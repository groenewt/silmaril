define RESOURCE_DESCRIPTION_FRAMEWORK_TURTLE_SUBJECT_AGGREGATION_RUN_EDGE
	@set +e; PYTHONDONTWRITEBYTECODE=1 PYTHONPATH="$(RESOURCE_DESCRIPTION_FRAMEWORK_TURTLE_SUBJECT_AGGREGATION_SOURCE_ROOT)" "$(SILMARIL_PYTHON)" -m $(1) <"$(2)" >"$(3).tmp" 2>"$(3).error"; status=$$?; set -e; if test "$$status" -ne 0; then cat "$(3).error" >&2; exit "$$status"; fi; rm -f "$(3).error"; mv "$(3).tmp" "$(3)"
endef

