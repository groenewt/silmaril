	$$(call RESOURCE_DESCRIPTION_FRAMEWORK_TURTLE_SUBJECT_AGGREGATION_RUN_EDGE,$$(RESOURCE_DESCRIPTION_FRAMEWORK_TURTLE_SUBJECT_AGGREGATION_MODULE_PREFIX).source.document.line.filter.process,$$<,$$@)
