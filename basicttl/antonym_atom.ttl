@prefix silm: <urn:silmaril:entity#> .
@prefix cco: <https://www.commoncoreontologies.org/> .
@prefix cceo: <https://www.commoncoreontologies.org/cpo#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

silm:antonymatom a owl:Class ;
    rdfs:label "AntonymAtom" ;
    rdfs:comment "An arrow asserting an opposite-meaning relation between a source atom and an antonym atom; populates the Antonyms Atlas column." .
