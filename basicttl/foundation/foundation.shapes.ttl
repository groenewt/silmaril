# =====================================================================================
# foundation.shapes.ttl — the SHACL law of the Foundation floor (W2 · SP0).
# =====================================================================================
# The single shapes graph for SP0 — the four-pillar bedrock (set theory / algebra /
# spaces / functionality) the whole ontology stands on. Loaded ONLY as the shapes graph
# by basicttl/foundation/checks/run-foundation-checks.sh (never mixed into the merged data
# graph) and validated against the merged SP0 + SP1 + SP2 + SP3 graph with inference="rdfs".
#
# Every shape here is a biting tooth proven by PROBE INJECTION (conforms True -> False),
# never by absence. Value-type checks use sh:in / sh:sparql, never a range-inference-vacuous
# sh:class (the SP1 defang discipline). Each atom the shapes reference carries a DS / PD / SYN
# authority tag (the Praeriehund honesty ledger, design §0).
#
# T1 SCAFFOLD: no sh:NodeShape is declared yet, so the runner skips this file
# ("no shapes declared yet (skipped)") and the floor is GREEN on the empty foundation graph
# with SP1 + SP2 + SP3 still green. Each later task adds exactly one (or a few) biting shape
# here, RED-before / GREEN-after, proven to bite by a documented probe injection:
#
#   T2  fnd:PresentedAlgebraShape      every rung resolves to a (Sigma, E) presented algebra
#   T3  fnd:SetCarrierShape            every foundation carrier is a fnd:Set under a grounding
#   T3  fnd:MembershipTypedShape       an element-of edge not 1->A typed -> RED
#   T3  fnd:UniversalProductShape      a product without its projections + factoriser -> RED
#   T3  fnd:PresheafNotSetShape        a presheaf owl:sameAs its element-set -> RED (PIN guard)
#   T4  fnd:MagmaClosureShape          closure rung tooth (an op-result outside the enumerated carrier -> RED)
#   T4  fnd:SemigroupAssocShape        associativity rung tooth
#   T4  fnd:MonoidIdentityShape        two-sided-identity rung tooth
#   T4  fnd:CommMonoidCommShape        commutativity rung tooth
#   T4  fnd:GroupInverseShape          two-sided-inverse rung tooth (genuineness) + inverse-COMPLETENESS (W1b)
#   T4  fnd:AbelianCommShape           abelian commutativity rung tooth
#   T4  fnd:QuasigroupDivisionShape    Latin-square division rung tooth (generalised over the Quasigroup family)
#   T4  fnd:QuasigroupTotalityShape    Latin-square division TOTALITY/existence rung tooth (every a,b has a left AND right solution) (A2)
#   T4  fnd:LoopIdentityShape          two-sided-identity rung tooth on fnd:Loop (L1: a Loop with no identity -> RED)
#   T4  fnd:AlgebraProgenitorShape     progenitor grounds nothing; every concrete rung adds EXACTLY ONE law
#   T4  fnd:MonoidIsEndoShape          Monoid ~= one-object category ~= F(X,X) (Pillar-4 seam)
#   T5  fnd:RingDistribShape           distributivity rung tooth
#   T5  fnd:RingAddAssocShape          additive ASSOCIATIVITY rung tooth over every fnd:Semiring ((a+b)+c=a+(b+c)) (A1)
#   T5  fnd:RingAddCommShape           additive COMMUTATIVITY rung tooth over every fnd:Semiring (a+b=b+a) (A1)
#   T5  fnd:RingAddIdentityShape       additive IDENTITY rung tooth: declared zero is a two-sided unit 0+x=x=x+0 over every fnd:Semiring, and a fnd:Semiring must HAVE a zero (R7-2)
#   T5  fnd:RingMultAssocShape         multiplicative ASSOCIATIVITY rung tooth over every fnd:Semiring ((a*b)*c=a*(b*c)) (A1)
#   T5  fnd:RingMultIdentityShape      multiplicative IDENTITY rung tooth: declared one is a two-sided unit 1*x=x=x*1 over every fnd:Semiring, and a fnd:Semiring must HAVE a one (R7-2 / Fix-B)
#   T5  fnd:RingAdditiveInverseShape   additive-inverse rung tooth (genuineness + completeness) (W1a)
#   T5  fnd:FieldMultInverseShape      multiplicative-inverse rung tooth
#   T5  fnd:FieldMultCommShape         field MULTIPLICATIVE-COMMUTATIVITY rung tooth over every fnd:Field (a*b=b*a) (R7-1)
#   T5  fnd:ModuleScalarShape          scalar-action TYPING rung tooth (R x M -> M)
#   T5  fnd:ModuleScalarLawShape       FULL module scalar-action law: unitality + scalar-assoc + bi-distributivity (W-SP0-B)
#   T5  fnd:VectorSpaceAxiomsShape     ALL EIGHT vector-space axioms bite over a fnd:Field (W2)
#   T6  fnd:SheafGluesShape            local sections agreeing on overlaps glue uniquely
#   T6  fnd:TopologyAxiomsShape        tau closed under finite intersection + arbitrary union
#   T6  fnd:MetricTriangleShape        d satisfies identity / identity-of-indiscernibles / symmetry / triangle inequality
#   T7  fnd:FrameRecognitionShape      the Frame is recognized as Curry's F
#   T7  fnd:FunctorVarianceShape       domain-widening / codomain-narrowing accepted -> RED
#   T7  fnd:SelfApplicationGuardShape  a not-genuinely-resolved chi-chi as a proposition -> RED (Fix-C: exemption needs a fnd:ContractGate/fnd:QuarantineResolution marking it provisional)
#   T8  fnd:CombinatorReducesShape     each combinator's defining reduction holds
#   T8  fnd:FnLadderShape              the F_n recurrence holds; a broken rung -> RED
#   T8  fnd:CombinatorProgenitorShape  agnostic combinator progenitor grounds nothing
#   T9  fnd:ImplicationKCWShape        the K / C / W implication laws hold
#   T9  fnd:CurryHowardShape           exponential B^A and implication A superset B coincide
#   T9  fnd:ProofTermTypedShape        a proof term is typed by the implication it proves
#   T10 fnd:ReanchorAdditiveShape      every prior-floor grounding is an edge; no prior triple removed
#   T10 fnd:SealedGroupIsGroupShape    the SP2 SealedGroup satisfies the full fnd:Group teeth
#   T10 fnd:ReanchorLandingParityShape all FOUR re-anchor edges use a POSITIVE landing-type test at parity (H2)
#   T11 fnd:AuthorityTagShape          every fnd class-like/property atom carries exactly one DS/PD/SYN tag
#   T11 fnd:AuthorityHonestyShape      every DS/PD-tagged atom carries an exact helios/srcy file:line (H1)
#
# Design spec: docs/superpowers/specs/2026-08-31-w2-sp0-foundation-design.md (§6)
# Plan:        docs/superpowers/plans/2026-08-31-w2-sp0-foundation-plan.md (Task T1)
# =====================================================================================

@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix fnd:  <urn:silmaril:fnd:#> .
@prefix prim: <urn:silmaril:prim:#> .
@prefix aob:  <urn:silmaril:aob:#> .
@prefix crs:  <urn:silmaril:crs:#> .
@prefix silm: <urn:silmaril:entity#> .

# =====================================================================================
# fnd:PresentedAlgebraShape (T2) — the minting-engine tooth: every presented algebra is minted, not
# invented (design s1; ledger/W2/algebra_foundation/02_algebra_tower.md s2, LIFTED). A sh:sparql node
# shape targeting fnd:PresentedAlgebra, mirroring the q_engine_presents ASK. It flags (1) a presented
# algebra with no fnd:hasSignature (no Sigma), (2) one with no fnd:hasEquationSet (no E), (3) one whose
# carrier is NOT F_E-produced — no fnd:hasCarrier ?c with ?c fnd:mintedVia some engine (the probe of
# record removes fnd:witnessCarrier fnd:mintedVia fnd:engineAdjunction), (4) one that fnd:satisfiesLaw
# an equation NOT in its own equation set (a rung claiming a law not in its E; the probe adds
# fnd:satisfiesLaw fnd:foreignLaw), and (5, the E-COVERAGE strengthening) one that fnd:rungRequiresLaw
# a law a class-general tooth enforces on it but does NOT fnd:satisfiesLaw (a rung whose presentation
# OMITS an enforced law; the probe deletes fnd:Semiring fnd:satisfiesLaw fnd:lawAddAssoc while
# fnd:RingAddAssocShape still enforces additive associativity on every fnd:Semiring). Clauses 4+5 together
# pin fnd:satisfiesLaw == the enforced law set, so E genuinely PRESENTS the rung structure. Every clause is
# EDGE-existence (not a ranged rdf:type), so inference="rdfs" cannot forge a fnd:mintedVia / fnd:hasSignature
# / fnd:hasEquation / fnd:rungRequiresLaw / fnd:satisfiesLaw edge and defang the tooth (the SP1 defang
# discipline: never a range-inference-vacuous sh:class). Full IRIs inside the sh:select so no sh:prefixes
# declaration is load-bearing. On this floor fnd:witnessPresentedAlgebra satisfies clauses 1-4 (no
# fnd:rungRequiresLaw, clause 5 vacuous) and every two-operation rung's fnd:rungRequiresLaw is a subset of
# its fnd:satisfiesLaw; each probe of record flips conforms True->False.
# =====================================================================================

fnd:PresentedAlgebraShape a sh:NodeShape ;
    rdfs:label "PresentedAlgebraShape" ;
    rdfs:comment "The minting-engine tooth with teeth on fnd:PresentedAlgebra (engine.ttl, design s1) - it makes 'the tower is minted, not invented' a graph fact. LIFTED from the Helios presented-free-algebra engine F_E(X)=T_Sigma(X)/=_E (helios/srcy/papers/26_adjunctions_free_graphs_governed_algebras/chapters/03_free_functor_on_graphs/sections/03_signature_equations_governed.tex:31-42) plus the free-|forgetful adjunction (26/sections/01_thesis.tex:93-128). A sh:sparql node shape targeting fnd:PresentedAlgebra that flags five breaches of faithful minting: (1) a presented algebra with no fnd:hasSignature (it has no signature Sigma to build the free term algebra over); (2) one with no fnd:hasEquationSet (it has no equation set E to quotient by); (3) one whose carrier is not F_E-produced - it has no fnd:hasCarrier ?c such that ?c fnd:mintedVia some fnd:FreeForgetful engine (a carrier asserted free by fiat rather than produced by the engine, the probe of record); (4) one that fnd:satisfiesLaw some equation that is NOT a fnd:hasEquation member of its own fnd:hasEquationSet (a rung claiming a law its presentation does not impose - the E-must-not-EXCEED direction); and (5, the E-COVERAGE strengthening) one that fnd:rungRequiresLaw some law - a law a CLASS-GENERAL tooth enforces on it - that it does NOT fnd:satisfiesLaw (a rung whose presentation OMITS an enforced law - the E-must-COVER direction; together clauses 4+5 pin fnd:satisfiesLaw == the enforced law set, so E genuinely PRESENTS the rung structure, matching the algebra_spine.ttl convention). Each clause reads only EDGE existence (fnd:hasSignature / fnd:hasEquationSet / fnd:hasCarrier / fnd:mintedVia / fnd:satisfiesLaw / fnd:hasEquation / fnd:rungRequiresLaw), never a bare sh:class over an rdfs:range, so inference=rdfs (which can materialise an rdf:type but cannot forge one of these property edges between two specific nodes) cannot defang it. On this floor fnd:witnessPresentedAlgebra (Sigma=fnd:witnessSignature, E=fnd:witnessEquationSet with member fnd:witnessLaw, carrier fnd:witnessCarrier mintedVia fnd:engineAdjunction, satisfiesLaw fnd:witnessLaw) satisfies clauses 1-4 and carries no fnd:rungRequiresLaw (clause 5 vacuous), and each two-operation rung (fnd:Semiring..fnd:VectorSpace) has fnd:rungRequiresLaw a SUBSET of its cumulative fnd:satisfiesLaw so clause 5 is GREEN; the probes of record - removing fnd:witnessCarrier fnd:mintedVia fnd:engineAdjunction (clause 3), adding fnd:witnessPresentedAlgebra fnd:satisfiesLaw fnd:foreignLaw with fnd:foreignLaw outside the equation set (clause 4), and deleting fnd:Semiring fnd:satisfiesLaw fnd:lawAddAssoc while fnd:Semiring still fnd:rungRequiresLaw fnd:lawAddAssoc and fnd:RingAddAssocShape still enforces additive associativity on every fnd:Semiring (clause 5) - each make the shape bite (conforms=True->False), proving the teeth on the cases that matter." ;
    sh:targetClass fnd:PresentedAlgebra ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "minting engine: this fnd:PresentedAlgebra is not faithfully minted - it lacks a fnd:hasSignature (Sigma), or lacks a fnd:hasEquationSet (E), or its carrier is not F_E-produced (no fnd:hasCarrier that is fnd:mintedVia a fnd:FreeForgetful engine), or it fnd:satisfiesLaw an equation that is not a fnd:hasEquation member of its own equation set (a law not in its E), or it fnd:rungRequiresLaw a law a class-general tooth enforces on it that it does NOT fnd:satisfiesLaw (its presentation omits an enforced law)." ;
        sh:select """
            SELECT $this WHERE {
              {
                $this <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <urn:silmaril:fnd:#PresentedAlgebra> .
                FILTER NOT EXISTS { $this <urn:silmaril:fnd:#hasSignature> ?s }
              } UNION {
                $this <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <urn:silmaril:fnd:#PresentedAlgebra> .
                FILTER NOT EXISTS { $this <urn:silmaril:fnd:#hasEquationSet> ?e }
              } UNION {
                $this <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <urn:silmaril:fnd:#PresentedAlgebra> .
                FILTER NOT EXISTS {
                  $this <urn:silmaril:fnd:#hasCarrier> ?c .
                  ?c <urn:silmaril:fnd:#mintedVia> ?ff .
                }
              } UNION {
                $this <urn:silmaril:fnd:#satisfiesLaw> ?law ;
                      <urn:silmaril:fnd:#hasEquationSet> ?e .
                FILTER NOT EXISTS { ?e <urn:silmaril:fnd:#hasEquation> ?law }
              } UNION {
                $this <urn:silmaril:fnd:#rungRequiresLaw> ?law .
                FILTER NOT EXISTS { $this <urn:silmaril:fnd:#satisfiesLaw> ?law }
              }
            }
        """ ;
    ] .


# =====================================================================================
# fnd:SetCarrierShape (T3) — every foundation carrier is a fnd:Set under a forgetful grounding
# (design s2, Pillar 1; 03_set_theory.md s1-s4, s7). A sh:sparql node shape targeting fnd:FreeAlgebra
# (the engine's produced carrier object), mirroring q_set_carrier: it flags any fnd:FreeAlgebra carrier
# that lacks a fnd:groundsInSet edge into a fnd:Set — a carrier not grounded under the honest two-step
# descent R:GovAlg->Graph (DS) then Graph->Set (fnd:graphUnderlyingSet, SYN). The clause reads only EDGE
# EXISTENCE on the carrier (fnd:groundsInSet), never a range-
# inferred rdf:type, so inference=rdfs (which can materialise a type from fnd:groundsInSet's rdfs:range
# but cannot forge the property EDGE between two specific nodes) cannot defang it — the SP1 defang
# discipline (never a range-inference-vacuous sh:class), the same edge-existence pattern as SP1's
# prim:DualGroundingShape and SP3's crs:ForgetfulTagFrame. On this floor fnd:witnessCarrier (a
# fnd:FreeAlgebra from engine.ttl) carries fnd:groundsInSet fnd:witnessUnderlyingSet and conforms; the
# probe of record injects fnd:probeUngroundedCarrier a fnd:FreeAlgebra with no grounding, flipping
# conforms True->False. Full IRIs in the sh:select so no sh:prefixes is load-bearing.
# =====================================================================================

fnd:SetCarrierShape a sh:NodeShape ;
    rdfs:label "SetCarrierShape" ;
    rdfs:comment "The structural-Set-floor carrier tooth with teeth on fnd:FreeAlgebra (set_theory.ttl, design s2 Pillar 1) - it makes 'every foundation carrier is a fnd:Set under a forgetful grounding' a graph fact. Honest two-step descent: the lifted right adjoint R:GovAlg->Graph (engine.ttl fnd:rightAdjoint, DS, helios/srcy/papers/26_adjunctions_free_graphs_governed_algebras/sections/01_thesis.tex:93-101) forgets a governed algebra to its inspectable underlying GRAPH (Hom_GovAlg(LG,A) ~= Hom_Graph(G,RA)), and THEN the Graph->Set underlying-vertex-set forgetful functor (fnd:graphUnderlyingSet, SYN standard math, NOT a paper-26 lift) sends that graph to the underlying set of the free-algebra carrier F_E(X); a carrier lands in the structural fnd:Set by this two-step R:GovAlg->Graph (DS) then Graph->Set (SYN), never a single DS R:GovAlg->Set. This shape requires that grounding to be present as an explicit fnd:groundsInSet edge. A sh:sparql node shape targeting fnd:FreeAlgebra that flags any carrier with no fnd:groundsInSet ?s edge (a carrier not grounded into any set). The clause reads only EDGE existence (fnd:groundsInSet), never a bare sh:class over an rdfs:range, so inference=rdfs cannot defang it - the SP1 defang discipline, the same edge-existence pattern as prim:DualGroundingShape (a tower class must carry its own prim:Realization edge) and crs:ForgetfulTagFrame. On this floor fnd:witnessCarrier (the engine's FreeAlgebra) carries fnd:groundsInSet fnd:witnessUnderlyingSet (a fnd:Set) and conforms; the probe of record - fnd:probeUngroundedCarrier a fnd:FreeAlgebra with no fnd:groundsInSet edge - makes the shape bite (conforms=True->False), proving the tooth on the case that matters. T10 adds the fnd:groundsInSet edges from the SP1/SP2/SP3 carriers (prim:Octet/RGB/Bit -> finite fnd:Set); this shape guards the foundation's own carriers." ;
    sh:targetClass fnd:FreeAlgebra ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "structural Set floor: this fnd:FreeAlgebra carrier is not grounded into a fnd:Set - it has no fnd:groundsInSet edge (a carrier that is not a Set under the two-step descent R:GovAlg->Graph then Graph->Set)." ;
        sh:select """
            SELECT $this WHERE {
              $this <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <urn:silmaril:fnd:#FreeAlgebra> .
              FILTER NOT EXISTS { $this <urn:silmaril:fnd:#groundsInSet> ?s }
            }
        """ ;
    ] .


# =====================================================================================
# fnd:MembershipTypedShape (T3) — every membership edge is a global element 1->A (design s2, Pillar 1;
# 03_set_theory.md s2.1). A sh:sparql node shape targeting subjects of fnd:elementOf, mirroring
# q_membership_typed: it flags any fnd:elementOf edge whose subject is NOT the typed arrow 1->A, i.e.
# lacks fnd:hasDomain fnd:Unit or lacks fnd:hasCodomain equal to the very set it is an element of. Both
# clauses read EDGE existence to the specific nodes fnd:Unit / the elementOf target, never a range-
# inferred rdf:type, so inference=rdfs cannot defang it. On this floor fnd:witnessElement (a
# fnd:GlobalElement with fnd:hasDomain fnd:Unit, fnd:hasCodomain fnd:witnessSetA, fnd:elementOf
# fnd:witnessSetA) conforms; the probe of record injects fnd:probeUntypedElement fnd:elementOf
# fnd:witnessSetA with no fnd:hasDomain fnd:Unit, flipping conforms True->False.
# =====================================================================================

fnd:MembershipTypedShape a sh:NodeShape ;
    rdfs:label "MembershipTypedShape" ;
    rdfs:comment "The structural-membership tooth with teeth on the subjects of fnd:elementOf (set_theory.ttl, design s2 Pillar 1) - it makes 'membership is a typed global element 1->A, never a bare untyped link' a graph fact, filling the flagged SP1 membership gap (03_set_theory.md s2.1, D-SET-2). A sh:sparql node shape (sh:targetSubjectsOf fnd:elementOf) that flags any fnd:elementOf ?A edge whose subject is not the arrow 1->A: it lacks fnd:hasDomain fnd:Unit (the terminal object 1) OR lacks fnd:hasCodomain equal to that same ?A. Both clauses read EDGE existence to the SPECIFIC nodes fnd:Unit and the fnd:elementOf target, never a bare sh:class over an rdfs:range, so inference=rdfs (which can materialise a type but cannot forge a fnd:hasDomain edge to fnd:Unit) cannot defang it - the SP1 defang discipline. On this floor fnd:witnessElement (a fnd:GlobalElement: fnd:hasDomain fnd:Unit, fnd:hasCodomain fnd:witnessSetA, fnd:elementOf fnd:witnessSetA) conforms; the probe of record - fnd:probeUntypedElement fnd:elementOf fnd:witnessSetA with NO fnd:hasDomain fnd:Unit (an element that is not the global element 1->A) - makes the shape bite (conforms=True->False), proving the tooth." ;
    sh:targetSubjectsOf fnd:elementOf ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "structural membership: this fnd:elementOf edge is not a typed global element 1->A - its subject lacks fnd:hasDomain fnd:Unit or lacks fnd:hasCodomain equal to the set it is an element of (a bare untyped membership, not the arrow 1->A)." ;
        sh:select """
            SELECT $this WHERE {
              $this <urn:silmaril:fnd:#elementOf> ?A .
              FILTER NOT EXISTS {
                $this <urn:silmaril:fnd:#hasDomain> <urn:silmaril:fnd:#Unit> .
                $this <urn:silmaril:fnd:#hasCodomain> ?A .
              }
            }
        """ ;
    ] .


# =====================================================================================
# fnd:UniversalProductShape (T3) — every product carries its two projections + a universal factoriser
# (design s2, Pillar 1; 03_set_theory.md s2.4). A sh:sparql node shape targeting fnd:Product, mirroring
# q_universal_product: it flags a fnd:Product that lacks two DISTINCT fnd:hasProjection, OR lacks a
# fnd:hasFactoriser. Both clauses read EDGE existence, never a range-inferred rdf:type, so inference=rdfs
# cannot defang it - the same universal-property discipline aob:group_law uses (apex + legs + unique
# mediating morphism). On this floor fnd:witnessProduct (two projections + a factoriser) conforms; the
# probe of record injects fnd:probeBadProduct a fnd:Product with no projections and no factoriser,
# flipping conforms True->False. The fnd:Product / prim:Tuple polysemy (universal vs data) is SP6-scoped.
# =====================================================================================

fnd:UniversalProductShape a sh:NodeShape ;
    rdfs:label "UniversalProductShape" ;
    rdfs:comment "The universal-product tooth with teeth on fnd:Product (set_theory.ttl, design s2 Pillar 1) - it makes 'a product carries its two projections and its unique universal factoriser' a graph fact, reifying the universal property the same way basicttl/aob/group_law.ttl reifies the colimit (apex + legs + unique aob:universalFactor). A sh:sparql node shape targeting fnd:Product that flags two breaches: (1) a fnd:Product without two DISTINCT fnd:hasProjection (a product must have both pi_1 and pi_2); and (2) a fnd:Product without a fnd:hasFactoriser (the unique mediating morphism <f,g> through which every cone factors - without it the object is a mere span, not a universal product). Each clause reads EDGE existence (fnd:hasProjection / fnd:hasFactoriser), never a bare sh:class over an rdfs:range, so inference=rdfs cannot defang it - the SP1 defang discipline. This universal-construction fnd:Product is HELD DISTINCT from the DATA product prim:Tuple (SP6 polysemy, D-SET-5). On this floor fnd:witnessProduct (fnd:hasProjection fnd:witnessProj1, fnd:witnessProj2 ; fnd:hasFactoriser fnd:witnessFactoriser) conforms; the probe of record - fnd:probeBadProduct a fnd:Product with no projections and no factoriser - makes the shape bite (conforms=True->False), proving the tooth." ;
    sh:targetClass fnd:Product ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "universal product: this fnd:Product is not a genuine categorical product - it lacks two distinct fnd:hasProjection (pi_1, pi_2), or it lacks a fnd:hasFactoriser (the unique universal mediating morphism <f,g>)." ;
        sh:select """
            SELECT $this WHERE {
              {
                $this <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <urn:silmaril:fnd:#Product> .
                FILTER NOT EXISTS {
                  $this <urn:silmaril:fnd:#hasProjection> ?p1 , ?p2 .
                  FILTER(?p1 != ?p2)
                }
              } UNION {
                $this <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <urn:silmaril:fnd:#Product> .
                FILTER NOT EXISTS { $this <urn:silmaril:fnd:#hasFactoriser> ?f }
              }
            }
        """ ;
    ] .


# =====================================================================================
# fnd:PresheafNotSetShape (T3, PIN GUARD) — no presheaf is owl:sameAs its own set of elements
# (design s2 PIN guard; 03_set_theory.md D-SET-6). A sh:sparql node shape targeting fnd:Presheaf,
# mirroring q_presheaf_not_set: it flags a presheaf that is owl:sameAs one of its fnd:presheafElementSet
# values (identifying P with P(c) - the corpus's named forbidden collapse, 18/sections/01_thesis.tex:65-68).
# The clause reads the EXPLICIT owl:sameAs edge (rdfs inference does NOT do owl:sameAs entailment, so the
# edge stays exactly as asserted - non-forgeable). On this floor fnd:witnessPresheaf and its element-set
# fnd:witnessPresheafElemSet are deliberately kept distinct (no owl:sameAs) and conform; the probe of
# record injects fnd:witnessPresheaf owl:sameAs fnd:witnessPresheafElemSet, flipping conforms True->False.
# =====================================================================================

fnd:PresheafNotSetShape a sh:NodeShape ;
    rdfs:label "PresheafNotSetShape" ;
    rdfs:comment "The PIN-guard tooth with teeth on fnd:Presheaf (set_theory.ttl, design s2 / D-SET-6, LOAD-BEARING) - it makes the corpus's most-exposed cheese-trap law a graph fact: the set floor is the CARRIER beneath the category layer, it does NOT flatten it. A sh:sparql node shape targeting fnd:Presheaf that flags any presheaf which is owl:sameAs one of its own fnd:presheafElementSet values - i.e. 'the presheaf P is the same as the set of elements P(c)', which 'drops the contravariant action and collapses functoriality into static labelling' (helios/srcy/papers/18_presheaf_semantics/sections/01_thesis.tex:65-68; X = Hom(-,X) is shorthand not identity, 14/sections/01_thesis.tex:90-102). The clause reads the EXPLICIT owl:sameAs edge between the presheaf and its element-set; rdfs inference does NOT perform owl:sameAs entailment, so the edge is exactly as asserted and non-forgeable - inference cannot defang it. On this floor fnd:witnessPresheaf carries fnd:presheafElementSet fnd:witnessPresheafElemSet but is deliberately NOT owl:sameAs it (the two objects are kept distinct) and conforms; the probe of record - fnd:witnessPresheaf owl:sameAs fnd:witnessPresheafElemSet (the forbidden collapse) - makes the shape bite (conforms=True->False), proving the PIN guard on the case that matters." ;
    sh:targetClass fnd:Presheaf ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "presheaf != set (PIN guard): this fnd:Presheaf is owl:sameAs its own fnd:presheafElementSet - the forbidden collapse identifying the presheaf P with its set of elements P(c), flattening functoriality into static labelling." ;
        sh:select """
            SELECT $this WHERE {
              $this <urn:silmaril:fnd:#presheafElementSet> ?s .
              $this <http://www.w3.org/2002/07/owl#sameAs> ?s .
            }
        """ ;
    ] .


# =====================================================================================
# fnd:MagmaClosureShape (T4) — the base MAGMA rung's closure/totality tooth (design s3; 02_algebra_tower.md
# s1 MAGMA; M1 parity). fnd:Magma is a CONCRETE law-bearing rung (fnd:addsLaw fnd:lawClosure) but its
# closure law had NO biting tooth + NO witness while every sibling rung had both. This shape closes that
# hole at PARITY, REUSING the SealedGroup closure idiom (fnd:SealedGroupIsGroupShape's closure branch: a
# reified product over the op whose fnd:opResult is NOT a fnd:hasElement of the structure -> violation),
# made CLASS-GENERAL over fnd:Magma. A sh:sparql node shape targeting fnd:Magma (so under inference=rdfs it
# fires on every Magma-or-subclass instance): it flags a fnd:Magma that ENUMERATES its carrier
# (fnd:hasElement) and has some reified fnd:opResult over fnd:opStructure $this that is NOT one of its
# fnd:hasElement (a product escaping the enumerated carrier). The enumerated-carrier guard ($this
# fnd:hasElement ?someEl) is essential: the spine/quasigroup witnesses that do NOT enumerate a carrier
# (fnd:semigroupModel..fnd:groupModel, fnd:quasigroupModel..fnd:loopModel) carry no fnd:hasElement and are
# correctly out of scope, not misread as all-escaping; the enumerated magmas (fnd:magmaModel + the Z/4
# aob:witnessGroup via rdfs:subClassOf) are both closed. Every clause reads EDGE existence over the reified
# op table + the element enumeration, never a range-inferred rdf:type, so inference=rdfs cannot defang it
# (the SP1 defang discipline). On the floor fnd:magmaModel (closed order-2 non-associative table over {A,B})
# + aob:witnessGroup (closed Z/4) satisfy it -> conforms; the probe of record (fnd:probeMagmaOpenResult a
# fnd:Magma, enumerated carrier {A,B}, with an op row whose fnd:opResult is fnd:elemC outside {A,B}) makes
# the shape bite (conforms True->False), proving the tooth. Mirrors q_magma_closure.
# =====================================================================================

fnd:MagmaClosureShape a sh:NodeShape ;
    rdfs:label "MagmaClosureShape" ;
    rdfs:comment "The base Magma-rung CLOSURE/TOTALITY tooth with teeth on fnd:Magma (algebra_spine.ttl, design s3; M1 parity). fnd:Magma is a concrete law-bearing rung whose sole added law is closure/totality (fnd:addsLaw fnd:lawClosure: the binary operation . : S,S -> S is a TOTAL function landing back in the carrier S), yet its closure law previously had NO biting tooth and NO witness model, while every sibling rung (Semigroup..AbelianGroup, Quasigroup/Loop) carried both - the M1 defect. This shape gives fnd:Magma PARITY by making closure a CHECKABLE graph fact, REUSING the SealedGroup closure idiom (fnd:SealedGroupIsGroupShape / q_sealedgroup_is_group closure branch, and the topology closure check: a reified product over the operation whose result is NOT a fnd:hasElement of the structure -> violation), generalised CLASS-GENERAL over the whole fnd:Magma family. SYN, cited standard universal algebra (fnd:Magma is SYN; the free term-algebra substrate T_Sigma(X) is LIFTED, 26/03/03:13-15). A sh:sparql node shape (sh:targetClass fnd:Magma, so under inference=rdfs it targets every Magma-or-subclass instance) whose constraint fires when a fnd:Magma $this ENUMERATES its carrier (there is a $this fnd:hasElement ?someEl - the guard that scopes the tooth to magmas over an enumerated carrier) AND some reified product over it escapes that carrier (a ?row fnd:opStructure $this ; fnd:opResult ?r with ?r NOT a fnd:hasElement of $this). The enumerated-carrier guard is load-bearing: the spine/division witnesses that do not enumerate a carrier (fnd:semigroupModel, fnd:monoidModel, fnd:commMonoidModel, fnd:groupModel, fnd:quasigroupModel, fnd:loopModel - none carry fnd:hasElement, they enumerate via other predicates or not at all) are correctly OUT OF SCOPE and not falsely flagged as all-escaping; the magmas that DO enumerate fnd:hasElement are fnd:magmaModel (the closed order-2 non-associative witness over {A,B}) and, via rdfs:subClassOf fnd:Group ... fnd:Magma, the T10 aob:witnessGroup (the closed Z/4 SealedGroup), both closed. Every clause reads EDGE existence over the reified op table (fnd:opStructure/fnd:opResult) and the element enumeration (fnd:hasElement), never a bare sh:class over an rdfs:range, so inference=rdfs (which can materialise an rdf:type but cannot forge one of these property edges between two specific nodes) cannot defang it - the SP1 defang discipline. On this floor fnd:magmaModel (rows A.A=B, A.B=B, B.A=A, B.B=B, all landing in {A,B}) and aob:witnessGroup (the closed Z/4 Cayley table) satisfy it, so conforms=True; the probe of record - fnd:probeMagmaOpenResult a fnd:Magma with fnd:hasElement fnd:elemA , fnd:elemB and an op row whose fnd:opResult is fnd:elemC (outside the enumerated carrier {A,B}) - makes the closure clause bite (conforms=True->False) while the closed fnd:magmaModel stays GREEN, proving the tooth on the case that matters. Mirrors q_magma_closure." ;
    sh:targetClass fnd:Magma ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "magma rung (closure): this fnd:Magma enumerates a carrier (fnd:hasElement) yet some reified product over its operation has a fnd:opResult that is NOT a fnd:hasElement of the magma - the binary operation is not closed on the enumerated carrier (a product escapes S)." ;
        sh:select """
            SELECT $this WHERE {
              $this <urn:silmaril:fnd:#hasElement> ?someEl .
              ?row <urn:silmaril:fnd:#opStructure> $this ; <urn:silmaril:fnd:#opResult> ?r .
              FILTER NOT EXISTS { $this <urn:silmaril:fnd:#hasElement> ?r }
            }
        """ ;
    ] .


# =====================================================================================
# fnd:SemigroupAssocShape (T4) — associativity over the semigroup rung witness (design s3; 02_algebra_
# tower.md s1 SEMIGROUP; the associativity LAW is PD, proved for path/colon concat). A sh:sparql node
# shape targeting fnd:BinaryOperationApplication, mirroring q_semigroup_assoc: it flags the semigroup
# witness if ANY triple (x,y,z) over fnd:opStructure fnd:semigroupModel has (x.y).z != x.(y.z), reading
# the reified op table (fnd:opLeft/fnd:opRight/fnd:opResult) exactly as SP2's aob:GroupAssociativityShape
# does one floor up. Every clause is EDGE existence over the reified applications, never a range-inferred
# rdf:type, so inference=rdfs cannot forge an op row and defang it. On the floor the left-zero table
# (A.B=A, A.C=A, B.C=B) makes both bracketings of (A,B,C) evaluate to A; the probe of record (fnd:appSgAC
# fnd:opResult -> fnd:elemB) makes (A.B).C=B != A=A.(B.C), and the shape bites (conforms True->False).
# =====================================================================================

fnd:SemigroupAssocShape a sh:NodeShape ;
    rdfs:label "SemigroupAssocShape" ;
    rdfs:comment "The Semigroup-rung associativity tooth with teeth on the reified operation table of fnd:semigroupModel (algebra_spine.ttl, design s3). It makes the associativity law (x.y).z = x.(y.z) a CHECKABLE graph fact, mirroring SP2's aob:GroupAssociativityShape one floor down (basicttl/aob/group_law.ttl). The Semigroup atom is SYN (Helios names semigroup only as a boundary counterexample, 21/05/04:138) but the LAW is PROOF-DERIVED (associativity of path concatenation 31/01/02:51-94 and colon product 07/05/03:51-55). CLASS-GENERAL (no witness IRI is hardcoded): a sh:sparql node shape targeting fnd:BinaryOperationApplication whose constraint QUANTIFIES OVER EVERY fnd:Semigroup instance ?mdl (bound by ?mdl rdf:type fnd:Semigroup, so under inference=rdfs it matches the semigroup witness directly AND every associative rung above it - fnd:Monoid/fnd:CommutativeMonoid/fnd:Group/fnd:AbelianGroup and the SP2 aob:SealedGroup, each rdfs:subClassOf fnd:Semigroup - while the non-associative fnd:Quasigroup/fnd:Loop family, which hangs off fnd:Magma NOT fnd:Semigroup, is correctly excluded), exactly the way fnd:GroupInverseShape/fnd:QuasigroupDivisionShape quantify over their class rather than a single model. It fires when there EXISTS a triple (x,y,z) over fnd:opStructure ?mdl whose two bracketings disagree: it forms (x.y) via a row opLeft=x,opRight=y,opResult=xyr, then (x.y).z via opLeft=xyr,opRight=z,opResult=lr; and (y.z) via opLeft=y,opRight=z,opResult=yzr, then x.(y.z) via opLeft=x,opRight=yzr,opResult=rr; and FILTER(lr != rr). Every clause reads EDGE existence over the reified applications (fnd:opStructure/fnd:opLeft/fnd:opRight/fnd:opResult) plus the ?mdl rdf:type guard (materialisable but not forgeable between two specific nodes), never a bare sh:class over an rdfs:range, so inference=rdfs cannot defang it - the SP1 defang discipline. On this floor the left-zero witness table (A.B=A, A.C=A, B.C=B) makes both bracketings of (A,B,C) evaluate to A, and every other Semigroup-typed model (the Z/3 group, the abelian and commutative-monoid fragments, the Z/4 sealed group, the Z/3 module additive group) is a genuine associative structure, so conforms=True; the probe of record - changing fnd:appSgAC fnd:opResult from fnd:elemA to fnd:elemB, so (A.B).C = A.C = B while A.(B.C) = A.B = A - makes the shape bite (conforms=True->False), AND a FRESH correctly-typed non-associative fnd:Semigroup instance (a new ?mdl a fnd:Semigroup with a non-associative reified table) is now caught too, proving the tooth is CLASS-GENERAL not witness-pinned." ;
    sh:targetClass fnd:BinaryOperationApplication ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "semigroup rung: the operation of some fnd:Semigroup instance (?mdl a fnd:Semigroup, including every associative rung above it by rdfs:subClassOf under inference) is NOT associative - there is a triple (x,y,z) whose two bracketings (x.y).z and x.(y.z) evaluate to different fnd:opResult." ;
        sh:select """
            SELECT $this WHERE {
              $this <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <urn:silmaril:fnd:#BinaryOperationApplication> .
              ?mdl <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <urn:silmaril:fnd:#Semigroup> .
              ?ab  <urn:silmaril:fnd:#opStructure> ?mdl ; <urn:silmaril:fnd:#opLeft> ?x ; <urn:silmaril:fnd:#opRight> ?y ; <urn:silmaril:fnd:#opResult> ?xyr .
              ?lhs <urn:silmaril:fnd:#opStructure> ?mdl ; <urn:silmaril:fnd:#opLeft> ?xyr ; <urn:silmaril:fnd:#opRight> ?z ; <urn:silmaril:fnd:#opResult> ?lr .
              ?bc  <urn:silmaril:fnd:#opStructure> ?mdl ; <urn:silmaril:fnd:#opLeft> ?y ; <urn:silmaril:fnd:#opRight> ?z ; <urn:silmaril:fnd:#opResult> ?yzr .
              ?rhs <urn:silmaril:fnd:#opStructure> ?mdl ; <urn:silmaril:fnd:#opLeft> ?x ; <urn:silmaril:fnd:#opRight> ?yzr ; <urn:silmaril:fnd:#opResult> ?rr .
              FILTER(?lr != ?rr)
            }
        """ ;
    ] .


# =====================================================================================
# fnd:MonoidIdentityShape (T4) — the two-sided identity over any structure with a declared identity
# (design s3; Monoid = the ONE lifted rung; the unit law PD). A sh:sparql node shape targeting subjects
# of fnd:hasIdentityElement, mirroring q_monoid_identity: it flags a structure whose declared identity e
# fails e.x = x (a left row with result != right operand) or x.e = x (a right row with result != left
# operand), reading the reified op table. Edge-existence only, defang-proof. On the floor fnd:monoidModel
# (E.A=A, A.E=A, E.E=E) conforms; the probe (fnd:appMonEA fnd:opResult -> fnd:elemE) makes E.A=E != A -> RED.
# =====================================================================================

fnd:MonoidIdentityShape a sh:NodeShape ;
    rdfs:label "MonoidIdentityShape" ;
    rdfs:comment "The Monoid-rung two-sided-identity tooth with teeth on the subjects of fnd:hasIdentityElement AND on the class fnd:Monoid (algebra_spine.ttl, design s3; EXISTENCE-HALF close). Monoid is the ONE genuinely LIFTED rung (free monoid with proved unit, 07/05/03:38-55; monoid = one-object category, 21/05/04) and the two-sided identity/unit law is PROOF-DERIVED. It makes BOTH 'the declared identity really is a two-sided unit' (GENUINENESS) AND 'a monoid actually HAS a two-sided identity' (EXISTENCE) CHECKABLE graph facts. A sh:sparql node shape with TWO targets - sh:targetSubjectsOf fnd:hasIdentityElement (genuineness) and sh:targetClass fnd:Monoid (existence) - carrying TWO self-guarded sh:sparql constraints. Constraint A (GENUINENESS) fires when a structure ?mm with fnd:hasIdentityElement ?e has EITHER a reified row with ?e on the left whose fnd:opResult differs from the right operand (e.x != x, the left-unit law fails) OR a row with ?e on the right whose result differs from the left operand (x.e != x, the right-unit law fails). Constraint B (EXISTENCE, the guard-on-optional-edge close) fires when a $this that is a fnd:Monoid (directly, or via rdfs:subClassOf inference: every fnd:CommutativeMonoid / fnd:Group / fnd:AbelianGroup / aob:SealedGroup) carries NO fnd:hasIdentityElement at all - a unit-LESS monoid, which the earlier sh:targetSubjectsOf-only tooth never focused on (it bound $this to the identity, so a monoid that simply OMITS the defining identity edge escaped GREEN); it mirrors fnd:LoopIdentityShape branch 1 (a fnd:Loop with no identity -> RED) one family over. Both clauses read EDGE existence over the reified applications / the fnd:hasIdentityElement edge plus the rdf:type fnd:Monoid guard (materialisable but not forgeable between two specific nodes), never a bare sh:class over an rdfs:range, so inference=rdfs cannot defang it - the SP1 defang discipline. On this floor fnd:monoidModel (fnd:hasIdentityElement fnd:elemE; rows E.A=A, A.E=A, E.E=E), fnd:endoMonoidWitness, fnd:commMonoidModel, fnd:abelianModel, fnd:moduleAddGroup, fnd:nonnegRealsMonoid, fnd:groupModel and aob:witnessGroup ALL declare a two-sided identity, so conforms=True; the genuineness probe - changing fnd:appMonEA fnd:opResult from fnd:elemA to fnd:elemE, so E.A = E != A - makes constraint A bite, and the existence probe - a fnd:Monoid (e.g. a fresh fnd:CommutativeMonoid) with NO fnd:hasIdentityElement - makes constraint B bite (conforms=True->False), proving both teeth." ;
    sh:targetSubjectsOf fnd:hasIdentityElement ;
    sh:targetClass fnd:Monoid ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "monoid rung (genuine identity): this structure's declared fnd:hasIdentityElement is NOT a two-sided identity - a reified row with the identity on the left has a result != its right operand (e.x != x), or a row with the identity on the right has a result != its left operand (x.e != x)." ;
        sh:select """
            SELECT $this WHERE {
              $this <urn:silmaril:fnd:#hasIdentityElement> ?e .
              {
                ?rL <urn:silmaril:fnd:#opStructure> $this ; <urn:silmaril:fnd:#opLeft> ?e ; <urn:silmaril:fnd:#opRight> ?x ; <urn:silmaril:fnd:#opResult> ?rLr .
                FILTER(?rLr != ?x)
              } UNION {
                ?rR <urn:silmaril:fnd:#opStructure> $this ; <urn:silmaril:fnd:#opLeft> ?x ; <urn:silmaril:fnd:#opRight> ?e ; <urn:silmaril:fnd:#opResult> ?rRr .
                FILTER(?rRr != ?x)
              }
            }
        """ ;
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "monoid rung (identity EXISTENCE): this fnd:Monoid (directly or via rdfs:subClassOf - every fnd:CommutativeMonoid / fnd:Group / fnd:AbelianGroup / aob:SealedGroup) carries NO fnd:hasIdentityElement - a unit-less monoid (the defining identity edge is OMITTED, so the two-sided-identity law is not opt-in; mirrors fnd:LoopIdentityShape branch 1)." ;
        sh:select """
            SELECT $this WHERE {
              $this <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <urn:silmaril:fnd:#Monoid> .
              FILTER NOT EXISTS { $this <urn:silmaril:fnd:#hasIdentityElement> ?e }
            }
        """ ;
    ] .


# =====================================================================================
# fnd:CommMonoidCommShape (T4) — commutativity over the commutative-monoid rung witness (design s3; SYN).
# A sh:sparql node shape targeting fnd:BinaryOperationApplication, mirroring q_commmonoid_comm: it flags
# the witness if ANY pair (x,y) over fnd:opStructure fnd:commMonoidModel has x.y != y.x. Edge-existence,
# defang-proof. Floor: A.B=E, B.A=E -> conforms; probe (fnd:appCmBA fnd:opResult -> fnd:elemA) -> RED.
# =====================================================================================

fnd:CommMonoidCommShape a sh:NodeShape ;
    rdfs:label "CommMonoidCommShape" ;
    rdfs:comment "The CommutativeMonoid-rung commutativity tooth with teeth on the reified operation table of fnd:commMonoidModel (algebra_spine.ttl, design s3). CommutativeMonoid is SYN (the ATOM synthesized; instances lifted - (N0,+,0), M_J - and commutativity is a declared congruence, 07/05/03:222-232, with noncommutativity the corpus default). It makes commutativity x.y = y.x a CHECKABLE graph fact. CLASS-GENERAL (no witness IRI is hardcoded): a sh:sparql node shape targeting fnd:BinaryOperationApplication whose constraint QUANTIFIES OVER EVERY fnd:CommutativeMonoid instance ?mdl (bound by ?mdl rdf:type fnd:CommutativeMonoid, mirroring fnd:GroupInverseShape/fnd:QuasigroupDivisionShape) and fires when there EXISTS a pair (x,y) over fnd:opStructure ?mdl with a row opLeft=x,opRight=y,opResult=xyr and a row opLeft=y,opRight=x,opResult=yxr and FILTER(xyr != yxr). Every clause reads EDGE existence over the reified applications plus the ?mdl rdf:type guard, never a bare sh:class over an rdfs:range, so inference=rdfs cannot defang it - the SP1 defang discipline. On this floor the symmetric pair (A.B=E, B.A=E) of the commutative-monoid witness conforms; the probe of record - changing fnd:appCmBA fnd:opResult from fnd:elemE to fnd:elemA, so B.A = A while A.B = E - makes the shape bite (conforms=True->False), AND a FRESH correctly-typed non-commutative fnd:CommutativeMonoid instance is now caught too, proving the tooth is CLASS-GENERAL not witness-pinned." ;
    sh:targetClass fnd:BinaryOperationApplication ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "commutative-monoid rung: the operation of some fnd:CommutativeMonoid instance (?mdl a fnd:CommutativeMonoid) is NOT commutative - there is a pair (x,y) with x.y != y.x." ;
        sh:select """
            SELECT $this WHERE {
              $this <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <urn:silmaril:fnd:#BinaryOperationApplication> .
              ?mdl <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <urn:silmaril:fnd:#CommutativeMonoid> .
              ?xy <urn:silmaril:fnd:#opStructure> ?mdl ; <urn:silmaril:fnd:#opLeft> ?x ; <urn:silmaril:fnd:#opRight> ?y ; <urn:silmaril:fnd:#opResult> ?xyr .
              ?yx <urn:silmaril:fnd:#opStructure> ?mdl ; <urn:silmaril:fnd:#opLeft> ?y ; <urn:silmaril:fnd:#opRight> ?x ; <urn:silmaril:fnd:#opResult> ?yxr .
              FILTER(?xyr != ?yxr)
            }
        """ ;
    ] .


# =====================================================================================
# fnd:GroupInverseShape (T4) — the two-sided inverse undoes the operation (design s3; SYN, the one zero-
# Helios axiom). A sh:sparql node shape targeting fnd:InversePairing, mirroring q_group_inverse (reusing
# SP2's genuine-inverse discipline): it flags a claimed pairing (element x, inverse y, model with identity
# e) unless x.y = e AND y.x = e. Edge-existence, defang-proof. Floor: A.B=E, B.A=E -> conforms; probe
# (fnd:appGrAB fnd:opResult -> fnd:elemA) makes A.B=A != e -> RED.
# =====================================================================================

fnd:GroupInverseShape a sh:NodeShape ;
    rdfs:label "GroupInverseShape" ;
    rdfs:comment "The Group-rung two-sided-inverse tooth with teeth on fnd:InversePairing (GENUINENESS) and on fnd:Group (COMPLETENESS) (algebra_spine.ttl, design s3; W1b close). The inverse law is THE ONE tower axiom with ZERO Helios basis (02_algebra_tower.md s1 / Directive 20), authored as cited standard math; this tooth reuses SP2's genuine-inverse discipline (aob:retracts, 'a retract that does not undo -> RED', basicttl/aob/group_law.ttl). A sh:sparql node shape with TWO targets - sh:targetClass fnd:InversePairing (genuineness) and sh:targetClass fnd:Group (completeness) - carrying TWO self-guarded sh:sparql constraints, the same multi-target self-guarded pattern fnd:FieldMultInverseShape uses. Constraint A (GENUINE) fires when a pairing $this a fnd:InversePairing (fnd:pairingModel ?mdl with fnd:hasIdentityElement ?e, fnd:pairingElement ?x, fnd:pairingInverse ?y) does NOT two-sidedly undo: there is no reified row x.y = e OR no row y.x = e over fnd:opStructure ?mdl. Constraint B (COMPLETE, W1b) fires when a $this a fnd:Group has a fnd:hasGroupElement ?x that carries NO fnd:InversePairing (fnd:pairingModel $this, fnd:pairingElement ?x) - a group element with no inverse, mirroring fnd:SealedGroupIsGroupShape's inverse-universal branch. Without B a fnd:Group with a non-invertible element passed GREEN (the W1b hole), because A only checks DECLARED pairings. Each constraint self-guards on $this's type. Every clause reads EDGE existence over the reified applications, the pairing edges and the fnd:hasGroupElement enumeration, never a bare sh:class over an rdfs:range, so inference=rdfs cannot defang it - the SP1 defang discipline (fnd:hasGroupElement is quantified only over fnd:Group instances, so the abelian-group witness fnd:abelianModel and the SP2 aob:witnessGroup - which enumerate via fnd:hasElement, covered by fnd:SealedGroupIsGroupShape - are not spuriously caught). On this floor the Z/3 witness fnd:groupModel (identity E; A.B=E, B.A=E, E.E=E; fnd:hasGroupElement E/A/B each with a two-sided pairing A<->B, B<->A, E<->E) conforms; the genuineness probe - changing fnd:appGrAB fnd:opResult from fnd:elemE to fnd:elemA, so A.B = A != E and the claimed inverse B no longer undoes A - makes constraint A bite; the completeness probe - a fnd:Group over {E,A} with A non-invertible and an fnd:InversePairing only for E - makes constraint B bite (conforms=True->False), proving both teeth. Constraint C (carrier EXISTENCE, the guard-on-optional-edge close) fires when a fnd:Group ENUMERATES no carrier - it carries NEITHER fnd:hasGroupElement NOR fnd:hasElement - so completeness (B) is not opt-in: a carrier-less fnd:Group (whose completeness clause B would otherwise quantify over the empty set and pass vacuously) is now RED. On this floor fnd:groupModel (fnd:hasGroupElement E/A/B), fnd:abelianModel and fnd:moduleAddGroup (fnd:hasGroupElement, added in the EXISTENCE-HALF close) and aob:witnessGroup (fnd:hasElement) all enumerate their carrier, so conforms=True; the probe - a fnd:Group with no fnd:hasGroupElement and no fnd:hasElement - makes constraint C bite." ;
    sh:targetClass fnd:InversePairing , fnd:Group ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "group rung (A, genuine inverse): this claimed inverse pairing is not a genuine two-sided inverse - x . inv(x) != e or inv(x) . x != e (the claimed inverse does not undo the operation to the model identity)." ;
        sh:select """
            SELECT $this WHERE {
              $this <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <urn:silmaril:fnd:#InversePairing> ;
                    <urn:silmaril:fnd:#pairingModel> ?mdl ; <urn:silmaril:fnd:#pairingElement> ?x ; <urn:silmaril:fnd:#pairingInverse> ?y .
              ?mdl <urn:silmaril:fnd:#hasIdentityElement> ?e .
              FILTER NOT EXISTS {
                ?xy <urn:silmaril:fnd:#opStructure> ?mdl ; <urn:silmaril:fnd:#opLeft> ?x ; <urn:silmaril:fnd:#opRight> ?y ; <urn:silmaril:fnd:#opResult> ?e .
                ?yx <urn:silmaril:fnd:#opStructure> ?mdl ; <urn:silmaril:fnd:#opLeft> ?y ; <urn:silmaril:fnd:#opRight> ?x ; <urn:silmaril:fnd:#opResult> ?e .
              }
            }
        """ ;
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "group rung (B, complete): this fnd:Group has a fnd:hasGroupElement with no fnd:InversePairing - a group element that is not invertible (the inverse law is UNIVERSAL over the carrier, not merely satisfied by the declared pairings)." ;
        sh:select """
            SELECT $this WHERE {
              $this <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <urn:silmaril:fnd:#Group> ;
                    <urn:silmaril:fnd:#hasGroupElement> ?x .
              FILTER NOT EXISTS {
                ?p <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <urn:silmaril:fnd:#InversePairing> ;
                   <urn:silmaril:fnd:#pairingModel> $this ; <urn:silmaril:fnd:#pairingElement> ?x .
              }
            }
        """ ;
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "group rung (C, carrier EXISTENCE): this fnd:Group (directly or via rdfs:subClassOf - every fnd:AbelianGroup / aob:SealedGroup) ENUMERATES no carrier - it carries NEITHER fnd:hasGroupElement NOR fnd:hasElement, so the inverse-COMPLETENESS clause (B) has nothing to quantify over and a carrier-less group escapes it. The carrier enumeration is the defining edge that makes inverse-completeness NOT opt-in (the guard-on-optional-edge close); a fnd:Group that omits it -> RED." ;
        sh:select """
            SELECT $this WHERE {
              $this <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <urn:silmaril:fnd:#Group> .
              FILTER NOT EXISTS {
                { $this <urn:silmaril:fnd:#hasGroupElement> ?ge } UNION { $this <urn:silmaril:fnd:#hasElement> ?he }
              }
            }
        """ ;
    ] .


# =====================================================================================
# fnd:AbelianCommShape (T4) — commutativity over the abelian-group rung witness (design s3; SYN). Symmetric
# to fnd:CommMonoidCommShape but scoped to a DISTINCT witness fnd:abelianModel, so a non-commutative
# "abelian group" is RED. Floor: A.B=E, B.A=E -> conforms; probe (fnd:appAbBA fnd:opResult -> fnd:elemB) -> RED.
# =====================================================================================

fnd:AbelianCommShape a sh:NodeShape ;
    rdfs:label "AbelianCommShape" ;
    rdfs:comment "The AbelianGroup-rung commutativity tooth with teeth on the reified operation table of fnd:abelianModel (algebra_spine.ttl, design s3). AbelianGroup is SYN (Helios has 'abelian group' only as the vol-20 colimit-non-preservation counterexample, 20/09/03:61,65). It makes the abelian (commutativity) law x.y = y.x a CHECKABLE graph fact, authored SYMMETRIC to fnd:CommMonoidCommShape (the same law re-added off Group, Directive 17 no-cram) but scoped to a DISTINCT witness so a non-commutative 'abelian group' is caught on its own model. CLASS-GENERAL (no witness IRI is hardcoded): a sh:sparql node shape targeting fnd:BinaryOperationApplication whose constraint QUANTIFIES OVER EVERY fnd:AbelianGroup instance ?mdl (bound by ?mdl rdf:type fnd:AbelianGroup, so under inference=rdfs it also catches the module additive group fnd:moduleAddGroup, itself a fnd:AbelianGroup, both genuinely commutative Z/3) and fires when there EXISTS a pair (x,y) over fnd:opStructure ?mdl with x.y != y.x. Every clause reads EDGE existence over the reified applications plus the ?mdl rdf:type guard, never a bare sh:class over an rdfs:range, so inference=rdfs cannot defang it - the SP1 defang discipline. On this floor the symmetric pairs of the abelian witness (A.B=E, B.A=E, self-sums A.A=B, B.B=A) and of fnd:moduleAddGroup conform; the probe of record - changing fnd:appAbBA fnd:opResult from fnd:elemE to fnd:elemB, so B.A = B while A.B = E - makes the shape bite (conforms=True->False), AND a FRESH correctly-typed non-commutative fnd:AbelianGroup instance is now caught too, proving the tooth is CLASS-GENERAL not witness-pinned." ;
    sh:targetClass fnd:BinaryOperationApplication ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "abelian-group rung: the operation of some fnd:AbelianGroup instance (?mdl a fnd:AbelianGroup) is NOT commutative - there is a pair (x,y) with x.y != y.x (a non-commutative structure claiming to be abelian)." ;
        sh:select """
            SELECT $this WHERE {
              $this <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <urn:silmaril:fnd:#BinaryOperationApplication> .
              ?mdl <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <urn:silmaril:fnd:#AbelianGroup> .
              ?xy <urn:silmaril:fnd:#opStructure> ?mdl ; <urn:silmaril:fnd:#opLeft> ?x ; <urn:silmaril:fnd:#opRight> ?y ; <urn:silmaril:fnd:#opResult> ?xyr .
              ?yx <urn:silmaril:fnd:#opStructure> ?mdl ; <urn:silmaril:fnd:#opLeft> ?y ; <urn:silmaril:fnd:#opRight> ?x ; <urn:silmaril:fnd:#opResult> ?yxr .
              FILTER(?xyr != ?yxr)
            }
        """ ;
    ] .


# =====================================================================================
# fnd:QuasigroupDivisionShape (T4) — Latin-square division over the WHOLE fnd:Quasigroup family (design s3;
# SYN, fully absent in Helios; generalised at L1 so it also witnesses fnd:loopModel's inherited division
# law, loopModel being a fnd:Quasigroup by subclass). A sh:sparql node shape targeting
# fnd:BinaryOperationApplication, mirroring q_quasigroup_division: it flags any fnd:Quasigroup model (bound
# by ?qg a fnd:Quasigroup, so fnd:quasigroupModel directly and fnd:loopModel via fnd:Loop subClassOf
# fnd:Quasigroup) whose table has non-unique right division (a fixed left operand yields the same result for
# two distinct right operands) OR non-unique left division (a fixed right operand yields the same result for
# two distinct left operands). Edge-existence, defang-proof. Floor: the 9-row Z/3 quasigroup Latin square AND
# the 25-row order-5 loop Latin square both conform; probe (fnd:appQgAC fnd:opResult -> fnd:elemB) duplicates
# the quasigroup A-row result B -> RED (still biting after the generalisation).
# =====================================================================================

fnd:QuasigroupDivisionShape a sh:NodeShape ;
    rdfs:label "QuasigroupDivisionShape" ;
    rdfs:comment "The Quasigroup-rung Latin-square-division tooth with teeth on the reified operation tables of the fnd:Quasigroup family (algebra_spine.ttl, design s3; generalised at L1 to also witness fnd:loopModel's inherited division). Quasigroup/loop are FULLY ABSENT from Helios (02_algebra_tower.md s1: grep zero), authored as cited standard universal algebra. It makes the Latin-square property (unique left and right division) a CHECKABLE graph fact. A sh:sparql node shape targeting fnd:BinaryOperationApplication with two constraints, each scoped by ?qg a fnd:Quasigroup (matching fnd:quasigroupModel directly and fnd:loopModel via fnd:Loop rdfs:subClassOf fnd:Quasigroup under inference=rdfs): (A) RIGHT-division uniqueness - fires when a fixed left operand ?a yields the SAME result ?r for two DISTINCT right operands ?x1 != ?x2 within one model (two right-divisors, a repeated result in a row); and (B) LEFT-division uniqueness - fires when a fixed right operand ?b yields the same result ?s for two DISTINCT left operands ?y1 != ?y2 within one model (a repeated result in a column). Both clauses read EDGE existence over the reified applications plus the rdf:type guard ?qg a fnd:Quasigroup, never a bare sh:class over an rdfs:range for the OPERANDS, so inference=rdfs cannot forge an op-row edge and defang it - the SP1 defang discipline; the ?qg type guard is essential (without it the non-Latin left-zero fnd:semigroupModel and the identity fnd:monoidModel rows would be read as division collisions), and it is exactly what admits the loop witness. On this floor BOTH the cyclic Z/3 quasigroup table (A.A=A,A.B=B,A.C=C,B.A=B,B.B=C,B.C=A,C.A=C,C.B=A,C.C=B) and the order-5 loop table fnd:loopModel (a verified Latin square with two-sided identity E) are Latin squares (each element once per row and column) so conforms=True; the probe of record - changing fnd:appQgAC fnd:opResult from fnd:elemC to fnd:elemB, so the quasigroup A-row has A.B=B AND A.C=B - makes right division non-unique and the shape bite (conforms=True->False), still biting after the generalisation, proving the tooth." ;
    sh:targetClass fnd:BinaryOperationApplication ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "quasigroup rung: the Cayley table of a fnd:Quasigroup family model (fnd:quasigroupModel or fnd:loopModel) is NOT a Latin square - a fixed left operand yields the same result for two distinct right operands (right division non-unique), or a fixed right operand yields the same result for two distinct left operands (left division non-unique)." ;
        sh:select """
            SELECT $this WHERE {
              $this <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <urn:silmaril:fnd:#BinaryOperationApplication> .
              {
                ?qg <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <urn:silmaril:fnd:#Quasigroup> .
                ?r1 <urn:silmaril:fnd:#opStructure> ?qg ; <urn:silmaril:fnd:#opLeft> ?a ; <urn:silmaril:fnd:#opRight> ?x1 ; <urn:silmaril:fnd:#opResult> ?r .
                ?r2 <urn:silmaril:fnd:#opStructure> ?qg ; <urn:silmaril:fnd:#opLeft> ?a ; <urn:silmaril:fnd:#opRight> ?x2 ; <urn:silmaril:fnd:#opResult> ?r .
                FILTER(?x1 != ?x2)
              } UNION {
                ?qg <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <urn:silmaril:fnd:#Quasigroup> .
                ?l1 <urn:silmaril:fnd:#opStructure> ?qg ; <urn:silmaril:fnd:#opLeft> ?y1 ; <urn:silmaril:fnd:#opRight> ?b ; <urn:silmaril:fnd:#opResult> ?s .
                ?l2 <urn:silmaril:fnd:#opStructure> ?qg ; <urn:silmaril:fnd:#opLeft> ?y2 ; <urn:silmaril:fnd:#opRight> ?b ; <urn:silmaril:fnd:#opResult> ?s .
                FILTER(?y1 != ?y2)
              }
            }
        """ ;
    ] .


# =====================================================================================
# fnd:LoopIdentityShape (T4, L1 close) — the two-sided-identity rung tooth on fnd:Loop (design s3; SYN,
# quasigroup/loop fully absent in Helios). This is the DISTINCT per-rung tooth for fnd:Loop's ADDED law
# over fnd:Quasigroup (identity), bringing Loop to parity with every sibling rung (each carries a witness +
# a biting law-tooth), exactly as fnd:AbelianCommShape gives fnd:AbelianGroup a distinct commutativity tooth
# even though commutativity is re-added. It closes the L1 hole: the lone identity tooth fnd:MonoidIdentityShape
# targets only SUBJECTS of fnd:hasIdentityElement, so a fnd:Loop that is a quasigroup with NO identity passed
# vacuously (no witness, no shape, no ASK focused on it). A sh:sparql node shape targeting fnd:Loop that fires
# when a fnd:Loop EITHER (branch 1) carries NO fnd:hasIdentityElement at all, OR (branch 2) carries a declared
# identity ?e that FAILS the two-sided unit law over its reified op table (a left row e.x with result != x, or
# a right row x.e with result != x). Both branches read EDGE existence (fnd:hasIdentityElement + the reified
# op rows), never a range-inferred rdf:type on operands, so inference=rdfs cannot defang it - the SP1 defang
# discipline. On this floor fnd:loopModel (a fnd:Loop with fnd:hasIdentityElement fnd:elemE and the 25-row
# order-5 Latin-square table whose E row/column reproduce the header) conforms; the probe of record - a
# fnd:Loop that is a quasigroup with NO fnd:hasIdentityElement (fnd:probeLoopNoIdentity) - makes branch 1
# bite (conforms=True->False), proving the tooth on the exact case L1 exposed. Mirrors q_loop_identity.
# =====================================================================================

fnd:LoopIdentityShape a sh:NodeShape ;
    rdfs:label "LoopIdentityShape" ;
    rdfs:comment "The Loop-rung two-sided-identity tooth with teeth on fnd:Loop (algebra_spine.ttl, design s3; L1 close). fnd:Loop's ADDED law over fnd:Quasigroup is the two-sided identity (the same law fnd:Monoid adds over fnd:Semigroup, here its own atom off the division sub-family, Directive 17 no-cram); quasigroup/loop are FULLY ABSENT from Helios (02_algebra_tower.md s1, grep zero), authored as cited standard universal algebra. This is the DISTINCT per-rung biting tooth for fnd:Loop, at parity with every sibling rung (a SYN worked-example witness fnd:loopModel + this law-tooth), symmetric to how fnd:AbelianCommShape gives fnd:AbelianGroup a distinct commutativity tooth over a distinct witness even though the law is re-added. It CLOSES the L1 hole: the lone identity tooth fnd:MonoidIdentityShape is sh:targetSubjectsOf fnd:hasIdentityElement, so it never focuses on a fnd:Loop that declares NO identity - an identity-less quasigroup-typed-as-loop stayed vacuously GREEN (no witness instance, no SHACL shape targeting fnd:Loop, no q_loop ASK). A sh:sparql node shape targeting fnd:Loop whose constraint fires on a UNION of two identity breaches over a focus loop $this: (branch 1, EXISTENCE) $this a fnd:Loop carries NO fnd:hasIdentityElement (a loop must have a two-sided unit; a quasigroup with no identity is not a loop); (branch 2, GENUINENESS) $this has fnd:hasIdentityElement ?e but a reified row with ?e on the left has fnd:opResult != its right operand (e.x != x, left-unit fails) OR a row with ?e on the right has result != its left operand (x.e != x, right-unit fails). Both branches read only EDGE existence over fnd:hasIdentityElement and the reified op rows scoped by fnd:opStructure to $this, never a bare sh:class over an rdfs:range, so inference=rdfs cannot defang it - the SP1 defang discipline; branch 1 uses the loop's rdf:type fnd:Loop (materialisable but not forgeable between two specific nodes) as focus, exactly the AlgebraProgenitorShape constraint-C pattern. On this floor fnd:loopModel (fnd:hasIdentityElement fnd:elemE; the 25 rows fnd:appLpEE..fnd:appLpDD whose E-row E.x=x and E-column x.E=x hold for all x) satisfies both branches and conforms=True; the probe of record - fnd:probeLoopNoIdentity a fnd:Loop with a Latin-square table but NO fnd:hasIdentityElement (a genuine quasigroup masquerading as a loop) - makes branch 1 bite (conforms=True->False), the exact case that passed vacuously before L1. Mirrors q_loop_identity." ;
    sh:targetClass fnd:Loop ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "loop rung: this fnd:Loop is not a genuine loop - it carries NO fnd:hasIdentityElement (a quasigroup with no two-sided unit), or its declared identity fails the unit law (a left row e.x has result != x, or a right row x.e has result != x)." ;
        sh:select """
            SELECT $this WHERE {
              $this <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <urn:silmaril:fnd:#Loop> .
              {
                FILTER NOT EXISTS { $this <urn:silmaril:fnd:#hasIdentityElement> ?e0 }
              } UNION {
                $this <urn:silmaril:fnd:#hasIdentityElement> ?e .
                ?rL <urn:silmaril:fnd:#opStructure> $this ; <urn:silmaril:fnd:#opLeft> ?e ; <urn:silmaril:fnd:#opRight> ?x ; <urn:silmaril:fnd:#opResult> ?rLr .
                FILTER(?rLr != ?x)
              } UNION {
                $this <urn:silmaril:fnd:#hasIdentityElement> ?e .
                ?rR <urn:silmaril:fnd:#opStructure> $this ; <urn:silmaril:fnd:#opLeft> ?x ; <urn:silmaril:fnd:#opRight> ?e ; <urn:silmaril:fnd:#opResult> ?rRr .
                FILTER(?rRr != ?x)
              }
            }
        """ ;
    ] .


# =====================================================================================
# fnd:AlgebraProgenitorShape (T4) — the agnostic progenitor grounds nothing + every concrete rung adds
# EXACTLY ONE law (design s3, Directive 17; the maintainer byte_order / crs-geometer progenitor pattern).
# A sh:sparql node shape with THREE targets (sh:targetNode fnd:AlgebraicStructure for grounds-nothing;
# sh:targetSubjectsOf fnd:addsLaw for no-cram; sh:targetClass fnd:PresentedAlgebra for the adds-a-law lower
# bound), each constraint self-guarded. Constraint A: the progenitor node fnd:AlgebraicStructure must carry
# NO fnd:addsLaw, NO fnd:hasSignature, NO fnd:hasCarrier (it grounds nothing). Constraint B (<=1 upper
# bound): no rung may carry two distinct fnd:addsLaw (one law per child, never crammed). Constraint C (>=1
# lower bound): every CONCRETE rung (a fnd:PresentedAlgebra that is rdfs:subClassOf the progenitor) must
# carry at least one fnd:addsLaw - so a rung stripped of its added law is REJECTED; the agnostic progenitor
# (not a fnd:PresentedAlgebra) and the engine's fnd:witnessPresentedAlgebra (not a subClassOf the
# progenitor) are both excluded from C. B and C together = EXACTLY ONE law per concrete rung. Edge-
# existence, defang-proof. Floor: the progenitor is bare, every concrete rung has exactly one addsLaw ->
# conforms; probes - (A) fnd:AlgebraicStructure fnd:addsLaw fnd:lawInverse, (B) a rung a second addsLaw,
# (C) delete fnd:Semigroup fnd:addsLaw fnd:lawAssociativity (a lawless rung) - each -> RED.
# =====================================================================================

fnd:AlgebraProgenitorShape a sh:NodeShape ;
    rdfs:label "AlgebraProgenitorShape" ;
    rdfs:comment "The agnostic-progenitor tooth with teeth on fnd:AlgebraicStructure and on the tower rungs (algebra_spine.ttl, design s3, Directive 17). It makes two doctrines graph facts: (1) the agnostic progenitor GROUNDS NOTHING (the LIFTED byte_order / crs-geometer progenitor pattern, 02_algebra_tower.md s3, basicttl/crs/geometers.ttl:76), and (2) NO rung crams two laws (one law per child, the source's own 'add one clause at a time' discipline, 26/03/04:24-50). A sh:sparql node shape with TWO targets - sh:targetNode fnd:AlgebraicStructure (the grounds-nothing focus) and sh:targetSubjectsOf fnd:addsLaw (every rung) - carrying TWO self-guarded sh:sparql constraints. Constraint A (grounds nothing) fires when $this = fnd:AlgebraicStructure carries a fnd:addsLaw, a fnd:hasSignature, or a fnd:hasCarrier (the progenitor must ground no law, no signature, no carrier - it is not a fnd:PresentedAlgebra). Constraint B (no cram, the <=1 upper bound) fires when $this carries TWO DISTINCT fnd:addsLaw (a rung adding more than one law). Constraint C (adds-a-law, the >=1 lower bound) fires when $this is a CONCRETE rung - a fnd:PresentedAlgebra that is rdfs:subClassOf the agnostic fnd:AlgebraicStructure progenitor - carrying NO fnd:addsLaw at all (a rung stripped of its added law); it deliberately EXCLUDES the agnostic progenitor (not a fnd:PresentedAlgebra, correctly carries zero addsLaw) and the engine's fnd:witnessPresentedAlgebra (a fnd:PresentedAlgebra but NOT rdfs:subClassOf the progenitor, so not a tower rung). B and C together make 'EXACTLY ONE law per concrete rung' a graph fact (design s3 / plan T4 promise 'a rung minus its added law -> RED'). Each constraint self-guards (A on $this = fnd:AlgebraicStructure, B on the count of fnd:addsLaw, C on the concrete-rung type+subclass with zero addsLaw), so each no-ops on the irrelevant target - the same self-guarded multi-target pattern crs:PlaneProgenitorShape uses. All read EDGE existence (fnd:addsLaw / fnd:hasSignature / fnd:hasCarrier) or rdf:type + rdfs:subClassOf (the concrete-rung guard of C), never a bare sh:class over a property's rdfs:range, so inference=rdfs cannot defang them - the SP1 defang discipline. On this floor fnd:AlgebraicStructure is bare (no law, no signature, no carrier) and every concrete rung carries exactly one fnd:addsLaw, so conforms=True; the probes of record - (a) fnd:AlgebraicStructure fnd:addsLaw fnd:lawInverse (the progenitor grounding a law) fires constraint A, (b) adding a second fnd:addsLaw to any rung (e.g. fnd:Semigroup fnd:addsLaw fnd:lawIdentity, cramming two laws) fires constraint B, and (c) deleting fnd:Semigroup fnd:addsLaw fnd:lawAssociativity (a concrete rung stripped of its sole law) fires constraint C while the agnostic progenitor (zero addsLaw) stays GREEN - each makes the shape bite (conforms=True->False), proving all three teeth." ;
    sh:targetNode fnd:AlgebraicStructure ;
    sh:targetSubjectsOf fnd:addsLaw ;
    sh:targetClass fnd:PresentedAlgebra ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "algebra progenitor 'grounds nothing' (A): the agnostic fnd:AlgebraicStructure progenitor carries a fnd:addsLaw, a fnd:hasSignature, or a fnd:hasCarrier - it must ground NOTHING (no law, no signature, no carrier; it is not a fnd:PresentedAlgebra)." ;
        sh:select """
            SELECT $this WHERE {
              FILTER($this = <urn:silmaril:fnd:#AlgebraicStructure>)
              {
                $this <urn:silmaril:fnd:#addsLaw> ?l .
              } UNION {
                $this <urn:silmaril:fnd:#hasSignature> ?s .
              } UNION {
                $this <urn:silmaril:fnd:#hasCarrier> ?c .
              }
            }
        """ ;
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "algebra rung 'no cram' (B): this rung carries TWO DISTINCT fnd:addsLaw - a rung must add EXACTLY ONE law over its parent (Directive 17, never crammed)." ;
        sh:select """
            SELECT $this WHERE {
              $this <urn:silmaril:fnd:#addsLaw> ?l1 , ?l2 .
              FILTER(?l1 != ?l2)
            }
        """ ;
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "algebra rung 'adds a law' (C): this CONCRETE rung (a fnd:PresentedAlgebra that is rdfs:subClassOf the agnostic fnd:AlgebraicStructure progenitor) carries NO fnd:addsLaw - every concrete rung must add EXACTLY ONE law over its parent (Directive 17: the >=1 lower bound complementing the <=1 no-cram bound). Only the agnostic progenitor, which grounds nothing and is not a fnd:PresentedAlgebra, may carry zero fnd:addsLaw." ;
        sh:select """
            SELECT $this WHERE {
              $this a <urn:silmaril:fnd:#PresentedAlgebra> .
              $this <http://www.w3.org/2000/01/rdf-schema#subClassOf> <urn:silmaril:fnd:#AlgebraicStructure> .
              FILTER NOT EXISTS { $this <urn:silmaril:fnd:#addsLaw> ?l }
            }
        """ ;
    ] .


# =====================================================================================
# fnd:MonoidIsEndoShape (T4) — the Monoid rung IS a one-object category / F(X,X) (the Pillar-4 seam;
# design s3/s5; LIFTED 'monoid = one-object category', 21/05/04). A sh:sparql node shape targeting
# subjects of fnd:monoidAsCategory: it flags a monoid recognized as a one-object category whose monoid
# identity element is NOT the category's object-identity arrow (an endomorphism X->X). Edge-existence,
# defang-proof. Floor: fnd:endoMonoidWitness identity = fnd:idEndoX = objectIdentityArrow, endo X->X ->
# conforms; probe (fnd:endoMonoidWitness fnd:hasIdentityElement -> fnd:elemA) breaks the coincidence -> RED.
# =====================================================================================

fnd:MonoidIsEndoShape a sh:NodeShape ;
    rdfs:label "MonoidIsEndoShape" ;
    rdfs:comment "The Monoid = one-object category = F(X,X) seam tooth with teeth on the subjects of fnd:monoidAsCategory (algebra_spine.ttl, design s3/s5) - the Pillar-2/Pillar-4 seam. LIFTED (DS): Helios authors 'a monoid is a one-object category' with End_C(X), product=composition, unit=id_X (helios/srcy/papers/21_ologs_and_typed_english/chapters/05_yoneda_for_typed_english/sections/04_monoid_monad_yoneda_binders.tex:2,16-17,36-39; M_X=Hom(X,X), 31/01). It makes the seam a CHECKABLE graph fact: the endomorphism monoid's identity IS the object's id_X. A sh:sparql node shape (sh:targetSubjectsOf fnd:monoidAsCategory) whose constraint fires when a monoid ?mm with fnd:monoidAsCategory ?c and fnd:hasIdentityElement ?id fails the coincidence - it is NOT the case that ?c fnd:objectIdentityArrow ?id with ?c fnd:soleObject ?x and ?id an endomorphism X->X (fnd:endoDomain ?x, fnd:endoCodomain ?x). Every clause reads EDGE existence (fnd:monoidAsCategory / fnd:hasIdentityElement / fnd:objectIdentityArrow / fnd:soleObject / fnd:endoDomain / fnd:endoCodomain), never a bare sh:class over an rdfs:range, so inference=rdfs cannot forge the identity=id_X coincidence and defang it - the SP1 defang discipline. On this floor fnd:endoMonoidWitness (fnd:monoidAsCategory fnd:oneObjectCat; fnd:hasIdentityElement fnd:idEndoX, which is fnd:oneObjectCat's fnd:objectIdentityArrow and an endomorphism of fnd:endoObjectX) conforms; the probe of record - changing fnd:endoMonoidWitness fnd:hasIdentityElement from fnd:idEndoX to fnd:elemA (a non-identity element that is not id_X) - makes the monoid identity differ from the object identity arrow and the shape bite (conforms=True->False), proving the seam tooth." ;
    sh:targetSubjectsOf fnd:monoidAsCategory ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "monoid = one-object category seam: this monoid is recognized as a one-object category but its fnd:hasIdentityElement is NOT the category's fnd:objectIdentityArrow (id_X), an endomorphism X->X of the sole object - the monoid identity does not coincide with id_X, so it is not End(X)=F(X,X)." ;
        sh:select """
            SELECT $this WHERE {
              $this <urn:silmaril:fnd:#monoidAsCategory> ?c ; <urn:silmaril:fnd:#hasIdentityElement> ?id .
              FILTER NOT EXISTS {
                ?c <urn:silmaril:fnd:#objectIdentityArrow> ?id ; <urn:silmaril:fnd:#soleObject> ?x .
                ?id <urn:silmaril:fnd:#endoDomain> ?x ; <urn:silmaril:fnd:#endoCodomain> ?x .
              }
            }
        """ ;
    ] .


# =====================================================================================
# fnd:RingDistribShape (T5) — left-distributivity over the ring rung witness (design s3; the two-operation
# line is SYN, ring absent as algebra in Helios, 02_algebra_tower.md:134-136). A sh:sparql node shape
# targeting fnd:RingOperationApplication, mirroring q_ring_distrib: it flags the ring witness if ANY triple
# (x,y,z) over fnd:ringStructure fnd:ringModel has x·(y+z) != (x·y)+(x·z), reading the reified two-operation
# table (fnd:ringOp fnd:additiveOp / fnd:multiplicativeOp). Edge-existence over the reified applications,
# never a range-inferred rdf:type, so inference=rdfs cannot forge a row and defang it. Floor: the full GF(3)
# tables make every triple distribute; probe (fnd:appRingMul_1_2 fnd:ringResult -> fnd:ringOne) makes (1,1,1)
# fail (1·(1+1)=1 != 2=(1·1)+(1·1)) -> RED.
# =====================================================================================

fnd:RingDistribShape a sh:NodeShape ;
    rdfs:label "RingDistribShape" ;
    rdfs:comment "The Semiring-rung distributivity tooth with teeth on the reified two-operation table of every fnd:Semiring model (algebra_rings.ttl, design s3). It makes the FULL TWO-SIDED distributivity law x·(y+z) = x·y + x·z (left) AND (y+z)·x = y·x + z·x (right) a CHECKABLE graph fact, the two-operation analogue of fnd:SemigroupAssocShape one file up. Distributivity is fnd:Semiring's OWN added law (fnd:Semiring fnd:addsLaw fnd:lawDistributivity, algebra_rings.ttl:490; fnd:satisfiesLaw fnd:lawDistributivity, :497), NOT a law of the strict subclass fnd:Ring (which adds fnd:lawAdditiveInverse), so the tooth MUST bite class-general over the class where the law is ADDED, fnd:Semiring - broadening the earlier fnd:Ring-scoped guard that let a fresh, correctly-typed bare fnd:Semiring with a non-distributive reified two-operation table pass GREEN (the sub-population-enforcement escape the review targets: the defining law of a rung enforced only on a proper subclass). The whole two-operation line is SYN (ring is FULLY ABSENT as algebra in Helios - 'No algebraic ring, field (only record-field), or module', 02_algebra_tower.md:134-136; 'No +/x distributivity axioms', :132), authored as cited standard ring theory. CLASS-GENERAL (no witness IRI is hardcoded) AND COMPLETE-LAW (both distributive sides): a sh:sparql node shape targeting fnd:RingOperationApplication with TWO sh:sparql constraints, each QUANTIFYING OVER EVERY fnd:Semiring instance ?mdl (bound by ?mdl rdf:type fnd:Semiring, so under inference=rdfs it matches the ring witness fnd:ringModel and the field witness fnd:fieldModel - both fnd:Semiring since fnd:Ring rdfs:subClassOf fnd:Semiring and fnd:Field rdfs:subClassOf fnd:Ring - AND any bare fnd:Semiring, e.g. the canonical semiring N0), mirroring fnd:GroupInverseShape/fnd:FieldMultInverseShape rather than pinning a single model or a strict subclass. Constraint 1 (LEFT) fires when there EXISTS a triple (x,y,z) over fnd:ringStructure ?mdl with x·(y+z) != (x·y)+(x·z); constraint 2 (RIGHT) fires when (y+z)·x != (y·x)+(z·x). To keep each five-way self-join bounded (never an unconstrained per-focus explosion), $this is ANCHORED as the additive y+z row itself (fnd:ringOp fnd:additiveOp, ringLeft=y, ringRight=z, ringResult=s), then ?mdl is bound from that row and rdf:type-guarded fnd:Semiring; the left constraint forms x·(y+z) via an fnd:multiplicativeOp row (ringLeft=x,ringRight=s), x·y and x·z, (x·y)+(x·z), FILTER(lft != rgt); the right constraint forms (y+z)·x via a row (ringLeft=s,ringRight=x), y·x and z·x, (y·x)+(z·x), FILTER(lft != rgt). Distributivity is a TWO-sided law and right distributivity does NOT follow from left for a non-commutative semiring, so BOTH clauses are required for the COMPLETE law (the earlier witness-pinned tooth checked only left, arguing 'commutativity of GF(3) makes right follow' - a witness-specific escape a fresh non-commutative left-only structure would slip through; W-SP0-B closes it). Every clause reads EDGE existence over the reified applications (fnd:ringStructure/fnd:ringOp/fnd:ringLeft/fnd:ringRight/fnd:ringResult) plus the ?mdl rdf:type guard, never a bare sh:class over an rdfs:range, so inference=rdfs cannot forge a two-operation row and defang it - the SP1 defang discipline. On this floor the full GF(3) additive and multiplicative Cayley tables of fnd:ringModel make every distributivity triple hold on both sides (and fnd:fieldModel's sparser table has no closing violating chain), and no bare fnd:Semiring instance exists to widen the checked set, so broadening the guard leaves conforms=True; the probe of record - changing fnd:appRingMul_1_2 (1·2) fnd:ringResult from fnd:ringTwo to fnd:ringOne, so for the triple (1,1,1) x·(y+z) = 1·(1+1) = 1·2 = 1 while (x·y)+(x·z) = (1·1)+(1·1) = 1+1 = 2 - makes constraint 1 bite (conforms=True->False), a symmetric perturbation of a s·x row makes constraint 2 bite, AND a FRESH correctly-typed non-distributive bare fnd:Semiring instance (a new ?mdl a fnd:Semiring with a non-distributive reified two-operation table, grounding at fnd:Semiring not fnd:Ring) is now caught too, proving the tooth is CLASS-GENERAL over the class where the law is added and the law COMPLETE." ;
    sh:targetClass fnd:RingOperationApplication ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "semiring rung (left distributivity): the operation of some fnd:Semiring instance (?mdl a fnd:Semiring, including fnd:Ring and fnd:Field by rdfs:subClassOf) is NOT left-distributive - there is a triple (x,y,z) whose two sides x·(y+z) and (x·y)+(x·z) evaluate to different fnd:ringResult." ;
        sh:select """
            SELECT $this WHERE {
              $this <urn:silmaril:fnd:#ringStructure> ?mdl ; <urn:silmaril:fnd:#ringOp> <urn:silmaril:fnd:#additiveOp> ; <urn:silmaril:fnd:#ringLeft> ?y ; <urn:silmaril:fnd:#ringRight> ?z ; <urn:silmaril:fnd:#ringResult> ?s .
              ?mdl <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <urn:silmaril:fnd:#Semiring> .
              ?mxs <urn:silmaril:fnd:#ringStructure> ?mdl ; <urn:silmaril:fnd:#ringOp> <urn:silmaril:fnd:#multiplicativeOp> ; <urn:silmaril:fnd:#ringLeft> ?x ; <urn:silmaril:fnd:#ringRight> ?s ; <urn:silmaril:fnd:#ringResult> ?lft .
              ?mxy <urn:silmaril:fnd:#ringStructure> ?mdl ; <urn:silmaril:fnd:#ringOp> <urn:silmaril:fnd:#multiplicativeOp> ; <urn:silmaril:fnd:#ringLeft> ?x ; <urn:silmaril:fnd:#ringRight> ?y ; <urn:silmaril:fnd:#ringResult> ?p .
              ?mxz <urn:silmaril:fnd:#ringStructure> ?mdl ; <urn:silmaril:fnd:#ringOp> <urn:silmaril:fnd:#multiplicativeOp> ; <urn:silmaril:fnd:#ringLeft> ?x ; <urn:silmaril:fnd:#ringRight> ?z ; <urn:silmaril:fnd:#ringResult> ?q .
              ?apq <urn:silmaril:fnd:#ringStructure> ?mdl ; <urn:silmaril:fnd:#ringOp> <urn:silmaril:fnd:#additiveOp> ; <urn:silmaril:fnd:#ringLeft> ?p ; <urn:silmaril:fnd:#ringRight> ?q ; <urn:silmaril:fnd:#ringResult> ?rgt .
              FILTER(?lft != ?rgt)
            }
        """ ;
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "semiring rung (right distributivity): the operation of some fnd:Semiring instance (?mdl a fnd:Semiring, including fnd:Ring and fnd:Field by rdfs:subClassOf) is NOT right-distributive - there is a triple (x,y,z) whose two sides (y+z)·x and (y·x)+(z·x) evaluate to different fnd:ringResult (distributivity is a TWO-sided law; right distributivity does not follow from left for a non-commutative ring)." ;
        sh:select """
            SELECT $this WHERE {
              $this <urn:silmaril:fnd:#ringStructure> ?mdl ; <urn:silmaril:fnd:#ringOp> <urn:silmaril:fnd:#additiveOp> ; <urn:silmaril:fnd:#ringLeft> ?y ; <urn:silmaril:fnd:#ringRight> ?z ; <urn:silmaril:fnd:#ringResult> ?s .
              ?mdl <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <urn:silmaril:fnd:#Semiring> .
              ?msx <urn:silmaril:fnd:#ringStructure> ?mdl ; <urn:silmaril:fnd:#ringOp> <urn:silmaril:fnd:#multiplicativeOp> ; <urn:silmaril:fnd:#ringLeft> ?s ; <urn:silmaril:fnd:#ringRight> ?x ; <urn:silmaril:fnd:#ringResult> ?lft .
              ?myx <urn:silmaril:fnd:#ringStructure> ?mdl ; <urn:silmaril:fnd:#ringOp> <urn:silmaril:fnd:#multiplicativeOp> ; <urn:silmaril:fnd:#ringLeft> ?y ; <urn:silmaril:fnd:#ringRight> ?x ; <urn:silmaril:fnd:#ringResult> ?p .
              ?mzx <urn:silmaril:fnd:#ringStructure> ?mdl ; <urn:silmaril:fnd:#ringOp> <urn:silmaril:fnd:#multiplicativeOp> ; <urn:silmaril:fnd:#ringLeft> ?z ; <urn:silmaril:fnd:#ringRight> ?x ; <urn:silmaril:fnd:#ringResult> ?q .
              ?apq <urn:silmaril:fnd:#ringStructure> ?mdl ; <urn:silmaril:fnd:#ringOp> <urn:silmaril:fnd:#additiveOp> ; <urn:silmaril:fnd:#ringLeft> ?p ; <urn:silmaril:fnd:#ringRight> ?q ; <urn:silmaril:fnd:#ringResult> ?rgt .
              FILTER(?lft != ?rgt)
            }
        """ ;
    ] .


# =====================================================================================
# fnd:RingAdditiveInverseShape (T5 / W1a) — every fnd:Ring element has a two-sided ADDITIVE inverse (design
# s3; the two-operation line is SYN, ring absent as algebra in Helios). fnd:Ring's SOLE added law
# fnd:lawAdditiveInverse (algebra_rings.ttl) previously had NO tooth - the ring-family teeth tested only
# distributivity (the Semiring law) and multiplicative inverse (the Field law), so a semiring-with-no-
# additive-inverse typed fnd:Ring passed GREEN. This shape closes it, mirroring fnd:FieldMultInverseShape:
# TWO targets (sh:targetClass fnd:AdditiveInversePairing genuineness + sh:targetClass fnd:Ring completeness),
# each self-guarded. Constraint A (genuine): a claimed pairing (element x, inverse y, model with zero 0)
# unless x+y = 0 AND y+x = 0 (over the reified fnd:additiveOp table) -> RED. Constraint B (complete): a
# fnd:Ring with a fnd:hasRingElement carrying no fnd:AdditiveInversePairing -> RED. Edge-existence,
# defang-proof. Floor: fnd:ringModel + fnd:fieldModel (both fnd:Ring - Field rdfs:subClassOf Ring) each
# carry additive-inverse pairings 0<->0, 1<->2, 2<->1 -> conforms. PROBE OF RECORD: a Boolean-OR "ring"
# on {0,1} (1+1=1, so 1 has no additive inverse) whose element 1 carries no pairing -> constraint B bites.
# =====================================================================================

fnd:RingAdditiveInverseShape a sh:NodeShape ;
    rdfs:label "RingAdditiveInverseShape" ;
    rdfs:comment "The Ring-rung additive-inverse tooth with teeth on fnd:AdditiveInversePairing and fnd:Ring (algebra_rings.ttl, design s3; W1a close). fnd:Ring's characterising step over fnd:Semiring is fnd:lawAdditiveInverse - the additive monoid (S,+,0) is upgraded to an ABELIAN GROUP (every x has -x with x+(-x)=0) - but that law had NO biting tooth: the ring-family teeth checked only distributivity (fnd:RingDistribShape, the Semiring law) and multiplicative inverse (fnd:FieldMultInverseShape, the Field law), so a semiring-with-no-additive-inverse typed fnd:Ring passed GREEN (the W1a hole). Ring is FULLY ABSENT as algebra in Helios (02_algebra_tower.md:134-136), authored as cited standard ring theory; this tooth is the ADDITIVE analogue of fnd:FieldMultInverseShape and reuses the SP2/T4 genuine-inverse discipline (a claimed inverse that does not undo -> RED). It makes two doctrines graph facts: (A) every claimed additive-inverse pairing genuinely two-sidedly reaches the ring's zero, and (B) every ring element actually carries such a pairing. A sh:sparql node shape with TWO targets - sh:targetClass fnd:AdditiveInversePairing and sh:targetClass fnd:Ring - carrying TWO self-guarded sh:sparql constraints (the same multi-target self-guarded pattern fnd:FieldMultInverseShape uses). Constraint A fires when $this a fnd:AdditiveInversePairing (fnd:aipModel ?rng with fnd:hasZeroElement ?zero, fnd:aipElement ?x, fnd:aipInverse ?y) has NO reified additive row x+y = 0 OR no row y+x = 0 over fnd:ringStructure ?rng with fnd:ringOp fnd:additiveOp. Constraint B fires when $this a fnd:Ring has a fnd:hasRingElement ?e and there is NO fnd:AdditiveInversePairing over $this with fnd:aipElement ?e (an element with no additive inverse). Each constraint self-guards on $this's type, so each no-ops on the irrelevant target. Both read EDGE existence over the reified applications and pairing/enumeration edges, never a bare sh:class over an rdfs:range, so inference=rdfs cannot defang it - the SP1 defang discipline. On this floor fnd:ringModel and fnd:fieldModel (a fnd:Field rdfs:subClassOf fnd:Ring, so also targeted) both carry the GF(3) additive-group inverses 0<->0, 1<->2, 2<->1 with the reified additive rows 0+0=0, 1+2=0, 2+1=0, so conforms=True; the probe of record - a Boolean-OR 'ring' on {0,1} with 1+1=1 (so nothing + 1 = 0 and element 1 has NO additive inverse), carrying an fnd:AdditiveInversePairing only for 0 - makes constraint B bite for that ring's element 1 (conforms=True->False), a semiring-with-no-additive-inverse masquerading as a ring, proving the tooth. Constraint C (carrier EXISTENCE, the guard-on-optional-edge close) fires when a fnd:Ring (or fnd:Field) ENUMERATES no carrier (no fnd:hasRingElement) or declares no fnd:hasZeroElement - the very edges B quantifies over - so that additive-inverse completeness is not opt-in: a carrier-less ring, which would pass B vacuously, is now RED. On this floor fnd:ringModel and fnd:fieldModel both enumerate fnd:hasRingElement 0/1/2 and declare fnd:hasZeroElement, so conforms=True; the probe - a fnd:Ring with no fnd:hasRingElement - makes constraint C bite. Mirrors q_ring_additive_inverse." ;
    sh:targetClass fnd:AdditiveInversePairing , fnd:Ring ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "ring rung (A, genuine additive inverse): this claimed additive-inverse pairing is not a genuine two-sided inverse - x + inv(x) != 0 or inv(x) + x != 0 (the claimed additive inverse does not sum to the ring's zero)." ;
        sh:select """
            SELECT $this WHERE {
              $this <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <urn:silmaril:fnd:#AdditiveInversePairing> ;
                    <urn:silmaril:fnd:#aipModel> ?rng ; <urn:silmaril:fnd:#aipElement> ?x ; <urn:silmaril:fnd:#aipInverse> ?y .
              ?rng <urn:silmaril:fnd:#hasZeroElement> ?zero .
              FILTER NOT EXISTS {
                ?xy <urn:silmaril:fnd:#ringStructure> ?rng ; <urn:silmaril:fnd:#ringOp> <urn:silmaril:fnd:#additiveOp> ; <urn:silmaril:fnd:#ringLeft> ?x ; <urn:silmaril:fnd:#ringRight> ?y ; <urn:silmaril:fnd:#ringResult> ?zero .
                ?yx <urn:silmaril:fnd:#ringStructure> ?rng ; <urn:silmaril:fnd:#ringOp> <urn:silmaril:fnd:#additiveOp> ; <urn:silmaril:fnd:#ringLeft> ?y ; <urn:silmaril:fnd:#ringRight> ?x ; <urn:silmaril:fnd:#ringResult> ?zero .
              }
            }
        """ ;
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "ring rung (B, complete): this fnd:Ring has a fnd:hasRingElement with no fnd:AdditiveInversePairing - an element that is not additively invertible (the additive-inverse law is UNIVERSAL over the carrier; a semiring masquerading as a ring)." ;
        sh:select """
            SELECT $this WHERE {
              $this <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <urn:silmaril:fnd:#Ring> ;
                    <urn:silmaril:fnd:#hasRingElement> ?e .
              FILTER NOT EXISTS { ?q <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <urn:silmaril:fnd:#AdditiveInversePairing> ; <urn:silmaril:fnd:#aipModel> $this ; <urn:silmaril:fnd:#aipElement> ?e }
            }
        """ ;
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "ring rung (C, carrier EXISTENCE): this fnd:Ring (directly or via rdfs:subClassOf - every fnd:Field) ENUMERATES no carrier (no fnd:hasRingElement) or declares no additive identity (no fnd:hasZeroElement) - the defining edges the additive-inverse-COMPLETENESS clause (B) quantifies over are OMITTED, so a carrier-less ring escapes completeness; a fnd:Ring that omits either edge -> RED (the guard-on-optional-edge close)." ;
        sh:select """
            SELECT $this WHERE {
              $this <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <urn:silmaril:fnd:#Ring> .
              {
                FILTER NOT EXISTS { $this <urn:silmaril:fnd:#hasRingElement> ?e }
              } UNION {
                FILTER NOT EXISTS { $this <urn:silmaril:fnd:#hasZeroElement> ?z }
              }
            }
        """ ;
    ] .


# =====================================================================================
# fnd:FieldMultInverseShape (T5) — every nonzero field element is multiplicatively invertible (design s3;
# field absent as algebra, SYN). A sh:sparql node shape with TWO targets: sh:targetClass fnd:MultInversePairing
# (genuineness) and sh:targetClass fnd:Field (completeness), each constraint self-guarded (the same
# multi-target pattern fnd:AlgebraProgenitorShape uses). Constraint A (genuine): a claimed pairing (element
# x, inverse y, model with one-element 1) unless x·y = 1 AND y·x = 1 -> RED. Constraint B (complete): a field
# with a nonzero fnd:hasRingElement carrying no fnd:MultInversePairing -> RED. Edge-existence, defang-proof.
# Floor: 1<->1, 2<->2 with 1·1=1, 2·2=1 -> conforms; probe (fnd:appFieldMul_2_2 fnd:ringResult -> fnd:fieldTwo)
# makes 2·2=2 != 1 -> RED.
# =====================================================================================

fnd:FieldMultInverseShape a sh:NodeShape ;
    rdfs:label "FieldMultInverseShape" ;
    rdfs:comment "The Field-rung multiplicative-inverse tooth with teeth on fnd:MultInversePairing and fnd:Field (algebra_rings.ttl, design s3). Field is FULLY ABSENT as algebra in Helios (only record-field, 02_algebra_tower.md:134-136), authored as cited standard field theory; this tooth is the MULTIPLICATIVE analogue of fnd:GroupInverseShape and reuses the SP2/T4 genuine-inverse discipline (a claimed inverse that does not undo -> RED). It makes two doctrines graph facts: (A) every claimed multiplicative-inverse pairing genuinely two-sidedly reaches the field's one, and (B) every nonzero field element actually carries such a pairing. A sh:sparql node shape with TWO targets - sh:targetClass fnd:MultInversePairing and sh:targetClass fnd:Field - carrying TWO self-guarded sh:sparql constraints (the same multi-target self-guarded pattern fnd:AlgebraProgenitorShape uses). Constraint A fires when $this a fnd:MultInversePairing (fnd:mipModel ?fld with fnd:hasOneElement ?one, fnd:mipElement ?x, fnd:mipInverse ?y) has NO reified multiplicative row x·y = 1 OR no row y·x = 1 over fnd:ringStructure ?fld. Constraint B fires when $this a fnd:Field has a fnd:hasRingElement ?e that is not its fnd:hasZeroElement and there is NO fnd:MultInversePairing over $this with fnd:mipElement ?e (a nonzero element with no inverse). Each constraint self-guards on $this's type, so each no-ops on the irrelevant target. Both read EDGE existence over the reified applications and pairing/enumeration edges, never a bare sh:class over an rdfs:range, so inference=rdfs cannot defang it - the SP1 defang discipline. On this floor the GF(3) field fnd:fieldModel (1·1=1, 2·2=1; pairings 1<->1, 2<->2 for the nonzero elements 1 and 2) conforms; the probe of record - changing fnd:appFieldMul_2_2 (2·2) fnd:ringResult from fnd:fieldOne to fnd:fieldTwo, so 2·2 = 2 != 1 - makes constraint A bite for fnd:mipPairTwo (conforms=True->False), a 'field' with a non-invertible nonzero element, proving the tooth. Constraint C (one-element EXISTENCE, the guard-on-optional-edge close) fires when a fnd:Field declares no fnd:hasOneElement - the multiplicative identity 1 that constraint A binds as the inverse target (x.inv(x)=1) - so a one-less field, which A would skip for lack of a bound 1, is now RED. On this floor fnd:fieldModel declares fnd:hasOneElement fnd:fieldOne, so conforms=True; the probe - a fnd:Field with no fnd:hasOneElement - makes constraint C bite." ;
    sh:targetClass fnd:MultInversePairing , fnd:Field ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "field rung (A, genuine inverse): this claimed multiplicative-inverse pairing is not a genuine two-sided inverse - x · inv(x) != 1 or inv(x) · x != 1 (the claimed inverse does not multiply to the field's one)." ;
        sh:select """
            SELECT $this WHERE {
              $this <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <urn:silmaril:fnd:#MultInversePairing> ;
                    <urn:silmaril:fnd:#mipModel> ?fld ; <urn:silmaril:fnd:#mipElement> ?x ; <urn:silmaril:fnd:#mipInverse> ?y .
              ?fld <urn:silmaril:fnd:#hasOneElement> ?one .
              FILTER NOT EXISTS {
                ?xy <urn:silmaril:fnd:#ringStructure> ?fld ; <urn:silmaril:fnd:#ringOp> <urn:silmaril:fnd:#multiplicativeOp> ; <urn:silmaril:fnd:#ringLeft> ?x ; <urn:silmaril:fnd:#ringRight> ?y ; <urn:silmaril:fnd:#ringResult> ?one .
                ?yx <urn:silmaril:fnd:#ringStructure> ?fld ; <urn:silmaril:fnd:#ringOp> <urn:silmaril:fnd:#multiplicativeOp> ; <urn:silmaril:fnd:#ringLeft> ?y ; <urn:silmaril:fnd:#ringRight> ?x ; <urn:silmaril:fnd:#ringResult> ?one .
              }
            }
        """ ;
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "field rung (B, complete): this fnd:Field has a nonzero fnd:hasRingElement with no fnd:MultInversePairing - a nonzero element that is not multiplicatively invertible." ;
        sh:select """
            SELECT $this WHERE {
              $this <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <urn:silmaril:fnd:#Field> ;
                    <urn:silmaril:fnd:#hasRingElement> ?e ; <urn:silmaril:fnd:#hasZeroElement> ?zero .
              FILTER(?e != ?zero)
              FILTER NOT EXISTS { ?q <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <urn:silmaril:fnd:#MultInversePairing> ; <urn:silmaril:fnd:#mipModel> $this ; <urn:silmaril:fnd:#mipElement> ?e }
            }
        """ ;
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "field rung (C, one-element EXISTENCE): this fnd:Field declares no fnd:hasOneElement - the multiplicative identity 1 the inverse must reach (x.inv(x)=1) is OMITTED, so the genuineness clause (A) has no target 1 to bind and a one-less field escapes it; a fnd:Field that omits fnd:hasOneElement -> RED (the guard-on-optional-edge close)." ;
        sh:select """
            SELECT $this WHERE {
              $this <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <urn:silmaril:fnd:#Field> .
              FILTER NOT EXISTS { $this <urn:silmaril:fnd:#hasOneElement> ?one }
            }
        """ ;
    ] .


# =====================================================================================
# fnd:ModuleScalarShape (T5) — the scalar action is well typed R x M -> M (design s3; module absent as
# algebra, SYN). A sh:sparql node shape targeting fnd:ScalarAction, mirroring q_module_scalar: it flags an
# action whose scalar is not a fnd:hasRingElement of the module's base ring, OR whose result is not a
# fnd:hasModuleVector of the module (the action escapes M). Edge-existence, defang-proof. Floor: the rank-1
# free module over GF(3) (1·V1=V1, 2·V1=V2, 2·V2=V1) conforms; probe (an action with result fnd:ringZero,
# a ring element that is not a module vector) -> RED.
# =====================================================================================

fnd:ModuleScalarShape a sh:NodeShape ;
    rdfs:label "ModuleScalarShape" ;
    rdfs:comment "The Module-rung scalar-action typing tooth with teeth on fnd:ScalarAction (algebra_rings.ttl, design s3). Module is FULLY ABSENT as algebra in Helios (only code-module, 02_algebra_tower.md:134-136), authored as cited standard module theory. It makes the scalar action's TYPING (R x M -> M) a CHECKABLE graph fact - the same edge-existence discipline as fnd:MembershipTypedShape / fnd:SetCarrierShape. A sh:sparql node shape targeting fnd:ScalarAction with TWO UNION clauses: (1) the scalar escapes the ring - an action (fnd:saModule ?m fnd:moduleOverRing ?ring, fnd:saScalar ?r) whose ?r is NOT a fnd:hasRingElement of ?ring; and (2) the result escapes the module - an action (fnd:saModule ?m, fnd:saResult ?res) whose ?res is NOT a fnd:hasModuleVector of ?m (the action does not land back in M). Both clauses read EDGE existence (fnd:saModule/fnd:moduleOverRing/fnd:saScalar/fnd:saResult/fnd:hasRingElement/fnd:hasModuleVector), never a bare sh:class over an rdfs:range, so inference=rdfs cannot forge one of these edges and defang it - the SP1 defang discipline. On this floor the rank-1 free module fnd:moduleModel over GF(3) (actions 1·V1=V1, 2·V1=V2, 2·V2=V1, all with ring-element scalars and module-vector results) and the vector-space unit-law action conform; the probe of record - fnd:probeEscapingScalarAction (fnd:saModule fnd:moduleModel ; fnd:saScalar fnd:ringOne ; fnd:saVector fnd:vecV1 ; fnd:saResult fnd:ringZero, a RING element that is not a fnd:hasModuleVector) - makes clause (2) bite (conforms=True->False), proving the tooth." ;
    sh:targetClass fnd:ScalarAction ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "module rung: this scalar action is not well typed (R x M -> M) - its scalar is not a fnd:hasRingElement of the module's base ring, or its result is not a fnd:hasModuleVector of the module (the action escapes M)." ;
        sh:select """
            SELECT $this WHERE {
              {
                $this <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <urn:silmaril:fnd:#ScalarAction> ;
                      <urn:silmaril:fnd:#saModule> ?m ; <urn:silmaril:fnd:#saScalar> ?r .
                ?m <urn:silmaril:fnd:#moduleOverRing> ?ring .
                FILTER NOT EXISTS { ?ring <urn:silmaril:fnd:#hasRingElement> ?r }
              } UNION {
                $this <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <urn:silmaril:fnd:#ScalarAction> ;
                      <urn:silmaril:fnd:#saModule> ?m ; <urn:silmaril:fnd:#saResult> ?res .
                FILTER NOT EXISTS { ?m <urn:silmaril:fnd:#hasModuleVector> ?res }
              }
            }
        """ ;
    ] .


# =====================================================================================
# fnd:ModuleScalarLawShape (T5 / W-SP0-B) — the FULL module scalar-action LAW over EVERY fnd:Module (design
# s3; module absent as algebra in Helios, SYN). fnd:ModuleScalarShape checks only the action's TYPING
# (R x M -> M); this NEW tooth checks the actual module axioms the typing tooth left unenforced, so a
# well-typed-but-non-unital / non-associative-in-scalars / non-distributive "module" no longer passes GREEN
# (the sub-clause-only-law hole the hostile review keeps finding variants of - here for fnd:Module). A
# sh:sparql node shape targeting fnd:Module (so under inference=rdfs it catches BOTH the plain rank-1 free
# module fnd:moduleModel over GF(3) AND the vector space fnd:vectorSpaceModel, a fnd:VectorSpace
# rdfs:subClassOf fnd:Module) with FOUR self-contained sh:sparql constraints, one per sub-law, each firing
# EXISTENTIALLY when a closing witness over the reified fnd:ScalarAction / fnd:RingOperationApplication /
# fnd:opStructure tables violates the equation:
#   (1) UNITALITY 1.m = m: a scalar action whose scalar is the base ring's fnd:hasOneElement whose
#       fnd:saResult != its fnd:saVector -> RED.
#   (2) SCALAR-ASSOCIATIVITY (r.s).m = r.(s.m): a ring product r.s = c (fnd:multiplicativeOp over the
#       fnd:moduleOverRing base ring) where c.m != r.(s.m) (the two scalar actions) -> RED.
#   (3) LEFT BI-DISTRIBUTIVITY r.(m+n) = r.m + r.n: over the module's fnd:moduleAdditiveGroup vector sum
#       m+n, where r.(m+n) != (r.m)+(r.n) -> RED.
#   (4) RIGHT BI-DISTRIBUTIVITY (r+s).m = r.m + s.m: over a base-ring additive sum r+s = c, where
#       c.m != (r.m)+(s.m) -> RED.
# Every clause reads EDGE existence over the reified rows plus the $this rdf:type fnd:Module guard and the
# fnd:moduleOverRing / fnd:moduleAdditiveGroup edges, never a bare sh:class over an rdfs:range, so
# inference=rdfs cannot defang it - the SP1 defang discipline. On this floor fnd:moduleModel (over the full
# GF(3) ring, additive group fnd:moduleAddGroup, actions 1.V1=V1 / 2.V1=V2 / 2.V2=V1) and fnd:vectorSpaceModel
# (over GF(3) as a field, additive group fnd:abelianModel, actions 1.A=A / 2.A=B / 2.B=A) satisfy all four
# sub-laws, so conforms=True; the probes of record each flip conforms True->False: (1) change fnd:saOneV1
# fnd:saResult to fnd:vecV2 (1.V1 = V2 != V1); (2) change fnd:saTwoV2 fnd:saResult to fnd:vecV0 so
# 2.(2.V1) = 2.V2 = V0 while (2.2).V1 = 1.V1 = V1; (3) change fnd:appMAddV2V2 fnd:opResult so (r.m)+(r.n)
# drifts; (4) change fnd:appRingAdd_1_1 so (1+1).V1 != 1.V1 + 1.V1. A FRESH non-unital or non-distributive
# fnd:Module instance is caught the same way. Mirrors q_module_scalar_law.
# =====================================================================================

fnd:ModuleScalarLawShape a sh:NodeShape ;
    rdfs:label "ModuleScalarLawShape" ;
    rdfs:comment "The FULL module scalar-action LAW tooth with teeth on fnd:Module (algebra_rings.ttl, design s3; W-SP0-B close). Module is FULLY ABSENT as algebra in Helios (only code-module, 02_algebra_tower.md:134-136), authored as cited standard module theory. It COMPLETES the module law that fnd:ModuleScalarShape left as a sub-clause: fnd:ModuleScalarShape checks ONLY the scalar action's TYPING (the scalar is a base-ring element and the result a module vector, R x M -> M), so a well-typed action table that is NON-UNITAL (1.m != m), NON-ASSOCIATIVE in scalars ((r.s).m != r.(s.m)), or NON-DISTRIBUTIVE (r.(m+n) != r.m + r.n, or (r+s).m != r.m + s.m) passed GREEN - the exact sub-clause-only-law defect the hostile review keeps finding variants of. This NEW tooth makes the four genuine fnd:lawScalarAction axioms CHECKABLE graph facts. CLASS-GENERAL: a sh:sparql node shape targeting fnd:Module (so under inference=rdfs it QUANTIFIES OVER the plain module witness fnd:moduleModel AND the vector space fnd:vectorSpaceModel, a fnd:VectorSpace rdfs:subClassOf fnd:Module) with FOUR self-contained sh:sparql constraints, each firing EXISTENTIALLY when a closing witness violates its equation: (1) UNITALITY - a fnd:ScalarAction over $this whose fnd:saScalar is the fnd:moduleOverRing base ring's fnd:hasOneElement has fnd:saResult != fnd:saVector (1.m != m); (2) SCALAR-ASSOCIATIVITY - a base-ring multiplicative product r.s = c (a fnd:multiplicativeOp fnd:RingOperationApplication over the fnd:moduleOverRing) where the action c.m (result lhs) and the composite r.(s.m) (action s.m = w, then r.w = rhs) disagree; (3) LEFT BI-DISTRIBUTIVITY - a vector sum m+n over $this's fnd:moduleAdditiveGroup (a fnd:opStructure row) where r.(m+n) != (r.m)+(r.n) (the sum of the two scalar-action results, again over the fnd:moduleAdditiveGroup); (4) RIGHT BI-DISTRIBUTIVITY - a base-ring additive sum r+s = c (a fnd:additiveOp row over the fnd:moduleOverRing) where c.m != (r.m)+(s.m). Every clause reads EDGE existence over the reified fnd:ScalarAction rows (fnd:saModule/fnd:saScalar/fnd:saVector/fnd:saResult), the base ring's reified two-operation table (fnd:ringStructure/fnd:ringOp/fnd:ringLeft/fnd:ringRight/fnd:ringResult), the vector additive group's reified table (fnd:opStructure/fnd:opLeft/fnd:opRight/fnd:opResult), the fnd:moduleOverRing / fnd:moduleAdditiveGroup / fnd:hasOneElement edges, and the $this rdf:type fnd:Module guard - never a bare sh:class over an rdfs:range, so inference=rdfs cannot defang it (the SP1 defang discipline). On this floor fnd:moduleModel (base ring fnd:ringModel GF(3) with its full additive+multiplicative tables, fnd:moduleAdditiveGroup fnd:moduleAddGroup the Z/3 vector group, actions 1.V1=V1 / 2.V1=V2 / 2.V2=V1) and fnd:vectorSpaceModel (base ring fnd:fieldModel, fnd:moduleAdditiveGroup fnd:abelianModel, actions 1.A=A / 2.A=B / 2.B=A) satisfy every sub-law, so conforms=True; the probes of record each flip conforms True->False: unitality - fnd:saOneV1 fnd:saResult -> fnd:vecV2 (1.V1 = V2 != V1); scalar-associativity - fnd:saTwoV2 fnd:saResult -> fnd:vecV0 (2.(2.V1) = 2.V2 = V0 while (2.2).V1 = 1.V1 = V1); left bi-distributivity - fnd:appMAddV2V2 fnd:opResult perturbed so (2.V1)+(2.V1) drifts from 2.(V1+V1); right bi-distributivity - fnd:appRingAdd_1_1 fnd:ringResult perturbed so (1+1).V1 != 1.V1 + 1.V1. A FRESH correctly-typed non-unital or non-distributive fnd:Module instance is caught the same way, proving the tooth is CLASS-GENERAL and the law COMPLETE. Constraints 5 and 6 (the guard-on-optional-edge close) add the EXISTENCE half the four law clauses left open (they fire only when a closing action-chain exists, so an action-LESS module passed vacuously and fnd:ModuleScalarShape, targeting fnd:ScalarAction, never focused on it): constraint 5 fires on a fnd:Module with NO fnd:ScalarAction at all, and constraint 6 on a fnd:Module whose base ring's fnd:hasOneElement acts on no vector (no unit action witnessed, so unitality is not opt-in). On this floor fnd:moduleModel (fnd:saOneV1 the unit action 1.V1=V1) and fnd:vectorSpaceModel (fnd:saUnitLaw 1.A=A) both carry a unit action, so conforms=True; the probes - a fnd:Module with no fnd:ScalarAction (constraint 5) and a fnd:Module whose one acts on nothing (constraint 6) - each bite. Mirrors q_module_scalar_law." ;
    sh:targetClass fnd:Module ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "module scalar law (1, unitality): a fnd:Module has a scalar action whose scalar is the base ring's one but whose result != its vector (1.m != m)." ;
        sh:select """
            SELECT $this WHERE {
              $this <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <urn:silmaril:fnd:#Module> ;
                    <urn:silmaril:fnd:#moduleOverRing> ?ring .
              ?ring <urn:silmaril:fnd:#hasOneElement> ?one .
              ?a <urn:silmaril:fnd:#saModule> $this ; <urn:silmaril:fnd:#saScalar> ?one ; <urn:silmaril:fnd:#saVector> ?v ; <urn:silmaril:fnd:#saResult> ?r .
              FILTER(?r != ?v)
            }
        """ ;
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "module scalar law (2, scalar-associativity): a fnd:Module violates (r.s).m = r.(s.m) - a base-ring product r.s = c gives c.m != r.(s.m) over the reified scalar actions." ;
        sh:select """
            SELECT $this WHERE {
              $this <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <urn:silmaril:fnd:#Module> ;
                    <urn:silmaril:fnd:#moduleOverRing> ?ring .
              ?rs <urn:silmaril:fnd:#ringStructure> ?ring ; <urn:silmaril:fnd:#ringOp> <urn:silmaril:fnd:#multiplicativeOp> ; <urn:silmaril:fnd:#ringLeft> ?r ; <urn:silmaril:fnd:#ringRight> ?s ; <urn:silmaril:fnd:#ringResult> ?c .
              ?cm <urn:silmaril:fnd:#saModule> $this ; <urn:silmaril:fnd:#saScalar> ?c ; <urn:silmaril:fnd:#saVector> ?m ; <urn:silmaril:fnd:#saResult> ?lhs .
              ?sm <urn:silmaril:fnd:#saModule> $this ; <urn:silmaril:fnd:#saScalar> ?s ; <urn:silmaril:fnd:#saVector> ?m ; <urn:silmaril:fnd:#saResult> ?w .
              ?rw <urn:silmaril:fnd:#saModule> $this ; <urn:silmaril:fnd:#saScalar> ?r ; <urn:silmaril:fnd:#saVector> ?w ; <urn:silmaril:fnd:#saResult> ?rhs .
              FILTER(?lhs != ?rhs)
            }
        """ ;
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "module scalar law (3, left bi-distributivity): a fnd:Module violates r.(m+n) = r.m + r.n - a vector sum m+n over the module additive group gives r.(m+n) != (r.m)+(r.n)." ;
        sh:select """
            SELECT $this WHERE {
              $this <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <urn:silmaril:fnd:#Module> ;
                    <urn:silmaril:fnd:#moduleAdditiveGroup> ?g .
              ?smn <urn:silmaril:fnd:#opStructure> ?g ; <urn:silmaril:fnd:#opLeft> ?m ; <urn:silmaril:fnd:#opRight> ?n ; <urn:silmaril:fnd:#opResult> ?mn .
              ?rmn <urn:silmaril:fnd:#saModule> $this ; <urn:silmaril:fnd:#saScalar> ?r ; <urn:silmaril:fnd:#saVector> ?mn ; <urn:silmaril:fnd:#saResult> ?lhs .
              ?rm <urn:silmaril:fnd:#saModule> $this ; <urn:silmaril:fnd:#saScalar> ?r ; <urn:silmaril:fnd:#saVector> ?m ; <urn:silmaril:fnd:#saResult> ?pm .
              ?rn <urn:silmaril:fnd:#saModule> $this ; <urn:silmaril:fnd:#saScalar> ?r ; <urn:silmaril:fnd:#saVector> ?n ; <urn:silmaril:fnd:#saResult> ?pn .
              ?sum <urn:silmaril:fnd:#opStructure> ?g ; <urn:silmaril:fnd:#opLeft> ?pm ; <urn:silmaril:fnd:#opRight> ?pn ; <urn:silmaril:fnd:#opResult> ?rhs .
              FILTER(?lhs != ?rhs)
            }
        """ ;
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "module scalar law (4, right bi-distributivity): a fnd:Module violates (r+s).m = r.m + s.m - a base-ring sum r+s = c gives c.m != (r.m)+(s.m)." ;
        sh:select """
            SELECT $this WHERE {
              $this <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <urn:silmaril:fnd:#Module> ;
                    <urn:silmaril:fnd:#moduleOverRing> ?ring ; <urn:silmaril:fnd:#moduleAdditiveGroup> ?g .
              ?rs <urn:silmaril:fnd:#ringStructure> ?ring ; <urn:silmaril:fnd:#ringOp> <urn:silmaril:fnd:#additiveOp> ; <urn:silmaril:fnd:#ringLeft> ?r ; <urn:silmaril:fnd:#ringRight> ?s ; <urn:silmaril:fnd:#ringResult> ?c .
              ?cm <urn:silmaril:fnd:#saModule> $this ; <urn:silmaril:fnd:#saScalar> ?c ; <urn:silmaril:fnd:#saVector> ?m ; <urn:silmaril:fnd:#saResult> ?lhs .
              ?rm <urn:silmaril:fnd:#saModule> $this ; <urn:silmaril:fnd:#saScalar> ?r ; <urn:silmaril:fnd:#saVector> ?m ; <urn:silmaril:fnd:#saResult> ?pr .
              ?sm <urn:silmaril:fnd:#saModule> $this ; <urn:silmaril:fnd:#saScalar> ?s ; <urn:silmaril:fnd:#saVector> ?m ; <urn:silmaril:fnd:#saResult> ?ps .
              ?sum <urn:silmaril:fnd:#opStructure> ?g ; <urn:silmaril:fnd:#opLeft> ?pr ; <urn:silmaril:fnd:#opRight> ?ps ; <urn:silmaril:fnd:#opResult> ?rhs .
              FILTER(?lhs != ?rhs)
            }
        """ ;
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "module scalar law (5, action EXISTENCE): this fnd:Module (directly or via rdfs:subClassOf - every fnd:VectorSpace) carries NO fnd:ScalarAction at all - the defining scalar action R x M -> M is OMITTED, so the typing tooth (fnd:ModuleScalarShape, which targets fnd:ScalarAction) never focuses on it and an action-less module escapes GREEN; a fnd:Module with no scalar action -> RED (the guard-on-optional-edge close)." ;
        sh:select """
            SELECT $this WHERE {
              $this <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <urn:silmaril:fnd:#Module> .
              FILTER NOT EXISTS { ?a <urn:silmaril:fnd:#saModule> $this }
            }
        """ ;
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "module scalar law (6, unit-action EXISTENCE): this fnd:Module witnesses NO unit action - its base ring's fnd:hasOneElement acts on no vector (no fnd:ScalarAction with saScalar = the base ring's one), so the unitality clause (1) never fires and a non-unital module escapes it; a fnd:Module that omits the unit action -> RED (the guard-on-optional-edge close)." ;
        sh:select """
            SELECT $this WHERE {
              $this <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <urn:silmaril:fnd:#Module> ;
                    <urn:silmaril:fnd:#moduleOverRing> ?ring .
              ?ring <urn:silmaril:fnd:#hasOneElement> ?one .
              FILTER NOT EXISTS { ?a <urn:silmaril:fnd:#saModule> $this ; <urn:silmaril:fnd:#saScalar> ?one }
            }
        """ ;
    ] .


# =====================================================================================
# fnd:VectorSpaceAxiomsShape (T5) — the distinguishing vector-space axioms over a fnd:Field (design s3/s4;
# vector space absent as a rung, SYN). A sh:sparql node shape targeting fnd:VectorSpace with TWO UNION
# clauses: (structural) a vector space whose fnd:scalarField is not a fnd:Field or whose
# fnd:vectorAdditiveGroup is not a fnd:AbelianGroup -> RED; (unit law) a unit-law action with scalar = the
# field's one whose fnd:saResult != its fnd:saVector (1·v != v) -> RED. Edge-existence + the unit-law
# numeric equality, defang-proof. Floor: scalar field GF(3), additive group the T4 fnd:abelianModel, unit
# law 1·A=A -> conforms; probe (fnd:saUnitLaw fnd:saResult -> fnd:elemB) makes 1·A=B != A -> RED.
# =====================================================================================

fnd:VectorSpaceAxiomsShape a sh:NodeShape ;
    rdfs:label "VectorSpaceAxiomsShape" ;
    rdfs:comment "The VectorSpace-rung axioms tooth with teeth on fnd:VectorSpace (algebra_rings.ttl, design s3/s4; W2 close - ALL EIGHT axioms now bite, no false-inheritance claim). Vector space is absent as a rung in Helios (only incidental 'ambient vector spaces', 02_algebra_tower.md:136), authored as cited standard linear algebra. A sh:sparql node shape targeting fnd:VectorSpace whose FIVE sh:sparql constraints prove the eight vector-space axioms as follows, each mirrored by a clause of q_vectorspace_axioms: AXIOMS 1-4 ((V,+) is an abelian group) - proved by CONSTRAINT 1 (structural), which fires unless the vector space's fnd:scalarField carries GENUINE FIELD STRUCTURE (a fnd:hasOneElement AND a fnd:hasZeroElement AND a fnd:MultInversePairing mipModel it) AND its fnd:vectorAdditiveGroup carries GENUINE ABELIAN-GROUP STRUCTURE (a fnd:hasIdentityElement AND an fnd:InversePairing pairingModel it). FIX-A3 (rdfs-inference VACUITY close): the earlier form read the range-inferred rdf:type fnd:Field / fnd:AbelianGroup inside FILTER NOT EXISTS, and since fnd:scalarField's rdfs:range IS fnd:Field and fnd:vectorAdditiveGroup's rdfs:range IS fnd:AbelianGroup, inference=rdfs MATERIALISED those types onto ANY target (even a fnd:Magma), so the NOT-EXISTS was always satisfied and a VectorSpace whose scalarField/vectorAdditiveGroup pointed at a non-Field / non-abelian passed GREEN; the positive-STRUCTURAL edge test (fnd:hasOneElement / fnd:MultInversePairing / fnd:hasIdentityElement / fnd:InversePairing) cannot be forged by range inference (the SP1 defang discipline), so a fnd:Magma scalar field or additive group now correctly goes RED. The fnd:AbelianGroup's commutativity is still teeth-proved by fnd:AbelianCommShape over the same model, and the fnd:Field's mult-inverse structure by fnd:FieldMultInverseShape; AXIOM 5 (unit scalar, 1v = v) - proved by CONSTRAINT 2, which fires when the fnd:unitLawAction (scalar = the field's fnd:hasOneElement) has fnd:saResult != fnd:saVector; AXIOM 6 (scalar distributivity over vector addition, a(u+v) = au+av) - proved by CONSTRAINT 3, which fires when a scalar a acting on a vector sum s = u+v (a fnd:opStructure row over the fnd:vectorAdditiveGroup) gives a fnd:saResult != the sum (au)+(av) of the two scalar-action results; AXIOM 7 (scalar distributivity over field addition, (a+b)v = av+bv) - proved by CONSTRAINT 4, which fires when a field sum c = a+b (a fnd:additiveOp row over the fnd:scalarField) acting on v gives cv != (av)+(bv); AXIOM 8 (scalar-multiplication associativity, (ab)v = a(bv)) - proved by CONSTRAINT 5, which fires when a field product c = a.b (a fnd:multiplicativeOp row over the fnd:scalarField) acting on v gives cv != a(bv). (The EARLIER comment falsely claimed axioms 6-8 were 'inherited from fnd:ModuleScalarShape + fnd:RingDistribShape'; they are NOT - fnd:ModuleScalarShape checks only the action's TYPING R x M -> M and fnd:RingDistribShape checks distributivity of the SCALAR ring's own two operations, neither the scalar-action distributivity/associativity over the vector space; W2 authors the three missing teeth here.) Every clause reads rdf:type via rdfs entailment on fnd:Field / fnd:AbelianGroup (both explicitly typed, non-forgeable) plus EDGE existence over the reified scalar-action / vector-addition / field-operation rows and numeric inequality FILTERs, never a bare range-inferred sh:class - the SP1 defang discipline. On this floor fnd:vectorSpaceModel (fnd:scalarField fnd:fieldModel a fnd:Field over GF(3), fnd:vectorAdditiveGroup fnd:abelianModel a fnd:AbelianGroup on {E=0,A=1,B=2}, fnd:unitLawAction fnd:saUnitLaw 1.A=A, scalar actions 2.A=B / 2.B=A, vector sums A+A=B / B+B=A, field sums/products) satisfies every axiom, so conforms=True; the probes of record each flip conforms True->False: axiom 5 change fnd:saUnitLaw fnd:saResult to fnd:elemB (1.A=B!=A); axiom 6 change fnd:appAbBB fnd:opResult to fnd:elemE (a(u+v) != au+av on a=2,u=v=A); axiom 7 change fnd:appFieldAdd_1_1 fnd:ringResult to fnd:fieldOne ((a+b)v != av+bv on a=b=1,v=A); axiom 8 change fnd:appFieldMul_2_1 fnd:ringResult to fnd:fieldOne ((ab)v != a(bv) on a=2,b=1,v=A) - proving all eight teeth." ;
    sh:targetClass fnd:VectorSpace ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "vector-space axioms 1-5: the scalar structure is not a genuine fnd:Field (no fnd:hasOneElement / fnd:hasZeroElement / fnd:MultInversePairing structure) or the additive group of vectors is not a genuine fnd:AbelianGroup (no fnd:hasIdentityElement / fnd:InversePairing structure) - axioms 1-4 - or the unit law 1.v = v fails on the unit-law action (axiom 5)." ;
        sh:select """
            SELECT $this WHERE {
              {
                $this <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <urn:silmaril:fnd:#VectorSpace> .
                FILTER NOT EXISTS {
                  $this <urn:silmaril:fnd:#scalarField> ?f .
                  ?f <urn:silmaril:fnd:#hasOneElement> ?fone .
                  ?f <urn:silmaril:fnd:#hasZeroElement> ?fzero .
                  ?mp <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <urn:silmaril:fnd:#MultInversePairing> ; <urn:silmaril:fnd:#mipModel> ?f .
                }
              } UNION {
                $this <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <urn:silmaril:fnd:#VectorSpace> .
                FILTER NOT EXISTS {
                  $this <urn:silmaril:fnd:#vectorAdditiveGroup> ?g .
                  ?g <urn:silmaril:fnd:#hasIdentityElement> ?gid .
                  ?gp <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <urn:silmaril:fnd:#InversePairing> ; <urn:silmaril:fnd:#pairingModel> ?g .
                }
              } UNION {
                $this <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <urn:silmaril:fnd:#VectorSpace> ;
                      <urn:silmaril:fnd:#scalarField> ?f2 ; <urn:silmaril:fnd:#unitLawAction> ?ula .
                ?f2 <urn:silmaril:fnd:#hasOneElement> ?one .
                ?ula <urn:silmaril:fnd:#saScalar> ?one ; <urn:silmaril:fnd:#saVector> ?vec ; <urn:silmaril:fnd:#saResult> ?r .
                FILTER(?r != ?vec)
              }
            }
        """ ;
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "vector-space axiom 6 (scalar distributivity over vector addition): a scalar a acting on a vector sum u+v gives a(u+v) != au+av." ;
        sh:select """
            SELECT $this WHERE {
              $this <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <urn:silmaril:fnd:#VectorSpace> ;
                    <urn:silmaril:fnd:#vectorAdditiveGroup> ?g .
              ?suv <urn:silmaril:fnd:#opStructure> ?g ; <urn:silmaril:fnd:#opLeft> ?u ; <urn:silmaril:fnd:#opRight> ?v ; <urn:silmaril:fnd:#opResult> ?s .
              ?as <urn:silmaril:fnd:#saModule> $this ; <urn:silmaril:fnd:#saScalar> ?a ; <urn:silmaril:fnd:#saVector> ?s ; <urn:silmaril:fnd:#saResult> ?lhs .
              ?au <urn:silmaril:fnd:#saModule> $this ; <urn:silmaril:fnd:#saScalar> ?a ; <urn:silmaril:fnd:#saVector> ?u ; <urn:silmaril:fnd:#saResult> ?pu .
              ?av <urn:silmaril:fnd:#saModule> $this ; <urn:silmaril:fnd:#saScalar> ?a ; <urn:silmaril:fnd:#saVector> ?v ; <urn:silmaril:fnd:#saResult> ?pv .
              ?sum <urn:silmaril:fnd:#opStructure> ?g ; <urn:silmaril:fnd:#opLeft> ?pu ; <urn:silmaril:fnd:#opRight> ?pv ; <urn:silmaril:fnd:#opResult> ?rhs .
              FILTER(?lhs != ?rhs)
            }
        """ ;
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "vector-space axiom 7 (scalar distributivity over field addition): a field sum a+b acting on v gives (a+b)v != av+bv." ;
        sh:select """
            SELECT $this WHERE {
              $this <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <urn:silmaril:fnd:#VectorSpace> ;
                    <urn:silmaril:fnd:#vectorAdditiveGroup> ?g ; <urn:silmaril:fnd:#scalarField> ?fld .
              ?abr <urn:silmaril:fnd:#ringStructure> ?fld ; <urn:silmaril:fnd:#ringOp> <urn:silmaril:fnd:#additiveOp> ; <urn:silmaril:fnd:#ringLeft> ?a ; <urn:silmaril:fnd:#ringRight> ?b ; <urn:silmaril:fnd:#ringResult> ?c .
              ?cv <urn:silmaril:fnd:#saModule> $this ; <urn:silmaril:fnd:#saScalar> ?c ; <urn:silmaril:fnd:#saVector> ?v ; <urn:silmaril:fnd:#saResult> ?lhs .
              ?av <urn:silmaril:fnd:#saModule> $this ; <urn:silmaril:fnd:#saScalar> ?a ; <urn:silmaril:fnd:#saVector> ?v ; <urn:silmaril:fnd:#saResult> ?pa .
              ?bv <urn:silmaril:fnd:#saModule> $this ; <urn:silmaril:fnd:#saScalar> ?b ; <urn:silmaril:fnd:#saVector> ?v ; <urn:silmaril:fnd:#saResult> ?pb .
              ?sum <urn:silmaril:fnd:#opStructure> ?g ; <urn:silmaril:fnd:#opLeft> ?pa ; <urn:silmaril:fnd:#opRight> ?pb ; <urn:silmaril:fnd:#opResult> ?rhs .
              FILTER(?lhs != ?rhs)
            }
        """ ;
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "vector-space axiom 8 (scalar-multiplication associativity): a field product a.b acting on v gives (ab)v != a(bv)." ;
        sh:select """
            SELECT $this WHERE {
              $this <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <urn:silmaril:fnd:#VectorSpace> ;
                    <urn:silmaril:fnd:#scalarField> ?fld .
              ?abr <urn:silmaril:fnd:#ringStructure> ?fld ; <urn:silmaril:fnd:#ringOp> <urn:silmaril:fnd:#multiplicativeOp> ; <urn:silmaril:fnd:#ringLeft> ?a ; <urn:silmaril:fnd:#ringRight> ?b ; <urn:silmaril:fnd:#ringResult> ?c .
              ?cv <urn:silmaril:fnd:#saModule> $this ; <urn:silmaril:fnd:#saScalar> ?c ; <urn:silmaril:fnd:#saVector> ?v ; <urn:silmaril:fnd:#saResult> ?lhs .
              ?bv <urn:silmaril:fnd:#saModule> $this ; <urn:silmaril:fnd:#saScalar> ?b ; <urn:silmaril:fnd:#saVector> ?v ; <urn:silmaril:fnd:#saResult> ?w .
              ?aw <urn:silmaril:fnd:#saModule> $this ; <urn:silmaril:fnd:#saScalar> ?a ; <urn:silmaril:fnd:#saVector> ?w ; <urn:silmaril:fnd:#saResult> ?rhs .
              FILTER(?lhs != ?rhs)
            }
        """ ;
    ] .


# =====================================================================================
# fnd:SheafGluesShape (T6) — the LIFTED sheaf-gluing tooth (design s4; 04_space_constructs.md s1.1). A
# sh:sparql node shape targeting fnd:MatchingFamily with TWO UNION clauses mirroring q_sheaf_glues:
# (1, existence-under-agreement) an AGREEING family (fnd:restrictionToOverlapA = fnd:restrictionToOverlapB)
# that has NO fnd:hasGluing restricting back to both legs (fnd:glueRestrictsToA = fnd:familyOverA and
# fnd:glueRestrictsToB = fnd:familyOverB) -> RED; (2, uniqueness) a family with two DISTINCT fnd:hasGluing
# values -> RED. Edge existence + the overlap-agreement/gluing equalities, defang-proof (never a range-
# inference-vacuous sh:class). Floor: fnd:matchingFamilyWitness agrees on the overlap and has a unique
# valid gluing fnd:secGlobal -> conforms; probe (fnd:secGlobal fnd:glueRestrictsToA -> fnd:secB) leaves
# the family agreeing but with no valid glue -> RED (local sections agreeing on overlaps, no unique glue).
# =====================================================================================

fnd:SheafGluesShape a sh:NodeShape ;
    rdfs:label "SheafGluesShape" ;
    rdfs:comment "The LIFTED sheaf-gluing tooth with teeth on fnd:MatchingFamily (spaces.ttl, design s4). It makes the equalizer-form sheaf condition a graph fact: local sections agreeing on overlaps glue to a UNIQUE global section (helios/srcy/papers/19_mereology_as_colimit/chapters/05_atomic_colimit_constructions/sections/02_sheaf_condition_for_part_of.tex:30-52; the corpus's own honesty caveat, 'absent the equalizer the apex is conjectured, not constructed', :151-157). A sh:sparql node shape targeting fnd:MatchingFamily with TWO UNION clauses: (1) fires when a matching family whose two overlap restrictions AGREE (fnd:restrictionToOverlapA = fnd:restrictionToOverlapB) has NO fnd:hasGluing that restricts back to exactly its two legs (a gluing ?g with ?g fnd:glueRestrictsToA the family's fnd:familyOverA and ?g fnd:glueRestrictsToB the family's fnd:familyOverB); (2, uniqueness) fires when a family carries two DISTINCT fnd:hasGluing values. Every clause reads EDGE existence over the reified matching family plus the overlap-agreement / gluing-restriction equalities, never a bare sh:class over an rdfs:range, so inference=rdfs cannot forge a gluing edge and defang it - the SP1 defang discipline. On this floor fnd:matchingFamilyWitness (restrictions both fnd:secOverlap, gluing fnd:secGlobal restricting to fnd:secA / fnd:secB) conforms; the probe of record - repointing fnd:secGlobal fnd:glueRestrictsToA from fnd:secA to fnd:secB, so the agreeing family has no valid gluing - makes clause 1 bite (conforms=True->False), proving the tooth on the case that matters (a failed sheaf gluing = the missing apex)." ;
    sh:targetClass fnd:MatchingFamily ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "sheaf condition: an agreeing matching family has no unique valid gluing - either an agreeing family (equal overlap restrictions) with no fnd:hasGluing restricting back to both legs, or a family with two distinct gluings (violating uniqueness of the amalgamation)." ;
        sh:select """
            SELECT $this WHERE {
              {
                $this <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <urn:silmaril:fnd:#MatchingFamily> ;
                      <urn:silmaril:fnd:#restrictionToOverlapA> ?ra ;
                      <urn:silmaril:fnd:#restrictionToOverlapB> ?rb ;
                      <urn:silmaril:fnd:#familyOverA> ?sa ;
                      <urn:silmaril:fnd:#familyOverB> ?sb .
                FILTER(?ra = ?rb)
                FILTER NOT EXISTS {
                  $this <urn:silmaril:fnd:#hasGluing> ?g .
                  ?g <urn:silmaril:fnd:#glueRestrictsToA> ?sa ;
                     <urn:silmaril:fnd:#glueRestrictsToB> ?sb .
                }
              } UNION {
                $this <urn:silmaril:fnd:#hasGluing> ?g1 , ?g2 .
                FILTER(?g1 != ?g2)
              }
            }
        """ ;
    ] .


# =====================================================================================
# fnd:TopologyAxiomsShape (T6) — the SYN point-set topology tooth (design s4; 04 s3/D2, the corpus refuses
# point-set topology so this is SYN cited standard topology). A sh:sparql node shape targeting
# fnd:TopologicalSpace with THREE UNION clauses mirroring q_topology_axioms: (a) tau lacks the empty open
# or X among its opens; (b) a reified fnd:OpenIntersection of two opens has a result that is NOT an open
# (not closed under finite intersection); (c) a reified fnd:OpenUnion of two opens has a result that is NOT
# an open (not closed under union). Edge existence + fnd:hasOpenSet membership, defang-proof. Floor: the
# discrete topology on {a,b} conforms; probe (fnd:ixAB fnd:intersectResult -> fnd:setNonOpen) makes clause
# (b) bite (conforms True->False).
# =====================================================================================

fnd:TopologyAxiomsShape a sh:NodeShape ;
    rdfs:label "TopologyAxiomsShape" ;
    rdfs:comment "The SYN point-set-topology tooth with teeth on fnd:TopologicalSpace (spaces.ttl, design s4). The corpus DELIBERATELY REFUSES point-set topology on its objects (helios/srcy/papers/19_mereology_as_colimit/chapters/05_atomic_colimit_constructions/sections/03_cell_complex_pasting.tex:9-13,69-74 'makes no claim about a point-set topology on Mittens'), the recorded reason this atom is SYN, cited standard topology, not a Helios lift; per the maximal choice (Directive 20) it is teeth-proved anyway. It makes the open-set axioms a graph fact. A sh:sparql node shape targeting fnd:TopologicalSpace with THREE UNION clauses: (a) fires when the space does NOT have both its fnd:hasEmptyOpen and its fnd:hasTotalOpen among its fnd:hasOpenSet members (empty and X must be open); (b, finite-intersection closure) fires when a reified fnd:OpenIntersection scoped to the space (fnd:intersectionIn) whose two operands (fnd:intersectLeft, fnd:intersectRight) are opens has a fnd:intersectResult that is NOT a fnd:hasOpenSet; (c, union closure) fires when a reified fnd:OpenUnion whose operands are opens has a fnd:unionResult that is NOT a fnd:hasOpenSet. Every clause reads EDGE existence + fnd:hasOpenSet membership over the reified closure rows, never a bare sh:class over an rdfs:range, so inference=rdfs cannot forge an open-set membership and defang it - the SP1 defang discipline. On this floor the discrete topology fnd:topSpaceWitness (tau={empty,{a},{b},X}, every pairwise intersection/union landing back in tau) conforms; the probe of record - repointing fnd:ixAB fnd:intersectResult from fnd:openEmpty to fnd:setNonOpen (a set not in tau) - makes clause (b) bite (conforms=True->False), proving tau is no longer closed under finite intersection." ;
    sh:targetClass fnd:TopologicalSpace ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "topology axioms: (X,tau) fails an open-set axiom - either tau lacks the empty open or the total open X, or a finite intersection of two opens is not open, or a union of two opens is not open (tau not closed under finite intersection / arbitrary union)." ;
        sh:select """
            SELECT $this WHERE {
              {
                $this <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <urn:silmaril:fnd:#TopologicalSpace> .
                FILTER NOT EXISTS {
                  $this <urn:silmaril:fnd:#hasEmptyOpen> ?e . $this <urn:silmaril:fnd:#hasOpenSet> ?e .
                  $this <urn:silmaril:fnd:#hasTotalOpen> ?x . $this <urn:silmaril:fnd:#hasOpenSet> ?x .
                }
              } UNION {
                ?ix <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <urn:silmaril:fnd:#OpenIntersection> ;
                    <urn:silmaril:fnd:#intersectionIn> $this ;
                    <urn:silmaril:fnd:#intersectLeft> ?l ;
                    <urn:silmaril:fnd:#intersectRight> ?r ;
                    <urn:silmaril:fnd:#intersectResult> ?res .
                $this <urn:silmaril:fnd:#hasOpenSet> ?l , ?r .
                FILTER NOT EXISTS { $this <urn:silmaril:fnd:#hasOpenSet> ?res }
              } UNION {
                ?un <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <urn:silmaril:fnd:#OpenUnion> ;
                    <urn:silmaril:fnd:#unionIn> $this ;
                    <urn:silmaril:fnd:#unionLeft> ?ul ;
                    <urn:silmaril:fnd:#unionRight> ?ur ;
                    <urn:silmaril:fnd:#unionResult> ?ures .
                $this <urn:silmaril:fnd:#hasOpenSet> ?ul , ?ur .
                FILTER NOT EXISTS { $this <urn:silmaril:fnd:#hasOpenSet> ?ures }
              }
            }
        """ ;
    ] .


# =====================================================================================
# fnd:MetricTriangleShape (T6) — the SYN metric-space tooth (design s4; 04 s1.4/D4, metric spaces are USAGE
# in Helios never an axiomatized atom, so SYN cited standard metric geometry). A sh:sparql node shape
# targeting fnd:MetricSpace with FOUR UNION clauses mirroring q_metric_triangle: (a) identity - a self
# distance d(p,p) != 0; (b) identity of indiscernibles - two DISTINCT points x!=y with d(x,y)=0 (the axiom
# separating a METRIC from a pseudometric); (c) symmetry - d(x,y) != d(y,x); (d) triangle - d(x,z) >
# d(x,y)+d(y,z). Edge existence over reified fnd:DistanceAssertion rows + numeric FILTERs, defang-proof.
# Floor: the 3-point space {A,B,C} (d(A,B)=d(B,C)=1, d(A,C)=2, self 0, no off-diagonal zeros) conforms;
# probe (fnd:distAC fnd:distValue 2 -> 5) makes the triangle clause bite; and a pseudometric with two
# distinct zero-distance points typed fnd:MetricSpace makes clause (b) bite (conforms True->False).
# =====================================================================================

fnd:MetricTriangleShape a sh:NodeShape ;
    rdfs:label "MetricTriangleShape" ;
    rdfs:comment "The SYN metric-space tooth with teeth on fnd:MetricSpace (spaces.ttl, design s4). Metric spaces are USAGE only in Helios (metric feature codomains, the tessellation graph metric d_f^T) never an axiomatized (X,d) atom (04 s1.4), the recorded reason this atom is SYN, cited standard metric geometry; per the maximal choice (Directive 20) it is teeth-proved. It makes the three metric axioms graph facts. A sh:sparql node shape targeting fnd:MetricSpace with FOUR UNION clauses over the reified fnd:DistanceAssertion rows (fnd:distFrom / fnd:distTo / fnd:distValue): (a, identity d(x,x)=0) fires when a self-distance d(p,p) has fnd:distValue != 0; (b, identity of indiscernibles d(x,y)=0 => x=y) fires when a row (a,b,0) has a != b - two DISTINCT points at zero distance, the axiom that separates a genuine METRIC from a mere PSEUDOMETRIC (which keeps only d(x,x)=0); (c, symmetry) fires when two rows (x,y,v1) and (y,x,v2) have v1 != v2; (d, triangle inequality) fires when three rows (x,z,vxz),(x,y,vxy),(y,z,vyz) have vxz > vxy + vyz. Every clause reads EDGE existence over the reified rows plus a numeric FILTER, never a bare sh:class over an rdfs:range, so inference=rdfs cannot forge a distance row and defang it - the SP1 defang discipline; and it is CLASS-GENERAL over fnd:MetricSpace (any instance is caught, not a hardcoded witness). On this floor the 3-point space fnd:metricSpaceWitness (d(A,B)=d(B,C)=1, d(A,C)=2, self-distances 0, NO off-diagonal zeros; the triangle A-B-C holds with equality 2 = 1+1) conforms; the probe of record for the triangle leg - raising fnd:distAC fnd:distValue from 2 to 5, so d(A,C)=5 > d(A,B)+d(B,C)=2 - makes clause (d) bite; and the probe of record for the new identity-of-indiscernibles leg - a pseudometric with two distinct zero-distance points (a fnd:MetricSpace carrying a fnd:DistanceAssertion distFrom x distTo y with x != y and distValue 0) - makes clause (b) bite (conforms=True->False), so a pseudometric masquerading as a fnd:MetricSpace is RED." ;
    sh:targetClass fnd:MetricSpace ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "metric axioms: (X,d) fails a metric axiom - either a self-distance d(x,x) is nonzero (identity d(x,x)=0), or two DISTINCT points x!=y have d(x,y)=0 (the identity of indiscernibles d(x,y)=0 => x=y, the axiom that separates a METRIC from a pseudometric), or d(x,y) != d(y,x) (symmetry), or d(x,z) > d(x,y)+d(y,z) (the triangle inequality)." ;
        sh:select """
            SELECT $this WHERE {
              {
                $this <urn:silmaril:fnd:#hasDistanceAssertion> ?d .
                ?d <urn:silmaril:fnd:#distFrom> ?p ;
                   <urn:silmaril:fnd:#distTo> ?p ;
                   <urn:silmaril:fnd:#distValue> ?v .
                FILTER(?v != 0)
              } UNION {
                $this <urn:silmaril:fnd:#hasDistanceAssertion> ?d0 .
                ?d0 <urn:silmaril:fnd:#distFrom> ?a ; <urn:silmaril:fnd:#distTo> ?b ; <urn:silmaril:fnd:#distValue> ?v0 .
                FILTER(?a != ?b && ?v0 = 0)
              } UNION {
                $this <urn:silmaril:fnd:#hasDistanceAssertion> ?d1 , ?d2 .
                ?d1 <urn:silmaril:fnd:#distFrom> ?x ; <urn:silmaril:fnd:#distTo> ?y ; <urn:silmaril:fnd:#distValue> ?v1 .
                ?d2 <urn:silmaril:fnd:#distFrom> ?y ; <urn:silmaril:fnd:#distTo> ?x ; <urn:silmaril:fnd:#distValue> ?v2 .
                FILTER(?v1 != ?v2)
              } UNION {
                $this <urn:silmaril:fnd:#hasDistanceAssertion> ?dxz , ?dxy , ?dyz .
                ?dxz <urn:silmaril:fnd:#distFrom> ?x2 ; <urn:silmaril:fnd:#distTo> ?z2 ; <urn:silmaril:fnd:#distValue> ?vxz .
                ?dxy <urn:silmaril:fnd:#distFrom> ?x2 ; <urn:silmaril:fnd:#distTo> ?y2 ; <urn:silmaril:fnd:#distValue> ?vxy .
                ?dyz <urn:silmaril:fnd:#distFrom> ?y2 ; <urn:silmaril:fnd:#distTo> ?z2 ; <urn:silmaril:fnd:#distValue> ?vyz .
                FILTER(?vxz > ?vxy + ?vyz)
              }
            }
        """ ;
    ] .


# =====================================================================================
# T7 — functionality.ttl teeth (design s5, Pillar 4; Directive 19; Curry 1936, CITED). Three biting
# shapes mirroring the three EXPECT-TRUE ASKs, each proven to bite by a probe of record. Every atom the
# shapes reference is SYN (cited Curry 1936); the RECOGNIZED prim:Frame / prim:isYonedaPoint /
# silm:isProvisional are committed/LIFTED but not authored here. Full IRIs inside every sh:select so no
# sh:prefixes declaration is load-bearing. All checks read EDGE existence / literal values, never a
# range-inference-vacuous sh:class (the SP1 defang discipline).
# =====================================================================================

fnd:FrameRecognitionShape a sh:NodeShape ;
    rdfs:label "FrameRecognitionShape" ;
    rdfs:comment "The Curry-F recognition tooth with teeth on fnd:Functionality (functionality.ttl, design s5 F1; Directive 19 :270-273). SYN: cited standard mathematics (Curry 1936 s1); the pillar RECOGNIZES the committed SP1 prim:Frame as F rather than rebuilding an arrow tower. It makes 'the Frame IS Curry's F applied' a graph fact: a sh:sparql node shape targeting fnd:Functionality that fires when a functionality fnd:recognizesFrameCarrier some carrier that does NOT carry prim:isYonedaPoint true - i.e. a functionality recognizing an INVENTED parallel object instead of the unary law's Yoneda-point Frame (prim:Frame prim:isYonedaPoint true, committed at basicttl/primitives/taiji.ttl:1994). The constraint reads prim:isYonedaPoint on the recognized carrier by sh:sparql (a literal-value NOT EXISTS), never a bare sh:class over an rdfs:range, so inference=rdfs cannot forge the flag and defang it, and no rdfs:range on fnd:recognizesFrameCarrier can retype the committed SP1 carrier. On this floor fnd:curryFunctionality fnd:recognizesFrameCarrier prim:Frame (which is prim:isYonedaPoint true) conforms; the probe of record - fnd:probeBadFunctionality a fnd:Functionality ; fnd:recognizesFrameCarrier fnd:probeNotAFrame, where fnd:probeNotAFrame carries no prim:isYonedaPoint - makes the shape bite (conforms True->False), proving the recognition is onto the real Frame, not a rebuilt F. A first UNION branch (the guard-on-optional-edge close) fires when a fnd:Functionality carries NO fnd:recognizesFrameCarrier edge at all - the earlier single-clause form bound ?c via that edge, so a functionality that OMITS the recognition entirely (recognizing nothing) escaped GREEN; a fnd:Functionality with no fnd:recognizesFrameCarrier is now RED (the sole floor functionality fnd:curryFunctionality recognizes prim:Frame, so conforms=True). Mirrors q_frame_is_functionality." ;
    sh:targetClass fnd:Functionality ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "Curry-F recognition: a fnd:Functionality recognizes NO frame carrier at all (the defining fnd:recognizesFrameCarrier edge is OMITTED - the guard-on-optional-edge close), or it recognizes a frame carrier that is not the unary law's Yoneda point (no prim:isYonedaPoint true) - a rebuilt/invented parallel F, not the recognized committed Frame." ;
        sh:select """
            SELECT $this WHERE {
              {
                $this <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <urn:silmaril:fnd:#Functionality> .
                FILTER NOT EXISTS { $this <urn:silmaril:fnd:#recognizesFrameCarrier> ?c0 }
              } UNION {
                $this <urn:silmaril:fnd:#recognizesFrameCarrier> ?c .
                FILTER NOT EXISTS { ?c <urn:silmaril:prim:#isYonedaPoint> true }
              }
            }
        """ ;
    ] .

fnd:FunctorVarianceShape a sh:NodeShape ;
    rdfs:label "FunctorVarianceShape" ;
    rdfs:comment "The s4 variance tooth with teeth on fnd:VarianceStep (functionality.ttl, design s5 F3/F3'; Curry 1936 s4). SYN: cited standard mathematics; Directive 19 :279-281 mandates the function-type algebra carry the variance (contravariant domain, covariant codomain). The covariant codomain leg is the variance SP1's prim:RealizationTransport already proves covariantly (realization.ttl:2865-2920); the contravariant domain leg is the NEW law (F(dom,cod) a separate bifunctor from prim:Frame the product, since the unary law forbids a Frame input coordinate, docs/unary-byte-frame-law.md:686-687; design DF-D Opt 2). A sh:sparql node shape targeting fnd:VarianceStep with TWO UNION clauses over the reified F(X,Y) <: F(U,V) step (fnd:varianceFrom the sub F(X,Y), fnd:varianceTo the super F(U,V), each arrow type's fnd:hasDomainType / fnd:hasCodomainType, and the fnd:varSubtypeOf order): (a, domain) fires when the target domain U is neither equal to nor fnd:varSubtypeOf the source domain X - a domain WIDENING (contravariance violated); (b, codomain) fires when the source codomain Y is neither equal to nor fnd:varSubtypeOf the target codomain V - a codomain NARROWING (covariance violated). Every clause reads EDGE existence over the reified arrow types plus the subtype order (with an explicit FILTER for the equality case), never a bare sh:class over an rdfs:range, so inference=rdfs cannot forge a fnd:varSubtypeOf edge and defang it. On this floor fnd:varStepValid (F(Animal,Dog) <: F(Dog,Animal): domain narrows Animal->Dog, codomain widens Dog->Animal, both licensed by fnd:typeDog fnd:varSubtypeOf fnd:typeAnimal) conforms; the probe of record - fnd:probeVarStep a fnd:VarianceStep ; fnd:varianceFrom fnd:arrowTypeDogDog ; fnd:varianceTo fnd:arrowTypeAnimalDog (claims F(Dog,Dog) <: F(Animal,Dog), widening the domain Dog->Animal) - fires clause (a) and makes the shape bite (conforms True->False). Two further clauses (the guard-on-optional-edge close) add the EXISTENCE half the two variance clauses left open (they bind ?x/?y/?u/?v via fnd:varianceFrom/fnd:varianceTo and the endpoints' fnd:hasDomainType/fnd:hasCodomainType, so a fnd:VarianceStep that OMITS fnd:varianceFrom or fnd:varianceTo, or whose endpoint arrow type omits its domain/codomain, yielded no row and escaped): a fnd:VarianceStep with no complete fnd:varianceFrom (sub arrow with both domain and codomain) -> RED, and likewise for fnd:varianceTo. On this floor fnd:varStepValid carries a complete sub F(Animal,Dog) and super F(Dog,Animal), so conforms=True. Mirrors q_functor_variance." ;
    sh:targetClass fnd:VarianceStep ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "s4 variance: an accepted step OMITS a defining edge (no fnd:varianceFrom / fnd:varianceTo, or an endpoint arrow type missing its fnd:hasDomainType / fnd:hasCodomainType - the guard-on-optional-edge close), or it widens the domain (target domain U is neither = nor a subtype of source domain X - contravariance violated) or narrows the codomain (source codomain Y is neither = nor a subtype of target codomain V - covariance violated)." ;
        sh:select """
            SELECT $this WHERE {
              {
                $this <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <urn:silmaril:fnd:#VarianceStep> .
                FILTER NOT EXISTS {
                  $this <urn:silmaril:fnd:#varianceFrom> ?sf . ?sf <urn:silmaril:fnd:#hasDomainType> ?sfd . ?sf <urn:silmaril:fnd:#hasCodomainType> ?sfc .
                }
              } UNION {
                $this <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <urn:silmaril:fnd:#VarianceStep> .
                FILTER NOT EXISTS {
                  $this <urn:silmaril:fnd:#varianceTo> ?st . ?st <urn:silmaril:fnd:#hasDomainType> ?std . ?st <urn:silmaril:fnd:#hasCodomainType> ?stc .
                }
              } UNION {
                $this <urn:silmaril:fnd:#varianceFrom> ?sub ; <urn:silmaril:fnd:#varianceTo> ?sup .
                ?sub <urn:silmaril:fnd:#hasDomainType> ?x .
                ?sup <urn:silmaril:fnd:#hasDomainType> ?u .
                FILTER(?u != ?x)
                FILTER NOT EXISTS { ?u <urn:silmaril:fnd:#varSubtypeOf> ?x }
              } UNION {
                $this <urn:silmaril:fnd:#varianceFrom> ?sub2 ; <urn:silmaril:fnd:#varianceTo> ?sup2 .
                ?sub2 <urn:silmaril:fnd:#hasCodomainType> ?y .
                ?sup2 <urn:silmaril:fnd:#hasCodomainType> ?v .
                FILTER(?y != ?v)
                FILTER NOT EXISTS { ?y <urn:silmaril:fnd:#varSubtypeOf> ?v }
              }
            }
        """ ;
    ] .

fnd:SelfApplicationGuardShape a sh:NodeShape ;
    rdfs:label "SelfApplicationGuardShape" ;
    rdfs:comment "The Curry-s6 paradox-quarantine tooth with teeth on fnd:SelfApplication (functionality.ttl, design s5; Directive 19 :293; Fix-C genuine-resolution strengthening). SYN: cited standard mathematics (Curry 1936 s6 - the Russell contradiction chi=[f]N(ff), |-chi-chi=N(chi-chi) arises only from applying F outside its category; type discipline is the quarantine). It makes 'the foundation never naively self-applies' a graph fact via TWO INDEPENDENT violation conditions: (a) UNCONDITIONALLY when a self-application is fnd:admittedAsProposition true (treated as a naive proposition, the exact move s6 forbids - this branch is NOT gated behind the genuine-resolution FILTER, so even a genuinely-resolved, type-disciplined self-application admitted as a proposition is RED); OR (b) when a NOT-GENUINELY-RESOLVED self-application lacks silm:isProvisional true (it did not resolve to the Praeriehund provisional quarantine - this branch stays gated behind the genuine-resolution FILTER NOT EXISTS). Fix-C closes the exemption hole: the earlier tooth exempted a self-application on the mere EXISTENCE of a fnd:passedGuard edge to ANY node, so fnd:passedGuard fnd:propA (an arbitrary UNCONSTRAINED node) admitted the Russell witness. GENUINELY RESOLVED now means the fnd:passedGuard target ?g is a proper gate/quarantine resolution - ?g a fnd:ContractGate OR ?g a fnd:QuarantineResolution - that itself fnd:marksProvisional $this, AND $this carries silm:isProvisional true; only such a real resolution exempts, never an arbitrary fnd:passedGuard link. All branches read EDGE existence / literal values (fnd:passedGuard, fnd:marksProvisional, rdf:type fnd:ContractGate/fnd:QuarantineResolution, fnd:admittedAsProposition, silm:isProvisional) by sh:sparql, never a bare sh:class over an rdfs:range, so inference=rdfs (which materialises supertypes but cannot forge a fnd:ContractGate type onto an arbitrary node, nor a fnd:marksProvisional edge) cannot defang the quarantine. On this floor fnd:chiSelfApplication (ungated, silm:isProvisional true, no fnd:admittedAsProposition) conforms via the provisional path, and fnd:gatedSelfApplication (fnd:passedGuard fnd:typedSelfAppGate, a fnd:ContractGate that fnd:marksProvisional it, silm:isProvisional true) conforms as GENUINELY resolved; the probe of record - fnd:chiSelfApplication fnd:passedGuard fnd:propA (arbitrary node) + fnd:admittedAsProposition true + drop silm:isProvisional - is NOT genuinely resolved (propA is neither a fnd:ContractGate nor a fnd:QuarantineResolution and does not fnd:marksProvisional it) and admitted as a proposition, so the shape bites (conforms True->False), whereas the pre-Fix-C tooth wrongly exempted it. The T1 probe of record for the UNCONDITIONAL branch (a): fnd:gatedSelfApplication fnd:admittedAsProposition true - a GENUINELY-RESOLVED self-application (it passedGuard fnd:typedSelfAppGate which marksProvisional it, and carries silm:isProvisional true) admitted as a proposition - now bites RED, though it passed GREEN before the split (the Curry s6 asymmetry the split closes); dropping the flag returns it to GREEN while the ungated fnd:chiSelfApplication + fnd:admittedAsProposition true stays RED. Mirrors q_no_untyped_self_apply." ;
    sh:targetClass fnd:SelfApplication ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "s6 quarantine: a self-application is admitted as a naive proposition (fnd:admittedAsProposition true - forbidden UNCONDITIONALLY, gated or not), OR it is NOT genuinely resolved (no fnd:passedGuard to a fnd:ContractGate/fnd:QuarantineResolution that fnd:marksProvisional it while it carries silm:isProvisional true - an arbitrary fnd:passedGuard edge does not count) and fails to resolve to silm:isProvisional true - the Curry s6 type discipline is violated." ;
        sh:select """
            SELECT $this WHERE {
              {
                # (a) UNCONDITIONAL: admitting a self-application as a NAIVE PROPOSITION is the exact
                # Curry s6 move (treating chi-chi as a truth-bearer) - forbidden REGARDLESS of resolution,
                # so this disjunct is moved OUT from under the genuine-resolution FILTER NOT EXISTS: even a
                # genuinely-resolved, type-disciplined self-application may only ever be PROVISIONALLY named,
                # never admitted as a proposition (design s6 quarantine; Directive 19 :293).
                $this <urn:silmaril:fnd:#admittedAsProposition> true
              }
              UNION
              {
                # (b) an UNGATED / not-genuinely-resolved self-application that lacks silm:isProvisional true
                # (STILL gated behind the genuine-resolution FILTER NOT EXISTS, exactly as before): a
                # self-application not admitted by a fnd:ContractGate / fnd:QuarantineResolution that
                # fnd:marksProvisional it while it carries silm:isProvisional true must resolve to the
                # Praeriehund provisional quarantine, or it is a violation.
                FILTER NOT EXISTS {
                  $this <urn:silmaril:fnd:#passedGuard> ?g .
                  ?g <urn:silmaril:fnd:#marksProvisional> $this .
                  $this <urn:silmaril:entity#isProvisional> true .
                  { ?g <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <urn:silmaril:fnd:#ContractGate> }
                  UNION
                  { ?g <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <urn:silmaril:fnd:#QuarantineResolution> }
                }
                FILTER NOT EXISTS { $this <urn:silmaril:entity#isProvisional> true }
              }
            }
        """ ;
    ] .


# =====================================================================================
# fnd:CombinatorReducesShape (T8) — each combinator's defining reduction holds (design s5; Curry 1936
# combinators B/C/W/K/I, axioms (FB)(FC)(FW)(FK) + I x = x; combinators.ttl). A sh:sparql node shape
# targeting fnd:CombinatorReduction with five self-guarded UNION violation branches (one per combinator,
# each keyed on fnd:reducesCombinator), reading the reified result tree by fnd:appFn / fnd:appArg edge
# existence, never a range-inferred rdf:type, so inference=rdfs cannot forge an application edge and
# defang it (the SP1 defang discipline). Floor: the five witness reductions match their canonical forms
# -> conforms; probe (fnd:redK fnd:reducesTo -> fnd:argY, K x y = y) -> RED.
# =====================================================================================

fnd:CombinatorReducesShape a sh:NodeShape ;
    rdfs:label "CombinatorReducesShape" ;
    rdfs:comment "The combinator-reduction tooth with teeth on fnd:CombinatorReduction (combinators.ttl, design s5). It makes each of the five Curry combinators' defining reductions a CHECKABLE graph fact: I x = x, K x y = x, W x y = ((x y) y), C x y z = ((x z) y), B x y z = (x (y z)) (Curry 1936, the identity combinator + the axioms (FK)(FW)(FC)(FB)). All SYN, cited standard mathematics - B/C/W/K/I are grep-verified ABSENT from the corpus (a named-variable lambda corpus, 06a_functionality_corpus.md s2.3), so these are cited-from-Curry atoms with no Helios carrier, never masquerading as a lift. A sh:sparql node shape targeting fnd:CombinatorReduction whose constraint fires on a UNION of five self-guarded branches, each matching fnd:reducesCombinator on its combinator and then checking the canonical form: (I) fnd:reducesCombinator fnd:I with fnd:reducesTo != fnd:redArg1; (K) fnd:reducesCombinator fnd:K with fnd:reducesTo != fnd:redArg1; (W) fnd:reducesCombinator fnd:W where fnd:reducesTo is NOT the tree ((x y) y) - fnd:appFn an inner (x y) and fnd:appArg y; (C) fnd:reducesCombinator fnd:C where fnd:reducesTo is NOT ((x z) y) - fnd:appFn an inner (x z) and fnd:appArg y; (B) fnd:reducesCombinator fnd:B where fnd:reducesTo is NOT (x (y z)) - fnd:appFn x directly and fnd:appArg a sub-application (y z). Every clause reads EDGE existence over the reified reduction and its result tree (fnd:reducesCombinator / fnd:redArg1..3 / fnd:reducesTo / fnd:appFn / fnd:appArg), never a bare sh:class over an rdfs:range, so inference=rdfs (which can materialise an rdf:type but cannot forge an application edge between two specific term nodes) cannot defang it - the SP1 defang discipline. On this floor the five witness reductions fnd:redI/redK/redW/redC/redB match their canonical forms, so conforms=True; the probe of record - changing fnd:redK fnd:reducesTo from fnd:argX to fnd:argY (K x y = y, the wrong projection) - makes the K branch's FILTER(?res != ?x) fire and the shape bite (conforms=True->False), proving the tooth. A SIXTH branch (the guard-on-optional-edge close) fires when a fnd:CombinatorReduction names a fnd:reducesCombinator but OMITS fnd:reducesTo entirely - the five canonical-form branches all bind ?res via fnd:reducesTo, so a reduction with combinator+args but no result yielded no row and escaped GREEN; a reduction with reducesCombinator and no reducesTo is now RED (the real witnesses fnd:redI/redK/redW/redC/redB all carry fnd:reducesTo, so conforms=True)." ;
    sh:targetClass fnd:CombinatorReduction ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "combinator reduction: a fnd:CombinatorReduction names a fnd:reducesCombinator but OMITS its fnd:reducesTo result (the guard-on-optional-edge close), or a combinator's fnd:reducesTo departs from its Curry canonical form (I x = x, K x y = x, W x y = ((x y) y), C x y z = ((x z) y), B x y z = (x (y z)))." ;
        sh:select """
            SELECT $this WHERE {
              {
                $this <urn:silmaril:fnd:#reducesCombinator> ?comb .
                FILTER NOT EXISTS { $this <urn:silmaril:fnd:#reducesTo> ?anyres }
              } UNION {
                $this <urn:silmaril:fnd:#reducesCombinator> <urn:silmaril:fnd:#I> ;
                      <urn:silmaril:fnd:#redArg1> ?x ; <urn:silmaril:fnd:#reducesTo> ?res .
                FILTER(?res != ?x)
              } UNION {
                $this <urn:silmaril:fnd:#reducesCombinator> <urn:silmaril:fnd:#K> ;
                      <urn:silmaril:fnd:#redArg1> ?x ; <urn:silmaril:fnd:#reducesTo> ?res .
                FILTER(?res != ?x)
              } UNION {
                $this <urn:silmaril:fnd:#reducesCombinator> <urn:silmaril:fnd:#W> ;
                      <urn:silmaril:fnd:#redArg1> ?x ; <urn:silmaril:fnd:#redArg2> ?y ; <urn:silmaril:fnd:#reducesTo> ?res .
                FILTER NOT EXISTS {
                  ?res <urn:silmaril:fnd:#appFn> ?in ; <urn:silmaril:fnd:#appArg> ?y .
                  ?in  <urn:silmaril:fnd:#appFn> ?x ; <urn:silmaril:fnd:#appArg> ?y .
                }
              } UNION {
                $this <urn:silmaril:fnd:#reducesCombinator> <urn:silmaril:fnd:#C> ;
                      <urn:silmaril:fnd:#redArg1> ?x ; <urn:silmaril:fnd:#redArg2> ?y ; <urn:silmaril:fnd:#redArg3> ?z ; <urn:silmaril:fnd:#reducesTo> ?res .
                FILTER NOT EXISTS {
                  ?res <urn:silmaril:fnd:#appFn> ?in ; <urn:silmaril:fnd:#appArg> ?y .
                  ?in  <urn:silmaril:fnd:#appFn> ?x ; <urn:silmaril:fnd:#appArg> ?z .
                }
              } UNION {
                $this <urn:silmaril:fnd:#reducesCombinator> <urn:silmaril:fnd:#B> ;
                      <urn:silmaril:fnd:#redArg1> ?x ; <urn:silmaril:fnd:#redArg2> ?y ; <urn:silmaril:fnd:#redArg3> ?z ; <urn:silmaril:fnd:#reducesTo> ?res .
                FILTER NOT EXISTS {
                  ?res <urn:silmaril:fnd:#appFn> ?x ; <urn:silmaril:fnd:#appArg> ?in .
                  ?in  <urn:silmaril:fnd:#appFn> ?y ; <urn:silmaril:fnd:#appArg> ?z .
                }
              }
            }
        """ ;
    ] .


# =====================================================================================
# fnd:FnLadderShape (T8) — the F_n arity recurrence holds (design s5; Curry Def 2.1: F_0=I, F_1=F,
# F_{n+1}=(C.BB_{n+1}) F_1 F_n; combinators.ttl). A sh:sparql node shape targeting fnd:NaryFunctionality
# with three violation clauses: (base) index-0 must be fnd:fnDefinedAs fnd:I and index-1 fnd:curryFunctionality;
# (successor) a rung with fnd:fnPredecessor must have predecessorIndex+1 = ownIndex, and (index >= 2) must
# carry fnd:fnBaseCase fnd:fnRung1 and fnd:composedVia a fnd:Compositor. Edge/arithmetic, defang-proof.
# Floor: fnRung0..3 satisfy the recurrence -> conforms; probe (fnd:fnRung2 fnd:fnPredecessor -> fnd:fnRung0,
# 0+1 != 2) -> RED.
# =====================================================================================

fnd:FnLadderShape a sh:NodeShape ;
    rdfs:label "FnLadderShape" ;
    rdfs:comment "The F_n arity-ladder recurrence tooth with teeth on fnd:NaryFunctionality (combinators.ttl, design s5). It makes Curry's Def 2.1 recurrence (F_0 = I, F_1 = F, F_{n+1} = (C.BB_{n+1}) F_1 F_n) a CHECKABLE graph fact. SYN, cited standard mathematics (the corpus has no F_n; the ladder is countably indexed but each rung finite, sitting inside the T3 finite-ordinal floor with no transfinite gap). A sh:sparql node shape targeting fnd:NaryFunctionality whose constraint fires on a UNION of clauses: (base-0) $this fnd:fnIndex 0 but NOT fnd:fnDefinedAs fnd:I; (base-1) $this fnd:fnIndex 1 but NOT fnd:fnDefinedAs fnd:curryFunctionality (the F_1 = F seam to Pillar 4); (successor arithmetic) $this fnd:fnPredecessor ?p with fnd:fnIndex ?i and ?p fnd:fnIndex ?pi where (?pi + 1) != ?i (the predecessor is not exactly one rung below - a broken rung); (successor base-fold) $this fnd:fnIndex ?i with ?i >= 2 but NOT fnd:fnBaseCase fnd:fnRung1 (the recurrence dropped the F_1 fold); (successor compositor) $this fnd:fnIndex ?i with ?i >= 2 but NOT fnd:composedVia a fnd:Compositor (no composition mechanism). Every clause reads EDGE existence or integer arithmetic over the ladder (fnd:fnIndex / fnd:fnDefinedAs / fnd:fnPredecessor / fnd:fnBaseCase / fnd:composedVia), never a bare sh:class over an rdfs:range, so inference=rdfs cannot defang it - the SP1 defang discipline. On this floor fnd:fnRung0 (index 0, defined as fnd:I), fnd:fnRung1 (index 1, defined as fnd:curryFunctionality), fnd:fnRung2 (index 2, predecessor fnRung1, base-case fnRung1, composed via gammaCompositor) and fnd:fnRung3 (index 3, predecessor fnRung2, base-case fnRung1, composed via gammaCompositor) satisfy every clause, so conforms=True; the probe of record - changing fnd:fnRung2 fnd:fnPredecessor from fnd:fnRung1 to fnd:fnRung0 (predecessor index 0, own index 2, so 0 + 1 != 2, a broken rung) - makes the arithmetic clause fire and the shape bite (conforms=True->False), proving the tooth. Two further clauses (the guard-on-optional-edge close) add the EXISTENCE half the successor-arithmetic clause left open (it binds ?p via fnd:fnPredecessor and ?pi via the predecessor's fnd:fnIndex, so a successor that OMITS fnd:fnPredecessor, or whose predecessor omits fnd:fnIndex, yielded no row and escaped): a rung with fnd:fnIndex >= 2 and NO fnd:fnPredecessor -> RED, and a successor whose fnd:fnPredecessor carries NO fnd:fnIndex -> RED. On this floor fnd:fnRung2/fnRung3 each carry a fnd:fnPredecessor whose fnd:fnIndex is exactly one below, so conforms=True; a predecessor-less index-2 rung makes the first new clause bite." ;
    sh:targetClass fnd:NaryFunctionality ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "F_n ladder: a rung breaks Curry's Def 2.1 recurrence - the index-0 base is not I, the index-1 base is not the functionality F, a successor's predecessor is not one index below, or a successor omits the F_1 base-fold or the compositor." ;
        sh:select """
            SELECT $this WHERE {
              {
                $this <urn:silmaril:fnd:#fnIndex> 0 .
                FILTER NOT EXISTS { $this <urn:silmaril:fnd:#fnDefinedAs> <urn:silmaril:fnd:#I> }
              } UNION {
                $this <urn:silmaril:fnd:#fnIndex> 1 .
                FILTER NOT EXISTS { $this <urn:silmaril:fnd:#fnDefinedAs> <urn:silmaril:fnd:#curryFunctionality> }
              } UNION {
                $this <urn:silmaril:fnd:#fnPredecessor> ?p ; <urn:silmaril:fnd:#fnIndex> ?i .
                ?p <urn:silmaril:fnd:#fnIndex> ?pi .
                FILTER((?pi + 1) != ?i)
              } UNION {
                $this <urn:silmaril:fnd:#fnIndex> ?i .
                FILTER(?i >= 2)
                FILTER NOT EXISTS { $this <urn:silmaril:fnd:#fnBaseCase> <urn:silmaril:fnd:#fnRung1> }
              } UNION {
                $this <urn:silmaril:fnd:#fnIndex> ?i .
                FILTER(?i >= 2)
                FILTER NOT EXISTS { $this <urn:silmaril:fnd:#composedVia> ?g . ?g <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <urn:silmaril:fnd:#Compositor> }
              } UNION {
                $this <urn:silmaril:fnd:#fnIndex> ?i .
                FILTER(?i >= 2)
                FILTER NOT EXISTS { $this <urn:silmaril:fnd:#fnPredecessor> ?p }
              } UNION {
                $this <urn:silmaril:fnd:#fnPredecessor> ?p ; <urn:silmaril:fnd:#fnIndex> ?i .
                FILTER(?i >= 2)
                FILTER NOT EXISTS { ?p <urn:silmaril:fnd:#fnIndex> ?pi }
              }
            }
        """ ;
    ] .


# =====================================================================================
# fnd:CombinatorProgenitorShape (T8) — the agnostic combinator progenitor grounds nothing + no combinator
# crams two arities (design s5, Directive 17; the LIFTED byte_order / crs-geometer progenitor pattern;
# combinators.ttl). A sh:sparql node shape with TWO targets (sh:targetNode fnd:Combinator for
# grounds-nothing; sh:targetSubjectsOf fnd:combinatorArity for no-cram), each constraint self-guarded.
# Constraint A: the progenitor fnd:Combinator carries NO fnd:combinatorArity, NO fnd:combinatorSymbol,
# and is the fnd:reducesCombinator of NO reduction. Constraint B: no combinator carries two distinct
# fnd:combinatorArity. Edge-existence, defang-proof. Floor: the progenitor is bare, each combinator has
# one arity -> conforms; probe (fnd:Combinator fnd:combinatorArity 2) -> RED.
# =====================================================================================

fnd:CombinatorProgenitorShape a sh:NodeShape ;
    rdfs:label "CombinatorProgenitorShape" ;
    rdfs:comment "The agnostic combinator-progenitor tooth with teeth on fnd:Combinator and on the combinators (combinators.ttl, design s5, Directive 17). It makes two doctrines graph facts: (1) the agnostic fnd:Combinator progenitor GROUNDS NOTHING (the LIFTED byte_order / crs-geometer progenitor pattern, basicttl/crs/geometers.ttl:76 - the packaging is lifted though the combinator content is cited Curry), and (2) NO combinator crams two arities (one canonical arity per child, the Directive-17 no-privilege / one-law-per-child discipline, mirroring fnd:AlgebraProgenitorShape). A sh:sparql node shape with TWO targets - sh:targetNode fnd:Combinator (the grounds-nothing focus) and sh:targetSubjectsOf fnd:combinatorArity (every combinator) - carrying TWO self-guarded sh:sparql constraints. Constraint A (grounds nothing) fires when $this = fnd:Combinator carries a fnd:combinatorArity, a fnd:combinatorSymbol, or is the fnd:reducesCombinator object of some fnd:CombinatorReduction (the progenitor must ground no arity, no symbol, no reduction - only its concrete children B/C/W/K/I do). Constraint B (no cram) fires when $this carries TWO DISTINCT fnd:combinatorArity (a combinator with two conflicting arities). Each constraint self-guards (A on $this = fnd:Combinator, B on the count of fnd:combinatorArity), so each no-ops on the irrelevant target - the same self-guarded multi-target pattern fnd:AlgebraProgenitorShape uses. Both read EDGE existence (fnd:combinatorArity / fnd:combinatorSymbol / fnd:reducesCombinator), never a bare sh:class over an rdfs:range, so inference=rdfs cannot defang it - the SP1 defang discipline. On this floor fnd:Combinator is bare (no arity, no symbol, reduced by nothing) and each of fnd:B/C/W/K/I carries exactly one arity, so conforms=True; the probes of record - (a) fnd:Combinator fnd:combinatorArity 2 (the progenitor grounding an arity) fires constraint A, and (b) adding a second distinct fnd:combinatorArity to any combinator fires constraint B - each makes the shape bite (conforms=True->False), proving both teeth." ;
    sh:targetNode fnd:Combinator ;
    sh:targetSubjectsOf fnd:combinatorArity ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "combinator progenitor 'grounds nothing' (A): the agnostic fnd:Combinator progenitor carries a fnd:combinatorArity, a fnd:combinatorSymbol, or is reduced by a fnd:CombinatorReduction - it must ground NOTHING (only its concrete children B/C/W/K/I carry arity/symbol/reduction)." ;
        sh:select """
            SELECT $this WHERE {
              FILTER($this = <urn:silmaril:fnd:#Combinator>)
              {
                $this <urn:silmaril:fnd:#combinatorArity> ?a .
              } UNION {
                $this <urn:silmaril:fnd:#combinatorSymbol> ?s .
              } UNION {
                ?red <urn:silmaril:fnd:#reducesCombinator> $this .
              }
            }
        """ ;
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "combinator 'no cram' (B): this combinator carries TWO DISTINCT fnd:combinatorArity - a combinator must have EXACTLY ONE canonical arity (Directive 17, never crammed)." ;
        sh:select """
            SELECT $this WHERE {
              $this <urn:silmaril:fnd:#combinatorArity> ?a1 , ?a2 .
              FILTER(?a1 != ?a2)
            }
        """ ;
    ] .


# =====================================================================================
# fnd:ImplicationKCWShape (T9) — the K/C/W implication laws hold (design s5; Curry 1936 s5, the K/C/W
# implication laws Thm 5.8; logic.ttl). A sh:sparql node shape targeting fnd:ImplicationLaw with three
# self-guarded UNION violation branches (one per combinator, each keyed on fnd:lawCombinator), walking
# the reified implication-formula tree by fnd:antecedent / fnd:consequent edge existence and binding the
# shared propositions by SPARQL variable identity, never a range-inferred rdf:type (the SP1 defang
# discipline). Floor: the three witness laws match their canonical formulae -> conforms; probe (a K-law
# whose formula is the bare A ⊃ B, not weakening) -> RED.
# =====================================================================================

fnd:ImplicationKCWShape a sh:NodeShape ;
    rdfs:label "ImplicationKCWShape" ;
    rdfs:comment "The K/C/W implication-law tooth with teeth on fnd:ImplicationLaw (logic.ttl, design s5). It makes Curry s5's three implication laws CHECKABLE graph facts: K = A ⊃ (B ⊃ A) (weakening), W = (A ⊃ (A ⊃ B)) ⊃ (A ⊃ B) (contraction), C = (A ⊃ (B ⊃ C)) ⊃ (B ⊃ (A ⊃ C)) (exchange) - the implication-face of the T8 combinators K/W/C respectively (Curry 1936 s5, Thm 5.8: F is definable from ⊃ given exactly these K/C/W laws). All SYN, cited standard mathematics - the corpus has no implicational calculus, so these are cited-from-Curry atoms with no Helios carrier, never masquerading as a lift. A sh:sparql node shape targeting fnd:ImplicationLaw whose constraint fires on a UNION of three self-guarded branches, each matching fnd:lawCombinator on its combinator and then checking that fnd:lawFormula has the canonical shape via an inner FILTER NOT EXISTS over the reified tree: (K) fnd:lawCombinator fnd:K where the formula is NOT A ⊃ (B ⊃ A) - antecedent ?a, consequent an implication whose antecedent is some ?b and whose consequent is the SAME ?a (the outer antecedent reappearing - weakening); (W) fnd:lawCombinator fnd:W where the formula is NOT (A ⊃ (A ⊃ B)) ⊃ (A ⊃ B) - antecedent A ⊃ (A ⊃ B) with the doubled A, consequent A ⊃ B sharing that A and the B (contraction); (C) fnd:lawCombinator fnd:C where the formula is NOT (A ⊃ (B ⊃ C)) ⊃ (B ⊃ (A ⊃ C)) - antecedent A ⊃ (B ⊃ C), consequent B ⊃ (A ⊃ C) with A and B swapped and C fixed (exchange). Every clause reads EDGE existence over the reified formula (fnd:lawCombinator / fnd:lawFormula / fnd:antecedent / fnd:consequent), binding shared propositions by SPARQL variable identity, never a bare sh:class over an rdfs:range, so inference=rdfs (which can materialise an rdf:type but cannot forge an antecedent/consequent edge between two specific proposition nodes) cannot defang it - the SP1 defang discipline. On this floor fnd:lawK/lawW/lawC match their canonical formulae, so conforms=True; the probe of record - injecting fnd:probeLawK a fnd:ImplicationLaw ; fnd:lawCombinator fnd:K ; fnd:lawFormula fnd:implAB (K = A ⊃ B, whose consequent propB is atomic, NOT an implication whose consequent is the outer antecedent) - makes the K branch's inner FILTER NOT EXISTS fire and the shape bite (conforms=True->False), proving the tooth. Two further branches (the guard-on-optional-edge close) add the EXISTENCE half the three canonical-shape branches left open (they bind ?f via fnd:lawFormula and self-guard on fnd:lawCombinator, so an fnd:ImplicationLaw that OMITS fnd:lawFormula or fnd:lawCombinator yielded no row and escaped): an fnd:ImplicationLaw with no fnd:lawFormula -> RED, and one with no fnd:lawCombinator -> RED. On this floor fnd:lawK/lawW/lawC each carry both, so conforms=True. Mirrors q_implication_kcw." ;
    sh:targetClass fnd:ImplicationLaw ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "K/C/W implication law: a law OMITS a defining edge (no fnd:lawCombinator or no fnd:lawFormula - the guard-on-optional-edge close), or a law's fnd:lawFormula departs from its combinator's canonical shape (K = A ⊃ (B ⊃ A) weakening, W = (A ⊃ (A ⊃ B)) ⊃ (A ⊃ B) contraction, C = (A ⊃ (B ⊃ C)) ⊃ (B ⊃ (A ⊃ C)) exchange)." ;
        sh:select """
            SELECT $this WHERE {
              {
                $this <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <urn:silmaril:fnd:#ImplicationLaw> .
                FILTER NOT EXISTS { $this <urn:silmaril:fnd:#lawFormula> ?anyf }
              } UNION {
                $this <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <urn:silmaril:fnd:#ImplicationLaw> .
                FILTER NOT EXISTS { $this <urn:silmaril:fnd:#lawCombinator> ?anyc }
              } UNION {
                $this <urn:silmaril:fnd:#lawCombinator> <urn:silmaril:fnd:#K> ; <urn:silmaril:fnd:#lawFormula> ?f .
                FILTER NOT EXISTS {
                  ?f <urn:silmaril:fnd:#antecedent> ?a ; <urn:silmaril:fnd:#consequent> ?c .
                  ?c <urn:silmaril:fnd:#antecedent> ?b ; <urn:silmaril:fnd:#consequent> ?a .
                }
              } UNION {
                $this <urn:silmaril:fnd:#lawCombinator> <urn:silmaril:fnd:#W> ; <urn:silmaril:fnd:#lawFormula> ?f .
                FILTER NOT EXISTS {
                  ?f <urn:silmaril:fnd:#antecedent> ?ant ; <urn:silmaril:fnd:#consequent> ?con .
                  ?ant <urn:silmaril:fnd:#antecedent> ?a ; <urn:silmaril:fnd:#consequent> ?inner .
                  ?inner <urn:silmaril:fnd:#antecedent> ?a ; <urn:silmaril:fnd:#consequent> ?b .
                  ?con <urn:silmaril:fnd:#antecedent> ?a ; <urn:silmaril:fnd:#consequent> ?b .
                }
              } UNION {
                $this <urn:silmaril:fnd:#lawCombinator> <urn:silmaril:fnd:#C> ; <urn:silmaril:fnd:#lawFormula> ?f .
                FILTER NOT EXISTS {
                  ?f <urn:silmaril:fnd:#antecedent> ?ant ; <urn:silmaril:fnd:#consequent> ?con .
                  ?ant <urn:silmaril:fnd:#antecedent> ?a ; <urn:silmaril:fnd:#consequent> ?bc .
                  ?bc <urn:silmaril:fnd:#antecedent> ?b ; <urn:silmaril:fnd:#consequent> ?c .
                  ?con <urn:silmaril:fnd:#antecedent> ?b ; <urn:silmaril:fnd:#consequent> ?ac .
                  ?ac <urn:silmaril:fnd:#antecedent> ?a ; <urn:silmaril:fnd:#consequent> ?c .
                }
              }
            }
        """ ;
    ] .


# =====================================================================================
# fnd:CurryHowardShape (T9) — the arrow sense and the implication sense coincide on the witness (design
# s5; Curry 1936 s5 Thm 5.8, the functionality<->implication taiji; logic.ttl). A sh:sparql node shape
# targeting fnd:CurryHowardCorrespondence with two UNION violation branches (domain/antecedent,
# codomain/consequent) reading the arrow type's domain/codomain, the implication's antecedent/consequent,
# and the propositions-as-types bridge fnd:propType by edge existence, never a range-inferred type
# (the SP1 defang discipline). Floor: chWitness's two senses coincide -> conforms; probe (F(Animal,Dog)
# paired with Dog ⊃ Animal) -> RED.
# =====================================================================================

fnd:CurryHowardShape a sh:NodeShape ;
    rdfs:label "CurryHowardShape" ;
    rdfs:comment "The Curry-Howard taiji tooth with teeth on fnd:CurryHowardCorrespondence (logic.ttl, design s5; Directive 16 polysemy). It makes 'the arrow sense and the implication sense are ONE object' a CHECKABLE graph fact: the exponential B^A = the T7 fnd:ArrowType F(A,B) (the how-you-compute face) and the implication A ⊃ B = an fnd:Implication (the what-it-proves face) COINCIDE (Curry 1936 s5: F' ≡ [x,y,z](u)(xu ⊃ y(zu)), Thm 5.8 - every F-theorem holds for F' given the K/C/W laws). SYN, cited standard mathematics. A sh:sparql node shape targeting fnd:CurryHowardCorrespondence whose constraint fires on a UNION of two branches over the reified correspondence (fnd:arrowSense the arrow type, fnd:implicationSense the implication): (domain) fires when the arrow's fnd:hasDomainType is NOT the fnd:WitnessType the implication's fnd:antecedent denotes via the propositions-as-types bridge fnd:propType (an antecedent/domain divergence); (codomain) fires when the arrow's fnd:hasCodomainType is NOT the type the implication's fnd:consequent denotes via fnd:propType (a consequent/codomain divergence). Every clause reads EDGE existence over the reified correspondence, the arrow type's domain/codomain, the implication's antecedent/consequent, and the fnd:propType bridge, never a bare sh:class over an rdfs:range, so inference=rdfs cannot forge a propType edge and defang it - the SP1 defang discipline. On this floor fnd:chWitness (arrow F(Animal,Dog), implication Animal ⊃ Dog, propAnimal->typeAnimal, propDog->typeDog) coincides on both coordinates, so conforms=True; the probe of record - fnd:probeCh a fnd:CurryHowardCorrespondence ; fnd:arrowSense fnd:arrowTypeAnimalDog ; fnd:implicationSense fnd:implDogAnimal (F(Animal,Dog) paired with Dog ⊃ Animal: the arrow domain typeAnimal but the antecedent propDog denotes typeDog) - fires the domain branch and makes the shape bite (conforms=True->False), proving the tooth. Two further branches (the guard-on-optional-edge close) add the EXISTENCE half the two divergence branches left open (they bind ?arr/?impl and their domain/codomain/antecedent/consequent, so a correspondence that OMITS fnd:arrowSense or fnd:implicationSense, or whose sense lacks its domain/codomain/antecedent/consequent, yielded no row and escaped): a fnd:CurryHowardCorrespondence with no complete fnd:arrowSense (domain+codomain) or no complete fnd:implicationSense (antecedent+consequent) -> RED. On this floor fnd:chWitness carries both complete senses, so conforms=True. Mirrors q_curry_howard." ;
    sh:targetClass fnd:CurryHowardCorrespondence ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "Curry-Howard taiji: a correspondence OMITS a defining edge (no fnd:arrowSense with a domain+codomain type, or no fnd:implicationSense with an antecedent+consequent - the guard-on-optional-edge close), or its arrow sense and implication sense diverge - the arrow domain type is not the type the implication antecedent denotes (via fnd:propType), or the arrow codomain type is not the type the implication consequent denotes." ;
        sh:select """
            SELECT $this WHERE {
              {
                $this <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <urn:silmaril:fnd:#CurryHowardCorrespondence> .
                FILTER NOT EXISTS {
                  $this <urn:silmaril:fnd:#arrowSense> ?arr0 . ?arr0 <urn:silmaril:fnd:#hasDomainType> ?d0 . ?arr0 <urn:silmaril:fnd:#hasCodomainType> ?c0 .
                }
              } UNION {
                $this <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <urn:silmaril:fnd:#CurryHowardCorrespondence> .
                FILTER NOT EXISTS {
                  $this <urn:silmaril:fnd:#implicationSense> ?impl0 . ?impl0 <urn:silmaril:fnd:#antecedent> ?a0 . ?impl0 <urn:silmaril:fnd:#consequent> ?cc0 .
                }
              } UNION {
                $this <urn:silmaril:fnd:#arrowSense> ?arr ; <urn:silmaril:fnd:#implicationSense> ?impl .
                ?arr <urn:silmaril:fnd:#hasDomainType> ?dt .
                ?impl <urn:silmaril:fnd:#antecedent> ?ant .
                FILTER NOT EXISTS { ?ant <urn:silmaril:fnd:#propType> ?dt }
              } UNION {
                $this <urn:silmaril:fnd:#arrowSense> ?arr ; <urn:silmaril:fnd:#implicationSense> ?impl .
                ?arr <urn:silmaril:fnd:#hasCodomainType> ?ct .
                ?impl <urn:silmaril:fnd:#consequent> ?con .
                FILTER NOT EXISTS { ?con <urn:silmaril:fnd:#propType> ?ct }
              }
            }
        """ ;
    ] .


# =====================================================================================
# fnd:ProofTermTypedShape (T9) — a proof term is typed by the implication it claims (design s5; Curry
# 1936 s5, terms-as-proofs; logic.ttl). A sh:sparql node shape targeting fnd:ProofTerm with two UNION
# violation branches (domain/antecedent, codomain/consequent) reading the proof term's arrow type, the
# proved implication, and the fnd:propType bridge by edge existence, never a range-inferred type
# (the SP1 defang discipline). Floor: proofAnimalDog's type matches its proved implication -> conforms;
# probe (a proof term claiming Animal ⊃ Dog but typed F(Dog,Animal)) -> RED.
# =====================================================================================

fnd:ProofTermTypedShape a sh:NodeShape ;
    rdfs:label "ProofTermTypedShape" ;
    rdfs:comment "The proof-term typing tooth with teeth on fnd:ProofTerm (logic.ttl, design s5; the plan's T9 probe - a proof term whose type isn't the implication it claims -> RED). It makes the terms-as-proofs face of Curry-Howard a CHECKABLE graph fact: a proof of an implication A ⊃ B is a function of type F(A,B) (Curry 1936 s5), so a proof term's fnd:proofTermType (its T7 fnd:ArrowType) must match its fnd:provesImplication (the fnd:Implication it witnesses). SYN, cited standard mathematics. A sh:sparql node shape targeting fnd:ProofTerm whose constraint fires on a UNION of two branches (fnd:provesImplication the implication, fnd:proofTermType the arrow type): (domain) fires when the arrow's fnd:hasDomainType is NOT the fnd:WitnessType the proved implication's fnd:antecedent denotes via fnd:propType (the proof accepts the wrong type); (codomain) fires when the arrow's fnd:hasCodomainType is NOT the type the proved implication's fnd:consequent denotes via fnd:propType (the proof returns the wrong type). This is the INHABITANT-level coincidence complementing fnd:CurryHowardShape's CONSTRUCTOR-level one. Every clause reads EDGE existence over the reified proof term, its arrow type's domain/codomain, the proved implication's antecedent/consequent, and the fnd:propType bridge, never a bare sh:class over an rdfs:range, so inference=rdfs cannot forge a propType edge and defang it - the SP1 defang discipline. On this floor fnd:proofAnimalDog (proves Animal ⊃ Dog, typed F(Animal,Dog)) matches on both coordinates, so conforms=True; the probe of record - fnd:probeProof a fnd:ProofTerm ; fnd:provesImplication fnd:implAnimalDog ; fnd:proofTermType fnd:arrowTypeDogAnimal (claims to prove Animal ⊃ Dog but is typed F(Dog,Animal): the arrow domain typeDog, but the proved antecedent propAnimal denotes typeAnimal) - fires the domain branch and makes the shape bite (conforms=True->False), proving the tooth. Two further branches (the guard-on-optional-edge close) add the EXISTENCE half the two divergence branches left open (they bind ?arr/?impl and their domain/codomain/antecedent/consequent, so a proof term that OMITS fnd:proofTermType or fnd:provesImplication, or whose arrow type / implication lacks its domain/codomain/antecedent/consequent, yielded no row and escaped): a fnd:ProofTerm with no complete fnd:proofTermType or no complete fnd:provesImplication -> RED. On this floor fnd:proofAnimalDog carries both, so conforms=True. Mirrors q_proof_term_typed." ;
    sh:targetClass fnd:ProofTerm ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "proof-term typing: a proof term OMITS a defining edge (no fnd:proofTermType with a domain+codomain, or no fnd:provesImplication with an antecedent+consequent - the guard-on-optional-edge close), or its fnd:proofTermType diverges from its fnd:provesImplication - the arrow domain type is not the type the proved antecedent denotes (via fnd:propType), or the arrow codomain type is not the type the proved consequent denotes (a proof term whose type isn't the implication it claims)." ;
        sh:select """
            SELECT $this WHERE {
              {
                $this <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <urn:silmaril:fnd:#ProofTerm> .
                FILTER NOT EXISTS {
                  $this <urn:silmaril:fnd:#proofTermType> ?arr0 . ?arr0 <urn:silmaril:fnd:#hasDomainType> ?d0 . ?arr0 <urn:silmaril:fnd:#hasCodomainType> ?c0 .
                }
              } UNION {
                $this <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <urn:silmaril:fnd:#ProofTerm> .
                FILTER NOT EXISTS {
                  $this <urn:silmaril:fnd:#provesImplication> ?impl0 . ?impl0 <urn:silmaril:fnd:#antecedent> ?a0 . ?impl0 <urn:silmaril:fnd:#consequent> ?cc0 .
                }
              } UNION {
                $this <urn:silmaril:fnd:#provesImplication> ?impl ; <urn:silmaril:fnd:#proofTermType> ?arr .
                ?arr <urn:silmaril:fnd:#hasDomainType> ?dt .
                ?impl <urn:silmaril:fnd:#antecedent> ?ant .
                FILTER NOT EXISTS { ?ant <urn:silmaril:fnd:#propType> ?dt }
              } UNION {
                $this <urn:silmaril:fnd:#provesImplication> ?impl ; <urn:silmaril:fnd:#proofTermType> ?arr .
                ?arr <urn:silmaril:fnd:#hasCodomainType> ?ct .
                ?impl <urn:silmaril:fnd:#consequent> ?con .
                FILTER NOT EXISTS { ?con <urn:silmaril:fnd:#propType> ?ct }
              }
            }
        """ ;
    ] .


# =====================================================================================
# fnd:ReanchorAdditiveShape (T10) — every prior-floor grounding is an EDGE onto a genuine structure; no
# rebuild-in-disguise (design s7; 05_reanchor_surface.md s4). A sh:sparql node shape on the subjects of
# fnd:groundsInAlgebra: it fires when a fnd:groundsInAlgebra edge targets a structure that is NOT a genuine
# (Sigma,E) presented-algebra rung - one carrying no fnd:hasSignature - i.e. a re-anchor onto a non-matching
# node (a rebuild-in-disguise) rather than an additive grounding onto a real rung. Edge-existence on
# fnd:hasSignature (never a range-inferred type, so inference=rdfs cannot forge it - the SP1 defang
# discipline). Floor: prim:ByteVector->fnd:Monoid, prim:Integer->fnd:Ring, prim:Rational/prim:Real->fnd:Field
# all carry fnd:hasSignature -> conforms; probe fnd:probeBadAlgebraGrounding fnd:groundsInAlgebra fnd:setBit2
# (a fnd:Set, no signature) -> RED. Mirrors q_reanchor_additive's inner clause.
# =====================================================================================

fnd:ReanchorAdditiveShape a sh:NodeShape ;
    rdfs:label "ReanchorAdditiveShape" ;
    rdfs:comment "The additive-re-anchor tooth with teeth on the subjects of fnd:groundsInAlgebra (reanchor.ttl, design s7; 05_reanchor_surface.md s4 - 15/16 surface rows additive). It makes the ADDITIVE discipline a graph fact: a committed carrier re-anchors by an EDGE onto the algebra it ALREADY IS, never by a rebuild onto a bogus node. A sh:sparql node shape (sh:targetSubjectsOf fnd:groundsInAlgebra) whose constraint fires when a carrier ?this with fnd:groundsInAlgebra ?alg has an ?alg that carries NO fnd:hasSignature - i.e. the grounding lands on a structure that is not a genuine (Sigma,E) presented-algebra rung (every real rung - fnd:Magma..fnd:AbelianGroup, fnd:Semiring/Ring/Field - carries a fnd:hasSignature; the agnostic fnd:AlgebraicStructure progenitor and any random node do not). It reads EDGE existence on fnd:hasSignature (of the target), never a bare sh:class over fnd:groundsInAlgebra's rdfs:range fnd:AlgebraicStructure (which inference=rdfs WOULD materialise and defang) - the SP1 defang discipline. On this floor every fnd:groundsInAlgebra edge (prim:ByteVector->fnd:Monoid, prim:Integer->fnd:Ring, prim:Rational/prim:Real->fnd:Field) targets a signature-carrying rung, so conforms=True; the probe of record - fnd:probeBadAlgebraGrounding fnd:groundsInAlgebra fnd:setBit2 (grounding onto a fnd:Set, which has no fnd:hasSignature: a re-anchor onto a non-matching structure) - makes the shape bite (conforms=True->False), proving the tooth. It ALSO targets the subjects of fnd:groundsInSpace with a second, symmetric constraint that brings the fourth grounding predicate to PARITY with its three siblings (H2): every fnd:groundsInSpace edge must land on a GENUINE space object - one carrying a space-structure EDGE (fnd:hasPoint / fnd:hasDistanceAssertion of a fnd:MetricSpace, fnd:hasTessellationVertices of a fnd:PerceptualTessellation, or fnd:hasCarrierSet / fnd:hasOpenSet of a fnd:TopologicalSpace), never the range-inferred rdf:type fnd:MetricSpace (which inference=rdfs materialises onto any groundsInSpace target and would defang a type check) - the same defang discipline the fnd:hasSignature algebra branch uses. On this floor crs:GeographicPlaneGeometer fnd:groundsInSpace fnd:metricSpaceWitness (a fnd:MetricSpace carrying fnd:hasPoint + fnd:hasDistanceAssertion) conforms; the space probe of record - crs:CoordinateDerivation fnd:groundsInSpace fnd:setBit2 (a fnd:Set with no space-structure edge) - makes the space branch bite, and deleting the sole real groundsInSpace edge makes q_reanchor_additive's existence line fail. Mirrors q_reanchor_additive." ;
    sh:targetSubjectsOf fnd:groundsInAlgebra ;
    sh:targetSubjectsOf fnd:groundsInSpace ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "additive re-anchor: this fnd:groundsInAlgebra edge targets a non-matching structure - the target carries no fnd:hasSignature, so it is not a genuine (Sigma,E) presented-algebra rung (a rebuild-in-disguise re-anchor)." ;
        sh:select """
            SELECT $this WHERE {
              $this <urn:silmaril:fnd:#groundsInAlgebra> ?alg .
              FILTER NOT EXISTS { ?alg <urn:silmaril:fnd:#hasSignature> ?sig }
            }
        """ ;
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "additive re-anchor (space): this fnd:groundsInSpace edge targets a non-space - the target carries no space-structure edge (fnd:hasPoint / fnd:hasDistanceAssertion / fnd:hasTessellationVertices / fnd:hasCarrierSet / fnd:hasOpenSet), so it is not a genuine space object (fnd:MetricSpace / fnd:Site / fnd:PerceptualTessellation / fnd:TopologicalSpace) - a re-anchor onto a non-matching structure." ;
        sh:select """
            SELECT $this WHERE {
              $this <urn:silmaril:fnd:#groundsInSpace> ?spx .
              FILTER NOT EXISTS {
                { ?spx <urn:silmaril:fnd:#hasPoint> ?pt } UNION
                { ?spx <urn:silmaril:fnd:#hasDistanceAssertion> ?da } UNION
                { ?spx <urn:silmaril:fnd:#hasTessellationVertices> ?tv } UNION
                { ?spx <urn:silmaril:fnd:#hasCarrierSet> ?csx } UNION
                { ?spx <urn:silmaril:fnd:#hasOpenSet> ?os }
              }
            }
        """ ;
    ] .


# =====================================================================================
# fnd:SealedGroupIsGroupShape (T10) — the SP2 aob:SealedGroup satisfies the full fnd:Group teeth (the ONE
# real build; design s7 / Directive 20 PIN; 05_reanchor_surface.md A1/D4). A sh:sparql node shape targeting
# aob:SealedGroup: it fires (RED) when the sealed group fails any of the four group properties over its
# foundation-side model - binary-op present, closure (no product escapes fnd:hasElement), two-sided-inverse-
# universal (every element carries a genuine two-sided inverse pairing), abelian-flag (a model flagged
# fnd:isAbelian true with a non-commuting pair) - plus the two-sided identity. Reuses the T4 op-table/pairing
# discipline (fnd:MonoidIdentityShape + fnd:GroupInverseShape also bite the same model/pairings). Edge-
# existence throughout, defang-proof. Floor: aob:witnessGroup's closed abelian Z/4 table + 4 pairings + 4
# hasElement + identity + isAbelian true -> conforms; probe (fnd:sgApp_a_c fnd:opResult -> aob:witnessExample,
# so a+c=b != e) breaks the inverse-universal clause -> RED. Mirrors q_sealedgroup_is_group.
# =====================================================================================

fnd:SealedGroupIsGroupShape a sh:NodeShape ;
    rdfs:label "SealedGroupIsGroupShape" ;
    rdfs:comment "The SealedGroup-is-a-Group tooth with teeth on aob:SealedGroup (reanchor.ttl, design s7 / Directive 20 PIN - the ONE real build; 05_reanchor_surface.md A1/D4). SP2's sealed group names itself a group OBJECT but materialises only partial axioms (05 s2.1); this shape makes the full group law a CHECKABLE graph fact over the T10 foundation-side model, so 'aob:SealedGroup IS a fnd:Group' is teeth-proved not asserted. A sh:sparql node shape (sh:targetClass aob:SealedGroup) whose constraint fires on a UNION of the group-failure branches over a sealed group $this: (identity) it carries no fnd:hasIdentityElement; (binary-op) it carries no fnd:opStructure row at all; (closure) some reified product over fnd:opStructure $this has a fnd:opResult that is not a fnd:hasElement of $this (a product escaping the carrier); (inverse-universal) some fnd:hasElement of $this carries no fnd:InversePairing (fnd:pairingModel $this, fnd:pairingElement it); (abelian-flag) $this fnd:isAbelian true yet some pair (x,y) over its table has x.y != y.x. Every clause reads EDGE existence over the reified op table, the pairings, the element enumeration and the flag, never a bare sh:class over an rdfs:range, so inference=rdfs cannot defang it - the SP1 defang discipline; and it complements the reused T4 teeth (fnd:MonoidIdentityShape on the identity, fnd:GroupInverseShape on each pairing's two-sided undo) that fire on the SAME model. On this floor aob:witnessGroup (the closed abelian Z/4 Cayley table over {witnessAnchor=e, witnessDescription=a, witnessExample=b, witnessReplacement=c}, four fnd:hasElement, four two-sided fnd:InversePairing honouring aob:retracts, fnd:hasIdentityElement witnessAnchor, fnd:isAbelian true) satisfies every branch, so conforms=True; the probe of record - changing fnd:sgApp_a_c fnd:opResult from aob:witnessAnchor to aob:witnessExample (a+c=b != e) - leaves the product in the carrier but makes the inverse pairing fnd:sgInvA/fnd:sgInvC fail its two-sided undo, so the inverse-universal branch (and fnd:GroupInverseShape) bite (conforms=True->False), proving the tooth. Mirrors q_sealedgroup_is_group." ;
    sh:targetClass aob:SealedGroup ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "sealed-group-is-group: this aob:SealedGroup fails a group property over its foundation model - missing identity, no binary operation, a product escaping the carrier (closure), an element with no two-sided inverse pairing, or a non-commutative pair while flagged abelian." ;
        sh:select """
            SELECT $this WHERE {
              {
                FILTER NOT EXISTS { $this <urn:silmaril:fnd:#hasIdentityElement> ?e }
              } UNION {
                FILTER NOT EXISTS { ?any <urn:silmaril:fnd:#opStructure> $this }
              } UNION {
                ?row <urn:silmaril:fnd:#opStructure> $this ; <urn:silmaril:fnd:#opResult> ?r .
                FILTER NOT EXISTS { $this <urn:silmaril:fnd:#hasElement> ?r }
              } UNION {
                $this <urn:silmaril:fnd:#hasElement> ?x .
                FILTER NOT EXISTS {
                  ?p a <urn:silmaril:fnd:#InversePairing> ; <urn:silmaril:fnd:#pairingModel> $this ; <urn:silmaril:fnd:#pairingElement> ?x .
                }
              } UNION {
                $this <urn:silmaril:fnd:#isAbelian> true .
                ?xy <urn:silmaril:fnd:#opStructure> $this ; <urn:silmaril:fnd:#opLeft> ?x ; <urn:silmaril:fnd:#opRight> ?y ; <urn:silmaril:fnd:#opResult> ?xyr .
                ?yx <urn:silmaril:fnd:#opStructure> $this ; <urn:silmaril:fnd:#opLeft> ?y ; <urn:silmaril:fnd:#opRight> ?x ; <urn:silmaril:fnd:#opResult> ?yxr .
                FILTER(?xyr != ?yxr)
              }
            }
        """ ;
    ] .


# =====================================================================================
# fnd:ReanchorLandingParityShape (T10 / H2 — the landing-type PARITY tooth for the two remaining re-anchor
# edges) — brings fnd:groundsInSet and fnd:functionalityOf to landing-type PARITY with fnd:groundsInAlgebra
# and fnd:groundsInSpace (fnd:ReanchorAdditiveShape). Those two siblings already guard BOTH edge existence
# AND the landing TYPE (an algebra grounding must land on a signature-carrying (Sigma,E) rung; a space
# grounding on a genuine space-structure object). fnd:groundsInSet and fnd:functionalityOf had EXISTENCE
# teeth (q_set_carrier requires the carrier to carry a groundsInSet edge; q_frame_is_functionality anchors
# the recognition) but NO landing-type guard - so a spurious edge onto a WRONG-TYPED target stayed GREEN.
# This shape closes that gap so all FOUR re-anchor edge types carry BOTH existence AND landing-type teeth,
# ALL FOUR now a POSITIVE landing-type test at genuine parity (no negative blacklist anywhere):
#   * a fnd:groundsInSet edge whose object is NOT rdf:type fnd:Set (directly or via rdfs inference) - i.e.
#     the landing is not a genuine set (a fnd:Presheaf, fnd:Product, fnd:Cardinality, fnd:Combinator, an
#     algebra rung, a space) -> RED; this MIRRORS how fnd:groundsInAlgebra requires a genuine (Sigma,E)
#     structure, fnd:groundsInSpace a genuine space object, and fnd:functionalityOf a genuine functionality;
#   * a fnd:functionalityOf edge onto a NON-Functionality - a target carrying NO fnd:recognizesFrameCarrier
#     edge, so it is not Curry's F recognized on the Frame -> RED.
# The set landing is a POSITIVE rdf:type fnd:Set requirement, replacing the earlier NEGATIVE wrong-structure
# blacklist (which fired only if the target carried one of seven competing markers - fnd:hasSignature /
# fnd:recognizesFrameCarrier / fnd:hasPoint / fnd:hasDistanceAssertion / fnd:hasTessellationVertices /
# fnd:hasOpenSet / fnd:hasCarrierSet - and so let a wrong-typed target carrying NONE of them, a
# fnd:Presheaf / Product / Cardinality / Combinator, stay GREEN: the parity hole). The positive test works
# because fnd:groundsInSet DELIBERATELY declares the permissive rdfs:range owl:Thing rather than the precise
# fnd:Set (set_theory.ttl): a range fnd:Set would force inference=rdfs to materialise rdf:type fnd:Set onto
# EVERY target (satisfying the check on wrong-typed targets too) and defang the positive test,
# exactly the range-forging the sibling algebra/space guards dodge by reading a structural EDGE. Instead
# every genuine grounding target is typed rdf:type fnd:Set HONESTLY AND EXPLICITLY at its own declaration
# (the finite carriers fnd:setOctet256/RGB3/Bit2, the SP2 fnd:setOctet32Power/setByteOrderCoproduct, the
# SP3 fnd:setCarrierProduct, every algebra-rung underlying set fnd:setMagma..fnd:setVectorSpace, and the
# free-algebra underlying set fnd:witnessUnderlyingSet - a countably infinite set is STILL a fnd:Set), so
# the real floor is GREEN while any wrong-typed landing is RED. The sole fnd:functionalityOf target
# fnd:curryFunctionality carries fnd:recognizesFrameCarrier prim:Frame, so the functionality branch is
# GREEN. PROBES OF RECORD (each flips True->False): probeSubj fnd:groundsInSet fnd:witnessPresheaf (a
# fnd:Presheaf, not a Set) -> RED; the same onto fnd:witnessProduct / fnd:card256 (a fnd:Cardinality) /
# fnd:B (a fnd:Combinator) / fnd:Monoid -> RED; prim:Frame fnd:functionalityOf fnd:Monoid (typing by an
# algebra with no frame recognition) -> RED.
# =====================================================================================
fnd:ReanchorLandingParityShape a sh:NodeShape ;
    rdfs:label "ReanchorLandingParityShape" ;
    rdfs:comment "The landing-type PARITY tooth for the two remaining re-anchor edges, with teeth on the subjects of fnd:groundsInSet and fnd:functionalityOf (reanchor.ttl, design s7 / H2). It brings those two edges to PARITY with fnd:groundsInAlgebra and fnd:groundsInSpace (fnd:ReanchorAdditiveShape), which already guard both edge existence AND the landing TYPE; fnd:groundsInSet and fnd:functionalityOf previously had only existence teeth (q_set_carrier / q_frame_is_functionality), so a spurious re-anchor edge onto a WRONG-TYPED target stayed GREEN. A sh:sparql node shape (sh:targetSubjectsOf fnd:groundsInSet, sh:targetSubjectsOf fnd:functionalityOf) with two constraints: (set) a fnd:groundsInSet edge whose object is NOT rdf:type fnd:Set (directly or via rdfs inference) is landing on a wrong-typed structure that is not a genuine set - a fnd:Presheaf, fnd:Product, fnd:Cardinality, fnd:Combinator, an algebra rung, a space - so it is RED, a POSITIVE landing-type test at genuine parity with fnd:groundsInAlgebra's fnd:hasSignature requirement, fnd:groundsInSpace's space-structure requirement and fnd:functionalityOf's frame-recognition requirement (no negative blacklist anywhere); (functionality) a fnd:functionalityOf edge whose object carries NO fnd:recognizesFrameCarrier edge is not Curry's F recognized on the committed Frame, a wrong-typed non-functionality, so it is RED. The functionality clause reads only EDGE existence over the recognition predicate fnd:recognizesFrameCarrier, and the set clause reads the target's EXPLICIT rdf:type fnd:Set: the positive set test is NOT defanged because fnd:groundsInSet DELIBERATELY declares the permissive rdfs:range owl:Thing rather than the precise fnd:Set (set_theory.ttl) - a range fnd:Set would force inference=rdfs to materialise rdf:type fnd:Set onto EVERY groundsInSet target (including a wrong-typed one) and defang the check, the same range-forging the sibling algebra/space guards dodge by reading a structural EDGE (fnd:functionalityOf's rdfs:range fnd:Functionality is likewise never read as a type - the functionality clause reads the recognition edge). This REPLACES the earlier NEGATIVE wrong-structure blacklist, whose parity hole was that it fired only if the target carried one of seven competing markers, so a wrong-typed target carrying none of them - a fnd:Presheaf (fnd:presheafElementSet only), a fnd:Product (fnd:hasProjection/hasFactoriser), a fnd:Cardinality (fnd:cardinalityCount), a fnd:Combinator - stayed GREEN. The positive test does not false-reject any honest set because every genuine grounding target is typed rdf:type fnd:Set explicitly at its own declaration - the finite carriers fnd:setOctet256/RGB3/Bit2, the SP2 fnd:setOctet32Power/setByteOrderCoproduct, the SP3 fnd:setCarrierProduct, every algebra-rung underlying set fnd:setMagma..fnd:setVectorSpace, and the free-algebra underlying set fnd:witnessUnderlyingSet (a countably infinite set is STILL a fnd:Set, so it is typed fnd:Set with no positive-marker dodge, Praeriehund: name the thing as what it is) - so every real fnd:groundsInSet edge stays GREEN while any wrong-typed landing is RED. On this floor all real fnd:groundsInSet targets are typed fnd:Set and the sole fnd:functionalityOf target fnd:curryFunctionality carries fnd:recognizesFrameCarrier prim:Frame, so conforms=True; the probes of record - probeSubj fnd:groundsInSet fnd:witnessPresheaf (a fnd:Presheaf, not a Set), the same onto fnd:witnessProduct / fnd:card256 (a fnd:Cardinality) / fnd:B (a fnd:Combinator) / fnd:Monoid, and prim:Frame fnd:functionalityOf fnd:Monoid (an algebra with no frame recognition) - each make the shape bite (conforms=True->False), proving both landings. With this shape all FOUR re-anchor edge types (fnd:groundsInSet / fnd:groundsInAlgebra / fnd:groundsInSpace / fnd:functionalityOf) carry BOTH existence and landing-type teeth." ;
    sh:targetSubjectsOf fnd:groundsInSet ;
    sh:targetSubjectsOf fnd:functionalityOf ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "re-anchor landing (set): this fnd:groundsInSet edge targets a NON-Set - the object is NOT rdf:type fnd:Set (a genuine grounding target IS a set, typed explicitly; a Presheaf / Product / Cardinality / Combinator / algebra rung / space is not), so it is a wrong-typed structure, not a genuine fnd:Set (a spurious re-anchor onto a non-matching landing)." ;
        sh:select """
            SELECT $this WHERE {
              $this <urn:silmaril:fnd:#groundsInSet> ?s .
              FILTER NOT EXISTS { ?s <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <urn:silmaril:fnd:#Set> }
            }
        """ ;
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "re-anchor landing (functionality): this fnd:functionalityOf edge targets a NON-Functionality - the object carries no fnd:recognizesFrameCarrier edge, so it is not Curry's F recognized on the committed Frame (a callable typed by a wrong-typed non-functionality)." ;
        sh:select """
            SELECT $this WHERE {
              $this <urn:silmaril:fnd:#functionalityOf> ?f .
              FILTER NOT EXISTS { ?f <urn:silmaril:fnd:#recognizesFrameCarrier> ?c }
            }
        """ ;
    ] .

# =====================================================================================
# fnd:AuthorityTagShape (T11, THE HONESTY-LEDGER INTEGRATION TOOTH) — every fnd class-like /
# property atom carries EXACTLY ONE authority tag drawn from the enumerated DS/PD/SYN trichotomy
# (design s0, the Praeriehund honesty ledger, LOAD-BEARING; Directive 20 HONESTY pin). This is the
# tooth that makes "no SYN atom masquerades as a Helios lift" a GRAPH FACT rather than a claim in
# prose, and it is what the depth gate's "every SYN atom tagged" requirement bites on. Mirrors the
# EXPECT-TRUE ASK q_honesty_ledger.
# =====================================================================================
fnd:AuthorityTagShape a sh:NodeShape ;
    rdfs:label "AuthorityTagShape" ;
    rdfs:comment "The honesty-ledger integration tooth with teeth on every fnd-namespace owl:Class, owl:ObjectProperty and owl:DatatypeProperty (design s0 / Directive 20 HONESTY pin, LOAD-BEARING) - it makes the Praeriehund honesty ledger a machine-checked graph fact: every load-bearing foundation atom carries EXACTLY ONE authority classification drawn from the enumerated trichotomy fnd:DS (verbatim Helios lift) | fnd:PD (proof-derived from Helios) | fnd:SYN (synthesized as cited standard-mathematical fact, the Directive-19 Curry precedent), so no SYN atom can masquerade as a Helios lift (a DS/PD claim with no Helios basis) and no atom is left silently unclassified. A sh:sparql node shape with three sh:targetClass declarations (owl:Class, owl:ObjectProperty, owl:DatatypeProperty) whose single constraint - SCOPED to the fnd namespace by a STRSTARTS filter so the SP1 prim: / SP2 aob: / SP3 crs: class-like nodes in the merged graph are focus nodes but never produce a violation - fires on a UNION of two honesty-breach branches over a foundation atom $this: (a) $this carries NO fnd:authority whose value is one of fnd:DS / fnd:PD / fnd:SYN (unclassified, or classified only by an out-of-enum value); (b) $this carries TWO DISTINCT fnd:authority values (an ambiguous ledger entry - the exact shape a SYN-masquerading-as-DS double-tag would take). Both clauses read only EDGE existence over fnd:authority and the enumerated tag individuals, never a bare sh:class over an rdfs:range, so inference=rdfs (which materialises an rdf:type via the owl:Thing domain of fnd:authority but cannot forge an fnd:authority edge onto a specific enumerated tag) cannot defang it - the SP1 defang discipline. On the committed floor all 77 fnd owl:Class + 122 fnd owl:ObjectProperty + 22 fnd owl:DatatypeProperty atoms carry exactly one valid tag (17/1/59 DS/PD/SYN at owl:Class level; 52/11/453 DS/PD/SYN across all 516 fnd subjects, after the H1 honesty sweep retagged the agnostic progenitor / universal-object / worked-example-witness atoms from DS/PD to their honest SYN and cited every remaining DS/PD atom to a helios/srcy file:line - see fnd:AuthorityHonestyShape), so conforms=True; the probe of record - injecting fnd:probeUntaggedClass a owl:Class with NO fnd:authority - makes branch (a) fire and the shape bite (conforms=True->False), and a second probe - fnd:probeDoubleTag fnd:authority fnd:SYN, fnd:DS - makes branch (b) fire, together proving the tooth on the two cases that matter (silent-unclassified and masquerade-by-double-tag). Mirrors q_honesty_ledger." ;
    sh:targetClass owl:Class , owl:ObjectProperty , owl:DatatypeProperty ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "honesty-ledger: this fnd atom is not honestly classified - it carries no single authority tag from the DS/PD/SYN trichotomy, or it carries two distinct tags (a SYN atom must never masquerade as a Helios lift; every foundation atom must be tagged exactly once)." ;
        sh:select """
            SELECT $this WHERE {
              FILTER(STRSTARTS(STR($this), "urn:silmaril:fnd:#"))
              {
                FILTER NOT EXISTS {
                  $this <urn:silmaril:fnd:#authority> ?t .
                  FILTER(?t IN (<urn:silmaril:fnd:#DS>, <urn:silmaril:fnd:#PD>, <urn:silmaril:fnd:#SYN>))
                }
              } UNION {
                $this <urn:silmaril:fnd:#authority> ?a , ?b .
                FILTER(?a != ?b)
              }
            }
        """ ;
    ] .


# =====================================================================================
# fnd:AuthorityHonestyShape (T11, THE SELF-ENFORCING DS/PD-CITATION TOOTH; H1 close) — the honesty
# ledger's OWN bar (design s0: "an atom tagged DS/PD without an exact resolvable helios/srcy file:line in
# its comment is a defect") made a GRAPH FACT. fnd:AuthorityTagShape proves every fnd atom is tagged EXACTLY
# ONCE; this shape proves the STRONGER honesty invariant that a DS or PD tag is never a bare claim - a
# verbatim-Helios (DS) or proof-derived-from-Helios (PD) atom MUST carry the exact Helios file:line in
# its rdfs:comment, so no SYN-grade synthesis can masquerade as a lift by simply wearing a DS/PD tag with
# no source locus. A sh:sparql node shape on the SUBJECTS of fnd:authority (every tagged atom is a focus
# node) carrying THREE constraints, each SELF-GUARDED to the DS/PD atoms (FILTER ?t IN (fnd:DS, fnd:PD)).
# Constraint 1 (EXACT-LINE PRESENCE) fires when such an atom has NO rdfs:comment matching a REGEX for an
# EXACT-LINE helios/srcy citation "helios/srcy/...*.tex:[0-9]" (a helios/srcy .tex IMMEDIATELY followed by
# a :START(-END)? line) - so no citation at all, OR a citation stripped of its :line (a bare file), is RED.
# This STRENGTHENS the earlier CONTAINS("helios/srcy/") form, which a bare-file citation (no :line) passed -
# the hole a hostile review named; design s0's bar is an exact resolvable file:LINE, not a mere substring.
# Constraint 2 (NO-BARE-FILE) fires on ANY bare-file helios/srcy .tex NOT followed by :[0-9] (REGEX negative
# lookahead), so EVERY helios citation on a DS/PD atom must pin its line(s) - the in-graph proxy of the
# runner-level per-citation gate. Both read only TEXT over rdfs:comment (REGEX), never a range-inferred
# type, so inference=rdfs cannot forge a citation and defang it - the SP1 defang discipline; and a SYN atom
# (the great majority of the floor) is never a focus-node violation because its tag is not in {DS,PD}.
# Floor: after the citation sweep every DS/PD atom (the minting engine, structural Set/Presheaf/Omega,
# Monoid + the endomorphism seam vocabulary incl. fnd:soleObject:36-39, Site/Sheaf/PerceptualTessellation
# vocabulary incl. fnd:overCover/fnd:familyOverB:30-52 / fnd:LocalSection:1-9 / fnd:MatchingFamily:1-5, the
# honesty machinery cited to appendix 37:240) carries an exact-line helios/srcy citation on EVERY reference
# -> conforms=True. PROBES OF RECORD (each flips True->False): (a) retag fnd:AlgebraicStructure back to
# fnd:DS (its comment cites only Directive 17 + the ledger, no helios/srcy) -> constraint 1 RED; (b) inject
# a fresh DS atom with no helios/srcy citation -> constraint 1 RED; (c) strip the :line off a real DS atom's
# sole citation (fnd:soleObject:36-39 -> bare) -> constraint 1 (no lined citation) AND constraint 2 (bare
# file present) RED. A THIRD sh:sparql constraint closes the
# EXACT-RESOLVABLE half of the bar: a DS/PD comment carrying an ELLIPSIS (/... or _...) or a duplicated
# .tex...tex segment is an in-graph proxy for a non-resolving path -> RED (probes fnd:probeElidedDS /
# fnd:probeDupDS bite it; the swept real floor stays green). The on-disk test -f resolution of every cited
# helios/srcy .tex is enforced at the runner level (checks/run-foundation-checks.sh). Mirrors q_authority_honest.
# =====================================================================================
fnd:AuthorityHonestyShape a sh:NodeShape ;
    rdfs:label "AuthorityHonestyShape" ;
    rdfs:comment "The self-enforcing DS/PD-citation tooth with teeth on every subject of fnd:authority (design s0, the Praeriehund honesty ledger's OWN bar, LOAD-BEARING; Directive 20 HONESTY pin). It makes the ledger's discipline that 'a DS/PD tag without an exact resolvable helios/srcy file:line is a defect' a machine-checked graph fact: a verbatim-Helios (fnd:DS) or proof-derived-from-Helios (fnd:PD) atom is only honest if its rdfs:comment carries the source locus it claims to be lifted from, so a synthesized atom can never masquerade as a Helios lift merely by wearing a DS/PD tag. A sh:sparql node shape (sh:targetSubjectsOf fnd:authority) carrying THREE constraints, each self-guarded to the DS/PD tags (FILTER ?t IN (fnd:DS, fnd:PD) - a SYN atom is a focus node but never a violation, since its provenance is cited standard math or a maintainer directive, not a Helios file:line). Constraint 1 (EXACT-LINE PRESENCE) fires when the atom has NO rdfs:comment carrying an EXACT-LINE helios/srcy citation - a REGEX for 'helios/srcy/...*.tex:[0-9]', i.e. a helios/srcy/.../*.tex path IMMEDIATELY followed by a ':START(-END)?' line suffix; so an atom with no helios/srcy citation at all, OR one whose sole citation was stripped of its :line (leaving a bare file), is RED. This STRENGTHENS the prior CONTAINS('helios/srcy/') form, which passed a bare-file citation with no line - the hole a hostile review named; design section-0's bar is 'an atom tagged DS/PD without an EXACT resolvable helios/srcy file:LINE is a defect', not merely a helios/srcy substring. Constraint 2 (NO-BARE-FILE) fires when the comment carries ANY bare-file helios/srcy/.../*.tex NOT followed by ':[0-9]' (a REGEX negative-lookahead '(?!:[0-9])'), so that EVERY helios/srcy citation on a DS/PD atom - not just one - must pin its line(s); this is the in-graph proxy of the runner-level 'every helios citation is lined' gate (bash, which alone can iterate each citation and read the disk). Both read only TEXT over rdfs:comment (REGEX over STR), never a bare sh:class over an rdfs:range, so inference=rdfs cannot forge a citation and defang it - the SP1 defang discipline; the shape is complementary to fnd:AuthorityTagShape (which proves exactly-one-tag) by proving the STRONGER honesty invariant on the DS/PD subset. On the swept floor every DS/PD atom carries an exact-line helios/srcy citation on EVERY helios reference (the minting engine + structural Set + the Monoid/endomorphism seam vocabulary - incl. fnd:soleObject now :36-39 - + Site/Sheaf/PerceptualTessellation vocabulary - incl. fnd:overCover/fnd:familyOverB now :30-52, fnd:LocalSection :1-9, fnd:MatchingFamily :1-5 - cited to their authored papers, and the DS/PD/SYN honesty machinery itself cited to helios/srcy/appendices/37_appendix_c_node_arrow_foundation/sections/00_content.tex - the three-way DirectSource/ProvedDerivation/DeclaredSynthesis trichotomy the AuthorityTag/PD/authority atoms carry at :1704 and its separation subsubsection at :1956, the coarser binary direct-source-vs-declared-synthesis pole the DS/SYN tags name at :240), so conforms=True; the probes of record - (a) retagging fnd:AlgebraicStructure back to fnd:DS (whose comment cites only Directive 17 + the ledger byte_order worked example, no helios/srcy - the exact SYN-masquerading-as-DS dodge the ledger forbids) fires constraint 1, (b) a fresh fnd:probeUncitedDS a owl:Class ; fnd:authority fnd:DS with a comment carrying no helios/srcy fires constraint 1, and (c) STRIPPING the :line off any real DS atom's sole helios citation (e.g. fnd:soleObject :36-39 -> bare) fires constraint 1 (no lined citation left) AND constraint 2 (a bare-file citation now present) - each makes the shape bite (conforms=True->False). A THIRD sh:sparql constraint on this shape closes design section-0's EXACT-RESOLVABLE bar: a DS/PD atom whose rdfs:comment carries an ELIDED citation - an ellipsis segment (/... or _...) standing in for the elided chapter/section directories, or a whitespace-free duplicated .tex...tex filename segment (matched by CONTAINS '/...' / '_...' and a REGEX for two .tex tokens with no space between) - is an in-graph PROXY for a NON-EXACT, non-resolving helios/srcy path and is RED (probe fnd:probeElidedDS, whose citation carries a .../foo.tex ellipsis, and probe fnd:probeDupDS, whose citation carries a .tex_...tex duplication, each make it bite True->False; the real floor, whose every DS/PD citation was swept to its exact resolvable path, stays green). The filesystem resolution itself - test -f each cited helios/srcy .tex - is enforced at the runner level (checks/run-foundation-checks.sh), where bash can read the disk that SPARQL cannot; the two together are the honest closure of the exact-resolvable-teeth-checked bar. Mirrors q_authority_honest." ;
    sh:targetSubjectsOf fnd:authority ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "authority honesty: this atom is tagged fnd:DS or fnd:PD (a Helios lift) but its rdfs:comment carries no EXACT-LINE 'helios/srcy/.../*.tex:START(-END)?' citation - a direct-source/proof-derived claim with no authored Helios source LINE (a bare-file citation, or none at all - a SYN-grade synthesis masquerading as a lift); add the exact helios/srcy/.../*.tex file:line or retag fnd:SYN with the honest provenance." ;
        sh:select """
            SELECT $this WHERE {
              $this <urn:silmaril:fnd:#authority> ?t .
              FILTER(?t IN (<urn:silmaril:fnd:#DS>, <urn:silmaril:fnd:#PD>))
              FILTER NOT EXISTS {
                $this <http://www.w3.org/2000/01/rdf-schema#comment> ?c .
                FILTER(REGEX(STR(?c), "helios/srcy/[^ ,;)]*\\\\.tex:[0-9]"))
              }
            }
        """ ;
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "authority honesty (bare-file, no :line): this atom is tagged fnd:DS or fnd:PD (a Helios lift) but its rdfs:comment carries a BARE-FILE helios/srcy/.../*.tex citation with NO ':START(-END)?' line suffix - the exact-line bar of design section-0 ('an atom tagged DS/PD without an exact resolvable helios/srcy file:line is a defect') requires EVERY helios/srcy citation on a DS/PD atom to pin its line(s); append the true line range (grep the quote) or retag fnd:SYN." ;
        sh:select """
            SELECT $this WHERE {
              $this <urn:silmaril:fnd:#authority> ?t .
              FILTER(?t IN (<urn:silmaril:fnd:#DS>, <urn:silmaril:fnd:#PD>))
              $this <http://www.w3.org/2000/01/rdf-schema#comment> ?cb .
              FILTER(REGEX(STR(?cb), "helios/srcy/[^ ,;)]*\\\\.tex(?!:[0-9])"))
            }
        """ ;
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "authority honesty (exact-resolvable): this atom is tagged fnd:DS or fnd:PD (a Helios lift) but its rdfs:comment carries an ELIDED citation - an ellipsis segment (/... or _...) standing in for the chapter/section directories, or a duplicated .tex...tex filename segment - so the cited helios/srcy path is NON-EXACT and does not resolve on disk (design section-0's exact-resolvable bar); expand it to the full resolvable helios/srcy/<paper>/<chapters>/<sections>/<file>.tex file:line." ;
        sh:select """
            SELECT $this WHERE {
              $this <urn:silmaril:fnd:#authority> ?t .
              FILTER(?t IN (<urn:silmaril:fnd:#DS>, <urn:silmaril:fnd:#PD>))
              $this <http://www.w3.org/2000/01/rdf-schema#comment> ?c2 .
              FILTER( CONTAINS(STR(?c2), "/...") || CONTAINS(STR(?c2), "_...") || REGEX(STR(?c2), "\\\\.tex[^ ,;)]*\\\\.tex") )
            }
        """ ;
    ] .


# =====================================================================================
# fnd:RingAddAssocShape (T5 / Fix-A1) — additive ASSOCIATIVITY over every fnd:Semiring's + operation
# ((a+b)+c = a+(b+c)) (design s3; the two-operation line is SYN, ring absent as algebra in Helios,
# 02_algebra_tower.md:134-136). The Semiring->Ring->Field line reifies its two Cayley tables through
# fnd:ringStructure/fnd:ringOp/fnd:ringLeft/fnd:ringRight/fnd:ringResult (a DISTINCT vocabulary from the
# spine fnd:opStructure the T4 fnd:SemigroupAssocShape walks), so the T4 associativity tooth NEVER
# reaches the ring's additive operation - a fnd:Ring/fnd:Semiring with a non-associative addition passed
# GREEN. This tooth closes that hole on the ADDITIVE side, class-general over the class where the
# additive-monoid substrate lives (fnd:Semiring, reaching fnd:Ring and fnd:Field by rdfs:subClassOf),
# mirroring fnd:RingDistribShape's anchoring discipline. A sh:sparql node shape targeting
# fnd:RingOperationApplication, $this ANCHORED as the a+b additive row so the four-row self-join stays
# bounded. Edge-existence over the reified applications, never a range-inferred rdf:type, so
# inference=rdfs cannot forge a row and defang it (the SP1 defang discipline). Floor: the full GF(3)
# additive tables of fnd:ringModel (and the sparser fnd:fieldModel, no closing violating chain) make
# every additive triple associate -> conforms; PROBE OF RECORD - change fnd:appRingAdd_2_2
# fnd:ringResult from fnd:ringOne to fnd:ringZero (2+2=0), so for the triple (2,2,1): (2+2)+1 = 0+1 = 1
# while 2+(2+1) = 2+0 = 2 - the two bracketings disagree and the shape bites (conforms True->False).
# =====================================================================================

fnd:RingAddAssocShape a sh:NodeShape ;
    rdfs:label "RingAddAssocShape" ;
    rdfs:comment "The two-operation ADDITIVE-ASSOCIATIVITY tooth with teeth on the reified additive Cayley table of every fnd:Semiring model (algebra_rings.ttl, design s3; Fix-A1). The Semiring->Ring->Field additive operation (+) must be ASSOCIATIVE - (a+b)+c = a+(b+c) - because a ring's additive part is an abelian GROUP and a semiring's is a commutative MONOID, both of which demand associativity; but the ring reifies its operations via fnd:ringStructure/fnd:ringOp/fnd:ringLeft/fnd:ringRight/fnd:ringResult, a DISTINCT vocabulary from the one-operation spine's fnd:opStructure that the T4 fnd:SemigroupAssocShape walks, so the spine associativity tooth NEVER reached the ring additive operation - a fnd:Ring or fnd:Semiring with a non-associative reified additive table passed GREEN (the exact Fix-A1 hole). The whole two-operation line is SYN, ring FULLY ABSENT as algebra in Helios (02_algebra_tower.md:134-136), authored as cited standard ring theory. CLASS-GENERAL (no witness IRI hardcoded): a sh:sparql node shape targeting fnd:RingOperationApplication whose constraint QUANTIFIES OVER EVERY fnd:Semiring instance ?mdl (bound ?mdl rdf:type fnd:Semiring, so under inference=rdfs it matches the ring witness fnd:ringModel and the field witness fnd:fieldModel - both fnd:Semiring since fnd:Ring rdfs:subClassOf fnd:Semiring and fnd:Field rdfs:subClassOf fnd:Ring - AND any bare fnd:Semiring), mirroring fnd:RingDistribShape rather than pinning a witness. To keep the four-way self-join bounded, $this is ANCHORED as the additive a+b row itself (fnd:ringOp fnd:additiveOp, ringLeft=a, ringRight=b, ringResult=ab), then ?mdl is bound from that row and rdf:type-guarded fnd:Semiring; the constraint forms (a+b)+c via an fnd:additiveOp row (ringLeft=ab, ringRight=c, result=lhs), b+c via an fnd:additiveOp row (ringLeft=b, ringRight=c, result=bc), a+(b+c) via an fnd:additiveOp row (ringLeft=a, ringRight=bc, result=rhs), and FILTER(?lhs != ?rhs). Every clause reads EDGE existence over the reified applications plus the ?mdl rdf:type guard, never a bare sh:class over an rdfs:range, so inference=rdfs cannot forge a two-operation row and defang it (the SP1 defang discipline). On this floor the full GF(3) additive Cayley table of fnd:ringModel makes every additive triple associate (and fnd:fieldModel's sparser additive table has no closing violating chain), so conforms=True; the PROBE OF RECORD - changing fnd:appRingAdd_2_2 (2+2) fnd:ringResult from fnd:ringOne to fnd:ringZero, so for the triple (a,b,c)=(2,2,1): (a+b)+c = (2+2)+1 = 0+1 = 1 (via fnd:appRingAdd_0_1) while a+(b+c) = 2+(2+1) = 2+0 = 2 (via fnd:appRingAdd_2_0) - makes the constraint bite (conforms True->False), a fnd:Ring with non-associative addition, proving the tooth CLASS-GENERAL over the class where the additive-monoid substrate lives. Mirrors q_ring_add_assoc." ;
    sh:targetClass fnd:RingOperationApplication ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "semiring rung (additive associativity): the additive operation of some fnd:Semiring instance (?mdl a fnd:Semiring, including fnd:Ring and fnd:Field by rdfs:subClassOf) is NOT associative - there is a triple (a,b,c) whose two bracketings (a+b)+c and a+(b+c) evaluate to different fnd:ringResult." ;
        sh:select """
            SELECT $this WHERE {
              $this <urn:silmaril:fnd:#ringStructure> ?mdl ; <urn:silmaril:fnd:#ringOp> <urn:silmaril:fnd:#additiveOp> ; <urn:silmaril:fnd:#ringLeft> ?a ; <urn:silmaril:fnd:#ringRight> ?b ; <urn:silmaril:fnd:#ringResult> ?ab .
              ?mdl <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <urn:silmaril:fnd:#Semiring> .
              ?abc <urn:silmaril:fnd:#ringStructure> ?mdl ; <urn:silmaril:fnd:#ringOp> <urn:silmaril:fnd:#additiveOp> ; <urn:silmaril:fnd:#ringLeft> ?ab ; <urn:silmaril:fnd:#ringRight> ?c ; <urn:silmaril:fnd:#ringResult> ?lhs .
              ?rbc <urn:silmaril:fnd:#ringStructure> ?mdl ; <urn:silmaril:fnd:#ringOp> <urn:silmaril:fnd:#additiveOp> ; <urn:silmaril:fnd:#ringLeft> ?b ; <urn:silmaril:fnd:#ringRight> ?c ; <urn:silmaril:fnd:#ringResult> ?bc .
              ?rabc <urn:silmaril:fnd:#ringStructure> ?mdl ; <urn:silmaril:fnd:#ringOp> <urn:silmaril:fnd:#additiveOp> ; <urn:silmaril:fnd:#ringLeft> ?a ; <urn:silmaril:fnd:#ringRight> ?bc ; <urn:silmaril:fnd:#ringResult> ?rhs .
              FILTER(?lhs != ?rhs)
            }
        """ ;
    ] .


# =====================================================================================
# fnd:RingAddCommShape (T5 / Fix-A1) — additive COMMUTATIVITY over every fnd:Semiring's + operation
# (a+b = b+a) (design s3; SYN, ring absent as algebra in Helios). The ring reifies via fnd:ringStructure,
# a DISTINCT vocabulary from the spine fnd:opStructure the T4 fnd:CommMonoidCommShape / fnd:AbelianCommShape
# walk, so no spine commutativity tooth reaches the ring additive operation - a fnd:Semiring/fnd:Ring with
# a non-commutative addition passed GREEN. A ring's / semiring's additive part is a COMMUTATIVE monoid /
# abelian group, so + MUST commute; this tooth closes it class-general over fnd:Semiring. A sh:sparql node
# shape targeting fnd:RingOperationApplication, $this anchored as the a+b additive row, binding ?mdl a
# fnd:Semiring and requiring the reversed row b+a to agree. Edge-existence, defang-proof. Floor: the full
# GF(3) additive table of fnd:ringModel is commutative -> conforms; PROBE OF RECORD - change
# fnd:appRingAdd_0_2 (0+2) fnd:ringResult from fnd:ringTwo to fnd:ringZero, so 0+2 = 0 while 2+0 = 2
# (fnd:appRingAdd_2_0) - the pair (0,2) is non-commutative and the shape bites.
# =====================================================================================

fnd:RingAddCommShape a sh:NodeShape ;
    rdfs:label "RingAddCommShape" ;
    rdfs:comment "The two-operation ADDITIVE-COMMUTATIVITY tooth with teeth on the reified additive Cayley table of every fnd:Semiring model (algebra_rings.ttl, design s3; Fix-A1). The Semiring->Ring->Field additive operation (+) must COMMUTE - a+b = b+a - because a semiring's additive part is a COMMUTATIVE monoid and a ring's is an ABELIAN group; but the ring reifies its operations via fnd:ringStructure/fnd:ringOp/fnd:ringLeft/fnd:ringRight/fnd:ringResult, a DISTINCT vocabulary from the one-operation spine's fnd:opStructure that the T4 fnd:CommMonoidCommShape and fnd:AbelianCommShape walk, so no spine commutativity tooth reached the ring additive operation - a fnd:Semiring or fnd:Ring with a non-commutative reified additive table passed GREEN (the Fix-A1 hole on the commutativity side). The two-operation line is SYN, ring FULLY ABSENT as algebra in Helios (02_algebra_tower.md:134-136), authored as cited standard ring theory. CLASS-GENERAL: a sh:sparql node shape targeting fnd:RingOperationApplication whose constraint QUANTIFIES OVER EVERY fnd:Semiring instance ?mdl (bound ?mdl rdf:type fnd:Semiring, matching fnd:ringModel and fnd:fieldModel by rdfs:subClassOf under inference=rdfs, plus any bare fnd:Semiring), mirroring fnd:RingDistribShape rather than pinning a witness. $this is ANCHORED as the additive a+b row (fnd:ringOp fnd:additiveOp, ringLeft=a, ringRight=b, ringResult=ab); the constraint forms the reversed b+a row (fnd:additiveOp, ringLeft=b, ringRight=a, ringResult=ba) and FILTER(?ab != ?ba). It reads EDGE existence over the reified applications plus the ?mdl rdf:type guard, never a bare sh:class over an rdfs:range, so inference=rdfs cannot forge a two-operation row and defang it (the SP1 defang discipline). On this floor the full GF(3) additive Cayley table of fnd:ringModel is commutative (every a+b equals b+a; fnd:fieldModel's 1+2 and 2+1 both reach 0) so conforms=True; the PROBE OF RECORD - changing fnd:appRingAdd_0_2 (0+2) fnd:ringResult from fnd:ringTwo to fnd:ringZero, so 0+2 = 0 while 2+0 = 2 (via fnd:appRingAdd_2_0) - makes the pair (0,2) non-commutative and the constraint bite (conforms True->False), a fnd:Semiring with non-commutative addition, proving the tooth CLASS-GENERAL. Mirrors q_ring_add_comm." ;
    sh:targetClass fnd:RingOperationApplication ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "semiring rung (additive commutativity): the additive operation of some fnd:Semiring instance (?mdl a fnd:Semiring, including fnd:Ring and fnd:Field by rdfs:subClassOf) is NOT commutative - there is a pair (a,b) whose sums a+b and b+a evaluate to different fnd:ringResult." ;
        sh:select """
            SELECT $this WHERE {
              $this <urn:silmaril:fnd:#ringStructure> ?mdl ; <urn:silmaril:fnd:#ringOp> <urn:silmaril:fnd:#additiveOp> ; <urn:silmaril:fnd:#ringLeft> ?a ; <urn:silmaril:fnd:#ringRight> ?b ; <urn:silmaril:fnd:#ringResult> ?ab .
              ?mdl <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <urn:silmaril:fnd:#Semiring> .
              ?rba <urn:silmaril:fnd:#ringStructure> ?mdl ; <urn:silmaril:fnd:#ringOp> <urn:silmaril:fnd:#additiveOp> ; <urn:silmaril:fnd:#ringLeft> ?b ; <urn:silmaril:fnd:#ringRight> ?a ; <urn:silmaril:fnd:#ringResult> ?ba .
              FILTER(?ab != ?ba)
            }
        """ ;
    ] .


# =====================================================================================
# fnd:RingMultAssocShape (T5 / Fix-A1) — multiplicative ASSOCIATIVITY over every fnd:Semiring's * operation
# ((a*b)*c = a*(b*c)) (design s3; SYN, ring absent as algebra in Helios). A ring's/semiring's multiplicative
# part is a MONOID (semigroup for a rng), so * MUST be associative; but the ring reifies via fnd:ringStructure,
# distinct from the spine fnd:opStructure, so no spine associativity tooth reached the ring multiplicative
# operation - a fnd:Semiring/fnd:Ring with a non-associative multiplication passed GREEN. This tooth closes it
# class-general over fnd:Semiring, mirroring fnd:RingAddAssocShape but over the fnd:multiplicativeOp rows.
# Edge-existence, defang-proof. Floor: the full GF(3) multiplicative table of fnd:ringModel is associative ->
# conforms; PROBE OF RECORD - change fnd:appRingMul_2_1 (2*1) fnd:ringResult from fnd:ringTwo to fnd:ringZero,
# so for the triple (a,b,c)=(2,1,2): (a*b)*c = (2*1)*2 = 0*2 = 0 while a*(b*c) = 2*(1*2) = 2*2 = 1 - the two
# bracketings disagree and the shape bites.
# =====================================================================================

fnd:RingMultAssocShape a sh:NodeShape ;
    rdfs:label "RingMultAssocShape" ;
    rdfs:comment "The two-operation MULTIPLICATIVE-ASSOCIATIVITY tooth with teeth on the reified multiplicative Cayley table of every fnd:Semiring model (algebra_rings.ttl, design s3; Fix-A1). The Semiring->Ring->Field multiplicative operation (*) must be ASSOCIATIVE - (a*b)*c = a*(b*c) - because a ring's/semiring's multiplicative part is a MONOID (at minimum a semigroup); but the ring reifies its operations via fnd:ringStructure/fnd:ringOp/fnd:ringLeft/fnd:ringRight/fnd:ringResult, a DISTINCT vocabulary from the one-operation spine's fnd:opStructure that the T4 fnd:SemigroupAssocShape walks, so the spine associativity tooth NEVER reached the ring multiplicative operation - a fnd:Ring or fnd:Semiring with a non-associative reified multiplicative table passed GREEN (the Fix-A1 hole on the multiplicative side). The two-operation line is SYN, ring FULLY ABSENT as algebra in Helios (02_algebra_tower.md:134-136), authored as cited standard ring theory. CLASS-GENERAL: a sh:sparql node shape targeting fnd:RingOperationApplication whose constraint QUANTIFIES OVER EVERY fnd:Semiring instance ?mdl (bound ?mdl rdf:type fnd:Semiring, matching fnd:ringModel and fnd:fieldModel by rdfs:subClassOf under inference=rdfs, plus any bare fnd:Semiring), mirroring fnd:RingDistribShape / fnd:RingAddAssocShape rather than pinning a witness. To keep the four-way self-join bounded, $this is ANCHORED as the multiplicative a*b row itself (fnd:ringOp fnd:multiplicativeOp, ringLeft=a, ringRight=b, ringResult=ab), then ?mdl is bound from that row and rdf:type-guarded fnd:Semiring; the constraint forms (a*b)*c via an fnd:multiplicativeOp row (ringLeft=ab, ringRight=c, result=lhs), b*c via an fnd:multiplicativeOp row (ringLeft=b, ringRight=c, result=bc), a*(b*c) via an fnd:multiplicativeOp row (ringLeft=a, ringRight=bc, result=rhs), and FILTER(?lhs != ?rhs). Every clause reads EDGE existence over the reified applications plus the ?mdl rdf:type guard, never a bare sh:class over an rdfs:range, so inference=rdfs cannot forge a two-operation row and defang it (the SP1 defang discipline). On this floor the full GF(3) multiplicative Cayley table of fnd:ringModel makes every multiplicative triple associate (and fnd:fieldModel's sparser multiplicative table has no closing violating chain), so conforms=True; the PROBE OF RECORD - changing fnd:appRingMul_2_1 (2*1) fnd:ringResult from fnd:ringTwo to fnd:ringZero, so for the triple (a,b,c)=(2,1,2): (a*b)*c = (2*1)*2 = 0*2 = 0 (via fnd:appRingMul_0_2) while a*(b*c) = 2*(1*2) = 2*2 = 1 (via fnd:appRingMul_1_2 then fnd:appRingMul_2_2) - makes the constraint bite (conforms True->False), a fnd:Ring with non-associative multiplication, proving the tooth CLASS-GENERAL. Mirrors q_ring_mult_assoc." ;
    sh:targetClass fnd:RingOperationApplication ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "semiring rung (multiplicative associativity): the multiplicative operation of some fnd:Semiring instance (?mdl a fnd:Semiring, including fnd:Ring and fnd:Field by rdfs:subClassOf) is NOT associative - there is a triple (a,b,c) whose two bracketings (a*b)*c and a*(b*c) evaluate to different fnd:ringResult." ;
        sh:select """
            SELECT $this WHERE {
              $this <urn:silmaril:fnd:#ringStructure> ?mdl ; <urn:silmaril:fnd:#ringOp> <urn:silmaril:fnd:#multiplicativeOp> ; <urn:silmaril:fnd:#ringLeft> ?a ; <urn:silmaril:fnd:#ringRight> ?b ; <urn:silmaril:fnd:#ringResult> ?ab .
              ?mdl <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <urn:silmaril:fnd:#Semiring> .
              ?abc <urn:silmaril:fnd:#ringStructure> ?mdl ; <urn:silmaril:fnd:#ringOp> <urn:silmaril:fnd:#multiplicativeOp> ; <urn:silmaril:fnd:#ringLeft> ?ab ; <urn:silmaril:fnd:#ringRight> ?c ; <urn:silmaril:fnd:#ringResult> ?lhs .
              ?rbc <urn:silmaril:fnd:#ringStructure> ?mdl ; <urn:silmaril:fnd:#ringOp> <urn:silmaril:fnd:#multiplicativeOp> ; <urn:silmaril:fnd:#ringLeft> ?b ; <urn:silmaril:fnd:#ringRight> ?c ; <urn:silmaril:fnd:#ringResult> ?bc .
              ?rabc <urn:silmaril:fnd:#ringStructure> ?mdl ; <urn:silmaril:fnd:#ringOp> <urn:silmaril:fnd:#multiplicativeOp> ; <urn:silmaril:fnd:#ringLeft> ?a ; <urn:silmaril:fnd:#ringRight> ?bc ; <urn:silmaril:fnd:#ringResult> ?rhs .
              FILTER(?lhs != ?rhs)
            }
        """ ;
    ] .


# =====================================================================================
# fnd:RingAddIdentityShape (T5 / R7-2) — the two-operation ADDITIVE-IDENTITY tooth (design s3; the
# two-operation line is SYN, ring FULLY ABSENT as algebra in Helios, 02_algebra_tower.md:134-136). A
# Semiring/Ring/Field's additive part is a commutative MONOID (Semiring) / abelian GROUP (Ring/Field),
# so it MUST carry a two-sided additive identity 0 with 0+x = x AND x+0 = x for every element; but the
# ring reifies its operations via fnd:ringStructure/fnd:ringOp/fnd:ringLeft/fnd:ringRight/fnd:ringResult
# over the DISTINCT fnd:hasZeroElement zero (not the one-operation spine's fnd:hasIdentityElement the T4
# fnd:MonoidIdentityShape keys on), so NO spine identity tooth reached the ring additive identity - a
# Semiring/Ring/Field whose declared fnd:hasZeroElement fails 0+a=a, or which declares NO zero at all,
# passed GREEN (the round-7 finding-2 hole on the additive side). This tooth closes it, mirroring
# fnd:MonoidIdentityShape one file up but over the two-operation reified table: TWO targets -
# sh:targetSubjectsOf fnd:hasZeroElement (GENUINENESS) and sh:targetClass fnd:Semiring (EXISTENCE) -
# each self-guarded. Edge-existence over the reified applications + the fnd:hasZeroElement edge, never a
# bare sh:class over an rdfs:range, so inference=rdfs cannot defang it (the SP1 defang discipline).
# Floor: fnd:ringModel (full GF(3) additive table, 0+x=x and x+0=x for x in {0,1,2}) and fnd:fieldModel
# (0 declared, 0+0=0) both conform. PROBE OF RECORD (genuineness): change fnd:appRingAdd_0_1 (0+1=1)
# fnd:ringResult from fnd:ringOne to fnd:ringZero, so 0+1 = 0 != 1 - the declared zero fails the left-unit
# law and constraint A bites (conforms True->False). EXISTENCE probe: a fresh fnd:Semiring with no
# fnd:hasZeroElement -> constraint B bites. Mirrors q_ring_add_identity.
# =====================================================================================

fnd:RingAddIdentityShape a sh:NodeShape ;
    rdfs:label "RingAddIdentityShape" ;
    rdfs:comment "The two-operation ADDITIVE-IDENTITY tooth with teeth on the subjects of fnd:hasZeroElement (GENUINENESS) AND on the class fnd:Semiring (EXISTENCE) (algebra_rings.ttl, design s3; round-7 finding-2 close, additive side). The Semiring->Ring->Field additive operation (+) is a commutative MONOID (Semiring) / abelian GROUP (Ring/Field), so it MUST carry a two-sided additive identity 0 - the fnd:hasZeroElement - with 0+x = x AND x+0 = x for every carrier element x; but the ring reifies its operations via fnd:ringStructure/fnd:ringOp/fnd:ringLeft/fnd:ringRight/fnd:ringResult over fnd:hasZeroElement, a DISTINCT vocabulary from the one-operation spine's fnd:opStructure over fnd:hasIdentityElement that the T4 fnd:MonoidIdentityShape walks (the two are held DISTINCT precisely so a two-operation model never trips a T4 tooth), so NO spine identity tooth ever reached the ring additive identity - a fnd:Semiring/fnd:Ring/fnd:Field whose declared fnd:hasZeroElement fails 0+a=a, OR which omits the zero entirely, passed GREEN (the exact round-7 finding-2 hole on the additive side). The two-operation line is SYN, ring FULLY ABSENT as algebra in Helios (02_algebra_tower.md:134-136), authored as cited standard ring theory; this tooth is the two-operation / additive analogue of fnd:MonoidIdentityShape and makes two doctrines graph facts: (A) a declared additive zero really is a two-sided unit, and (B) a two-operation structure actually HAS a zero. A sh:sparql node shape with TWO targets - sh:targetSubjectsOf fnd:hasZeroElement and sh:targetClass fnd:Semiring - carrying TWO self-guarded sh:sparql constraints (the same multi-target self-guarded pattern fnd:MonoidIdentityShape / fnd:FieldMultInverseShape use). Constraint A (GENUINENESS) fires when a structure $this with fnd:hasZeroElement ?z has EITHER a reified fnd:additiveOp row with ?z on the left whose fnd:ringResult differs from the right operand (z+x != x, the left-unit law fails) OR a row with ?z on the right whose result differs from the left operand (x+z != x, the right-unit law fails). Constraint B (EXISTENCE, the guard-on-optional-edge close) fires when a $this that is a fnd:Semiring (directly, or via rdfs:subClassOf inference: every fnd:Ring / fnd:Field) carries NO fnd:hasZeroElement at all - a zero-less semiring, which the sh:targetSubjectsOf-only genuineness clause never focuses on (it binds $this to the zero, so a structure that simply OMITS the defining zero edge would escape GREEN); it mirrors fnd:MonoidIdentityShape constraint B one family over. Both clauses read EDGE existence over the reified applications / the fnd:hasZeroElement edge plus the rdf:type fnd:Semiring guard (materialisable but not forgeable between two specific nodes), never a bare sh:class over an rdfs:range, so inference=rdfs cannot defang it - the SP1 defang discipline. On this floor fnd:ringModel (fnd:hasZeroElement fnd:ringZero; the full GF(3) additive table with 0+0=0, 0+1=1, 0+2=2, 1+0=1, 2+0=2) and fnd:fieldModel (fnd:hasZeroElement fnd:fieldZero; 0+0=0) both declare a two-sided additive zero, so conforms=True; the GENUINENESS probe of record - changing fnd:appRingAdd_0_1 (0+1) fnd:ringResult from fnd:ringOne to fnd:ringZero, so 0+1 = 0 != 1 - makes constraint A bite (conforms True->False), a two-operation structure whose declared zero is not a two-sided additive unit, and the EXISTENCE probe - a fresh fnd:Semiring with NO fnd:hasZeroElement - makes constraint B bite, together proving both teeth CLASS-GENERAL over the class where the additive commutative-monoid substrate lives. Mirrors q_ring_add_identity." ;
    sh:targetSubjectsOf fnd:hasZeroElement ;
    sh:targetClass fnd:Semiring ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "ring/semiring rung (genuine additive identity): this structure's declared fnd:hasZeroElement is NOT a two-sided additive identity - a reified additive row with the zero on the left has a result != its right operand (0+x != x), or a row with the zero on the right has a result != its left operand (x+0 != x)." ;
        sh:select """
            SELECT $this WHERE {
              $this <urn:silmaril:fnd:#hasZeroElement> ?z .
              {
                ?rL <urn:silmaril:fnd:#ringStructure> $this ; <urn:silmaril:fnd:#ringOp> <urn:silmaril:fnd:#additiveOp> ; <urn:silmaril:fnd:#ringLeft> ?z ; <urn:silmaril:fnd:#ringRight> ?x ; <urn:silmaril:fnd:#ringResult> ?rLr .
                FILTER(?rLr != ?x)
              } UNION {
                ?rR <urn:silmaril:fnd:#ringStructure> $this ; <urn:silmaril:fnd:#ringOp> <urn:silmaril:fnd:#additiveOp> ; <urn:silmaril:fnd:#ringLeft> ?x ; <urn:silmaril:fnd:#ringRight> ?z ; <urn:silmaril:fnd:#ringResult> ?rRr .
                FILTER(?rRr != ?x)
              }
            }
        """ ;
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "ring/semiring rung (additive identity EXISTENCE): this fnd:Semiring (directly or via rdfs:subClassOf - every fnd:Ring / fnd:Field) carries NO fnd:hasZeroElement - a zero-less two-operation structure (the defining additive identity edge is OMITTED, so the additive-identity law is not opt-in; mirrors fnd:MonoidIdentityShape constraint B)." ;
        sh:select """
            SELECT $this WHERE {
              $this <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <urn:silmaril:fnd:#Semiring> .
              FILTER NOT EXISTS { $this <urn:silmaril:fnd:#hasZeroElement> ?z }
            }
        """ ;
    ] .


# =====================================================================================
# fnd:RingMultIdentityShape (T5 / R7-2 / Fix-B) — the two-operation MULTIPLICATIVE-IDENTITY tooth (design s3;
# the two-operation line is SYN, ring FULLY ABSENT as algebra in Helios, 02_algebra_tower.md:134-136). A
# Semiring's multiplicative part is a MONOID (each of the two operations of a semiring is a monoid, · with
# identity 1), so a fnd:Semiring MUST carry a two-sided multiplicative identity 1 - the fnd:hasOneElement -
# with 1*x = x AND x*1 = x for every element; but the ring reifies over the DISTINCT fnd:hasOneElement (not
# the spine's fnd:hasIdentityElement the T4 fnd:MonoidIdentityShape keys on), so NO spine identity tooth
# reached the ring/semiring multiplicative identity - a fnd:Semiring whose declared fnd:hasOneElement fails
# 1*a=a, or which omits the one, passed GREEN (round-7 finding-2, multiplicative side; and Fix-B: the
# EXISTENCE clause was scoped only to fnd:Ring, so a unit-less bare fnd:Semiring - itself a multiplicative
# monoid - escaped GREEN). Fix-B extends the EXISTENCE scope from fnd:Ring to fnd:Semiring (and thus
# Ring/Field by rdfs:subClassOf), exactly mirroring fnd:RingAddIdentityShape whose additive EXISTENCE
# already quantifies over fnd:Semiring. TWO targets - sh:targetSubjectsOf fnd:hasOneElement (GENUINENESS) +
# sh:targetClass fnd:Semiring (EXISTENCE) - self-guarded. Edge-existence, defang-proof. Floor: fnd:ringModel
# (1*x=x, x*1=x over the full GF(3) mult table) and fnd:fieldModel (1 declared, 1*1=1), both fnd:Semiring by
# rdfs:subClassOf, declare a two-sided one and conform. PROBE OF RECORD (genuineness): change
# fnd:appRingMul_1_0 (1*0=0) fnd:ringResult from fnd:ringZero to fnd:ringOne, so 1*0 = 1 != 0 - the declared
# one fails the left-unit law and constraint A bites. EXISTENCE probe (Fix-B): a fresh unit-less fnd:Semiring
# with no fnd:hasOneElement -> constraint B bites. Mirrors q_ring_mult_identity.
# =====================================================================================

fnd:RingMultIdentityShape a sh:NodeShape ;
    rdfs:label "RingMultIdentityShape" ;
    rdfs:comment "The two-operation MULTIPLICATIVE-IDENTITY tooth with teeth on the subjects of fnd:hasOneElement (GENUINENESS) AND on the class fnd:Semiring (EXISTENCE) (algebra_rings.ttl, design s3; round-7 finding-2 close, multiplicative side; Fix-B EXISTENCE-scope broadening). The Semiring->Ring->Field multiplicative operation (*) is a MONOID (per the design two-operation line: 'each of the two operations a monoid'), so a fnd:Semiring MUST carry a two-sided multiplicative identity 1 - the fnd:hasOneElement - with 1*x = x AND x*1 = x for every carrier element x; but the ring reifies its operations via fnd:ringStructure/fnd:ringOp/fnd:ringLeft/fnd:ringRight/fnd:ringResult over fnd:hasOneElement, a DISTINCT vocabulary from the one-operation spine's fnd:opStructure over fnd:hasIdentityElement that the T4 fnd:MonoidIdentityShape walks (held DISTINCT so a two-operation model never trips a T4 tooth), so NO spine identity tooth ever reached the ring/semiring multiplicative identity - a fnd:Semiring whose declared fnd:hasOneElement fails 1*a=a, OR which omits the one entirely, passed GREEN (the exact round-7 finding-2 hole on the multiplicative side; and Fix-B: the EXISTENCE clause was scoped to fnd:Ring, so a unit-less bare fnd:Semiring - itself a multiplicative monoid needing a two-sided 1 - was never focused and escaped GREEN). Fix-B broadens the EXISTENCE scope from fnd:Ring to fnd:Semiring (and thus Ring/Field), exactly mirroring fnd:RingAddIdentityShape whose ADDITIVE existence already quantifies over fnd:Semiring - the same class where the additive-monoid substrate lives. The two-operation line is SYN, ring FULLY ABSENT as algebra in Helios (02_algebra_tower.md:134-136), authored as cited standard ring theory; this tooth is the multiplicative analogue of fnd:RingAddIdentityShape and makes two doctrines graph facts: (A) a declared multiplicative one really is a two-sided unit, and (B) a semiring/ring actually HAS a one. A sh:sparql node shape with TWO targets - sh:targetSubjectsOf fnd:hasOneElement and sh:targetClass fnd:Semiring - carrying TWO self-guarded sh:sparql constraints (the same multi-target self-guarded pattern fnd:MonoidIdentityShape / fnd:FieldMultInverseShape use). Constraint A (GENUINENESS) fires when a structure $this with fnd:hasOneElement ?o has EITHER a reified fnd:multiplicativeOp row with ?o on the left whose fnd:ringResult differs from the right operand (1*x != x, the left-unit law fails) OR a row with ?o on the right whose result differs from the left operand (x*1 != x, the right-unit law fails). Constraint B (EXISTENCE, the guard-on-optional-edge close) fires when a $this that is a fnd:Semiring (directly, or via rdfs:subClassOf inference: every fnd:Ring / fnd:Field) carries NO fnd:hasOneElement at all - a one-less semiring, which the sh:targetSubjectsOf-only genuineness clause never focuses on (it binds $this to the one, so a semiring that OMITS the defining one edge would escape GREEN); it mirrors fnd:RingAddIdentityShape constraint B on the additive side and fnd:FieldMultInverseShape constraint C (one-element EXISTENCE) one rung down. Both clauses read EDGE existence over the reified applications / the fnd:hasOneElement edge plus the rdf:type fnd:Semiring guard, never a bare sh:class over an rdfs:range, so inference=rdfs cannot defang it - the SP1 defang discipline. On this floor fnd:ringModel (fnd:hasOneElement fnd:ringOne; the full GF(3) multiplicative table with 1*0=0, 1*1=1, 1*2=2, 0*1=0, 2*1=2) and fnd:fieldModel (fnd:hasOneElement fnd:fieldOne; 1*1=1), both fnd:Semiring by rdfs:subClassOf, declare a two-sided multiplicative one, so conforms=True; the GENUINENESS probe of record - changing fnd:appRingMul_1_0 (1*0) fnd:ringResult from fnd:ringZero to fnd:ringOne, so 1*0 = 1 != 0 - makes constraint A bite (conforms True->False), a ring whose declared one is not a two-sided multiplicative unit, and the EXISTENCE probe (Fix-B) - a fresh unit-less fnd:Semiring with NO fnd:hasOneElement - makes constraint B bite, together proving both teeth CLASS-GENERAL over the class where the multiplicative-monoid substrate lives. Mirrors q_ring_mult_identity." ;
    sh:targetSubjectsOf fnd:hasOneElement ;
    sh:targetClass fnd:Semiring ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "ring/semiring rung (genuine multiplicative identity): this structure's declared fnd:hasOneElement is NOT a two-sided multiplicative identity - a reified multiplicative row with the one on the left has a result != its right operand (1*x != x), or a row with the one on the right has a result != its left operand (x*1 != x)." ;
        sh:select """
            SELECT $this WHERE {
              $this <urn:silmaril:fnd:#hasOneElement> ?o .
              {
                ?rL <urn:silmaril:fnd:#ringStructure> $this ; <urn:silmaril:fnd:#ringOp> <urn:silmaril:fnd:#multiplicativeOp> ; <urn:silmaril:fnd:#ringLeft> ?o ; <urn:silmaril:fnd:#ringRight> ?x ; <urn:silmaril:fnd:#ringResult> ?rLr .
                FILTER(?rLr != ?x)
              } UNION {
                ?rR <urn:silmaril:fnd:#ringStructure> $this ; <urn:silmaril:fnd:#ringOp> <urn:silmaril:fnd:#multiplicativeOp> ; <urn:silmaril:fnd:#ringLeft> ?x ; <urn:silmaril:fnd:#ringRight> ?o ; <urn:silmaril:fnd:#ringResult> ?rRr .
                FILTER(?rRr != ?x)
              }
            }
        """ ;
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "ring/semiring rung (multiplicative identity EXISTENCE): this fnd:Semiring (directly or via rdfs:subClassOf - every fnd:Ring / fnd:Field) carries NO fnd:hasOneElement - a one-less semiring (the defining multiplicative identity edge is OMITTED, so the multiplicative-identity law is not opt-in; the multiplicative part is a MONOID from the fnd:Semiring rung up, exactly as the additive part is from fnd:Semiring in fnd:RingAddIdentityShape; mirrors fnd:FieldMultInverseShape constraint C)." ;
        sh:select """
            SELECT $this WHERE {
              $this <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <urn:silmaril:fnd:#Semiring> .
              FILTER NOT EXISTS { $this <urn:silmaril:fnd:#hasOneElement> ?o }
            }
        """ ;
    ] .


# =====================================================================================
# fnd:FieldMultCommShape (T5 / R7-1) — field MULTIPLICATIVE-COMMUTATIVITY over every fnd:Field's *
# operation (a*b = b*a) (design s3 two-operation line: 'Field multiplicative part COMMUTATIVE'; SYN,
# field FULLY ABSENT as algebra in Helios, only record-field, 02_algebra_tower.md:134-136). A fnd:Field's
# defining upgrade over a fnd:Ring is that its NONZERO elements form a COMMUTATIVE group under * (a field's
# multiplication commutes); the additive side already has fnd:RingAddCommShape, but the MULTIPLICATIVE
# commutativity that is specific to fnd:Field had NO tooth - a fnd:Field with a*b != b*a passed GREEN (the
# round-7 finding-1 HIGH hole). This tooth mirrors fnd:RingAddCommShape but on the fnd:multiplicativeOp rows
# and SCOPED to fnd:Field (not fnd:Semiring - noncommutative rings/semirings are legitimate, so the
# multiplicative-commutativity law is added ONLY at the fnd:Field rung, exactly as the design pins it). A
# sh:sparql node shape targeting fnd:RingOperationApplication, $this ANCHORED as the multiplicative a*b row,
# binding ?mdl a fnd:Field and requiring the reversed row b*a to agree. Edge-existence over the reified
# applications + the ?mdl rdf:type fnd:Field guard, never a bare sh:class over an rdfs:range, so
# inference=rdfs cannot forge a two-operation row and defang it (the SP1 defang discipline). Floor: the GF(3)
# field fnd:fieldModel multiplicative table (1*1=1, 2*2=1, 2*1=2, 1*2=2) is commutative -> conforms; PROBE
# OF RECORD - change fnd:appFieldMul_1_2 (1*2) fnd:ringResult from fnd:fieldTwo to fnd:fieldOne, so 1*2 = 1
# while 2*1 = 2 (fnd:appFieldMul_2_1) - the pair (1,2) is non-commutative and the shape bites. Mirrors
# q_field_mult_comm.
# =====================================================================================

fnd:FieldMultCommShape a sh:NodeShape ;
    rdfs:label "FieldMultCommShape" ;
    rdfs:comment "The two-operation field MULTIPLICATIVE-COMMUTATIVITY tooth with teeth on the reified multiplicative Cayley table of every fnd:Field model (algebra_rings.ttl, design s3; round-7 finding-1 HIGH close). The design's two-operation line pins the Field rung as 'multiplicative part COMMUTATIVE' - a fnd:Field's defining upgrade over a fnd:Ring is that its nonzero elements form a COMMUTATIVE group under * (every field's multiplication commutes: a*b = b*a) - and the additive side already carries fnd:RingAddCommShape, but the MULTIPLICATIVE commutativity SPECIFIC to fnd:Field had NO biting tooth: the ring-family teeth checked additive commutativity (fnd:RingAddCommShape, over fnd:Semiring), both associativities and distributivity, but NOT multiplicative commutativity - so a fnd:Field with a non-commutative reified multiplicative table passed GREEN (the exact round-7 finding-1 HIGH hole). Field is FULLY ABSENT as algebra in Helios (only record-field, 02_algebra_tower.md:134-136), authored as cited standard field theory; this tooth is the MULTIPLICATIVE / field-scoped analogue of fnd:RingAddCommShape. It is scoped to fnd:Field, NOT fnd:Semiring: non-commutative rings and semirings are legitimate algebra (matrix rings, the corpus semiring coefficients), so multiplicative commutativity is added ONLY at the fnd:Field rung - mirroring how the design adds it exactly there, and unlike additive commutativity which holds from fnd:Semiring up. CLASS-GENERAL over fnd:Field (no witness IRI hardcoded): a sh:sparql node shape targeting fnd:RingOperationApplication whose constraint QUANTIFIES OVER EVERY fnd:Field instance ?mdl (bound ?mdl rdf:type fnd:Field, so under inference=rdfs it matches the field witness fnd:fieldModel and any bare fnd:Field), mirroring fnd:RingAddCommShape rather than pinning a witness. $this is ANCHORED as the multiplicative a*b row (fnd:ringOp fnd:multiplicativeOp, ringLeft=a, ringRight=b, ringResult=ab); the constraint forms the reversed b*a row (fnd:multiplicativeOp, ringLeft=b, ringRight=a, ringResult=ba) and FILTER(?ab != ?ba). It reads EDGE existence over the reified applications plus the ?mdl rdf:type fnd:Field guard, never a bare sh:class over an rdfs:range, so inference=rdfs cannot forge a two-operation row and defang it (the SP1 defang discipline). On this floor the GF(3) field fnd:fieldModel multiplicative table (1*1=1, 2*2=1, 2*1=2 and its reverse 1*2=2) is commutative - the distinct-element pair (1,2) has 1*2 = 2 = 2*1 - so conforms=True; the PROBE OF RECORD - changing fnd:appFieldMul_1_2 (1*2) fnd:ringResult from fnd:fieldTwo to fnd:fieldOne, so 1*2 = 1 while 2*1 = 2 (via fnd:appFieldMul_2_1) - makes the pair (1,2) non-commutative and the constraint bite (conforms True->False), a fnd:Field with non-commutative multiplication, proving the tooth CLASS-GENERAL over the fnd:Field rung. Mirrors q_field_mult_comm." ;
    sh:targetClass fnd:RingOperationApplication ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "field rung (multiplicative commutativity): the multiplicative operation of some fnd:Field instance (?mdl a fnd:Field) is NOT commutative - there is a pair (a,b) whose products a*b and b*a evaluate to different fnd:ringResult." ;
        sh:select """
            SELECT $this WHERE {
              $this <urn:silmaril:fnd:#ringStructure> ?mdl ; <urn:silmaril:fnd:#ringOp> <urn:silmaril:fnd:#multiplicativeOp> ; <urn:silmaril:fnd:#ringLeft> ?a ; <urn:silmaril:fnd:#ringRight> ?b ; <urn:silmaril:fnd:#ringResult> ?ab .
              ?mdl <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <urn:silmaril:fnd:#Field> .
              ?rba <urn:silmaril:fnd:#ringStructure> ?mdl ; <urn:silmaril:fnd:#ringOp> <urn:silmaril:fnd:#multiplicativeOp> ; <urn:silmaril:fnd:#ringLeft> ?b ; <urn:silmaril:fnd:#ringRight> ?a ; <urn:silmaril:fnd:#ringResult> ?ba .
              FILTER(?ab != ?ba)
            }
        """ ;
    ] .


# =====================================================================================
# fnd:QuasigroupTotalityShape (T4 / Fix-A2) — Latin-square division TOTALITY/EXISTENCE over the WHOLE
# fnd:Quasigroup family (design s3; SYN, quasigroup/loop fully absent in Helios). The existing
# fnd:QuasigroupDivisionShape enforced only the UNIQUENESS half of the Latin-square law (no row/column
# repeats a result); a PARTIAL division table where some a.x=b has NO solution passed GREEN. This tooth
# adds the EXISTENCE/TOTALITY half: for a fnd:Quasigroup (and fnd:Loop via subclass) over its enumerated
# carrier (derived as the elements appearing as left operands - in a Latin square every element is some
# left operand), every pair (a,b) MUST have a LEFT-division solution x (a.x=b) AND a RIGHT-division
# solution y (y.a=b). A sh:sparql node shape targeting fnd:BinaryOperationApplication (mirroring
# fnd:QuasigroupDivisionShape) with a UNION of the two totality breaches. Edge-existence + rdf:type guard,
# defang-proof. Floor: the 9-row Z/3 quasigroup Latin square AND the 25-row order-5 loop Latin square are
# TOTAL (every pair has both divisions) -> conforms; PROBE OF RECORD - DELETE the row fnd:appQgAC
# (A.C=C) from fnd:quasigroupModel, so A.x never reaches C (A reaches only {A,B}) and the pair (a=A,b=C)
# has no left-division solution -> the left-totality branch bites (conforms True->False), while
# fnd:QuasigroupDivisionShape (uniqueness) stays GREEN (deleting a row introduces no duplicate).
# =====================================================================================

fnd:QuasigroupTotalityShape a sh:NodeShape ;
    rdfs:label "QuasigroupTotalityShape" ;
    rdfs:comment "The Quasigroup-rung Latin-square-division TOTALITY/EXISTENCE tooth with teeth on the reified operation tables of the fnd:Quasigroup family (algebra_spine.ttl, design s3; Fix-A2). fnd:QuasigroupDivisionShape / q_quasigroup_division enforce only the UNIQUENESS half of the Latin-square law (no fixed left operand yields one result for two right operands, no fixed right operand for two left operands - no repeated result in a row or column); but a PARTIAL division table where some equation a.x=b has NO solution x SATISFIES uniqueness vacuously and passed GREEN (a quasigroup Cayley table must be a Latin square, i.e. total AND unique division - the existence half was unchecked). Quasigroup/loop are FULLY ABSENT from Helios (02_algebra_tower.md s1: grep zero), authored as cited standard universal algebra. This tooth adds the EXISTENCE half: for every fnd:Quasigroup $this (matching fnd:quasigroupModel directly and fnd:loopModel via fnd:Loop rdfs:subClassOf fnd:Quasigroup under inference=rdfs) and every pair of carrier elements (a,b) - the carrier DERIVED as the set of elements appearing as a fnd:opLeft of some row of $this (in a Latin square every carrier element is some left operand, so this derivation is exact and needs no separate enumeration edge) - there MUST exist a LEFT-division solution x with a.x=b AND a RIGHT-division solution y with y.a=b. A sh:sparql node shape targeting fnd:Quasigroup directly (so the focus nodes are exactly the two family models fnd:quasigroupModel and fnd:loopModel - the loop typed fnd:Quasigroup by rdfs:subClassOf under inference=rdfs - keeping the per-model carrier cross-join bounded, unlike fnd:QuasigroupDivisionShape's whole-fnd:BinaryOperationApplication target which would re-evaluate the same existence sweep on every op row) with a UNION of two constraints, both scoped to $this's own reified rows (fnd:opStructure $this): (A) LEFT-division totality - fires when carrier elements a and b exist (each a fnd:opLeft of some row of $this) with NO row fnd:opStructure $this, fnd:opLeft a, fnd:opRight ?x, fnd:opResult b (the equation a.x=b has no solution); and (B) RIGHT-division totality - fires when carrier elements a and b exist with NO row fnd:opStructure $this, fnd:opLeft ?y, fnd:opRight a, fnd:opResult b (the equation y.a=b has no solution). Both clauses read EDGE existence over the reified op rows scoped by fnd:opStructure to the focus $this a fnd:Quasigroup, never a bare sh:class over an rdfs:range, so inference=rdfs cannot forge an op-row edge and defang it (the SP1 defang discipline); the fnd:Quasigroup focus guard is essential (without it the non-Latin left-zero fnd:semigroupModel and identity fnd:monoidModel rows would be misread as partial-division tables), and it is exactly what admits the loop witness. On this floor BOTH the 9-row cyclic Z/3 quasigroup table (each row and column a permutation of {A,B,C}, so every pair has a unique left and right divisor) and the 25-row order-5 loop table fnd:loopModel (a verified Latin square) are TOTAL, so conforms=True; the PROBE OF RECORD - DELETING the row fnd:appQgAC (A.C=C) from fnd:quasigroupModel, so the A-row becomes {A.A=A, A.B=B} and A.x never reaches C, leaving the pair (a=A, b=C) with no left-division solution - makes constraint A bite (conforms True->False), the exact partial-table case the uniqueness-only tooth passed, while fnd:QuasigroupDivisionShape stays GREEN (deleting a row introduces no repeated result). Mirrors q_quasigroup_total." ;
    sh:targetClass fnd:Quasigroup ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "quasigroup rung (division TOTALITY): the Cayley table of this fnd:Quasigroup family model (fnd:quasigroupModel or fnd:loopModel) is a PARTIAL Latin square - some pair (a,b) of carrier elements has NO left-division solution x (a.x=b) or NO right-division solution y (y.a=b); division is not total." ;
        sh:select """
            SELECT $this WHERE {
              $this <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <urn:silmaril:fnd:#Quasigroup> .
              {
                ?ra <urn:silmaril:fnd:#opStructure> $this ; <urn:silmaril:fnd:#opLeft> ?a .
                ?rb <urn:silmaril:fnd:#opStructure> $this ; <urn:silmaril:fnd:#opLeft> ?b .
                FILTER NOT EXISTS { ?rx <urn:silmaril:fnd:#opStructure> $this ; <urn:silmaril:fnd:#opLeft> ?a ; <urn:silmaril:fnd:#opRight> ?x ; <urn:silmaril:fnd:#opResult> ?b }
              } UNION {
                ?ra2 <urn:silmaril:fnd:#opStructure> $this ; <urn:silmaril:fnd:#opLeft> ?a2 .
                ?rb2 <urn:silmaril:fnd:#opStructure> $this ; <urn:silmaril:fnd:#opLeft> ?b2 .
                FILTER NOT EXISTS { ?ry <urn:silmaril:fnd:#opStructure> $this ; <urn:silmaril:fnd:#opLeft> ?y ; <urn:silmaril:fnd:#opRight> ?a2 ; <urn:silmaril:fnd:#opResult> ?b2 }
              }
            }
        """ ;
    ] .
