@prefix silm: <urn:silmaril:entity#> .
@prefix cco: <https://www.commoncoreontologies.org/> .
@prefix cceo: <https://www.commoncoreontologies.org/cpo#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

silm:shapeatom a owl:Class ;
    rdfs:label "ShapeAtom" ;
    rdfs:comment "A named diagrammatic shape backed by a TikZ style snippet, a semantic role, and a CCO Quality IRI for grounded geometric attribution." .
