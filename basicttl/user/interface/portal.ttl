portal:DocumentFrameLayout a portal:Artifact ;
    portal:content """<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>{{ page.title | escape }}</title><link rel="stylesheet" href="{{ '/assets/css/main.css' | relative_url }}"><link rel="stylesheet" href="{{ '/assets/css/generated.css' | relative_url }}"><link rel="stylesheet" href="{{ '/assets/vendor/katex/katex.min.css' | relative_url }}"></head>
<body class="document-frame" data-base-path="{{ site.baseurl }}" data-source="{{ page.document_source | escape }}"><a class="skip-link" href="#document-content">Skip to document</a><header class="document-toolbar"><span>{{ page.title | escape }}</span><button type="button" data-fold="close">Collapse sections</button><button type="button" data-fold="open">Expand sections</button><a href="{{ page.url | relative_url }}" target="_blank" rel="noopener">Open full document</a></header><div class="document-layout"><details class="document-toc" open><summary>Contents</summary><nav aria-label="Document contents"><ol id="document-toc"></ol></nav></details><main id="document-content" class="embedded-document-body" data-document-source="{{ page.document_source | escape }}" data-document-digest="{{ page.document_digest }}">{{ content }}</main></div><script defer src="{{ '/assets/vendor/katex/katex.min.js' | relative_url }}"></script><script defer src="{{ '/assets/vendor/katex/contrib/auto-render.min.js' | relative_url }}"></script><script defer src="{{ '/assets/js/portal.js' | relative_url }}"></script></body></html>""" ;
    portal:path "docs/_layouts/document-frame.html" .

portal:Elements portal:query """PREFIX interface: <urn:silmaril:user:interface:>
PREFIX projection: <urn:silmaril:user:interface:projection:>
PREFIX geometry: <http://www.opengis.net/ont/geosparql#>
PREFIX datatype: <http://www.w3.org/2001/XMLSchema#>
SELECT ?subject ?tag ?text ?parent ?horizontal ?vertical WHERE {
 ?root interface:child* ?subject . ?subject a ?species . ?species projection:tag ?tag .
 OPTIONAL { ?subject interface:text ?literal } BIND(COALESCE(?literal, "") AS ?text)
 OPTIONAL { ?parent interface:child ?subject }
 ?subject geometry:hasGeometry/geometry:asWKT ?point .
 BIND(STRAFTER(STR(?point), "POINT (") AS ?coordinates)
 BIND(datatype:integer(STRBEFORE(?coordinates, " ")) AS ?horizontal)
 BIND(datatype:integer(STRBEFORE(STRAFTER(?coordinates, " "), ")")) AS ?vertical)
} ORDER BY ?vertical ?horizontal STR(?subject)""" .

