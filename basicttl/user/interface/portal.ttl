<urn:silmaril:user:interface:portal:element:8> a portal:Paragraph ;
    geometry:hasGeometry <urn:silmaril:user:interface:portal:geometry:8> ;
    interface:text "Magma, semigroup, and monoid add operation, associativity, and identity. Commutative monoids add symmetry; groups add inverses; abelian groups have both. Quasigroups and loops take the division branch. Follow the reduct records to see which structure is forgotten." .

<urn:silmaril:user:interface:portal:element:9> a portal:Link ;
