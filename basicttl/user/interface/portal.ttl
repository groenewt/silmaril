<urn:silmaril:user:interface:portal:element:39> a portal:Paragraph ;
    geometry:hasGeometry <urn:silmaril:user:interface:portal:geometry:39> ;
    interface:text "For the declared carrier A, every ordered pair needs exactly one result in A. For a callable f, the output and the error-or-effect remain separate projections of one physical frame. Neither formula certifies the current implementation." .

<urn:silmaril:user:interface:portal:element:4> a portal:Link ;
    geometry:hasGeometry <urn:silmaril:user:interface:portal:geometry:4> ;
    interface:attribute <urn:silmaril:user:interface:portal:attribute:4:class>,
        <urn:silmaril:user:interface:portal:attribute:4:href> ;
    interface:text "Open the monoid declaration →" .

<urn:silmaril:user:interface:portal:element:40> a portal:MathematicalExpression ;
    geometry:hasGeometry <urn:silmaril:user:interface:portal:geometry:40> ;
    interface:attribute <urn:silmaril:user:interface:portal:attribute:40:data-mathematics> ;
    interface:text "\\begin{aligned}\\mu &: A\\times A\\longrightarrow A \\\\\\forall\\,a,b\\in A\\;&\\exists!\\,c\\in A:\\ \\mu(a,b)=c\\end{aligned}" .

<urn:silmaril:user:interface:portal:element:41> a portal:MathematicalExpression ;
    geometry:hasGeometry <urn:silmaril:user:interface:portal:geometry:41> ;
    interface:attribute <urn:silmaril:user:interface:portal:attribute:41:data-mathematics> ;
    interface:text "\\begin{aligned}f &: T\\longrightarrow\\operatorname{Frame}(X,Y) \\\\\\pi_{\\mathrm{output}} &: \\operatorname{Frame}(X,Y)\\longrightarrow X \\\\\\pi_{\\mathrm{error\\mid effect}} &: \\operatorname{Frame}(X,Y)\\longrightarrow Y\\end{aligned}" .

<urn:silmaril:user:interface:portal:element:42> a portal:Paragraph ;
    geometry:hasGeometry <urn:silmaril:user:interface:portal:geometry:42> ;
    interface:text "The algebra spine distinguishes theory records, model declarations, equations, and evidence. The runtime still owes physically integrated byte-carrier types, dependency gates, a unary launcher, and inverse readback before site generation is admitted." .

