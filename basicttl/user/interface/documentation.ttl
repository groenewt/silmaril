@prefix document: <urn:silmaril:user:interface:documentation:> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .

document:Content document:query """PREFIX document: <urn:silmaril:user:interface:documentation:>
SELECT ?identity ?path ?title ?content ?digest WHERE { ?subject a document:Source ; document:identity ?identity ; document:path ?path ; document:title ?title ; document:content ?content ; document:digest ?digest } ORDER BY ?path""" .

document:Include a document:Template ;
    document:content """<div class="document-shelf">
{% for document in site.data.documentation %}{% if include.source == nil or include.source == document.source %}
<details class="embedded-document" id="document-{{ document.identity }}" data-document-title="{{ document.title | escape }}">
<summary><span>{{ document.title | escape }}</span><small>{{ document.source | escape }}</small></summary>
<iframe class="document-panel" title="{{ document.title | escape }}" data-document-source="{{ document.source | escape }}" data-document-digest="{{ document.digest }}" data-src="{{ '/documents/' | append: document.identity | append: '/' | relative_url }}" loading="lazy"></iframe>
<noscript><a href="{{ '/documents/' | append: document.identity | append: '/' | relative_url }}">Read {{ document.title | escape }}</a></noscript>
</details>{% endif %}{% endfor %}</div>""" ;
    document:path "docs/_includes/documentation.html" .

document:Navigation a document:Template ;
    document:content "<a href=\"{{ \"/reading/\" | relative_url }}\">Reading room</a>" ;
    document:path "docs/_includes/reading-navigation.html" .

document:Profile a document:Template ;
    document:content """<section class="section page-section"><div class="section-container">
<h2>Aster — review and implementation identity</h2>
<p>A distinct session signing identity for the user-interface, ontology and documentation work. Its public key is proposed for the agent trust class; maintainer endorsement establishes trust.</p>
<dl><dt>Signing address</dt><dd>aster@silmaril.internal</dd><dt>Public fingerprint</dt><dd><code>1649618A5612CC75132F9336F52E907F309C73B3</code></dd><dt>Algorithm</dt><dd>Ed25519 / OpenPGP</dd><dt>Custody</dt><dd>The private key remains in the session keyring. Only the public key is published.</dd></dl>
</div></section>""" ;
    document:path "docs/_includes/aster-profile.html" .

document:Reading a document:Template ;
    document:content """---
layout: default
title: "Reading room | Silmaril"
permalink: /reading/
---
<section class="living-portal reading-room"><p class="section-eyebrow">The reading room · open one cupboard at a time</p><h1>Every document has a place.</h1><p>Notes from the workshop, plans for the next floor, and the laws the machinery still owes. Choose a title to read it here. Each document has its own contents, folding sections, and full-page view.</p><div class="reading-controls"><label for="document-search">Find a document</label><input id="document-search" type="search" placeholder="Search titles or paths…"><button type="button" data-shelf="close">Collapse all documents</button><button type="button" data-shelf="open">Expand visible documents</button><p id="document-count" role="status" aria-live="polite"></p></div><details class="reading-contents"><summary>Document contents</summary><nav aria-label="Reading room contents"><ul>{% for document in site.data.documentation %}<li><a href="#document-{{ document.identity }}">{{ document.title | escape }}</a></li>{% endfor %}</ul></nav></details>{% include documentation.html %}</section>""" ;
    document:path "docs/reading.html" .

document:Registry document:query """PREFIX document: <urn:silmaril:user:interface:documentation:>
SELECT ?subject ?path WHERE { ?subject a document:Source ; document:path ?path } ORDER BY ?path""" .

document:RepositoryCatalog a document:Catalog ;
    document:extension ".md" .

document:Templates document:query """PREFIX document: <urn:silmaril:user:interface:documentation:>
SELECT ?path ?content WHERE { ?subject a document:Template ; document:path ?path ; document:content ?content } ORDER BY ?path""" .

document:content a owl:DatatypeProperty .

document:digest a owl:DatatypeProperty .

document:identity a owl:DatatypeProperty .

document:path a owl:DatatypeProperty .

document:query a owl:DatatypeProperty .

