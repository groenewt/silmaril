# =====================================================================================
# T11 — ANCESTRAL GROUNDING PATHS (STEP B completeness, SP1 q_ancestral_transport_resolves).
# =====================================================================================
# Grounding the crs progenitor/child hierarchies (carriers B_rgb -> {Q_A,Q_G}; role tower K_* ->
# {K_S,K_O,K_P}; geometer -> {role, quark, plane}; plane -> {honeycomb, geographic, role-pair};
# role-pair -> {(S,O),(S,P),(O,P)}) makes each child A a tower subtype below a REALIZED proper
# ancestor B (both now rdfs:subClassOf+ prim:FormalType and both dual-grounded, so B carries
# rho(B)=crs:carrier_B with prim:interpretAs closing back to B). SP1's q_ancestral_transport_resolves
# then REQUIRES, for every such (A,B) pair, a resolvable prim:AncestralGroundingPath carrying A's
# grounding UP to rho(B) — exactly as SP1's realization.ttl supplies for its 45 tower subtype pairs.
# This block materialises one per pair: a prim:RealizationTransport (the rho-image of the taxonomic
# subtyping A -> B, prim:transportDom rho(A)=crs:carrier_A, prim:transportCod rho(B)=crs:carrier_B,
# prim:isTransportIdentity false) and a prim:AncestralGroundingPath resolving prim:ancestralLandsIn
# onto rho(B). crs subtyping is asserted directly via rdfs:subClassOf (T2/T3/T5/T6), so — unlike SP1's
# number tower — SP3 does NOT mint the formal prim:SubtypeArrow/olog apparatus here; the path therefore
# carries no prim:ancestralViaArrow (q_ancestral_transport_resolves does not read it), and no
# prim:SubtypeArrow / prim:CompositeArrow is created (so q_yoneda_full / q_functor_composition_total /
# FunctorTransportShape are untouched). Each child keeps its OWN direct grounding (its cluster above)
# UNCHANGED; this only ADDS the transported second grounding, honouring the enrich-do-not-strip law.
# =====================================================================================

crs:rt_sub_AtlasByteCarrier_TaggedByteCarrier a prim:RealizationTransport ;
    prim:transportDom crs:carrier_AtlasByteCarrier ;
    prim:transportCod crs:carrier_TaggedByteCarrier ;
    prim:isTransportIdentity false ;
    rdfs:label "rho(sub: AtlasByteCarrier -> TaggedByteCarrier) = transport carrier_AtlasByteCarrier -> carrier_TaggedByteCarrier" ;
    rdfs:comment "The rho-image of the taxonomic subtyping arrow crs:AtlasByteCarrier rdfs:subClassOf+ crs:TaggedByteCarrier: a non-identity prim:RealizationTransport carrying rho(crs:AtlasByteCarrier) = crs:carrier_AtlasByteCarrier (prim:transportDom) up to rho(crs:TaggedByteCarrier) = crs:carrier_TaggedByteCarrier (prim:transportCod), prim:isTransportIdentity false. It is the transport crs:agp_AtlasByteCarrier_TaggedByteCarrier resolves along so crs:AtlasByteCarrier is grounded a SECOND way — transported into its realized ancestor crs:TaggedByteCarrier's carrier — in ADDITION to its own direct grounding, keeping SP1's q_ancestral_transport_resolves total over the merged graph." .

crs:agp_AtlasByteCarrier_TaggedByteCarrier a prim:AncestralGroundingPath ;
    prim:ancestralSubtype crs:AtlasByteCarrier ;
    prim:ancestralAncestor crs:TaggedByteCarrier ;
    prim:ancestralViaTransport crs:rt_sub_AtlasByteCarrier_TaggedByteCarrier ;
    prim:ancestralLandsIn crs:carrier_TaggedByteCarrier ;
    rdfs:label "AtlasByteCarrier also-grounded-through TaggedByteCarrier" ;
    rdfs:comment "The materialised ancestral grounding path witnessing that crs:AtlasByteCarrier is ALSO grounded through its realized proper ancestor crs:TaggedByteCarrier (crs:AtlasByteCarrier rdfs:subClassOf+ crs:TaggedByteCarrier, both dual-grounded FormalType objects over the merged graph). crs:AtlasByteCarrier keeps its OWN direct grounding (its own reflexive carrier + prim:Realization + prim:Primitive) UNCHANGED; this ADDS the transported second grounding: prim:ancestralViaTransport crs:rt_sub_AtlasByteCarrier_TaggedByteCarrier is the rho-image of the taxonomic subtyping, and prim:ancestralLandsIn crs:carrier_TaggedByteCarrier = rho(crs:TaggedByteCarrier) is the ancestor's own realization carrier the transport's prim:transportCod resolves to exactly. SP1's q_ancestral_transport_resolves reads this pair as covered." .

crs:rt_sub_GraphByteCarrier_TaggedByteCarrier a prim:RealizationTransport ;
    prim:transportDom crs:carrier_GraphByteCarrier ;
    prim:transportCod crs:carrier_TaggedByteCarrier ;
    prim:isTransportIdentity false ;
    rdfs:label "rho(sub: GraphByteCarrier -> TaggedByteCarrier) = transport carrier_GraphByteCarrier -> carrier_TaggedByteCarrier" ;
    rdfs:comment "The rho-image of the taxonomic subtyping arrow crs:GraphByteCarrier rdfs:subClassOf+ crs:TaggedByteCarrier: a non-identity prim:RealizationTransport carrying rho(crs:GraphByteCarrier) = crs:carrier_GraphByteCarrier (prim:transportDom) up to rho(crs:TaggedByteCarrier) = crs:carrier_TaggedByteCarrier (prim:transportCod), prim:isTransportIdentity false. It is the transport crs:agp_GraphByteCarrier_TaggedByteCarrier resolves along so crs:GraphByteCarrier is grounded a SECOND way — transported into its realized ancestor crs:TaggedByteCarrier's carrier — in ADDITION to its own direct grounding, keeping SP1's q_ancestral_transport_resolves total over the merged graph." .

