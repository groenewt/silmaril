# =====================================================================================
# (17+5) crs:SubjectPredicatePlane — the (pi_S,pi_P) role-pair plane that drops the Object role (geometers.ttl T6).
# =====================================================================================
crs:SubjectPredicatePlane a prim:FormalType ;
    rdfs:subClassOf prim:FormalType ;
    prim:realizesAs crs:realize_SubjectPredicatePlane ;
    prim:rhoObject  crs:carrier_SubjectPredicatePlane ;
    prim:yonedaObject crs:repr_SubjectPredicatePlane .

crs:carrier_SubjectPredicatePlane a prim:PhysicalEncoding ;
    prim:bitWidth 8 ;
    prim:byteOrder prim:EndianNeutral ;
    prim:interpretAs crs:SubjectPredicatePlane ;
    rdfs:label "SubjectPredicatePlane carrier: octet-vector layout" ;
    rdfs:comment "The reflexive byte carrier of crs:SubjectPredicatePlane (the (pi_S,pi_P) role-pair plane that drops the Object role (geometers.ttl T6)): the octet-vector serialisation of the (Subject,Predicate) retained-role coordinates, prim:bitWidth 8 per octet occurrence, prim:byteOrder prim:EndianNeutral (the byte-vector granule carries no multi-unit endianness), prim:interpretAs crs:SubjectPredicatePlane so the physical yang closes back onto its own formal yin (SP1 q_colimit_reflexive). It descends from the SP1 octet-vector floor (design 2.2/2.3), the SP2 prim:StringUtf8ByteVector octet-vector idiom reused, never re-minted." .

crs:realize_SubjectPredicatePlane a prim:Realization ;
    prim:realizesFrom crs:SubjectPredicatePlane ;
    prim:encoding    crs:carrier_SubjectPredicatePlane ;
    prim:frameOutput crs:carrier_SubjectPredicatePlane ;
    prim:frameEffect prim:EncodingLoss ;
    rdfs:label "rho: SubjectPredicatePlane |-> octet-vector carrier (EncodingLoss)" ;
    rdfs:comment "The dual-grounding realization rho of crs:SubjectPredicatePlane (the (pi_S,pi_P) role-pair plane that drops the Object role (geometers.ttl T6)) — a Frame / Kleisli arrow of the SP1 realization monad gluing the class to its octet-vector carrier: prim:frameOutput crs:carrier_SubjectPredicatePlane (X, the physical byte layout) and prim:frameEffect prim:EncodingLoss (Y, a SELECTED member of SP1's closed prim:Effect family, never a new effect). It is the self arm SP1's prim:DualGroundingShape reads (prim:realizesFrom crs:SubjectPredicatePlane), the reused SP1 tooth Task T11 owes this coordinate-chart object." .

crs:prim_SubjectPredicatePlane a prim:Primitive ;
    prim:formalFacet   crs:SubjectPredicatePlane ;
    prim:physicalFacet crs:carrier_SubjectPredicatePlane ;
    prim:gluedBy       crs:realize_SubjectPredicatePlane ;
    rdfs:label "Primitive SubjectPredicatePlane (taiji: formal (+) octet-vector carrier)" ;
    rdfs:comment "The colimit-taiji primitive of crs:SubjectPredicatePlane (the (pi_S,pi_P) role-pair plane that drops the Object role (geometers.ttl T6)) binding its formal yin (prim:formalFacet crs:SubjectPredicatePlane) to its physical yang (prim:physicalFacet crs:carrier_SubjectPredicatePlane) by the realization rho (prim:gluedBy crs:realize_SubjectPredicatePlane), so the class is a genuine dual-grounded prim:Primitive over the merged floor, not a bare owl:Class, satisfying SP1's q_colimit_reflexive / q_colimit_universal." .

crs:repr_SubjectPredicatePlane a prim:RepresentablePresheaf , prim:OlogObject ;
    prim:representableOf crs:SubjectPredicatePlane ;
