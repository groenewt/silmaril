@prefix silm: <urn:silmaril:entity#> .
@prefix cco: <https://www.commoncoreontologies.org/> .
@prefix cceo: <https://www.commoncoreontologies.org/cpo#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

silm:synonymatom a owl:Class ;
    rdfs:label "SynonymAtom" ;
    rdfs:comment "An arrow asserting that a synonym term refers to the same concept as a source atom; populates the Synonyms Atlas column." .
