@prefix silm: <urn:silmaril:entity#> .
@prefix cco: <https://www.commoncoreontologies.org/> .
@prefix cceo: <https://www.commoncoreontologies.org/cpo#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

silm:coloratom a owl:Class ;
    rdfs:label "ColorAtom" ;
    rdfs:comment "A named color carrying a hex value, a semantic role tag, and a CCO Quality IRI for grounding diagrammatic and typographic color choices." .
