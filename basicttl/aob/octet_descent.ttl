    prim:ordinalMin 0 ; prim:ordinalMax 255 ;
    aob:octetPosition 5 ; aob:octetValue 82 .
aob:witnessDigestOctet06 a prim:Octet ;
    prim:ordinalMin 0 ; prim:ordinalMax 255 ;
    aob:octetPosition 6 ; aob:octetValue 73 .
aob:witnessDigestOctet07 a prim:Octet ;
