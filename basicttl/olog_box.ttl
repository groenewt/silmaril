@prefix silm: <urn:silmaril:entity#> .
@prefix cco: <https://www.commoncoreontologies.org/> .
@prefix cceo: <https://www.commoncoreontologies.org/cpo#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

silm:ologbox a owl:Class ;
    rdfs:label "OlogBox" ;
    rdfs:comment "Olog encapsulation per Spivak/Kent 2012 + the Wave-8 directive: draw the boundary that encapsulates each diagram/formula/lemma/theorem so the knowledge inside reality-tunnels across domains via the typed-leg interface alone." .
