    a owl:NamedIndividual ;
    rdfs:label "urn:silmaril:entity#instances.papers.03_silmaril_federation.chapters.06_crdt_gossip_convergence.sections.02_convergence_algebra.concrete_anchor.r1_join_r2" ;
    silm:hasLongDescription "The MorningAndAfternoonReadingsMerged is R_1 join R_2 is the merge of the morning replica (weight=3.8kg, about=Mittens) and the afternoon replica (temp=38.6C, about=Mittens). The merged state contains both readings. This is one grouping of the first two replicas before merging with the evening reading." .

silm:instances_papers_03_silmaril_federation_chapters_06_crdt_gossip_convergence_sections_02_convergence_algebra_concrete_anchor_r1r2_join_r3
    a owl:NamedIndividual ;
