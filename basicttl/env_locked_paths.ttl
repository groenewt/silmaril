@prefix silm: <urn:silmaril:entity#> .
@prefix cco: <https://www.commoncoreontologies.org/> .
@prefix cceo: <https://www.commoncoreontologies.org/cpo#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

silm:checkenvlockedpaths a owl:Class ;
    rdfs:label "CheckEnvLockedPaths" ;
    rdfs:comment "Every script, Elixir module, and template under the working tree must\nreference filesystem locations via ${SIL_*} env vars (or relative\nreferences through such roots). Bare /home/tristan paths and\n$(git rev-parse) shell-outs outside the env-bootstrap layer are\nviolations of the env-locking discipline.\n" .
