@prefix silm: <urn:silmaril:entity#> .
@prefix cco: <https://www.commoncoreontologies.org/> .
@prefix cceo: <https://www.commoncoreontologies.org/cpo#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

silm:checkatomanchorgrounding a owl:Class ;
    rdfs:label "CheckAtomAnchorGrounding" ;
    rdfs:comment "Every ConcreteAnchor instance must carry a cco_grounding_iri that resolves\nin ${SIL_CCO_TTL_DIR}; every YonedaHomLeg must carry a cpo_process_iri\nthat resolves in ${SIL_CPO_TTL_FILE}.\n" .
