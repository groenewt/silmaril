@prefix silm:  <urn:silmaril:entity#> .
@prefix cco:   <https://www.commoncoreontologies.org/> .
@prefix cceo:  <https://www.commoncoreontologies.org/cpo#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

# =============================================================================
# The concrete end-to-end v1 rebuild DAG as instances of dag_ontology.ttl.
# Base units S0, G, W1-W5, X; their phases; the doctrines, rulings, goals, and
# governing superpowers skills each binds to; and the dependsOn edges the
# schedule query reads. Every individual is typed against a domain class
# (never a bare owl:NamedIndividual) per the depth gate.
# =============================================================================

### ---- Doctrines -------------------------------------------------------------
silm:doctrine_praeriehund a owl:NamedIndividual, silm:Doctrine ;
    rdfs:label "Praeriehund doctrine" ;
    rdfs:comment "docs/praeriehund-demokratie-der-kategorien.md: name the unknown provisionally; declare partial functors partial; never force-fit, fabricate, or delete-rename-erase a coordinate without a byte-complete inverse. Inspectable, revisable, federated." .
silm:doctrine_unary_byte_frame_law a owl:NamedIndividual, silm:Doctrine ;
    rdfs:label "Unary Byte-Frame Law" ;
    rdfs:comment "docs/unary-byte-frame-law.md (+ enforcement-proof, receipts): F(x) -> Frame(output, error|effect); S/O/P as nth-dim URN towers; full lexical identity; physical byte descent; ContractGate external admission; Continue/Complete scheduler." .

### ---- Rulings ---------------------------------------------------------------
silm:ruling_file_axis_taxonomy a owl:NamedIndividual, silm:Ruling ;
    rdfs:label "File axis = virtual taxonomy + full projection packet" .
silm:ruling_ndim_crs a owl:NamedIndividual, silm:Ruling ;
    rdfs:label "N-dimensional CRS law realized as S/O/P towers" .
silm:ruling_fable_dissolve a owl:NamedIndividual, silm:Ruling ;
    rdfs:label "Fable dissolve-and-absorb" .
silm:ruling_depth_gate a owl:NamedIndividual, silm:Ruling ;
    rdfs:label "Aggressive depth gate with absolute remediation" .

# ---- W2 brainstorming rulings (design_constraints.md Directives 1-13, 2026-08-07) ----
silm:ruling_corpus_agnostic_iteration a owl:NamedIndividual, silm:Ruling ;
    rdfs:label "W2 = corpus-agnostic ontology shape + basicttl depth remediation; no new-corpus binding (that is the re-runnable W5); this iteration is a v1 to be fundamentally challenged and relaunched" .
silm:ruling_dual_grounding_floor a owl:NamedIndividual, silm:Ruling ;
    rdfs:label "Subatomic dual-grounding: every primitive is BOTH its formal type-tower (real/natural/imaginary ...) AND its physical bit/byte reality through the ISA/UEFI lens ('what is a number'); the base unit remains bit- and byte-vectors" .
silm:ruling_colimit_taiji_monadic a owl:NamedIndividual, silm:Ruling ;
    rdfs:label "The AOB primitive is literally a colimit taiji of twin ologs (formal <-> physical) whose realization functor is monadic (Kleisli) and IS the unary law's Frame(output, effect)" .
silm:ruling_aob_sauce_glossary_polysemy a owl:NamedIndividual, silm:Ruling ;
    rdfs:label "Ground the AOB in the real base_agents WIP AOB; hold structured AND unstructured types as synonyms AND antonyms through the mole of glossaries, each encapsulating a distinct epistemology (OSSIE mime the arbiter)" .
silm:ruling_unary_grammar_jepa_twin a owl:NamedIndividual, silm:Ruling ;
    rdfs:label "Leave first-class room for the unary grammar + bit/byte/colour vectors (the JEPA data-engineering substrate) and realize the agents/telephone twin as a tighter Yoneda realization of ologs-of-ologs" .

### ---- Goals -----------------------------------------------------------------
silm:goal_corpus_bound_morph a owl:NamedIndividual, silm:Goal ;
    rdfs:label "Corpus bound/morph into definitive v1 AOB buildout" .
silm:goal_render_everything a owl:NamedIndividual, silm:Goal ;
    rdfs:label "Render everything, subatomic per format, via sparky substrate" .
silm:goal_unary_planning a owl:NamedIndividual, silm:Goal ;
    rdfs:label "Superpowers planning + strict unary refactor of all violators" .
silm:goal_cicd_engine a owl:NamedIndividual, silm:Goal ;
    rdfs:label "Engine-agnostic CI/CD architecture as its own goal" .

