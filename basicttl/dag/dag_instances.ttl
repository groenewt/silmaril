### ---- Key artifacts (the Interfaces payload; edges induced by these) --------
silm:artifact_superpowers_os a owl:NamedIndividual, silm:Artifact ; rdfs:label "external/skills/superpowers submodule" .
silm:artifact_dag_ontology a owl:NamedIndividual, silm:Artifact ; rdfs:label "basicttl/dag/* (this DAG authored as ontology)" .
silm:artifact_taxonomy_census a owl:NamedIndividual, silm:Artifact ; rdfs:label "Full-capture taxonomy census + Complete Component Account seed" .
silm:artifact_primitive_floor a owl:NamedIndividual, silm:Artifact ; rdfs:label "basicttl/primitives/* — the twin-olog colimit-taiji Primitive Floor (formal type-towers <-> physical bit/byte/ISA-UEFI carriers + Frame-monad realization); W2 sub-project 1" .
silm:artifact_aob_meta_ontology a owl:NamedIndividual, silm:Artifact ; rdfs:label "AOB meta-ontology + projection packet + CRS/S-O-P-tower law + format taxonomy + glossary polysemy" .
silm:artifact_render_pipelines a owl:NamedIndividual, silm:Artifact ; rdfs:label "GeoSPARQL render pipelines + Split/Consolidated seal (artifact-free branch)" .
silm:artifact_cicd_engine a owl:NamedIndividual, silm:Artifact ; rdfs:label "Multi-engine gated CI/CD (rdflib/Jena/SIS/Sedona), blocking gates" .
silm:artifact_v1_buildout a owl:NamedIndividual, silm:Artifact ; rdfs:label "Definitive v1 AOB buildout (all 11 projections, reversible)" .
silm:artifact_unary_green a owl:NamedIndividual, silm:Artifact ; rdfs:label "All callables satisfy the 10-point Source Discipline (RED->GREEN)" .

### ---- The graph ------------------------------------------------------------
silm:dag_v1 a owl:NamedIndividual, silm:DirectedAcyclicGraph ;
    rdfs:label "Silmaril v1 rebuild DAG" ;
    rdfs:comment "The extinction-event rebuild: the RED enforcement is wiped and the GREEN v1 emerges as the ontology satisfies its own law." ;
    silm:hasWorkflow silm:wf_s0, silm:wf_g, silm:wf_w1, silm:wf_w2, silm:wf_w3, silm:wf_w4, silm:wf_w5, silm:wf_x .

### ---- Workflows ------------------------------------------------------------

silm:wf_s0 a owl:NamedIndividual, silm:Workflow ;
    rdfs:label "S0 — Install superpowers as the external skills OS" ;
    silm:hasStatus "completed" ;
    silm:hasOrdinal 0 ;
    silm:governedBySkill silm:skill_using_superpowers, silm:skill_writing_skills ;
    silm:honorsDoctrine silm:doctrine_praeriehund, silm:doctrine_unary_byte_frame_law ;
    silm:realizesGoal silm:goal_unary_planning ;
    silm:producesArtifact silm:artifact_superpowers_os ;
    silm:hasPhase silm:phase_s0_1, silm:phase_s0_2, silm:phase_s0_3 .

silm:wf_g a owl:NamedIndividual, silm:Workflow ;
    rdfs:label "G — Genesis: the DAG is ontology" ;
    silm:hasStatus "completed" ;
    silm:hasOrdinal 1 ;
    silm:dependsOn silm:wf_s0 ;
    silm:governedBySkill silm:skill_brainstorming, silm:skill_writing_plans, silm:skill_verification_before_completion ;
    silm:honorsDoctrine silm:doctrine_praeriehund, silm:doctrine_unary_byte_frame_law ;
    silm:honorsRuling silm:ruling_ndim_crs ;
    silm:realizesGoal silm:goal_unary_planning ;
    silm:consumesArtifact silm:artifact_superpowers_os ;
    silm:producesArtifact silm:artifact_dag_ontology ;
    silm:hasPhase silm:phase_g_1, silm:phase_g_2, silm:phase_g_3, silm:phase_g_4 .

silm:wf_w1 a owl:NamedIndividual, silm:Workflow ;
    rdfs:label "W1 — Discovery & full-capture taxonomy mapping" ;
    silm:hasStatus "completed" ;
    silm:hasOrdinal 2 ;
    silm:hasAgentBudget 1000 ;
    silm:dependsOn silm:wf_g ;
    silm:governedBySkill silm:skill_dispatching_parallel_agents, silm:skill_using_git_worktrees, silm:skill_subagent_driven_development ;
    silm:honorsDoctrine silm:doctrine_praeriehund, silm:doctrine_unary_byte_frame_law ;
    silm:honorsRuling silm:ruling_file_axis_taxonomy ;
    silm:realizesGoal silm:goal_corpus_bound_morph ;
    silm:consumesArtifact silm:artifact_dag_ontology ;
    silm:producesArtifact silm:artifact_taxonomy_census ;
    silm:hasPhase silm:phase_w1_1, silm:phase_w1_2, silm:phase_w1_3, silm:phase_w1_4, silm:phase_w1_5, silm:phase_w1_6, silm:phase_w1_7, silm:phase_w1_8, silm:phase_w1_9, silm:phase_w1_10 .

