    rdfs:label "W2 — Ontology design (taxonomy x AOB x projection-packet x S/O/P-tower CRS)" ;
    silm:hasOrdinal 3 ;
    silm:hasStatus "in-progress" ;
    silm:hasAgentBudget 1000 ;
