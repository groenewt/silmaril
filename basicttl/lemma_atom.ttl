@prefix silm: <urn:silmaril:entity#> .
@prefix cco: <https://www.commoncoreontologies.org/> .
@prefix cceo: <https://www.commoncoreontologies.org/cpo#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

silm:lemmaatom a owl:Class ;
    rdfs:label "LemmaAtom" ;
    rdfs:comment "A named lemma carried as a paper atom, holding hypothesis, conclusion, and a comma-joined list of dependency URNs (see-also folded as register tag)." .
