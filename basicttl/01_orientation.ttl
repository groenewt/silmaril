    rdfs:label "LedgerRowAnchorWitnessPathAddlPaperKind" ;
    rdfs:label "urn:silmaril:entity#instances.papers.01_orientation.chapters.15_witness_traceability.sections.03_ledger_row_anatomy.concrete_anchor_1#cannon_cat_joy_of_cats.md" ;
    silm:hasAdditionalAttribute "base_topic:free monad" ;
