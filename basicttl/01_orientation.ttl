    a owl:NamedIndividual ;
    rdfs:label "NegativeWitnessAnchorRowTwoEmptyGapCellsAddlBaseTopic" ;
    rdfs:label "NegativeWitnessAnchorRowTwoEmptyGapCellsAddlCircuitCorner" ;
    rdfs:label "NegativeWitnessAnchorRowTwoEmptyGapCellsAddlDunbarLayer" ;
    rdfs:label "NegativeWitnessAnchorRowTwoEmptyGapCellsAddlPaperKind" ;
    rdfs:label "urn:silmaril:entity#instances.papers.01_orientation.chapters.15_witness_traceability.sections.04_negative_witnesses.concrete_anchor_5#geometricgapforrefusedshortcut" ;
