silm:instances_papers_01_orientation_chapters_14_kleisli_enrichment_pipeline_sections_01_kleisli_category_overview_concrete_anchor_3%23witnessafterkleislicite
    a owl:NamedIndividual ;
    rdfs:label "KleisliOverviewAnchorWitnessAddlBaseTopic" ;
    rdfs:label "KleisliOverviewAnchorWitnessAddlCircuitCorner" ;
    rdfs:label "KleisliOverviewAnchorWitnessAddlDunbarLayer" ;
    rdfs:label "KleisliOverviewAnchorWitnessAddlPaperKind" ;
    rdfs:label "urn:silmaril:entity#instances.papers.01_orientation.chapters.14_kleisli_enrichment_pipeline.sections.01_kleisli_category_overview.concrete_anchor_3#witnessafterkleislicite" ;
