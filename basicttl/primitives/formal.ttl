# ------------------------------------------------------------------------------------
# IdentityArrows — the reflexive unit at every object (60, incl the FormalType root)
# ------------------------------------------------------------------------------------
prim:id_Bag a prim:IdentityArrow ; prim:arrowDom prim:Bag ; prim:arrowCod prim:Bag ;
    rdfs:label "id_Bag" ;
    rdfs:comment "The identity morphism id_Bag at object prim:Bag: prim:arrowDom = prim:arrowCod = prim:Bag, the unit of arrow composition at this object and the unique member of Hom(prim:Bag, prim:Bag) in the thin category. It is the reflexive Yoneda point of the representable presheaf Hom(-, prim:Bag)." .
prim:id_Bignum a prim:IdentityArrow ; prim:arrowDom prim:Bignum ; prim:arrowCod prim:Bignum ;
    rdfs:label "id_Bignum" ;
