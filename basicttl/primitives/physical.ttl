@prefix prim: <urn:silmaril:prim:#> .
@prefix silm: <urn:silmaril:entity#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

# =====================================================================================
# physical.ttl — the PHYSICAL olog of the Primitive Floor (W2 · SP1, plan Task 3).
# =====================================================================================
# The yang facet of the twin-olog colimit taiji: the byte-stream carrier closure plus
# the ISA/UEFI machine types, representation facets, text encodings, and the RGB colour
# code space. The carrier ladder Bit → Nibble → Octet → ByteVector → Word → Block →
# Stream → Container descends by prim:byteDescendsTo to the width-1 prim:Bit floor.
# Every prim:PhysicalEncoding declares prim:bitWidth, prim:byteWidth, prim:byteOrder and
# the mutual-colimit back-pointer prim:interpretAs to the FormalType it realizes; that
# back-pointer is how yang holds yin, closing the round-trip seal (q_colimit_roundtrip).
# Byte ≠ Octet (unary law); ByteVector width is 1..128. Corpus-agnostic: pure shape.
#
# Design spec: docs/superpowers/specs/2026-08-07-w2-primitive-floor-design.md (§4)
# Plan:        docs/superpowers/plans/2026-08-07-w2-sp1-primitive-floor.md (Task 3)
# Formal olog (interpretAs targets): basicttl/primitives/formal.ttl
# Acceptance:  q_bytevector_cap, q_byte_descent, q_rgb GREEN; q_colimit_roundtrip stays GREEN.
# =====================================================================================


# =====================================================================================
# Properties introduced by the physical olog
# =====================================================================================

prim:byteDescendsTo a owl:ObjectProperty ;
    rdfs:label "byteDescendsTo" ;
    rdfs:domain prim:PhysicalCarrier ;
    rdfs:range prim:PhysicalCarrier ;
    rdfs:comment "The physical descent edge of the carrier ladder: a source carrier is composed of, and therefore descends to, a narrower carrier, transitively bottoming at prim:Bit. Byte-descent is the Kleisli composition of carriers down to the width-1 floor; the acceptance ASK q_byte_descent asserts prim:ByteVector prim:byteDescendsTo+ prim:Bit." .

prim:interpretAs a owl:ObjectProperty ;
    rdfs:label "interpretAs" ;
    rdfs:domain prim:PhysicalEncoding ;
    rdfs:range prim:FormalType ;
    rdfs:comment "The mutual-colimit back-pointer: from a physical encoding to the FormalType it realizes, so yang (physical) holds yin (formal) and the round-trip physical → interpretAs → formal closes. Every PhysicalEncoding MUST carry exactly this back-pointer; an encoding with no interpretAs is a dangling carrier the SHACL law and q_colimit_roundtrip reject." .

prim:byteOrder a owl:ObjectProperty ;
    rdfs:label "byteOrder" ;
    rdfs:domain prim:PhysicalEncoding ;
    rdfs:range prim:ByteOrder ;
    rdfs:comment "The endianness facet of a physical encoding: the order in which constituent octets serialize (prim:LE / prim:BE), or prim:EndianNeutral for single-octet and sub-octet encodings where ordering is not applicable. An independent coordinate from bit width per the unary law; mixed/PDP-endian is deferred (spec §8)." .

prim:signedness a owl:ObjectProperty ;
    rdfs:label "signedness" ;
    rdfs:domain prim:PhysicalEncoding ;
    rdfs:range prim:Signedness ;
    rdfs:comment "The signedness facet of an integer encoding: prim:Signed (domain straddles zero, interpreting as prim:Integer) or prim:Unsigned (non-negative domain, interpreting as prim:Natural). Orthogonal to width and byte-order; it fixes the ordinal floor of the encoding and selects which number-tower formal type the encoding interprets as." .

prim:integerRepresentation a owl:ObjectProperty ;
    rdfs:label "integerRepresentation" ;
    rdfs:domain prim:PhysicalEncoding ;
    rdfs:range prim:IntegerRepresentation ;
    rdfs:comment "The negative-value scheme of a signed integer encoding: prim:TwosComplement, prim:OnesComplement, or prim:SignMagnitude. This floor's INT8..128 encodings use two's-complement; the alternatives are modelled so historical and exotic encodings can be interpreted without a force-fit (Präriehund honesty)." .

prim:ieee754Field a owl:ObjectProperty ;
    rdfs:label "ieee754Field" ;
    rdfs:domain prim:PhysicalEncoding ;
    rdfs:range prim:IEEE754Field ;
    rdfs:comment "Relates a floating-point encoding to the IEEE-754 structural fields it partitions its bits into: prim:IEEE754Sign, prim:IEEE754Exponent, prim:IEEE754Mantissa. The exponent and mantissa widths of these fields are what distinguish half, single, double, x87 double-extended, and quad precision." .

prim:hasChannel a owl:ObjectProperty ;
    rdfs:label "hasChannel" ;
    rdfs:domain prim:ColourSpace ;
    rdfs:range prim:Octet ;
    rdfs:comment "Relates a colour code space to its component channels, each an octet-valued carrier. For prim:RGB the channels are exactly prim:Red, prim:Green, prim:Blue, each one prim:Octet of cardinality 256 and ordinal range 0..255 — the JEPA colour substrate grounding colour into the physical byte carrier." .

prim:bitWidth a owl:DatatypeProperty ;
    rdfs:label "bitWidth" ;
    rdfs:domain prim:PhysicalEncoding ;
    rdfs:range xsd:integer ;
    rdfs:comment "The number of bits one occurrence of a physical encoding occupies. Bounded by the unary-law ByteVector ceiling; the acceptance ASK q_bytevector_cap rejects any encoding whose bitWidth exceeds the 1024-bit vector cap. Distinct from stream ordinal, block start/end/length, which count byte occurrences, not bits." .

prim:byteWidth a owl:DatatypeProperty ;
    rdfs:label "byteWidth" ;
    rdfs:domain prim:PhysicalEncoding ;
    rdfs:range xsd:integer ;
    rdfs:comment "The number of whole octets one occurrence of a physical encoding occupies (bitWidth divided by eight for octet-aligned encodings). For variable-width text encodings this records the maximum occurrence width. Byte width is a cardinality distinct from the 1..128 bit-width bound of a single byte occurrence." .

prim:ordinalMin a owl:DatatypeProperty ;
    rdfs:label "ordinalMin" ;
    rdfs:domain prim:Octet ;
    rdfs:range xsd:integer ;
    rdfs:comment "The inclusive lower bound of the ordinal value range of an octet-valued carrier occurrence — 0 for an unsigned octet channel. The ordinal (0..255) is a distinct coordinate from the octet's cardinality (256) and from bit width, per the unary law's three-coordinate distinction." .

prim:ordinalMax a owl:DatatypeProperty ;
    rdfs:label "ordinalMax" ;
    rdfs:domain prim:Octet ;
    rdfs:range xsd:integer ;
    rdfs:comment "The inclusive upper bound of the ordinal value range of an octet-valued carrier occurrence — 255 for an unsigned octet channel, whose code space has cardinality 256. Ordinal 255, count 256, and bit width 128 remain three navigable coordinates that must never be collapsed into one another." .

prim:uefiName a owl:DatatypeProperty ;
    rdfs:label "uefiName" ;
    rdfs:domain prim:PhysicalEncoding ;
    rdfs:range xsd:string ;
    rdfs:comment "The exact-width UEFI/EDK2 spelling for a machine-type encoding (for example UINT32, INT8, CHAR16, BOOLEAN), recorded as immutable external evidence of the exact-width naming precedent. The literal no-UEFI-exact-name marks widths and formats the UEFI core does not name (128-bit integers, IEEE-754 floats)." .

prim:ieee754 a owl:DatatypeProperty ;
    rdfs:label "ieee754" ;
    rdfs:domain prim:PhysicalEncoding ;
    rdfs:range xsd:boolean ;
    rdfs:comment "True for a floating-point encoding that follows the IEEE-754 binary interchange (or x87 double-extended) format, marking that its bit layout is the sign/exponent/mantissa partition and that its realization Frame carries an IEEE754-rounding effect. Non-IEEE float formats are deferred this iteration (spec §8)." .

prim:byteCount a owl:DatatypeProperty ;
    rdfs:label "byteCount" ;
    rdfs:domain prim:PhysicalEncoding ;
    rdfs:range xsd:integer ;
    rdfs:comment "The number of whole byte occurrences a variable-length ByteVector-family encoding may span — the SECOND, independent width cap of the two-cap model (spec §9c): fixed-width scalar encodings are ceilinged by prim:bitWidth ≤ 128, whereas a ByteVector encoding is ceilinged by prim:byteCount ≤ 128 (= up to 1024 bits). byteCount counts byte OCCURRENCES in the ordered vector, a cardinality distinct from prim:bitWidth (which records the per-occurrence granule width, 8 for an octet-granular ByteVector). A Bignum, Blob, or Hash realizes into such a vector; the 129th byte occurrence is the enforced overflow the ByteVectorEncodingShape rejects." .

prim:alignment a owl:DatatypeProperty ;
    rdfs:label "alignment" ;
    rdfs:domain prim:PhysicalEncoding ;
    rdfs:range xsd:integer ;
    rdfs:comment "The memory-alignment facet of a physical encoding (spec §9g): the byte boundary a whole occurrence must start on (1, 2, 4, 8, …), typically the width of the widest scalar component of a composite/product encoding. Alignment is an independent coordinate from prim:bitWidth and prim:byteOrder — two encodings of equal width may demand different alignment — and together with prim:padding it fixes the exact in-memory footprint of a Product encoding whose components would otherwise straddle a natural boundary." .

prim:padding a owl:DatatypeProperty ;
    rdfs:label "padding" ;
    rdfs:domain prim:PhysicalEncoding ;
    rdfs:range xsd:integer ;
    rdfs:comment "The padding facet of a physical encoding (spec §9g): the number of unused filler bytes inserted between or after a composite/product encoding's components so each component lands on its required prim:alignment boundary. Padding bytes carry no value; they are the honest cost of alignment, distinct from the payload width recorded by prim:bitWidth. A tightly packed encoding declares prim:padding 0; a naturally aligned Product may declare a non-zero pad." .

prim:exponentBits a owl:DatatypeProperty ;
    rdfs:label "exponentBits" ;
    rdfs:domain prim:PhysicalEncoding ;
    rdfs:range xsd:integer ;
    rdfs:comment "The width in bits of the IEEE-754 biased-exponent field (prim:IEEE754Exponent) of a floating-point encoding — the per-format breakdown spec §9g asks for: half=5, single=8, double=11, x87 double-extended=15, quad=15. The exponent width sets the encoding's dynamic range; together with prim:mantissaBits and the single implicit sign bit it accounts for every bit of the format (1 + exponentBits + mantissaBits = bitWidth, with the x87 explicit-integer-bit exception noted on Float80)." .

prim:mantissaBits a owl:DatatypeProperty ;
    rdfs:label "mantissaBits" ;
    rdfs:domain prim:PhysicalEncoding ;
    rdfs:range xsd:integer ;
    rdfs:comment "The width in bits of the IEEE-754 significand/mantissa field (prim:IEEE754Mantissa) of a floating-point encoding — the per-format breakdown spec §9g asks for: half=10, single=23, double=52, x87 double-extended=64 (explicit integer bit included), quad=112. The mantissa width sets the encoding's precision; with prim:exponentBits and the sign bit it partitions the whole float, and it is why a Float32 narrowed from a Float64 source loses low-order mantissa bits (the prim:NarrowingLoss effect)." .


# =====================================================================================
# The physical carrier ladder — owl:Class tower, Bit floor to Container top
# =====================================================================================

prim:PhysicalCarrier a owl:Class ;
    rdfs:label "PhysicalCarrier" ;
    rdfs:comment "The yang facet of the twin-olog colimit taiji: a physical byte-stream carrier considered independently of the mathematical meaning it carries. PhysicalCarriers form the descent ladder Bit → Nibble → Octet → ByteVector → Word → Block → Stream → Container, related by prim:byteDescendsTo, every rung of which bottoms out at the width-1 prim:Bit floor. Each carrier is the physical home into which a formal type is realized; the mutual back-pointer prim:interpretAs closes the colimit from encoding back to its formal type, so yang holds yin." .

prim:Bit a owl:Class ; rdfs:subClassOf prim:PhysicalCarrier ;
    rdfs:label "Bit" ;
    rdfs:comment "The width-1 floor of the physical carrier ladder: a single binary digit taking exactly one of two values, the eigenvalue trust root of the byte-frame law from which every wider carrier is composed. Bit carries no byte-order (a single bit has no multi-unit ordering) and is the terminal target of prim:byteDescendsTo — no carrier descends below it. Bit and Byte deliberately do not inherit from one another (unary law): a Byte is a composite of Bits, not a kind of Bit, and the bit/schema bootstrap is a constructor-free initial algebra rather than a hidden ancestry cycle." .

prim:Nibble a owl:Class ; rdfs:subClassOf prim:PhysicalCarrier ;
    rdfs:label "Nibble" ;
    rdfs:comment "A 4-bit carrier — half an octet, the unit that addresses a single hexadecimal digit (ordinal 0..15) and the natural rung between Bit and Octet on the descent ladder. A Nibble byteDescendsTo Bit (it is composed of four bits) and is itself the descent target of Octet (an octet is two nibbles). It is a convenience carrier for the hex-oriented interpretation of opaque Blob content; below the octet boundary it carries no independent byte-order because ordering only becomes meaningful across whole octets." .

prim:Octet a owl:Class ; rdfs:subClassOf prim:PhysicalCarrier ;
    rdfs:label "Octet" ;
    rdfs:comment "An exactly-8-bit carrier and the unit of the 256-cardinality byte and colour code space: an Octet takes ordinal values 0..255 (cardinality 256). It is kept strictly distinct from prim:Byte, which this floor models as a possibly-non-8-bit addressable unit — Byte ≠ Octet, per the unary law. Octets compose into a prim:ByteVector and byteDescendsTo Nibble then Bit; the colour channels Red/Green/Blue are each exactly one Octet, and the atom z-coordinate is the uint16 of a source digest's first two Octets. Count 256, ordinal 255 and bit width 128 remain three distinct coordinates." .

prim:Byte a owl:Class ; rdfs:subClassOf prim:PhysicalCarrier ;
    rdfs:label "Byte" ;
    rdfs:comment "The addressable-unit carrier — the smallest independently addressable storage cell of a machine, which the unary law refuses to hardwire to eight bits: Byte ≠ Octet. On virtually all modern hardware a Byte is an Octet, but historical and DSP architectures use 6-, 7-, 9-, or wider byte cells, so this floor keeps Byte as its own carrier that byteDescendsTo Bit without asserting a fixed width. When a Byte is known to be eight bits it is realized as an Octet; that identification is a typed relation between two carriers, not a definitional collapse of one into the other." .

prim:ByteVector a owl:Class ; rdfs:subClassOf prim:PhysicalCarrier ;
    rdfs:label "ByteVector" ;
    rdfs:comment "The bounded ordered byte-vector carrier — a sequence of 1..128 byte occurrences, the unary-law cap that ceilings every registered physical encoding (a single scalar encoding stays ≤128 bits, and no vector may exceed 128 byte occurrences). ByteVector is the ordered algebraic carrier with schema-qualified Empty and Link alternatives, a Link carrying one admitted head byte and a tail of the same schema. A Bignum realizes into it, meeting an unbounded mathematical value with a bounded physical carrier — exactly the may-overflow effect. It byteDescendsTo Octet → Nibble → Bit, closing to the floor." .

prim:Word a owl:Class ; rdfs:subClassOf prim:PhysicalCarrier ;
    rdfs:label "Word" ;
    rdfs:comment "A machine word carrier — a fixed group of octets sized to the host architecture's natural register width (16, 32, or 64 bits), the unit of aligned arithmetic and addressing. Word byteDescendsTo Octet: it is a composite of octets whose count is the architecture's word size, and its byte-order (little- or big-endian) is the load-bearing facet governing how its constituent octets serialize on the wire and in memory. It sits above ByteVector-scale addressing and below Block-scale organization on the carrier ladder." .

prim:Block a owl:Class ; rdfs:subClassOf prim:PhysicalCarrier ;
    rdfs:label "Block" ;
    rdfs:comment "A block carrier — a bounded, complete or explicitly-incomplete span over one stable stream revision, the organizational unit above the raw ByteVector. A Block is not identified by a bare offset or a host slice (unary law): it carries explicit start, end, and length coordinates counted in byte occurrences, cardinalities that use their own non-negative generation-sized carriers distinct from the 1..128 bit-width bound. Block byteDescendsTo ByteVector and aggregates upward into a Stream; it is where bounded reads and framing decisions physically attach." .

prim:Stream a owl:Class ; rdfs:subClassOf prim:PhysicalCarrier ;
    rdfs:label "Stream" ;
    rdfs:comment "A stream carrier — an ordered, potentially unbounded sequence of schema-qualified byte occurrences, the layer above Block on the carrier ladder. A Stream supplies the ordering that Blocks bound and that Containers organize; its ordinal, block-start, block-end, and block-length coordinates are non-negative generation-sized carriers separate from the bit-width carrier, and remain valid at Avogadro-scale partition counts. Stream byteDescendsTo Block and is the physical substrate a String, RDFGraph, or serialized value is laid into." .

prim:Container a owl:Class ; rdfs:subClassOf prim:PhysicalCarrier ;
    rdfs:label "Container" ;
    rdfs:comment "A container carrier — an admitted organization of one or more Blocks (or Streams) with explicit schema and boundary evidence, the top rung of the physical carrier ladder. A Container is where a file, archive, or message envelope lives: it groups lower carriers under one boundary and schema so their bytes can be navigated as a whole. Container byteDescendsTo Stream, and through the transitive descent chain every Container ultimately bottoms out at the prim:Bit floor, so no carrier organization escapes the byte substrate." .

# ---- Composite / Product carrier kind (reusable; spec §9g, plan Task R1) -------------
#      The reusable physical home for pairs, tuples, and every categorical product. Per-type
#      Product encodings (Rational num·den, Complex re·im, Interval start·end, Quantity
#      magnitude·unit, Measurement value·uncertainty, DateTime epoch·tz, the Frame output·effect,
#      the general TupleConcat) reference THIS carrier kind rather than re-deriving the notion of
#      "several heterogeneous components laid contiguously". It is authored here as a shared piece,
#      not a per-type encoding.
prim:CompositeCarrier a owl:Class ; rdfs:subClassOf prim:PhysicalCarrier ;
    rdfs:label "CompositeCarrier (Product / composite physical carrier)" ;
    rdfs:comment "The composite/product physical carrier — a fixed-arity, heterogeneous, ordered concatenation of component carriers laid out contiguously, the reusable physical home of the Aggregate-tower Tuple and of every categorical product this floor realizes: a Rational's numerator·denominator pair, a Complex's real·imaginary pair, an Interval's start·end pair, a Quantity's magnitude·unit pair, a Measurement's value·uncertainty pair, a zoned DateTime's epoch·offset pair, and the unary law's Frame output·effect product. It is a subclass of prim:PhysicalCarrier but deliberately NOT of prim:ByteVector: a ByteVector is a homogeneous variable-length run of equal-schema byte occurrences counted by prim:byteCount, whereas a CompositeCarrier's components may each be a different width, encoding, and byte-order, so its arity — part of its identity — is fixed and carries no length prefix. Because heterogeneous components would otherwise straddle natural boundaries, its exact in-memory footprint is fixed by the prim:alignment and prim:padding facets that pack each component onto its required boundary. It byteDescendsTo prim:Octet and thence transitively to the width-1 prim:Bit floor, so no product escapes the byte substrate; the mutual-colimit back-pointer prim:interpretAs on a Product encoding over this carrier still closes the round-trip to the formal product type it realizes." .

# ---- The byte-descent ladder edges (byteDescendsTo+ reaches Bit) ---------------------
prim:Nibble          prim:byteDescendsTo prim:Bit .
prim:Octet           prim:byteDescendsTo prim:Nibble .
prim:Byte            prim:byteDescendsTo prim:Bit .
prim:ByteVector      prim:byteDescendsTo prim:Octet .
prim:Word            prim:byteDescendsTo prim:Octet .
prim:Block           prim:byteDescendsTo prim:ByteVector .
prim:Stream          prim:byteDescendsTo prim:Block .
prim:Container       prim:byteDescendsTo prim:Stream .
prim:CompositeCarrier prim:byteDescendsTo prim:Octet .


# =====================================================================================
# Representation facet families (owl:Class) + their individuals
# =====================================================================================

prim:ByteOrder a owl:Class ;
    rdfs:label "ByteOrder" ;
    rdfs:comment "The byte-order (endianness) facet family — the ordering in which the constituent octets of a multi-octet encoding are laid down in memory or on the wire. Its individuals are prim:LE (little-endian, least-significant octet first), prim:BE (big-endian, most-significant octet first), and prim:EndianNeutral (single-octet or sub-octet encodings, for which ordering is not applicable). Mixed / PDP-endian orderings are deliberately deferred this iteration (spec §8, YAGNI) and named here rather than silently dropped." .

prim:LE a prim:ByteOrder ; rdfs:label "LittleEndian (least-significant octet first)" .
prim:BE a prim:ByteOrder ; rdfs:label "BigEndian (most-significant octet first)" .
prim:EndianNeutral a prim:ByteOrder ; rdfs:label "EndianNeutral (single-octet / sub-octet; ordering not applicable)" .

prim:Signedness a owl:Class ;
    rdfs:label "Signedness" ;
    rdfs:comment "The signedness facet family — whether an integer encoding admits negative values. Its individuals are prim:Signed (the value domain straddles zero, using one of the integer-representation schemes) and prim:Unsigned (the value domain is non-negative, 0..2ⁿ−1). Signedness is orthogonal to width and to byte-order: it selects which formal number type an integer encoding interprets as — signed widths back prim:Integer, unsigned widths back prim:Natural — and it fixes the ordinal floor of the encoding." .

prim:Signed a prim:Signedness ; rdfs:label "Signed (domain straddles zero → prim:Integer)" .
prim:Unsigned a prim:Signedness ; rdfs:label "Unsigned (non-negative domain → prim:Natural)" .

prim:IntegerRepresentation a owl:Class ;
    rdfs:label "IntegerRepresentation" ;
    rdfs:comment "The integer-representation facet family — how a signed integer encoding maps bit patterns to negative values. Its individuals are prim:TwosComplement (the ubiquitous modern scheme, a single zero and an asymmetric range), prim:OnesComplement (bitwise negation, carrying a negative zero), and prim:SignMagnitude (a dedicated sign bit plus magnitude, also with a negative zero). This floor's INT8..128 encodings use two's-complement; the alternatives are modelled so historical and exotic encodings can be interpreted without a force-fit." .

prim:TwosComplement a prim:IntegerRepresentation ; rdfs:label "Two's complement (single zero, asymmetric range)" .
prim:OnesComplement a prim:IntegerRepresentation ; rdfs:label "One's complement (negative zero)" .
prim:SignMagnitude a prim:IntegerRepresentation ; rdfs:label "Sign-magnitude (sign bit + magnitude, negative zero)" .

prim:IEEE754Field a owl:Class ;
    rdfs:label "IEEE754Field" ;
    rdfs:comment "The IEEE-754 field family — the three structural fields into which a floating-point encoding partitions its bits: prim:IEEE754Sign (one bit selecting the ± sign), prim:IEEE754Exponent (a biased exponent field whose width sets the dynamic range), and prim:IEEE754Mantissa (the significand/fraction field whose width sets the precision). Every Float16/32/64/80/128 encoding is composed of exactly these three fields; their exponent and mantissa widths are what distinguish half, single, double, x87 double-extended, and quad precision." .

prim:IEEE754Sign a prim:IEEE754Field ; rdfs:label "IEEE-754 sign bit" .
prim:IEEE754Exponent a prim:IEEE754Field ; rdfs:label "IEEE-754 biased exponent field" .
prim:IEEE754Mantissa a prim:IEEE754Field ; rdfs:label "IEEE-754 significand/mantissa field" .


# =====================================================================================
# The physical-encoding supertype — owl:Class, sibling of prim:PhysicalCarrier
# =====================================================================================

prim:PhysicalEncoding a owl:Class ;
    rdfs:label "PhysicalEncoding" ;
    rdfs:comment "The interpretation facet of the twin-olog colimit taiji, sibling to prim:PhysicalCarrier: a concrete bit-layout scheme that fixes how a span of bits over a carrier is read as a value. Its individuals are the ISA/UEFI machine types (BOOLEAN, UINT8..128, INT8..128, CHAR8/16, Float16/32/64/80/128) and the text encodings (ASCII, Latin-1, UTF-8/16/32) — the concrete formats into which a formal type is realized. Where PhysicalCarrier answers 'how wide is the cell', PhysicalEncoding answers 'how are those bits to be read'. Every PhysicalEncoding declares prim:bitWidth, prim:byteWidth and prim:byteOrder, and carries the mutual-colimit back-pointer prim:interpretAs to the FormalType it realizes, so yang holds yin and the round-trip physical → interpretAs → formal closes (q_colimit_roundtrip). It is the rdfs:domain of every encoding-facet property in this file (bitWidth, byteWidth, byteOrder, signedness, integerRepresentation, ieee754Field, uefiName, ieee754) and the sh:targetClass of the SHACL EncodingShape; an encoding lacking bitWidth, byteOrder, or interpretAs is a dangling carrier the law rejects." .


# =====================================================================================
# Punning witnesses — the formal types that physical encodings interpret back to are
# here also asserted as INDIVIDUALS of prim:FormalType (OWL 2 punning), so the mutual-
# colimit round-trip q_colimit_roundtrip (?e interpretAs ?f . ?f a prim:FormalType)
# closes under the runner's non-inference SPARQL. The classes, their tower arrows, and
# their ≥200-char comments are authored in formal.ttl; these are additive type facts.
# =====================================================================================

prim:Bool      a prim:FormalType .
prim:Natural   a prim:FormalType .
prim:Integer   a prim:FormalType .
prim:Real      a prim:FormalType .
prim:Codepoint a prim:FormalType .


# =====================================================================================
# ISA / UEFI machine-type encodings — each interpretAs a formal type (back-pointer)
# =====================================================================================

# ---- BOOLEAN (UEFI 1-byte boolean) --------------------------------------------------
prim:Boolean a prim:PhysicalEncoding ;
    rdfs:label "BOOLEAN (UEFI 1-byte boolean, 0/1)" ;
    prim:bitWidth 8 ; prim:byteWidth 1 ; prim:byteOrder prim:EndianNeutral ;
    prim:interpretAs prim:Bool ; prim:uefiName "BOOLEAN" ;
    rdfs:comment "The Boolean physical encoding: 8 bits / 1 bytes, endian-neutral. It interpretAs Bool — the two-valued Boolean type, a subclass of Kleene3 with the unknown value forbidden — the mutual-colimit back-pointer that closes the round-trip physical → interpretAs → formal reflexively onto its own formal type (spec §9d). UEFI exact-width naming precedent: BOOLEAN. As a concrete bit-layout it fixes how a span of bits over the carrier is read as a value, and it byte-descends through the physical carrier ladder to the width-1 prim:Bit floor of the byte substrate." .

# ---- Unsigned integers UINT8..128 → Natural -----------------------------------------
prim:Uint8 a prim:PhysicalEncoding ;
    rdfs:label "UINT8" ; prim:bitWidth 8 ; prim:byteWidth 1 ;
    prim:byteOrder prim:EndianNeutral ; prim:interpretAs prim:Natural ;
    prim:signedness prim:Unsigned ; prim:uefiName "UINT8" ;
    rdfs:comment "The Uint8 physical encoding: 8 bits / 1 bytes, endian-neutral. It interpretAs Natural — the natural numbers ℕ, a subclass of Integer, the counting floor of the number tower — the mutual-colimit back-pointer that closes the round-trip physical → interpretAs → formal reflexively onto its own formal type (spec §9d). It is unsigned (non-negative). UEFI exact-width naming precedent: UINT8. As a concrete bit-layout it fixes how a span of bits over the carrier is read as a value, and it byte-descends through the physical carrier ladder to the width-1 prim:Bit floor of the byte substrate." .

prim:Uint16 a prim:PhysicalEncoding ;
    rdfs:label "UINT16" ; prim:bitWidth 16 ; prim:byteWidth 2 ;
    prim:byteOrder prim:LE ; prim:interpretAs prim:Natural ;
    prim:signedness prim:Unsigned ; prim:uefiName "UINT16" ;
    rdfs:comment "The Uint16 physical encoding: 16 bits / 2 bytes, little-endian. It interpretAs Natural — the natural numbers ℕ, a subclass of Integer, the counting floor of the number tower — the mutual-colimit back-pointer that closes the round-trip physical → interpretAs → formal reflexively onto its own formal type (spec §9d). It is unsigned (non-negative). UEFI exact-width naming precedent: UINT16. As a concrete bit-layout it fixes how a span of bits over the carrier is read as a value, and it byte-descends through the physical carrier ladder to the width-1 prim:Bit floor of the byte substrate." .

prim:Uint32 a prim:PhysicalEncoding ;
    rdfs:label "UINT32" ; prim:bitWidth 32 ; prim:byteWidth 4 ;
    prim:byteOrder prim:LE ; prim:interpretAs prim:Natural ;
    prim:signedness prim:Unsigned ; prim:uefiName "UINT32" ;
    rdfs:comment "The Uint32 physical encoding: 32 bits / 4 bytes, little-endian. It interpretAs Natural — the natural numbers ℕ, a subclass of Integer, the counting floor of the number tower — the mutual-colimit back-pointer that closes the round-trip physical → interpretAs → formal reflexively onto its own formal type (spec §9d). It is unsigned (non-negative). UEFI exact-width naming precedent: UINT32. As a concrete bit-layout it fixes how a span of bits over the carrier is read as a value, and it byte-descends through the physical carrier ladder to the width-1 prim:Bit floor of the byte substrate." .

prim:Uint64 a prim:PhysicalEncoding ;
    rdfs:label "UINT64" ; prim:bitWidth 64 ; prim:byteWidth 8 ;
    prim:byteOrder prim:LE ; prim:interpretAs prim:Natural ;
    prim:signedness prim:Unsigned ; prim:uefiName "UINT64" ;
    rdfs:comment "The Uint64 physical encoding: 64 bits / 8 bytes, little-endian. It interpretAs Natural — the natural numbers ℕ, a subclass of Integer, the counting floor of the number tower — the mutual-colimit back-pointer that closes the round-trip physical → interpretAs → formal reflexively onto its own formal type (spec §9d). It is unsigned (non-negative). UEFI exact-width naming precedent: UINT64. As a concrete bit-layout it fixes how a span of bits over the carrier is read as a value, and it byte-descends through the physical carrier ladder to the width-1 prim:Bit floor of the byte substrate." .

prim:Uint128 a prim:PhysicalEncoding ;
    rdfs:label "UINT128" ; prim:bitWidth 128 ; prim:byteWidth 16 ;
    prim:byteOrder prim:LE ; prim:interpretAs prim:Natural ;
    prim:signedness prim:Unsigned ; prim:uefiName "no-UEFI-exact-name" ;
    rdfs:comment "The Uint128 physical encoding: 128 bits / 16 bytes, little-endian. It interpretAs Natural — the natural numbers ℕ, a subclass of Integer, the counting floor of the number tower — the mutual-colimit back-pointer that closes the round-trip physical → interpretAs → formal reflexively onto its own formal type (spec §9d). It is unsigned (non-negative). As a concrete bit-layout it fixes how a span of bits over the carrier is read as a value, and it byte-descends through the physical carrier ladder to the width-1 prim:Bit floor of the byte substrate." .

# ---- Signed integers INT8..128 → Integer (two's-complement) -------------------------
prim:Int8 a prim:PhysicalEncoding ;
    rdfs:label "INT8" ; prim:bitWidth 8 ; prim:byteWidth 1 ;
    prim:byteOrder prim:EndianNeutral ; prim:interpretAs prim:Integer ;
    prim:signedness prim:Signed ; prim:integerRepresentation prim:TwosComplement ;
