prim:NaturalWithZero prim:rhoObject prim:NaturalWithZeroCanonicalEncoding .
prim:NaturalWithoutZero prim:rhoObject prim:NaturalWithoutZeroUint32 .
prim:Optional prim:rhoObject prim:OptionalPresenceEncoding .
prim:Ordinal prim:rhoObject prim:Ordinal_Uint32Index .
prim:Point prim:rhoObject prim:PointWkbGeometry .
