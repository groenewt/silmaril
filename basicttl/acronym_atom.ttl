@prefix silm: <urn:silmaril:entity#> .
@prefix cco: <https://www.commoncoreontologies.org/> .
@prefix cceo: <https://www.commoncoreontologies.org/cpo#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

silm:acronymatom a owl:Class ;
    rdfs:label "AcronymAtom" ;
    rdfs:comment "A short-form acronym and its expansion, surfaced in the fancyhdr footer-L acronym strip on first use within a chapter." .
