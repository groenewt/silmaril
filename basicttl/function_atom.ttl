@prefix silm: <urn:silmaril:entity#> .
@prefix cco: <https://www.commoncoreontologies.org/> .
@prefix cceo: <https://www.commoncoreontologies.org/cpo#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

silm:functionatom a owl:Class ;
    rdfs:label "FunctionAtom" ;
    rdfs:comment "A named function (mathematical or implemented) carried as a paper atom, with signature and intent recorded so the function participates in the Yoneda traversal." .
