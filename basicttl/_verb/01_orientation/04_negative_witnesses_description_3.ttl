silm:instances_papers_01_orientation_chapters_15_witness_traceability_sections_04_negative_witnesses_concrete_anchor_3#emptyhomcatusmittens a owl:NamedIndividual ;
    rdfs:label "urn:silmaril:entity#instances.papers.01_orientation.chapters.15_witness_traceability.sections.04_negative_witnesses.concrete_anchor_3#emptyhomcatusmittens" .
silm:instances_papers_01_orientation_chapters_15_witness_traceability_sections_04_negative_witnesses_concrete_anchor_3#emptyhomcatusmittens silm:hasLongDescription "The EmptyHomCatusMittens is EmptyHomSet is the terminus of the gate_refuse arrow in the negative-witness chain. For the catus-collision probe, the empty hom-set is Hom_O_01(catus, Mittens) = empty: there is no admitted arrow from a bare catus row to the concrete cat Mittens. The negative witness from gippidy00 lines 97-105 (collision-list) supports this empty hom-set by enumerating the candidates that fail (bare catus, TSN 183798 alone, any catus row) and exhibiting why each cannot be Mittens." .
