silm:instances_papers_01_orientation_chapters_14_kleisli_enrichment_pipeline_sections_05_glue_as_kleisli_arrow_concrete_anchor_2#mittenscolimitapex a owl:NamedIndividual ;
    rdfs:label "urn:silmaril:entity#instances.papers.01_orientation.chapters.14_kleisli_enrichment_pipeline.sections.05_glue_as_kleisli_arrow.concrete_anchor_2#mittenscolimitapex" .
silm:instances_papers_01_orientation_chapters_14_kleisli_enrichment_pipeline_sections_05_glue_as_kleisli_arrow_concrete_anchor_2#mittenscolimitapex silm:hasLongDescription "The MittensColimitApex is Mittens is the colimit apex colim(D_Mittens) produced by the glue Kleisli arrow when all ten typed legs are present and compatible. Mittens is not a summary, not a label, and not a selected row. It is the canonical object produced by the universal property of the cocone. No competing cocone target (e.g., VetCarePlan77) replaces it; VetCarePlan77 receives the unique mediating arrow u from Mittens, confirming Mittens as the colimit." .
