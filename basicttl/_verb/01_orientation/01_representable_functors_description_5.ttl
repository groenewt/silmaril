silm:instances_papers_01_orientation_chapters_04_yoneda_position_deepening_sections_01_representable_functors_concrete_anchor_5#mittensincomingyonedaprofile a owl:NamedIndividual ;
    rdfs:label "urn:silmaril:entity#instances.papers.01_orientation.chapters.04_yoneda_position_deepening.sections.01_representable_functors.concrete_anchor_5#mittensincomingyonedaprofile" .
silm:instances_papers_01_orientation_chapters_04_yoneda_position_deepening_sections_01_representable_functors_concrete_anchor_5#mittensincomingyonedaprofile silm:hasLongDescription "The MittensIncomingYonedaProfile is the incoming Yoneda profile of Mittens: contravariant functor X -> Hom(X, Mittens). In the paper's apparatus it appears as the symbol 'Y^in_Mittens', a concrete instance grounded in the Mittens domain story; it serves as the anchor whose semantics every diagram, formula, and prose reference back to." .
