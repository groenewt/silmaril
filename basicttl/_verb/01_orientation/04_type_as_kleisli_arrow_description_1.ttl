silm:instances_papers_01_orientation_chapters_14_kleisli_enrichment_pipeline_sections_04_type_as_kleisli_arrow_concrete_anchor_1#witness_record a owl:NamedIndividual ;
    rdfs:label "urn:silmaril:entity#instances.papers.01_orientation.chapters.14_kleisli_enrichment_pipeline.sections.04_type_as_kleisli_arrow.concrete_anchor_1#witness_record" .
silm:instances_papers_01_orientation_chapters_14_kleisli_enrichment_pipeline_sections_04_type_as_kleisli_arrow_concrete_anchor_1#witness_record silm:hasLongDescription "The Witness_record is Witness_record is the Free(Sigma)-wrapped vet-record witness, produced by the cite step. It is the source of the gate arrow in the type diagram. After gate checks it (TypedNode_record), admit produces TypedLeg_record. The witness carries the vet-record provenance: file path, line range, verbatim quote, local key." .
