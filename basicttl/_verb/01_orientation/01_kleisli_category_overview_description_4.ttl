silm:instances_papers_01_orientation_chapters_14_kleisli_enrichment_pipeline_sections_01_kleisli_category_overview_concrete_anchor_4#typedlegmeasurement a owl:NamedIndividual ;
    rdfs:label "urn:silmaril:entity#instances.papers.01_orientation.chapters.14_kleisli_enrichment_pipeline.sections.01_kleisli_category_overview.concrete_anchor_4#typedlegmeasurement" .
silm:instances_papers_01_orientation_chapters_14_kleisli_enrichment_pipeline_sections_01_kleisli_category_overview_concrete_anchor_4#typedlegmeasurement silm:hasLongDescription "The TypedLegMeasurement is TypedLeg is the third node of the Kleisli pipeline, produced by type^Kl. For the measurement-leg run, TypedLeg instantiates to TypedLeg_measurement: a named olog object representing the MeasurementEvent2024 sort applied to the Mittens 4.1kg reading. Its outgoing arrow is the cocone leg lambda_meas: TypedLeg_measurement -> Mittens that glue^Kl will commit to the colimit." .
