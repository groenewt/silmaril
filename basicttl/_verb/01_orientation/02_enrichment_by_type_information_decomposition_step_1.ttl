silm:instances_papers_01_orientation_chapters_14_kleisli_enrichment_pipeline_sections_02_enrichment_by_type_information_decomposition_step_1__step_hom_o_01a_b_in_set_set_enriched_category a owl:NamedIndividual ;
    rdfs:label "A Set-enriched category replaces each hom-set with a set object in Set and requires composition to be a function of sets. The page olog O_01 is Set-enriched: every hom-set is a finite set of typed arrows." .
