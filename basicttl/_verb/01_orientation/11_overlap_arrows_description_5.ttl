silm:instances_papers_01_orientation_chapters_05_mittens_leg_walkthrough_sections_11_overlap_arrows_concrete_anchor_5#mittensincomingyonedaprofile a owl:NamedIndividual ;
    rdfs:label "urn:silmaril:entity#instances.papers.01_orientation.chapters.05_mittens_leg_walkthrough.sections.11_overlap_arrows.concrete_anchor_5#mittensincomingyonedaprofile" .
silm:instances_papers_01_orientation_chapters_05_mittens_leg_walkthrough_sections_11_overlap_arrows_concrete_anchor_5#mittensincomingyonedaprofile silm:hasLongDescription "The MittensIncomingYonedaProfile is the incoming Yoneda profile of Mittens: contravariant functor X -> Hom(X, Mittens). In the paper's apparatus it appears as the symbol 'Y^in_Mittens', a concrete instance grounded in the Mittens domain story; it serves as the anchor whose semantics every diagram, formula, and prose reference back to." .
