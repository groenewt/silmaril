silm:instances_papers_01_orientation_chapters_14_kleisli_enrichment_pipeline_sections_02_enrichment_by_type_information_concrete_anchor_2#mittensenrichedprofile a owl:NamedIndividual ;
    rdfs:label "urn:silmaril:entity#instances.papers.01_orientation.chapters.14_kleisli_enrichment_pipeline.sections.02_enrichment_by_type_information.concrete_anchor_2#mittensenrichedprofile" .
silm:instances_papers_01_orientation_chapters_14_kleisli_enrichment_pipeline_sections_02_enrichment_by_type_information_concrete_anchor_2#mittensenrichedprofile silm:hasLongDescription "The MittensEnrichedProfile is The colimit apex whose full Yoneda profile is the product of ten typed hom-sets. The Set-enrichment claim makes this profile explicitly finite and named: Hom(A, Mittens) for each of the ten source sorts, plus Hom(Mittens, B) for each target sort." .
