silm:instances_papers_01_orientation_chapters_04_yoneda_position_deepening_sections_01_representable_functors_concrete_anchor_6#mittensoutgoingyonedaprofile a owl:NamedIndividual ;
    rdfs:label "urn:silmaril:entity#instances.papers.01_orientation.chapters.04_yoneda_position_deepening.sections.01_representable_functors.concrete_anchor_6#mittensoutgoingyonedaprofile" .
silm:instances_papers_01_orientation_chapters_04_yoneda_position_deepening_sections_01_representable_functors_concrete_anchor_6#mittensoutgoingyonedaprofile silm:hasLongDescription "The MittensOutgoingYonedaProfile is the outgoing Yoneda profile of Mittens: covariant functor X -> Hom(Mittens, X). In the paper's apparatus it appears as the symbol 'Y^out_Mittens', a concrete instance grounded in the Mittens domain story; it serves as the anchor whose semantics every diagram, formula, and prose reference back to." .
