silm:instances_papers_01_orientation_chapters_14_kleisli_enrichment_pipeline_sections_05_glue_as_kleisli_arrow_concrete_anchor_5#typedlegclassification_domesticcat a owl:NamedIndividual ;
    rdfs:label "urn:silmaril:entity#instances.papers.01_orientation.chapters.14_kleisli_enrichment_pipeline.sections.05_glue_as_kleisli_arrow.concrete_anchor_5#typedlegclassification_domesticcat" .
silm:instances_papers_01_orientation_chapters_14_kleisli_enrichment_pipeline_sections_05_glue_as_kleisli_arrow_concrete_anchor_5#typedlegclassification_domesticcat silm:hasLongDescription "The TypedLegClassification_DomesticCat is TypedLeg_classification represents the classification source leg of D_Mittens as a typed olog object: it carries the membership arrow lambda_cls: Mittens -> DomesticCat. In the glue diagram it sits on the lower diagonal feeding into Mittens; it is a distinct olog object from the taxonomy leg above it, so the cocone receives classification and taxonomy as two separate compatible legs." .
