silm:instances_papers_01_orientation_chapters_14_kleisli_enrichment_pipeline_sections_05_glue_as_kleisli_arrow_concrete_anchor_1#typedleg_record a owl:NamedIndividual ;
    rdfs:label "urn:silmaril:entity#instances.papers.01_orientation.chapters.14_kleisli_enrichment_pipeline.sections.05_glue_as_kleisli_arrow.concrete_anchor_1#typedleg_record" .
silm:instances_papers_01_orientation_chapters_14_kleisli_enrichment_pipeline_sections_05_glue_as_kleisli_arrow_concrete_anchor_1#typedleg_record silm:hasLongDescription "The TypedLeg_record is TypedLeg_record represents the olog object VetRecord77 (the veterinary examination record for Mittens from 2024) as a typed colimit leg. The glue arrow lambda_rec: TypedLeg_record -> Mittens is one of the ten cocone legs that must be present and compatible for glue to produce the Mittens colimit apex." .
