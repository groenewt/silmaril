silm:instances_papers_01_orientation_chapters_01_reader_onboarding_sections_04_first_walkthrough_mittens_concrete_anchor_5#mittensincomingyonedaprofile a owl:NamedIndividual ;
    rdfs:label "urn:silmaril:entity#instances.papers.01_orientation.chapters.01_reader_onboarding.sections.04_first_walkthrough_mittens.concrete_anchor_5#mittensincomingyonedaprofile" .
silm:instances_papers_01_orientation_chapters_01_reader_onboarding_sections_04_first_walkthrough_mittens_concrete_anchor_5#mittensincomingyonedaprofile silm:hasLongDescription "The MittensIncomingYonedaProfile is the incoming Yoneda profile of Mittens: contravariant functor X -> Hom(X, Mittens). In the paper's apparatus it appears as the symbol 'Y^in_Mittens', a concrete instance grounded in the Mittens domain story; it serves as the anchor whose semantics every diagram, formula, and prose reference back to." .
