silm:instances_papers_01_orientation_chapters_15_witness_traceability_sections_03_ledger_row_anatomy_decomposition_step_1__step_anchor;_witness_path;_witness_line_range;_interpretation_kin a owl:NamedIndividual ;
    rdfs:label "The ledger has eight named columns: anchor (which section the claim belongs to), witness_path (file on disk), witness_line_range (specific lines), interpretation_kind (source-leg, negative-regression, etc.), verbatim_quote (exact text), validation_law (which rule governs the claim), edit_target (which paper section to edit), edit_diff_sha (SHA of the diff hunk)." .
