silm:instances_papers_01_orientation_chapters_07_node_arrow_gate_mechanics_sections_03_factorization_structures_concrete_anchor_5#mittensincomingyonedaprofile a owl:NamedIndividual ;
    rdfs:label "urn:silmaril:entity#instances.papers.01_orientation.chapters.07_node_arrow_gate_mechanics.sections.03_factorization_structures.concrete_anchor_5#mittensincomingyonedaprofile" .
silm:instances_papers_01_orientation_chapters_07_node_arrow_gate_mechanics_sections_03_factorization_structures_concrete_anchor_5#mittensincomingyonedaprofile silm:hasLongDescription "The MittensIncomingYonedaProfile is the incoming Yoneda profile of Mittens: contravariant functor X -> Hom(X, Mittens). In the paper's apparatus it appears as the symbol 'Y^in_Mittens', a concrete instance grounded in the Mittens domain story; it serves as the anchor whose semantics every diagram, formula, and prose reference back to." .
