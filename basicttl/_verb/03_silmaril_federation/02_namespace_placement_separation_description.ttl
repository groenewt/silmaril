silm:instances_papers_03_silmaril_federation_chapters_02_factored_storage_topology_sections_02_namespace_placement_separation_concrete_anchor_node1 a owl:NamedIndividual ;
    rdfs:label "urn:silmaril:entity#instances.papers.03_silmaril_federation.chapters.02_factored_storage_topology.sections.02_namespace_placement_separation.concrete_anchor.node1" .
silm:instances_papers_03_silmaril_federation_chapters_02_factored_storage_topology_sections_02_namespace_placement_separation_concrete_anchor_node1 silm:hasLongDescription "The StoragePacket_Mittens_Node is The typed storage packet for Mittens. Domain of the lambda_storage arrow. Placed in the vet-records/mittens/ namespace. In the paper's apparatus it appears as the symbol 'StoragePacket_Mittens (typed storage object)', a concrete instance grounded in the Mittens domain story; it serves as the anchor whose semantics every diagram, formula, and prose reference back to." .
silm:instances_papers_03_silmaril_federation_chapters_02_factored_storage_topology_sections_02_namespace_placement_separation_concrete_anchor_node2 a owl:NamedIndividual ;
    rdfs:label "urn:silmaril:entity#instances.papers.03_silmaril_federation.chapters.02_factored_storage_topology.sections.02_namespace_placement_separation.concrete_anchor.node2" .
silm:instances_papers_03_silmaril_federation_chapters_02_factored_storage_topology_sections_02_namespace_placement_separation_concrete_anchor_node2 silm:hasLongDescription "The VetRecordsMittensNamespace is The placement namespace for Mittens' storage objects. A location address — not the identity of Mittens. Two storage packets in this namespace are both ABOUT Mittens; the namespace does not make them Mittens." .
silm:instances_papers_03_silmaril_federation_chapters_02_factored_storage_topology_sections_02_namespace_placement_separation_concrete_anchor_node3 a owl:NamedIndividual ;
    rdfs:label "urn:silmaril:entity#instances.papers.03_silmaril_federation.chapters.02_factored_storage_topology.sections.02_namespace_placement_separation.concrete_anchor.node3" .
silm:instances_papers_03_silmaril_federation_chapters_02_factored_storage_topology_sections_02_namespace_placement_separation_concrete_anchor_node3 silm:hasLongDescription "The MittensGovernedApex_Namespace is Mittens is the apex of D_Mittens — the governed individual cat. The namespace placement points to storage objects about Mittens; Mittens is not inside the namespace. In the paper's apparatus it appears as the symbol 'Mittens (the governed individual at the apex)', a concrete instance grounded in the Mittens domain story; it serves as the anchor whose semantics every diagram, formula, and prose reference back to." .
