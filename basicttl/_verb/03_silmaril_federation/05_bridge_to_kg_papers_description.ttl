silm:instances_papers_03_silmaril_federation_chapters_10_cross_paper_bridges_sections_05_bridge_to_kg_papers_concrete_anchor_mittens_instance a owl:NamedIndividual ;
    rdfs:label "urn:silmaril:entity#instances.papers.03_silmaril_federation.chapters.10_cross_paper_bridges.sections.05_bridge_to_kg_papers.concrete_anchor.mittens_instance" .
silm:instances_papers_03_silmaril_federation_chapters_10_cross_paper_bridges_sections_05_bridge_to_kg_papers_concrete_anchor_mittens_instance silm:hasLongDescription "The MittensConcreteIndividual is Mittens is the concrete cat individual — the instancenode in the KG bridge diagram. From this node, typedInto goes to KGNode_Mittens and isAbout goes to VetRecord_Mittens. Mittens is NOT the KG node; it is the individual that KG nodes are about." .
silm:instances_papers_03_silmaril_federation_chapters_10_cross_paper_bridges_sections_05_bridge_to_kg_papers_concrete_anchor_kgnode_mittens a owl:NamedIndividual ;
    rdfs:label "urn:silmaril:entity#instances.papers.03_silmaril_federation.chapters.10_cross_paper_bridges.sections.05_bridge_to_kg_papers.concrete_anchor.kgnode_mittens" .
silm:instances_papers_03_silmaril_federation_chapters_10_cross_paper_bridges_sections_05_bridge_to_kg_papers_concrete_anchor_kgnode_mittens silm:hasLongDescription "The MittensKGNodeBeforeGrowth is KGNode_Mittens is the classnode — the RDF resource for Mittens's vet record before graph growth. It has triples for vaccination date and breed. It is typed into from Mittens via typedInto, and it can grow." .
silm:instances_papers_03_silmaril_federation_chapters_10_cross_paper_bridges_sections_05_bridge_to_kg_papers_concrete_anchor_vetrecord_mittens a owl:NamedIndividual ;
    rdfs:label "urn:silmaril:entity#instances.papers.03_silmaril_federation.chapters.10_cross_paper_bridges.sections.05_bridge_to_kg_papers.concrete_anchor.vetrecord_mittens" .
silm:instances_papers_03_silmaril_federation_chapters_10_cross_paper_bridges_sections_05_bridge_to_kg_papers_concrete_anchor_vetrecord_mittens silm:hasLongDescription "The MittensVetRecord is VetRecord_Mittens is the infonode — the vet record document about Mittens. From it, isAbout goes to Mittens and typedInto goes to KGNode_Mittens'. The vet record is about Mittens (the individual), not identical to Mittens." .
silm:instances_papers_03_silmaril_federation_chapters_10_cross_paper_bridges_sections_05_bridge_to_kg_papers_concrete_anchor_kgnode_mittens_prime a owl:NamedIndividual ;
    rdfs:label "urn:silmaril:entity#instances.papers.03_silmaril_federation.chapters.10_cross_paper_bridges.sections.05_bridge_to_kg_papers.concrete_anchor.kgnode_mittens_prime" .
silm:instances_papers_03_silmaril_federation_chapters_10_cross_paper_bridges_sections_05_bridge_to_kg_papers_concrete_anchor_kgnode_mittens_prime silm:hasLongDescription "The MittensKGNodeAfterGrowth is KGNode_Mittens' is the classnode after graph growth — the RDF resource with vaccination date, breed, AND updated weight. The grow arrow from KGNode_Mittens points here. The commutativity square says VetRecord_Mittens types into this grown node, and it is still about Mittens." .
