silm:instances_papers_03_silmaril_federation_chapters_06_crdt_gossip_convergence_sections_04_gossip_mittens_preservation_concrete_anchor_r1 a owl:NamedIndividual ;
    rdfs:label "urn:silmaril:entity#instances.papers.03_silmaril_federation.chapters.06_crdt_gossip_convergence.sections.04_gossip_mittens_preservation.concrete_anchor.r1" .
silm:instances_papers_03_silmaril_federation_chapters_06_crdt_gossip_convergence_sections_04_gossip_mittens_preservation_concrete_anchor_r1 silm:hasLongDescription "The MorningReplicaWithAboutnessA1 is R_1 is the morning vet-clinic replica of Mittens's StoragePacket, carrying aboutness arrow a_1: R_1 -> Mittens. Concretely: the replica holds {weight: 3.8kg, sensor: vet-clinic-scale-01, about: Mittens}." .
silm:instances_papers_03_silmaril_federation_chapters_06_crdt_gossip_convergence_sections_04_gossip_mittens_preservation_concrete_anchor_r_vee a owl:NamedIndividual ;
    rdfs:label "urn:silmaril:entity#instances.papers.03_silmaril_federation.chapters.06_crdt_gossip_convergence.sections.04_gossip_mittens_preservation.concrete_anchor.r_vee" .
silm:instances_papers_03_silmaril_federation_chapters_06_crdt_gossip_convergence_sections_04_gossip_mittens_preservation_concrete_anchor_r_vee silm:hasLongDescription "The FullyConvergedVetRecordAboutnessAvee is R_vee is the fully converged vet record for Mittens carrying the unique aboutness arrow a_vee: R_vee -> Mittens. After three health readings (weight, temperature, microchip scan) arrive at converged state, R_vee still refers to the same cat. The gossip protocol did not change the cat; it changed the replica's measurement record." .
silm:instances_papers_03_silmaril_federation_chapters_06_crdt_gossip_convergence_sections_04_gossip_mittens_preservation_concrete_anchor_r2 a owl:NamedIndividual ;
    rdfs:label "urn:silmaril:entity#instances.papers.03_silmaril_federation.chapters.06_crdt_gossip_convergence.sections.04_gossip_mittens_preservation.concrete_anchor.r2" .
silm:instances_papers_03_silmaril_federation_chapters_06_crdt_gossip_convergence_sections_04_gossip_mittens_preservation_concrete_anchor_r2 silm:hasLongDescription "The AfternoonReplicaWithAboutnessA2 is R_2 is the afternoon vet-clinic replica of Mittens's StoragePacket, carrying aboutness arrow a_2: R_2 -> Mittens. Concretely: {temperature: 38.6C, sensor: vet-clinic-thermometer-01, about: Mittens}. In the paper's apparatus it appears as the symbol 'R_2', a concrete instance grounded in the Mittens domain story; it serves as the anchor whose semantics every diagram, formula, and prose reference back to." .
silm:instances_papers_03_silmaril_federation_chapters_06_crdt_gossip_convergence_sections_04_gossip_mittens_preservation_concrete_anchor_mittens a owl:NamedIndividual ;
    rdfs:label "urn:silmaril:entity#instances.papers.03_silmaril_federation.chapters.06_crdt_gossip_convergence.sections.04_gossip_mittens_preservation.concrete_anchor.mittens" .
silm:instances_papers_03_silmaril_federation_chapters_06_crdt_gossip_convergence_sections_04_gossip_mittens_preservation_concrete_anchor_mittens silm:hasLongDescription "The MittensGovernedCatThroughGossip is Mittens is the semantic colimit apex — the governed individual cat that all replica aboutness arrows point to. After gossip convergence, a_vee: R_vee -> Mittens is the unique arrow that factors through all a_i. Mittens is unchanged by gossip: the cat's identity is preserved even as the measurement records are updated." .
