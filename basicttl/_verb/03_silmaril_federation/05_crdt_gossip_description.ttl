silm:instances_papers_03_silmaril_federation_chapters_flat_sections_05_crdt_gossip_concrete_anchor_node1 a owl:NamedIndividual ;
    rdfs:label "urn:silmaril:entity#instances.papers.03_silmaril_federation.chapters.flat.sections.05_crdt_gossip.concrete_anchor.node1" .
silm:instances_papers_03_silmaril_federation_chapters_flat_sections_05_crdt_gossip_concrete_anchor_node1 silm:hasLongDescription "The 05_crdt_gossipSourceNode is The typed source federation object for 05_crdt_gossip. In the Mittens example: VetRecord_Mittens, StoragePacket_Mittens, or KGAssertion_Mittens depending on the operation path. In the paper's apparatus it appears as the symbol 'Source (typed federation object)', a concrete instance grounded in the Mittens domain story; it serves as the anchor whose semantics every diagram, formula, and prose reference back to." .
silm:instances_papers_03_silmaril_federation_chapters_flat_sections_05_crdt_gossip_concrete_anchor_node2 a owl:NamedIndividual ;
    rdfs:label "urn:silmaril:entity#instances.papers.03_silmaril_federation.chapters.flat.sections.05_crdt_gossip.concrete_anchor.node2" .
silm:instances_papers_03_silmaril_federation_chapters_flat_sections_05_crdt_gossip_concrete_anchor_node2 silm:hasLongDescription "The 05_crdt_gossipOperationNode is The operation or gate node for 05_crdt_gossip. R_1 join R_2 = gossip merge of two Mittens replicas. Commutative: R_1 join R_2 = R_2 join R_1. Idempotent: R join R = R. In the paper's apparatus it appears as the symbol 'Operation or gate', a concrete instance grounded in the Mittens domain story; it serves as the anchor whose semantics every diagram, formula, and prose reference back to." .
silm:instances_papers_03_silmaril_federation_chapters_flat_sections_05_crdt_gossip_concrete_anchor_node3 a owl:NamedIndividual ;
    rdfs:label "urn:silmaril:entity#instances.papers.03_silmaril_federation.chapters.flat.sections.05_crdt_gossip.concrete_anchor.node3" .
silm:instances_papers_03_silmaril_federation_chapters_flat_sections_05_crdt_gossip_concrete_anchor_node3 silm:hasLongDescription "The MittensApex_05_crdt_gossip is Mittens is the colimit apex — the governed individual cat. All arrows in 05_crdt_gossip ultimately point toward Mittens. Mittens is NOT a source leg, NOT a storage packet, NOT a KG node. In the paper's apparatus it appears as the symbol 'Mittens (governed individual apex)', a concrete instance grounded in the Mittens domain story; it serves as the anchor whose semantics every diagram, formula, and prose reference back to." .
