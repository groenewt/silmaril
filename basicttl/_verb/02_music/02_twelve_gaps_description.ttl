    rdfs:label "urn:silmaril:entity#instances.papers.02_music.sections.02_twelve_gaps.concrete_anchor#mittens" .
silm:instances_papers_02_music_sections_02_twelve_gaps_concrete_anchor#mittens silm:hasLongDescription "The Mittens is the SourceWitness from the cannon/cat/joy_of_cats.md JoC §11 colimit citation, an external authority source leg. In the paper's apparatus it appears as the symbol '\\Mittens', a concrete instance grounded in the Mittens domain story; it serves as the anchor whose semantics every diagram, formula, and prose reference back to." .
silm:instances_papers_02_music_sections_02_twelve_gaps_concrete_anchor#taxonomywitness a owl:NamedIndividual ;
    rdfs:label "urn:silmaril:entity#instances.papers.02_music.sections.02_twelve_gaps.concrete_anchor#taxonomywitness" .
silm:instances_papers_02_music_sections_02_twelve_gaps_concrete_anchor#taxonomywitness silm:hasLongDescription "The TaxonomyWitness is the EvidencePacket carrying the typing decision and path law that admits the Mittens vaccination record, distinct from the raw audio file or storage object. In the paper's apparatus it appears as the symbol '\\concept{TaxonomyWitness}  \\', a concrete instance grounded in the Mittens domain story; it serves as the anchor whose semantics every diagram, formula, and prose reference back to." .
