    rdfs:label "urn:silmaril:entity#instances.papers.02_music.sections.05_avro_substrate.concrete_anchor#claimtype" .
silm:instances_papers_02_music_sections_05_avro_substrate_concrete_anchor#claimtype silm:hasLongDescription "The claimType is the Mittens domestic-cat classification leg (DomesticCat) as a typed source-leg arrow that anchors BY Mittens, not as an identity. In the paper's apparatus it appears as the symbol '\\concept{claimType} \\', a concrete instance grounded in the Mittens domain story; it serves as the anchor whose semantics every diagram, formula, and prose reference back to." .
silm:instances_papers_02_music_sections_05_avro_substrate_concrete_anchor#typedobject a owl:NamedIndividual ;
    rdfs:label "urn:silmaril:entity#instances.papers.02_music.sections.05_avro_substrate.concrete_anchor#typedobject" .
silm:instances_papers_02_music_sections_05_avro_substrate_concrete_anchor#typedobject silm:hasLongDescription "The TypedObject is the Felis catus / TSN 183798 taxonomy source leg, recoverable as a typed leg into D_Mittens but not interchangeable with the colimit apex Mittens. In the paper's apparatus it appears as the symbol '\\concept{TypedObject} \\', a concrete instance grounded in the Mittens domain story; it serves as the anchor whose semantics every diagram, formula, and prose reference back to." .
