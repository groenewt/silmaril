silm:instances_papers_02_music_sections_02_mittens_anchor_concrete_anchor#quality a owl:NamedIndividual ;
    rdfs:label "urn:silmaril:entity#instances.papers.02_music.sections.02_mittens_anchor.concrete_anchor#quality" .
silm:instances_papers_02_music_sections_02_mittens_anchor_concrete_anchor#quality silm:hasLongDescription "The quality is the Mittens body-mass observation record from the May 2026 vet visit at Tartu Animal Clinic, entering the engine as a typed quality-claim source packet. In the paper's apparatus it appears as the symbol '] D_{\\Mittens}(\\concept{quality})  \\', a concrete instance grounded in the Mittens domain story; it serves as the anchor whose semantics every diagram, formula, and prose reference back to." .
