    rdfs:label "urn:silmaril:entity#instances.papers.02_music.sections.07_tier1prime_extensions.concrete_anchor#admittednode" .
silm:instances_papers_02_music_sections_07_tier1prime_extensions_concrete_anchor#admittednode silm:hasLongDescription "The AdmittedNode is the TaskNode that records the admitted body-mass measurement as the engine's executable transformation. In the paper's apparatus it appears as the symbol '\\concept{AdmittedNode}', a concrete instance grounded in the Mittens domain story; it serves as the anchor whose semantics every diagram, formula, and prose reference back to." .
silm:instances_papers_02_music_sections_07_tier1prime_extensions_concrete_anchor#ologclaim a owl:NamedIndividual ;
