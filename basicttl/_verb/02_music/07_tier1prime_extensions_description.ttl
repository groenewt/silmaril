    rdfs:label "urn:silmaril:entity#instances.papers.02_music.sections.07_tier1prime_extensions.concrete_anchor#x" .
silm:instances_papers_02_music_sections_07_tier1prime_extensions_concrete_anchor#x silm:hasLongDescription "The X is the Mittens vaccination record FVRCP-2026-03-15, entering as a typed evidence packet with provenance and validation envelope. In the paper's apparatus it appears as the symbol '\\bigl(\\Hom(-,\\concept{X}),\\Hom(\\concept{X},-)\\bigr)', a concrete instance grounded in the Mittens domain story; it serves as the anchor whose semantics every diagram, formula, and prose reference back to." .
