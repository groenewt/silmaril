    rdfs:label "urn:silmaril:entity#instances.papers.21_ologs_and_typed_english.chapters.03_typed_verb_discipline.sections.03_verb_taxonomy.concrete_anchor_5_taxonomy#verbtaxonomyclassifier" .
silm:instances_papers_21_ologs_and_typed_english_chapters_03_typed_verb_discipline_sections_03_verb_taxonomy_concrete_anchor_5_taxonomy#verbtaxonomyclassifier silm:hasLongDescription "The VerbTaxonomyClassifier is the four-way classifier of typed-verb aspects. In the paper's apparatus it appears as the symbol 'taxonomy', a concrete instance grounded in the Mittens domain story; it serves as the anchor whose semantics every diagram, formula, and prose reference back to." .
