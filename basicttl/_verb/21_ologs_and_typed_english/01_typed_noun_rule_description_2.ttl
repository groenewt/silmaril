silm:instances_papers_21_ologs_and_typed_english_chapters_02_typed_noun_discipline_sections_01_typed_noun_rule_concrete_anchor_2_tau_N#typednoungate a owl:NamedIndividual ;
    rdfs:label "urn:silmaril:entity#instances.papers.21_ologs_and_typed_english.chapters.02_typed_noun_discipline.sections.01_typed_noun_rule.concrete_anchor_2_tau_N#typednoungate" .
silm:instances_papers_21_ologs_and_typed_english_chapters_02_typed_noun_discipline_sections_01_typed_noun_rule_concrete_anchor_2_tau_N#typednoungate silm:hasLongDescription "The TypedNounGate is the typing gate that admits or rejects N. In the paper's apparatus it appears as the symbol 'tau_N', a concrete instance grounded in the Mittens domain story; it serves as the anchor whose semantics every diagram, formula, and prose reference back to." .
