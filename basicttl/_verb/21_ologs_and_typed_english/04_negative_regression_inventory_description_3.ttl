silm:instances_papers_21_ologs_and_typed_english_chapters_02_typed_noun_discipline_sections_04_negative_regression_inventory_concrete_anchor_3_cats#pluralrejected a owl:NamedIndividual ;
    rdfs:label "urn:silmaril:entity#instances.papers.21_ologs_and_typed_english.chapters.02_typed_noun_discipline.sections.04_negative_regression_inventory.concrete_anchor_3_cats#pluralrejected" .
silm:instances_papers_21_ologs_and_typed_english_chapters_02_typed_noun_discipline_sections_04_negative_regression_inventory_concrete_anchor_3_cats#pluralrejected silm:hasLongDescription "The PluralRejected is rejected for being plural without aggregation discipline; remediated as a multi-row reading of DomesticCatBox. In the paper's apparatus it appears as the symbol 'cats', a concrete instance grounded in the Mittens domain story; it serves as the anchor whose semantics every diagram, formula, and prose reference back to." .
