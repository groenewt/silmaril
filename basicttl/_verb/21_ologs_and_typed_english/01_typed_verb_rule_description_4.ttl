silm:instances_papers_21_ologs_and_typed_english_chapters_03_typed_verb_discipline_sections_01_typed_verb_rule_concrete_anchor_4_tau_V#typedverbgate a owl:NamedIndividual ;
    rdfs:label "urn:silmaril:entity#instances.papers.21_ologs_and_typed_english.chapters.03_typed_verb_discipline.sections.01_typed_verb_rule.concrete_anchor_4_tau_V#typedverbgate" .
silm:instances_papers_21_ologs_and_typed_english_chapters_03_typed_verb_discipline_sections_01_typed_verb_rule_concrete_anchor_4_tau_V#typedverbgate silm:hasLongDescription "The TypedVerbGate is the typing gate applied to (v, src, tgt). In the paper's apparatus it appears as the symbol 'tau_V', a concrete instance grounded in the Mittens domain story; it serves as the anchor whose semantics every diagram, formula, and prose reference back to." .
