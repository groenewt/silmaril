silm:instances_papers_25_sheaf_gluing_chapters_01_sheaf_basics_local_sections_sections_02_presheaf_of_typed_sections_concrete_anchor_1#jointvetownersectionset a owl:NamedIndividual ;
    rdfs:label "urn:silmaril:entity#instances.papers.25_sheaf_gluing.chapters.01_sheaf_basics_local_sections.sections.02_presheaf_of_typed_sections.concrete_anchor_1#jointvetownersectionset" .
silm:instances_papers_25_sheaf_gluing_chapters_01_sheaf_basics_local_sections_sections_02_presheaf_of_typed_sections_concrete_anchor_1#jointvetownersectionset silm:hasLongDescription "The JointVetOwnerSectionSet is the set of typed sections over the joint vet-plus-owner window: bundles holding both a vet-visit summary and an owner-statement excerpt. In the paper's apparatus it appears as the symbol 'F_Mittens(U_{vet1+owner1})', a concrete instance grounded in the Mittens domain story; it serves as the anchor whose semantics every diagram, formula, and prose reference back to." .
