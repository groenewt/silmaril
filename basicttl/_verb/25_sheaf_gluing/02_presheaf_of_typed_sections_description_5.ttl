silm:instances_papers_25_sheaf_gluing_chapters_01_sheaf_basics_local_sections_sections_02_presheaf_of_typed_sections_concrete_anchor_5#mittenspresheaf a owl:NamedIndividual ;
    rdfs:label "urn:silmaril:entity#instances.papers.25_sheaf_gluing.chapters.01_sheaf_basics_local_sections.sections.02_presheaf_of_typed_sections.concrete_anchor_5#mittenspresheaf" .
silm:instances_papers_25_sheaf_gluing_chapters_01_sheaf_basics_local_sections_sections_02_presheaf_of_typed_sections_concrete_anchor_5#mittenspresheaf silm:hasLongDescription "The MittensPresheaf is the contravariant functor assigning each open to its set of typed local sections. In the paper's apparatus it appears as the symbol 'F_Mittens', a concrete instance grounded in the Mittens domain story; it serves as the anchor whose semantics every diagram, formula, and prose reference back to." .
