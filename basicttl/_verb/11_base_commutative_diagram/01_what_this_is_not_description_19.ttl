silm:instances_papers_11_base_commutative_diagram_chapters_02_typed_legs_and_atlas_sections_01_what_this_is_not_concrete_anchor_19_TaxonomyWitness#taxonomywitness a owl:NamedIndividual ;
    rdfs:label "urn:silmaril:entity#instances.papers.11_base_commutative_diagram.chapters.02_typed_legs_and_atlas.sections.01_what_this_is_not.concrete_anchor_19_TaxonomyWitness#taxonomywitness" .
silm:instances_papers_11_base_commutative_diagram_chapters_02_typed_legs_and_atlas_sections_01_what_this_is_not_concrete_anchor_19_TaxonomyWitness#taxonomywitness silm:hasLongDescription "The TaxonomyWitness is the source-leg evidence row supplying the DomesticCat refinement, distinct from Mittens. In the paper's apparatus it appears as the symbol 'TaxonomyWitness', a concrete instance grounded in the Mittens domain story; it serves as the anchor whose semantics every diagram, formula, and prose reference back to." .
