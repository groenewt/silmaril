silm:instances_papers_11_base_commutative_diagram_chapters_25_six_step_bridge_deep_dives_sections_04_path_monoid_six_step_concrete_anchor_1#rewriterule_relator a owl:NamedIndividual ;
    rdfs:label "urn:silmaril:entity#instances.papers.11_base_commutative_diagram.chapters.25_six_step_bridge_deep_dives.sections.04_path_monoid_six_step.concrete_anchor_1#rewriterule_relator" .
silm:instances_papers_11_base_commutative_diagram_chapters_25_six_step_bridge_deep_dives_sections_04_path_monoid_six_step_concrete_anchor_1#rewriterule_relator silm:hasLongDescription "The RewriteRule_relator is the rewrite rule from the base relator: \"rewrite c as r.a\" applied as a string replacement. In the paper's apparatus it appears as the symbol 'RewriteRule_relator', a concrete instance grounded in the Mittens domain story; it serves as the anchor whose semantics every diagram, formula, and prose reference back to." .
