silm:instances_papers_11_base_commutative_diagram_chapters_25_six_step_bridge_deep_dives_sections_02_presheaf_six_step_concrete_anchor_0#localsection_over_cat a owl:NamedIndividual ;
    rdfs:label "urn:silmaril:entity#instances.papers.11_base_commutative_diagram.chapters.25_six_step_bridge_deep_dives.sections.02_presheaf_six_step.concrete_anchor_0#localsection_over_cat" .
silm:instances_papers_11_base_commutative_diagram_chapters_25_six_step_bridge_deep_dives_sections_02_presheaf_six_step_concrete_anchor_0#localsection_over_cat silm:hasLongDescription "The LocalSection_over_Cat is a local section of F over Cat: F(Cat) = \"all cats have whiskers, retractile claws, body mass below 12 kg\". In the paper's apparatus it appears as the symbol 'LocalSection_over_Cat', a concrete instance grounded in the Mittens domain story; it serves as the anchor whose semantics every diagram, formula, and prose reference back to." .
