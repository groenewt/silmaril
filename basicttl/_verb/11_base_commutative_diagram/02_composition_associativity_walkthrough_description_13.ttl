silm:instances_papers_11_base_commutative_diagram_chapters_17_evidence_composition_identity_sections_02_composition_associativity_walkthrough_concrete_anchor_13_piquotientprojection#pi_quotient_projection a owl:NamedIndividual ;
    rdfs:label "urn:silmaril:entity#instances.papers.11_base_commutative_diagram.chapters.17_evidence_composition_identity.sections.02_composition_associativity_walkthrough.concrete_anchor_13_piquotientprojection#pi_quotient_projection" .
silm:instances_papers_11_base_commutative_diagram_chapters_17_evidence_composition_identity_sections_02_composition_associativity_walkthrough_concrete_anchor_13_piquotientprojection#pi_quotient_projection silm:hasLongDescription "The pi_quotient_projection is the projection from Free(G_11) onto O_11 = Free(G_11)/R_11 enforcing the relator equations. In the paper's apparatus it appears as the symbol 'pi_quotient_projection', a concrete instance grounded in the Mittens domain story; it serves as the anchor whose semantics every diagram, formula, and prose reference back to." .
