silm:instances_papers_11_base_commutative_diagram_chapters_19_bridges_monoids_functorial_ologs_sections_02_bridge_functorial_transport_concrete_anchor_3_DomesticCat#domesticcat a owl:NamedIndividual ;
    rdfs:label "urn:silmaril:entity#instances.papers.11_base_commutative_diagram.chapters.19_bridges_monoids_functorial_ologs.sections.02_bridge_functorial_transport.concrete_anchor_3_DomesticCat#domesticcat" .
silm:instances_papers_11_base_commutative_diagram_chapters_19_bridges_monoids_functorial_ologs_sections_02_bridge_functorial_transport_concrete_anchor_3_DomesticCat#domesticcat silm:hasLongDescription "The DomesticCat is the domestic-cat refinement class; a:Mittens->DomesticCat under r:DomesticCat->Cat. In the paper's apparatus it appears as the symbol 'DomesticCat', a concrete instance grounded in the Mittens domain story; it serves as the anchor whose semantics every diagram, formula, and prose reference back to." .
