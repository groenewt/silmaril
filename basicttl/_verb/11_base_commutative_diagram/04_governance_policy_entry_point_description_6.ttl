silm:instances_papers_11_base_commutative_diagram_chapters_24_rosetta_stone_cross_domain_sections_04_governance_policy_entry_point_concrete_anchor_6#policyinvariant_dual_certification a owl:NamedIndividual ;
    rdfs:label "urn:silmaril:entity#instances.papers.11_base_commutative_diagram.chapters.24_rosetta_stone_cross_domain.sections.04_governance_policy_entry_point.concrete_anchor_6#policyinvariant_dual_certification" .
silm:instances_papers_11_base_commutative_diagram_chapters_24_rosetta_stone_cross_domain_sections_04_governance_policy_entry_point_concrete_anchor_6#policyinvariant_dual_certification silm:hasLongDescription "The PolicyInvariant_dual_certification is the policy invariant: every vet record must be certified by BOTH internal audit AND external certification; the two must agree on the compliance apex. In the paper's apparatus it appears as the symbol 'PolicyInvariant_dual_certification', a concrete instance grounded in the Mittens domain story; it serves as the anchor whose semantics every diagram, formula, and prose reference back to." .
