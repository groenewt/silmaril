silm:instances_papers_11_base_commutative_diagram_chapters_02_typed_legs_and_atlas_sections_04_diagram_inventory_table_concrete_anchor_1#equalizer_joc_s750 a owl:NamedIndividual ;
    rdfs:label "urn:silmaril:entity#instances.papers.11_base_commutative_diagram.chapters.02_typed_legs_and_atlas.sections.04_diagram_inventory_table.concrete_anchor_1#equalizer_joc_s750" .
silm:instances_papers_11_base_commutative_diagram_chapters_02_typed_legs_and_atlas_sections_04_diagram_inventory_table_concrete_anchor_1#equalizer_joc_s750 silm:hasLongDescription "The Equalizer_JoC_S750 is the equalizer eq(f,g) = {x in X | f(x) = g(x)} from JoC 7.50; instantiated by the relator pair (c, r circ a) forced equal in O_11. In the paper's apparatus it appears as the symbol 'Equalizer_JoC_S750', a concrete instance grounded in the Mittens domain story; it serves as the anchor whose semantics every diagram, formula, and prose reference back to." .
