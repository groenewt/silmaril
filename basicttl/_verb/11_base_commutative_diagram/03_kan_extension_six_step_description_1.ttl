silm:instances_papers_11_base_commutative_diagram_chapters_25_six_step_bridge_deep_dives_sections_03_kan_extension_six_step_concrete_anchor_1#lanpi_f a owl:NamedIndividual ;
    rdfs:label "urn:silmaril:entity#instances.papers.11_base_commutative_diagram.chapters.25_six_step_bridge_deep_dives.sections.03_kan_extension_six_step.concrete_anchor_1#lanpi_f" .
silm:instances_papers_11_base_commutative_diagram_chapters_25_six_step_bridge_deep_dives_sections_03_kan_extension_six_step_concrete_anchor_1#lanpi_f silm:hasLongDescription "The LanPi_F is the left Kan extension Lan_pi F : O_11 -> Set; satisfies Lan_pi F (pi(c)) = F(c) up to the relator equation. In the paper's apparatus it appears as the symbol 'LanPi_F', a concrete instance grounded in the Mittens domain story; it serves as the anchor whose semantics every diagram, formula, and prose reference back to." .
