silm:instances_papers_11_base_commutative_diagram_chapters_25_six_step_bridge_deep_dives_sections_04_path_monoid_six_step_concrete_anchor_0#freepathmonoid a owl:NamedIndividual ;
    rdfs:label "urn:silmaril:entity#instances.papers.11_base_commutative_diagram.chapters.25_six_step_bridge_deep_dives.sections.04_path_monoid_six_step.concrete_anchor_0#freepathmonoid" .
silm:instances_papers_11_base_commutative_diagram_chapters_25_six_step_bridge_deep_dives_sections_04_path_monoid_six_step_concrete_anchor_0#freepathmonoid silm:hasLongDescription "The FreePathMonoid is the free path monoid Path(G_11): all finite strings of G_11-arrows (e.g. \"c\", \"r.a\", \"r.a.r.a\"). In the paper's apparatus it appears as the symbol 'FreePathMonoid', a concrete instance grounded in the Mittens domain story; it serves as the anchor whose semantics every diagram, formula, and prose reference back to." .
