    rdfs:label "urn:silmaril:entity#instances.papers.11_base_commutative_diagram.chapters.25_six_step_bridge_deep_dives.sections.04_path_monoid_six_step.concrete_anchor_3#confluencepathway" .
silm:instances_papers_11_base_commutative_diagram_chapters_25_six_step_bridge_deep_dives_sections_04_path_monoid_six_step_concrete_anchor_3#confluencepathway silm:hasLongDescription "The ConfluencePathway is the confluence pathway: any two reduction sequences from a path terminate at the same normal form. In the paper's apparatus it appears as the symbol 'ConfluencePathway', a concrete instance grounded in the Mittens domain story; it serves as the anchor whose semantics every diagram, formula, and prose reference back to." .
