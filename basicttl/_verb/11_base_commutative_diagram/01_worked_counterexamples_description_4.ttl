silm:instances_papers_11_base_commutative_diagram_chapters_12_worked_counterexamples_avogadro_sections_01_worked_counterexamples_concrete_anchor_4_Mammal#mammal a owl:NamedIndividual ;
    rdfs:label "urn:silmaril:entity#instances.papers.11_base_commutative_diagram.chapters.12_worked_counterexamples_avogadro.sections.01_worked_counterexamples.concrete_anchor_4_Mammal#mammal" .
silm:instances_papers_11_base_commutative_diagram_chapters_12_worked_counterexamples_avogadro_sections_01_worked_counterexamples_concrete_anchor_4_Mammal#mammal silm:hasLongDescription "The Mammal is the inferred mammal class; f:Cat->Mammal. In the paper's apparatus it appears as the symbol 'Mammal', a concrete instance grounded in the Mittens domain story; it serves as the anchor whose semantics every diagram, formula, and prose reference back to." .
