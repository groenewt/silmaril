    rdfs:label "urn:silmaril:entity#instances.papers.11_base_commutative_diagram.chapters.03_cheese_face_and_siblings.sections.02_sibling_connections.concrete_anchor_13_piquotientprojection#pi_quotient_projection" .
silm:instances_papers_11_base_commutative_diagram_chapters_03_cheese_face_and_siblings_sections_02_sibling_connections_concrete_anchor_13_piquotientprojection#pi_quotient_projection silm:hasLongDescription "The pi_quotient_projection is the projection from Free(G_11) onto O_11 = Free(G_11)/R_11 enforcing the relator equations. In the paper's apparatus it appears as the symbol 'pi_quotient_projection', a concrete instance grounded in the Mittens domain story; it serves as the anchor whose semantics every diagram, formula, and prose reference back to." .
