silm:instances_papers_11_base_commutative_diagram_chapters_25_six_step_bridge_deep_dives_sections_02_presheaf_six_step_concrete_anchor_3#gluingcondition_overlap a owl:NamedIndividual ;
    rdfs:label "urn:silmaril:entity#instances.papers.11_base_commutative_diagram.chapters.25_six_step_bridge_deep_dives.sections.02_presheaf_six_step.concrete_anchor_3#gluingcondition_overlap" .
silm:instances_papers_11_base_commutative_diagram_chapters_25_six_step_bridge_deep_dives_sections_02_presheaf_six_step_concrete_anchor_3#gluingcondition_overlap silm:hasLongDescription "The GluingCondition_overlap is the gluing over the overlap of two restriction routes (direct vs. via DomesticCat): both routes must give the same Mittens-specific section. In the paper's apparatus it appears as the symbol 'GluingCondition_overlap', a concrete instance grounded in the Mittens domain story; it serves as the anchor whose semantics every diagram, formula, and prose reference back to." .
