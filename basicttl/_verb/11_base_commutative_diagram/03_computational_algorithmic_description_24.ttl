silm:instances_papers_11_base_commutative_diagram_chapters_10_alternatives_dual_computational_sections_03_computational_algorithmic_concrete_anchor_24_CocLegCompatibility#coclegcompatibility a owl:NamedIndividual ;
    rdfs:label "urn:silmaril:entity#instances.papers.11_base_commutative_diagram.chapters.10_alternatives_dual_computational.sections.03_computational_algorithmic.concrete_anchor_24_CocLegCompatibility#coclegcompatibility" .
silm:instances_papers_11_base_commutative_diagram_chapters_10_alternatives_dual_computational_sections_03_computational_algorithmic_concrete_anchor_24_CocLegCompatibility#coclegcompatibility silm:hasLongDescription "The CocLegCompatibility is the universal cocone-leg compatibility law: all incoming legs agree on the apex. In the paper's apparatus it appears as the symbol 'CocLegCompatibility', a concrete instance grounded in the Mittens domain story; it serves as the anchor whose semantics every diagram, formula, and prose reference back to." .
