silm:instances_papers_11_base_commutative_diagram_chapters_25_six_step_bridge_deep_dives_sections_02_presheaf_six_step_concrete_anchor_2#restrictionmap_rho a owl:NamedIndividual ;
    rdfs:label "urn:silmaril:entity#instances.papers.11_base_commutative_diagram.chapters.25_six_step_bridge_deep_dives.sections.02_presheaf_six_step.concrete_anchor_2#restrictionmap_rho" .
silm:instances_papers_11_base_commutative_diagram_chapters_25_six_step_bridge_deep_dives_sections_02_presheaf_six_step_concrete_anchor_2#restrictionmap_rho silm:hasLongDescription "The RestrictionMap_rho is the restriction from F(Cat) to F(Mittens): rho takes the class-level information and restricts to Mittens-specific instantiation. In the paper's apparatus it appears as the symbol 'RestrictionMap_rho', a concrete instance grounded in the Mittens domain story; it serves as the anchor whose semantics every diagram, formula, and prose reference back to." .
