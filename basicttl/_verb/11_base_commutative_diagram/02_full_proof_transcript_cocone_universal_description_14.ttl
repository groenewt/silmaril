silm:instances_papers_11_base_commutative_diagram_chapters_11_proof_transcripts_sections_02_full_proof_transcript_cocone_universal_concrete_anchor_14_R11relator#r_11_relator a owl:NamedIndividual ;
    rdfs:label "urn:silmaril:entity#instances.papers.11_base_commutative_diagram.chapters.11_proof_transcripts.sections.02_full_proof_transcript_cocone_universal.concrete_anchor_14_R11relator#r_11_relator" .
silm:instances_papers_11_base_commutative_diagram_chapters_11_proof_transcripts_sections_02_full_proof_transcript_cocone_universal_concrete_anchor_14_R11relator#r_11_relator silm:hasLongDescription "The R_11_relator is the relator pair set R_11 declaring h.c = g.f.c, c = r.a as page-11 commuting laws. In the paper's apparatus it appears as the symbol 'R_11_relator', a concrete instance grounded in the Mittens domain story; it serves as the anchor whose semantics every diagram, formula, and prose reference back to." .
