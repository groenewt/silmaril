silm:instances_papers_11_base_commutative_diagram_chapters_25_six_step_bridge_deep_dives_sections_03_kan_extension_six_step_concrete_anchor_2#pifunctor a owl:NamedIndividual ;
    rdfs:label "urn:silmaril:entity#instances.papers.11_base_commutative_diagram.chapters.25_six_step_bridge_deep_dives.sections.03_kan_extension_six_step.concrete_anchor_2#pifunctor" .
silm:instances_papers_11_base_commutative_diagram_chapters_25_six_step_bridge_deep_dives_sections_03_kan_extension_six_step_concrete_anchor_2#pifunctor silm:hasLongDescription "The PiFunctor is the quotient functor pi : Free(G_11) -> O_11; the source functor of the Kan extension. In the paper's apparatus it appears as the symbol 'PiFunctor', a concrete instance grounded in the Mittens domain story; it serves as the anchor whose semantics every diagram, formula, and prose reference back to." .
