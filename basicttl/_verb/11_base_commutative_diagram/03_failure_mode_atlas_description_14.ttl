silm:instances_papers_11_base_commutative_diagram_chapters_08_joc_and_regression_sections_03_failure_mode_atlas_concrete_anchor_14_R11relator#r_11_relator a owl:NamedIndividual ;
    rdfs:label "urn:silmaril:entity#instances.papers.11_base_commutative_diagram.chapters.08_joc_and_regression.sections.03_failure_mode_atlas.concrete_anchor_14_R11relator#r_11_relator" .
silm:instances_papers_11_base_commutative_diagram_chapters_08_joc_and_regression_sections_03_failure_mode_atlas_concrete_anchor_14_R11relator#r_11_relator silm:hasLongDescription "The R_11_relator is the relator pair set R_11 declaring h.c = g.f.c, c = r.a as page-11 commuting laws. In the paper's apparatus it appears as the symbol 'R_11_relator', a concrete instance grounded in the Mittens domain story; it serves as the anchor whose semantics every diagram, formula, and prose reference back to." .
