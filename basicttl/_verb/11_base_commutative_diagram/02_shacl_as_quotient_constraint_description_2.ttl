silm:instances_papers_11_base_commutative_diagram_chapters_27_governance_shacl_deep_dive_sections_02_shacl_as_quotient_constraint_concrete_anchor_2#quotientbyshape a owl:NamedIndividual ;
    rdfs:label "urn:silmaril:entity#instances.papers.11_base_commutative_diagram.chapters.27_governance_shacl_deep_dive.sections.02_shacl_as_quotient_constraint.concrete_anchor_2#quotientbyshape" .
silm:instances_papers_11_base_commutative_diagram_chapters_27_governance_shacl_deep_dive_sections_02_shacl_as_quotient_constraint_concrete_anchor_2#quotientbyshape silm:hasLongDescription "The QuotientByShape is the quotient of the data graph by the SHACL congruence: equivalence classes of triples modulo shape-equivalence. In the paper's apparatus it appears as the symbol 'QuotientByShape', a concrete instance grounded in the Mittens domain story; it serves as the anchor whose semantics every diagram, formula, and prose reference back to." .
