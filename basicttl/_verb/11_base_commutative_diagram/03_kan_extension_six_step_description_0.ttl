    rdfs:label "urn:silmaril:entity#instances.papers.11_base_commutative_diagram.chapters.25_six_step_bridge_deep_dives.sections.03_kan_extension_six_step.concrete_anchor_0#f_concrete" .
silm:instances_papers_11_base_commutative_diagram_chapters_25_six_step_bridge_deep_dives_sections_03_kan_extension_six_step_concrete_anchor_0#f_concrete silm:hasLongDescription "The F_concrete is a concrete F : Free(G_11) -> Set sending Cat to {Mittens, Whiskers, Felix}, DomesticCat to {Mittens, Whiskers}, Mittens to {Mittens_obj}, and arrows to inclusions. In the paper's apparatus it appears as the symbol 'F_concrete', a concrete instance grounded in the Mittens domain story; it serves as the anchor whose semantics every diagram, formula, and prose reference back to." .
