silm:instances_papers_11_base_commutative_diagram_chapters_24_rosetta_stone_cross_domain_sections_06_six_step_scaffold_exposition_concrete_anchor_0#mittenscommutingsquare a owl:NamedIndividual ;
    rdfs:label "urn:silmaril:entity#instances.papers.11_base_commutative_diagram.chapters.24_rosetta_stone_cross_domain.sections.06_six_step_scaffold_exposition.concrete_anchor_0#mittenscommutingsquare" .
silm:instances_papers_11_base_commutative_diagram_chapters_24_rosetta_stone_cross_domain_sections_06_six_step_scaffold_exposition_concrete_anchor_0#mittenscommutingsquare silm:hasLongDescription "The MittensCommutingSquare is the abstract base commutative square Cat -> {DomesticCat, Mittens} -> Mittens with relator pi(h) = pi(g circ f). In the paper's apparatus it appears as the symbol 'MittensCommutingSquare', a concrete instance grounded in the Mittens domain story; it serves as the anchor whose semantics every diagram, formula, and prose reference back to." .
