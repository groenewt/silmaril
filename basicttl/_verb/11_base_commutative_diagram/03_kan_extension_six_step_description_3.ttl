silm:instances_papers_11_base_commutative_diagram_chapters_25_six_step_bridge_deep_dives_sections_03_kan_extension_six_step_concrete_anchor_3#kancolimit_apex a owl:NamedIndividual ;
    rdfs:label "urn:silmaril:entity#instances.papers.11_base_commutative_diagram.chapters.25_six_step_bridge_deep_dives.sections.03_kan_extension_six_step.concrete_anchor_3#kancolimit_apex" .
silm:instances_papers_11_base_commutative_diagram_chapters_25_six_step_bridge_deep_dives_sections_03_kan_extension_six_step_concrete_anchor_3#kancolimit_apex silm:hasLongDescription "The KanColimit_apex is the Kan-extension colimit apex: the universal cocone receiving F-images at each object of O_11. In the paper's apparatus it appears as the symbol 'KanColimit_apex', a concrete instance grounded in the Mittens domain story; it serves as the anchor whose semantics every diagram, formula, and prose reference back to." .
