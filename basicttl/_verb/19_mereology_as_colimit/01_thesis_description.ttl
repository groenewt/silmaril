silm:instances_papers_19_mereology_as_colimit_chapters_flat_sections_01_thesis_concrete_anchor#mereologydiagram a owl:NamedIndividual ;
    rdfs:label "urn:silmaril:entity#instances.papers.19_mereology_as_colimit.chapters.flat.sections.01_thesis.concrete_anchor#mereologydiagram" .
silm:instances_papers_19_mereology_as_colimit_chapters_flat_sections_01_thesis_concrete_anchor#mereologydiagram silm:hasLongDescription "The MereologyDiagram is the part-whole diagram of Mittens-the-cat, indexed by body-region tags (head, torso, paws, tail) and overlap joints. In the paper's apparatus it appears as the symbol 'D_Mittens', a concrete instance grounded in the Mittens domain story; it serves as the anchor whose semantics every diagram, formula, and prose reference back to." .
silm:instances_papers_19_mereology_as_colimit_chapters_flat_sections_01_thesis_concrete_anchor#mittenscolimit a owl:NamedIndividual ;
    rdfs:label "urn:silmaril:entity#instances.papers.19_mereology_as_colimit.chapters.flat.sections.01_thesis.concrete_anchor#mittenscolimit" .
silm:instances_papers_19_mereology_as_colimit_chapters_flat_sections_01_thesis_concrete_anchor#mittenscolimit silm:hasLongDescription "The MittensColimit is the colimit apex assembling head, torso, paws, and tail observations into the single individual Mittens-the-cat. In the paper's apparatus it appears as the symbol 'colim_D_Mittens', a concrete instance grounded in the Mittens domain story; it serves as the anchor whose semantics every diagram, formula, and prose reference back to." .
silm:instances_papers_19_mereology_as_colimit_chapters_flat_sections_01_thesis_concrete_anchor#headobservation a owl:NamedIndividual ;
    rdfs:label "urn:silmaril:entity#instances.papers.19_mereology_as_colimit.chapters.flat.sections.01_thesis.concrete_anchor#headobservation" .
silm:instances_papers_19_mereology_as_colimit_chapters_flat_sections_01_thesis_concrete_anchor#headobservation silm:hasLongDescription "The HeadObservation is the head-region olog fragment of Mittens's vet exam: left ear position, right ear position, three-color torbie eye markings. In the paper's apparatus it appears as the symbol 'HeadObs', a concrete instance grounded in the Mittens domain story; it serves as the anchor whose semantics every diagram, formula, and prose reference back to." .
silm:instances_papers_19_mereology_as_colimit_chapters_flat_sections_01_thesis_concrete_anchor#torsoobservation a owl:NamedIndividual ;
    rdfs:label "urn:silmaril:entity#instances.papers.19_mereology_as_colimit.chapters.flat.sections.01_thesis.concrete_anchor#torsoobservation" .
silm:instances_papers_19_mereology_as_colimit_chapters_flat_sections_01_thesis_concrete_anchor#torsoobservation silm:hasLongDescription "The TorsoObservation is the torso-region olog fragment of Mittens: flank patch, back stripe, belly fur density and three-color torbie pattern. In the paper's apparatus it appears as the symbol 'TorsoObs', a concrete instance grounded in the Mittens domain story; it serves as the anchor whose semantics every diagram, formula, and prose reference back to." .
silm:instances_papers_19_mereology_as_colimit_chapters_flat_sections_01_thesis_concrete_anchor#tailobservation a owl:NamedIndividual ;
    rdfs:label "urn:silmaril:entity#instances.papers.19_mereology_as_colimit.chapters.flat.sections.01_thesis.concrete_anchor#tailobservation" .
silm:instances_papers_19_mereology_as_colimit_chapters_flat_sections_01_thesis_concrete_anchor#tailobservation silm:hasLongDescription "The TailObservation is the tail-region olog fragment of Mittens: base joint, tip white tuft, length 28cm with kink near distal end. In the paper's apparatus it appears as the symbol 'TailObs', a concrete instance grounded in the Mittens domain story; it serves as the anchor whose semantics every diagram, formula, and prose reference back to." .
silm:instances_papers_19_mereology_as_colimit_chapters_flat_sections_01_thesis_concrete_anchor#neckjoint a owl:NamedIndividual ;
    rdfs:label "urn:silmaril:entity#instances.papers.19_mereology_as_colimit.chapters.flat.sections.01_thesis.concrete_anchor#neckjoint" .
silm:instances_papers_19_mereology_as_colimit_chapters_flat_sections_01_thesis_concrete_anchor#neckjoint silm:hasLongDescription "The NeckJoint is the shared anatomical joint between Mittens's head and torso observations, the apex of the head-torso pushout. In the paper's apparatus it appears as the symbol 'NeckJoint', a concrete instance grounded in the Mittens domain story; it serves as the anchor whose semantics every diagram, formula, and prose reference back to." .
silm:instances_papers_19_mereology_as_colimit_chapters_flat_sections_01_thesis_concrete_anchor#spinejoint a owl:NamedIndividual ;
    rdfs:label "urn:silmaril:entity#instances.papers.19_mereology_as_colimit.chapters.flat.sections.01_thesis.concrete_anchor#spinejoint" .
silm:instances_papers_19_mereology_as_colimit_chapters_flat_sections_01_thesis_concrete_anchor#spinejoint silm:hasLongDescription "The SpineJoint is the shared anatomical joint between Mittens's torso and tail observations, the apex of the torso-tail pushout. In the paper's apparatus it appears as the symbol 'SpineJoint', a concrete instance grounded in the Mittens domain story; it serves as the anchor whose semantics every diagram, formula, and prose reference back to." .
silm:instances_papers_19_mereology_as_colimit_chapters_flat_sections_01_thesis_concrete_anchor#vetcareplanrecord a owl:NamedIndividual ;
    rdfs:label "urn:silmaril:entity#instances.papers.19_mereology_as_colimit.chapters.flat.sections.01_thesis.concrete_anchor#vetcareplanrecord" .
silm:instances_papers_19_mereology_as_colimit_chapters_flat_sections_01_thesis_concrete_anchor#vetcareplanrecord silm:hasLongDescription "The VetCarePlanRecord is the clinical care plan record 77 generated for Mittens at the May 2026 vet visit at the Tartu Animal Clinic. In the paper's apparatus it appears as the symbol 'VetCarePlan_77', a concrete instance grounded in the Mittens domain story; it serves as the anchor whose semantics every diagram, formula, and prose reference back to." .
silm:instances_papers_19_mereology_as_colimit_chapters_flat_sections_01_thesis_concrete_anchor#mittensthecat a owl:NamedIndividual ;
    rdfs:label "urn:silmaril:entity#instances.papers.19_mereology_as_colimit.chapters.flat.sections.01_thesis.concrete_anchor#mittensthecat" .
silm:instances_papers_19_mereology_as_colimit_chapters_flat_sections_01_thesis_concrete_anchor#mittensthecat silm:hasLongDescription "The MittensTheCat is the running anchor: Mittens-the-cat, the integrated whole receiving every typed-leg observation through the cocone. In the paper's apparatus it appears as the symbol 'Mittens', a concrete instance grounded in the Mittens domain story; it serves as the anchor whose semantics every diagram, formula, and prose reference back to." .
silm:instances_papers_19_mereology_as_colimit_chapters_flat_sections_01_thesis_concrete_anchor#legoriginfunctor a owl:NamedIndividual ;
    rdfs:label "urn:silmaril:entity#instances.papers.19_mereology_as_colimit.chapters.flat.sections.01_thesis.concrete_anchor#legoriginfunctor" .
silm:instances_papers_19_mereology_as_colimit_chapters_flat_sections_01_thesis_concrete_anchor#legoriginfunctor silm:hasLongDescription "The LegOriginFunctor is the functor that picks out the origin object of a named cocone leg in the D_Mittens diagram (head, torso, evidence, role). In the paper's apparatus it appears as the symbol 'LegOrigin', a concrete instance grounded in the Mittens domain story; it serves as the anchor whose semantics every diagram, formula, and prose reference back to." .
silm:instances_papers_19_mereology_as_colimit_chapters_flat_sections_01_thesis_concrete_anchor#legcoconearrow a owl:NamedIndividual ;
    rdfs:label "urn:silmaril:entity#instances.papers.19_mereology_as_colimit.chapters.flat.sections.01_thesis.concrete_anchor#legcoconearrow" .
silm:instances_papers_19_mereology_as_colimit_chapters_flat_sections_01_thesis_concrete_anchor#legcoconearrow silm:hasLongDescription "The LegCoconeArrow is the cocone leg arrow from a typed leg origin into the Mittens apex, realizing the part-of inclusion. In the paper's apparatus it appears as the symbol 'LegCocone', a concrete instance grounded in the Mittens domain story; it serves as the anchor whose semantics every diagram, formula, and prose reference back to." .
silm:instances_papers_19_mereology_as_colimit_chapters_flat_sections_01_thesis_concrete_anchor#indexcategoryjmittens a owl:NamedIndividual ;
    rdfs:label "urn:silmaril:entity#instances.papers.19_mereology_as_colimit.chapters.flat.sections.01_thesis.concrete_anchor#indexcategoryjmittens" .
silm:instances_papers_19_mereology_as_colimit_chapters_flat_sections_01_thesis_concrete_anchor#indexcategoryjmittens silm:hasLongDescription "The IndexCategoryJMittens is the index category whose objects are typed leg tags (head, torso, tail, evidence, role, process) and arrows are overlap claims. In the paper's apparatus it appears as the symbol 'J_Mittens', a concrete instance grounded in the Mittens domain story; it serves as the anchor whose semantics every diagram, formula, and prose reference back to." .
