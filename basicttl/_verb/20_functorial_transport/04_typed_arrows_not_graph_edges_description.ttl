silm:instances_papers_20_functorial_transport_chapters_01_functors_as_typed_cross_kg_mappings_sections_04_typed_arrows_not_graph_edges_concrete_anchor#graphhomomorphism a owl:NamedIndividual ;
    rdfs:label "urn:silmaril:entity#instances.papers.20_functorial_transport.chapters.01_functors_as_typed_cross_kg_mappings.sections.04_typed_arrows_not_graph_edges.concrete_anchor#graphhomomorphism" .
silm:instances_papers_20_functorial_transport_chapters_01_functors_as_typed_cross_kg_mappings_sections_04_typed_arrows_not_graph_edges_concrete_anchor#graphhomomorphism silm:hasLongDescription "The GraphHomomorphism is a graph homomorphism on the underlying labeled directed graphs. In the paper's apparatus it appears as the symbol 'H', a concrete instance grounded in the Mittens domain story; it serves as the anchor whose semantics every diagram, formula, and prose reference back to." .
silm:instances_papers_20_functorial_transport_chapters_01_functors_as_typed_cross_kg_mappings_sections_04_typed_arrows_not_graph_edges_concrete_anchor#clinicvoid a owl:NamedIndividual ;
