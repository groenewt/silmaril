silm:instances_papers_20_functorial_transport_chapters_02_preservation_laws_as_transport_correctness_sections_04_preservation_failures_as_transport_pathologies_concrete_anchor#syntheticselfloop a owl:NamedIndividual ;
    rdfs:label "urn:silmaril:entity#instances.papers.20_functorial_transport.chapters.02_preservation_laws_as_transport_correctness.sections.04_preservation_failures_as_transport_pathologies.concrete_anchor#syntheticselfloop" .
silm:instances_papers_20_functorial_transport_chapters_02_preservation_laws_as_transport_correctness_sections_04_preservation_failures_as_transport_pathologies_concrete_anchor#syntheticselfloop silm:hasLongDescription "The SyntheticSelfLoop is F1 pathology: the transport sends a household identity to a non-identity self-loop on the clinic side. In the paper's apparatus it appears as the symbol 'synthetic-loop', a concrete instance grounded in the Mittens domain story; it serves as the anchor whose semantics every diagram, formula, and prose reference back to." .
silm:instances_papers_20_functorial_transport_chapters_02_preservation_laws_as_transport_correctness_sections_04_preservation_failures_as_transport_pathologies_concrete_anchor#lostidentity a owl:NamedIndividual ;
    rdfs:label "urn:silmaril:entity#instances.papers.20_functorial_transport.chapters.02_preservation_laws_as_transport_correctness.sections.04_preservation_failures_as_transport_pathologies.concrete_anchor#lostidentity" .
silm:instances_papers_20_functorial_transport_chapters_02_preservation_laws_as_transport_correctness_sections_04_preservation_failures_as_transport_pathologies_concrete_anchor#lostidentity silm:hasLongDescription "The LostIdentity is F1 pathology: the transport simply drops the household identity arrow; the clinic patient image has no identity declared. In the paper's apparatus it appears as the symbol 'drop-identity', a concrete instance grounded in the Mittens domain story; it serves as the anchor whose semantics every diagram, formula, and prose reference back to." .
silm:instances_papers_20_functorial_transport_chapters_02_preservation_laws_as_transport_correctness_sections_04_preservation_failures_as_transport_pathologies_concrete_anchor#compositemismatch a owl:NamedIndividual ;
    rdfs:label "urn:silmaril:entity#instances.papers.20_functorial_transport.chapters.02_preservation_laws_as_transport_correctness.sections.04_preservation_failures_as_transport_pathologies.concrete_anchor#compositemismatch" .
silm:instances_papers_20_functorial_transport_chapters_02_preservation_laws_as_transport_correctness_sections_04_preservation_failures_as_transport_pathologies_concrete_anchor#compositemismatch silm:hasLongDescription "The CompositeMismatch is F2 pathology: the transport sends the household composite to a clinic arrow not equal to the composite of the transports. In the paper's apparatus it appears as the symbol 'mismatch-composite', a concrete instance grounded in the Mittens domain story; it serves as the anchor whose semantics every diagram, formula, and prose reference back to." .
