silm:instances_papers_20_functorial_transport_chapters_04_yoneda_for_transport_sections_01_yoneda_profile_of_source_object_concrete_anchor#householdcareplan a owl:NamedIndividual ;
    rdfs:label "urn:silmaril:entity#instances.papers.20_functorial_transport.chapters.04_yoneda_for_transport.sections.01_yoneda_profile_of_source_object.concrete_anchor#householdcareplan" .
silm:instances_papers_20_functorial_transport_chapters_04_yoneda_for_transport_sections_01_yoneda_profile_of_source_object_concrete_anchor#householdcareplan silm:hasLongDescription "The HouseholdCarePlan is a generic household-side object; concretely the household's care plan for Mittens, used as a probe object. In the paper's apparatus it appears as the symbol 'X', a concrete instance grounded in the Mittens domain story; it serves as the anchor whose semantics every diagram, formula, and prose reference back to." .
silm:instances_papers_20_functorial_transport_chapters_04_yoneda_for_transport_sections_01_yoneda_profile_of_source_object_concrete_anchor#householdcareplanprobearrow a owl:NamedIndividual ;
    rdfs:label "urn:silmaril:entity#instances.papers.20_functorial_transport.chapters.04_yoneda_for_transport.sections.01_yoneda_profile_of_source_object.concrete_anchor#householdcareplanprobearrow" .
silm:instances_papers_20_functorial_transport_chapters_04_yoneda_for_transport_sections_01_yoneda_profile_of_source_object_concrete_anchor#householdcareplanprobearrow silm:hasLongDescription "The HouseholdCarePlanProbeArrow is a generic incoming-Yoneda element: a household-typed arrow from the care plan into Mittens. In the paper's apparatus it appears as the symbol 'a', a concrete instance grounded in the Mittens domain story; it serves as the anchor whose semantics every diagram, formula, and prose reference back to." .
silm:instances_papers_20_functorial_transport_chapters_04_yoneda_for_transport_sections_01_yoneda_profile_of_source_object_concrete_anchor#outgoingyonedaprofilemittens a owl:NamedIndividual ;
    rdfs:label "urn:silmaril:entity#instances.papers.20_functorial_transport.chapters.04_yoneda_for_transport.sections.01_yoneda_profile_of_source_object.concrete_anchor#outgoingyonedaprofilemittens" .
silm:instances_papers_20_functorial_transport_chapters_04_yoneda_for_transport_sections_01_yoneda_profile_of_source_object_concrete_anchor#outgoingyonedaprofilemittens silm:hasLongDescription "The OutgoingYonedaProfileMittens is the outgoing representable functor: what Mittens projects forward into the household ontology. In the paper's apparatus it appears as the symbol 'Y^out_Mittens', a concrete instance grounded in the Mittens domain story; it serves as the anchor whose semantics every diagram, formula, and prose reference back to." .
