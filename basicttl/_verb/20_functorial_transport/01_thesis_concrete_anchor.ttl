    rdfs:label "the household-side diagram on Mittens whose objects are the typed household-side legs (type, taxonPath, quality, evidence, process, role, measurement)." .
silm:instances_papers_20_functorial_transport_chapters_flat_sections_01_thesis_concrete_anchor__preservationcomparisonmap a owl:NamedIndividual ;
    rdfs:label "the comparison map colim(F o D_Mittens) -> F(colim D_Mittens) whose isomorphism is the preservation audit point." .
