silm:instances_papers_20_functorial_transport_chapters_01_functors_as_typed_cross_kg_mappings_sections_02_vetclinic_kg_as_target_category_concrete_anchor#clinicpatient a owl:NamedIndividual ;
    rdfs:label "urn:silmaril:entity#instances.papers.20_functorial_transport.chapters.01_functors_as_typed_cross_kg_mappings.sections.02_vetclinic_kg_as_target_category.concrete_anchor#clinicpatient" .
silm:instances_papers_20_functorial_transport_chapters_01_functors_as_typed_cross_kg_mappings_sections_02_vetclinic_kg_as_target_category_concrete_anchor#clinicpatient silm:hasLongDescription "The ClinicPatient is the clinic's slot for any animal it opens a chart for; not Mittens by household-name. In the paper's apparatus it appears as the symbol 'ClinicPatient', a concrete instance grounded in the Mittens domain story; it serves as the anchor whose semantics every diagram, formula, and prose reference back to." .
