silm:instances_papers_20_functorial_transport_chapters_01_functors_as_typed_cross_kg_mappings_sections_03_the_transport_functor_named_concrete_anchor#transportf a owl:NamedIndividual ;
    rdfs:label "urn:silmaril:entity#instances.papers.20_functorial_transport.chapters.01_functors_as_typed_cross_kg_mappings.sections.03_the_transport_functor_named.concrete_anchor#transportf" .
silm:instances_papers_20_functorial_transport_chapters_01_functors_as_typed_cross_kg_mappings_sections_03_the_transport_functor_named_concrete_anchor#transportf silm:hasLongDescription "The TransportF is the Vet-Imports-Household-Records functor, the named cross-KG mapping. In the paper's apparatus it appears as the symbol 'TransportF', a concrete instance grounded in the Mittens domain story; it serves as the anchor whose semantics every diagram, formula, and prose reference back to." .
silm:instances_papers_20_functorial_transport_chapters_01_functors_as_typed_cross_kg_mappings_sections_03_the_transport_functor_named_concrete_anchor#clinicpatientformittens a owl:NamedIndividual ;
    rdfs:label "urn:silmaril:entity#instances.papers.20_functorial_transport.chapters.01_functors_as_typed_cross_kg_mappings.sections.03_the_transport_functor_named.concrete_anchor#clinicpatientformittens" .
silm:instances_papers_20_functorial_transport_chapters_01_functors_as_typed_cross_kg_mappings_sections_03_the_transport_functor_named_concrete_anchor#clinicpatientformittens silm:hasLongDescription "The ClinicPatientForMittens is the clinic-side image of Mittens, equal to ClinicPatient instance for this Mittens (the slot the clinic opened). In the paper's apparatus it appears as the symbol 'TransportF(Mittens)', a concrete instance grounded in the Mittens domain story; it serves as the anchor whose semantics every diagram, formula, and prose reference back to." .
silm:instances_papers_20_functorial_transport_chapters_01_functors_as_typed_cross_kg_mappings_sections_03_the_transport_functor_named_concrete_anchor#clinicvetrecord4419 a owl:NamedIndividual ;
    rdfs:label "urn:silmaril:entity#instances.papers.20_functorial_transport.chapters.01_functors_as_typed_cross_kg_mappings.sections.03_the_transport_functor_named.concrete_anchor#clinicvetrecord4419" .
silm:instances_papers_20_functorial_transport_chapters_01_functors_as_typed_cross_kg_mappings_sections_03_the_transport_functor_named_concrete_anchor#clinicvetrecord4419 silm:hasLongDescription "The ClinicVetRecord4419 is the clinic chart record numbered 4419, image of the household's record 77 under transport. In the paper's apparatus it appears as the symbol 'TransportF(HouseVetRecord_77)', a concrete instance grounded in the Mittens domain story; it serves as the anchor whose semantics every diagram, formula, and prose reference back to." .
silm:instances_papers_20_functorial_transport_chapters_01_functors_as_typed_cross_kg_mappings_sections_03_the_transport_functor_named_concrete_anchor#derivedanchor_03_the_3 a owl:NamedIndividual ;
    rdfs:label "urn:silmaril:entity#instances.papers.20_functorial_transport.chapters.01_functors_as_typed_cross_kg_mappings.sections.03_the_transport_functor_named.concrete_anchor#derivedanchor_03_the_3" .
silm:instances_papers_20_functorial_transport_chapters_01_functors_as_typed_cross_kg_mappings_sections_03_the_transport_functor_named_concrete_anchor#derivedanchor_03_the_3 silm:hasLongDescription "The DerivedAnchor_03_the_3 is a derived anchor for the transport diagram: the clinic-side image of the household typed leg, carrying composition data. In the paper's apparatus it appears as the symbol 'DerivedAnchor_3', a concrete instance grounded in the Mittens domain story; it serves as the anchor whose semantics every diagram, formula, and prose reference back to." .
silm:instances_papers_20_functorial_transport_chapters_01_functors_as_typed_cross_kg_mappings_sections_03_the_transport_functor_named_concrete_anchor#householdhomset_03_the_4 a owl:NamedIndividual ;
    rdfs:label "urn:silmaril:entity#instances.papers.20_functorial_transport.chapters.01_functors_as_typed_cross_kg_mappings.sections.03_the_transport_functor_named.concrete_anchor#householdhomset_03_the_4" .
silm:instances_papers_20_functorial_transport_chapters_01_functors_as_typed_cross_kg_mappings_sections_03_the_transport_functor_named_concrete_anchor#householdhomset_03_the_4 silm:hasLongDescription "The HouseholdHomSet_03_the_4 is the household hom-set of typed arrows between two nodes; finite, enumerable, and preserved under transport F. In the paper's apparatus it appears as the symbol 'HomSetAnchor_4', a concrete instance grounded in the Mittens domain story; it serves as the anchor whose semantics every diagram, formula, and prose reference back to." .
silm:instances_papers_20_functorial_transport_chapters_01_functors_as_typed_cross_kg_mappings_sections_03_the_transport_functor_named_concrete_anchor#coconeapex_03_the_5 a owl:NamedIndividual ;
    rdfs:label "urn:silmaril:entity#instances.papers.20_functorial_transport.chapters.01_functors_as_typed_cross_kg_mappings.sections.03_the_transport_functor_named.concrete_anchor#coconeapex_03_the_5" .
silm:instances_papers_20_functorial_transport_chapters_01_functors_as_typed_cross_kg_mappings_sections_03_the_transport_functor_named_concrete_anchor#coconeapex_03_the_5 silm:hasLongDescription "The CoconeApex_03_the_5 is the cocone apex into which Mittens' typed household-side legs collect; the transport must preserve this colimit cocone. In the paper's apparatus it appears as the symbol 'CocomeAnchor_5', a concrete instance grounded in the Mittens domain story; it serves as the anchor whose semantics every diagram, formula, and prose reference back to." .
