silm:instances_papers_04_forge_chapters_03_materialization_spine_sections_01_interpret_step_concrete_anchor_4#mittensforgeroutingfunctor a owl:NamedIndividual ;
    rdfs:label "urn:silmaril:entity#instances.papers.04_forge.chapters.03_materialization_spine.sections.01_interpret_step.concrete_anchor_4#mittensforgeroutingfunctor" .
silm:instances_papers_04_forge_chapters_03_materialization_spine_sections_01_interpret_step_concrete_anchor_4#mittensforgeroutingfunctor silm:hasLongDescription "The MittensForgeRoutingFunctor is The routing functor R: F_04 to Backend that sends each typed source leg to a backend write target while preserving the leg's Yoneda profile (incoming and outgoing arrows). In the paper's apparatus it appears as the symbol 'RoutingFunctor', a concrete instance grounded in the Mittens domain story; it serves as the anchor whose semantics every diagram, formula, and prose reference back to." .
