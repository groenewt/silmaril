silm:instances_papers_04_forge_sections_05_philosophical_substrate_concrete_anchor_5#mittensforgeroutingfunctor a owl:NamedIndividual ;
    rdfs:label "urn:silmaril:entity#instances.papers.04_forge.sections.05_philosophical_substrate.concrete_anchor_5#mittensforgeroutingfunctor" .
silm:instances_papers_04_forge_sections_05_philosophical_substrate_concrete_anchor_5#mittensforgeroutingfunctor silm:hasLongDescription "The MittensForgeRoutingFunctor is In section 'Philosophical Substrate of the Forge' the bare symbol RuntimeCarrier anchors to MittensForgeRoutingFunctor: The routing functor R: F_04 to Backend that sends each typed source leg to a backend write target while preserving the leg's Yoneda profile (incoming and outgoing arrows)." .
