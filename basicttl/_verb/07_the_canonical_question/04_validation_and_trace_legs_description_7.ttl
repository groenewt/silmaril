silm:instances_papers_07_the_canonical_question_chapters_02_typed_legs_of_the_question_sections_04_validation_and_trace_legs_concrete_anchor_7#mittensanswerabilityprofile a owl:NamedIndividual ;
    rdfs:label "urn:silmaril:entity#instances.papers.07_the_canonical_question.chapters.02_typed_legs_of_the_question.sections.04_validation_and_trace_legs.concrete_anchor_7#mittensanswerabilityprofile" .
silm:instances_papers_07_the_canonical_question_chapters_02_typed_legs_of_the_question_sections_04_validation_and_trace_legs_concrete_anchor_7#mittensanswerabilityprofile silm:hasLongDescription "The MittensAnswerabilityProfile is the answerability profile Hom_O(Q_07, -) reading the canonical question as the set of admitted typed-answer arrows. In the paper's apparatus it appears as the symbol '\\Hom_{\\C}(-,A)', a concrete instance grounded in the Mittens domain story; it serves as the anchor whose semantics every diagram, formula, and prose reference back to." .
