silm:instances_papers_06_topology_jepa_chapters_05_vjepa_temporal_extension_sections_01_spatiotemporal_patch_category_concrete_anchor#mittensdiagramimage a owl:NamedIndividual ;
    rdfs:label "urn:silmaril:entity#instances.papers.06_topology_jepa.chapters.05_vjepa_temporal_extension.sections.01_spatiotemporal_patch_category.concrete_anchor#mittensdiagramimage" .
silm:instances_papers_06_topology_jepa_chapters_05_vjepa_temporal_extension_sections_01_spatiotemporal_patch_category_concrete_anchor#mittensdiagramimage silm:hasLongDescription "The MittensDiagramImage is the rendered image of the Mittens olog diagram (head, torso, paws, tail, body-mass 4.2 kg tag, vet-record stamp, Cat-classification arrow) input to the topology-JEPA pipeline. In the paper's apparatus it appears as the symbol 'I_Mittens', a concrete instance grounded in the Mittens domain story; it serves as the anchor whose semantics every diagram, formula, and prose reference back to." .
silm:instances_papers_06_topology_jepa_chapters_05_vjepa_temporal_extension_sections_01_spatiotemporal_patch_category_concrete_anchor#headpatch a owl:NamedIndividual ;
    rdfs:label "urn:silmaril:entity#instances.papers.06_topology_jepa.chapters.05_vjepa_temporal_extension.sections.01_spatiotemporal_patch_category.concrete_anchor#headpatch" .
silm:instances_papers_06_topology_jepa_chapters_05_vjepa_temporal_extension_sections_01_spatiotemporal_patch_category_concrete_anchor#headpatch silm:hasLongDescription "The HeadPatch is the rectangular pixel window covering the head region of Mittens-the-cat in the diagram, including the cat-classification node and its outgoing Cat arrow. In the paper's apparatus it appears as the symbol 'U_head', a concrete instance grounded in the Mittens domain story; it serves as the anchor whose semantics every diagram, formula, and prose reference back to." .
silm:instances_papers_06_topology_jepa_chapters_05_vjepa_temporal_extension_sections_01_spatiotemporal_patch_category_concrete_anchor#bodypatch a owl:NamedIndividual ;
    rdfs:label "urn:silmaril:entity#instances.papers.06_topology_jepa.chapters.05_vjepa_temporal_extension.sections.01_spatiotemporal_patch_category.concrete_anchor#bodypatch" .
silm:instances_papers_06_topology_jepa_chapters_05_vjepa_temporal_extension_sections_01_spatiotemporal_patch_category_concrete_anchor#bodypatch silm:hasLongDescription "The BodyPatch is the rectangular pixel window covering the torso of Mittens including the BodyMass 4.2 kg quality node and its measurement arrow. In the paper's apparatus it appears as the symbol 'U_body', a concrete instance grounded in the Mittens domain story; it serves as the anchor whose semantics every diagram, formula, and prose reference back to." .
