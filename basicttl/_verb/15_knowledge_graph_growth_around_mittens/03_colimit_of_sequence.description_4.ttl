silm:instances_papers_15_chapters_01_sections_03_concrete_anchor_4#canonicalinjection a owl:NamedIndividual ;
    rdfs:label "urn:silmaril:entity#instances.papers.15.chapters.01.sections.03.concrete_anchor.4#canonicalinjection" .
silm:instances_papers_15_chapters_01_sections_03_concrete_anchor_4#canonicalinjection silm:hasLongDescription "The CanonicalInjection is the canonical injection of the stage-n diagram into the colimit. In the paper's apparatus it appears as the symbol 'eta_n', a concrete instance grounded in the Mittens domain story; it serves as the anchor whose semantics every diagram, formula, and prose reference back to." .
