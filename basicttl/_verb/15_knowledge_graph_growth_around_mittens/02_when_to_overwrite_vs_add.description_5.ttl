silm:instances_papers_15_chapters_05_sections_02_concrete_anchor_5#growthactioncategory a owl:NamedIndividual ;
    rdfs:label "urn:silmaril:entity#instances.papers.15.chapters.05.sections.02.concrete_anchor.5#growthactioncategory" .
silm:instances_papers_15_chapters_05_sections_02_concrete_anchor_5#growthactioncategory silm:hasLongDescription "The GrowthActionCategory is the action category with additive and corrective sub-monoids. In the paper's apparatus it appears as the symbol 'Growth_Mittens', a concrete instance grounded in the Mittens domain story; it serves as the anchor whose semantics every diagram, formula, and prose reference back to." .
