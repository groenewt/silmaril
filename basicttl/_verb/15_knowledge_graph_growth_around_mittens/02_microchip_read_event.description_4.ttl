silm:instances_papers_15_chapters_02_sections_02_concrete_anchor_4#catspeciestype a owl:NamedIndividual ;
    rdfs:label "urn:silmaril:entity#instances.papers.15.chapters.02.sections.02.concrete_anchor.4#catspeciestype" .
silm:instances_papers_15_chapters_02_sections_02_concrete_anchor_4#catspeciestype silm:hasLongDescription "The CatSpeciesType is the species type node; the cat is rdf:type Cat. In the paper's apparatus it appears as the symbol 'Cat', a concrete instance grounded in the Mittens domain story; it serves as the anchor whose semantics every diagram, formula, and prose reference back to." .
