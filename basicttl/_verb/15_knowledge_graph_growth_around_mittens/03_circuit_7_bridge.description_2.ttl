silm:instances_papers_15_chapters_06_sections_03_concrete_anchor_2#recordedgrowthstep a owl:NamedIndividual ;
    rdfs:label "urn:silmaril:entity#instances.papers.15.chapters.06.sections.03.concrete_anchor.2#recordedgrowthstep" .
silm:instances_papers_15_chapters_06_sections_03_concrete_anchor_2#recordedgrowthstep silm:hasLongDescription "The RecordedGrowthStep is one recorded step at stage n. In the paper's apparatus it appears as the symbol '(F_n, L_n)', a concrete instance grounded in the Mittens domain story; it serves as the anchor whose semantics every diagram, formula, and prose reference back to." .
