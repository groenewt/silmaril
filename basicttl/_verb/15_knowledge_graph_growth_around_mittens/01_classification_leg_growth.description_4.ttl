silm:instances_papers_15_chapters_03_sections_01_concrete_anchor_4#refinementarrow0 a owl:NamedIndividual ;
    rdfs:label "urn:silmaril:entity#instances.papers.15.chapters.03.sections.01.concrete_anchor.4#refinementarrow0" .
silm:instances_papers_15_chapters_03_sections_01_concrete_anchor_4#refinementarrow0 silm:hasLongDescription "The RefinementArrow0 is the monic inclusion DomesticCat -> Cat. In the paper's apparatus it appears as the symbol 'rho_0', a concrete instance grounded in the Mittens domain story; it serves as the anchor whose semantics every diagram, formula, and prose reference back to." .
