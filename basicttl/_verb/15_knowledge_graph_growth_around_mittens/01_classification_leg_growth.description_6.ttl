silm:instances_papers_15_chapters_03_sections_01_concrete_anchor_6#mittens a owl:NamedIndividual ;
    rdfs:label "urn:silmaril:entity#instances.papers.15.chapters.03.sections.01.concrete_anchor.6#mittens" .
silm:instances_papers_15_chapters_03_sections_01_concrete_anchor_6#mittens silm:hasLongDescription "The Mittens is the cat; one instance of each class in the refinement chain. In the paper's apparatus it appears as the symbol 'Mittens', a concrete instance grounded in the Mittens domain story; it serves as the anchor whose semantics every diagram, formula, and prose reference back to." .
