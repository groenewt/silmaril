silm:instances_papers_15_chapters_07_sections_01_concrete_anchor_1#stagensnapshot a owl:NamedIndividual ;
    rdfs:label "urn:silmaril:entity#instances.papers.15.chapters.07.sections.01.concrete_anchor.1#stagensnapshot" .
silm:instances_papers_15_chapters_07_sections_01_concrete_anchor_1#stagensnapshot silm:hasLongDescription "The StageNSnapshot is any stage N >= max admission-stage. In the paper's apparatus it appears as the symbol 'D_Mittens^N', a concrete instance grounded in the Mittens domain story; it serves as the anchor whose semantics every diagram, formula, and prose reference back to." .
