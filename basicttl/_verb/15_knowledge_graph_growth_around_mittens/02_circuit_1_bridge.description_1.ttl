silm:instances_papers_15_chapters_06_sections_02_concrete_anchor_1#bodymarknodetype a owl:NamedIndividual ;
    rdfs:label "urn:silmaril:entity#instances.papers.15.chapters.06.sections.02.concrete_anchor.1#bodymarknodetype" .
silm:instances_papers_15_chapters_06_sections_02_concrete_anchor_1#bodymarknodetype silm:hasLongDescription "The BodyMarkNodeType is the type tag for body-mark nodes (qualities, implants, observations). In the paper's apparatus it appears as the symbol 'BodyMark', a concrete instance grounded in the Mittens domain story; it serves as the anchor whose semantics every diagram, formula, and prose reference back to." .
