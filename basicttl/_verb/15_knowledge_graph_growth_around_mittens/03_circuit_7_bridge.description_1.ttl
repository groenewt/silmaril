silm:instances_papers_15_chapters_06_sections_03_concrete_anchor_1#mittensgrowthcorpus a owl:NamedIndividual ;
    rdfs:label "urn:silmaril:entity#instances.papers.15.chapters.06.sections.03.concrete_anchor.1#mittensgrowthcorpus" .
silm:instances_papers_15_chapters_06_sections_03_concrete_anchor_1#mittensgrowthcorpus silm:hasLongDescription "The MittensGrowthCorpus is the multiset of every recorded growth step about Mittens. In the paper's apparatus it appears as the symbol 'C_Mittens', a concrete instance grounded in the Mittens domain story; it serves as the anchor whose semantics every diagram, formula, and prose reference back to." .
