silm:instances_papers_15_chapters_05_sections_01_concrete_anchor_3#correctionarrow a owl:NamedIndividual ;
    rdfs:label "urn:silmaril:entity#instances.papers.15.chapters.05.sections.01.concrete_anchor.3#correctionarrow" .
silm:instances_papers_15_chapters_05_sections_01_concrete_anchor_3#correctionarrow silm:hasLongDescription "The CorrectionArrow is the correction arrow between corrected and erroneous values. In the paper's apparatus it appears as the symbol 'corrects', a concrete instance grounded in the Mittens domain story; it serves as the anchor whose semantics every diagram, formula, and prose reference back to." .
