silm:instances_papers_05_granite_substrate_sections_03_icechunk_fanout_yoneda_hom_leg a owl:NamedIndividual ;
    rdfs:label "IcechunkFanoutYonedaHomLegExample" .
silm:instances_papers_05_granite_substrate_sections_03_icechunk_fanout_yoneda_hom_leg silm:hasExample "In 'IcechunkFanoutYonedaHomLeg', the typed legs of the Yoneda hom-profile are witnessed by concrete Mittens-domain arrows. For example, The arrow Mittens -> VetCarePlan_77 does not survive into ChunkManifest_Mittens. (02_materialization_leg.tex Theorem 1.2 Step 2)" .
