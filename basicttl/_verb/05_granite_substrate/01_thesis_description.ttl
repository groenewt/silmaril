silm:instances_papers_05_granite_substrate_chapters_flat_sections_01_thesis_concrete_anchor#graniteclosuretuple a owl:NamedIndividual ;
    rdfs:label "urn:silmaril:entity#instances.papers.05_granite_substrate.chapters.flat.sections.01_thesis.concrete_anchor#graniteclosuretuple" .
silm:instances_papers_05_granite_substrate_chapters_flat_sections_01_thesis_concrete_anchor#graniteclosuretuple silm:hasLongDescription "The GraniteClosureTuple is the Granite closure tuple (B, chi, M, A, alpha, T, V) for the Tartu vet-clinic encyclopedia entry: source body, chunk extraction, manifest family, adapter family, fusion cocone, stabilized model, validation profile." .
silm:instances_papers_05_granite_substrate_chapters_flat_sections_01_thesis_concrete_anchor#sourcebody05 a owl:NamedIndividual ;
    rdfs:label "urn:silmaril:entity#instances.papers.05_granite_substrate.chapters.flat.sections.01_thesis.concrete_anchor#sourcebody05" .
silm:instances_papers_05_granite_substrate_chapters_flat_sections_01_thesis_concrete_anchor#sourcebody05 silm:hasLongDescription "The SourceBody05 is the governed source body for entry 05_granite_substrate: all tex files under src/papers/05_granite_substrate/. In the paper's apparatus it appears as the symbol 'B', a concrete instance grounded in the Mittens domain story; it serves as the anchor whose semantics every diagram, formula, and prose reference back to." .
silm:instances_papers_05_granite_substrate_chapters_flat_sections_01_thesis_concrete_anchor#chunkextraction a owl:NamedIndividual ;
    rdfs:label "urn:silmaril:entity#instances.papers.05_granite_substrate.chapters.flat.sections.01_thesis.concrete_anchor#chunkextraction" .
silm:instances_papers_05_granite_substrate_chapters_flat_sections_01_thesis_concrete_anchor#chunkextraction silm:hasLongDescription "The ChunkExtraction is the chunk extraction morphism that reads governed sections of B and produces typed chunks, e.g. extracting the Tartu vet-record passage from 02_mittens_anchor.tex lines 44-58. In the paper's apparatus it appears as the symbol 'chi', a concrete instance grounded in the Mittens domain story; it serves as the anchor whose semantics every diagram, formula, and prose reference back to." .
silm:instances_papers_05_granite_substrate_chapters_flat_sections_01_thesis_concrete_anchor#manifestfamily a owl:NamedIndividual ;
    rdfs:label "urn:silmaril:entity#instances.papers.05_granite_substrate.chapters.flat.sections.01_thesis.concrete_anchor#manifestfamily" .
silm:instances_papers_05_granite_substrate_chapters_flat_sections_01_thesis_concrete_anchor#manifestfamily silm:hasLongDescription "The ManifestFamily is the family of chunk manifests produced for every typed chunk, including m_vet (manifest for the Tartu vet-record evidence chunk c-0x7f4a). In the paper's apparatus it appears as the symbol 'M', a concrete instance grounded in the Mittens domain story; it serves as the anchor whose semantics every diagram, formula, and prose reference back to." .
silm:instances_papers_05_granite_substrate_chapters_flat_sections_01_thesis_concrete_anchor#adapterfamily a owl:NamedIndividual ;
    rdfs:label "urn:silmaril:entity#instances.papers.05_granite_substrate.chapters.flat.sections.01_thesis.concrete_anchor#adapterfamily" .
silm:instances_papers_05_granite_substrate_chapters_flat_sections_01_thesis_concrete_anchor#adapterfamily silm:hasLongDescription "The AdapterFamily is the family of LoRA adapters specialized per leg type: A_evidence, A_classification, A_taxonomy-source, A_quality, A_process, A_role, A_storage. In the paper's apparatus it appears as the symbol 'A', a concrete instance grounded in the Mittens domain story; it serves as the anchor whose semantics every diagram, formula, and prose reference back to." .
silm:instances_papers_05_granite_substrate_chapters_flat_sections_01_thesis_concrete_anchor#fusedadapter a owl:NamedIndividual ;
    rdfs:label "urn:silmaril:entity#instances.papers.05_granite_substrate.chapters.flat.sections.01_thesis.concrete_anchor#fusedadapter" .
silm:instances_papers_05_granite_substrate_chapters_flat_sections_01_thesis_concrete_anchor#fusedadapter silm:hasLongDescription "The FusedAdapter is the DoRA-style fused adapter A_ast, the colimit of the adapter family over the leg-partition cocone. In the paper's apparatus it appears as the symbol 'A_ast', a concrete instance grounded in the Mittens domain story; it serves as the anchor whose semantics every diagram, formula, and prose reference back to." .
silm:instances_papers_05_granite_substrate_chapters_flat_sections_01_thesis_concrete_anchor#stabilizedmodel a owl:NamedIndividual ;
    rdfs:label "urn:silmaril:entity#instances.papers.05_granite_substrate.chapters.flat.sections.01_thesis.concrete_anchor#stabilizedmodel" .
silm:instances_papers_05_granite_substrate_chapters_flat_sections_01_thesis_concrete_anchor#stabilizedmodel silm:hasLongDescription "The StabilizedModel is the stabilized Granite model T_full after absorbing the fused adapter A_ast into the base model M_0. In the paper's apparatus it appears as the symbol 'T_full', a concrete instance grounded in the Mittens domain story; it serves as the anchor whose semantics every diagram, formula, and prose reference back to." .
silm:instances_papers_05_granite_substrate_chapters_flat_sections_01_thesis_concrete_anchor#validationprofile a owl:NamedIndividual ;
    rdfs:label "urn:silmaril:entity#instances.papers.05_granite_substrate.chapters.flat.sections.01_thesis.concrete_anchor#validationprofile" .
silm:instances_papers_05_granite_substrate_chapters_flat_sections_01_thesis_concrete_anchor#validationprofile silm:hasLongDescription "The ValidationProfile is the validation and repair profile for the Granite pipeline: VetRecordShape, StorageManifestShape, MittensAntiHallucinationBattery. In the paper's apparatus it appears as the symbol 'V', a concrete instance grounded in the Mittens domain story; it serves as the anchor whose semantics every diagram, formula, and prose reference back to." .
silm:instances_papers_05_granite_substrate_chapters_flat_sections_01_thesis_concrete_anchor#icechunkchunkmittens a owl:NamedIndividual ;
