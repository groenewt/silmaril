silm:instances_papers_16_one_integrated_growing_knowledge_graph_chapters_01_integration_as_colimit_of_colimits_sections_03_integrated_universal_property_concrete_anchors#combinedsourcepool a owl:NamedIndividual ;
    rdfs:label "urn:silmaril:entity#instances.papers.16_one_integrated_growing_knowledge_graph.chapters.01_integration_as_colimit_of_colimits.sections.03_integrated_universal_property.concrete_anchors#combinedsourcepool" .
silm:instances_papers_16_one_integrated_growing_knowledge_graph_chapters_01_integration_as_colimit_of_colimits_sections_03_integrated_universal_property_concrete_anchors#combinedsourcepool silm:hasLongDescription "The CombinedSourcePool is the disjoint union of the four per-entity source diagrams plus typed cross-entity arrows; concretely, the combined pool of every Mittens-source, every Pumpkin-source, every Vet77-source, and every Household-source." .
silm:instances_papers_16_one_integrated_growing_knowledge_graph_chapters_01_integration_as_colimit_of_colimits_sections_03_integrated_universal_property_concrete_anchors#flatcolimitapex a owl:NamedIndividual ;
    rdfs:label "urn:silmaril:entity#instances.papers.16_one_integrated_growing_knowledge_graph.chapters.01_integration_as_colimit_of_colimits.sections.03_integrated_universal_property.concrete_anchors#flatcolimitapex" .
silm:instances_papers_16_one_integrated_growing_knowledge_graph_chapters_01_integration_as_colimit_of_colimits_sections_03_integrated_universal_property_concrete_anchors#flatcolimitapex silm:hasLongDescription "The FlatColimitApex is the flat colimit of the combined source pool; canonically isomorphic to HouseholdKG. In the paper's apparatus it appears as the symbol 'colim D^flat', a concrete instance grounded in the Mittens domain story; it serves as the anchor whose semantics every diagram, formula, and prose reference back to." .
silm:instances_papers_16_one_integrated_growing_knowledge_graph_chapters_01_integration_as_colimit_of_colimits_sections_03_integrated_universal_property_concrete_anchors#fubinicanonicaliso a owl:NamedIndividual ;
    rdfs:label "urn:silmaril:entity#instances.papers.16_one_integrated_growing_knowledge_graph.chapters.01_integration_as_colimit_of_colimits.sections.03_integrated_universal_property.concrete_anchors#fubinicanonicaliso" .
silm:instances_papers_16_one_integrated_growing_knowledge_graph_chapters_01_integration_as_colimit_of_colimits_sections_03_integrated_universal_property_concrete_anchors#fubinicanonicaliso silm:hasLongDescription "The FubiniCanonicalIso is the canonical isomorphism kappa : colim D^flat -> HouseholdKG promised by Joy of Cats Section 11.13. In the paper's apparatus it appears as the symbol 'kappa', a concrete instance grounded in the Mittens domain story; it serves as the anchor whose semantics every diagram, formula, and prose reference back to." .
silm:instances_papers_16_one_integrated_growing_knowledge_graph_chapters_01_integration_as_colimit_of_colimits_sections_03_integrated_universal_property_concrete_anchors#audittrailquery a owl:NamedIndividual ;
    rdfs:label "urn:silmaril:entity#instances.papers.16_one_integrated_growing_knowledge_graph.chapters.01_integration_as_colimit_of_colimits.sections.03_integrated_universal_property.concrete_anchors#audittrailquery" .
silm:instances_papers_16_one_integrated_growing_knowledge_graph_chapters_01_integration_as_colimit_of_colimits_sections_03_integrated_universal_property_concrete_anchors#audittrailquery silm:hasLongDescription "The AuditTrailQuery is a concrete competing cocone target: the auditor query asking which arrows of the ontology supplied the annual vet bill. In the paper's apparatus it appears as the symbol 'X (= AnnualBill77)', a concrete instance grounded in the Mittens domain story; it serves as the anchor whose semantics every diagram, formula, and prose reference back to." .
