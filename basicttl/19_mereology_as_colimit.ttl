silm:instances_papers_19_mereology_as_colimit_chapters_10_computational_construction_sections_03_alternative_formalizations_concrete_anchor%23indexcategoryjmittens
    a owl:NamedIndividual ;
    rdfs:label "urn:silmaril:entity#instances.papers.19_mereology_as_colimit.chapters.10_computational_construction.sections.03_alternative_formalizations.concrete_anchor#indexcategoryjmittens" ;
    silm:hasLongDescription "The IndexCategoryJMittens is the index category whose objects are typed leg tags (head, torso, tail, evidence, role, process) and arrows are overlap claims. In the paper's apparatus it appears as the symbol 'J_Mittens', a concrete instance grounded in the Mittens domain story; it serves as the anchor whose semantics every diagram, formula, and prose reference back to." .

silm:instances_papers_19_mereology_as_colimit_chapters_10_computational_construction_sections_03_alternative_formalizations_concrete_anchor%23yonedaprofilemap
