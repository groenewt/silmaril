@prefix silm: <urn:silmaril:entity#> .
@prefix cco: <https://www.commoncoreontologies.org/> .
@prefix cceo: <https://www.commoncoreontologies.org/cpo#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

silm:chapter a owl:Class ;
    rdfs:label "Chapter" ;
    rdfs:comment "A modular chapter unit inside a paper-monad; each chapter encapsulates its sections via a chapter subdirectory and asserts the encapsulation invariant." .
