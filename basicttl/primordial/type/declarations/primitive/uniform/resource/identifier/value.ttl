@prefix model: <urn:silmaril:primordial:type:> .
@prefix ontology: <http://www.w3.org/2002/07/owl#> .
@prefix primitive: <urn:silmaril:prim:#> .
@prefix schema1: <http://www.w3.org/2000/01/rdf-schema#> .

<urn:silmaril:primordial:type:class:primitive:UniformResourceIdentifier> a ontology:Class,
        model:ClassDeclaration ;
    schema1:comment "Nominal polymorphic class declaration for urn:silmaril:prim:#URI. It retains the source class's exact ancestry and inherits independently typed identity, formal, physical, realization and ancestry coordinates through the primordial template. Source properties remain individually addressed contracts. This declaration is not an executable Python class or a physical admission certificate." ;
    schema1:subClassOf primitive:URI,
        <urn:silmaril:primordial:type:class:primitive:UniformResourceName> ;
    model:admissionState model:Pending ;
    model:declarationPath "basicttl/primordial/type/declarations/primitive/uniform/resource/identifier/value.ttl" ;
    model:sourceClass primitive:URI ;
    model:sourceDocument "basicttl/primitives/formal.ttl" .
