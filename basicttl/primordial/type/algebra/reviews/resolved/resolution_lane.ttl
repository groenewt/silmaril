# =====================================================================================
# resolution_lane.ttl — the RESOLUTION / marker / lifecycle spine of the V7 review lane (T-PROV).
# =====================================================================================
# The 'resolved' third of reviews/{executor,shadow,resolved}/ (D24 Modular Option A+): it mints
# (1) the reshaped-record SCOPE MARKER class the ProvenanceClosureShape targets by sh:targetClass
# (so the shape's focus is EXACTLY the reshaped records and never a fixture's fresh record node),
# (2) the D24 lane lifecycle activity chain Draft -> ExecutorValidation -> ShadowCritique ->
# Resolution -> ShadowRevalidation -> Accepted (wired by prov:wasInformedBy across the three lane
# files), the Draft/Resolution/Accepted activities + the Resolution record, and (3) on every one of
# the twenty-nine reshaped records: the scope-marker rdf:type AND the prov:wasGeneratedBy edge to
# the Draft activity (the record was GENERATED by the authoring activity; it is ATTRIBUTED to the
# executor + shadow agents in the sibling lane files). Together the three lane files make gate V7's
# dual-count (executor >= 1 AND shadow >= 1 + wasGeneratedBy) a graph fact.
#
# Design: docs/superpowers/specs/2026-09-06-w2-sp0-primordial-fold-design.md (§4 V7); D24 lifecycle.
# Plan:   docs/superpowers/plans/2026-09-06-w2-sp0-spine-fold-plan.md (Task T-PROV).
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix gprov: <urn:silmaril:type:graph:instance:instruction:code:property:governance:provenance:> .

# --- the reshaped-record SCOPE MARKER class (ProvenanceClosureShape sh:targetClass) ---
<urn:silmaril:type:graph:instance:instruction:code:property:governance:provenance:class:reshaped:record:scope>
    a owl:Class ;
    rdfs:label "reshaped-record provenance-closure scope" ;
    rdfs:comment "The scope MARKER class for the V7 provenance-closure tooth (design §4 V7): it is stamped as an rdf:type on EXACTLY the twenty-nine reshaped records of the folded spine that carry the D24 provenance quartet (the 8 presented-theory records, the 8 B4 model-record declaration classes, the 7 forgetful reduct morphisms and the 6 theorem records — every subject bearing @rel:authority / @rel:created). The ProvenanceClosureShape targets THIS class by sh:targetClass, so its focus set is precisely the reshaped records and never a fixture's fresh rec:*:record node (which carries no scope marker) — the design §4 non-vacuity discipline (a shape must have >= 1 focus, and must not accidentally range over evidence-plane witnesses). A node typed with this marker MUST be attributed to >= 1 executor AND >= 1 shadow (prov:wasAttributedTo) and carry a prov:wasGeneratedBy, or the tooth reddens. It is a Plane-4 ProvenanceArtifact annotation, orthogonal to the record's Plane-1 rec:*:record identity." .

# --- the D24 lane lifecycle activities: Draft (step 1), Resolution (step 4), Accepted (step 6) ---
<urn:silmaril:type:graph:instance:instruction:code:property:governance:provenance:activity:lifecycle:draft:sp0:spine:fold>
    a owl:NamedIndividual , prov:Activity ;
    rdfs:label "lifecycle: Draft (D24 lane step 1)" ;
    prov:wasAssociatedWith <urn:silmaril:type:graph:instance:instruction:code:property:governance:provenance:agent:executor:sp0:spine:fold> .

<urn:silmaril:type:graph:instance:instruction:code:property:governance:provenance:activity:lifecycle:resolution:sp0:spine:fold>
    a owl:NamedIndividual , prov:Activity ;
    rdfs:label "lifecycle: Resolution (D24 lane step 4)" ;
    prov:wasAssociatedWith <urn:silmaril:type:graph:instance:instruction:code:property:governance:provenance:agent:executor:sp0:spine:fold> ;
    prov:wasInformedBy <urn:silmaril:type:graph:instance:instruction:code:property:governance:provenance:activity:lifecycle:shadow:critique:sp0:spine:fold> .

<urn:silmaril:type:graph:instance:instruction:code:property:governance:provenance:activity:lifecycle:accepted:sp0:spine:fold>
    a owl:NamedIndividual , prov:Activity ;
    rdfs:label "lifecycle: Accepted (D24 lane step 6)" ;
    prov:wasAssociatedWith <urn:silmaril:type:graph:instance:instruction:code:property:governance:provenance:agent:executor:sp0:spine:fold> ;
    prov:wasInformedBy <urn:silmaril:type:graph:instance:instruction:code:property:governance:provenance:activity:lifecycle:shadow:revalidation:sp0:spine:fold> .

<urn:silmaril:type:graph:instance:instruction:code:property:governance:provenance:record:resolution:sp0:spine:fold>
    a owl:NamedIndividual , prov:Entity ;
    rdfs:label "resolution record (SP0 spine-fold V7 lane)" ;
    prov:wasGeneratedBy <urn:silmaril:type:graph:instance:instruction:code:property:governance:provenance:activity:lifecycle:resolution:sp0:spine:fold> ;
    prov:wasAttributedTo <urn:silmaril:type:graph:instance:instruction:code:property:governance:provenance:agent:executor:sp0:spine:fold> , <urn:silmaril:type:graph:instance:instruction:code:property:governance:provenance:agent:shadow:sp0:spine:fold> ;
    prov:value "Resolution: shadow-critique findings dispositioned; the ProvenanceClosureShape targets a dedicated scope marker (not the generic rec:*:record classes) so fixture record nodes are not falsely reddened, and V7 excludes Plane-2 denotata (V1: no provenance on a denotatum)." .

