    rel:structure <urn:silmaril:fixture:algebra:ring:z3:tables> ;
    rel:operation:discriminator alg:semiring:kingdom:definition:phylum:specification:class:discriminator:order:enumeration:family:operation:genus:multiplicative:species:discriminator:component:definition:instance:canonical ;
