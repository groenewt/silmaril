    rel:category:first <urn:silmaril:fixture:algebra:ring:z3:elem:0> ; rel:category:second <urn:silmaril:fixture:algebra:ring:z3:elem:2> ; rel:category:result <urn:silmaril:fixture:algebra:ring:z3:elem:0> .
<urn:silmaril:fixture:algebra:ring:z3:mul:1:0> a owl:NamedIndividual , rec:application:two:operation:record ;
    rel:structure <urn:silmaril:fixture:algebra:ring:z3:tables> ;
    rel:operation:discriminator alg:semiring:kingdom:definition:phylum:specification:class:discriminator:order:enumeration:family:operation:genus:multiplicative:species:discriminator:component:definition:instance:canonical ;
    rel:category:first <urn:silmaril:fixture:algebra:ring:z3:elem:1> ; rel:category:second <urn:silmaril:fixture:algebra:ring:z3:elem:0> ; rel:category:result <urn:silmaril:fixture:algebra:ring:z3:elem:0> .
<urn:silmaril:fixture:algebra:ring:z3:mul:1:1> a owl:NamedIndividual , rec:application:two:operation:record ;
    rel:structure <urn:silmaril:fixture:algebra:ring:z3:tables> ;
    rel:operation:discriminator alg:semiring:kingdom:definition:phylum:specification:class:discriminator:order:enumeration:family:operation:genus:multiplicative:species:discriminator:component:definition:instance:canonical ;
    rel:category:first <urn:silmaril:fixture:algebra:ring:z3:elem:1> ; rel:category:second <urn:silmaril:fixture:algebra:ring:z3:elem:1> ; rel:category:result <urn:silmaril:fixture:algebra:ring:z3:elem:1> .
# *** INJECTED VIOLATION: 1·2 should be 2 (elem:2); here corrupted to 1 (elem:1) ***
<urn:silmaril:fixture:algebra:ring:z3:mul:1:2> a owl:NamedIndividual , rec:application:two:operation:record ;
    rel:structure <urn:silmaril:fixture:algebra:ring:z3:tables> ;
    rel:operation:discriminator alg:semiring:kingdom:definition:phylum:specification:class:discriminator:order:enumeration:family:operation:genus:multiplicative:species:discriminator:component:definition:instance:canonical ;
