# =====================================================================================
# group_pos.ttl — the POSITIVE fixture for the group inverse tooth (W2 · SP0, T-GROUP).
# =====================================================================================
# Z/3 under addition {e=0, a=1, b=2}, a genuine group with two-sided identity e and a
# two-sided inverse for every element (0↔0, 1↔2, 2↔1). The full, correct Cayley table:
#   0·0=0 0·1=1 0·2=2 / 1·0=1 1·1=2 1·2=0 / 2·0=2 2·1=0 2·2=1  (addition mod 3).
# Merged onto the algebra data graph it MUST still conform (run-algebra-checks.sh step (b)
# positive polarity): the ModelShape two-sided identity tooth is satisfied (every e-row/column
# cell returns the other operand) and probes/group_law.rq returns 0 rows over it (every element
# has a two-sided inverse to e). It is the finite:checked / finite:table witness the design
# demotes to fixtures/ (D24 four-planes: element / finite-table evidence lives OUTSIDE the
# ontology data glob and the CI data graph). Its single injected-violation twin is
# fixtures/group_neg.ttl (0·0 yields a, breaking e's own inverse and the left-identity ->
# ModelShape + the probe RED). Typed rec:model:record so it is a focus of the ModelShape.
#
# Depth-gate compliance: every subject is an owl:NamedIndividual with a SPECIFIC type
# (rec:model:record / @typ:finite:element / @typ:finite:composition), never bare and never
# an owl:Class (no 200-char comment obligation in a fixture).

@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rel: <urn:silmaril:type:graph:instance:instruction:code:property:relation:> .
@prefix typ: <urn:silmaril:type:graph:instance:instruction:code:property:type:> .
@prefix rec: <urn:silmaril:type:graph:instance:instruction:code:property:grounding:ontology:basic:formal:domain:knowledge:representation:kingdom:specification:phylum:formal:contract:class:class:order:declared:family:seed:genus:registry:species:> .

# --- the model witness: Z/3 with declared two-sided identity e, finite:checked ---
<urn:silmaril:fixture:algebra:group:z3:positive>
    a owl:NamedIndividual , rec:model:record ;
    rel:notation "Z/3 under + (genuine group, identity e, inverses 0↔0 1↔2 2↔1)" ;
    rel:identity:element <urn:silmaril:fixture:algebra:group:z3:positive:elem:e> ;
    rel:validation:mode  "finite:table" ;
    rel:proof:status     "finite:checked" .

# --- carrier elements ---
<urn:silmaril:fixture:algebra:group:z3:positive:elem:e>
    a owl:NamedIndividual , typ:finite:element ;
    rel:notation "e = 0" .
<urn:silmaril:fixture:algebra:group:z3:positive:elem:a>
    a owl:NamedIndividual , typ:finite:element ;
    rel:notation "a = 1" .
<urn:silmaril:fixture:algebra:group:z3:positive:elem:b>
    a owl:NamedIndividual , typ:finite:element ;
    rel:notation "b = 2" .

# --- the reified Cayley cells (addition mod 3) — a total, correct table ---
<urn:silmaril:fixture:algebra:group:z3:positive:cell:ee>
    a owl:NamedIndividual , typ:finite:composition ;
    rel:structure       <urn:silmaril:fixture:algebra:group:z3:positive> ;
    rel:category:first  <urn:silmaril:fixture:algebra:group:z3:positive:elem:e> ;
    rel:category:second <urn:silmaril:fixture:algebra:group:z3:positive:elem:e> ;
    rel:category:result <urn:silmaril:fixture:algebra:group:z3:positive:elem:e> .
<urn:silmaril:fixture:algebra:group:z3:positive:cell:ea>
    a owl:NamedIndividual , typ:finite:composition ;
    rel:structure       <urn:silmaril:fixture:algebra:group:z3:positive> ;
    rel:category:first  <urn:silmaril:fixture:algebra:group:z3:positive:elem:e> ;
    rel:category:second <urn:silmaril:fixture:algebra:group:z3:positive:elem:a> ;
    rel:category:result <urn:silmaril:fixture:algebra:group:z3:positive:elem:a> .
<urn:silmaril:fixture:algebra:group:z3:positive:cell:eb>
    a owl:NamedIndividual , typ:finite:composition ;
    rel:structure       <urn:silmaril:fixture:algebra:group:z3:positive> ;
    rel:category:first  <urn:silmaril:fixture:algebra:group:z3:positive:elem:e> ;
    rel:category:second <urn:silmaril:fixture:algebra:group:z3:positive:elem:b> ;
    rel:category:result <urn:silmaril:fixture:algebra:group:z3:positive:elem:b> .
<urn:silmaril:fixture:algebra:group:z3:positive:cell:ae>
    a owl:NamedIndividual , typ:finite:composition ;
    rel:structure       <urn:silmaril:fixture:algebra:group:z3:positive> ;
    rel:category:first  <urn:silmaril:fixture:algebra:group:z3:positive:elem:a> ;
    rel:category:second <urn:silmaril:fixture:algebra:group:z3:positive:elem:e> ;
    rel:category:result <urn:silmaril:fixture:algebra:group:z3:positive:elem:a> .
<urn:silmaril:fixture:algebra:group:z3:positive:cell:aa>
    a owl:NamedIndividual , typ:finite:composition ;
    rel:structure       <urn:silmaril:fixture:algebra:group:z3:positive> ;
    rel:category:first  <urn:silmaril:fixture:algebra:group:z3:positive:elem:a> ;
    rel:category:second <urn:silmaril:fixture:algebra:group:z3:positive:elem:a> ;
    rel:category:result <urn:silmaril:fixture:algebra:group:z3:positive:elem:b> .
<urn:silmaril:fixture:algebra:group:z3:positive:cell:ab>
    a owl:NamedIndividual , typ:finite:composition ;
    rel:structure       <urn:silmaril:fixture:algebra:group:z3:positive> ;
    rel:category:first  <urn:silmaril:fixture:algebra:group:z3:positive:elem:a> ;
    rel:category:second <urn:silmaril:fixture:algebra:group:z3:positive:elem:b> ;
    rel:category:result <urn:silmaril:fixture:algebra:group:z3:positive:elem:e> .
<urn:silmaril:fixture:algebra:group:z3:positive:cell:be>
    a owl:NamedIndividual , typ:finite:composition ;
    rel:structure       <urn:silmaril:fixture:algebra:group:z3:positive> ;
    rel:category:first  <urn:silmaril:fixture:algebra:group:z3:positive:elem:b> ;
    rel:category:second <urn:silmaril:fixture:algebra:group:z3:positive:elem:e> ;
    rel:category:result <urn:silmaril:fixture:algebra:group:z3:positive:elem:b> .
<urn:silmaril:fixture:algebra:group:z3:positive:cell:ba>
    a owl:NamedIndividual , typ:finite:composition ;
    rel:structure       <urn:silmaril:fixture:algebra:group:z3:positive> ;
    rel:category:first  <urn:silmaril:fixture:algebra:group:z3:positive:elem:b> ;
    rel:category:second <urn:silmaril:fixture:algebra:group:z3:positive:elem:a> ;
    rel:category:result <urn:silmaril:fixture:algebra:group:z3:positive:elem:e> .
<urn:silmaril:fixture:algebra:group:z3:positive:cell:bb>
    a owl:NamedIndividual , typ:finite:composition ;
    rel:structure       <urn:silmaril:fixture:algebra:group:z3:positive> ;
    rel:category:first  <urn:silmaril:fixture:algebra:group:z3:positive:elem:b> ;
    rel:category:second <urn:silmaril:fixture:algebra:group:z3:positive:elem:b> ;
    rel:category:result <urn:silmaril:fixture:algebra:group:z3:positive:elem:a> .
