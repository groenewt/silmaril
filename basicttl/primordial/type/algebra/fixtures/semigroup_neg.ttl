# =====================================================================================
# semigroup_neg.ttl — the FAILING NEGATIVE fixture for the semigroup associativity tooth
# (W2 · SP0, T-SEMI). The materialized RED (D24: sh:conforms true alone is vacuous — a positive
# AND a failing negative per shape).
# =====================================================================================
# Z/3 under addition {e=0, a=1, b=2} with a SINGLE injected violation: the cell e·a yields b
# instead of a. Every other cell is the correct Z/3 table, so the graph is otherwise a conformant
# associative model and the ONE injected error is what bites. The single corrupted cell makes the
# table NON-ASSOCIATIVE — the characteristic semigroup-rung violation — for example the triple
# (e,a,a):
#     (e·a)·a = b·a = e        [uses the corrupted e·a = b]
#      e·(a·a) = e·b = b
#     e != b  =>  (x·y)·z != x·(y·z), associativity FAILS
# so probes/semigroup_law.rq returns >= 1 row over it (the PRIMARY, characteristic-law tooth).
#
# SHACL FLIP (why the runner's fixture iteration catches it). The associativity-specific SHACL
# NodeShape is authored later by T-SHAPES; at this rung's stage the shapes graph
# (shapes/algebra.shapes.ttl) carries no associativity tooth. The single corrupted cell is
# therefore chosen to involve the declared identity element e (e·a), so that the SAME one-cell
# error ALSO trips the existing ModelShape identity tooth (sh:targetClass rec:model:record: for a
# model with @rel:identity:element e, the left-unit e·x = x must hold — here e·a yields b, not a).
# Thus base + this negative does NOT conform: ModelShape flips conforms True->False and
# run-algebra-checks.sh step (b) records a PASS negative. One injected change, both teeth (the
# associativity probe AND the identity SHACL tooth) bite. Companion positive: fixtures/semigroup_pos.ttl.
#
# Depth-gate compliance: every subject is an owl:NamedIndividual with a SPECIFIC type
# (rec:model:record / @typ:finite:element / @typ:finite:composition), never bare and never an
# owl:Class (no 200-char comment obligation in a fixture).

@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rel: <urn:silmaril:type:graph:instance:instruction:code:property:relation:> .
@prefix typ: <urn:silmaril:type:graph:instance:instruction:code:property:type:> .
@prefix rec: <urn:silmaril:type:graph:instance:instruction:code:property:grounding:ontology:basic:formal:domain:knowledge:representation:kingdom:specification:phylum:formal:contract:class:class:order:declared:family:seed:genus:registry:species:> .

# --- the model witness: Z/3 with declared identity e (INVALID: e·a corrupted -> non-associative) ---
<urn:silmaril:fixture:algebra:semigroup:z3:negative>
    a owl:NamedIndividual , rec:model:record ;
    rel:notation "Z/3 under + (BROKEN: e·a yields b, not a -> non-associative)" ;
    rel:identity:element <urn:silmaril:fixture:algebra:semigroup:z3:negative:elem:e> .

# --- carrier elements ---
<urn:silmaril:fixture:algebra:semigroup:z3:negative:elem:e>
    a owl:NamedIndividual , typ:finite:element ;
    rel:notation "e = 0" .
<urn:silmaril:fixture:algebra:semigroup:z3:negative:elem:a>
    a owl:NamedIndividual , typ:finite:element ;
    rel:notation "a = 1" .
<urn:silmaril:fixture:algebra:semigroup:z3:negative:elem:b>
    a owl:NamedIndividual , typ:finite:element ;
    rel:notation "b = 2" .

# --- the reified Cayley cells (Z/3 addition table with e·a corrupted from a to b) ---
<urn:silmaril:fixture:algebra:semigroup:z3:negative:cell:ee>
    a owl:NamedIndividual , typ:finite:composition ;
    rel:structure       <urn:silmaril:fixture:algebra:semigroup:z3:negative> ;
    rel:category:first  <urn:silmaril:fixture:algebra:semigroup:z3:negative:elem:e> ;
    rel:category:second <urn:silmaril:fixture:algebra:semigroup:z3:negative:elem:e> ;
    rel:category:result <urn:silmaril:fixture:algebra:semigroup:z3:negative:elem:e> .
<urn:silmaril:fixture:algebra:semigroup:z3:negative:cell:ea>
    a owl:NamedIndividual , typ:finite:composition ;
    rel:structure       <urn:silmaril:fixture:algebra:semigroup:z3:negative> ;
    rel:category:first  <urn:silmaril:fixture:algebra:semigroup:z3:negative:elem:e> ;
    rel:category:second <urn:silmaril:fixture:algebra:semigroup:z3:negative:elem:a> ;
    rel:category:result <urn:silmaril:fixture:algebra:semigroup:z3:negative:elem:b> .  # INJECTED VIOLATION: should be :elem:a
<urn:silmaril:fixture:algebra:semigroup:z3:negative:cell:eb>
    a owl:NamedIndividual , typ:finite:composition ;
    rel:structure       <urn:silmaril:fixture:algebra:semigroup:z3:negative> ;
    rel:category:first  <urn:silmaril:fixture:algebra:semigroup:z3:negative:elem:e> ;
    rel:category:second <urn:silmaril:fixture:algebra:semigroup:z3:negative:elem:b> ;
    rel:category:result <urn:silmaril:fixture:algebra:semigroup:z3:negative:elem:b> .
<urn:silmaril:fixture:algebra:semigroup:z3:negative:cell:ae>
    a owl:NamedIndividual , typ:finite:composition ;
    rel:structure       <urn:silmaril:fixture:algebra:semigroup:z3:negative> ;
    rel:category:first  <urn:silmaril:fixture:algebra:semigroup:z3:negative:elem:a> ;
    rel:category:second <urn:silmaril:fixture:algebra:semigroup:z3:negative:elem:e> ;
    rel:category:result <urn:silmaril:fixture:algebra:semigroup:z3:negative:elem:a> .
<urn:silmaril:fixture:algebra:semigroup:z3:negative:cell:aa>
    a owl:NamedIndividual , typ:finite:composition ;
    rel:structure       <urn:silmaril:fixture:algebra:semigroup:z3:negative> ;
    rel:category:first  <urn:silmaril:fixture:algebra:semigroup:z3:negative:elem:a> ;
    rel:category:second <urn:silmaril:fixture:algebra:semigroup:z3:negative:elem:a> ;
    rel:category:result <urn:silmaril:fixture:algebra:semigroup:z3:negative:elem:b> .
<urn:silmaril:fixture:algebra:semigroup:z3:negative:cell:ab>
    a owl:NamedIndividual , typ:finite:composition ;
    rel:structure       <urn:silmaril:fixture:algebra:semigroup:z3:negative> ;
    rel:category:first  <urn:silmaril:fixture:algebra:semigroup:z3:negative:elem:a> ;
    rel:category:second <urn:silmaril:fixture:algebra:semigroup:z3:negative:elem:b> ;
    rel:category:result <urn:silmaril:fixture:algebra:semigroup:z3:negative:elem:e> .
<urn:silmaril:fixture:algebra:semigroup:z3:negative:cell:be>
    a owl:NamedIndividual , typ:finite:composition ;
    rel:structure       <urn:silmaril:fixture:algebra:semigroup:z3:negative> ;
    rel:category:first  <urn:silmaril:fixture:algebra:semigroup:z3:negative:elem:b> ;
    rel:category:second <urn:silmaril:fixture:algebra:semigroup:z3:negative:elem:e> ;
    rel:category:result <urn:silmaril:fixture:algebra:semigroup:z3:negative:elem:b> .
<urn:silmaril:fixture:algebra:semigroup:z3:negative:cell:ba>
    a owl:NamedIndividual , typ:finite:composition ;
    rel:structure       <urn:silmaril:fixture:algebra:semigroup:z3:negative> ;
    rel:category:first  <urn:silmaril:fixture:algebra:semigroup:z3:negative:elem:b> ;
    rel:category:second <urn:silmaril:fixture:algebra:semigroup:z3:negative:elem:a> ;
    rel:category:result <urn:silmaril:fixture:algebra:semigroup:z3:negative:elem:e> .
<urn:silmaril:fixture:algebra:semigroup:z3:negative:cell:bb>
    a owl:NamedIndividual , typ:finite:composition ;
    rel:structure       <urn:silmaril:fixture:algebra:semigroup:z3:negative> ;
    rel:category:first  <urn:silmaril:fixture:algebra:semigroup:z3:negative:elem:b> ;
    rel:category:second <urn:silmaril:fixture:algebra:semigroup:z3:negative:elem:b> ;
    rel:category:result <urn:silmaril:fixture:algebra:semigroup:z3:negative:elem:a> .
