# =====================================================================================
# quasigroup_neg.ttl — the FAILING NEGATIVE fixture for the quasigroup latin-division tooth
# (W2 · SP0, Stage 2a, T-QGRP). The materialized RED (D24: sh:conforms true alone is vacuous —
# a positive AND a failing negative per shape).
# =====================================================================================
# Z/3 under addition {e=0, a=1, b=2} with a SINGLE injected violation: the product e·a is
# changed from a to b. Every other cell is the correct Z/3 product, so the graph is otherwise a
# conformant Latin-square quasigroup witness and the ONE injected change is what bites. After the
# injection row e reads:
#   row e:  e·e=e  e·a=b  e·b=b       <- b occurs TWICE, a is MISSING (a Latin-square row broken)
# so left division by e is NOT unique: both e·a=b and e·b=b, i.e. e\b has two solutions (a and b)
# and e\a has none. This is exactly a failure of the total-and-unique-division / Latin-square law.
#
# TWO teeth catch the single collision, both flipping True->False under the injection:
#   (i) probes/quasigroup_law.rq (the latin-division tooth): cells e·a and e·b share the same
#       first operand (e) and the same result (b) with distinct second operands (a vs b) — a
#       LEFT-division collision -> the probe returns >= 1 row (RED).
#   (ii) the committed shapes/algebra.shapes.ttl ModelShape (sh:targetClass rec:model:record):
#       the collision is placed on the e-row and the model declares @rel:identity:element e (a
#       quasigroup MAY have an identity — that makes it a loop, a legitimate quasigroup witness,
#       just as fixtures/magma_pos.ttl is a magma that is also a monoid), so the left-unit tooth
#       e·x = x reads e·a = b != a and ModelShape flips conforms True->False (RED). This is what
#       the runner's fixture iteration catches, since the dedicated QuasigroupShape is a Stage-2
#       T-SHAPES deliverable not yet authored and shapes/algebra.shapes.ttl is out of this rung's
#       write scope (see fixtures/quasigroup_pos.ttl).
#
# The model witness lives HERE in fixtures/ (D24 four-planes: element / finite-table witnesses
# are EVIDENCE, outside the ontology data glob and the CI data graph), typed rec:model:record so
# it is a focus node of the shape (via sh:targetClass; the reified rows are scoped to it by
# @rel:structure). Companion positive: fixtures/quasigroup_pos.ttl (identical but e·a = a, a
# genuine Latin square).
#
# Depth-gate compliance: every subject is an owl:NamedIndividual with a SPECIFIC type
# (rec:model:record / @typ:finite:element / @typ:finite:composition), never a bare
# NamedIndividual and never an owl:Class (no 200-char comment obligation in a fixture).

@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rel: <urn:silmaril:type:graph:instance:instruction:code:property:relation:> .
@prefix typ: <urn:silmaril:type:graph:instance:instruction:code:property:type:> .
@prefix rec: <urn:silmaril:type:graph:instance:instruction:code:property:grounding:ontology:basic:formal:domain:knowledge:representation:kingdom:specification:phylum:formal:contract:class:class:order:declared:family:seed:genus:registry:species:> .

# --- the model witness: Z/3 with carrier {e,a,b}, identity e (BROKEN: e·a yields b, not a) ---
<urn:silmaril:fixture:algebra:quasigroup:z3:negative>
    a owl:NamedIndividual , rec:model:record ;
    rel:notation "Z/3 under + (BROKEN: e·a yields b, so b occurs twice in row e — Latin-square / unique-division broken)" ;
    rel:carrier:member   <urn:silmaril:fixture:algebra:quasigroup:z3:negative:elem:e> ,
                         <urn:silmaril:fixture:algebra:quasigroup:z3:negative:elem:a> ,
                         <urn:silmaril:fixture:algebra:quasigroup:z3:negative:elem:b> ;
    rel:identity:element <urn:silmaril:fixture:algebra:quasigroup:z3:negative:elem:e> .

# --- carrier elements ---
<urn:silmaril:fixture:algebra:quasigroup:z3:negative:elem:e>
    a owl:NamedIndividual , typ:finite:element ;
    rel:notation "e = 0" .
<urn:silmaril:fixture:algebra:quasigroup:z3:negative:elem:a>
    a owl:NamedIndividual , typ:finite:element ;
    rel:notation "a = 1" .
<urn:silmaril:fixture:algebra:quasigroup:z3:negative:elem:b>
    a owl:NamedIndividual , typ:finite:element ;
    rel:notation "b = 2" .

# --- the reified Cayley cells (Z/3, with the single injected collision at e·a) ---
# row e: e·e=e  e·a=b[BROKEN, should be a]  e·b=b
<urn:silmaril:fixture:algebra:quasigroup:z3:negative:cell:ee>
    a owl:NamedIndividual , typ:finite:composition ;
    rel:structure       <urn:silmaril:fixture:algebra:quasigroup:z3:negative> ;
    rel:category:first  <urn:silmaril:fixture:algebra:quasigroup:z3:negative:elem:e> ;
    rel:category:second <urn:silmaril:fixture:algebra:quasigroup:z3:negative:elem:e> ;
    rel:category:result <urn:silmaril:fixture:algebra:quasigroup:z3:negative:elem:e> .
<urn:silmaril:fixture:algebra:quasigroup:z3:negative:cell:ea>
    a owl:NamedIndividual , typ:finite:composition ;
    rel:structure       <urn:silmaril:fixture:algebra:quasigroup:z3:negative> ;
    rel:category:first  <urn:silmaril:fixture:algebra:quasigroup:z3:negative:elem:e> ;
    rel:category:second <urn:silmaril:fixture:algebra:quasigroup:z3:negative:elem:a> ;
    rel:category:result <urn:silmaril:fixture:algebra:quasigroup:z3:negative:elem:b> .  # INJECTED VIOLATION: e·a -> b (should be a); b now occurs twice in row e -> left division by e not unique
<urn:silmaril:fixture:algebra:quasigroup:z3:negative:cell:eb>
    a owl:NamedIndividual , typ:finite:composition ;
    rel:structure       <urn:silmaril:fixture:algebra:quasigroup:z3:negative> ;
    rel:category:first  <urn:silmaril:fixture:algebra:quasigroup:z3:negative:elem:e> ;
    rel:category:second <urn:silmaril:fixture:algebra:quasigroup:z3:negative:elem:b> ;
    rel:category:result <urn:silmaril:fixture:algebra:quasigroup:z3:negative:elem:b> .
# row a: a·e=a  a·a=b  a·b=e
<urn:silmaril:fixture:algebra:quasigroup:z3:negative:cell:ae>
    a owl:NamedIndividual , typ:finite:composition ;
    rel:structure       <urn:silmaril:fixture:algebra:quasigroup:z3:negative> ;
    rel:category:first  <urn:silmaril:fixture:algebra:quasigroup:z3:negative:elem:a> ;
    rel:category:second <urn:silmaril:fixture:algebra:quasigroup:z3:negative:elem:e> ;
    rel:category:result <urn:silmaril:fixture:algebra:quasigroup:z3:negative:elem:a> .
<urn:silmaril:fixture:algebra:quasigroup:z3:negative:cell:aa>
    a owl:NamedIndividual , typ:finite:composition ;
    rel:structure       <urn:silmaril:fixture:algebra:quasigroup:z3:negative> ;
    rel:category:first  <urn:silmaril:fixture:algebra:quasigroup:z3:negative:elem:a> ;
    rel:category:second <urn:silmaril:fixture:algebra:quasigroup:z3:negative:elem:a> ;
    rel:category:result <urn:silmaril:fixture:algebra:quasigroup:z3:negative:elem:b> .
<urn:silmaril:fixture:algebra:quasigroup:z3:negative:cell:ab>
    a owl:NamedIndividual , typ:finite:composition ;
    rel:structure       <urn:silmaril:fixture:algebra:quasigroup:z3:negative> ;
    rel:category:first  <urn:silmaril:fixture:algebra:quasigroup:z3:negative:elem:a> ;
    rel:category:second <urn:silmaril:fixture:algebra:quasigroup:z3:negative:elem:b> ;
    rel:category:result <urn:silmaril:fixture:algebra:quasigroup:z3:negative:elem:e> .
# row b: b·e=b  b·a=e  b·b=a
<urn:silmaril:fixture:algebra:quasigroup:z3:negative:cell:be>
    a owl:NamedIndividual , typ:finite:composition ;
    rel:structure       <urn:silmaril:fixture:algebra:quasigroup:z3:negative> ;
    rel:category:first  <urn:silmaril:fixture:algebra:quasigroup:z3:negative:elem:b> ;
    rel:category:second <urn:silmaril:fixture:algebra:quasigroup:z3:negative:elem:e> ;
    rel:category:result <urn:silmaril:fixture:algebra:quasigroup:z3:negative:elem:b> .
<urn:silmaril:fixture:algebra:quasigroup:z3:negative:cell:ba>
    a owl:NamedIndividual , typ:finite:composition ;
    rel:structure       <urn:silmaril:fixture:algebra:quasigroup:z3:negative> ;
    rel:category:first  <urn:silmaril:fixture:algebra:quasigroup:z3:negative:elem:b> ;
    rel:category:second <urn:silmaril:fixture:algebra:quasigroup:z3:negative:elem:a> ;
    rel:category:result <urn:silmaril:fixture:algebra:quasigroup:z3:negative:elem:e> .
<urn:silmaril:fixture:algebra:quasigroup:z3:negative:cell:bb>
    a owl:NamedIndividual , typ:finite:composition ;
    rel:structure       <urn:silmaril:fixture:algebra:quasigroup:z3:negative> ;
    rel:category:first  <urn:silmaril:fixture:algebra:quasigroup:z3:negative:elem:b> ;
    rel:category:second <urn:silmaril:fixture:algebra:quasigroup:z3:negative:elem:b> ;
    rel:category:result <urn:silmaril:fixture:algebra:quasigroup:z3:negative:elem:a> .
