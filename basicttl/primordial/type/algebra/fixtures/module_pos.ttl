# =====================================================================================
# module_pos.ttl — the finite-table CERTIFICATE fixture (POSITIVE) for the module rung (W2 · SP0 · Stage 3a,
# T-MODULE; the rank-1 free-module witness re-expressing fnd:moduleModel, algebra_rings.ttl:759, in the
# new idiom).
# =====================================================================================
# The rank-1 free module M = {V0,V1,V2} (an additive group ~= Z/3) over the base ring GF(3), with its
# reified SCALAR ACTIONS R x M -> M (discriminated by the reified @typ:scalar:action node, scoped
# @rel:action:model -> the model):
#   1·V1 = V1     2·V1 = V2     2·V2 = V1   (2·2 = 1 mod 3, so 2·(2·V1) = V1)
# every action's result is a module vector (V0/V1/V2), so the scalar action lands back in M (R x M -> M).
# A genuine module: every scalar action is a well-typed map into M. Stamped with the D24 finite-table
# CERTIFICATE metadata @rel:proof:status "finite:checked" (the scalar actions were exhaustively checked) +
# @rel:validation:mode "finite:table" (the mode the module theory record declares, mirroring fnd:moduleModel).
# Typed rec:model:record so it is a ModuleScalarActionShape / ModelShape focus. Merged onto the algebra data
# graph it MUST still conform (run-algebra-checks.sh step (b) positive polarity): ModuleScalarActionShape
# passes over these well-typed actions; ModelShape's identity tooth is vacuous (no @rel:identity:element);
# the one-operation per-law teeth are vacuous (no reified cell is scoped @rel:structure -> the model) and
# the ring/field two-operation teeth are vacuous (no @rel:reified:table on the model — the scalar actions
# are scoped @rel:action:model, the isolation). Its matching action-law-VIOLATING negative is
# fixtures/module_neg.ttl.
# D24 four-planes: finite-table EVIDENCE under fixtures/, outside the ontology data glob and the CI graph.
#
# Depth-gate compliance: every subject is an owl:NamedIndividual with a SPECIFIC type (rec:model:record /
# @typ:scalar:action / @typ:finite:element), never bare, never owl:Class.

@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rel: <urn:silmaril:type:graph:instance:instruction:code:property:relation:> .
@prefix typ: <urn:silmaril:type:graph:instance:instruction:code:property:type:> .
@prefix rec: <urn:silmaril:type:graph:instance:instruction:code:property:grounding:ontology:basic:formal:domain:knowledge:representation:kingdom:specification:phylum:formal:contract:class:class:order:declared:family:seed:genus:registry:species:> .

# --- the finite:checked / finite:table certificate model: the rank-1 free module over GF(3) ---
<urn:silmaril:fixture:algebra:module:z3>
    a owl:NamedIndividual , rec:model:record ;
    rel:notation "rank-1 free module M={V0,V1,V2} over the ring GF(3) — finite scalar-action certificate (every action lands in M: 1·V1=V1, 2·V1=V2, 2·V2=V1)" ;
    rel:module:ring     <urn:silmaril:fixture:algebra:module:z3:ring> ;
    rel:module:vector   <urn:silmaril:fixture:algebra:module:z3:vec:0> ;
    rel:module:vector   <urn:silmaril:fixture:algebra:module:z3:vec:1> ;
    rel:module:vector   <urn:silmaril:fixture:algebra:module:z3:vec:2> ;
    rel:validation:mode "finite:table" ;
    rel:proof:status    "finite:checked" .

# --- the base ring R the module acts over (GF(3), referenced by @rel:module:ring; its scalars 1, 2 act) ---
<urn:silmaril:fixture:algebra:module:z3:ring>
    a owl:NamedIndividual , typ:finite:element ;
    rel:notation "the base ring GF(3) whose elements act on the module vectors by scalar multiplication" .

# --- module vectors (the carrier M ~= Z/3) ---
<urn:silmaril:fixture:algebra:module:z3:vec:0> a owl:NamedIndividual , typ:finite:element ; rel:notation "V0 (the zero vector 0_M)" .
<urn:silmaril:fixture:algebra:module:z3:vec:1> a owl:NamedIndividual , typ:finite:element ; rel:notation "V1 (the generator vector)" .
<urn:silmaril:fixture:algebra:module:z3:vec:2> a owl:NamedIndividual , typ:finite:element ; rel:notation "V2 = 2·V1" .

# --- ring scalars (elements of the base ring GF(3) that act) ---
<urn:silmaril:fixture:algebra:module:z3:scalar:1> a owl:NamedIndividual , typ:finite:element ; rel:notation "1 (the ring's multiplicative unit; the unit scalar 1·m=m)" .
<urn:silmaril:fixture:algebra:module:z3:scalar:2> a owl:NamedIndividual , typ:finite:element ; rel:notation "2 (a ring scalar)" .

# --- reified SCALAR ACTIONS (folds fnd:saOneV1 / fnd:saTwoV1 / fnd:saTwoV2): each result is a module
#     vector, so the action lands back in M (R x M -> M). Scoped @rel:action:model -> the model. ---
<urn:silmaril:fixture:algebra:module:z3:act:1:V1> a owl:NamedIndividual , typ:scalar:action ;
    rel:notation "1·V1 = V1 (the unit scalar fixes the generator)" ;
    rel:action:model  <urn:silmaril:fixture:algebra:module:z3> ;
    rel:action:scalar <urn:silmaril:fixture:algebra:module:z3:scalar:1> ;
    rel:action:vector <urn:silmaril:fixture:algebra:module:z3:vec:1> ;
    rel:action:result <urn:silmaril:fixture:algebra:module:z3:vec:1> .
<urn:silmaril:fixture:algebra:module:z3:act:2:V1> a owl:NamedIndividual , typ:scalar:action ;
    rel:notation "2·V1 = V2" ;
    rel:action:model  <urn:silmaril:fixture:algebra:module:z3> ;
    rel:action:scalar <urn:silmaril:fixture:algebra:module:z3:scalar:2> ;
    rel:action:vector <urn:silmaril:fixture:algebra:module:z3:vec:1> ;
    rel:action:result <urn:silmaril:fixture:algebra:module:z3:vec:2> .
<urn:silmaril:fixture:algebra:module:z3:act:2:V2> a owl:NamedIndividual , typ:scalar:action ;
    rel:notation "2·V2 = V1 (2·2 = 1 mod 3)" ;
    rel:action:model  <urn:silmaril:fixture:algebra:module:z3> ;
    rel:action:scalar <urn:silmaril:fixture:algebra:module:z3:scalar:2> ;
    rel:action:vector <urn:silmaril:fixture:algebra:module:z3:vec:2> ;
    rel:action:result <urn:silmaril:fixture:algebra:module:z3:vec:1> .
