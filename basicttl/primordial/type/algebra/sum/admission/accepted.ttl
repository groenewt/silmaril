@prefix model: <urn:silmaril:primordial:type:> .
@prefix family: <urn:silmaril:primordial:type:class:> .
@prefix primitive: <urn:silmaril:prim:#> .
@prefix ontology: <http://www.w3.org/2002/07/owl#> .
@prefix schema: <http://www.w3.org/2000/01/rdf-schema#> .

family:Accepted a ontology:Class, model:ClassDeclaration, model:Alternative ;
    schema:subClassOf family:Admission ; model:progenitor family:Admission ;
    model:discriminant family:AcceptedTag ;
    model:declarationPath "basicttl/primordial/type/algebra/sum/admission/accepted.ttl" ;
    model:field family:AcceptedValueField ;
    model:admissionState model:Pending ;
    schema:comment "Accepted[Value] is the positive constructor class of the Admission output algebra. Its one payload has an explicit invariant formal-type parameter; acceptance cannot introduce an arbitrary host object. The constructor declaration is independently addressed and does not itself constitute an acceptance witness or a runtime admission." .
family:AcceptedValueField a model:Field ; model:owner family:Accepted ; model:range family:AdmissionValueParameter ; model:referenceKind model:ValueReference ; model:multiplicity model:ExactlyOne ; model:mutability model:Immutable .
