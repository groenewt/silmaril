@prefix model: <urn:silmaril:primordial:type:> .
@prefix family: <urn:silmaril:primordial:type:class:> .
@prefix primitive: <urn:silmaril:prim:#> .
@prefix ontology: <http://www.w3.org/2002/07/owl#> .
@prefix schema: <http://www.w3.org/2000/01/rdf-schema#> .

family:ByteVector a ontology:Class, model:ClassDeclaration, model:ClosedSum ;
    schema:subClassOf primitive:PhysicalCarrier ; schema:seeAlso primitive:ByteVector ;
    model:parameter family:VectorSchemaParameter ;
    model:alternative family:EmptyByteVector, family:LinkedByteVector ;
    model:admissionState model:Pending ;
    schema:comment "ByteVector[Schema] is a closed schema-indexed algebra with Empty and Link alternatives. Empty retains explicit schema and stream revision; Link carries a schema-qualified byte occurrence and a vector tail indexed by exactly the same schema. This recursive class declaration neither uses Octet as the universal Byte nor admits a host byte array." .
family:VectorSchemaParameter a model:Parameter ; model:owner family:ByteVector ; model:bound family:ByteSchema ; model:variance model:Invariant .
family:EmptyByteVector ontology:disjointWith family:LinkedByteVector .

family:VectorHeadType a model:Application ; model:constructor family:ByteOccurrence ; model:scope family:ByteVector ; model:binding family:VectorHeadSchema .
family:VectorHeadSchema a model:Binding ; model:binds family:OccurrenceSchemaParameter ; model:argument family:VectorSchemaParameter .
family:VectorTailType a model:Application ; model:constructor family:ByteVector ; model:scope family:ByteVector ; model:binding family:VectorTailSchema .
family:VectorTailSchema a model:Binding ; model:binds family:VectorSchemaParameter ; model:argument family:VectorSchemaParameter .
