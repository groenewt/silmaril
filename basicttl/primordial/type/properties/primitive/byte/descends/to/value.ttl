<urn:silmaril:primordial:type:class:property:primitive:ByteDescendsToValue> a ontology:Class,
        model:ClassDeclaration ;
    schema1:comment "The independently named value type of urn:silmaril:prim:#byteDescendsTo. Its semantic parent is urn:silmaril:prim:#PhysicalCarrier; the role remains distinct from other fields sharing that parent. The source range is retained separately for an explicit conversion gate. This nominal declaration does not admit a host literal or provide conversion or physical byte-closure evidence." ;
    schema1:subClassOf primitive:PhysicalCarrier ;
    model:admissionState model:Pending ;
    model:declarationPath "basicttl/primordial/type/properties/primitive/byte/descends/to/value.ttl" ;
