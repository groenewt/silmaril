@prefix model: <urn:silmaril:primordial:type:> .
@prefix ontology: <http://www.w3.org/2002/07/owl#> .
@prefix primitive: <urn:silmaril:prim:#> .
@prefix schema1: <http://www.w3.org/2000/01/rdf-schema#> .

<urn:silmaril:primordial:type:class:primitive:YonedaEvaluation> model:field <urn:silmaril:primordial:type:property:primitive:EvaluationComponent> .

<urn:silmaril:primordial:type:class:property:primitive:EvaluationComponentValue> a ontology:Class,
        model:ClassDeclaration ;
    schema1:comment "The independently named value type of urn:silmaril:prim:#evalComponent. Its semantic parent is urn:silmaril:prim:#RhoComponent; the role remains distinct from other fields sharing that parent. The source range is retained separately for an explicit conversion gate. This nominal declaration does not admit a host literal or provide conversion or physical byte-closure evidence." ;
    schema1:subClassOf primitive:RhoComponent ;
    model:admissionState model:Pending ;
    model:declarationPath "basicttl/primordial/type/properties/primitive/evaluation/component/value.ttl" ;
    model:propertyRole <urn:silmaril:primordial:type:property:primitive:EvaluationComponent> .

<urn:silmaril:primordial:type:property:primitive:EvaluationComponent> a model:Field ;
    model:cardinalityAuthority model:ProposedClassContract ;
    model:multiplicity model:ExactlyOne ;
    model:mutability model:Immutable ;
    model:owner <urn:silmaril:primordial:type:class:primitive:YonedaEvaluation> ;
    model:range <urn:silmaril:primordial:type:class:property:primitive:EvaluationComponentValue> ;
    model:referenceKind model:ValueReference ;
    model:sourcePredicate primitive:evalComponent ;
    model:sourceRange primitive:RhoComponent .
