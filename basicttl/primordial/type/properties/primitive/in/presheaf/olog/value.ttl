<urn:silmaril:primordial:type:class:primitive:OlogObject> model:field <urn:silmaril:primordial:type:property:primitive:InPresheafOlog> .

<urn:silmaril:primordial:type:class:property:primitive:InPresheafOlogValue> a ontology:Class,
        model:ClassDeclaration ;
    schema1:comment "The independently named value type of urn:silmaril:prim:#inPresheafOlog. Its semantic parent is urn:silmaril:prim:#PresheafOlog; the role remains distinct from other fields sharing that parent. The source range is retained separately for an explicit conversion gate. This nominal declaration does not admit a host literal or provide conversion or physical byte-closure evidence." ;
    schema1:subClassOf primitive:PresheafOlog ;
    model:admissionState model:Pending ;
    model:declarationPath "basicttl/primordial/type/properties/primitive/in/presheaf/olog/value.ttl" ;
    model:propertyRole <urn:silmaril:primordial:type:property:primitive:InPresheafOlog> .

