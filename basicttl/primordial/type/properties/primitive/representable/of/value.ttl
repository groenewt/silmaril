@prefix model: <urn:silmaril:primordial:type:> .
@prefix ontology: <http://www.w3.org/2002/07/owl#> .
@prefix primitive: <urn:silmaril:prim:#> .
@prefix schema1: <http://www.w3.org/2000/01/rdf-schema#> .

<urn:silmaril:primordial:type:class:primitive:RepresentablePresheaf> model:field <urn:silmaril:primordial:type:property:primitive:RepresentableOf> .

<urn:silmaril:primordial:type:class:property:primitive:RepresentableOfValue> a ontology:Class,
        model:ClassDeclaration ;
    schema1:comment "The independently named value type of urn:silmaril:prim:#representableOf. Its semantic parent is urn:silmaril:prim:#FormalType; the role remains distinct from other fields sharing that parent. The source range is retained separately for an explicit conversion gate. This nominal declaration does not admit a host literal or provide conversion or physical byte-closure evidence." ;
    schema1:subClassOf primitive:FormalType ;
    model:admissionState model:Pending ;
    model:declarationPath "basicttl/primordial/type/properties/primitive/representable/of/value.ttl" ;
    model:propertyRole <urn:silmaril:primordial:type:property:primitive:RepresentableOf> .

<urn:silmaril:primordial:type:property:primitive:RepresentableOf> a model:Field ;
    model:cardinalityAuthority model:ProposedClassContract ;
    model:multiplicity model:ExactlyOne ;
    model:mutability model:Immutable ;
    model:owner <urn:silmaril:primordial:type:class:primitive:RepresentablePresheaf> ;
    model:range <urn:silmaril:primordial:type:class:property:primitive:RepresentableOfValue> ;
    model:referenceKind model:ClassReference ;
    model:sourcePredicate primitive:representableOf ;
    model:sourceRange primitive:FormalType .
