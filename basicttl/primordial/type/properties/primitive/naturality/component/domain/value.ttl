@prefix model: <urn:silmaril:primordial:type:> .
@prefix ontology: <http://www.w3.org/2002/07/owl#> .
@prefix primitive: <urn:silmaril:prim:#> .
@prefix schema1: <http://www.w3.org/2000/01/rdf-schema#> .

<urn:silmaril:primordial:type:class:primitive:NaturalitySquare> model:field <urn:silmaril:primordial:type:property:primitive:NaturalityComponentDomain> .

<urn:silmaril:primordial:type:class:property:primitive:NaturalityComponentDomainValue> a ontology:Class,
        model:ClassDeclaration ;
    schema1:comment "The independently named value type of urn:silmaril:prim:#natComponentDom. Its semantic parent is urn:silmaril:prim:#RhoComponent; the role remains distinct from other fields sharing that parent. The source range is retained separately for an explicit conversion gate. This nominal declaration does not admit a host literal or provide conversion or physical byte-closure evidence." ;
    schema1:subClassOf primitive:RhoComponent ;
    model:admissionState model:Pending ;
    model:declarationPath "basicttl/primordial/type/properties/primitive/naturality/component/domain/value.ttl" ;
    model:propertyRole <urn:silmaril:primordial:type:property:primitive:NaturalityComponentDomain> .

<urn:silmaril:primordial:type:property:primitive:NaturalityComponentDomain> a model:Field ;
    model:cardinalityAuthority model:ProposedClassContract ;
    model:multiplicity model:ExactlyOne ;
    model:mutability model:Immutable ;
    model:owner <urn:silmaril:primordial:type:class:primitive:NaturalitySquare> ;
    model:range <urn:silmaril:primordial:type:class:property:primitive:NaturalityComponentDomainValue> ;
    model:referenceKind model:ValueReference ;
    model:sourcePredicate primitive:natComponentDom ;
    model:sourceRange primitive:RhoComponent .
