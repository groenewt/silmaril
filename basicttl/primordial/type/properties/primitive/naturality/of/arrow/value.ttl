@prefix model: <urn:silmaril:primordial:type:> .
@prefix ontology: <http://www.w3.org/2002/07/owl#> .
@prefix primitive: <urn:silmaril:prim:#> .
@prefix schema1: <http://www.w3.org/2000/01/rdf-schema#> .

<urn:silmaril:primordial:type:class:primitive:NaturalitySquare> model:field <urn:silmaril:primordial:type:property:primitive:NaturalityOfArrow> .

<urn:silmaril:primordial:type:class:property:primitive:NaturalityOfArrowValue> a ontology:Class,
        model:ClassDeclaration ;
    schema1:comment "The independently named value type of urn:silmaril:prim:#natOfArrow. Its semantic parent is urn:silmaril:prim:#SubtypeArrow; the role remains distinct from other fields sharing that parent. The source range is retained separately for an explicit conversion gate. This nominal declaration does not admit a host literal or provide conversion or physical byte-closure evidence." ;
    schema1:subClassOf primitive:SubtypeArrow ;
    model:admissionState model:Pending ;
    model:declarationPath "basicttl/primordial/type/properties/primitive/naturality/of/arrow/value.ttl" ;
    model:propertyRole <urn:silmaril:primordial:type:property:primitive:NaturalityOfArrow> .

<urn:silmaril:primordial:type:property:primitive:NaturalityOfArrow> a model:Field ;
    model:cardinalityAuthority model:ProposedClassContract ;
    model:multiplicity model:ExactlyOne ;
    model:mutability model:Immutable ;
    model:owner <urn:silmaril:primordial:type:class:primitive:NaturalitySquare> ;
    model:range <urn:silmaril:primordial:type:class:property:primitive:NaturalityOfArrowValue> ;
    model:referenceKind model:ValueReference ;
    model:sourcePredicate primitive:natOfArrow ;
    model:sourceRange primitive:SubtypeArrow .
