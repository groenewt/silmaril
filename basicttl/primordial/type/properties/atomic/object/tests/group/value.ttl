<urn:silmaril:primordial:type:class:atomic:object:TestCocone> model:field <urn:silmaril:primordial:type:property:TestsGroup> .

<urn:silmaril:primordial:type:class:property:TestsGroupValue> a ontology:Class,
        model:ClassDeclaration ;
    schema1:comment "The independently named value type of urn:silmaril:aob:#testsGroup. Its semantic parent is urn:silmaril:aob:#SealedGroup; the role remains distinct from other fields sharing that parent. The source range is retained separately for an explicit conversion gate. This nominal declaration does not admit a host literal or provide conversion or physical byte-closure evidence." ;
    schema1:subClassOf atomic:SealedGroup ;
    model:admissionState model:Pending ;
    model:declarationPath "basicttl/primordial/type/properties/atomic/object/tests/group/value.ttl" ;
