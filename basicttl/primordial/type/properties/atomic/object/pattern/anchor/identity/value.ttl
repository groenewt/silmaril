@prefix atomic: <urn:silmaril:aob:#> .
@prefix model: <urn:silmaril:primordial:type:> .
@prefix ontology: <http://www.w3.org/2002/07/owl#> .
@prefix schema1: <http://www.w3.org/2000/01/rdf-schema#> .

<urn:silmaril:primordial:type:class:atomic:object:AtomicObjectAtom> model:field <urn:silmaril:primordial:type:property:PatternAnchorIdentity> .

<urn:silmaril:primordial:type:class:property:PatternAnchorIdentityValue> a ontology:Class,
        model:ClassDeclaration ;
    schema1:comment "The independently named value type of urn:silmaril:aob:#patternAnchorUrn. Its semantic parent is urn:silmaril:aob:#UpperAnchor; the role remains distinct from other fields sharing that parent. The source range is retained separately for an explicit conversion gate. This nominal declaration does not admit a host literal or provide conversion or physical byte-closure evidence." ;
    schema1:subClassOf atomic:UpperAnchor ;
    model:admissionState model:Pending ;
    model:declarationPath "basicttl/primordial/type/properties/atomic/object/pattern/anchor/identity/value.ttl" ;
    model:propertyRole <urn:silmaril:primordial:type:property:PatternAnchorIdentity> .

<urn:silmaril:primordial:type:property:PatternAnchorIdentity> a model:Field ;
    model:cardinalityAuthority model:ProposedClassContract ;
    model:multiplicity model:ExactlyOne ;
    model:mutability model:Immutable ;
    model:owner <urn:silmaril:primordial:type:class:atomic:object:AtomicObjectAtom> ;
    model:range <urn:silmaril:primordial:type:class:property:PatternAnchorIdentityValue> ;
    model:referenceKind model:ValueReference ;
    model:sourcePredicate atomic:patternAnchorUrn ;
    model:sourceRange atomic:UpperAnchor .
