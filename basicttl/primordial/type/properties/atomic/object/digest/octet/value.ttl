@prefix atomic: <urn:silmaril:aob:#> .
@prefix model: <urn:silmaril:primordial:type:> .
@prefix ontology: <http://www.w3.org/2002/07/owl#> .
@prefix primitive: <urn:silmaril:prim:#> .
@prefix schema1: <http://www.w3.org/2000/01/rdf-schema#> .

<urn:silmaril:primordial:type:class:atomic:object:HashDigest> model:field <urn:silmaril:primordial:type:property:DigestOctet> .

<urn:silmaril:primordial:type:class:property:DigestOctetValue> a ontology:Class,
        model:ClassDeclaration ;
    schema1:comment "The independently named value type of urn:silmaril:aob:#digestOctet. Its semantic parent is urn:silmaril:prim:#Octet; the role remains distinct from other fields sharing that parent. The source range is retained separately for an explicit conversion gate. This nominal declaration does not admit a host literal or provide conversion or physical byte-closure evidence." ;
    schema1:subClassOf primitive:Octet ;
    model:admissionState model:Pending ;
    model:declarationPath "basicttl/primordial/type/properties/atomic/object/digest/octet/value.ttl" ;
    model:propertyRole <urn:silmaril:primordial:type:property:DigestOctet> .

<urn:silmaril:primordial:type:property:DigestOctet> a model:Field ;
    model:cardinalityAuthority model:ProposedClassContract ;
    model:multiplicity model:UnorderedMany ;
    model:mutability model:Immutable ;
    model:owner <urn:silmaril:primordial:type:class:atomic:object:HashDigest> ;
    model:range <urn:silmaril:primordial:type:class:property:DigestOctetValue> ;
    model:referenceKind model:ValueReference ;
    model:sourcePredicate atomic:digestOctet ;
    model:sourceRange primitive:Octet .
