@prefix atomic: <urn:silmaril:aob:#> .
@prefix model: <urn:silmaril:primordial:type:> .
@prefix ontology: <http://www.w3.org/2002/07/owl#> .
@prefix schema1: <http://www.w3.org/2000/01/rdf-schema#> .

<urn:silmaril:primordial:type:class:atomic:object:ObservationContract> model:field <urn:silmaril:primordial:type:property:ObservationRange> .

<urn:silmaril:primordial:type:class:property:ObservationRangeValue> a ontology:Class,
        model:ClassDeclaration ;
    schema1:comment "The independently named value type of urn:silmaril:aob:#obsARange. Its semantic parent is urn:silmaril:aob:#ObservationARange; the role remains distinct from other fields sharing that parent. The source range is retained separately for an explicit conversion gate. This nominal declaration does not admit a host literal or provide conversion or physical byte-closure evidence." ;
    schema1:subClassOf atomic:ObservationARange ;
    model:admissionState model:Pending ;
    model:declarationPath "basicttl/primordial/type/properties/atomic/object/observation/range/value.ttl" ;
    model:propertyRole <urn:silmaril:primordial:type:property:ObservationRange> .

<urn:silmaril:primordial:type:property:ObservationRange> a model:Field ;
    model:cardinalityAuthority model:ProposedClassContract ;
    model:multiplicity model:ExactlyOne ;
    model:mutability model:Immutable ;
    model:owner <urn:silmaril:primordial:type:class:atomic:object:ObservationContract> ;
    model:range <urn:silmaril:primordial:type:class:property:ObservationRangeValue> ;
    model:referenceKind model:ValueReference ;
    model:sourcePredicate atomic:obsARange ;
    model:sourceRange atomic:ObservationARange .
