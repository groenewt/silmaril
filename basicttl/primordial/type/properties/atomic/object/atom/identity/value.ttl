@prefix atomic: <urn:silmaril:aob:#> .
@prefix family: <urn:silmaril:primordial:type:class:> .
@prefix model: <urn:silmaril:primordial:type:> .
@prefix ontology: <http://www.w3.org/2002/07/owl#> .
@prefix schema1: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:silmaril:primordial:type:class:atomic:object:AtomicObjectAtom> model:field <urn:silmaril:primordial:type:property:AtomIdentity> .

<urn:silmaril:primordial:type:class:property:AtomIdentityValue> a ontology:Class,
        model:ClassDeclaration ;
    schema1:comment "The independently named value type of urn:silmaril:aob:#atomUrn. Its semantic parent is urn:silmaril:primordial:type:class:OccurrenceIdentity; the role remains distinct from other fields sharing that parent. The source range is retained separately for an explicit conversion gate. This nominal declaration does not admit a host literal or provide conversion or physical byte-closure evidence." ;
    schema1:subClassOf family:OccurrenceIdentity ;
    model:admissionState model:Pending ;
    model:declarationPath "basicttl/primordial/type/properties/atomic/object/atom/identity/value.ttl" ;
    model:propertyRole <urn:silmaril:primordial:type:property:AtomIdentity> .

<urn:silmaril:primordial:type:property:AtomIdentity> a model:Field ;
    model:cardinalityAuthority model:ProposedClassContract ;
    model:multiplicity model:ExactlyOne ;
    model:mutability model:Immutable ;
    model:owner <urn:silmaril:primordial:type:class:atomic:object:AtomicObjectAtom> ;
    model:range <urn:silmaril:primordial:type:class:property:AtomIdentityValue> ;
    model:referenceKind model:ValueReference ;
    model:requiresConversionGate model:Pending ;
    model:sourcePredicate atomic:atomUrn ;
    model:sourceRange xsd:string .
