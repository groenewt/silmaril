@prefix model: <urn:silmaril:primordial:type:> .
@prefix ontology: <http://www.w3.org/2002/07/owl#> .
@prefix schema1: <http://www.w3.org/2000/01/rdf-schema#> .

<urn:silmaril:primordial:type:class:atomic:object:AtomicObjectAtom> model:field <urn:silmaril:primordial:type:property:HasHashDigest> .

<urn:silmaril:primordial:type:class:property:HasHashDigestValue> a ontology:Class,
        model:ClassDeclaration ;
    schema1:comment "The independently named value type of urn:silmaril:aob:#hasHashDigest. Its semantic parent is urn:silmaril:aob:#HashDigest; the role remains distinct from other fields sharing that parent. The source range is retained separately for an explicit conversion gate. This nominal declaration does not admit a host literal or provide conversion or physical byte-closure evidence." ;
    schema1:subClassOf atomic:HashDigest ;
    model:admissionState model:Pending ;
    model:declarationPath "basicttl/primordial/type/properties/atomic/object/has/hash/digest/value.ttl" ;
    model:propertyRole <urn:silmaril:primordial:type:property:HasHashDigest> .

<urn:silmaril:primordial:type:property:HasHashDigest> a model:Field ;
    model:cardinalityAuthority model:ProposedClassContract ;
    model:multiplicity model:ExactlyOne ;
    model:mutability model:Immutable ;
    model:owner <urn:silmaril:primordial:type:class:atomic:object:AtomicObjectAtom> ;
    model:range <urn:silmaril:primordial:type:class:property:HasHashDigestValue> ;
    model:referenceKind model:ValueReference ;
    model:sourcePredicate atomic:hasHashDigest ;
    model:sourceRange atomic:HashDigest .
