@prefix atomic: <urn:silmaril:aob:#> .
@prefix model: <urn:silmaril:primordial:type:> .
@prefix ontology: <http://www.w3.org/2002/07/owl#> .
@prefix schema1: <http://www.w3.org/2000/01/rdf-schema#> .

<urn:silmaril:primordial:type:class:atomic:object:TestCocone> model:field <urn:silmaril:primordial:type:property:MediatedBy> .

<urn:silmaril:primordial:type:class:property:MediatedByValue> a ontology:Class,
        model:ClassDeclaration ;
    schema1:comment "The independently named value type of urn:silmaril:aob:#mediatedBy. Its semantic parent is urn:silmaril:aob:#MediatingMorphism; the role remains distinct from other fields sharing that parent. The source range is retained separately for an explicit conversion gate. This nominal declaration does not admit a host literal or provide conversion or physical byte-closure evidence." ;
    schema1:subClassOf atomic:MediatingMorphism ;
    model:admissionState model:Pending ;
    model:declarationPath "basicttl/primordial/type/properties/atomic/object/mediated/by/value.ttl" ;
    model:propertyRole <urn:silmaril:primordial:type:property:MediatedBy> .

<urn:silmaril:primordial:type:property:MediatedBy> a model:Field ;
    model:cardinalityAuthority model:ProposedClassContract ;
    model:multiplicity model:ExactlyOne ;
    model:mutability model:Immutable ;
    model:owner <urn:silmaril:primordial:type:class:atomic:object:TestCocone> ;
    model:range <urn:silmaril:primordial:type:class:property:MediatedByValue> ;
    model:referenceKind model:ValueReference ;
    model:sourcePredicate atomic:mediatedBy ;
    model:sourceRange atomic:MediatingMorphism .
