@prefix atomic: <urn:silmaril:aob:#> .
@prefix model: <urn:silmaril:primordial:type:> .
@prefix ontology: <http://www.w3.org/2002/07/owl#> .
@prefix schema1: <http://www.w3.org/2000/01/rdf-schema#> .

<urn:silmaril:primordial:type:class:atomic:object:CoconeLeg> model:field <urn:silmaril:primordial:type:property:LegTarget> .

<urn:silmaril:primordial:type:class:property:LegTargetValue> a ontology:Class,
        model:ClassDeclaration ;
    schema1:comment "The independently named value type of urn:silmaril:aob:#legTarget. Its semantic parent is urn:silmaril:aob:#TestCocone; the role remains distinct from other fields sharing that parent. The source range is retained separately for an explicit conversion gate. This nominal declaration does not admit a host literal or provide conversion or physical byte-closure evidence." ;
    schema1:subClassOf atomic:TestCocone ;
    model:admissionState model:Pending ;
    model:declarationPath "basicttl/primordial/type/properties/atomic/object/leg/target/value.ttl" ;
    model:propertyRole <urn:silmaril:primordial:type:property:LegTarget> .

<urn:silmaril:primordial:type:property:LegTarget> a model:Field ;
    model:cardinalityAuthority model:ProposedClassContract ;
    model:multiplicity model:ExactlyOne ;
    model:mutability model:Immutable ;
    model:owner <urn:silmaril:primordial:type:class:atomic:object:CoconeLeg> ;
    model:range <urn:silmaril:primordial:type:class:property:LegTargetValue> ;
    model:referenceKind model:ValueReference ;
    model:sourcePredicate atomic:legTarget ;
    model:sourceRange atomic:TestCocone .
