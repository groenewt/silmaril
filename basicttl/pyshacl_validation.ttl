@prefix silm: <urn:silmaril:entity#> .
@prefix cco: <https://www.commoncoreontologies.org/> .
@prefix cceo: <https://www.commoncoreontologies.org/cpo#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

silm:checkpyshaclvalidation a owl:Class ;
    rdfs:label "CheckPyshaclValidation" ;
    rdfs:comment "pyshacl-driven SHACL conformance between the SHACL leg and the TTL leg\nof every Layer-2 paper. SHACL NodeShapes target atom-family URIs and\nconstrain IRI patterns + cardinality + required fields per Layer-1 spec;\nTTL instances must satisfy every shape.\n" .
