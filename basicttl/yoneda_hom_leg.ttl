silm:yonedahomleg a owl:Class ;
    rdfs:label "YonedaHomLeg" ;
    rdfs:comment "A single typed leg (incoming probe arrow OR outgoing cocone arrow) attached to the central object of a paper. Carries the witness quote that grounds the leg in the source." .
