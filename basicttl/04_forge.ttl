silm:instances_papers_04_forge_chapters_01_gate_discipline_sections_02_node_typing_contract_decomposition_step_1__step_forge_morphism_for_02_node_typing_contract
    a owl:NamedIndividual ;
    rdfs:label "N ranges over proposed node names. τ(N) is the typing sentence: 'A N is a kind-of-object that predicate.' ProposedNode is the incoming name before the gate. TypedOlogBox is the result after τ." .

silm:instances_papers_04_forge_chapters_01_gate_discipline_sections_02_node_typing_contract_decomposition_step_2__step_forge_morphism_for_02_node_typing_contract
    a owl:NamedIndividual ;
    rdfs:label "The map τ is a functor from the free graph of proposed names to the olog category. Functoriality means that if node N1 has an arrow to N2 in the proposal, then τ(N1) must have a typed arrow to τ(N2) in the olog." .

silm:instances_papers_04_forge_chapters_01_gate_discipline_sections_02_node_typing_contract_decomposition_step_3__step_forge_morphism_for_02_node_typing_contract
    a owl:NamedIndividual ;
