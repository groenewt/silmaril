@prefix validation: <urn:silmaril:validation:request:> .
@prefix ontology: <http://www.w3.org/2002/07/owl#> .
@prefix schema: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix constraint: <http://www.w3.org/ns/shacl#> .
@prefix datatype: <http://www.w3.org/2001/XMLSchema#> .

validation:SourceParsing a validation:Check ;
    schema:comment "Parse every tracked Turtle source under its declared assembly context, and distinguish complete documents from prefix-dependent fragments." ;
    validation:declarationPath "basicttl/validation/request/checks/source/parsing/value.ttl" .
