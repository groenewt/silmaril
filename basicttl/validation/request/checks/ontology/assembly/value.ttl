@prefix validation: <urn:silmaril:validation:request:> .
@prefix ontology: <http://www.w3.org/2002/07/owl#> .
@prefix schema: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix constraint: <http://www.w3.org/ns/shacl#> .
@prefix datatype: <http://www.w3.org/2001/XMLSchema#> .

validation:OntologyAssembly a validation:Check ;
    schema:comment "Parse the consolidated ontology produced by the declared build and validate all required source and constraint assembly members." ;
    validation:declarationPath "basicttl/validation/request/checks/ontology/assembly/value.ttl" ;
    validation:dependsOn validation:SourceParsing .
