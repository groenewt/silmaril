@prefix validation: <urn:silmaril:validation:request:> .
@prefix ontology: <http://www.w3.org/2002/07/owl#> .
@prefix schema: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix constraint: <http://www.w3.org/ns/shacl#> .
@prefix datatype: <http://www.w3.org/2001/XMLSchema#> .

validation:DeploymentDependency a validation:Check ;
    schema:comment "Require deployment to consume artifacts from the same validated revision after required integration and browser checks succeed." ;
    validation:declarationPath "basicttl/validation/request/checks/deployment/dependency/value.ttl" ;
    validation:dependsOn validation:ContinuousIntegration .
