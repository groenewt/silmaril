@prefix validation: <urn:silmaril:validation:request:> .
@prefix ontology: <http://www.w3.org/2002/07/owl#> .
@prefix schema: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix constraint: <http://www.w3.org/ns/shacl#> .
@prefix datatype: <http://www.w3.org/2001/XMLSchema#> .

validation:EmbeddedDocuments a validation:Check ;
    schema:comment "Render the full tracked Markdown corpus inside titled document containers with nested folding, local contents and keyboard navigation." ;
    validation:declarationPath "basicttl/validation/request/checks/embedded/documents/value.ttl" ;
    validation:dependsOn validation:RootBuild, validation:ProjectBuild .
