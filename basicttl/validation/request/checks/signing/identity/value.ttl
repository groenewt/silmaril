@prefix validation: <urn:silmaril:validation:request:> .
@prefix ontology: <http://www.w3.org/2002/07/owl#> .
@prefix schema: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix constraint: <http://www.w3.org/ns/shacl#> .
@prefix datatype: <http://www.w3.org/2001/XMLSchema#> .

validation:SigningIdentity a validation:Check ;
    schema:comment "Verify the existing Aster public fingerprint against the configured signing identity; do not replace a usable key." ;
    validation:declarationPath "basicttl/validation/request/checks/signing/identity/value.ttl" .
