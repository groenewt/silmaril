@prefix validation: <urn:silmaril:validation:request:> .
@prefix ontology: <http://www.w3.org/2002/07/owl#> .
@prefix schema: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix constraint: <http://www.w3.org/ns/shacl#> .
@prefix datatype: <http://www.w3.org/2001/XMLSchema#> .

validation:CitationSources a validation:Check ;
    schema:comment "Resolve every required citation against provisioned source files in a clean checkout." ;
    validation:declarationPath "basicttl/validation/request/checks/citation/sources/value.ttl" .
