@prefix validation: <urn:silmaril:validation:request:> .
@prefix ontology: <http://www.w3.org/2002/07/owl#> .
@prefix schema: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix constraint: <http://www.w3.org/ns/shacl#> .
@prefix datatype: <http://www.w3.org/2001/XMLSchema#> .

validation:CommitSignatures a validation:Check ;
    schema:comment "Verify every candidate commit with the tracked public key and preserve its signed payload." ;
    validation:declarationPath "basicttl/validation/request/checks/commit/signatures/value.ttl" ;
    validation:dependsOn validation:SigningIdentity .
