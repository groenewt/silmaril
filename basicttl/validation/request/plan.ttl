validation:FullRequest a validation:Plan ;
    validation:requires validation:SigningIdentity, validation:CommitSignatures, validation:SignedPublication, validation:SourceParsing, validation:OntologyAssembly, validation:OntologyFloors, validation:AlgebraCounterexamples, validation:LiteralReadback, validation:CoordinateTransfer, validation:CitationSources, validation:PolymorphicModel, validation:PhysicalClasses, validation:UnaryContracts, validation:ImportAdmission, validation:RuntimeAdmission, validation:OntologyProjection, validation:RootBuild, validation:ProjectBuild, validation:EmbeddedDocuments, validation:OntologyNavigation, validation:VectorRendering, validation:MathematicalRendering, validation:Accessibility, validation:NarrativeContent, validation:ContinuousIntegration, validation:DeploymentDependency ;
    schema:comment "This plan covers the full requested audit, typed realization and generated-site work. Structural model validation is one criterion among the required checks. The completeness query reports recorded success only; runtime admission stays governed by its separate physical contracts." .
