ns2918:primary
    ns2797:context ns2359:relation ;
    ns2806:kind ns2808:exactsemantics ;
    ns2806:rationale "Transitivity is a closure law under relational composition." ;
    ns2806:translation "Φ(Transitive(R)) is R∘R⊆R." ;
