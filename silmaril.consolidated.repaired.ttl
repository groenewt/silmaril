ns2916:primary
    ns2797:context ns2356:relation ;
    ns2806:kind ns2808:exactsemantics ;
    ns2806:rationale "Functional properties are right-unique relations." ;
    ns2806:translation "Φ(Functional(R)) is ∀a,b,c((R(a,b)∧R(a,c))⇒b=c)." ;
