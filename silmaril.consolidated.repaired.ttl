ns3286:primary
    ns2797:context ns2354:translation ;
    ns2806:kind ns2808:representationbridge ;
    ns2806:rationale "XSD representation rules connect XML syntax to the component model." ;
    ns2806:translation "Φ maps XML representation items to abstract components; α maps representation constraints; β forgets concrete syntax while preserving the denoted component and satisfaction condition." ;
