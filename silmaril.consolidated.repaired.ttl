ns2859:primary
    ns2797:context ns2343:monic ;
    ns2806:kind ns2808:exactsemantics ;
    ns2806:rationale "Keys and identity constraints are observation families with injectivity conditions, not database-key syntax alone." ;
    ns2806:translation "For named individuals in the scoped class, sharing at least one value for every listed key property implies equality, with the Direct Semantics named-object restrictions. In the additional total single-valued observation profile this reduces to a jointly monic family. General OWL keys neither assert value presence nor functionality, and are not database duplicate-rejection constraints." ;
    ns2809:status ns2811:specified ;
    ns2812:resolution ns2364:six ;
    ns2813:witness ns3435:monic ;
    ns2814:construct ns2821:haskey ;
    ns2814:institution ns2818:semantics ;
