ns3308:primary
    ns2797:context ns2361:union ;
    ns2806:kind ns2808:exactsemantics ;
    ns2806:rationale "XSD union datatypes can have overlapping member value spaces and source-sensitive member selection." ;
    ns2806:translation "Φ(union(T₁,…,Tₙ)) maps to ⋃Vᵢ plus a member-selection relation recording which member lexical mapping succeeds; overlaps are retained rather than forced into disjoint tags." ;
    ns2809:status ns2811:specified ;
    ns2812:resolution ns2363:general ;
    ns2813:witness ns3453:union ;
    ns2814:construct ns3307:eight ;
