ns596:control
    ns3476:identifier "urn:silmaril:core:entity:individual:axiom:zero:requires:control" ;
    ns799:axiom "primitive" ;
    ns800:value ns803:instances ;
    ns802:progress "asserted" ;
    ns822:identifier "urn:silmaril:axiom:axiomZeroRequiresControl" ;
    ns9:root ns14:md, ns21:ttl ;
    rdf:type ns1151:specification, owl:NamedIndividual ;
