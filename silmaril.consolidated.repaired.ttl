ns804:silmaril
    dcterms:created "2026-08-19"^^xsd:date ;
    dcterms:description "A modular ontology of algebraic and homotopical specifications, n-dimensional engagement interfaces, typed plans, execution processes, external gates, evidence records, and protocol-bounded adapter execution." ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:title "Silmaril BFO–CCO–CPO Grounded Ontology" ;
    ns3469:import ns1:bfo.owl, ns5:CognitiveProcessOntology, ns7:CommonCoreOntologiesMerged ;
    ns3469:version ns805:1 ;
    ns3476:identifier "urn:silmaril:core:entity:project:ontology:silmaril" ;
    ns3486:role "preserved ontology document descriptor" ;
    owl:versionInfo "2026-08-19.1" .

