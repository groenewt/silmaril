ns597:option
    ns3471:state ns3489:declared ;
    ns3476:identifier "urn:silmaril:core:entity:individual:bargaining:benchmark:comparison:option" ;
    ns822:identifier "urn:silmaril:type:graph:instance:instruction:code:property:core:entity:individual:bargaining:benchmark:comparison:option" ;
    rdf:type ns1785:specification, owl:NamedIndividual ;
    rdfs:label "Benchmark comparison option" ;
    skos:definition "Execute a frozen trial design only after model, prompt, seed, sample-size and execution-envelope bindings validate; retain unsuccessful and unmeasured trials." .

ns598:relevance
    ns3471:state ns3489:declared ;
    ns3476:identifier "urn:silmaril:core:entity:individual:bargaining:decision:relevance" ;
    ns822:identifier "urn:silmaril:type:graph:instance:instruction:code:property:core:entity:individual:bargaining:decision:relevance" ;
    rdf:type ns1331:specification, owl:NamedIndividual ;
    rdfs:label "Mechanism-design and evaluation relevance" ;
    skos:definition "Determine whether a proposed bargaining protocol produces stable, incentive-compatible outcomes under the specified agent restrictions, and where commitment, horizon or information design changes are warranted. Distributional incidence is reported by player role; no deployed policy recommendation follows from unrun trials." .

ns599:classification
    ns3471:state ns3489:declared ;
    ns3476:identifier "urn:silmaril:core:entity:individual:bargaining:descriptive:classification" ;
    ns822:identifier "urn:silmaril:type:graph:instance:instruction:code:property:core:entity:individual:bargaining:descriptive:classification" ;
    rdf:type ns1945:specification, owl:NamedIndividual ;
    rdfs:label "Descriptive comparison with a structural benchmark" ;
    skos:definition "Classify observed agent actions descriptively relative to a finite extensive-form equilibrium benchmark. Any causal framing-effect analysis requires randomized framing and player order with a separately declared identification contract." .

ns59:algebra
    ns3476:identifier "urn:silmaril:core:entity:entity:resource:token:legacy:fungible:primordial:borel:sigma:algebra" .

ns5:CognitiveProcessOntology
    dcterms:contributor "Barry Smith", "David Gordon Limbaugh", "David Kasmier", "Jonathan Vajda" ;
    dcterms:description "This ontology is designed to represent the acts performed during the collection of information and generation of intelligence products"@en ;
    ns3469:import ns7:CommonCoreOntologiesMerged ;
    ns3469:version ns4:CognitiveProcessOntology ;
    ns3486:role "preserved ontology document descriptor" ;
    owl:versionInfo "April 28, 2025", "Version 0.92"@en ;
    rdfs:label "Cognitive Process Ontology"@en .

ns600:geography
    ns3471:state ns3489:declared ;
    ns3476:identifier "urn:silmaril:core:entity:individual:bargaining:geography" ;
    ns822:identifier "urn:silmaril:type:graph:instance:instruction:code:property:core:entity:individual:bargaining:geography" ;
    rdf:type ns1505:specification, owl:NamedIndividual ;
    rdfs:label "Nongeographic simulated market" ;
    skos:definition "A local synthetic bargaining environment. No geographic population is sampled; host location is execution provenance, not an economic geography." .

ns600:information
    ns3476:identifier "urn:silmaril:core:entity:individual:bargaining:information" ;
    ns800:value ns803:instances ;
    ns802:progress "asserted" ;
    ns822:identifier "urn:silmaril:type:graph:instance:instruction:code:property:core:entity:individual:bargaining:information" ;
    ns9:root ns14:md, ns21:ttl ;
    rdf:type ns1262:specification, owl:NamedIndividual ;
    rdfs:label "bargaining information" ;
    skos:definition "Complete-information benchmark marker." .

ns600:mechanism
    ns3471:state ns3489:declared ;
    ns3476:identifier "urn:silmaril:core:entity:individual:bargaining:mechanism" ;
    ns822:identifier "urn:silmaril:type:graph:instance:instruction:code:property:core:entity:individual:bargaining:mechanism" ;
    rdf:type ns1714:specification, owl:NamedIndividual ;
    rdfs:label "Bounded reasoning, framing and coordination hypotheses" ;
    skos:definition "Candidate mechanisms are limited backward reasoning, fairness preferences, prompt-induced conventions and coordination. These are hypotheses. Verbal rationales alone cannot discriminate strategic reasoning from pattern matching." .

ns600:outcomes
    ns3471:state ns3489:declared ;
    ns3476:identifier "urn:silmaril:core:entity:individual:bargaining:outcomes" ;
    ns822:identifier "urn:silmaril:type:graph:instance:instruction:code:property:core:entity:individual:bargaining:outcomes" ;
    rdf:type ns1791:specification, owl:NamedIndividual ;
    rdfs:label "Agreement, allocation and benchmark deviation" ;
    skos:definition "Report proposer and responder token shares, acceptance decision, agreement round, discounted payoffs, invalid-action rate and signed/absolute deviation from the equilibrium strategy at every reached subgame. Report all trials, including timeouts and failed parses." .

ns600:payoff
    ns3476:identifier "urn:silmaril:core:entity:individual:bargaining:payoff" ;
    ns800:value ns803:instances ;
    ns802:progress "asserted" ;
    ns822:identifier "urn:silmaril:type:graph:instance:instruction:code:property:core:entity:individual:bargaining:payoff" ;
    ns9:root ns14:md, ns21:ttl ;
    rdf:type ns1814:specification, owl:NamedIndividual ;
    rdfs:label "bargaining payoff" ;
    skos:definition "Payoff from accepted division and delay." .

ns600:period
    ns3471:state ns3489:declared ;
    ns3476:identifier "urn:silmaril:core:entity:individual:bargaining:period" ;
    ns822:identifier "urn:silmaril:type:graph:instance:instruction:code:property:core:entity:individual:bargaining:period" ;
    rdf:type ns2089:specification, owl:NamedIndividual ;
    rdfs:label "Four decision rounds per match" ;
    skos:definition "There are at most four offers in a match. Calendar execution timestamps will be recorded when actual trials run; none are fabricated for this proposed design." .

ns600:population
    ns3471:state ns3489:declared ;
    ns3476:identifier "urn:silmaril:core:entity:individual:bargaining:population" ;
    ns822:identifier "urn:silmaril:type:graph:instance:instruction:code:property:core:entity:individual:bargaining:population" ;
    rdf:type ns2111:specification, owl:NamedIndividual ;
    rdfs:label "Explicitly selected local model configurations" ;
    skos:definition "Target is the finite roster of locally installed model/version, prompt, sampling, seed and player-role configurations fixed before launch. The roster is currently an unresolved launch parameter. Findings do not generalize to humans or all AI models." .

ns600:prompt
    ns3476:identifier "urn:silmaril:core:entity:individual:bargaining:prompt" ;
    ns800:value ns803:instances ;
    ns802:progress "asserted" ;
    ns9:root ns14:md, ns21:ttl ;
    rdf:type ns1885:specification, owl:NamedIndividual ;
    rdfs:label "bargaining prompt" ;
    skos:definition "Exact game prompt carrier." .

ns600:question
    ns3471:state ns3489:declared ;
    ns3476:identifier "urn:silmaril:core:entity:individual:bargaining:question" ;
    ns822:identifier "urn:silmaril:type:graph:instance:instruction:code:property:core:entity:individual:bargaining:question" ;
    ns950:option ns597:option ;
    rdf:type ns1387:specification, owl:NamedIndividual ;
    rdfs:label "Bargaining deviations from equilibrium" ;
    skos:definition "How do declared local AI-agent implementations allocate surplus and accept or reject offers relative to backward-induction predictions, and how stable are deviations across models, player order, prompts, and repeated trials? No model narrative is measured human sentiment." .

ns600:timing
    ns3476:identifier "urn:silmaril:core:entity:individual:bargaining:timing" ;
    ns800:value ns803:instances ;
    ns802:progress "asserted" ;
    ns822:identifier "urn:silmaril:type:graph:instance:instruction:code:property:core:entity:individual:bargaining:timing" ;
    ns9:root ns14:md, ns21:ttl ;
    rdf:type ns2123:specification, owl:NamedIndividual ;
    rdfs:label "bargaining timing" ;
    skos:definition "Alternating-offer timing structure." .

ns600:uncertainty
    ns3471:state ns3489:declared ;
    ns3476:identifier "urn:silmaril:core:entity:individual:bargaining:uncertainty" ;
    ns822:identifier "urn:silmaril:type:graph:instance:instruction:code:property:core:entity:individual:bargaining:uncertainty" ;
    rdf:type ns2168:specification, owl:NamedIndividual ;
    rdfs:label "Repeated-trial and framing robustness" ;
    skos:definition "Proposed design crosses a prespecified model roster, two player orders, neutral versus entitlement framing, and a registered sampling/seed roster. Preserve exact model revision, prompt bytes, temperature, seed, timing, session logs and termination status. Report effect sizes and uncertainty at the independent match/session level, paired contrasts where justified, and sensitivity across framings and models. Actual roster sizes and trial counts must be sealed before launch." .

ns600:unit
    ns3471:state ns3489:declared ;
    ns3476:identifier "urn:silmaril:core:entity:individual:bargaining:unit" ;
    ns822:identifier "urn:silmaril:type:graph:instance:instruction:code:property:core:entity:individual:bargaining:unit" ;
    rdf:type ns2175:specification, owl:NamedIndividual ;
    rdfs:label "Bargaining match and decision" ;
    skos:definition "Primary unit: one complete two-player match. Secondary unit: a decision nested in a match. The analysis must not count correlated decisions as independent matches." .

