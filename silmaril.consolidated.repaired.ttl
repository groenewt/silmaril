        PREFIX silc: <urn:silmaril:type:graph:instance:instruction:code:property:core:entity:structure:class:>
        PREFIX sild: <urn:silmaril:type:graph:instance:instruction:code:property:core:entity:property:data:>
        SELECT $this WHERE {
          $this rdf:type/rdfs:subClassOf* <urn:silmaril:type:graph:instance:instruction:code:property:core:entity:structure:class:process:entity> ; <urn:silmaril:type:graph:instance:instruction:code:property:core:entity:property:data:process:identifier> ?key .
          ?other rdf:type/rdfs:subClassOf* <urn:silmaril:type:graph:instance:instruction:code:property:core:entity:structure:class:process:entity> ; <urn:silmaril:type:graph:instance:instruction:code:property:core:entity:property:data:process:identifier> ?key .
          FILTER(?other != $this)
        }""" .

