    ns2806:rationale "OWL properties and many XSD reference relations are typed binary relations, not generic magmas." ;
    ns2806:translation "Φ maps a property expression to R ⊆ A×B; α maps assertions and restrictions to relation membership or quantified fibers; β takes the binary-relation reduct." ;
    ns2809:status ns2811:specified ;
    ns2812:resolution ns2364:seven ;
    ns2813:witness ns3452:relation ;
