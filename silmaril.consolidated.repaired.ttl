ns2957:primary
    ns2797:context ns2334:predicate ;
    ns2806:kind ns2808:exactsemantics ;
    ns2806:rationale "OWL class constructors and class axioms operate on extensions as a Boolean algebra of predicates or subobjects." ;
    ns2806:translation "Φ maps a class expression C to its characteristic predicate χ_C; α maps constructors to meet, join, complement, bounds, equality, or inclusion; β takes the class-extension reduct." ;
    ns2809:status ns2811:specified ;
    ns2812:resolution ns2364:seven ;
