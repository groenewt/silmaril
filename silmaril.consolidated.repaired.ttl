ns2919:primary
    ns2797:context ns2353:converse ;
    ns2806:kind ns2808:exactsemantics ;
    ns2806:rationale "Inverse properties are modeled by the involution on typed relations." ;
    ns2806:translation "Φ(inverseOf(R,S)) is R=Sᵒᵖ; β preserves ordered pairs with coordinates exchanged." ;
