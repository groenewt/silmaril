ns783:benchmark
    ns3470:denominator "10"^^xsd:integer ;
    ns3470:numerator "9"^^xsd:integer ;
    ns3472:proposer "181"^^xsd:integer ;
    ns3472:responder "819"^^xsd:integer ;
    ns3476:identifier "urn:silmaril:core:entity:individual:subgame:perfect:equilibrium:benchmark" ;
    ns800:value ns803:instances ;
    ns802:progress "asserted" ;
    ns822:identifier "urn:silmaril:type:graph:instance:instruction:code:property:core:entity:individual:subgame:perfect:equilibrium:benchmark" ;
    ns9:root ns14:md, ns21:ttl ;
    rdf:type ns2091:specification, owl:NamedIndividual ;
    rdfs:label "subgame perfect equilibrium benchmark" ;
    repair:players "2"^^xsd:integer ;
    repair:rounds "4"^^xsd:integer ;
    repair:tokens "1000"^^xsd:integer ;
    skos:definition "Finite perfect-information bargaining game: two players split one thousand integer tokens; at most four alternating offers; player one offers first; both discount next-round payoffs by nine tenths; disagreement after round four pays zero; offers include zero and the entire pie; responders accept when indifferent. Backward induction gives first-round allocation one hundred eighty-one to player one and eight hundred nineteen to player two. This is not the infinite-horizon Rubinstein split." .

