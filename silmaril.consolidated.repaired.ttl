ns2822:primary
    ns2797:context ns2345:record ;
    ns2806:kind ns2808:representationbridge ;
    ns2806:rationale "Annotations and documentation are records attached to semantic objects, not Boolean constructors." ;
    ns2806:translation "Φ preserves named metadata fields, their subjects, values, and provenance without assigning logical force absent from the source institution." ;
    ns2809:status ns2811:specified ;
    ns2812:resolution ns2364:seven ;
    ns2813:witness ns3437:record ;
    ns2814:construct ns2821:annotation ;
