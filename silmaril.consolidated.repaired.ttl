ns2363:general
    ns3404:normative "accepted" ;
    ns3457:legacy "urn:silmaril:seed:decision:anchor:map:release:general" ;
    prov:wasAttributedTo ns3420:release ;
    prov:wasGeneratedBy ns2261:nine ;
    rdf:type ns3400:release ;
    rdfs:label "general accepted release resolution" .

ns2364:five
    dcterms:identifier "owl:q:05" ;
    ns3404:normative "accepted" ;
    ns3457:legacy "urn:silmaril:seed:decision:owl:q:05" ;
    prov:wasAttributedTo ns3420:release ;
    prov:wasGeneratedBy ns2261:nine ;
    rdf:type ns3400:release ;
    rdfs:comment "Use lowercase genus-first colon descents. Prepositions are represented only when semantically discriminating; source vocabulary is mapped to explicit nouns such as class:subsumption, property:subsumption, restriction:property, restriction:filler:universal, and annotation:definition:source." ;
    rdfs:label "owl normalized identifiers" .

ns2364:four
    dcterms:identifier "owl:q:04" ;
    ns3404:normative "accepted" ;
    ns3457:legacy "urn:silmaril:seed:decision:owl:q:04" ;
    prov:wasAttributedTo ns3420:release ;
    prov:wasGeneratedBy ns2261:nine ;
    rdf:type ns3400:release ;
    rdfs:comment "Annotation, versioning, deprecation, ontology-header, restriction-frame, membership, and disequality constructs receive primary metadata, provenance, typed-relation, or constraint gates. No construct is waived merely because it is not an algebraic operator." ;
    rdfs:label "owl metadata and versioning gates" .

ns2364:one
    dcterms:identifier "owl:q:01" ;
    ns3404:normative "accepted" ;
    ns3457:legacy "urn:silmaril:seed:decision:owl:q:01" ;
    prov:wasAttributedTo ns3420:release ;
    prov:wasGeneratedBy ns2261:nine ;
    rdf:type ns3400:release ;
    rdfs:comment "The local OWL 1 synopsis manifest contains 58 source occurrences: 50 listed constructs, 2 explicit built-ins, and 6 expansion occurrences. Every occurrence has a distinct source-record IRI. The OWL 2 supplement is counted independently." ;
    rdfs:label "owl synopsis count contract" .

ns2364:seven
    dcterms:identifier "owl:q:07" ;
    ns3404:normative "accepted" ;
    ns3457:legacy "urn:silmaril:seed:decision:owl:q:07" ;
    prov:wasAttributedTo ns3420:release ;
    prov:wasGeneratedBy ns2261:nine ;
    rdf:type ns3400:release ;
    rdfs:comment "The local owl.md manifest stays source-faithful to its OWL 1 synopsis. OWL 2-only constructs, including named individuals, property chains, qualified cardinalities, keys, negative assertions, and datatype definitions, live in the explicit OWL 2 supplement." ;
    rdfs:label "owl version scope" .

ns2364:six
    dcterms:identifier "owl:q:06" ;
    ns3404:normative "accepted" ;
    ns3457:legacy "urn:silmaril:seed:decision:owl:q:06" ;
    prov:wasAttributedTo ns3420:release ;
    prov:wasGeneratedBy ns2261:nine ;
    rdf:type ns3400:release ;
    rdfs:comment "OWL keys use the named-domain shared-value relation condition. Joint monicity is only a specialization under total single-valued observations on that scope; no unique-name assumption is introduced." ;
    rdfs:label "owl has-key source" .

ns2364:three
    dcterms:identifier "owl:q:03" ;
    ns3404:normative "accepted" ;
    ns3457:legacy "urn:silmaril:seed:decision:owl:q:03" ;
    prov:wasAttributedTo ns3420:release ;
    prov:wasGeneratedBy ns2261:nine ;
    rdf:type ns3400:release ;
    rdfs:comment "Complex classes remain an included source-tier record because owl.md names them. OWL DL global and typing side conditions are institution assumptions and supplemental constraint records, not silently merged with class constructors." ;
    rdfs:label "owl complex-class treatment" .

ns2364:two
    dcterms:identifier "owl:q:02" ;
    ns3404:normative "accepted" ;
    ns3457:legacy "urn:silmaril:seed:decision:owl:q:02" ;
    prov:wasAttributedTo ns3420:release ;
    prov:wasGeneratedBy ns2261:nine ;
    rdf:type ns3400:release ;
    rdfs:comment "Every expansion occurrence is materialized as its own source record and linked to its base construct by expansion-of. Arbitrary-cardinality and class-expression expansions use distinct normalized record IRIs." ;
    rdfs:label "owl expansion materialization" .

ns2365:eight
    dcterms:identifier "xsd:oq:18" ;
    ns3404:normative "accepted" ;
    ns3457:legacy "urn:silmaril:seed:decision:xsd:oq:18" ;
    prov:wasAttributedTo ns3420:release ;
    prov:wasGeneratedBy ns2261:nine ;
    rdf:type ns3400:release ;
    rdfs:comment "Use constraint:component:definition:group:model:properties for Model Group Definition Properties Correct and constraint:component:group:model for Model Group Correct." ;
    rdfs:label "model-group constraint collision" .

ns2365:five
    dcterms:identifier "xsd:oq:15" ;
    ns3404:normative "accepted" ;
    ns3457:legacy "urn:silmaril:seed:decision:xsd:oq:15" ;
    prov:wasAttributedTo ns3420:release ;
    prov:wasGeneratedBy ns2261:nine ;
    rdf:type ns3400:release ;
    rdfs:comment "Model namespace fixup as one normative procedure record with explicit implementation-defined branch records; normative and implementation-dependent clauses remain distinguishable." ;
    rdfs:label "namespace-fixup status" .

ns2365:four
    dcterms:identifier "xsd:oq:14" ;
    ns3404:normative "accepted" ;
    ns3457:legacy "urn:silmaril:seed:decision:xsd:oq:14" ;
    prov:wasAttributedTo ns3420:release ;
    prov:wasGeneratedBy ns2261:nine ;
    rdf:type ns3400:release ;
    rdfs:comment "Open-content interleave mode and model-group interleave are distinct source constructs. They may share a secondary algebraic operation target but never share identity." ;
    rdfs:label "interleave disambiguation" .

ns2365:nine
    dcterms:identifier "xsd:oq:19" ;
    ns3404:normative "accepted" ;
    ns3457:legacy "urn:silmaril:seed:decision:xsd:oq:19" ;
    prov:wasAttributedTo ns3420:release ;
    prov:wasGeneratedBy ns2261:nine ;
    rdf:type ns3400:release ;
    rdfs:comment "Keep open-content and model-group interleave records separate and link each to the shared interleaving-operation catalog by distinct assignments." ;
    rdfs:label "interleave record count" .

ns2365:one
    dcterms:identifier "xsd:oq:11" ;
    ns3404:normative "accepted" ;
    ns3457:legacy "urn:silmaril:seed:decision:xsd:oq:11" ;
    prov:wasAttributedTo ns3420:release ;
    prov:wasGeneratedBy ns2261:nine ;
    rdf:type ns3400:release ;
    rdfs:comment "Selected Type Definition and Instance-Specified Type Definition are separate source records and retain their override relation." ;
    rdfs:label "selected type split" .

ns2365:seven
    dcterms:identifier "xsd:oq:17" ;
    ns3404:normative "accepted" ;
    ns3457:legacy "urn:silmaril:seed:decision:xsd:oq:17" ;
    prov:wasAttributedTo ns3420:release ;
    prov:wasGeneratedBy ns2261:nine ;
    rdf:type ns3400:release ;
    rdfs:comment "Effective Value Constraint is a standalone source record reused by attribute and element declaration semantics." ;
    rdfs:label "effective-value constraint" .

ns2365:six
    dcterms:identifier "xsd:oq:16" ;
    ns3404:normative "accepted" ;
    ns3457:legacy "urn:silmaril:seed:decision:xsd:oq:16" ;
    prov:wasAttributedTo ns3420:release ;
    prov:wasGeneratedBy ns2261:nine ;
    rdf:type ns3400:release ;
    rdfs:comment "Materialize the greatest-fixed-point/closure semantics as a dedicated operation record linked to the Attribute Group Definition source construct." ;
    rdfs:label "attribute-group closure" .

ns2365:three
    dcterms:identifier "xsd:oq:13" ;
    ns3404:normative "accepted" ;
    ns3457:legacy "urn:silmaril:seed:decision:xsd:oq:13" ;
    prov:wasAttributedTo ns3420:release ;
    prov:wasGeneratedBy ns2261:nine ;
    rdf:type ns3400:release ;
    rdfs:comment "Empty, simple, element-only, and mixed content types are separate derived terms under the Complex Type Definition content-type record." ;
    rdfs:label "content-type varieties" .

ns2365:two
    dcterms:identifier "xsd:oq:12" ;
    ns3404:normative "accepted" ;
    ns3457:legacy "urn:silmaril:seed:decision:xsd:oq:12" ;
    prov:wasAttributedTo ns3420:release ;
    prov:wasGeneratedBy ns2261:nine ;
    rdf:type ns3400:release ;
    rdfs:comment "Keep each named PSVI contribution as a source record and materialize shared PSVI properties such as validity and validation-attempted as reusable property terms." ;
    rdfs:label "psvi property granularity" .

ns2365:zero
    dcterms:identifier "xsd:oq:10" ;
    ns3404:normative "accepted" ;
    ns3457:legacy "urn:silmaril:seed:decision:xsd:oq:10" ;
    prov:wasAttributedTo ns3420:release ;
    prov:wasGeneratedBy ns2261:nine ;
    rdf:type ns3400:release ;
    rdfs:comment "Materialize preserve, replace, and collapse as three operation records beneath one whitespace-normalization family." ;
    rdfs:label "white-space normalization" .

ns2366:eight
    dcterms:identifier "xsd:oq:38" ;
    ns3404:normative "accepted" ;
    ns3457:legacy "urn:silmaril:seed:decision:xsd:oq:38" ;
    prov:wasAttributedTo ns3420:release ;
    prov:wasGeneratedBy ns2261:nine ;
    rdf:type ns3400:release ;
    rdfs:comment "Preserve document-level include-cycle legality and component-level model-group acyclicity as distinct scoped constraints. No global cycle-policy unification is permitted." ;
    rdfs:label "cycle-policy scope" .

ns2366:five
    dcterms:identifier "xsd:oq:35" ;
    ns3404:normative "accepted" ;
    ns3457:legacy "urn:silmaril:seed:decision:xsd:oq:35" ;
    prov:wasAttributedTo ns3420:release ;
    prov:wasGeneratedBy ns2261:nine ;
    rdf:type ns3400:release ;
    rdfs:comment "Materialize one conditional-inclusion mechanism record plus six separate vc attribute records: min-version, max-version, type-available, type-unavailable, facet-available, and facet-unavailable." ;
    rdfs:label "conditional-inclusion granularity" .

ns2366:four
    dcterms:identifier "xsd:oq:34" ;
    ns3404:normative "accepted" ;
    ns3457:legacy "urn:silmaril:seed:decision:xsd:oq:34" ;
    prov:wasAttributedTo ns3420:release ;
    prov:wasGeneratedBy ns2261:nine ;
    rdf:type ns3400:release ;
    rdfs:comment "Materialize NCName as a standalone naming record normalized as name:noncolonized, distinct from the NCName datatype record." ;
    rdfs:label "ncname record" .

ns2366:one
    dcterms:identifier "xsd:oq:31" ;
    ns3404:normative "accepted" ;
    ns3457:legacy "urn:silmaril:seed:decision:xsd:oq:31" ;
    prov:wasAttributedTo ns3420:release ;
    prov:wasGeneratedBy ns2261:nine ;
    rdf:type ns3400:release ;
    rdfs:comment "Normalize dateTime as type:data:date:time, base64Binary as type:data:binary:base64, anyURI as type:data:uri:any, and Gregorian g-types as type:data:date:gregorian:*." ;
    rdfs:label "datatype name normalization" .

ns2366:seven
    dcterms:identifier "xsd:oq:37" ;
    ns3404:normative "accepted" ;
    ns3457:legacy "urn:silmaril:seed:decision:xsd:oq:37" ;
    prov:wasAttributedTo ns3420:release ;
    prov:wasGeneratedBy ns2261:nine ;
    rdf:type ns3400:release ;
    rdfs:comment "Include the Layer 3 web-access construct with a conservative representation bridge that records implementation latitude." ;
    rdfs:label "web access layer" .

ns2366:six
    dcterms:identifier "xsd:oq:36" ;
    ns3404:normative "accepted" ;
    ns3457:legacy "urn:silmaril:seed:decision:xsd:oq:36" ;
    prov:wasAttributedTo ns3420:release ;
    prov:wasGeneratedBy ns2261:nine ;
    rdf:type ns3400:release ;
    rdfs:comment "Materialize a chameleon composition concept record and a separate normative transformation record sourced to Appendix F.1." ;
    rdfs:label "chameleon granularity" .

ns2366:three
    dcterms:identifier "xsd:oq:33" ;
    ns3404:normative "accepted" ;
    ns3457:legacy "urn:silmaril:seed:decision:xsd:oq:33" ;
    prov:wasAttributedTo ns3420:release ;
    prov:wasGeneratedBy ns2261:nine ;
    rdf:type ns3400:release ;
    rdfs:comment "Include Component Designators as a source record with a conservative external-spec bridge and explicit W3C Note provenance; do not waive it." ;
    rdfs:label "component designator" .

ns2366:two
    dcterms:identifier "xsd:oq:32" ;
    ns3404:normative "accepted" ;
    ns3457:legacy "urn:silmaril:seed:decision:xsd:oq:32" ;
    prov:wasAttributedTo ns3420:release ;
    prov:wasGeneratedBy ns2261:nine ;
    rdf:type ns3400:release ;
    rdfs:comment "Include a separately versioned XSD 1.1 Part 2 supplement sourced from the official W3C Recommendation. Materialize every special, primitive, and ordinary built-in datatype individually." ;
    rdfs:label "xsd part-two boundary" .

ns2366:zero
    dcterms:identifier "xsd:oq:30" ;
    ns3404:normative "accepted" ;
    ns3457:legacy "urn:silmaril:seed:decision:xsd:oq:30" ;
    prov:wasAttributedTo ns3420:release ;
    prov:wasGeneratedBy ns2261:nine ;
    rdf:type ns3400:release ;
    rdfs:comment "Facet overlay is a standalone right-biased kind-indexed merge operation linked to the facet-restriction constraint." ;
    rdfs:label "facet overlay" .

ns2367:eight
    dcterms:identifier "xsd:oq:28" ;
    ns3404:normative "accepted" ;
    ns3457:legacy "urn:silmaril:seed:decision:xsd:oq:28" ;
    prov:wasAttributedTo ns3420:release ;
    prov:wasGeneratedBy ns2261:nine ;
    rdf:type ns3400:release ;
    rdfs:comment "Every XSD 1.1 built-in datatype is counted and materialized individually, with family records excluded from the source-construct count." ;
    rdfs:label "built-in datatype granularity" .

ns2367:five
    dcterms:identifier "xsd:oq:25" ;
    ns3404:normative "accepted" ;
    ns3457:legacy "urn:silmaril:seed:decision:xsd:oq:25" ;
    prov:wasAttributedTo ns3420:release ;
    prov:wasGeneratedBy ns2261:nine ;
    rdf:type ns3400:release ;
    rdfs:comment "The node table is a first-class finite-map/index algebra structure and also an infoset contribution. The primary gate is the index structure; PSVI placement is a secondary gate." ;
    rdfs:label "node table semantics" .

ns2367:four
    dcterms:identifier "xsd:oq:24" ;
    ns3404:normative "accepted" ;
    ns3457:legacy "urn:silmaril:seed:decision:xsd:oq:24" ;
    prov:wasAttributedTo ns3420:release ;
    prov:wasGeneratedBy ns2261:nine ;
    rdf:type ns3400:release ;
    rdfs:comment "Retain one Identity-Constraint Definition component record and materialize unique, key, and key-reference as three derived category records, with key-reference normalized as reference:key." ;
    rdfs:label "identity-constraint categories" .

ns2367:nine
    dcterms:identifier "xsd:oq:29" ;
    ns3404:normative "accepted" ;
    ns3457:legacy "urn:silmaril:seed:decision:xsd:oq:29" ;
    prov:wasAttributedTo ns3420:release ;
    prov:wasGeneratedBy ns2261:nine ;
    rdf:type ns3400:release ;
    rdfs:comment "Atomic, list, and union mapping rules are separate source records, not folded into the common simple-type representation record." ;
    rdfs:label "simple-type mapping rules" .

ns2367:one
    dcterms:identifier "xsd:oq:21" ;
    ns3404:normative "accepted" ;
    ns3457:legacy "urn:silmaril:seed:decision:xsd:oq:21" ;
    prov:wasAttributedTo ns3420:release ;
    prov:wasGeneratedBy ns2261:nine ;
    rdf:type ns3400:release ;
    rdfs:comment "Materialize one Namespace Constraint lattice record plus three operation records for subset, union, and intersection. Each named source operation gets its own primary gate to the shared lattice." ;
    rdfs:label "namespace-constraint algebra" .

ns2367:seven
    dcterms:identifier "xsd:oq:27" ;
    ns3404:normative "accepted" ;
    ns3457:legacy "urn:silmaril:seed:decision:xsd:oq:27" ;
    prov:wasAttributedTo ns3420:release ;
    prov:wasGeneratedBy ns2261:nine ;
    rdf:type ns3400:release ;
    rdfs:comment "Static validity and dynamic evaluation environments remain separate records." ;
    rdfs:label "xpath environment split" .

ns2367:six
    dcterms:identifier "xsd:oq:26" ;
    ns3404:normative "accepted" ;
    ns3457:legacy "urn:silmaril:seed:decision:xsd:oq:26" ;
    prov:wasAttributedTo ns3420:release ;
    prov:wasGeneratedBy ns2261:nine ;
    rdf:type ns3400:release ;
    rdfs:comment "Namespace Binding is a standalone implementation record linked to XPath Expression." ;
    rdfs:label "namespace binding" .

ns2367:three
    dcterms:identifier "xsd:oq:23" ;
    ns3404:normative "accepted" ;
    ns3457:legacy "urn:silmaril:seed:decision:xsd:oq:23" ;
    prov:wasAttributedTo ns3420:release ;
    prov:wasGeneratedBy ns2261:nine ;
    rdf:type ns3400:release ;
    rdfs:comment "Materialize each of the four XPath sublanguages as its own source record beneath a shared XPath-language family." ;
    rdfs:label "xpath sublanguages" .

ns2367:two
    dcterms:identifier "xsd:oq:22" ;
    ns3404:normative "accepted" ;
    ns3457:legacy "urn:silmaril:seed:decision:xsd:oq:22" ;
    prov:wasAttributedTo ns3420:release ;
    prov:wasGeneratedBy ns2261:nine ;
    rdf:type ns3400:release ;
    rdfs:comment "Particle bounded iteration and datatype list sequencing remain distinct constructions on different carriers, connected only by an explicit secondary structural-kinship bridge." ;
    rdfs:label "repetition versus list" .

ns2367:zero
    dcterms:identifier "xsd:oq:20" ;
    ns3404:normative "accepted" ;
    ns3457:legacy "urn:silmaril:seed:decision:xsd:oq:20" ;
    prov:wasAttributedTo ns3420:release ;
    prov:wasGeneratedBy ns2261:nine ;
    rdf:type ns3400:release ;
    rdfs:comment "The two separately named effective-total-range constraints remain two source records." ;
    rdfs:label "effective-total-range split" .

ns2368:eight
    dcterms:identifier "xsd:oq:08" ;
    ns3404:normative "accepted" ;
    ns3457:legacy "urn:silmaril:seed:decision:xsd:oq:08" ;
    prov:wasAttributedTo ns3420:release ;
    prov:wasGeneratedBy ns2261:nine ;
    rdf:type ns3400:release ;
    rdfs:comment "Every named Validation Rule, Schema Component Constraint, Schema Representation Constraint, and PSVI Contribution is a separate source construct with one primary gate." ;
    rdfs:label "named rule granularity" .

ns2368:five
    dcterms:identifier "xsd:oq:05" ;
    ns3404:normative "accepted" ;
    ns3457:legacy "urn:silmaril:seed:decision:xsd:oq:05" ;
    prov:wasAttributedTo ns3420:release ;
    prov:wasGeneratedBy ns2261:nine ;
    rdf:type ns3400:release ;
    rdfs:comment "Materialize each named conformance class and each named validity class atomically, with family records used only for navigation." ;
    rdfs:label "conformance and validity classes" .

ns2368:four
    dcterms:identifier "xsd:oq:04" ;
    ns3404:normative "accepted" ;
    ns3457:legacy "urn:silmaril:seed:decision:xsd:oq:04" ;
    prov:wasAttributedTo ns3420:release ;
    prov:wasGeneratedBy ns2261:nine ;
    rdf:type ns3400:release ;
    rdfs:comment "PSVI, assessment, validation, governing declaration, and governing type definitions are all gated source anchors." ;
    rdfs:label "conceptual definition gating" .

ns2368:nine
    dcterms:identifier "xsd:oq:09" ;
    ns3404:normative "accepted" ;
    ns3457:legacy "urn:silmaril:seed:decision:xsd:oq:09" ;
    prov:wasAttributedTo ns3420:release ;
    prov:wasGeneratedBy ns2261:nine ;
    rdf:type ns3400:release ;
    rdfs:comment "Scope, Value Constraint, and other spec-defined reusable property records are standalone anchors linked to their host components." ;
    rdfs:label "property-record status" .

ns2368:one
    dcterms:identifier "xsd:oq:01" ;
    ns3404:normative "accepted" ;
    ns3457:legacy "urn:silmaril:seed:decision:xsd:oq:01" ;
    prov:wasAttributedTo ns3420:release ;
    prov:wasGeneratedBy ns2261:nine ;
    rdf:type ns3400:release ;
    rdfs:comment "Every normative namespace and namespace-policy construct receives a primary gate assignment. Namespace records are source constructs as well as institution context." ;
    rdfs:label "xsd namespace gating" .

ns2368:seven
    dcterms:identifier "xsd:oq:07" ;
    ns3404:normative "accepted" ;
    ns3457:legacy "urn:silmaril:seed:decision:xsd:oq:07" ;
    prov:wasAttributedTo ns3420:release ;
    prov:wasGeneratedBy ns2261:nine ;
    rdf:type ns3400:release ;
    rdfs:comment "Normalize anySimpleType as type:simple:any and anyAtomicType as type:atomic:any, making the semantic genus the first descent." ;
    rdfs:label "any-type normalization" .

ns2368:six
    dcterms:identifier "xsd:oq:06" ;
    ns3404:normative "accepted" ;
    ns3457:legacy "urn:silmaril:seed:decision:xsd:oq:06" ;
    prov:wasAttributedTo ns3420:release ;
    prov:wasGeneratedBy ns2261:nine ;
    rdf:type ns3400:release ;
    rdfs:comment "Retain a family record at group:substitution and a derived specialized term at group:substitution:element. The source row has one primary gate; the specialization is a denoted term, not a duplicate source occurrence." ;
    rdfs:label "element substitution group naming" .

ns2368:three
    dcterms:identifier "xsd:oq:03" ;
    ns3404:normative "accepted" ;
    ns3457:legacy "urn:silmaril:seed:decision:xsd:oq:03" ;
    prov:wasAttributedTo ns3420:release ;
    prov:wasGeneratedBy ns2261:nine ;
    rdf:type ns3400:release ;
    rdfs:comment "Materialize one family record and seven member records for may, should, must, must-not, error, deprecated, and user-option. Each member is typed in the deontic/conformance modality catalog." ;
    rdfs:label "conformance keyword granularity" .

ns2368:two
    dcterms:identifier "xsd:oq:02" ;
    ns3404:normative "accepted" ;
    ns3457:legacy "urn:silmaril:seed:decision:xsd:oq:02" ;
    prov:wasAttributedTo ns3420:release ;
    prov:wasGeneratedBy ns2261:nine ;
    rdf:type ns3400:release ;
    rdfs:comment "The XML namespace is included as a conservative external-dependency bridge because XSD normatively grants it special status, while provenance records that its definition originates outside XSD." ;
    rdfs:label "xml namespace scope" .

