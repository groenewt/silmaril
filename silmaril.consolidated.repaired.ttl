ns576:symmetry
    ns3476:identifier "urn:silmaril:core:entity:individual:axiom:metric:symmetry" ;
    ns799:axiom "topological" ;
    ns800:value ns803:instances ;
    ns802:progress "asserted" ;
    ns822:identifier "urn:silmaril:axiom:axiomMetricSymmetry" ;
    ns9:root ns14:md, ns21:ttl ;
    rdf:type ns1151:specification, owl:NamedIndividual ;
    rdfs:label "metric symmetry axiom" ;
    skos:definition "Distance from x to y equals distance from y to x." .

ns576:triangle
    ns3476:identifier "urn:silmaril:core:entity:individual:axiom:metric:triangle" ;
    ns799:axiom "topological" ;
    ns800:value ns803:instances ;
    ns802:progress "asserted" ;
    ns822:identifier "urn:silmaril:axiom:axiomMetricTriangle" ;
    ns9:root ns14:md, ns21:ttl ;
    rdf:type ns1151:specification, owl:NamedIndividual ;
    rdfs:label "metric triangle axiom" ;
    skos:definition "Distance from x to z is no greater than the sum of distances through y." .

ns577:compatibility
