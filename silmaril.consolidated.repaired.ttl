ns8:ont00000002
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Cooling Artifact Function"@en ;
    rdfs:subClassOf ns8:ont00000323 ;
    skos:definition "An Artifact Function that is realized in a process in which the thermal energy of a system decreases."@en .

ns8:ont00000003
    ns8:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI ;
    owl:disjointWith ns8:ont00000649 ;
    rdf:type owl:Class ;
    rdfs:label "Designative Name"@en ;
    rdfs:subClassOf ns8:ont00000686 ;
    skos:altLabel "Name"@en ;
    skos:definition "A Designative Information Content Entity that consists of a string of characters that designates an entity within a specified cultural or social namespace and which is typically a word or phrase in a natural language that has an accepted cultural or social significance."@en .

ns8:ont00000004
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Change"@en ;
    rdfs:subClassOf ns1:BFO_0000015 ;
    skos:definition "A Process in which some independent continuant endures and 1) one or more of the dependent entities it bears increase or decrease in intensity, 2) the entity begins to bear some dependent entity or 3) the entity ceases to bear some dependent entity."@en .

ns8:ont00000005
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Act"@en ;
    rdfs:subClassOf ns1:BFO_0000015 ;
    skos:definition "A Process in which at least one Agent plays a causative role."@en .

ns8:ont00000006
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Upper Midrange Frequency"@en ;
    rdfs:subClassOf ns8:ont00000530 ;
    skos:definition "A Sonic Frequency that is between 2 and 4 kHz."@en .

ns8:ont00000007
    ns8:ont00001754 "http://www.thefreedictionary.com/natural+process" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Natural Process"@en ;
    rdfs:subClassOf ns1:BFO_0000015 ;
    skos:definition "A Process existing in or produced by nature; rather than by the intent of human beings."@en .

ns8:ont00000008
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Sound Frequency"@en ;
    rdfs:subClassOf ns8:ont00001047 ;
    skos:definition "A Frequency that is the rate of Oscillations per second of a Sound Wave."@en .

ns8:ont00000009
    ns8:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Mass Density"@en ;
    rdfs:subClassOf ns1:BFO_0000019 ;
    skos:altLabel "Density"@en ;
    skos:definition "A Quality that inheres in a bearer in virtue of that bearer's mass per unit volume."@en .

ns8:ont00000010
    ns8:ont00001754 "http://www.dictionary.com/browse/corporation" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Incorporated Organization"@en ;
    rdfs:subClassOf ns8:ont00001180 ;
    skos:altLabel "Corporation"@en ;
    skos:definition "An Organization formed by an Act of Incorporation that consists of an association of individuals, created by law or under authority of law, having a continuous existence independent of the existences of its members and owners, and having powers and liabilities distinct from those of its members and owners."@en .

ns8:ont00000011
    ns8:ont00001754 "https://en.oxforddictionaries.com/definition/nominal (Definition 6)" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Nominal Stasis"@en ;
    rdfs:subClassOf ns8:ont00000135 ;
    skos:altLabel "Nominal"@en ;
    skos:definition "A Stasis of Specifically Dependent Continuant in which some Independent Continuant bears a Quality or Realizable Entity that has a level of intensity or functionality that falls within the designed, expected, or acceptable range such that the Independent Continuant is of normal value, usefulness, or functionality."@en .

ns8:ont00000012
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Propulsion Control System"@en ;
    rdfs:subClassOf ns8:ont00000781 ;
    skos:definition "A Control System that consists of control devices, displays, indicators, or modules designed to control a Propulsion System."@en .

ns8:ont00000013
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Gain of Generically Dependent Continuant"@en ;
    rdfs:subClassOf _:nimportcommonb191, ns8:ont00000554 ;
    skos:definition "A Gain of Dependent Continuant wherein some Independent Continuant becomes the carrier of some Generically Dependent Continuant."@en ;
    skos:example "A Person forms a Plan, A Person is initiated into a Religion, A photgraphic image is produced." .

ns8:ont00000014
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Aztec Code"@en ;
    rdfs:subClassOf ns8:ont00000241 ;
    skos:definition "A Two-Dimensional Barcode that is used by the transportation industry to scan tickets."@en .

ns8:ont00000015
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Shotgun&oldid=1062571691"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Shotgun"@en ;
    rdfs:subClassOf ns8:ont00001104 ;
    skos:definition "A Long Gun that fires packets of shot, a single slug, a sabot, or a specialty round (such as tear gas, bolo shell, or a breaching round) over shorter ranges than that of Rifles and with less accuracy."@en .

ns8:ont00000016
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Triangular Waveform"@en ;
    rdfs:subClassOf ns8:ont00001286 ;
    skos:definition "A Waveform that is characterized by a triangular shape due to the continuous linear zig-zag transitions between minimum and maximum Amplitudes of the Wave Cycle."@en .

ns8:ont00000017
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Semi-major_and_semi-minor_axes&oldid=1047911304"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/GeospatialOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Minor Axis"@en ;
    rdfs:subClassOf ns1:BFO_0000026 ;
    skos:definition "A One-Dimensional Spatial Region that is the longest line segment perpendicular to the Major Axis that connects two points on the edge of an Ellipse."@en .

ns8:ont00000018
    ns8:ont00001754 "https://en.wikipedia.org/wiki/Title_(property)" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Title Document"@en ;
    rdfs:subClassOf ns8:ont00001346 ;
    skos:definition "A Legal Instrument that is designed as evidence of ownership."@en .

ns8:ont00000019
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Power Inverting Artifact Function"@en ;
    rdfs:subClassOf ns8:ont00000961 ;
    skos:definition "A Current Conversion Artifact Function that is realized by processes in which some Artifact is used to convert direct current (DC) to alternating current (AC)."@en .

ns8:ont00000020
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Container"@en ;
    rdfs:subClassOf ns8:ont00000995 ;
    skos:definition "A Material Artifact that is designed to contain (wholly or partially) some material entity."@en .

ns8:ont00000021
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Sensor Platform"@en ;
    rdfs:subClassOf ns8:ont00000995 ;
    skos:definition "A Material Artifact that is designed to support, and in some cases transport, a Sensor during its deployment and functioning."@en .

ns8:ont00000022
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Radio Communication Reception Artifact Function"@en ;
    rdfs:subClassOf ns8:ont00000422 ;
    skos:definition "A Communication Reception Artifact Function that is realized during events in which an Artifact receives information transmitted from another Artifact, where the transmission of information occurs using radio waves."@en .

ns8:ont00000023
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Sensor Deployment Artifact Function"@en ;
    rdfs:subClassOf ns8:ont00000323 ;
    skos:definition "An Artifact Function that inheres in Artifacts that are designed to support or convey one or more Sensors while the Sensors are realizing their own Artifact Functions."@en .

ns8:ont00000024
    ns8:ont00001754 "http://www.dictionary.com/browse/advising" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Act of Advising"@en ;
    rdfs:subClassOf ns8:ont00000133 ;
    skos:definition "An Act of Directive Communication performed by providing advice or counsel to another agent."@en .

ns8:ont00000025
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Electronic Stock"@en ;
    rdfs:subClassOf ns8:ont00001278 ;
    skos:definition "Stock that consists of Bytes."@en .

ns8:ont00000026
    ns8:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Hair Color"@en ;
    rdfs:subClassOf ns1:BFO_0000019 ;
    skos:definition "A Quality inhering in a portion of Hair by virtue of its color."@en .

ns8:ont00000027
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Mail&oldid=1057401839"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Mailing"@en ;
    rdfs:subClassOf ns8:ont00000517 ;
    skos:altLabel "Act of Mailing"@en ;
    skos:definition "An Act of Communication by Media in which information and tangible objects, usually written documents, are delivered to destinations around the world."@en .

ns8:ont00000028
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Dispersive Prism"@en ;
    rdfs:subClassOf ns8:ont00000804 ;
    skos:definition "A Prism designed to break up a beam of light entering the Prism into its constituent spectral colors by leveraging the refractive index of light based on its Frequency."@en .

ns8:ont00000029
    ns8:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Median Point Estimate Information Content Entity"@en ;
    rdfs:subClassOf ns8:ont00000745 ;
    skos:altLabel "Median"@en ;
    skos:definition "A Point Estimate Information Content Entity that is a measurement of a set of values and is equal to either the middle value or the average of the two values which separate the set into two equally populated upper and lower sets."@en .

ns8:ont00000030
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Nuclear_reactor&oldid=1063370273"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Nuclear Reactor"@en ;
    rdfs:subClassOf ns8:ont00000288 ;
    skos:definition "A Power Source that is designed to initiate and control a self-sustained nuclear chain reaction to produce power in the form of heat, which can be transferred to a working fluid for further conversion to mechanical or electrical energy."@en .

ns8:ont00000031
    ns8:ont00001760 "https://www.commoncoreontologies.org/GeospatialOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Atmospheric Feature"@en ;
    rdfs:subClassOf ns8:ont00001081 ;
    skos:definition "A Geographic Feature that is part of the atmosphere (including the atmosphere itself as a non-proper part) having a relatively stable lifecycle and which has a location that can be distinguished from the surrounding portion of the atmosphere."@en .

ns8:ont00000032
    ns8:ont00001754 "https://en.wikipedia.org/wiki/Church_(building)" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Church"@en ;
    rdfs:subClassOf ns8:ont00000052 ;
    skos:definition "A Religious Facility that is designed for Christian worship and prayer."@en .

ns8:ont00000033
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Decrease of Role"@en ;
    rdfs:subClassOf ns8:ont00000854 ;
    skos:definition "A Decrease of Realizable Entity in which some Independent Continuant has a decrease of some Role that it bears."@en .

ns8:ont00000034
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Vehicle&oldid=1063682179"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Conveyance Artifact Function"@en ;
    rdfs:subClassOf ns8:ont00000448 ;
    skos:definition "A Motion Artifact Function that is realized in a process in which the bearer of the function conveys entities from one location to another."@en .

ns8:ont00000035
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Soft X-ray Frequency"@en ;
    rdfs:subClassOf ns8:ont00000490 ;
    skos:definition "An X-Ray Frequency that is between 30 petahertz and 3 exahertz."@en .

ns8:ont00000036
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Waste_management&oldid=1062844209"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Waste Management Artifact Function"@en ;
    rdfs:subClassOf ns8:ont00001301 ;
    skos:definition "A Service Artifact Function that is realized in processes of collecting transporting processing recycling or disposing and monitoring of waste materials."@en .

ns8:ont00000037
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Observation&oldid=1062502087"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Act of Observation"@en ;
    rdfs:subClassOf ns8:ont00000228 ;
    skos:definition "A Planned Act of acquiring information from a source via the use of one or more senses."@en .

ns8:ont00000038
    ns8:ont00001754 "https://www.incose.org/about-systems-engineering/system-and-se-definition/general-system-definition"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "System Role"@en ;
    rdfs:subClassOf ns1:BFO_0000023 ;
    skos:definition "A Role that inheres in an entity in virtue of its parts or elements being arranged in such a way that they together exhibit behavior or meaning that they do not exhibit individually."@en .

ns8:ont00000039
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Portion of Solid Fuel"@en ;
    rdfs:subClassOf ns8:ont00000838 ;
    skos:definition "A Portion of Fuel that is stored in a solid state."@en .

ns8:ont00000040
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Grocery_store&oldid=1060022873"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Grocery Store"@en ;
    rdfs:subClassOf ns8:ont00001102 ;
    skos:definition "A Commercial Facility that is designed to sell food."@en .

ns8:ont00000041
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Hostel&oldid=1057812930"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Hostel"@en ;
    rdfs:subClassOf ns8:ont00000410 ;
    skos:definition "A Residential Facility that is designed to temporarily lodge guests in a sociable environment for relatively low costs."@en .

ns8:ont00000042
    ns8:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Semicircular"@en ;
    rdfs:subClassOf ns8:ont00001059 ;
    skos:definition "A Shape quality inhering in a bearer in virtue of the bearer having the shape of half a circle."@en .

ns8:ont00000043
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Portion of Solid Propellant"@en ;
    rdfs:subClassOf ns8:ont00000593 ;
    skos:definition "A Portion of Propellant that is stored in a solid state."@en .

ns8:ont00000044
    ns8:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Eye Color"@en ;
    rdfs:subClassOf _:nimportcommonb196, ns1:BFO_0000019 ;
    skos:definition "A Quality inhering in an Eye by virtue of the color of the Eye's Iris."@en .

ns8:ont00000045
    ns8:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Petroleum Depot"@en ;
    rdfs:subClassOf ns8:ont00000881 ;
    skos:definition "A Storage Facility that is designed to store petroleum, oil, or lubricants."@en .

ns8:ont00000046
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Province&oldid=1062496131"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Province"@en ;
    rdfs:subClassOf ns8:ont00000126 ;
    skos:definition "A First-Order Administrative Region that is part of a Country and delimits the authority of a magistrate who holds constitutionally-defined administrative jurisdiction over the defined geographic territory that bounds the Province."@en .

ns8:ont00000047
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Flow_control_valve&oldid=1013438085"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:comment "Flow Control Valves are often more complex than a simple Valve and typically include an Actuator that is capable of automatically adjusting the state of the valve in response to signals from a connected Sensor or Controller."@en ;
    rdfs:label "Flow Control Valve"@en ;
    rdfs:subClassOf ns8:ont00000598 ;
    skos:definition "A Valve that is designed to regulate the flow or Pressure of a fluid."@en .

ns8:ont00000048
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Random_wire_antenna&oldid=1058546356"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Random Wire Antenna"@en ;
    rdfs:subClassOf ns8:ont00000499 ;
    skos:definition "A Wire Antenna that consists of a long wire suspended above the ground with a length that does not bear a relation to the wavelength of the radio waves used and which is typically used as a receiving antenna on the long, medium, and short wave bands."@en .

ns8:ont00000049
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Banknote"@en ;
    rdfs:subClassOf ns8:ont00000475 ;
    skos:definition "A Portion of Cash that consists of a portable slips of paper or fabric designed to bear some specified Financial Value."@en .

ns8:ont00000050
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Very High Frequency Communication Instrument"@en ;
    rdfs:subClassOf ns8:ont00000903 ;
    skos:definition "A Radio Communication Instrument that is designed to participate in some process that has process part some Very High Frequency."@en .

ns8:ont00000051
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:comment "An Act of Construction typically involves the production of only one or a limited number of goods, such as in the construction of an airport or a community of condominiums."@en ;
    rdfs:label "Act of Construction"@en ;
    rdfs:subClassOf ns8:ont00000908 ;
    skos:definition "An Act of Artifact Processing wherein Artifacts are built on site as prescribed by some contract."@en .

ns8:ont00000052
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Religion&oldid=1063431202"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Religious Facility"@en ;
    rdfs:subClassOf ns8:ont00000192 ;
    skos:definition "A Facility that is designed for worship and prayer."@en .

ns8:ont00000053
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Motor_vehicle&oldid=1063627395"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Ground Motor Vehicle"@en ;
    rdfs:subClassOf ns8:ont00000618 ;
    skos:definition "A Ground Vehicle that is designed to receive its motive power from an Engine and is not designed to travel on rails."@en .

ns8:ont00000054
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Stirling_engine&oldid=1061164490"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Stirling Engine"@en ;
    rdfs:subClassOf ns8:ont00000431 ;
    skos:definition "An External Combusion Engine that is designed to compress and expand some working fluid at different temperatures, such that there is a net conversion of heat energy to mechanical work."@en .

ns8:ont00000055
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Medicine&oldid=1062226814"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Healthcare Facility"@en ;
    rdfs:subClassOf ns8:ont00000192 ;
    skos:definition "A Facility that is designed for the diagnosis, treatment, and prevention of disease."@en .

ns8:ont00000056
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Reaction_engine&oldid=1046981784"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Reaction Engine"@en ;
    rdfs:subClassOf ns8:ont00000210 ;
    skos:altLabel "Reaction Motor"@en ;
    skos:definition "An Engine that provides propulsion by expelling Reaction Mass."@en .

ns8:ont00000057
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Mobile_phone&oldid=1061800841"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Mobile Telephone"@en ;
    rdfs:subClassOf ns8:ont00000907 ;
    skos:definition "A Telephone that is connected to a Telephone Network by radio waves."@en .

ns8:ont00000058
    ns8:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Scalp Hair"@en ;
    rdfs:subClassOf ns8:ont00000084 ;
    skos:definition "A Bodily Component that consists of a portion of hair that grows on the scalp of a human or other animal."@en .

ns8:ont00000059
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Telephone_line&oldid=1063429738"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Telephone Line"@en ;
    rdfs:subClassOf ns8:ont00000825 ;
    skos:altLabel "Telephone Circuit"@en ;
    skos:definition "A Telecommunication Network Line that consists of a physical wire or other signaling medium that is designed to be part of a Telephone Network."@en .

ns8:ont00000060
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Open-pit_mining&oldid=1059271938"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Open Pit Mine"@en ;
    rdfs:subClassOf ns8:ont00000639 ;
    skos:definition "A Mine that is designed to support the extraction of materials from the ground directly without using tunnels."@en .

ns8:ont00000061
    ns8:ont00001760 "https://www.commoncoreontologies.org/UnitsOfMeasureOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Measurement Unit of Flow"@en ;
    rdfs:subClassOf ns8:ont00000120 ;
    skos:definition "A Measurement Unit that is used as a standard for measurement of the rate at which portions of a substance pass per unit of time."@en .

ns8:ont00000062
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Frequency Measurement Artifact Function"@en ;
    rdfs:subClassOf ns8:ont00001100 ;
    skos:definition "A Measurement Artifact Function that is realized during events in which an Artifact is used to measure the Frequency of a specified object or class of objects."@en .

ns8:ont00000063
    ns8:ont00001760 "https://www.commoncoreontologies.org/TimeOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:comment "This is a defined class."@en ;
    rdfs:label "Multi-Hour Temporal Interval"@en ;
    rdfs:subClassOf _:nimportcommonb197, ns1:BFO_0000038 ;
    skos:definition "A one-dimensional temporal region that is measured in Hours and spans at least one Hour."@en .

ns8:ont00000064
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Book&oldid=1063132471"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Book"@en ;
    rdfs:subClassOf ns8:ont00000798 ;
    skos:definition "An Information Bearing Artifact that is designed to bear some specific Information Content Entity by means of ink, paper, parchment, or other materials fastened together to hinge at one side."@en .

ns8:ont00000065
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Act of Location Change"@en ;
    rdfs:subClassOf ns8:ont00000357 ;
    skos:definition "An Act of Motion in which the location of some Object is changed by some Agent."@en .

ns8:ont00000066
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Military&oldid=1063431234"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Military Artifact Function"@en ;
    rdfs:subClassOf ns8:ont00001301 ;
    skos:definition "A Service Artifact Function that is realized in processes related to the armed services."@en .

ns8:ont00000067
    ns8:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:comment "In traditional astronomical usage, civil time is mean solar time as calculated from midnight as the beginning of the Civil Day."@en, "Note that Civil Time Reference System is more accurately represented as a Temporal Reference System that participates in an act of usage that is sanctioned by an appropriate civil authority. As such, it should be represented as a defined class."@en ;
    rdfs:label "Civil Time Reference System"@en ;
    rdfs:subClassOf ns8:ont00001328 ;
    skos:definition "A Temporal Reference System that is a statutory time scale as designated by civilian authorities to determine local time(s)."@en .

ns8:ont00000068
    ns8:ont00001760 "https://www.commoncoreontologies.org/GeospatialOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Three-Dimensional Path"@en ;
    rdfs:subClassOf _:nimportcommonb198, ns1:BFO_0000028 ;
    skos:definition "A Three-Dimensional Spatial Region that encompasses the spatial region through which some Object travels."@en .

ns8:ont00000069
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Transcript&oldid=1038510063"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Transcript"@en ;
    rdfs:subClassOf ns8:ont00001298 ;
    skos:definition "A Document that is designed to bear some specific Information Content Entity that was originally recorded in a different medium."@en .

ns8:ont00000070
    ns8:ont00001760 "https://www.commoncoreontologies.org/GeospatialOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Ground Track Point"@en ;
    rdfs:subClassOf ns1:BFO_0000018 ;
    skos:definition "A Zero-Dimensional Spatial Region that is an idealized point located on the surface of an Astronomical Body directly below an Object Track Point."@en .

ns8:ont00000071
    ns8:ont00001754 "http://www.dictionary.com/browse/town" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Town"@en ;
    rdfs:subClassOf ns8:ont00000460 ;
    skos:definition "A Local Administrative Region in which a human population permanently resides that is typically larger than the population of a Village but smaller than that of a City; is designated as a town based on a particular administrative, legal, or historical status; and which delimits a local Government that typically exercises less power than that of a City Government."@en .

ns8:ont00000072
    ns8:ont00001754 "Anderson et. al. A Land Use and Land Cover Classification System for use with Remote Sensor Data, Geological Survey Professional Paper 964" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/GeospatialOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Low Density Residential Area"@en ;
    rdfs:subClassOf ns8:ont00000224 ;
    skos:definition "A Populated Place where houses are on lots of more than one acre."@en .

ns8:ont00000073
    ns8:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI ;
    owl:equivalentClass _:nimportcommonb199 ;
    rdf:type owl:Class ;
    rdfs:label "Temporal Interval Identifier"@en ;
    rdfs:subClassOf ns8:ont00000399 ;
    skos:altLabel "One-Dimensional Temporal Region Identifier"@en ;
    skos:definition "A Temporal Region Identifier that designates some Temporal Interval."@en .

ns8:ont00000074
    ns8:ont00001760 "https://www.commoncoreontologies.org/UnitsOfMeasureOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Measurement Unit of Acceleration"@en ;
    rdfs:subClassOf ns8:ont00000120 ;
    skos:definition "A Measurement Unit that is used as a standard for measurement of the rate at which objects change their velocities per unit of time."@en ;
    skos:example "feet per second per second, kilometers per second per second" .

ns8:ont00000075
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Optical_microscope&oldid=1063131242"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Optical Microscope"@en ;
    rdfs:subClassOf ns8:ont00000304 ;
    skos:altLabel "Light Microscope"@en ;
    skos:definition "A Microscope that is designed to use visible light and a system of Optical Lenses to produce a significantly enlarged image of the Object."@en .

ns8:ont00000076
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Telecommunications&oldid=1061143810"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Wired Communication Artifact Function"@en ;
    rdfs:subClassOf ns8:ont00000727 ;
    skos:definition "A Communication Artifact Function that is realized in a process that conveys meaningful signs by means of a (usually cylindrical) flexible strand or rod of metal."@en .

ns8:ont00000077
    ns8:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI ;
    owl:disjointWith ns8:ont00000923 ;
    rdf:type owl:Class ;
    rdfs:label "Code Identifier"@en ;
    rdfs:subClassOf ns8:ont00000649 ;
    skos:altLabel "Code ID"@en, "ID Code"@en, "Identifier Code"@en ;
    skos:definition "A Non-Name Identifier that consists of a string of characters that was created and assigned according to an encoding system such that metadata can be derived from the identifier."@en .

ns8:ont00000078
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:comment "Although the boundary between Act of Estimation and guessing is vague, estimation can be partially distinguished from guessing in that every Act of Estimation has as input some relevant information; whereas an act of guessing can occur sans information (or at least sans pertinent information). For example, if Mr. Green were asked how many blades of grass are in his lawn, he could simply choose a number (i.e. he could guess) or he could estimate the number by counting how many baldes of grass are in 1 square foot of his lawn, measuring the square footage of his lawn, and then multiplying these values to arrive at a number. Hence, many estimates may be loosely considered to be educated guesses."@en, "Note that, while every Act of Measuring arguably involves some degree of estimation (for example, a measuring instrument rounding to the nearest ten-thousandth or an Agent reading an analog display), it would be a mistake to classify all Acts of Measuring as Acts of Estimation. This holds even for cases (e.g. census taking) in which sofisticated estimations are often more accurate than other means of measuring (e.g. enumeration)."@en ;
    rdfs:label "Act of Estimation"@en ;
    rdfs:subClassOf ns8:ont00000345 ;
    skos:altLabel "Act of Approximation"@en ;
    skos:definition "An Act of Measuring that involves the comparison of a measurement of a similar Entity or of a portion of the Entity being estimated to produce an approximated measurement of the target Entity."@en ;
    skos:example "measuring how much time a train will add to your commute by measuring how long it takes for 10 train cars to pass a given point and then combining this information with an estimate of how many train cars are in a typical train based on your past experience", "measuring the amount of time required to do a task based on how long it took to do a similar task in the past", "measuring the height of a building by counting the number of floors and multiplying it by the height of an average floor in an average building", "measuring the property value of a house based on its square footage and the average cost per square foot of other houses in the area" ;
    skos:scopeNote "In all cases, the Agent in an Act of Estimation either lacks complete information, lacks access to the relevant information, or chooses not to use the complete information (perhaps to save money or time) about the thing being estimated; instead, the Agent uses some or all of the relevant information that the Agent does have as a basis for arriving at the estimate."@en .

ns8:ont00000079
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Social_movement&oldid=1062720561"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Act of Social Movement"@en ;
    rdfs:subClassOf ns8:ont00001327 ;
    skos:definition "A Social Act composed of a series of performances, displays and campaigns directed at implementing, resisting or undoing a change in society."@en .

ns8:ont00000080
    ns8:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Standard Time of Day Identifier"@en ;
    rdfs:subClassOf ns8:ont00000827 ;
    skos:definition "A Time of Day Identifier that designates an approximate Temporal Instant that is part of some Day and is specified using the Hours, Minutes, and Seconds of the Day that preceded the Temporal Instant."@en .

ns8:ont00000081
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Cutting&oldid=1058846915"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Cutting Weapon"@en ;
    rdfs:subClassOf ns8:ont00000445 ;
    skos:definition "A Weapon that is designed to inflict harm, damage, or incapacity by means of separating some portion of its target into two or more portions through the application of acutely directed force."@en .

ns8:ont00000082
    ns8:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Green"@en ;
    rdfs:subClassOf ns8:ont00000378 ;
    skos:definition "A Color that is between Yellow and Cyan with a wavelength in the visible spectrum, typically between 520 to 560 nanometers."@en .

ns8:ont00000083
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Process Ending"@en ;
    rdfs:subClassOf ns1:BFO_0000035 ;
    skos:definition "A Process Boundary that occurs on a Zero-Dimensional Temporal Region that is the ending instant of the One-Dimensional Temporal Region on which the Process, of which the Process Boundary is a part, occurs."@en .

ns8:ont00000084
    ns8:ont00001754 "https://www.ncbi.nlm.nih.gov/pmc/articles/PMC3017014/" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Bodily Component"@en ;
    rdfs:subClassOf ns1:BFO_0000024 ;
    skos:definition "A Fiat Object Part located within or on the surface of an Agent."@en ;
    skos:example "Bodily Components include anatomical structures, body flora, pathogens, toxins, and their combinations." .

ns8:ont00000085
    ns8:ont00001754 "http://wordnetweb.princeton.edu/perl/webwn?s=minute" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/TimeOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Minute"@en ;
    rdfs:subClassOf _:nimportcommonb203, ns1:BFO_0000202 ;
    skos:definition "A Temporal Interval that is equal to sixty consecutive Seconds."@en .

ns8:ont00000086
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Autopilot&oldid=1063382206"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Autopilot System"@en ;
    rdfs:subClassOf ns8:ont00000723 ;
    skos:altLabel "Autopilot"@en ;
    skos:definition "A Vehicle Control System that is designed to enable some Agent to control the trajectory of a Vehicle without constant 'hands-on' control."@en .

ns8:ont00000087
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Ordinal_date&oldid=1061989434"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:comment "An Ordinal Date Identifier may or may not also contain a number indicating a specific Year. If both numbers are included, the ISO 8601 ordinal date format stipulates that the two numbers be formatted as YYYY-DDD or YYYYDDD where [YYYY] indicates a year and [DDD] is the day of that year, from 001 through 365 (or 366 in leap years)."@en ;
    rdfs:label "Ordinal Date Identifier"@en ;
    rdfs:subClassOf ns8:ont00000894 ;
    skos:altLabel "Ordinal Date"@en ;
    skos:definition "A Decimal Date Identifier that designates some Day by using a number to indicate the sequential ordering of the Day since the beginning of the Year."@en .

ns8:ont00000088
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Firearm&oldid=1061216363"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Firearm"@en ;
    rdfs:subClassOf ns8:ont00001051 ;
    skos:definition "A Projectile Launcher that is designed to launch Bullets or Cartridges."@en .

ns8:ont00000089
    ns8:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI ;
    owl:equivalentClass _:nimportcommonb204 ;
    rdf:type owl:Class ;
    rdfs:label "Skill"@en ;
    rdfs:subClassOf ns8:ont00001379 ;
    skos:definition "An Agent Capability that inheres in a Person to the extent of that Person's capacity to realize it in Intentional Acts of a certain type."@en .

ns8:ont00000090
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Infrared_telescope&oldid=1062918090"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Infrared Telescope"@en ;
    rdfs:subClassOf ns8:ont00000547 ;
    skos:definition "A Telescope that is designed to aid in the observation of spatially distant Objects by means of collecting and focusing infrared light to form an enhanced image of the Object."@en .

ns8:ont00000091
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Portion of Coolant"@en ;
    rdfs:subClassOf ns8:ont00000457 ;
    skos:definition "A Portion of Material that is designed to be used in a thermal control system to reduce or maintain the temperature of an object to or at a specified level."@en .

ns8:ont00000092
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Transducer&oldid=1053290948"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Bidirectional Transducer"@en ;
    rdfs:subClassOf ns8:ont00000736 ;
    skos:definition "A Transducer that is designed to receive a signal in the form of physical phenomena and convert it into an electrical signal, and vice versa."@en .

ns8:ont00000093
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Preferred Stock"@en ;
    rdfs:subClassOf ns8:ont00001278 ;
    skos:definition "Stock that entitles its holder to receive a certain level of dividend payments before any dividends can be issued to other holders."@en .

ns8:ont00000094
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Seat_of_government&oldid=1063047501"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Seat of National Government"@en ;
    rdfs:subClassOf ns8:ont00000946 ;
    skos:definition "A Government Building that is designed for the administration of a sovereign nation."@en ;
    skos:example "Parliament of Canada", "United States Capitol" .

ns8:ont00000095
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Flight_control_surfaces&oldid=1019271264"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Control Surface"@en ;
    rdfs:subClassOf ns8:ont00000995 ;
    skos:definition "A Material Artifact that is designed to deflect air, water, or another medium around its surface in order to change the Attitude of a Vehicle by rotating the Vehicle on one or more of its Axes of Rotation."@en .

ns8:ont00000096
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Propulsion&oldid=1022034059"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Propulsion System"@en ;
    rdfs:subClassOf ns8:ont00000995 ;
    skos:definition "A Material Artifact that is designed to facilitate the movement of material entities from one location to another and which consists of a source of mechanical power and a means of converting this power into propulsive force to generate the movement."@en .

ns8:ont00000097
    ns8:ont00001754 "Hecht, Eugene (1987). Optics (2nd ed.). Addison Wesley. ISBN 978-0-201-11609-0. Chapters 5 & 6."@en ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Complex Optical Lens"@en ;
    rdfs:subClassOf ns8:ont00001207 ;
    skos:altLabel "Lens System"@en ;
    skos:definition "An Optical Lens consisting of more than one Simple Optical Lenses."@en .

ns8:ont00000098
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Electrical Artifact Function"@en ;
    rdfs:subClassOf ns8:ont00000323 ;
    skos:definition "An Artifact Function that is realized during events in which an Artifact is used to perform a process involving electrical power."@en .

ns8:ont00000099
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Wave&oldid=1062648180"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Wave Process"@en ;
    rdfs:subClassOf _:nimportcommonb208, _:nimportcommonb209, ns8:ont00000007 ;
    skos:definition "A Natural Process that involves Oscillation accompanied by a transfer of energy that travels through a portion of matter or spatial region."@en .

ns8:ont00000100
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Stasis of Partially Mission Capable"@en ;
    rdfs:subClassOf ns8:ont00001132 ;
    skos:definition "A Stasis of Mission Capability during which the participating Continuant is capable of performing some but not all of its primary functions for the specified Mission."@en .

ns8:ont00000101
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Portion of Liquid Oxygen"@en ;
    rdfs:subClassOf ns8:ont00000255 ;
    skos:definition "A Portion of Cryogenic Material that is composed (almost) entirely of liquid oxygen."@en .

ns8:ont00000102
    ns8:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:comment "Skin Type is classified according to a reference system such as the Fitzpatrick scale: https://en.wikipedia.org/wiki/Fitzpatrick_scale"@en ;
    rdfs:label "Skin Type"@en ;
    rdfs:subClassOf ns1:BFO_0000019 ;
    skos:definition "A Quality inhering in a portion of skin by virtue of its color and natural tendency to respond to ultraviolet light."@en .

ns8:ont00000103
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Vehicle Compartment"@en ;
    rdfs:subClassOf ns8:ont00000995 ;
    skos:altLabel "Compartment"@en ;
    skos:definition "A Material Artifact that is designed to partition a Vehicle into subdivisions for various purposes."@en .

ns8:ont00000104
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Naval_mine&oldid=1062538523"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Underwater Mine"@en ;
    rdfs:subClassOf ns8:ont00000639 ;
    skos:definition "A Mine that is designed to support the extraction of materials from the ocean floor."@en .

ns8:ont00000105
    ns8:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Square"@en ;
    rdfs:subClassOf ns8:ont00001369 ;
    skos:definition "A Rectangular shape which has four equal length sides and four 90 degree angles."@en .

ns8:ont00000106
    ns8:ont00001753 "EOL", "EoL" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:comment "An End of Life Stasis (EoL) is distinguished from a Stasis of Partially Mission Capable or Stasis of Non-Mission Capable in that EoL is more inclusive such that the participating Artifact may be either Partially or Non-Mission Capable. Additionally, EoL applies only to Artifacts and is typically determined in relation to its original mission and designed primary functions. In contrast, an Artifact's level of Mission Capability depends on the requirements of the mission under consideration such that a given Artifact may simultaneously be Fully Mission Capable for mission1, Partially Mission Capable for mission2, and Non-Mission Capable for mission3."@en ;
    rdfs:label "End of Life Stasis"@en ;
    rdfs:subClassOf ns8:ont00001213 ;
    skos:definition "A Stasis of Artifact Operationality that holds during a Temporal Interval when the participating Artifact is no longer capable of realizing all of its designed primary Artifact Functions."@en .

ns8:ont00000107
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Increase of Generically Dependent Continuant"@en ;
    rdfs:subClassOf ns8:ont00001048 ;
    skos:definition "An Increase of Dependent Continuant in which some Independent Continuant has an increase of some Generically Dependent Continuant that it bears."@en .

ns8:ont00000108
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Train_station&oldid=1063922802"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Rail Facility"@en ;
    rdfs:subClassOf ns8:ont00000226 ;
    skos:definition "A Transportation Facility that is designed for transferring people or cargo to and from Trains."@en .

ns8:ont00000109
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Act of Military Force"@en ;
    rdfs:subClassOf ns8:ont00000228 ;
    skos:definition "A Planned Act of employing a Military Force to achieve some desired result."@en .

ns8:ont00000110
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Mechanical Process"@en ;
    rdfs:subClassOf ns1:BFO_0000015 ;
    skos:definition "A Process that is the realization of some Disposition of an Artifact"@en .

ns8:ont00000111
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Air Inlet"@en ;
    rdfs:subClassOf ns8:ont00000256 ;
    skos:altLabel "Air Intake"@en ;
    skos:definition "A Fluid Control Artifact that consists of an opening that is designed to capture and direct the flow of air into the system it is part of."@en .

ns8:ont00000112
    ns8:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Translucent"@en ;
    rdfs:subClassOf ns8:ont00001384 ;
    skos:definition "An Opacity that inheres in a bearer in virtue of that bearer's capacity to transmit some but not all electromagnetic radiation of a given frequency through the bearer such that the bearer reflects, scatters, or absorbs some but not all electromagnetic radiation of that frequency."@en .

ns8:ont00000113
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Ventilation Control Artifact Function"@en ;
    rdfs:subClassOf ns8:ont00000323 ;
    skos:definition "An Artifact Function that is realized in processes in which some Artifact is used to control the quality of air in some space."@en .

ns8:ont00000114
    ns8:ont00001760 "https://www.commoncoreontologies.org/TimeOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Unix Temporal Instant"@en ;
    rdfs:subClassOf ns1:BFO_0000203 ;
    skos:definition "A Temporal Instant as specified by the number of Seconds that have elapsed since the specified Epoch Time as described by an implementation of Unix Time."@en .

ns8:ont00000115
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Stasis of Disposition"@en ;
    rdfs:subClassOf ns8:ont00000246 ;
    skos:definition "A Stasis of Realizable Entity in which some Independent Continuant bears some Disposition that remains unchanged during a Temporal Interval."@en .

ns8:ont00000116
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Pump"@en ;
    rdfs:subClassOf ns8:ont00000256 ;
    skos:definition "A Fluid Control Artifact that is designed to impart motion to a portion of fluid to transport it within a system through the use of mechanical action."@en .

ns8:ont00000117
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Information Processing Artifact"@en ;
    rdfs:subClassOf ns8:ont00000995 ;
    skos:definition "A Material Artifact that is designed to use algorithms to transform some Information Content Entity into another Information Content Entity."@en .

ns8:ont00000118
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    owl:equivalentClass _:nimportcommonb210 ;
    rdf:type owl:Class ;
    rdfs:label "Artifact Function Specification"@en ;
    rdfs:subClassOf ns8:ont00000965 ;
    skos:definition "A Directive Information Content Entity that prescribes some Artifact Function and which is part of some Artifact Model."@en .

ns8:ont00000119
    ns8:ont00001754 "https://en.wikipedia.org/wiki/Orientation_(geometry)" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Spatial Orientation"@en ;
    rdfs:subClassOf ns1:BFO_0000145 ;
    skos:altLabel "Attitude"@en ;
    skos:definition "A Relational Quality that is the angle of Rotation of an Object relative to one or more Plane of Reference or Axis of Rotation."@en .

ns8:ont00000120
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Unit_of_measurement&oldid=1061038125"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Measurement Unit"@en ;
    rdfs:subClassOf ns8:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes a definite magnitude of a physical quantity, defined and adopted by convention and/or by law, that is used as a standard for measurement of the same physical quantity."@en .

ns8:ont00000121
    ns8:ont00001754 "JC3IEDM-MIRD-DMWG-Edition_3.0.2_20090514" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Act of Conducting Mass Media Interview"@en ;
    rdfs:subClassOf ns8:ont00000588 ;
    skos:definition "An Act of Mass Media Communication involving a conversation between a reporter and a person of public interest, used as a basis of a broadcast or publication."@en .

ns8:ont00000122
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Vehicle Track Point"@en ;
    rdfs:subClassOf _:nimportcommonb214, ns8:ont00000170 ;
    skos:definition "An Object Track Point that is where a Vehicle is or was located during some motion."@en .

ns8:ont00000123
    ns8:ont00001754 "Derived (loosely) from: John Searle's Speech Acts: An Essay in the Philosophy of Language" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:comment "Examples: apologizing, condoling, congratulating, greeting, thanking, accepting (acknowledging an acknowledgment)"@en ;
    rdfs:label "Act of Expressive Communication"@en ;
    rdfs:subClassOf ns8:ont00000402 ;
    skos:definition "An Act of Communication in which an Agent expresses their attitudes or emotions towards some entity."@en .

ns8:ont00000124
    ns8:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Solar Time Reference System"@en ;
    rdfs:subClassOf ns8:ont00001328 ;
    skos:definition "A Temporal Reference System that is based on the position of the Sun in the sky."@en .

ns8:ont00000125
    ns8:ont00001760 "https://www.commoncoreontologies.org/GeospatialOntology"^^xsd:anyURI ;
    owl:equivalentClass _:nimportcommonb215 ;
    rdf:type owl:Class ;
    rdfs:label "Bounding Box Point"@en ;
    rdfs:subClassOf ns8:ont00000373 ;
    skos:definition "A Geospatial Position that is a proper part of some Geospatial Region Bounding Box."@en .

ns8:ont00000126
    ns8:ont00001754 "http://www.geonames.org/export/codes.html" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "First-Order Administrative Region"@en ;
    rdfs:subClassOf _:nimportcommonb219, ns8:ont00001152 ;
    skos:definition "A Government Domain that is a primary administrative division of a Country."@en ;
    skos:example "a state in the United States" .

ns8:ont00000127
    ns8:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Performance Specification"@en ;
    rdfs:subClassOf _:nimportcommonb220, ns8:ont00000965 ;
    skos:definition "A Directive Information Content Entity that prescribes some aspect of the behavior of a participant in a Process given one or more operating conditions."@en ;
    skos:example "Maximum Speed at high altitude; Rate of Ascent at 10 degrees celsius with nominal payload." .

ns8:ont00000128
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Portion of Liquid Hydrogen"@en ;
    rdfs:subClassOf ns8:ont00000255 ;
    skos:definition "A Portion of Cryogenic Material that is composed (almost) entirely of liquid hydrogen."@en .

ns8:ont00000129
    ns8:ont00001754 "http://www.thefreedictionary.com/tattoo" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Tattoo"@en ;
    rdfs:subClassOf ns8:ont00000084 ;
    skos:definition "A Bodily Component that consists of a typically permanent mark or design on a portion of skin that is created by a process of pricking and ingraining an indelible pigment or by raising scars."@en .

ns8:ont00000130
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Transformer&oldid=1062163369"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Power Transformer"@en ;
    rdfs:subClassOf ns8:ont00000995 ;
    skos:definition "A Material Artifact that is designed to transfer electrical energy between two or more circuits through electromagnetic induction."@en .

ns8:ont00000131
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Increase of Quality"@en ;
    rdfs:subClassOf ns8:ont00001214 ;
    skos:definition "An Increase of Specifically Dependent Continuant in which some Indpendent Continuant has an increase of some Quality that it bears."@en .

ns8:ont00000132
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Record&oldid=1062776450"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Recording Device"@en ;
    rdfs:subClassOf ns8:ont00000117 ;
    skos:definition "An Information Processing Artifact that is designed to capture some information and store it in some recording format on some storage medium."@en .

ns8:ont00000133
    ns8:ont00001754 "Derived (loosely) from: John Searle's Speech Acts: An Essay in the Philosophy of Language" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:comment "Examples: advising, admonishing, asking, begging, dismissing, excusing, forbidding, instructing, ordering, permitting, requesting, requiring, suggesting, urging, warning"@en ;
    rdfs:label "Act of Directive Communication"@en ;
    rdfs:subClassOf ns8:ont00000402 ;
    skos:definition "An Act of Communication that is intended to cause the hearer to take a particular action."@en .

ns8:ont00000134
    ns8:ont00001754 "http://www.geonames.org/export/codes.html" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Third-Order Administrative Region"@en ;
    rdfs:subClassOf _:nimportcommonb221, ns8:ont00001152 ;
    skos:definition "A Government Domain that is a subdivision of a Second-Order Administrative Region."@en .

ns8:ont00000135
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Stasis of Specifically Dependent Continuant"@en ;
    rdfs:subClassOf ns8:ont00000819 ;
    skos:definition "A Stasis in which some Independent Continuant bears some Specifically Dependent Continuant that remains unchanged during a Temporal Interval."@en .

ns8:ont00000136
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Optical_instrument&oldid=1061981216"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:comment "Optical Instruments are typically constructed for the purpose of being used to aid in vision or the analysis of light."@en ;
    rdfs:label "Optical Instrument"@en ;
    rdfs:subClassOf ns8:ont00000995 ;
    skos:definition "A Material Artifact that is designed to process light waves."@en ;
    skos:scopeNote "Light waves can be processed in a variety of ways including via reflection, refraction, diffraction, deflection, focusing, collimation, dispersion, and interference."@en .

ns8:ont00000137
    ns8:ont00001754 "http://en.wikipedia.org/wiki/Deposit_(bank)" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Act of Financial Deposit"@en ;
    rdfs:subClassOf ns8:ont00000836 ;
    skos:definition "An Act of Financial Instrument Use wherein a Financial Instrument is transferred by an Agent (the Depositor) to another Agent to create a liability to be repaid to the Depositor through an Act of Financial Withdrawal."@en .

ns8:ont00000138
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Maximum Power"@en ;
    rdfs:subClassOf ns8:ont00000503 ;
    skos:definition "A Power that is characterized by the maximum rate of Work, or Energy consumed, done in a given time period."@en .

ns8:ont00000139
    dcterms:bibliographicCitation "Convention on Rights and Duties of States (inter-American); December 26, 1933. https://avalon.law.yale.edu/20th_century/intam03.asp. Accessed 6 Apr. 2023." ;
    dcterms:creator "https://cubrc.org"^^xsd:anyURI ;
    ns8:ont00001754 "https://avalon.law.yale.edu/20th_century/intam03.asp" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Domain of a Country"@en ;
    rdfs:subClassOf ns8:ont00001152 ;
    skos:definition "A Government Domain that is associated with certain distinct political, ethnic, or cultural characteristics, and which delimits a Government that has legitimate authority over a Populace."@en ;
    skos:editorialNote "'Country' is an unclear term. Does it refer to the people, the government, the site, or the material in the site? Furthermore, what is properly referred to as a 'Country' is highly dependent on the classification practices of the international community. For example: The United Kingdom is a sovereign country that has Wales, a non-sovereign Country, as a member. Vatican City is a sovereign country that is landlocked by a city: Rome, Italy. Puerto Rico is not a country (it's a territory) but has a government, a distinct culture, and so on. Thus, here we do not define 'Country' but instead define 'Domain of a Country'."@en ;
    skos:prefLabel "Domain of a Country"@en .

ns8:ont00000140
    ns8:ont00001760 "https://www.commoncoreontologies.org/UnitsOfMeasureOntology" ;
    rdf:type owl:Class ;
    rdfs:comment "The type of particle quantified is typically either atoms or molecules, but may also be protons, neutrons, electrons, quarks, or other particles. The type of particle being measured should always be specified along with the measurement and its unit."@en ;
    rdfs:label "Measurement Unit of Amount of Substance"@en ;
    rdfs:subClassOf ns8:ont00000120 ;
    skos:altLabel "Measurement Unit of Chemical Amount"@en, "Measurement Unit of Enplethy"@en ;
    skos:definition "A Measurement Unit that is used as a standard for measurement of the number of a specified type of particle in a portion of matter."@en ;
    skos:example "mole, pound-mole" .

ns8:ont00000141
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Population&oldid=1059148871"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Populace"@en ;
    rdfs:subClassOf ns8:ont00000914 ;
    skos:definition "A Group of Persons forming the total population of some Government Domain."@en .

ns8:ont00000142
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Act of Government"@en ;
    rdfs:subClassOf ns8:ont00000228 ;
    skos:definition "A Planned Act that is initiated or supported by some Geopolitical Entity and enforced by some Government Agent."@en .

ns8:ont00000143
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Cargo Cabin"@en ;
    rdfs:subClassOf ns8:ont00000103 ;
    skos:definition "A Vehicle Compartment that is used to store goods or materials during transportation."@en .

ns8:ont00000144
    ns8:ont00001754 "http://wordnetweb.princeton.edu/perl/webwn?s=meet (Sense Key: meet%2:41:00, get together%2:41:00)" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Act of Meeting"@en ;
    rdfs:subClassOf ns8:ont00000433 ;
    skos:definition "An Act of Association wherein two or more Persons assemble for some common purpose."@en .

ns8:ont00000145
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Incendiary_device&oldid=1055642422"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Incendiary Weapon"@en ;
    rdfs:subClassOf ns8:ont00000445 ;
    skos:definition "A Weapon that is designed to inflict harm, damage, or incapacity by means of starting a fire."@en .

ns8:ont00000146
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Constructed_language&oldid=1062733589"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI ;
    owl:disjointWith ns8:ont00000496 ;
    rdf:type owl:Class ;
    rdfs:label "Artificial Language"@en ;
    rdfs:subClassOf ns8:ont00001175 ;
    skos:definition "A Language that is developed through conscious planning and premeditation, rather than one that was developed through use and repetition."@en ;
    skos:example "Esperanto", "Python Programming Language" .

ns8:ont00000147
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Transponder_(aeronautics)&oldid=1052688836"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Flight Transponder"@en ;
    rdfs:subClassOf ns8:ont00000325 ;
    skos:definition "A Radio Transponder that is designed to produce a specified response (typically for identification, location, or status update purposes) when it receives a radio-frequency interrogation."@en .

ns8:ont00000148
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Clockwise Rotational Motion"@en ;
    rdfs:subClassOf ns8:ont00000368 ;
    skos:altLabel "CW Rotational Motion"@en, "Clockwise Rotation"@en ;
    skos:definition "A Rotational Motion in which the direction of rotation is toward the right as seen relative to the designated side of the plane of rotation."@en ;
    skos:example "the axial rotation of the Earth as seen from above the South Pole" .

ns8:ont00000149
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Instant_messaging&oldid=1062873579"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Instant Messaging"@en ;
    rdfs:subClassOf ns8:ont00000517 ;
    skos:altLabel "Act of IMing"@en, "Act of Instant Messaging"@en ;
    skos:definition "An Act of Communication by Media in which real-time direct text-based communication occurs between two or more people using personal computers or other devices, along with shared Instant Messaging Client Software conveyed over a network, such as the Internet."@en .

ns8:ont00000150
    ns8:ont00001753 "RF" ;
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Radio_wave&oldid=1062110903"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Radio Frequency"@en ;
    rdfs:subClassOf ns8:ont00000754 ;
    skos:definition "An Electromagnetic Radiation Frequency of some Electromagnetic Wave that is between 3 kHz and 300 GHz."@en .

ns8:ont00000151
    ns8:ont00001754 "http://www.merriam-webster.com/dictionary/report" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Act of Reporting"@en ;
    rdfs:subClassOf ns8:ont00000379 ;
    skos:definition "An Act of Representative Communication performed by giving a detailed account or statement."@en .

ns8:ont00000152
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Telephone_network&oldid=1046265527"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Telephone Network"@en ;
    rdfs:subClassOf ns8:ont00000998 ;
    skos:definition "A Telecommunication Network that is designed to allow telephone calls to be made between two or more parties connected to the network."@en .

ns8:ont00000153
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Generator Control Unit"@en ;
    rdfs:subClassOf ns8:ont00000781 ;
    skos:definition "A Control System that is designed to regulate the voltage of some Electrical Power Source."@en .

ns8:ont00000154
    ns8:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:comment "While there is always at least one Mode for every set of data, it is possible for any given set of data to have multiple Modes. The Mode is typically most useful when the members of the set are all Nominal Measurement Information Content Entities."@en ;
    rdfs:label "Mode Point Estimate Information Content Entity"@en ;
    rdfs:subClassOf ns8:ont00000745 ;
    skos:altLabel "Mode"@en, "Statistical Mode"@en ;
    skos:definition "A Point Estimate Information Content Entity that is a measurement of a set of values and is equal to the value or values that occur most often in the set."@en .

ns8:ont00000155
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Electromagnetic_spectrum&oldid=1063851392"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Near Infrared Light Frequency"@en ;
    rdfs:subClassOf ns8:ont00001337 ;
    skos:definition "An Infrared Light Frequency that is between 214 and 400 terahertz."@en .

ns8:ont00000156
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Handgun&oldid=1060570395"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Hand Gun"@en ;
    rdfs:subClassOf ns8:ont00000088 ;
    skos:definition "A Firearm that is designed to have a relatively short barrel and to be held in one or two hands and to be fired without being braced against the shoulder."@en .

ns8:ont00000157
    ns8:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Facial Hair"@en ;
    rdfs:subClassOf ns8:ont00000084 ;
    skos:definition "A Bodily Component that consists of a portion of hair that grows on the face of a human (typically male) or other animal."@en .

ns8:ont00000158
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Lithium-ion_battery&oldid=1064099588"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Lithium-ion Electric Battery"@en ;
    rdfs:subClassOf ns8:ont00001105 ;
    skos:definition "A Secondary Cell Electric Battery that produces electricity when lithium ions move from anode to cathode."@en .

ns8:ont00000159
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Timekeeper&oldid=1061681902"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Timekeeping Instrument"@en ;
    rdfs:subClassOf ns8:ont00000798 ;
    skos:definition "An Information Bearing Artifact that is designed to bear some specific Information Content Entity that is about some temporal region."@en .

ns8:ont00000160
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Hand_tool&oldid=1060741381"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Manual Tool"@en ;
    rdfs:subClassOf ns8:ont00000581 ;
    skos:altLabel "Hand Tool"@en ;
    skos:definition "A Tool that is designed to be powered by manual labor rather than by an engine."@en .

ns8:ont00000161
    ns8:ont00001760 "https://www.commoncoreontologies.org/GeospatialOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Coordinate System Axis"@en ;
    rdfs:subClassOf ns1:BFO_0000026 ;
    skos:definition "A One-Dimensional Spatial Region defined by a Coordinate System for the purpose of identifying the position of entities along one dimension of the Coordinate System's spatial framework."@en .

ns8:ont00000162
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Electrical Connector Artifact Function"@en ;
    rdfs:subClassOf ns8:ont00000795 ;
    skos:definition "An Electrical Conduction Artifact Function that is realized by processes in which some Artifact is used to join electrical terminations to create an electrical circuit."@en .

ns8:ont00000163
    ns8:ont00001760 "https://www.commoncoreontologies.org/GeospatialOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "z-Axis"@en ;
    rdfs:subClassOf ns8:ont00000161 ;
    skos:definition "A Coordinate System Axis designated by the variable 'z'."@en .

ns8:ont00000164
    ns8:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Minimum Ordinal Measurement Information Content Entity"@en ;
    rdfs:subClassOf ns8:ont00001010 ;
    skos:definition "An Ordinal Measurement Information Content Entity that is a measurement of some entity in virtue of it being the smallest or having the least amount relative to a nominally described set of like entities."@en .

ns8:ont00000165
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Crime&oldid=1062237249"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Criminal Act"@en ;
    rdfs:subClassOf ns8:ont00000228 ;
    skos:definition "A Planned Act committed in violation of rules or laws for which some governing authority (via mechanisms such as legal systems) can prescribe a conviction."@en .

ns8:ont00000166
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Wave Cycle"@en ;
    rdfs:subClassOf ns8:ont00000099 ;
    skos:definition "A Wave Process that consists of a portion of a Wave Process that begins at an arbitrary point of the Wave Process and ends at the next point when the pattern of the Wave Process begins to repeat."@en .

ns8:ont00000167
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Large-Scale Rocket Launcher"@en ;
    rdfs:subClassOf ns8:ont00001173 ;
    skos:definition "A Rocket Launcher that is designed to contain multiple Rocket Launchers."@en .

ns8:ont00000168
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Interpersonal_relationship&oldid=1060991304"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Act of Interpersonal Relationship"@en ;
    rdfs:subClassOf ns8:ont00000433 ;
    skos:definition "An Act of Association between two or more Persons that may range from fleeting to enduring."@en .

ns8:ont00000169
    ns8:ont00001753 "VHF" ;
    ns8:ont00001754 "International Telecommunication Union (ITU) and IEEE 521-2002 - IEEE Standard Letter Designations for Radar-Frequency Bands" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:comment "The corresponding Wavelength range is 10–1 m"@en ;
    rdfs:label "Very High Frequency"@en ;
    rdfs:subClassOf ns8:ont00000150 ;
    skos:altLabel "ITU Band Number 8"@en ;
    skos:definition "A Radio Frequency that is between 30 and 300 MHz."@en .

ns8:ont00000170
    ns8:ont00001760 "https://www.commoncoreontologies.org/GeospatialOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Object Track Point"@en ;
    rdfs:subClassOf _:nimportcommonb222, ns1:BFO_0000018 ;
    skos:definition "A Zero-Dimensional Spatial Region that is an idealized point where an Object is or was located during some motion."@en .

ns8:ont00000171
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Detergent&oldid=1064079329"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Detergent Artifact Function"@en ;
    rdfs:subClassOf ns8:ont00000344 ;
    skos:definition "A Surfactant Artifact Function that is realized in a process that cleans substances in dilute solutions."@en .

ns8:ont00000172
    ns8:ont00001753 "MOB" ;
    ns8:ont00001754 "http://www.jcs.mil/Portals/36/Documents/Doctrine/pubs/dictionary.pdf?ver=2018-08-27-122235-653" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Base of Operations"@en ;
    rdfs:subClassOf ns8:ont00000483 ;
    skos:altLabel "Main Operating Base"@en ;
    skos:definition "A Military Base with permanently stationed operating forces, robust Infrastructure, and strengthened force protection measures such that it is designed to launch and support large-scale operations, support smaller or less-permanent bases, and organize supply facilities."@en .

ns8:ont00000173
    ns8:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Civilian Role"@en ;
    rdfs:subClassOf ns1:BFO_0000023 ;
    skos:definition "A Role that inheres in an Agent or Group of Agents by virtue of that Agent or Group of Agents not being part of either an Armed Force or police force."@en .

ns8:ont00000174
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Ultraviolet Telescope"@en ;
    rdfs:subClassOf ns8:ont00000547 ;
    skos:altLabel "UV Telescope"@en ;
    skos:definition "A Telescope that is designed to aid in the observation of spatially distant Objects by means of collecting and focusing ultraviolet light to form an enhanced image of the Object."@en .

ns8:ont00000175
    ns8:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Organization Member Role"@en ;
    rdfs:subClassOf ns1:BFO_0000023 ;
    skos:definition "A Role that inheres in an Agent in virtue of the responsibilities that Agent is expected to fulfill as a member of some Organization."@en .

ns8:ont00000176
    dcterms:bibliographicCitation "Lee, David S., and Brad Glosserman. “How Companies Can Navigate Today’s Geopolitical Risks.” Harvard Business Review, 28 Nov. 2022. hbr.org, https://hbr.org/2022/11/how-companies-can-navigate-todays-geopolitical-risks.", "University, Utah State. Geopolitical Power | Aggies GO. https://chass.usu.edu/international-studies/aggies-go/power. Accessed 6 Apr. 2023." ;
    dcterms:created "2022-12-30T21:32:27-05:00"^^xsd:dateTime ;
    dcterms:creator "https://cubrc.org"^^xsd:anyURI ;
    ns8:ont00001754 "https://chass.usu.edu/international-studies/aggies-go/power", "https://hbr.org/2022/11/how-companies-can-navigate-todays-geopolitical-risks" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI ;
    owl:equivalentClass _:nimportcommonb223 ;
    rdf:type owl:Class ;
    rdfs:label "Geopolitical Organization"@en ;
    rdfs:subClassOf ns8:ont00001180 ;
    skos:definition "An Organization that bears a Geopolitical Power Role."@en ;
    skos:prefLabel "Geopolitical Organization"@en .

ns8:ont00000177
    ns8:ont00001754 "J. J. Gibson, \"The Theory of Affordances,\" in The Ecological Approach to Visual Perception (NY: Taylor & Francis Group, 1986): 127-143. Available at: https://archive.org/details/pdfy-u5hmFOvOM2Civ4Gz/page/n70/mode/1up."@en ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Affordance"@en ;
    rdfs:subClassOf ns1:BFO_0000017 ;
    skos:definition "A Realizable Entity of an Independent Continuant that creates an opportunity for an Agent to realize some Agent Capability or Disposition in some Act."@en .

ns8:ont00000178
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Arrow&oldid=1058445874"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Arrow"@en ;
    rdfs:subClassOf ns8:ont00001150 ;
    skos:definition "A Portion of Ammunition that is designed to be fired from a Bow and consists of a long straight stiff shaft with stabilizers (fletchings) and a slot (the nock) on one end and a weighted tip (the arrowhead) on the other end."@en .

ns8:ont00000179
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:comment "More generally, Thrust is the propulsive Force of a Rocket."@en ;
    rdfs:label "Thrust"@en ;
    rdfs:subClassOf ns8:ont00000570 ;
    skos:definition "A Force that is equal in magnitude to but in the opposite direction of an exerted Force and which is used to describe the forward Force of a Jet or Rocket Engine in reaction to the Acceleration of its Reaction Mass in the opposite direction."@en .

ns8:ont00000180
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Hotel&oldid=1063583593"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Hotel"@en ;
    rdfs:subClassOf ns8:ont00000410 ;
    skos:definition "A Residential Facility that is designed to provide lodging that is paid for on a short-term basis."@en .

ns8:ont00000181
    ns8:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Language Skill"@en ;
    rdfs:subClassOf ns8:ont00000089 ;
    skos:definition "A Skill that is realized by an Act which is prescribed by a Language."@en .

ns8:ont00000182
    ns8:ont00001754 " http://www.merriam-webster.com/dictionary/thanks" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Act of Thanking"@en ;
    rdfs:subClassOf ns8:ont00000123 ;
    skos:definition "An Act of Expressive Communication performed by expressing gratitude."@en .

ns8:ont00000183
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Perfume&oldid=1062785740"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Fragrance Artifact Function"@en ;
    rdfs:subClassOf ns8:ont00000323 ;
    skos:definition "An Artifact Function that is realized in processes of perceiving a pleasant or sweet odor."@en .

ns8:ont00000184
    ns8:ont00001760 "https://www.commoncoreontologies.org/TimeOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Axial Rotation Period"@en ;
    rdfs:subClassOf ns1:BFO_0000202 ;
    skos:definition "A Temporal Interval that is equal to the length of time required for a spinning Object to complete one rotation around its Axis of Rotation."@en .

ns8:ont00000185
    ns8:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Blunt"@en ;
    rdfs:subClassOf ns8:ont00001059 ;
    skos:definition "A Shape Quality inhering in a bearer in virtue of the bearer not having a sharp edge or point."@en .

ns8:ont00000186
    ns8:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Artifact Version Ordinality"@en ;
    rdfs:subClassOf ns8:ont00001010 ;
    skos:definition "An Ordinal Measurement Information Content Entity that is about the form of an Artifact which differs in some respects from previous or future forms of that Artifact."@en .

ns8:ont00000187
    ns8:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Authority Role"@en ;
    rdfs:subClassOf ns1:BFO_0000023 ;
    skos:definition "A Role that is realized by Processes which create, modify, transfer, or eliminate Process Regulations or other Authority Roles, and inheres in an Agent in virtue of collective acceptance of that Agent's ability to issue binding directives."@en ;
    skos:scopeNote "Authority Roles are externally grounded in a social group's collective acceptance of the binding force of the agent's directives. This acceptance can be direct or indirect (e.g., by accepting a procedure for deputizing authority). Such collective acceptance need not be explicit or cognized; rather, collective acceptance can be expressed in the dispositions and attitudes of people toward that agent's directives. In many cases, the directives issued by Authority Roles are backed by threats of punishment or sanction for failure to comply, but the issuing of a directive plus a threat is not sufficient for authority. Rather, an agent's authority must be accepted either directly or indirectly through the acceptance of a procedure for bestowing authority (e.g., elections)."@en .

ns8:ont00000188
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Ground_track&oldid=1058025510"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/GeospatialOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Ground Track"@en ;
    rdfs:subClassOf ns1:BFO_0000026 ;
    skos:altLabel "Ground Trace"@en ;
    skos:definition "A One-Dimensional Spatial Region defined by the line formed on the surface of an Astronomical Body by projecting an imaginary line from the center of the tracked Object to the center of the Astronomical Body as the Object travels above the surface."@en ;
    skos:scopeNote "The Ground Track is the line on the surface of the Earth or other Astronomical Body that is located directly below the Object Track."@en .

ns8:ont00000189
    ns8:ont00001754 "http://www.dictionary.com/browse/degree" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Certificate"@en ;
    rdfs:subClassOf ns8:ont00000798 ;
    skos:definition "An Information Bearing Artifact that bears an Information Content Entity which attests to certain demonstrated characteristics of an Object, Person, or Organization."@en .

ns8:ont00000190
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Minimum Speed Artifact Function"@en ;
    rdfs:subClassOf ns8:ont00001353 ;
    skos:definition "A Speed Artifact Function that is realized in some process in which the Artifact bearing the Artifact Function attains the lowest speed at which that Artifact is designed to operate."@en .

ns8:ont00000191
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Act of Homicide"@en ;
    rdfs:subClassOf _:nimportcommonb227, ns8:ont00001147 ;
    skos:definition "An Act of Violence which causes the unlawful killing of another person."@en .

ns8:ont00000192
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Facility"@en ;
    rdfs:subClassOf _:nimportcommonb228, ns8:ont00000995 ;
    skos:definition "A Material Artifact that is designed as a building or campus dedicated to some specific purpose."@en .

ns8:ont00000193
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Telephone_line&oldid=1063429738"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Telephone Subscriber Line"@en ;
    rdfs:subClassOf ns8:ont00000059 ;
    skos:definition "A Telephone Line that connects a Communication Endpoint to another node in a Telecommunication Network to enable service to a user's Telephone."@en .

ns8:ont00000194
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Electrical Contact Artifact Function"@en ;
    rdfs:subClassOf ns8:ont00000795 ;
    skos:definition "An Electrical Conduction Artifact Function that is realized by processes in which some Artifact is used as an endpoint of an electrical circuit from which an electrical current is passed via physical contact with the endpoint."@en .

ns8:ont00000195
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Heliport&oldid=1049937701"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Heliport"@en ;
    rdfs:subClassOf ns8:ont00001078 ;
    skos:definition "An Airport that is designed for launching, receiving, and housing Rotorcraft."@en .

ns8:ont00000196
    ns8:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Purple"@en ;
    rdfs:subClassOf ns8:ont00000378 ;
    skos:definition "A Color that is aproximately midway between Red and Blue."@en .

ns8:ont00000197
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Process Beginning"@en ;
    rdfs:subClassOf ns1:BFO_0000035 ;
    skos:definition "A Process Boundary that occurs on a Zero-Dimensional Temporal Region that is the starting instant of the One-Dimensional Temporal Region on which the Process, of which the Process Boundary is a part, occurs."@en .

ns8:ont00000198
    ns8:ont00001760 "https://www.commoncoreontologies.org/UnitsOfMeasureOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Measurement Unit of Sound Level"@en ;
    rdfs:subClassOf ns8:ont00000120 ;
    skos:definition "A Measurement Unit that is used as a standard for measurement of the level (the loudness) of sounds."@en ;
    skos:example "decibels, sones" .

ns8:ont00000199
    ns8:ont00001754 "http://www.dictionary.com/browse/camera" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Camera"@en ;
    rdfs:subClassOf ns8:ont00000771 ;
    skos:definition "An Imaging Instrument that is designed to form and digitally or physically record an image of an entity."@en .

ns8:ont00000200
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Pilgrimage&oldid=1056524204"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Act of Pilgrimage"@en ;
    rdfs:subClassOf ns8:ont00000890 ;
    skos:definition "An Act of Travel to a location of importance to a person's beliefs and faith."@en .

ns8:ont00000201
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Act of Change of Residence"@en ;
    rdfs:subClassOf ns8:ont00000065 ;
    skos:definition "An Act of Location Change involving one or more Persons moving from one place of residence to another."@en .

ns8:ont00000202
    ns8:ont00001754 "http://wordnetweb.princeton.edu/perl/webwn?s=terrorism" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Act of Terrorist Training Instruction"@en ;
    rdfs:subClassOf ns8:ont00001075 ;
    skos:definition "An Act of Training Instruction performed by an Agent who realizes a capacity derived from the Agent's affiliation with some Terrorist Organization by imparting knowledge of the tactics, techniques, and/or strategies of the use of violence against civilians in order to attain goals that are political, religous, or ideological in nature to an Agent either directly or indirectly through some communication medium."@en .

ns8:ont00000203
    ns8:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Event Status Nominal Information Content Entity"@en ;
    rdfs:subClassOf ns8:ont00000293 ;
    skos:definition "A Nominal Measurement Information Content Entity that is a measurement of the current state of a process."@en ;
    skos:example "proposed, approved, planned, in progress, completed, failed, or successful" .

ns8:ont00000204
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Rifle&oldid=1056172452"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Rifle"@en ;
    rdfs:subClassOf ns8:ont00001104 ;
    skos:definition "A Long Gun that is designed to have a rifled barrel and to fire single Bullets over long ranges with high accuracy."@en .

ns8:ont00000205
    ns8:ont00001760 "https://www.commoncoreontologies.org/GeospatialOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:comment "The exact line of the Object Track may be drawn based on the Center of Mass of the Object or another reference point, such as the location of a transponder beacon or the center of a radar cross-section, depending on the Object being tracked."@en ;
    rdfs:label "Object Track"@en ;
    rdfs:subClassOf _:nimportcommonb229, ns1:BFO_0000026 ;
    skos:definition "A One-Dimensional Spatial Region that consists of the idealized line along which an Object has traversed during some motion."@en .

ns8:ont00000206
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Friction&oldid=1061569068"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Friction Reduction Artifact Function"@en ;
    rdfs:subClassOf ns8:ont00000323 ;
    skos:definition "An Artifact Function that is realized in processes of reducing the force resisting the relative motion of surfaces in contact."@en .

ns8:ont00000207
    ns8:ont00001760 "https://www.commoncoreontologies.org/GeospatialOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "One-Dimensional Geospatial Boundary"@en ;
    rdfs:subClassOf ns1:BFO_0000142 ;
    skos:definition "A Fiat Line that is a boundary of some Geospatial Region."@en .

ns8:ont00000208
    ns8:ont00001754 "http://www.merriam-webster.com/dictionary/congratulate" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Act of Congratulating"@en ;
    rdfs:subClassOf ns8:ont00000123 ;
    skos:definition "An Act of Expressive Communication performed by expressing vicarious pleasure to a person on the occasion of their success or good fortune."@en .

ns8:ont00000209
    ns8:ont00001754 "http://www.physicsclassroom.com/Class/waves/u10l2b.cfm" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Sound Wavelength"@en ;
    rdfs:subClassOf ns8:ont00000313 ;
    skos:definition "A Wavelength that is the distance a Sound Wave traverses during one Wave Cycle."@en .

ns8:ont00000210
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Engine&oldid=1063879193"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Engine"@en ;
    rdfs:subClassOf ns8:ont00000995 ;
    skos:altLabel "Motor"@en ;
    skos:definition "A Material Artifact that is designed to convert one form of energy into mechanical energy."@en .

ns8:ont00000211
    ns8:ont00001760 "https://www.commoncoreontologies.org/TimeOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:comment "This is a defined class."@en ;
    rdfs:label "Multi-Day Temporal Interval"@en ;
    rdfs:subClassOf _:nimportcommonb230, ns1:BFO_0000038 ;
    skos:definition "A one-dimensional temporal region that is measured in Days and spans at least one Day."@en .

ns8:ont00000212
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Chemical_weapon&oldid=1054342645"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Chemical Weapon"@en ;
    rdfs:subClassOf ns8:ont00000445 ;
    skos:definition "A Weapon that is designed to inflict harm, damage, or incapacity by means of releasing toxic chemicals."@en .

ns8:ont00000213
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Continent&oldid=1064057312"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/GeospatialOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Subcontinent"@en ;
    rdfs:subClassOf ns8:ont00000472 ;
    skos:definition "A Geospatial Region that is bounded by a large, relatively self-contained landmass forming a subdivision of a Continent."@en .

ns8:ont00000214
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Moving Target Indication Artifact Function"@en ;
    rdfs:subClassOf ns8:ont00000289 ;
    skos:definition "A Radar Imaging Artifact Function that inheres in Artifacts that are designed to identify and produce visual representations of moving entities by using a radar to emit successive phase coherent pulses, which are sampled and added to the subsequent pulse to cancel out signals from non-moving entities such that only signals from moving entities remain and are displayed."@en .

ns8:ont00000215
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Radio_telescope&oldid=1052819190"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:comment "A Radio Telescope consists of a specialized Antenna and a Radio Receiver and is typically used to receive radio waves from sources in outer space."@en ;
    rdfs:label "Radio Telescope"@en ;
    rdfs:subClassOf ns8:ont00000547 ;
    skos:definition "A Telescope that is designed to aid in the observation of spatially distant Objects by means of collecting and focusing radio waves to form an enhanced image of the Object."@en .

ns8:ont00000216
    ns8:ont00001754 "https://en.wikipedia.org/wiki/Shell_(projectile)" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Shell"@en ;
    rdfs:subClassOf ns8:ont00001150 ;
    skos:definition "A Portion of Ammunition that is designed to be a non-self-propelled projectile and to carry a payload (explosive or other) over a relatively short distance."@en .

ns8:ont00000217
    ns8:ont00001760 "https://www.commoncoreontologies.org/UnitsOfMeasureOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Measurement Unit of Area"@en ;
    rdfs:subClassOf ns8:ont00000120 ;
    skos:definition "A Measurement Unit that is used as a standard for measurement of two-dimensional regions or Geospatial Regions."@en ;
    skos:example "square feet, square meters, acre, hectare" .

ns8:ont00000218
    ns8:ont00001760 "https://www.commoncoreontologies.org/GeospatialOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Major Axis"@en ;
    rdfs:subClassOf ns1:BFO_0000026 ;
    skos:definition "A One-Dimensional Spatial Region that is the longest line segment that connects two points on the edge of an Ellipse."@en .

ns8:ont00000219
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Reflecting_telescope&oldid=1062982683"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Reflecting Optical Telescope"@en ;
    rdfs:subClassOf ns8:ont00001009 ;
    skos:altLabel "Reflecting Telescope"@en, "Reflector"@en ;
    skos:definition "An Optical Telescope that is designed to aid in the observation of spatially distant Objects by means of collecting and focusing visible light via reflection through the use of one or more curved Mirrors to form an enhanced image of the Object."@en .

ns8:ont00000220
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Ammunition_dump&oldid=1044466765"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Ammunition Depot"@en ;
    rdfs:subClassOf ns8:ont00000881 ;
    skos:definition "A Storage Facility that is designed to store Portions of Ammunition."@en .

ns8:ont00000221
    ns8:ont00001760 "https://www.commoncoreontologies.org/GeospatialOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Semi-Minor Axis"@en ;
    rdfs:subClassOf ns1:BFO_0000026 ;
    skos:definition "A One-Dimensional Spatial Region that is equal to half the length of the Minor Axis of an Ellipse."@en .

ns8:ont00000222
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Presence Frequency"@en ;
    rdfs:subClassOf ns8:ont00000530 ;
    skos:definition "A Sonic Frequency that is between 4 and 6 kHz."@en .

ns8:ont00000223
    ns8:ont00001760 "https://www.commoncoreontologies.org/TimeOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Time of Day"@en ;
    rdfs:subClassOf _:nimportcommonb231, ns1:BFO_0000203 ;
    skos:definition "A Temporal Instant that is part of a Day."@en .

ns8:ont00000224
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Human_settlement&oldid=1060418164"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/GeospatialOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Populated place"@en ;
    rdfs:subClassOf ns8:ont00001197 ;
    skos:definition "An Anthropogenic Feature at which people live or have lived."@en .

ns8:ont00000225
    ns8:ont00001754 "http://wordnetweb.princeton.edu/perl/webwn?s=month" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/TimeOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Month"@en ;
    rdfs:subClassOf _:nimportcommonb232, ns1:BFO_0000202 ;
    skos:definition "A Temporal Interval that is based on the approximate length of time required for a Natural Satellite to complete one cycle of its rotational motion around its Primary Body."@en ;
    skos:scopeNote "Unless otherwise specified, it is assumed that a Month is specified relative to the Rotational Motion of the Moon around the Earth. Earth Months are approximately equal to four consecutive Weeks or 30 consecutive Days."@en .

ns8:ont00000226
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Transport&oldid=1063526665"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Transportation Facility"@en ;
    rdfs:subClassOf ns8:ont00000192 ;
    skos:definition "A Facility that is designed for commencing or concluding the transportation of transportation artifacts, or for housing transportation artifacts."@en .

ns8:ont00000227
    ns8:ont00001760 "https://www.commoncoreontologies.org/TimeOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:comment "A Julian Year begins concurrently with January 1, ends concurrently with December 31, and has an average duration of exactly 365.25 Julian Days. Julian Years are typically indicated by prefixing a capital 'J' in front of the Year number, e.g. J2000.0 or J2018."@en ;
    rdfs:label "Julian Year"@en ;
    rdfs:subClassOf ns8:ont00000674 ;
    skos:definition "A Calendar Year in the Julian Calendar."@en .

ns8:ont00000228
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Planned Act"@en ;
    rdfs:subClassOf ns8:ont00000005 ;
    skos:altLabel "Intentional Act"@en ;
    skos:definition "An Act in which at least one Agent plays a causative role and which is prescribed by some Directive Information Content Entity held by at least one of the Agents."@en .

ns8:ont00000229
    ns8:ont00001760 "https://www.commoncoreontologies.org/UnitsOfMeasureOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Measurement Unit of Power"@en ;
    rdfs:subClassOf ns8:ont00000120 ;
    skos:definition "A Measurement Unit that is used as a standard for measurement of rates of work."@en ;
    skos:example "watt, horsepower" .

ns8:ont00000230
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Diffraction_grating&oldid=1060463366"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Diffraction Grating"@en ;
    rdfs:subClassOf ns8:ont00000136 ;
    skos:definition "An Optical Instrument with a periodic structure that is designed to split and defract a beam of light into several beams travelling in different directions."@en .

ns8:ont00000231
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Torpedo_tube&oldid=1063672665"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Torpedo Tube"@en ;
    rdfs:subClassOf ns8:ont00001051 ;
    skos:definition "A Projectile Launcher that is designed to launch Torpedoes."@en .

ns8:ont00000232
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Pumping_station&oldid=1045678418"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Pumping Station"@en ;
    rdfs:subClassOf ns8:ont00000677 ;
    skos:definition "A Product Transport Facility that is designed to pump fluids from one place to another."@en .

ns8:ont00000233
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Stock Certificate"@en ;
    rdfs:subClassOf ns8:ont00001278 ;
    skos:definition "Stock that consists of a Certificate."@en .

ns8:ont00000234
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Education&oldid=1064011752"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Act of Training"@en ;
    rdfs:subClassOf ns8:ont00000228 ;
    skos:definition "A Planned Act in which knowledge, skills or values are imparted from one or more Agents to at least one other Agent."@en .

ns8:ont00000235
    ns8:ont00001754 "http://wordnetweb.princeton.edu/perl/webwn?s=vocational%20training" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Act of Vocational Training Acquisition"@en ;
    rdfs:subClassOf ns8:ont00000687 ;
    skos:definition "An Act of Training Acquisition performed by an Agent by acquiring skills required for a specific occupation in industry, agriculture or trade from an Agent or communication medium that realizes a capacity derived from its affiliation with a Vocational School, Technical School, Trade Organization, or Industry Educational Program Provider."@en .

ns8:ont00000236
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Lighting System"@en ;
    rdfs:subClassOf ns8:ont00000995 ;
    skos:definition "A Material Artifact that is designed to emit light within some area."@en .

ns8:ont00000237
    ns8:ont00001754 "http://wordnetweb.princeton.edu/perl/webwn?s=terrorism" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Act of Terrorist Training Acquisition"@en ;
    rdfs:subClassOf ns8:ont00000687 ;
    skos:definition "An Act of Training Acquisition performed by an Agent by acquiring knowledge of the tactics, techniques, and/or strategies of the use of violence against civilians in order to attain goals that are political, religous, or ideological in nature from an Agent or communication medium that realizes a capacity derived from its affiliation with a Terrorist Organization."@en .

ns8:ont00000238
    ns8:ont00001754 "https://en.wikipedia.org/wiki/Propeller_(aeronautics)" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Propeller"@en ;
    rdfs:subClassOf ns8:ont00000995 ;
    skos:altLabel "Propelling Screw"@en ;
    skos:definition "A Material Artifact that is designed to convert rotary motion from an Engine or other mechanical Power Source into propulsive Force."@en .

ns8:ont00000239
    ns8:ont00001760 "https://www.commoncoreontologies.org/UnitsOfMeasureOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Measurement Unit of Mass"@en ;
    rdfs:subClassOf ns8:ont00000120 ;
    skos:definition "A Measurement Unit that is used as a standard for measurement of an object's resistance to Acceleration when a Force is applied to the object."@en ;
    skos:example "ounce, gram, pound" .

ns8:ont00000240
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Oath&oldid=1052326917"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Act of Oath Taking"@en ;
    rdfs:subClassOf ns8:ont00001162 ;
    skos:definition "An Act of Commissive Communication performed by stating or promising, usually calling upon something or someone that the oath maker considers sacred."@en .

ns8:ont00000241
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Two-Dimensional Barcode"@en ;
    rdfs:subClassOf ns8:ont00001064 ;
    skos:definition "A Barcode that is designed to bear lines of varying widths, spacing, height, and color that concretize some Directive Information Content Entity."@en .

ns8:ont00000242
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Data Matrix Code"@en ;
    rdfs:subClassOf ns8:ont00000241 ;
    skos:definition "A Two-Dimensional Barcode that consists of cells arranged in rectangular patterns and is used for marking small items in logistics and operations."@en .

ns8:ont00000243
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Heat_sink&oldid=1062822080"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Heat Sink"@en ;
    rdfs:subClassOf ns8:ont00000995 ;
    skos:definition "A Material Artifact that is designed to regulate the temperature of a computer by the passive transfer of heat away from other components in the computer."@en .

ns8:ont00000244
    ns8:ont00001754 "http://www.dictionary.com/browse/fragmentation" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Fragmentation Artifact Function"@en ;
    rdfs:subClassOf ns8:ont00001153 ;
    skos:definition "A Damaging Artifact Function that is realized in a process in which the structural integrity of an entity is impaired because of a detonation which causes fragmentation."@en .

ns8:ont00000245
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Petroleum&oldid=1062956217"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Petroleum Manufacturing Facility"@en ;
    rdfs:subClassOf ns8:ont00000782 ;
    skos:definition "A Factory that is designed to manufacture petroleum-based products."@en .

ns8:ont00000246
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Stasis of Realizable Entity"@en ;
    rdfs:subClassOf ns8:ont00000135 ;
    skos:definition "A Stasis of Specifically Dependent Continuant in which some Independent Continuant bears some Realizable Entity that remains unchanged during a Temporal Interval."@en .

ns8:ont00000247
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Road&oldid=1063402841" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Road"@en ;
    rdfs:subClassOf ns8:ont00001326 ;
    skos:definition "A Land Transportation Artifact that is designed to enable Ground Vehicles to travel from one location to another."@en .

ns8:ont00000248
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Chemical_industry&oldid=1061177027"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Chemical Manufacturing Facility"@en ;
    rdfs:subClassOf ns8:ont00000782 ;
    skos:definition "A Factory that is designed to manufacture or process chemicals."@en .

ns8:ont00000249
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Shaft&oldid=1023963656"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:comment "A Shaft is usually used to connect other components of a drive train that cannot be connected directly either because of the distance between them or the need to allow for relative movement between those components."@en ;
    rdfs:label "Shaft"@en ;
    rdfs:subClassOf ns8:ont00000995 ;
    skos:definition "A Material Artifact that is designed to rotate and transmit Torque, Power, or Rotational Motion from one machine element to another."@en .

ns8:ont00000250
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Loss of Realizable Entity"@en ;
    rdfs:subClassOf ns8:ont00000865 ;
    skos:definition "A Loss of Specifically Dependent Continuant in which some Independent Continuant ceases to be the bearer of some Realizable Entity."@en .

ns8:ont00000251
    ns8:ont00001754 "JC3IEDM version 3.0.2" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/GeospatialOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Continent"@en ;
    rdfs:subClassOf ns8:ont00000472 ;
    skos:definition "A Geospatial Region that is bounded by any of the Earth's main continuous expanses of land."@en .

ns8:ont00000252
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Nozzle"@en ;
    rdfs:subClassOf ns8:ont00000256 ;
    skos:definition "A Fluid Control Artifact that is designed to control the speed, direction, rate, shape, or pressure of the flow of fluid exiting it."@en .

ns8:ont00000253
    ns8:ont00001754 "http://purl.obolibrary.org/obo/IAO_0000178"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI ;
    owl:equivalentClass _:nimportcommonb233 ;
    rdf:type owl:Class ;
    rdfs:label "Information Bearing Entity"@en ;
    rdfs:subClassOf ns1:BFO_0000030 ;
    skos:altLabel "IBE"@en ;
    skos:definition "An Object upon which an Information Content Entity generically depends."@en .

ns8:ont00000254
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Transportation Artifact"@en ;
    rdfs:subClassOf ns8:ont00000995 ;
    skos:definition "A Material Artifact that is fixed in place and designed to bear a Function, the realization of which is sometimes part of a process moving Vehicles and Agents from one location to another."@en .

ns8:ont00000255
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Portion of Cryogenic Material"@en ;
    rdfs:subClassOf ns8:ont00000457 ;
    skos:definition "A Portion of Material that has been reduced to a very low temperature (below -180 degrees Celcius)."@en .

ns8:ont00000256
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Fluid Control Artifact"@en ;
    rdfs:subClassOf ns8:ont00000995 ;
    skos:definition "A Material Artifact that is designed to manipulate the flow of a fluid (i.e. a liquid or a gas)."@en .

ns8:ont00000257
    ns8:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Radiopaque"@en ;
    rdfs:subClassOf ns8:ont00000620 ;
    skos:altLabel "Radiodense"@en ;
    skos:definition "A Radiopacity that inheres in a bearer in virtue of its capacity to prevent most X-rays from passing through it."@en .

ns8:ont00000258
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "One-Dimensional Barcode"@en ;
    rdfs:subClassOf ns8:ont00001064 ;
    skos:definition "A Barcode that is designed to bear parallel lines of varying widths and spacing that concretize some Directive Information Content Entity."@en .

ns8:ont00000259
    ns8:ont00001760 "https://www.commoncoreontologies.org/TimeOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Calendar Month"@en ;
    rdfs:subClassOf ns8:ont00000225 ;
    skos:definition "A Month that begins and ends concurrently with the Days specified by a Calendar System to be the first and last Days of the Month."@en ;
    skos:example "January; February; March; April; May; June; July; August; September; October; November; December" .

ns8:ont00000260
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Muzzle Blast"@en ;
    rdfs:subClassOf ns8:ont00000675 ;
    skos:definition "A Sound Wave Process that is caused by a projectile being pushed from the barrel of a firearm by an explosive charge."@en .

ns8:ont00000261
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Gamma_ray&oldid=1062115897"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:comment """Currently gamma radiation is distinguished from x-rays by their source--either inside or outside of the nucleus--rather than by frequency, energy, and wavelength.
https://en.wikipedia.org/wiki/Gamma_ray#Naming_conventions_and_overlap_in_terminology"""@en ;
    rdfs:label "Gamma Ray Frequency"@en ;
    rdfs:subClassOf ns8:ont00000754 ;
    skos:definition "An Electromagnetic Radiation Frequency of some Electromagnetic Wave that is above 30 exahertz."@en .

ns8:ont00000262
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Retail&oldid=1061431295"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Shop"@en ;
    rdfs:subClassOf ns8:ont00001102 ;
    skos:definition "A Commercial Facility designed to sell small lots of goods to consumers."@en .

ns8:ont00000263
    ns8:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:comment "A single Clock Time System does not provide a complete means for identifying or measuring times. Depending on the particular Clock Time System, it may be compatible for use with one or more other Temporal Reference Systems."@en ;
    rdfs:label "Clock Time System"@en ;
    rdfs:subClassOf ns8:ont00001328 ;
    skos:definition "A Temporal Reference System that is a convention for keeping and displaying the Time of Day."@en .

ns8:ont00000264
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Hydraulic Fluid Reservoir"@en ;
    rdfs:subClassOf ns8:ont00000020 ;
    skos:definition "A Container that is designed to store some hydraulic fluid for use in some Hyrdraulic Power Source."@en .

ns8:ont00000265
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Election&oldid=1063238552"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Election"@en ;
    rdfs:subClassOf ns8:ont00001327 ;
    skos:altLabel "Act of Political Election"@en ;
    skos:definition "A Social Act by which a population chooses an individual to hold public office."@en .

ns8:ont00000266
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Hearing_aid&oldid=1062688647"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Hearing Aid"@en ;
    rdfs:subClassOf ns8:ont00001381 ;
    skos:definition "A Medical Artifact that is designed to improve hearing for its user."@en .

ns8:ont00000267
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Catalysis&oldid=1063864001"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Catalyst Artifact Function"@en ;
    rdfs:subClassOf ns8:ont00000791 ;
    skos:definition "A Chemical Reaction Artifact Function that is realized in a process in which the rate of a chemical reaction is increased due to the participation of an additional substance, without that substance being consumed in the reaction."@en .

ns8:ont00000268
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Cannon&oldid=1063792906"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Cannon"@en ;
    rdfs:subClassOf ns8:ont00001051 ;
    skos:definition "A Projectile Launcher that is designed to use a controlled explosion to launch a relatively large Portion of Ammunition, such as a Round Shot or a Shell, at a significant Velocity."@en .

ns8:ont00000269
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Transmitter&oldid=1061735586"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Radio Transmitter"@en ;
    rdfs:subClassOf ns8:ont00000903 ;
    skos:definition "A Radio Communication Instrument that is an electronic device that is designed to generate a radio frequency alternating current, which can be applied to a Radio Antenna to be transmitted as radio waves."@en .

ns8:ont00000270
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Education&oldid=1064011752"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Educational Facility"@en ;
    rdfs:subClassOf ns8:ont00000192 ;
    skos:definition "A Facility that is designed for facilitating learning, or the acquisition of knowledge, skills, values, beliefs, and habits."@en .

ns8:ont00000271
    ns8:ont00001754 "https://en.wikipedia.org/wiki/Underground_mining_(hard_rock)" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Underground Mine"@en ;
    rdfs:subClassOf ns8:ont00000639 ;
    skos:definition "A Mine that is designed to support the extraction of materials from the ground using underground tunnels and shafts."@en .

ns8:ont00000272
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Combustion"@en ;
    rdfs:subClassOf ns8:ont00000007 ;
    skos:altLabel "Burning Process"@en, "Combustion Process"@en ;
    skos:definition "A Natural Process in which a Portion of Fuel or other Material Entity is burned."@en .

ns8:ont00000273
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Communication Interference Artifact Function"@en ;
    rdfs:subClassOf ns8:ont00000323 ;
    skos:definition "An Artifact Function that is realized during events in which an Artifact is used to interfere with the transmission of information for the purpose of preventing communication."@en .

ns8:ont00000274
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Military&oldid=1063431234"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Armed Force"@en ;
    rdfs:subClassOf ns8:ont00001180 ;
    skos:definition "An Organization having the Objective to further the foreign and domestic policies of a Government and to defend that body and the nation it represents from external and internal aggressors."@en .

ns8:ont00000275
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Coordinate_system&oldid=1060461397"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:comment "Note that, while reference systems and reference frames are treated as synonyms here, some people treat them as related but separate entities. See: http://www.ggos-portal.org/lang_en/GGOS-Portal/EN/Topics/GeodeticApplications/GeodeticReferenceSystemsAndFrames/GeodeticReferenceSystemsAndFrames.html"@en ;
    rdfs:label "Spatial Reference System"@en ;
    rdfs:subClassOf ns8:ont00000398 ;
    skos:altLabel "Coordinate System"@en, "Spatial Coordinate System"@en, "Spatial Reference Frame"@en ;
    skos:definition "A Reference System that describes a set of standards for uniquely identifying the position of an entity or the direction of a vector within a defined spatial region by means of measurements along one or more Coordinate System Axes."@en .

ns8:ont00000276
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Solar_calendar&oldid=1058016588"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Solar Calendar System"@en ;
    rdfs:subClassOf ns8:ont00000891 ;
    skos:definition "A Calendar System that is designed to organize and identify dates based on the cycles of an Astronomical Body's Orbit around the Sun."@en ;
    skos:scopeNote "Unless otherwise specified, a Solar Calendar System is assumed to be relative to the Orbit of the Earth around the Sun."@en .

ns8:ont00000277
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Nuclear_weapon&oldid=1060854171"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Nuclear Weapon"@en ;
    rdfs:subClassOf ns8:ont00000445 ;
    skos:definition "A Weapon that is designed to inflict harm, damage, or incapacity by means of a destructive nuclear reaction, either through fission or through a combination of fission and fusion."@en .

ns8:ont00000278
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:comment "The SI unit of measure for Momentum is Newton seconds (N s)."@en ;
    rdfs:label "Momentum"@en ;
    rdfs:subClassOf ns1:BFO_0000144 ;
    skos:definition "A Process Profile of an object in Motion that is the product of its Mass and Velocity with respect to a frame of reference."@en .

ns8:ont00000279
    ns8:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Enemy Role"@en ;
    rdfs:subClassOf ns8:ont00000392 ;
    skos:definition "An Allegiance Role that inheres in an Agent by virtue of that Agent having committed offensive Acts or exhibited intent to perform such Acts towards a particular Agent or Group of Agents or has been declared as hostile by some appropriate authority."@en .

ns8:ont00000280
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Torpedo&oldid=1062609830"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Torpedo"@en ;
    rdfs:subClassOf ns8:ont00001124 ;
    skos:definition "A Precision-Guided Missile that is designed to be fired into a body of water, be self-propelled through the water, and carry an explosive payload."@en .

ns8:ont00000281
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Albedo&oldid=1063352646"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Albedo"@en ;
    rdfs:subClassOf ns8:ont00001137 ;
    skos:definition "A Radiation Reflectivity that inheres in a bearer in virtue of the capacity of its surface to reflect incident electromagnetic radiation of a particular wavelength."@en ;
    skos:scopeNote "Albedo is a reflection coefficient and is measured as the ratio of radiation reflected from the surface to the incident radiation. Albedo is dimensionless, can be expressed as a percentage, and is measured on a scale from 0 for no reflection to 1 for perfect reflection of a surface. Albedo depends on the wavelength of the radiation; when no wavelength is specified, it typically refers to some appropriate average across the spectrum of visible light."@en .

ns8:ont00000282
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Counterfeit_money&oldid=1064052318"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Counterfeit Financial Instrument"@en ;
    rdfs:subClassOf ns8:ont00000719 ;
    skos:definition "A Counterfeit Instrument that is designed to be a fake replica of some legally sanctioned Financial Instrument."@en .

ns8:ont00000283
    ns8:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Cylindrical"@en ;
    rdfs:subClassOf ns8:ont00001360 ;
    skos:altLabel "Columnar"@en ;
    skos:definition "A Three Dimensional Shape inhering in a bearer in virtue of the bearer having an elongated shape with round bases."@en .

ns8:ont00000284
    ns8:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Strength"@en ;
    rdfs:subClassOf ns1:BFO_0000017 ;
    skos:definition "A Realizable Entity that is realized when its bearer exerts or resists some power, influence, or force."@en ;
    skos:scopeNote "Strength is intended to be understood broadly here. Physical strength is only one type of Strength. Other subtypes of Strength may include military strength, psychological strength, emotional strength, political strength, technological strength, and so on."@en .

ns8:ont00000285
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Emergency_position-indicating_radiobeacon&oldid=1063407242"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Emergency Locator Transmitter"@en ;
    rdfs:subClassOf ns8:ont00000269 ;
    skos:definition "A Radio Transmitter that is designed to signal distress and provide positional data for the entity it is located on."@en .

ns8:ont00000286
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Stasis of Partially Mission Capable Maintenance"@en ;
    rdfs:subClassOf ns8:ont00000100 ;
    skos:definition "A Stasis of Partially Mission Capable during which the participating Continuant is not capable of performing some of its primary functions for the specified Mission due to participating in an Act Of Maintenance."@en .

ns8:ont00000287
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Inertial_navigation_system&oldid=1063682725"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Inertial Navigation System"@en ;
    rdfs:subClassOf ns8:ont00001187 ;
    skos:altLabel "INS"@en ;
    skos:definition "A Navigation System that is designed to continuously calculate via dead reckoning the position, orientation, and velocity of a moving object without the need for external references."@en .

ns8:ont00000288
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Power_source&oldid=1032888635"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Power Source"@en ;
    rdfs:subClassOf ns8:ont00000995 ;
    skos:definition "A Material Artifact that is designed to supply power to some other Artifact."@en .

ns8:ont00000289
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Radar Imaging Artifact Function"@en ;
    rdfs:subClassOf ns8:ont00000601 ;
    skos:definition "An Imaging Artifact Function that inheres in Artifacts that are designed to produce visual representations of entities using radio waves."@en .

ns8:ont00000290
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Decrease of Specifically Dependent Continuant"@en ;
    rdfs:subClassOf ns8:ont00000726 ;
    skos:definition "A Decrease of Dependent Continuant in which some Independent Continuant has a decrease in some Specifically Dependent Continuant that it bears."@en .

ns8:ont00000291
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Act of Decoy Use"@en ;
    rdfs:subClassOf ns8:ont00000566 ;
    skos:definition "An Act of Artifact Employment in which some Agent uses some Decoy."@en .

ns8:ont00000292
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    owl:equivalentClass _:nimportcommonb237 ;
    rdf:type owl:Class ;
    rdfs:label "Artifact Identifier"@en ;
    rdfs:subClassOf ns8:ont00000686 ;
    skos:definition "A Designative Information Content Entity which designates some Artifact."@en .

ns8:ont00000293
    ns8:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI ;
    owl:disjointWith ns8:ont00001010, ns8:ont00001022, ns8:ont00001364 ;
    owl:equivalentClass _:nimportcommonb241 ;
    rdf:type owl:Class ;
    rdfs:comment "Four of the subtypes of measurements used here (Interval, Nominal, Ordinal, and Ratio) were originally defined by S.S. Stevens in the article \"On the Theory of Scales of Measurement\" in Science, Vol. 103 No. 2684 on June 7, 1946. For an introductory article with links to additional content including criticisms and alternate classifications of measurements see https://en.wikipedia.org/wiki/Level_of_measurement"@en ;
    rdfs:label "Nominal Measurement Information Content Entity"@en ;
    rdfs:subClassOf ns8:ont00001163 ;
    skos:definition "A Measurement Information Content Entity that consists of a symbol that classifies Entities according to some shared, possibly arbitrary, characteristic."@en ;
    skos:example "The sentence \"January 20, 1985 was a cold day in Chicago, IL\" is the carrier of a nominal measurement."@en, "a measurement that classifies automobiles as sedans, coupes, hatchbacks, or convertibles", "a measurement that classifies military intelligence as strategic, operational, or tactical", "a measurement that classifies rocks as igneous, sedimentary, or metamorphic" .

ns8:ont00000294
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Airbreathing_jet_engine&oldid=1062364308"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Air-Breathing Jet Engine"@en ;
    rdfs:subClassOf ns8:ont00000533 ;
    skos:altLabel "Ducted Jet Engine"@en ;
    skos:definition "A Jet Engine that is propelled by a jet of hot exhaust gases formed from air that is drawn into the Engine via an Air Inlet."@en .

ns8:ont00000295
    ns8:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Wetness"@en ;
    rdfs:subClassOf ns1:BFO_0000019 ;
    skos:definition "A Quality that inheres in a bearer in virtue of the degree to which the bearer is covered by a liquid, typically on a continuum of dry to wet."@en .

ns8:ont00000296
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Angular_velocity&oldid=1060081663"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Angular Velocity"@en ;
    rdfs:subClassOf ns8:ont00000763 ;
    skos:altLabel "Rotational Velocity"@en ;
    skos:definition "A Velocity that is characterized by both the angular Speed of an object and the Axis about which the object is Rotating."@en .

ns8:ont00000297
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Hydrosphere&oldid=1128848972"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/GeospatialOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Portion of Hydrosphere"@en ;
    rdfs:subClassOf ns1:BFO_0000024 ;
    skos:definition "A fiat object part of the combined mass of water found on, under, and above the surface of a natural satellite"@en .

ns8:ont00000298
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Shoulder-Fired Rocket Launcher"@en ;
    rdfs:subClassOf ns8:ont00001173 ;
    skos:definition "A Rocket Launcher that is designed to be small enough to be carried by a single person and fired while supported on the person's shoulder."@en .

ns8:ont00000299
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Prosthesis&oldid=1063749698"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Prosthetic Leg"@en ;
    rdfs:subClassOf ns8:ont00000715 ;
    skos:definition "A Prosthesis that is designed to replace a missing leg."@en .

ns8:ont00000300
    ns8:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Group of Agents"@en ;
    rdfs:subClassOf _:nimportcommonb245, ns1:BFO_0000027 ;
    skos:definition "An Object Aggregate that has only Agents as parts."@en .

ns8:ont00000301
    ns8:ont00001754 "https://en.wikipedia.org/wiki/Transmission_(mechanics)"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Vehicle Transmission"@en ;
    rdfs:subClassOf ns8:ont00000663 ;
    skos:altLabel "Gearbox"@en, "Transmission"@en ;
    skos:definition "A Power Transmission Artifact that is designed to vary the output speed and torque in a rotating power transfer system."@en .

ns8:ont00000302
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Alternating Current Power Source"@en ;
    rdfs:subClassOf ns8:ont00001049 ;
    skos:definition "An Electrical Power Source that is designed to transfer electrical power in the form of alternating current."@en .

ns8:ont00000303
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Intercom&oldid=1055934442"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Intercommunication System"@en ;
    rdfs:subClassOf ns8:ont00001036 ;
    skos:definition "A Communication System that is designed to enable some Act of Communication between end points within a building, small collection of buildings, or within a small area of service."@en .

ns8:ont00000304
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Microscope&oldid=1059024357"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Microscope"@en ;
    rdfs:subClassOf ns8:ont00000771 ;
    skos:definition "An Imaging Instrument that is designed to enable users to see Objects that are otherwise too small to be seen by the naked eye by producing a significantly enlarged image of the Object."@en .

ns8:ont00000305
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Sound Pressure"@en ;
    rdfs:subClassOf ns8:ont00000380 ;
    skos:altLabel "Acoustic Pressure"@en ;
    skos:definition "A Pressure that is caused by a Sound Wave and is a local deviation from the ambient Pressure."@en .

ns8:ont00000306
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Hinge&oldid=1059935559"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Hinge"@en ;
    rdfs:subClassOf ns8:ont00001370 ;
    skos:definition "A Machine Bearing that is designed to limit the angle of Rotation between two solid objects."@en .

ns8:ont00000307
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Food&oldid=1062824590"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Portion of Food"@en ;
    rdfs:subClassOf ns8:ont00001084 ;
    skos:definition "A Portion of Processed Material that is designed to be consumed and ingested for nutrition or taste."@en .

ns8:ont00000308
    ns8:ont00001754 "http://www.collinsdictionary.com/dictionary/english/military-service" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Act of Military Service"@en ;
    rdfs:subClassOf ns8:ont00001226 ;
    skos:definition "An Act of Employment wherein a Person serves as a member of a Military Force, whether voluntarily or by conscription."@en .

ns8:ont00000309
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Health_care&oldid=1064015344"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Healthcare Artifact Function"@en ;
    rdfs:subClassOf ns8:ont00001301 ;
    skos:definition "A Service Artifact Function that is realized in processes of treating and preventing illness."@en .

ns8:ont00000310
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Grenade&oldid=1060366148"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Grenade"@en ;
    rdfs:subClassOf ns8:ont00000552 ;
    skos:altLabel "Hand Grenade"@en ;
    skos:definition "An Explosive Weapon that is designed to be relatively small and to be thrown by hand."@en .

ns8:ont00000311
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Filtration&oldid=1061655528"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Filtration Artifact Function"@en ;
    rdfs:subClassOf ns8:ont00001999 ;
    skos:definition "A Filter Function that is realized in a process in which some solid entity is prevented from moving along with some quantity of liquid."@en .

ns8:ont00000312
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Propulsion Process"@en ;
    rdfs:subClassOf ns8:ont00000007 ;
    skos:definition "A Natural Process in which one or more Forces are generated and applied to a participating Object such that the Object is set in Motion or has the direction or magnitude of its Motion altered."@en ;
    skos:example "a twin-engine turboprop plane rotating both of its propellers against a portion of atmosphere to propel the plane forward", "an apple falling to the ground under the power of Earth's gravitational force", "burning a portion of fuel to produce exhaust that is ejected through a jet nozzle to propel a rocket and its payload", "heat from a fire causing ashes to rise into the sky", "launching a water balloon using a sling shot", "the wind blowing leaves across a lawn", "turning a paddle wheel against a portion of water to propel the paddle boat forward" ;
    skos:scopeNote "In each case, a Propulsion Process minimally involves the Object being propelled, a Reaction Mass (e.g. a portion of water, atmosphere, exhaust, etc.), and the Force(s) acting between these two entities."@en .

ns8:ont00000313
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:comment "Assuming a non-dispersive media, the Wavelength will be the inverse of the Frequency."@en ;
    rdfs:label "Wavelength"@en ;
    rdfs:subClassOf ns8:ont00000752 ;
    skos:definition "A Wave Process Profile that is the distance the Wave Process traverses during one Wave Cycle."@en .

ns8:ont00000314
    ns8:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:comment "Typically, an IQE will be a complex pattern made up of multiple qualities joined together spatially."@en ;
    rdfs:label "Information Quality Entity"@en ;
    rdfs:subClassOf _:nimportcommonb250, ns1:BFO_0000019 ;
    skos:altLabel "IQE"@en ;
    skos:definition "A Quality that concretizes some Information Content Entity."@en .

ns8:ont00000315
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Telecommunications_network&oldid=1063347482"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Telecommunication Switching Node"@en ;
    rdfs:subClassOf ns8:ont00000918 ;
    skos:definition "A Telecommunication Network Node that is capable of redirecting a communication transmission to another Telecommunication Network Node."@en .

ns8:ont00000316
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Portion of Liquid Helium"@en ;
    rdfs:subClassOf ns8:ont00000255 ;
    skos:definition "A Portion of Cryogenic Material that is composed (almost) entirely of liquid helium."@en .

ns8:ont00000317
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Electronic Signal Processing Artifact Function"@en ;
    rdfs:subClassOf ns8:ont00001218 ;
    skos:definition "A Signal Processing Artifact Function that inheres in Artifacts that are designed to process or transfer information contained in electronic signals."@en .

ns8:ont00000318
    ns8:ont00001754 "http://purl.obolibrary.org/obo/OGMS_0000031" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Disease"@en ;
    rdfs:subClassOf ns1:BFO_0000016 ;
    skos:definition "A Disposition to undergo pathological processes that exists in an organism because of one or more disorders in that organism."@en .

ns8:ont00000319
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Design&oldid=1063941625"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Artifact Design"@en ;
    rdfs:subClassOf _:nimportcommonb251, ns8:ont00000965 ;
    skos:definition "A Directive Information Content Entity that is a specification of an object, manifested by an agent, intended to accomplish goals, in a particular environment, using a set of primitive components, satisfying a set of requirements, subject to constraints."@en .

ns8:ont00000320
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Reconnaissance&oldid=1038843823"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Act of Reconnaissance"@en ;
    rdfs:subClassOf ns8:ont00001251 ;
    skos:definition "An Act of Intelligence Gathering used to determine an Agent's disposition and intention; the composition and capabilities of Equipment and Facilities, and the surrounding landforms and weather conditions."@en .

ns8:ont00000321
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Residence&oldid=1019728937"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Residential Artifact Function"@en ;
    rdfs:subClassOf ns8:ont00001301 ;
    skos:definition "A Service Artifact Function that is realized in processes of residing in a dwelling or home."@en .

ns8:ont00000322
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Act of Funding"@en ;
    rdfs:subClassOf ns8:ont00000836 ;
    skos:definition "An Act of Financial Instrument Use in which an Agent provides a sum of money to another Agent for a particular purpose."@en .

ns8:ont00000323
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Artifact Function"@en ;
    rdfs:subClassOf _:nimportcommonb252, ns1:BFO_0000034 ;
    skos:definition "A Function that inheres in some Artifact in virtue of that Artifact being designed to be used in processes that require that Function to be realized."@en .

ns8:ont00000324
    ns8:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Width"@en ;
    rdfs:subClassOf ns8:ont00001367 ;
    skos:definition "A One Dimensional Extent that inheres in a bearer in virtue of the bearer's extension in a horizontal direction."@en .

ns8:ont00000325
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Radio Transponder"@en ;
    rdfs:subClassOf ns8:ont00000903 ;
    skos:altLabel "Transmitter-Responder"@en ;
    skos:definition "A Radio Communication Instrument that is an electronic device that acts as both a Radio Transmitter and responder and is used to wirelessly receive and transmit electrical signals."@en .

ns8:ont00000326
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "UPC Barcode"@en ;
    rdfs:subClassOf ns8:ont00000258 ;
    skos:definition "A One-Dimensional Barcode that consists of 6 or 12 numerical digits and is used to scan consumer goods."@en .

ns8:ont00000327
    ns8:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Texture"@en ;
    rdfs:subClassOf ns1:BFO_0000019 ;
    skos:definition "A Quality that inheres in a bearer in virtue of the size, shape, and distribution of features on its surface, typically on a continuum from smooth to rough."@en .

ns8:ont00000328
    ns8:ont00001754 "http://www.cfr.org/infrastructure/transportation-infrastructure-moving-america/p18611" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Transportation Infrastructure"@en ;
    rdfs:subClassOf ns8:ont00000870 ;
    skos:definition "An Infrastructure System that is designed to facilitate the movement of material entities from one location to another by providing the necessary structures for Persons to travel or for Vehicles to transport material entities."@en .

ns8:ont00000329
    ns8:ont00001760 "https://www.commoncoreontologies.org/TimeOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:comment "This is a defined class."@en ;
    rdfs:label "Multi-Month Temporal Interval"@en ;
    rdfs:subClassOf _:nimportcommonb253, ns1:BFO_0000038 ;
    skos:definition "A one-dimensional temporal region that is measured in Months and spans at least one Month."@en .

ns8:ont00000330
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Thermal_power_station&oldid=1062208548"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Thermal Power Plant"@en ;
    rdfs:subClassOf ns8:ont00001076 ;
    skos:definition "An Electric Power Station that is designed to convert heat energy into electrical energy."@en .

ns8:ont00000331
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=House&oldid=1062818553"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "House"@en ;
    rdfs:subClassOf ns8:ont00000410 ;
    skos:definition "A Residential Facility that is designed to provide a self-standing, permanent residence for an individual, family, household, multiple families, or similar-sized group."@en .

ns8:ont00000332
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Training_camp&oldid=1059977631"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Training Camp"@en ;
    rdfs:subClassOf ns8:ont00000192 ;
    skos:definition "A Facility that is designed for rigorous and focused training in order to learn or improve skills, usually involving physical actions."@en .

ns8:ont00000333
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Gas_turbine&oldid=1062398125"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Gas Turbine"@en ;
    rdfs:subClassOf ns8:ont00000394 ;
    skos:altLabel "Combustion Turbine"@en ;
    skos:definition "An Internal Combustion Engine that has a rotating compressor and a turbine and is designed to operate utilizing continous Combustion to produce Thrust, either directly via exhaust or indirectly via a prop."@en .

ns8:ont00000334
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Interphone"@en ;
    rdfs:subClassOf ns8:ont00000303 ;
    skos:definition "An Intercommunication System that that is designed to facilitate some Act of Communication between agents by means of audio messages."@en .

ns8:ont00000335
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Stasis of Generically Dependent Continuant"@en ;
    rdfs:subClassOf ns8:ont00000819 ;
    skos:definition "A Stasis in which some Independent Continuant bears some Generically Dependent Continuant that remains unchanged during a Temporal Interval."@en .

ns8:ont00000336
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Apartment&oldid=1064019048"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Apartment Building"@en ;
    rdfs:subClassOf ns8:ont00000410 ;
    skos:definition "A Residential Facility that is designed to contain multiple permanent residences comprised of a suite of rooms."@en .

ns8:ont00000337
    ns8:ont00001753 "RPG" ;
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Rocket-propelled_grenade&oldid=1063641548"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Rocket-Propelled Grenade"@en ;
    rdfs:subClassOf ns8:ont00001029 ;
    skos:definition "An Unguided Rocket that is designed to contain an explosive warhead, be fired from a Shoulder-Fired Rocket Launcher, and be used against Tanks."@en .

ns8:ont00000338
    ns8:ont00001754 "https://en.wikipedia.org/wiki/Fan_(machine)" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Fan"@en ;
    rdfs:subClassOf ns8:ont00000256 ;
    skos:definition "A Fluid Control Artifact that consists of a rotating arrangement of vanes or blades that are designed to act on a portion of fluid to create flow within it."@en .

ns8:ont00000339
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Agriculture&oldid=1063222666"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Agricultural Facility"@en ;
    rdfs:subClassOf ns8:ont00000192 ;
    skos:definition "A Facility that is designed as a building or campus for agricultural processes with the aim of cultivating animals, plants, or fungi for food, fiber, biofuel, medicinal plants, or other products to sustain and enhance human life."@en .

ns8:ont00000340
    ns8:ont00001754 "https://en.wikipedia.org/wiki/Mortar_(weapon)" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Mortar"@en ;
    rdfs:subClassOf ns8:ont00000268 ;
    skos:definition "A Cannon that is designed to fire projectiles at relatively low velocities over relatively short ranges."@en .

ns8:ont00000341
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Prosthesis&oldid=1063749698"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Prosthetic Arm"@en ;
    rdfs:subClassOf ns8:ont00000715 ;
    skos:definition "A Prosthesis that is designed to replace a missing arm."@en .

ns8:ont00000342
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Brake&oldid=1047693009"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Brake"@en ;
    rdfs:subClassOf ns8:ont00000995 ;
    skos:definition "A Material Artifact that is designed to inhibit the Vehicle's Motion by absorbing energy from a moving system."@en .

ns8:ont00000343
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Reciprocating_engine&oldid=1057783145"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Reciprocating Steam Engine"@en ;
    rdfs:subClassOf ns8:ont00000634 ;
    skos:definition "A Steam Engine that is designed to use one or more reciprocating pistons to convert pressure into a rotating motion."@en .

ns8:ont00000344
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Surfactant&oldid=1063693411"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Surfactant Artifact Function"@en ;
    rdfs:subClassOf ns8:ont00001281 ;
    skos:definition "An Emulsifier Artifact Function that is realized in a process that lowers the surface tension between two liquids or between a liquid and a solid."@en .

ns8:ont00000345
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Act of Measuring"@en ;
    rdfs:subClassOf ns8:ont00000228 ;
    skos:definition "A Planned Act that involves determining the extent, dimensions, quanity, or quality of an Entity relative to some standard."@en ;
    skos:example "putting an object on a scale to measure its weight in kilograms", "rating Hollywood movies on a 1 to 5 star scale", "using a tape measure to determine the height and width of a doorway in inches" .

ns8:ont00000346
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Communication Instrument"@en ;
    rdfs:subClassOf ns8:ont00000995 ;
    skos:definition "A Material Artifact that is designed to facilitate communication between at least two entities."@en .

ns8:ont00000347
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Electronic Bond"@en ;
    rdfs:subClassOf ns8:ont00001159 ;
    skos:definition "A Bond that consists of Bytes."@en .

ns8:ont00000348
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    owl:equivalentClass _:nimportcommonb254 ;
    rdf:type owl:Class ;
    rdfs:label "Filter"@en ;
    rdfs:subClassOf ns8:ont00000995 ;
    skos:definition "A Material Artifact that bears a Filter Function."@en .

ns8:ont00000349
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Police_station&oldid=1056208781"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Police Station"@en ;
    rdfs:subClassOf ns8:ont00000479 ;
    skos:definition "A Public Safety Facility that is designed for the professional and clerical processes of a local police force."@en .

ns8:ont00000350
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Cooling System"@en ;
    rdfs:subClassOf ns8:ont00000453 ;
    skos:definition "An Environment Control System that is designed to cool the air or objects in a Site."@en .

ns8:ont00000351
    ns8:ont00001754 "http://wordnetweb.princeton.edu/perl/webwn?s=commanding (Edited 08-22-2016)" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Act of Commanding"@en ;
    rdfs:subClassOf ns8:ont00000133 ;
    skos:definition "An Act of Directive Communication that exercises authoritative control or power over another agent's actions."@en .

ns8:ont00000352
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Satellite Artifact"@en ;
    rdfs:subClassOf ns8:ont00001139 ;
    skos:definition "A Spacecraft that is designed to Orbit a Space Object (typically Earth)."@en .

ns8:ont00000353
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Research Artifact Function"@en ;
    rdfs:subClassOf ns8:ont00000323 ;
    skos:definition "An Artifact Function that is realized during events in which an Artifact is used to perform research on a specified entity or class of entities."@en .

ns8:ont00000354
    ns8:ont00001754 "http://www.merriam-webster.com/dictionary/testify" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Act of Testifying"@en ;
    rdfs:subClassOf ns8:ont00000379 ;
    skos:definition "An Act of Representative Communication performed by stating one's personal knowledge or belief."@en .

ns8:ont00000355
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Refracting_telescope&oldid=1059975066"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Refracting Optical Telescope"@en ;
    rdfs:subClassOf ns8:ont00001009 ;
    skos:altLabel "Refracting Telescope"@en, "Refractor"@en ;
    skos:definition "An Optical Telescope that is designed to aid in the observation of spatially distant Objects by means of collecting and focusing visible light via refraction through the use of one or more Lenses to form an enhanced image of the Object."@en .

ns8:ont00000356
    ns8:ont00001754 "JC3IEDM-MIRD-DMWG-Edition_3.0.2_20090514" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Act of Publishing Mass Media Article"@en ;
    rdfs:subClassOf ns8:ont00000588 ;
    skos:definition "An Act of Mass Media Communication involving the preparation and public issuance of a non-fictional essay, especially one included with others in a newspaper, magazine, journal, etc."@en .

ns8:ont00000357
    ns8:ont00001754 "http://www.merriam-webster.com/dictionary/motion" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Act of Motion"@en ;
    rdfs:subClassOf ns8:ont00000228 ;
    skos:definition "A Planned Act by which an Agent causes the position or location of some Object to change."@en .

ns8:ont00000358
    ns8:ont00001760 "https://www.commoncoreontologies.org/GeospatialOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Geospatial Region Bounding Box"@en ;
    rdfs:subClassOf ns8:ont00001130 ;
    skos:definition "A Geospatial Polygon that has some Geospatial Region as a non-tangential proper part."@en .

ns8:ont00000359
    ns8:ont00001753 "JD" ;
    ns8:ont00001754 "https://www.defit.org/julian-date/" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/TimeOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Julian Date"@en ;
    rdfs:subClassOf _:nimportcommonb258, ns8:ont00000223 ;
    skos:definition "A Time of Day as specified according to the Julian Calendar using the Julian Date epoch."@en .

ns8:ont00000360
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Wounded Stasis"@en ;
    rdfs:subClassOf ns8:ont00001289 ;
    skos:altLabel "Wounded"@en ;
    skos:definition "A Damaged Stasis in which a Person or other organism is the bearer of a Quality or Realizable Entity that has suffered impairment (i.e., a decrease or loss) due to an injuring event."@en .

ns8:ont00000361
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Increase of Function"@en ;
    rdfs:subClassOf ns8:ont00001356 ;
    skos:definition "An Increase of Disposition in which some Independent Continuant has an increase of some Function that it bears."@en .

ns8:ont00000362
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Rocket_engine&oldid=1063879464"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:comment "Most rocket engines are also Internal Combustion Engines, however non-combusting forms also exist. For example, an untied balloon full of air that is released and allowed to zoom around the room may be both a Rocket Engine and a Physically Powered Engine."@en ;
    rdfs:label "Rocket Engine"@en ;
    rdfs:subClassOf ns8:ont00000533 ;
    skos:altLabel "Thruster"@en ;
    skos:definition "A Jet Engine that is designed to use only stored Rocket Propellant to form a high speed propulsive jet in order to generate Thrust."@en .

ns8:ont00000363
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Wireless_network&oldid=1060257041"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Wireless Telecommunication Network"@en ;
    rdfs:subClassOf ns8:ont00000998 ;
    skos:altLabel "Wireless Network"@en ;
    skos:definition "A Telecommunication Network that uses wireless connections to connect Telecommunication Network Nodes."@en .

ns8:ont00000364
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Pneumatic Motor"@en ;
    rdfs:subClassOf ns8:ont00001221 ;
    skos:altLabel "Air Motor"@en, "Compressed Air Engine"@en ;
    skos:definition "A Physically Powered Engine that converts potential energy stored in a portion of compressed air into mechanical energy."@en .

ns8:ont00000365
    ns8:ont00001760 "https://www.commoncoreontologies.org/GeospatialOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "x-Axis"@en ;
    rdfs:subClassOf ns8:ont00000161 ;
    skos:definition "A Coordinate System Axis designated by the variable 'x'."@en .

ns8:ont00000366
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Act of Information Processing"@en ;
    rdfs:subClassOf ns8:ont00000228 ;
    skos:definition "A Planned Act in which one or more input Information Content Entities are received, manipulated, transferred, or stored by an Agent."@en .

ns8:ont00000367
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Act of Military Training Instruction"@en ;
    rdfs:subClassOf ns8:ont00001075 ;
    skos:definition "An Act of Training Instruction performed by an Agent who realizes a capacity derived from the Agent's affiliation with some Military Organization by imparting knowledge of the tactics, techniques, and/or strategies of Military Operations to an Agent either directly or indirectly through some communication medium."@en .

ns8:ont00000368
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Rotation&oldid=1055998344"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Rotational Motion"@en ;
    rdfs:subClassOf _:nimportcommonb259, ns8:ont00001133 ;
    skos:altLabel "Rotation"@en ;
    skos:definition "A Motion Process in which an Object moves in a Circular or Elliptical Path around an Axis of Rotation."@en .

ns8:ont00000369
    ns8:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Priority Measurement Information Content Entity"@en ;
    rdfs:subClassOf ns8:ont00001010 ;
    skos:altLabel "Criticality Measurement"@en, "Importance Measurement"@en, "Priority Measurement"@en ;
    skos:definition "An Ordinal Measurement Information Content Entity that is a measurement of the relative importance of an entity."@en ;
    skos:example "low, normal, high, urgent, or immediate priority" .

ns8:ont00000370
    ns8:ont00001754 "http://www.thefreedictionary.com/condoling" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Act of Condoling"@en ;
    rdfs:subClassOf ns8:ont00000123 ;
    skos:definition "An Act of Expressive Communication performed by expressing sympathy or sorrow."@en .

ns8:ont00000371
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:comment "An Act of Prediction may involve the use of some or no relevant information. An Act of Prediction that utilizes relevant information may also be (or at least involve) an Act of Estimation. Hence, these two classes are not disjoint. Furthermore, neither class subsumes the other since estimates can be made about existing entities and not all predictions produce measurements (e.g. predicting that it will rain tomorrow)."@en ;
    rdfs:label "Act of Prediction"@en ;
    rdfs:subClassOf ns8:ont00000228 ;
    skos:definition "A Planned Act that involves the generation of a Predictive Information Content entity that is intended to describe an uncertain possible future event, value, entity, or attribute of an entity."@en ;
    skos:example "a chess master predicting the next 8 moves his opponent will make", "predicting that a particular stock will double in value over the next fiscal quarter", "using sample exit polls data to predict the winners of an election" ;
    skos:scopeNote "Predictions can only be made about things that are not yet the case (i.e. future things) and are further restricted to being about things that do not have a probability of either 1 (necessary) or 0 (impossible). For example, assuming that no organism is immortal, one cannot predict of a given organism that it will eventually die; however, one may predict uncertain things about the organism's eventual death, such as its precise cause or time."@en .

ns8:ont00000372
    ns8:ont00001754 "http://www.skybrary.aero/index.php/Transformer_Rectifier_Unit_(TRU)" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Power Transformer Rectifier Unit"@en ;
    rdfs:subClassOf ns8:ont00000995 ;
    skos:altLabel "TRU"@en ;
    skos:definition "A Material Artifact that is designed to perform the functions of both a Rectifier and a Transformer."@en .

ns8:ont00000373
    ns8:ont00001760 "https://www.commoncoreontologies.org/GeospatialOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Geospatial Position"@en ;
    rdfs:subClassOf ns1:BFO_0000147 ;
    skos:definition "A Fiat Point that is at or near the surface of the Earth and fixed according to some Geospatial Coordinate Reference System."@en .

ns8:ont00000374
    ns8:ont00001760 "https://www.commoncoreontologies.org/UnitsOfMeasureOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Measurement Unit of Volumetric Flow Rate"@en ;
    rdfs:subClassOf ns8:ont00000061 ;
    skos:definition "A Measurement Unit of Flow that is used as a standard for measurement of the rate at which volumes of fluid pass per unit time."@en ;
    skos:example "cubic metres per second, standard cubic centimeters per minute, cubic feet per second, gallons per minute" .

ns8:ont00000375
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Warehouse&oldid=1063721454"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Warehouse"@en ;
    rdfs:subClassOf ns8:ont00000881 ;
    skos:definition "A Storage Facility that is designed to store commercial goods."@en .

ns8:ont00000376
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Portion of Gallium Arsenide"@en ;
    rdfs:subClassOf ns8:ont00000457 ;
    skos:altLabel "Portion of GaAs"@en ;
    skos:definition "A Portion of Material that is composed of a compound of the elements gallium and arsenic."@en .

ns8:ont00000377
    ns8:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Disability"@en ;
    rdfs:subClassOf ns1:BFO_0000019 ;
    skos:definition "A Quality inhering in an Agent by virtue a physical or mental condition that limits the Agent's movements, senses, or activities."@en .

ns8:ont00000378
    ns8:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Color"@en ;
    rdfs:subClassOf ns8:ont00000784 ;
    skos:definition "An Optical Property that inheres in a bearer in virtue of that bearer's Color Hue, Color Saturation and Color Brightness."@en .

ns8:ont00000379
    ns8:ont00001754 "Derived (loosely) from: John Searle's Speech Acts: An Essay in the Philosophy of Language" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:comment "Examples: affirming, alleging, announcing, answering, attributing, claiming, classifying, concurring, confirming, conjecturing, denying, disagreeing, disclosing, disputing, identifying, informing, insisting, predicting, ranking, reporting, stating, stipulating"@en ;
    rdfs:label "Act of Representative Communication"@en ;
    rdfs:subClassOf ns8:ont00000402 ;
    skos:definition "An Act of Communication that commits a speaker to the truth of the expressed proposition."@en .

ns8:ont00000380
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Pressure"@en ;
    rdfs:subClassOf ns8:ont00000570 ;
    skos:definition "A Force that is applied perpendicular to the surface of an Object per unit area over which that Force is distributed."@en .

ns8:ont00000381
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Arms_industry&oldid=1063811497"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Weapon Manufacturing Facility"@en ;
    rdfs:subClassOf ns8:ont00000782 ;
    skos:definition "A Factory that is designed to produce or assemble weapons."@en .

ns8:ont00000382
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Spreadsheet&oldid=1064060503"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Spreadsheet"@en ;
    rdfs:subClassOf ns8:ont00000798 ;
    skos:definition "An Information Bearing Artifact that is designed to bear some Information Content Entity in an interactive, tabular form."@en .

ns8:ont00000383
    ns8:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Nuclear Family"@en ;
    rdfs:subClassOf ns8:ont00000837 ;
    skos:definition "A Family composed of parents and their children."@en .

ns8:ont00000384
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Rectilinear Motion"@en ;
    rdfs:subClassOf ns8:ont00000789 ;
    skos:altLabel "Linear Motion"@en ;
    skos:definition "A Translational Motion process in which an Object moves along a straight path."@en .

ns8:ont00000385
    ns8:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Wide"@en ;
    rdfs:subClassOf ns8:ont00001059 ;
    skos:altLabel "Broad"@en, "Fat"@en ;
    skos:definition "A Shape Quality inhering in a bearer in virtue of the bearer having a width or depth which is significantly larger in proportion to its length or height."@en .

ns8:ont00000386
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Webcast&oldid=1062685084"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:comment "Essentially, webcasting is “broadcasting” over the Internet."@en ;
    rdfs:label "Webcast"@en ;
    rdfs:subClassOf ns8:ont00000517 ;
    skos:altLabel "Act of Webcasting"@en ;
    skos:definition "An Act of Communciation by Media transmitted to an audience over the Internet using streaming media technology to distribute a single content source that may be distributed live or on demand."@en .

ns8:ont00000387
    ns8:ont00001760 "https://www.commoncoreontologies.org/GeospatialOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Axis of Rotation"@en ;
    rdfs:subClassOf ns1:BFO_0000026 ;
    skos:altLabel "Rotational Axis"@en ;
    skos:definition "A One-Dimensional Spatial Region defined by the line around which a spinning body rotates."@en .

ns8:ont00000388
    ns8:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI ;
    owl:equivalentClass _:nimportcommonb260 ;
    rdf:type owl:Class ;
    rdfs:label "Citizen"@en ;
    rdfs:subClassOf ns8:ont00001262 ;
    skos:definition "A Person who is the bearer of some Citizen Role."@en .

ns8:ont00000389
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Act of Buying"@en ;
    rdfs:subClassOf ns8:ont00001334 ;
    skos:definition "An Act of Purchasing wherein a Financial Instrument is used by an Agent (the Buyer) to acquire ownership of a good from another Agent (the Seller)."@en .

ns8:ont00000390
    ns8:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI ;
    owl:equivalentClass _:nimportcommonb264 ;
    rdf:type owl:Class ;
    rdfs:label "Spatial Region Identifier"@en ;
    rdfs:subClassOf ns8:ont00000686 ;
    skos:definition "A Designative Information Content Entity that designates some Spatial Region."@en .

ns8:ont00000391
    ns8:ont00001753 "THF" ;
    ns8:ont00001754 "International Telecommunication Union (ITU)" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:comment "The corresponding Wavelength range is 1–0.1 mm"@en ;
    rdfs:label "Tremendously High Frequency"@en ;
    rdfs:subClassOf ns8:ont00000754 ;
    skos:altLabel "ITU Band Number 12"@en, "Submillimeter Band Frequency"@en, "Terahertz Radiation Frequency"@en ;
    skos:definition "An Electromagnetic Radiation Frequency of some Electromagnetic Wave that is between 300 GHz and 3 THz."@en .

ns8:ont00000392
    ns8:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Allegiance Role"@en ;
    rdfs:subClassOf ns1:BFO_0000023 ;
    skos:definition "A Role that inheres in an Agent by virtue of the support it has committed to provide to another Agent when that Agent is involved in a conflict."@en .

ns8:ont00000393
    ns8:ont00001760 "https://www.commoncoreontologies.org/GeospatialOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Yaw Axis"@en ;
    rdfs:subClassOf ns8:ont00000387 ;
    skos:altLabel "Vertical Axis"@en ;
    skos:definition "An Axis of Rotation that passes through the center of an object's Mass from the top to the bottom and is perpendicular to the direction of the object's motion. For objects in Orbit, the Yaw Axis passes through the Barycenter of its Orbit."@en .

ns8:ont00000394
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Internal_combustion_engine&oldid=1063281505"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Internal Combustion Engine"@en ;
    rdfs:subClassOf ns8:ont00000746 ;
    skos:definition "A Combustion Engine that is designed to have an internal Combustion Chamber where portions of Fuel and Oxidizer mixture are burned to generate thermal energy that is then converted into mechanical energy."@en .

ns8:ont00000395
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Gain of Specifically Dependent Continuant"@en ;
    rdfs:subClassOf _:nimportcommonb268, ns8:ont00000554 ;
    skos:definition "A Gain of Dependent Continuant in which some Independent Continuant becomes the bearer of some Specifically Dependent Continuant."@en ;
    skos:example "A Person becomes pregnant (gain of quality), A person becomes forgetful (gain of disposition), A vehicle becomes amphibious (gain of function), A Person becomes a Database Administrator (gain of role)." .

ns8:ont00000396
    ns8:ont00001753 "ELF" ;
    ns8:ont00001754 "International Telecommunication Union (ITU)" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:comment "The corresponding Wavelength range is 100,000–10,000 km"@en ;
    rdfs:label "Extremely Low Frequency"@en ;
    rdfs:subClassOf ns8:ont00000150 ;
    skos:altLabel "ITU Band Number 1"@en ;
    skos:definition "A Radio Frequency that is between 3 and 30 Hz."@en .

ns8:ont00000397
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Combustion Chamber"@en ;
    rdfs:subClassOf ns8:ont00000995 ;
    skos:altLabel "Burner"@en, "Combustor"@en, "Flame Holder"@en ;
    skos:definition "A Material Artifact that is designed to wholly or partially bound an internal Site where a Combustion process is intended to occur."@en .

ns8:ont00000398
    ns8:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Reference System"@en ;
    rdfs:subClassOf ns8:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes a set of standards for organizing and understanding data of the specified type or domain."@en .

ns8:ont00000399
    ns8:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI ;
    owl:equivalentClass _:nimportcommonb273 ;
    rdf:type owl:Class ;
    rdfs:label "Temporal Region Identifier"@en ;
    rdfs:subClassOf ns8:ont00000686 ;
    skos:definition "A Designative Information Content Entity that designates some Temporal Region."@en .

ns8:ont00000400
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Park&oldid=1061073992"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/GeospatialOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Park"@en ;
    rdfs:subClassOf ns8:ont00001197 ;
    skos:definition "An Anthropogenic Feature that is a bounded area of land, or water, usually in its natural or semi-natural (landscaped) state and set aside for some purpose, usually to do with recreation or conservation."@en .

ns8:ont00000401
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Fundamental Frequency"@en ;
    rdfs:subClassOf ns8:ont00000008 ;
    skos:definition "A Sound Frequency that is the lowest Frequency of a Sound Wave."@en .

ns8:ont00000402
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Communication&oldid=1063752020"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Act of Communication"@en ;
    rdfs:subClassOf ns8:ont00000228 ;
    skos:definition "A Planned Act in which some Information Content Entity is transferred from some Agent to Another."@en .

ns8:ont00000403
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Diffraction Artifact Function"@en ;
    rdfs:subClassOf ns8:ont00000323 ;
    skos:definition "An Artifact Function that is realized by an Artifact participating in a diffraction event in which the Artifact forces a wave to bend around the corners of an obstacle or aperture into the region of geometrical shadow of the obstacle."@en .

ns8:ont00000404
    ns8:ont00001754 "http://www.thefreedictionary.com/iris" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Iris"@en ;
    rdfs:subClassOf _:nimportcommonb277, ns8:ont00000084 ;
    skos:definition "A Bodily Component that consists of the part of an Eye that is a pigmented, round, contractile membrane, suspended between the cornea and lens and perforated by the pupil, and which canonically regulates the amount of light entering the Eye."@en .

ns8:ont00000405
    ns8:ont00001754 "http://www.geonames.org/export/codes.html" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Second-Order Administrative Region"@en ;
    rdfs:subClassOf _:nimportcommonb278, ns8:ont00001152 ;
    skos:definition "A Government Domain that is a subdivision of a First-Order Administrative Region."@en .

ns8:ont00000406
    ns8:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Measurement Unit of Geocoordinate"@en ;
    rdfs:subClassOf ns8:ont00000120 ;
    skos:definition "A Measurement Unit specifying the geospatial coordinates of a location."@en .

ns8:ont00000407
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Electrical_resistivity_and_conductivity&oldid=1063749049"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Electrical Resistance Artifact Function"@en ;
    rdfs:subClassOf ns8:ont00000098 ;
    skos:definition "An Electrical Artifact Function that is realized in processes in which an Artifact opposes the flow of an electric current."@en .

ns8:ont00000408
    ns8:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Government Organization"@en ;
    rdfs:subClassOf _:nimportcommonb279, ns8:ont00001180 ;
    skos:definition "An Organization that is part of a Government and is responsible for the oversight or administration of specific governmental functions."@en .

ns8:ont00000409
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Spark Ignition System"@en ;
    rdfs:subClassOf ns8:ont00000742 ;
    skos:definition "An Ignition System that is designed to produce a spark in order to initiate an Ignition process."@en .

ns8:ont00000410
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Residence&oldid=1019728937"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Residential Facility"@en ;
    rdfs:subClassOf ns8:ont00000192 ;
    skos:definition "A Facility that is designed to house one or more Persons."@en .

ns8:ont00000411
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Speed Measurement Artifact Function"@en ;
    rdfs:subClassOf ns8:ont00001100 ;
    skos:definition "A Measurement Artifact Function that is realized during events in which an Artifact is used to measure the Speed of a specified object's or class of objects' Motion."@en .

ns8:ont00000412
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Redox&oldid=1063866348"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Oxidizer Artifact Function"@en ;
    rdfs:subClassOf ns8:ont00000791 ;
    skos:definition "A Chemical Reaction Artifact Function that is realized in a process in which electrons are removed from a reactant in a redox reaction."@en .

ns8:ont00000413
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Electron_microscope&oldid=1060512240"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Electron Microscope"@en ;
    rdfs:subClassOf ns8:ont00000304 ;
    skos:definition "A Microscope that is designed to use a beam of accelerated electrons to illuminate the target and produce a significantly enlarged image of the Object."@en .

ns8:ont00000414
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Square Waveform"@en ;
    rdfs:subClassOf ns8:ont00001286 ;
    skos:definition "A Waveform that is characterized by a square shape due to the near-instantaneous transitions between minimum and maximum Amplitudes of the Wave Cycle."@en .

ns8:ont00000415
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Antimicrobial&oldid=1064100151"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Anti-Microbial Artifact Function"@en ;
    rdfs:subClassOf ns8:ont00000828 ;
    skos:definition "A Pesticide Artifact Function that is realized in a process which causes illness in, or the death of, a microorganism."@en .

ns8:ont00000416
    ns8:ont00001754 "JC3IEDM-MIRD-DMWG-Edition_3.0.2_20090514" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Act of Publishing Mass Media Press Release"@en ;
    rdfs:subClassOf ns8:ont00000588 ;
    skos:definition "An Act of Mass Media Communication involving the preparation and public issuance of an official statement issued to one or more members of the media for the purpose of announcing newsworthy information."@en .

ns8:ont00000417
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Prosthesis&oldid=1063749698"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Prosthetic Hand"@en ;
    rdfs:subClassOf ns8:ont00000715 ;
    skos:definition "A Prosthesis that is designed to replace a missing hand."@en .

ns8:ont00000418
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Biographical Life"@en ;
    rdfs:subClassOf ns8:ont00000005 ;
    skos:definition "An Act composed of the Life Events that occur during the course of existence of an Agent (i.e. Person or Organization)."@en .

ns8:ont00000419
    ns8:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Part Number"@en ;
    rdfs:subClassOf ns8:ont00000077 ;
    skos:definition "A Code Identifier that designates a type of part whose instances are designed to be part of some Artifact."@en .

ns8:ont00000420
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Computer&oldid=1061553332"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Computer"@en ;
    rdfs:subClassOf ns8:ont00000117 ;
    skos:definition "An Information Processing Artifact that is designed to execute an arbitrary set of arithmetic or logical operations automatically."@en .

ns8:ont00000421
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Nuclear_power_plant&oldid=1062752651"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Nuclear Power Plant"@en ;
    rdfs:subClassOf ns8:ont00000330 ;
    skos:definition "A Thermal Power Plant that is designed to produce heat by means of a nuclear reactor, which is then converted to electrical energy."@en .

ns8:ont00000422
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Communication Reception Artifact Function"@en ;
    rdfs:subClassOf ns8:ont00000323 ;
    skos:definition "An Artifact Function that is realized during events in which an Artifact is used to receive information that has been transmitted for the purpose of communiction."@en .

ns8:ont00000423
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Automotive_industry&oldid=1061661751"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Motor Vehicle Manufacturing Facility"@en ;
    rdfs:subClassOf ns8:ont00000782 ;
    skos:definition "A Factory that is designed to manufacture automobiles."@en .

ns8:ont00000424
    ns8:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Sharp"@en ;
    rdfs:subClassOf ns8:ont00001059 ;
    skos:definition "A Shape Quality inhering in a bearer in virtue of the bearer having a fine point or thin edge."@en .

ns8:ont00000425
    ns8:ont00001760 "https://www.commoncoreontologies.org/TimeOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:comment "A Gregorian Year begins concurrently with January 1, ends concurrently with December 31, and has an average duration of exactly 365.2425 Gregorian Days. The Gregorian Year is based upon the vernal equinox year. Unless otherwise stated, instances of Calendar Year are assumed to be instances of Gregorian Year since the Gregorian Calendar is the most widely used civil Calendar System."@en ;
    rdfs:label "Gregorian Year"@en ;
    rdfs:subClassOf ns8:ont00000674 ;
    skos:definition "A Calendar Year in the Gregorian Calendar."@en .

ns8:ont00000426
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Military&oldid=1063431234"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Military Personnel Force"@en ;
    rdfs:subClassOf ns8:ont00000274 ;
    skos:definition "An Armed Force authorized to use deadly force, and weapons, to support the interests of the Government and some or all of its Citizens."@en .

ns8:ont00000427
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Armoured_fighting_vehicle&oldid=1063212018"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Armored Fighting Vehicle"@en ;
    rdfs:subClassOf ns8:ont00000053 ;
    skos:definition "A Ground Motor Vehicle that is designed to be armored and used to transport and support military personal in combat missions."@en .

ns8:ont00000428
    ns8:ont00001754 "https://en.wikipedia.org/wiki/Junction_(rail)" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Railway Junction"@en ;
    rdfs:subClassOf ns8:ont00001326 ;
    skos:definition "A Land Transportation Artifact that is designed to enable a Train to switch between the tracks of two routes."@en .

ns8:ont00000429
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Codabar Barcode"@en ;
    rdfs:subClassOf ns8:ont00000258 ;
    skos:definition "A One-Dimensional Barcode that consists of numbers 0-9 and the characters -$:/.+ and is used by logistics and healthcare professionals."@en .

ns8:ont00000430
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Stable Orientation"@en ;
    rdfs:subClassOf ns8:ont00000850 ;
    skos:definition "A Stasis of Quality that holds during a Temporal Interval when an object maintains the same Spatial Orientation."@en .

ns8:ont00000431
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=External_combustion_engine&oldid=1063941809"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "External Combustion Engine"@en ;
    rdfs:subClassOf ns8:ont00000746 ;
    skos:definition "A Combustion Engine that is designed to have an external Combustion Chamber where portions of Fuel and Oxidizer mixture are burned to generate thermal energy to heat the working fluid, which transfers energy to the Engine where it is converted into mechanical energy."@en .

ns8:ont00000432
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Missile_launch_facility&oldid=1062709375"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Missile Launch Site"@en ;
    rdfs:subClassOf ns8:ont00001052 ;
    skos:definition "A Military Facility that is designed for storing and launching missiles."@en .

ns8:ont00000433
    ns8:ont00001754 "http://en.wiktionary.org/wiki/associate" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Act of Association"@en ;
    rdfs:subClassOf ns8:ont00001327 ;
    skos:definition "A Social Act wherein an Agent unites with some other Agent in a Planned Act, enterprise or business."@en .

ns8:ont00000434
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Simple Optical Lens"@en ;
    rdfs:subClassOf ns8:ont00001207 ;
    skos:definition "An Optical Lens consisting of a single piece of transparent material."@en .

ns8:ont00000435
    ns8:ont00001760 "https://www.commoncoreontologies.org/TimeOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:comment "A Gregorian Day is twenty-four Hours in duration."@en ;
    rdfs:label "Gregorian Day"@en ;
    rdfs:subClassOf ns8:ont00000921 ;
    skos:definition "A Calendar Day in the Gregorian Calendar."@en .

ns8:ont00000436
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=X-ray_microscope&oldid=1046169107"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "X-ray Microscope"@en ;
    rdfs:subClassOf ns8:ont00000304 ;
    skos:definition "A Microscope that is designed to use Electromagnetic Radiation in the soft X-ray band to produce a significantly enlarged image of the Object."@en .

ns8:ont00000437
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Enhancement&oldid=1003326590"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Enhancing Artifact Function"@en ;
    rdfs:subClassOf ns8:ont00000323 ;
    skos:definition "An Artifact Function that is realized in processes of intensifying, increainsg, or further improving the quality, value, or extent of some entity."@en .

ns8:ont00000438
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Act of Official Documentation"@en ;
    rdfs:subClassOf ns8:ont00001374 ;
    skos:definition "An Act of Declarative Communication in which an Agent records some information for official use by another Agent."@en .

ns8:ont00000439
    ns8:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Black"@en ;
    rdfs:subClassOf ns8:ont00000378 ;
    skos:definition "A Color that lacks any hues as parts."@en .

ns8:ont00000440
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Watercraft&oldid=1054071067"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Watercraft"@en ;
    rdfs:subClassOf ns8:ont00000713 ;
    skos:definition "A Vehicle that is designed to convey passengers, cargo, or equipment from one location to another by water travel."@en .

ns8:ont00000441
    ns8:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Temperature"@en ;
    rdfs:subClassOf ns1:BFO_0000019 ;
    skos:definition "A Quality that inheres in a bearer in virtue of its thermal energy."@en .

ns8:ont00000442
    ns8:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Radioactive"@en ;
    rdfs:subClassOf ns1:BFO_0000019 ;
    skos:definition "A Quality that inheres in a bearer in virtue of that bearer exhibiting or being caused by radioactivity."@en .

ns8:ont00000443
    ns8:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI ;
    owl:equivalentClass _:nimportcommonb280 ;
    rdf:type owl:Class ;
    rdfs:label "Commercial Organization"@en ;
    rdfs:subClassOf ns8:ont00001180 ;
    skos:definition "An Organization that is the bearer of a Commercial Role and whose primary objective is to make a profit from the provision of goods or services."@en .

ns8:ont00000444
    ns8:ont00001760 "https://www.commoncoreontologies.org/UnitsOfMeasureOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Measurement Unit of Energy"@en ;
    rdfs:subClassOf ns8:ont00000120 ;
    skos:definition "A Measurement Unit that is used as a standard for measurement of the Amount of work that is available in an object."@en ;
    skos:example "ft-lbs, calorie, horsepower, kilowatt" .

ns8:ont00000445
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Weapon&oldid=1143263715"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Weapon"@en ;
    rdfs:subClassOf ns8:ont00000995 ;
    skos:definition "A Material Artifact that is designed to destroy or inflict damage to structures or systems, or to kill or wound living things by creating specific lethal or nonlethal effects."@en ;
    skos:scopeNote "Nonlethal effects include all outcomes short of death or destruction. This is captured by the fact that Damaged Stasis and Wounded Stasis are defined in terms of impairment of the Independent Continuant that participates in them."@en .

ns8:ont00000446
    ns8:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Circumference"@en ;
    rdfs:subClassOf ns8:ont00001293 ;
    skos:definition "A Perimeter that inheres in a circle or ellipse."@en .

ns8:ont00000447
    ns8:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Triangular"@en ;
    rdfs:subClassOf ns8:ont00001059 ;
    skos:definition "A Shape Quality inhering in a bearer in virtue of it having exactly three angles and exactly three sides."@en .

ns8:ont00000448
    ns8:ont00001754 "https://en.wikipedia.org/wiki/Motion_(physics)" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Motion Artifact Function"@en ;
    rdfs:subClassOf ns8:ont00000323 ;
    skos:definition "An Artifact Function that is realized in a process in which an entity changes its position with respect to time."@en .

ns8:ont00000449
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Remuneration&oldid=1033306001"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:comment "Comment: Remuneration normally consists of salary or hourly wages, but also applies to commission, stock options, fringe benefits, etc."@en ;
    rdfs:label "Act of Remuneration"@en ;
    rdfs:subClassOf ns8:ont00001334 ;
    skos:definition "An Act of Purchasing wherein a Financial Instrument is used by an Agent (the Employer) to compensate another Agent (the Employee) for the services they perform for the Employer."@en .

ns8:ont00000450
    ns8:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Silver Color"@en ;
    rdfs:subClassOf ns8:ont00000378 ;
    skos:definition "A Color that resembles Grey with the added feature of having a metallic shine."@en .

ns8:ont00000451
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Collimation Artifact Function"@en ;
    rdfs:subClassOf ns8:ont00000323 ;
    skos:definition "An Artifact Function that is realized by an Artifact participating in a collimation event in which the Artifact narrows a beam of particles or waves by either causing the spatial cross-section of the beam to become smaller or by causing the directions of motion of the beam's constituents to be aligned in a specifc direction of Motion."@en .

ns8:ont00000452
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Timekeeping Artifact Function"@en ;
    rdfs:subClassOf ns8:ont00000323 ;
    skos:definition "An Artifact Function that is realized during events in which an Artifact is used to keep track of and report the current time."@en .

ns8:ont00000453
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:comment "Controlling air quality typically involves temperature control, oxygen replenishment, and removal of moisture, odor, smoke, heat, dust, airborne bacteria, carbon dioxide, and other undesired gases or particulates."@en ;
    rdfs:label "Environment Control System"@en ;
    rdfs:subClassOf ns8:ont00000995 ;
    skos:definition "A Material Artifact that is designed to control the temperature, air quality, or other feature of a Site that is relevant to the comfort or operation of entities located within that Site."@en .

ns8:ont00000454
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Compression Ignition System"@en ;
    rdfs:subClassOf ns8:ont00000742 ;
    skos:definition "An Ignition System that is designed to generate heat by compressing a portion of fuel and oxidizer mixture in order to initiate an Ignition process."@en .

ns8:ont00000455
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Ceremony&oldid=1064081855"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Act of Ceremony"@en ;
    rdfs:subClassOf ns8:ont00001327 ;
    skos:definition "A Social Act of ritual significance, performed on a special occasion."@en .

ns8:ont00000456
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Rail_transport&oldid=1063793805" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Railway"@en ;
    rdfs:subClassOf ns8:ont00001326 ;
    skos:definition "A Land Transportation Artifact that is designed to enable Trains to transport passengers and goods."@en .

ns8:ont00000457
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Portion of Material"@en ;
    rdfs:subClassOf ns8:ont00001084 ;
    skos:definition "A Portion of Processed Material that was produced to be used as the input for another Act of Artifact Processing."@en .

ns8:ont00000458
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Coupling&oldid=1055718683"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Coupling"@en ;
    rdfs:subClassOf ns8:ont00000995 ;
    skos:definition "A Material Artifact that is designed to connect two Shafts together at their ends for the purpose of transmitting power."@en .

ns8:ont00000459
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Fluorescence&oldid=1061358510"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Fluorescence"@en ;
    rdfs:subClassOf ns8:ont00001126 ;
    skos:definition "A Luminescent Property that inheres in a bearer in virtue of that bearer's capacity to emit visible light while absorbing shorter wavelength radiation, but not after."@en .

ns8:ont00000460
    ns8:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Local Administrative Region"@en ;
    rdfs:subClassOf ns8:ont00001152 ;
    skos:altLabel "Locality"@en ;
    skos:definition "A Government Domain that delimits a local Government."@en .

ns8:ont00000461
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "ISSN Barcode"@en ;
    rdfs:subClassOf ns8:ont00000966 ;
    skos:definition "An EAN Barcode that is used to designate periodicals."@en .

ns8:ont00000462
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:comment "This class should be used to demarcate the start of the temporal interval (through the BFO 'occupies temporal region' property) that the Entity bears the Function."@en ;
    rdfs:label "Gain of Function"@en ;
    rdfs:subClassOf _:nimportcommonb284, ns8:ont00000609 ;
    skos:definition "A Gain of Disposition in which some Independent Continuant becomes the bearer of some Function."@en .

ns8:ont00000463
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Act of Educational Training Instruction"@en ;
    rdfs:subClassOf ns8:ont00001075 ;
    skos:definition "An Act of Training Instruction performed by an Agent who realizes a capacity derived from the Agent's affiliation with some Educational Organization by imparting knowledge of a curriculum to an Agent either directly or indirectly through some communication medium."@en .

ns8:ont00000464
    ns8:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Oblong"@en ;
    rdfs:subClassOf ns8:ont00001059 ;
    skos:definition "A Shape Quality inhering in a bearer in virtue of the bearer having an long thin shape with approximately parallel sides."@en .

ns8:ont00000465
    ns8:ont00001753 "MJD" ;
    ns8:ont00001754 "http://aa.usno.navy.mil/data/docs/JulianDate.php" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/TimeOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:comment """A Day begins at midnight GMT within the Modified Julian Date reference system. The Modified Julian Date (MJD) is related to the Julian Date (JD) by the formula:
MJD = JD - 2400000.5"""@en ;
    rdfs:label "Modified Julian Date"@en ;
    rdfs:subClassOf ns8:ont00000223 ;
    skos:definition "A Time of Day as specified according to the Julian Calendar using the Modified Julian Date epoch."@en .

ns8:ont00000466
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Orientation Control Artifact Function"@en ;
    rdfs:subClassOf ns8:ont00000323 ;
    skos:definition "An Artifact Function that is realized by processes in which some Artifact is used to control the Orientation of some object."@en .

ns8:ont00000467
    ns8:ont00001753 "APC" ;
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Armoured_personnel_carrier&oldid=1061608326"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Armored Personnel Carrier"@en ;
    rdfs:subClassOf ns8:ont00000427 ;
    skos:definition "An Armored Fighting Vehicle that is designed to transport infantry to the battlefield but which are not usually designed to take part in a direct-fire battle."@en .

ns8:ont00000468
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Office&oldid=1063508719"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Office Building"@en ;
    rdfs:subClassOf ns8:ont00001102 ;
    skos:definition "A Commercial Facility that is designed as an environment for conducting commercial, professional, or bureaucratic work."@en .

ns8:ont00000469
    ns8:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Geospatial Coordinate Reference System"@en ;
    rdfs:subClassOf ns8:ont00000275 ;
    skos:altLabel "Geographic Coordinate System"@en ;
    skos:definition "A Spatial Reference System that is used to determine and identify the location of a point or object at or near the surface of the Earth."@en .

ns8:ont00000470
    ns8:ont00001754 "http://www.dictionary.com/browse/degree" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Academic Degree"@en ;
    rdfs:subClassOf ns8:ont00000189 ;
    skos:definition "A Certificate issued by an Educational Organization to a Person to indicate that the Person has satisfactorily completed a course of study, or as an honorary recognition of the Person's achievement."@en .

ns8:ont00000471
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Warning Message"@en ;
    rdfs:subClassOf ns8:ont00001046 ;
    skos:definition "A Notification Message that is designed to bear an Information Content Entity that describes a possible or impending threat."@en .

ns8:ont00000472
    ns8:ont00001760 "https://www.commoncoreontologies.org/GeospatialOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Geospatial Region"@en ;
    rdfs:subClassOf ns1:BFO_0000029 ;
    skos:definition "A Site that is at or near the surface of the Earth."@en .

ns8:ont00000473
    ns8:ont00001754 "http://www.geonames.org/export/codes.html" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Fourth-Order Administrative Region"@en ;
    rdfs:subClassOf _:nimportcommonb289, ns8:ont00001152 ;
    skos:definition "A Government Domain that is a subdivision of a Third-Order Administrative Region."@en .

ns8:ont00000474
    ns8:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Curved"@en ;
    rdfs:subClassOf ns8:ont00001059 ;
    skos:definition "A Shape Quality inhering in a bearer in virtue of the bearer having borders which are smoothly rounded."@en .

ns8:ont00000475
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Portion of Cash"@en ;
    rdfs:subClassOf ns8:ont00000537 ;
    skos:definition "A Financial Instrument that is designed to be a ready medium of exchange."@en .

ns8:ont00000476
    ns8:ont00001754 "http://en.wikipedia.org/wiki/Objective_(goal)" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Objective"@en ;
    rdfs:subClassOf ns8:ont00000965 ;
    skos:definition "A Directive Information Content Entity that prescribes some projected state that some Agent intends to achieve."@en .

ns8:ont00000477
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Fuel_cell&oldid=1063586731"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Fuel Cell"@en ;
    rdfs:subClassOf ns8:ont00001049 ;
    skos:definition "An Electrical Power Source that consists in part of an anode, a cathode, and an electrolyte; converts chemical energy from a fuel into electricity through a chemical reaction of positively charged hydrogen ions with an oxidizing agent (typically oxygen); and, if given a continuous source of fuel and oxidizing agent, can continuously produce electricity."@en ;
    skos:scopeNote "A Fuel Cell differs from a Battery in that it requires a continuous source of fuel and oxygen to sustain the chemical reaction, whereas a Battery only uses chemicals already stored inside it."@en .

ns8:ont00000478
    ns8:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Cuboidal"@en ;
    rdfs:subClassOf ns8:ont00001360 ;
    skos:definition "A Three Dimensional Shape that inheres in a bearer in virtue of it having six Rectangular faces."@en .

ns8:ont00000479
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Public_security&oldid=1058257389"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Public Safety Facility"@en ;
    rdfs:subClassOf ns8:ont00000192 ;
    skos:definition "A Facility that is designed for the prevention of and protection from events that could endanger, injure, or damage the general public."@en .

ns8:ont00000480
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Life Support Artifact Function"@en ;
    rdfs:subClassOf ns8:ont00000323 ;
    skos:definition "An Artifact Function that is realized during events in which an Artifact materially affects an organism, where this causes that organism to continue living in a situation where death would otherwise occur."@en .

ns8:ont00000481
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Research_and_development&oldid=1062181110"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Research and Development Artifact Function"@en ;
    rdfs:subClassOf ns8:ont00001301 ;
    skos:definition "A Service Artifact Function that is realized in processes of producing new knowledge or of devising new applications of existing knowledge."@en .

ns8:ont00000482
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Synthetic Aperture Radar Imaging Artifact Function"@en ;
    rdfs:subClassOf ns8:ont00000289 ;
    skos:definition "A Radar Imaging Artifact Function that inheres in Artifacts that are designed to produce visual representations of entities using the motion of a radar antenna over a targeted region to create a synthetic aperture."@en .

ns8:ont00000483
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Military_base&oldid=1047077734"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Military Base"@en ;
    rdfs:subClassOf ns8:ont00001052 ;
    skos:definition "A Military Facility that is designed to shelter military equipment and personnel and to facilitate training and operations."@en .

ns8:ont00000484
    ns8:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Concave Shape"@en ;
    rdfs:subClassOf ns8:ont00001059 ;
    skos:definition "A Shape Quality that inheres in a bearer in virtue of the bearer having one or more cavities, such that at least one line connecting a pair of points on the surface of the bearer will lie outside."@en .

ns8:ont00000485
    ns8:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Commercial Role"@en ;
    rdfs:subClassOf ns1:BFO_0000023 ;
    skos:definition "A Role that inheres in an Organization by virtue of its establishment as a for-profit business."@en .

ns8:ont00000486
    ns8:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Neutral Role"@en ;
    rdfs:subClassOf ns8:ont00000392 ;
    skos:definition "An Allegiance Role that inheres in an Agent by virtue of that Agent not performing or being committed to performing Acts that have as their Objective to either support or undermine the Objectives of an Agent or Group of Agents involved in some conflict."@en .

ns8:ont00000487
    ns8:ont00001760 "https://www.commoncoreontologies.org/GeospatialOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Geospatial Location"@en ;
    rdfs:subClassOf _:nimportcommonb290, ns8:ont00000472 ;
    skos:definition "A Geospatial Region that is at which an Entity or Event is located."@en .

ns8:ont00000488
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Tripod&oldid=1063988190"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Tripod"@en ;
    rdfs:subClassOf ns8:ont00000995 ;
    skos:definition "A Material Artifact that consists of three legs and a platform that joins them and which is designed to support the weight and maintain the stability of objects that are attached to or rested on the platform."@en .

ns8:ont00000489
    ns8:ont00001754 "Anderson et. al. A Land Use and Land Cover Classification System for use with Remote Sensor Data, Geological Survey Professional Paper 964" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/GeospatialOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "High Density Residential Area"@en ;
    rdfs:subClassOf ns8:ont00000224 ;
    skos:definition "A Populated Place which is characterized by densely contained multiple-unit living structures."@en .

ns8:ont00000490
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "X-ray Frequency"@en ;
    rdfs:subClassOf ns8:ont00000754 ;
    skos:definition "An Electromagnetic Radiation Frequency of some Electromagnetic Wave that is between 30 petahertz and 30 exahertz."@en .

ns8:ont00000491
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Detonation&oldid=1061553336"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Detonating Artifact Function"@en ;
    rdfs:subClassOf ns8:ont00000323 ;
    skos:definition "An Artifact Function that is realized in processes of combustion involving a supersonic exothermic front accelerating through a medium that eventually drives a shock front propagating directly in front of it."@en .

ns8:ont00000492
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Email&oldid=1063646749"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Email Messaging"@en ;
    rdfs:subClassOf ns8:ont00000517 ;
    skos:altLabel "Act of Emailing"@en ;
    skos:definition "An Act of Communication by Media in which text-based communication occurs between two or more people using personal computers or other devices using some Email Client Software conveyed over the Internet."@en .

ns8:ont00000493
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Code List"@en ;
    rdfs:subClassOf ns8:ont00000799 ;
    skos:definition "A List that contains an ordered sequence of Information Bearing Entities that carry Code Identifiers."@en .

ns8:ont00000494
    ns8:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Serrated"@en ;
    rdfs:subClassOf ns8:ont00001059 ;
    skos:definition "A Shape Quality inhering in a bearer in virtue of the bearer having multiple sharp points along a edge."@en .

ns8:ont00000495
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Radio Communication Interference Artifact Function"@en ;
    rdfs:subClassOf ns8:ont00000273 ;
    skos:definition "A Communication Interference Artifact Function that is realized during events in which an Artifact is used to interfere with the transmission of information via radio waves."@en .

ns8:ont00000496
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Natural_language&oldid=1060890461"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Natural Language"@en ;
    rdfs:subClassOf ns8:ont00001175 ;
    skos:definition "A Language that is developed and evolves through use and repetition, rather than through conscious planning or premeditation."@en ;
    skos:example "English", "Mandarin (Chinese)", "Spanish" .

ns8:ont00000497
    ns8:ont00001760 "https://www.commoncoreontologies.org/UnitsOfMeasureOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Measurement Unit of Force"@en ;
    rdfs:subClassOf ns8:ont00000120 ;
    skos:definition "A Measurement Unit that is used as a standard for measurement of interactions in which the Motion or Velocity of an object is changed, unless the interaction is opposed."@en ;
    skos:example "newton, dyne, pound force " .

ns8:ont00000498
    ns8:ont00001754 "https://www.defit.org/julian-date/" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/TimeOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:comment "A Julian Day begins at noon Universal Time and is twenty-four Hours in duration."@en ;
    rdfs:label "Julian Day"@en ;
    rdfs:subClassOf ns8:ont00000921 ;
    skos:definition "A Calendar Day in the Julian Calendar."@en .

ns8:ont00000499
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Wire Antenna"@en ;
    rdfs:subClassOf ns8:ont00001192 ;
    skos:definition "A Radio Antenna that consists primarily of a length of wire."@en .

ns8:ont00000500
    ns8:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Eye"@en ;
    rdfs:subClassOf ns8:ont00000084 ;
    skos:definition "A Bodily Component that consists of an organ that canonically affords the Agent it is part of with the ability to receive visual stimuli necessary for sight."@en .

ns8:ont00000501
    ns8:ont00001754 "http://en.wikipedia.org/wiki/Deposit_(bank)" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Act of Financial Withdrawal"@en ;
    rdfs:subClassOf ns8:ont00000836 ;
    skos:definition "An Act of Financial Instrument Use wherein a Financial Instrument is transferred by an Agent to another Agent (the Depositor) from an account created by an earlier Act of Financial Deposit performed by the Depositor."@en .

ns8:ont00000502
    ns8:ont00001760 "https://www.commoncoreontologies.org/UnitsOfMeasureOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Measurement Unit of Area Moment of Inertia"@en ;
    rdfs:subClassOf ns8:ont00000120 ;
    skos:altLabel "Measurement Unit of Second Area Moment"@en ;
    skos:definition "A Measurement Unit that is used as a standard for measurement of the distribution of Mass of an object with respect to an axis."@en ;
    skos:scopeNote "A measure of an object’s resistance to bending or deflection."@en .

ns8:ont00000503
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Power"@en ;
    rdfs:subClassOf ns1:BFO_0000144 ;
    skos:definition "A Process Profile that is characterized by the rate of Work, or Energy consumed, done in a given time period."@en .

ns8:ont00000504
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Optical Processing Artifact Function"@en ;
    rdfs:subClassOf ns8:ont00000323 ;
    skos:definition "An Artifact Function that is realized by an Artifact participating in a visible light processing event."@en .

ns8:ont00000505
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Center_of_mass&oldid=1059976491"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/GeospatialOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Center of Mass"@en ;
    rdfs:subClassOf ns1:BFO_0000018 ;
    skos:definition "A Zero-Dimensional Spatial Region that is the point where the weighted position vectors of the distributed Mass of a Material Entity relative to this point sum to zero."@en .

ns8:ont00000506
    ns8:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Contractor Role"@en ;
    rdfs:subClassOf ns1:BFO_0000023 ;
    skos:definition "A Role that inheres in an Agent or Group of Agents by virtue of that Agent or Group of Agents entering into a Contract to provide materials or labor to perform a service or complete a task."@en ;
    skos:scopeNote "A Contractor Role differs from an Occupation Role in at least two ways. First, the Contract that binds the two parties together is not one of employment. Second, a Contractor Role is occupationally neutral in that an Agent can be contracted to perform any number of Occupational Roles."@en .

ns8:ont00000507
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Ethnic_group&oldid=1063804490"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Ethnic Group"@en ;
    rdfs:subClassOf _:nimportcommonb291, ns8:ont00000914 ;
    skos:definition "A Group of Persons who identify with one another based on one or more shared inherited characteristics such as language, ancestry, nationality, culture, customs, religion, or social experiences."@en .

ns8:ont00000508
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Ultraviolet&oldid=1062593453"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Near Ultraviolet Light Frequency"@en ;
    rdfs:subClassOf ns8:ont00000610 ;
    skos:definition "An Ultraviolet Light Frequency that is between 750 terahertz and 3 petahertz."@en .

ns8:ont00000509
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Service_provider&oldid=1059415018"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Service Provider"@en ;
    rdfs:subClassOf ns8:ont00001180 ;
    skos:definition "An Organization whose purpose is to provide a service to other Agents."@en .

ns8:ont00000510
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Mosque&oldid=1062609892"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Mosque"@en ;
    rdfs:subClassOf ns8:ont00000052 ;
    skos:definition "A Religious Facility that is designed for Islamic worship and prayer."@en .

ns8:ont00000511
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Act of Planning"@en ;
    rdfs:subClassOf ns8:ont00000228 ;
    skos:definition "A Planned Act that involves making a Plan to achieve some specified Objective."@en .

ns8:ont00000512
    ns8:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Radiation Emissivity"@en ;
    rdfs:subClassOf ns8:ont00000628 ;
    skos:definition "An Electromagnetic Radiation Property that inheres in a bearer in virtue of the capacity of that bearer to emit electromagnetic radiation of a given frequency."@en .

ns8:ont00000513
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Act of Tool Use"@en ;
    rdfs:subClassOf ns8:ont00000566 ;
    skos:definition "An Act of Artifact Employment in which some Agent uses some Tool."@en .

ns8:ont00000514
    ns8:ont00001754 "http://www.acs.psu.edu/drussell/Demos/waves/wavemotion.html" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Transverse Wave Profile"@en ;
    rdfs:subClassOf ns8:ont00000752 ;
    skos:altLabel "Transverse Wave"@en ;
    skos:definition "A Wave Process Profile in which the displacement of participating particles is perpendicular to the direction of the Wave Process' propogation."@en .

ns8:ont00000515
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Act of Vehicle Use"@en ;
    rdfs:subClassOf ns8:ont00000566 ;
    skos:definition "An Act of Artifact Employment in which some Agent uses some Vehicle."@en .

ns8:ont00000516
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Pneumatic Power Source"@en ;
    rdfs:subClassOf ns8:ont00000288 ;
    skos:definition "A Power Source that is designed to generate, control, or transmit power by means of compressed air or compressed inert gases."@en .

ns8:ont00000517
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Act of Communication by Media"@en ;
    rdfs:subClassOf ns8:ont00000402 ;
    skos:definition "An Act of Communication in which some Artifact is used to transfer an Information Bearing Entity from sender(s) to receiver(s)."@en .

ns8:ont00000518
    ns8:ont00001760 "https://www.commoncoreontologies.org/CurrencyUnitOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Measurement Unit of Currency"@en ;
    rdfs:subClassOf ns8:ont00000120 ;
    skos:definition "A Measurement Unit used in measurements of financial values."@en ;
    skos:example "U.S. Dollar, Euro, Yuan, South African Rand" .

ns8:ont00000519
    ns8:ont00001753 "EHF" ;
    ns8:ont00001754 "International Telecommunication Union (ITU)" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:comment "The corresponding Wavelength range is 10–1 mm"@en ;
    rdfs:label "Extremely High Frequency"@en ;
    rdfs:subClassOf ns8:ont00000732 ;
    skos:altLabel "ITU Band Number 11"@en, "Millimeter Band Frequency"@en ;
    skos:definition "A Microwave Frequency that is between 30 and 300 GHz."@en .

ns8:ont00000520
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Act of Departure"@en ;
    rdfs:subClassOf ns8:ont00000065 ;
    skos:definition "An Act of Location Change that consists of the participating entity leaving its starting location such that the larger Act of Location Change is initiated."@en .

ns8:ont00000521
    ns8:ont00001754 "JC3IEDM-MIRD-DMWG-Edition_3.0.2_20090514" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Act of Assassination"@en ;
    rdfs:subClassOf ns8:ont00001272 ;
    skos:definition "An Act of Murder of a prominent person."@en .

ns8:ont00000522
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Pulsejet&oldid=1050473545"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Pulsejet Engine"@en ;
    rdfs:subClassOf ns8:ont00000294 ;
    skos:altLabel "Pulse Jet"@en, "Pulsejet"@en ;
    skos:definition "An Air-Breathing Jet Engine that is capable of operating statically and uses intermittent (pulsing) Combustion of the fuel-oxidizer mixture before expelling the exhaust out through the rear Propelling Nozzle to generate Thrust."@en .

ns8:ont00000523
    ns8:ont00001754 "https://byjus.com/physics/loudness-of-sound/"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Loudness"@en ;
    rdfs:subClassOf ns8:ont00000862 ;
    skos:definition "A Sound Process Profile that is characterized by the amplitude and total energy of translated sound waves, typically on a continuum from soft to loud."@en .

ns8:ont00000524
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Air_conditioning&oldid=1063494896"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Air Conditioning Unit"@en ;
    rdfs:subClassOf ns8:ont00000350 ;
    skos:altLabel "AC Unit"@en ;
    skos:definition "A Cooling System that is designed to remove excess heat and humidity from the air in an enclosed space."@en .

ns8:ont00000525
    ns8:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Transparent"@en ;
    rdfs:subClassOf ns8:ont00001384 ;
    skos:definition "An Opacity that inheres in a bearer in virtue of that bearer's capacity to transmit all or nearly all electromagnetic radiation of a given frequency through the bearer such that the bearer reflects, scatters, or absorbs little or no electromagnetic radiation of that frequency."@en .

ns8:ont00000526
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Telescope&oldid=1057722342"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Gamma-ray Telescope"@en ;
    rdfs:subClassOf ns8:ont00000547 ;
    skos:definition "A Telescope that is designed to aid in the observation of spatially distant Objects by means of collecting and focusing Gamma-rays to form an enhanced image of the Object."@en .

ns8:ont00000527
    ns8:ont00001760 "https://www.commoncoreontologies.org/UnitsOfMeasureOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Measurement Unit of Rotational Inertia"@en ;
    rdfs:subClassOf ns8:ont00000120 ;
    skos:altLabel "Measurement Unit of Moment of Inertia"@en, "Measurement Unit of Rotational Mass"@en ;
    skos:definition "A Measurement Unit that is used as a standard for measurement of the distribution of Mass of an object with respect to its axis of rotation."@en ;
    skos:scopeNote "A measure of an object’s resistance to change in its state of rotation."@en .

ns8:ont00000528
    ns8:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "White"@en ;
    rdfs:subClassOf ns8:ont00000378 ;
    skos:definition "A Color of maximum brightness, the color of objects that reflect nearly all wavelengths of the visible light spectrum, thus considered achromatic."@en .

ns8:ont00000529
    ns8:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI ;
    owl:equivalentClass _:nimportcommonb292 ;
    rdf:type owl:Class ;
    rdfs:label "Date Identifier"@en ;
    rdfs:subClassOf ns8:ont00000073 ;
    skos:altLabel "Day Identifier"@en ;
    skos:definition "A Temporal Interval Identifier that designates some Day."@en .

ns8:ont00000530
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:comment "Sound waves with frequencies in this range are typically audible to humans."@en ;
    rdfs:label "Sonic Frequency"@en ;
    rdfs:subClassOf ns8:ont00000008 ;
    skos:altLabel "Audible Frequency"@en ;
    skos:definition "A Sound Frequency that is between 20 Hz and 20 kHz."@en .

ns8:ont00000531
    ns8:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Communications Facility"@en ;
    rdfs:subClassOf ns8:ont00000192 ;
    skos:definition "A Facility that is designed to support processes of receiving or transmitting information."@en .

ns8:ont00000532
    dcterms:bibliographicCitation "Convention on Rights and Duties of States (inter-American); December 26, 1933. https://avalon.law.yale.edu/20th_century/intam03.asp. Accessed 6 Apr. 2023." ;
    dcterms:created "2023-02-08T19:54:46-05:00"^^xsd:dateTime ;
    dcterms:creator "https://cubrc.org"^^xsd:anyURI ;
    ns8:ont00001754 "https://avalon.law.yale.edu/20th_century/intam03.asp" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI ;
    owl:equivalentClass _:nimportcommonb296 ;
    rdf:type owl:Class ;
    rdfs:label "Government of a Country"@en ;
    rdfs:subClassOf ns8:ont00001335 ;
    skos:definition "A Government that has legitimate authority within and is delimited by a Domain of a Country."@en ;
    skos:prefLabel "Government of a Country"@en .

ns8:ont00000533
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Jet_engine&oldid=1060157063"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:comment "Some (most) jet engines utilize turbines, but some do not. Most rocket engines do not utilize turbines, but some do."@en ;
    rdfs:label "Jet Engine"@en ;
    rdfs:subClassOf ns8:ont00000056 ;
    skos:definition "A Reaction Engine that discharges a fast moving jet that generates Thrust by jet propulsion."@en .

ns8:ont00000534
    ns8:ont00001754 "http://www.dictionary.com/browse/cutting" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Cutting Artifact Function"@en ;
    rdfs:subClassOf ns8:ont00001153 ;
    skos:definition "A Damaging Artifact Function that is realized in a process in which the structural integrity of an entity is impaired by being opened or divided."@en .

ns8:ont00000535
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Decrease of Quality"@en ;
    rdfs:subClassOf ns8:ont00000290 ;
    skos:definition "A Decrease of Specifically Dependent Continuant in which some Independent Continuant has a decrease of some Quality that it bears."@en ;
    skos:example "Weight Loss, Decreasing Temperature, decreasing color intensity, loss of structural integrity" .

ns8:ont00000536
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Bond Certificate"@en ;
    rdfs:subClassOf ns8:ont00001159 ;
    skos:definition "A Bond that consists of a Certificate."@en .

ns8:ont00000537
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Finance&oldid=1062402926"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Financial Instrument"@en ;
    rdfs:subClassOf ns8:ont00000995 ;
    skos:definition "A Material Artifact that is designed to be a tradeable asset and that is legally sanctioned."@en .

ns8:ont00000538
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Defoliant&oldid=1059494225"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Defoliant Artifact Function"@en ;
    rdfs:subClassOf ns8:ont00000831 ;
    skos:definition "An Herbicide Artifact Function that is realized in a process that causes a plant to lose its leaves."@en .

ns8:ont00000539
    ns8:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Count Measurement Information Content Entity"@en ;
    rdfs:subClassOf ns8:ont00001022 ;
    skos:definition "A Ratio Measurement Information Content Entity that is a measurement of the number of members of some aggregate."@en .

ns8:ont00000540
    ns8:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI ;
    owl:equivalentClass _:nimportcommonb300 ;
    rdf:type owl:Class ;
    rdfs:label "Temporal Instant Identifier"@en ;
    rdfs:subClassOf ns8:ont00000399 ;
    skos:altLabel "Zero-Dimensional Temporal Region Identifier"@en ;
    skos:definition "A Temporal Region Identifier that designates some Temporal Instant."@en .

ns8:ont00000541
    ns8:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Diameter"@en ;
    rdfs:subClassOf ns8:ont00001367 ;
    skos:definition "A One Dimensional Extent that inheres in a circle in virtue of the extent of a straight line that passes through the center of the circle and starts and ends on the circle's boundary."@en .

ns8:ont00000542
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Loss of Generically Dependent Continuant"@en ;
    rdfs:subClassOf ns8:ont00000876 ;
    skos:definition "A Loss of Dependent Continuant in which some Independent Continuant ceases to be the carrier of some Generically Dependent Continuant."@en .

ns8:ont00000543
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Decrease of Disposition"@en ;
    rdfs:subClassOf ns8:ont00000854 ;
    skos:definition "A Decrease of Realizable Entity in which some Independent Continuant has a decrease of some Disposition it bears."@en .

ns8:ont00000544
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    owl:equivalentClass _:nimportcommonb304 ;
    rdf:type owl:Class ;
    rdfs:comment "Although people speak of targeting a process, say, a parade, what in fact are being targeted are the material participants of that process. The disruption or ceasing of the process is the objective of some plan, but not technically a target. Only material things can be targeted for action. Even if some dependent entity is described as being the target, the material thing for which that dependent entity depends is the object of a targeting process."@en ;
    rdfs:label "Target"@en ;
    rdfs:subClassOf ns1:BFO_0000040 ;
    skos:definition "A Material Entity that is the object of an Act of Targeting."@en .

ns8:ont00000545
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Seat_of_government&oldid=1063047501"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Seat of Local Government"@en ;
    rdfs:subClassOf ns8:ont00000946 ;
    skos:altLabel "City Hall"@en, "Town Hall"@en ;
    skos:definition "A Government Building that is designed for the administration of a local community."@en .

ns8:ont00000546
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Unplanned Act"@en ;
    rdfs:subClassOf ns8:ont00000005 ;
    skos:altLabel "Unintentional Act"@en ;
    skos:definition "An Act in which at least one Agent plays a causative role and which is not prescribed by some Objective held by any of the Agents."@en .

ns8:ont00000547
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Telescope&oldid=1057722342"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Telescope"@en ;
    rdfs:subClassOf ns8:ont00000771 ;
    skos:definition "An Imaging Instrument that is designed to aid in the observation of spatially distant Objects by means of collecting and focusing Electromagnetic Radiation to form an enhanced image of the Object."@en .

ns8:ont00000548
    dcterms:bibliographicCitation "Vulnerability | Definition of Vulnerability by Oxford Dictionary on Lexico.Com Also Meaning of Vulnerability. https://web.archive.org/web/20210118111731/https://www.lexico.com/en/definition/vulnerability. Accessed 19 Dec. 2022. " ;
    dcterms:creator "https://cubrc.org"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Vulnerability"@en ;
    rdfs:subClassOf ns8:ont00000997 ;
    skos:definition "A Disrupting Disposition the realization of which would disrupt a process that the bearer of the Disrupting Disposition has an interest in."@en ;
    skos:editorialNote "This is defined class. A Vulnerability is indexed by the interest_in object property. A disposition can be a Vulnerability according to one index and not a Vulnerability according to another index." ;
    skos:prefLabel "Vulnerability"@en .

ns8:ont00000549
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Water Transportation Artifact"@en ;
    rdfs:subClassOf ns8:ont00000254 ;
    skos:definition "A Transportation Artifact that is fixed in place and designed to bear a Function, the realization of which is sometimes part of a process of moving Vehicles and Agents from one location to another via water."@en .

ns8:ont00000550
    ns8:ont00001760 "https://www.commoncoreontologies.org/TimeOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Morning"@en ;
    rdfs:subClassOf ns1:BFO_0000202 ;
    skos:definition "A Temporal Interval that consists of the temporal regions between when the sun dawns (approximately 6:00am) and reaches its apex (approximately 12:00pm)."@en .

ns8:ont00000551
    ns8:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Organism"@en ;
    rdfs:subClassOf ns1:BFO_0000030 ;
    skos:definition "An Object that is an Animal or Plant."@en .

ns8:ont00000552
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Explosive_weapon&oldid=1062481268"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Explosive Weapon"@en ;
    rdfs:subClassOf ns8:ont00000445 ;
    skos:altLabel "Bomb"@en ;
    skos:definition "A Weapon that is designed to inflict harm, damage, or incapacity by means of a violent release of energy caused by the exothermic reaction of an explosive material."@en .

ns8:ont00000553
    ns8:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI ;
    owl:equivalentClass _:nimportcommonb308 ;
    rdf:type owl:Class ;
    rdfs:label "Process Prohibition"@en ;
    rdfs:subClassOf ns8:ont00001324 ;
    skos:definition "A Process Regulation that prohibits some Process."@en .

ns8:ont00000554
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Gain of Dependent Continuant"@en ;
    rdfs:subClassOf ns8:ont00000004 ;
    skos:definition "A Change in which an Independent Continuant becomes the bearer or carrier of some Dependent Continuant."@en .

ns8:ont00000555
    ns8:ont00001754 "http://www.thefreedictionary.com/enhance" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Enhanced Stasis"@en ;
    rdfs:subClassOf ns8:ont00000135 ;
    skos:altLabel "Enhanced"@en ;
    skos:definition "A Stasis of Specifically Dependent Continuant in which some Independent Continuant bears a Quality or Realizable Entity that has undergone improvement (i.e., an increase or gain) due to a previous action or event such that the Independent Continuant is now of greater value, usefulness, or functionality."@en .

ns8:ont00000556
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Payload&oldid=1035953573"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:comment "Depending on the nature of the Flight or Mission, the Payload of a Vehicle may include cargo, passengers, flight crew, munitions, scientific instruments or experiments, or other equipment. Extra fuel, when optionally carried, is also considered part of the payload."@en ;
    rdfs:label "Payload"@en ;
    rdfs:subClassOf ns1:BFO_0000040 ;
    skos:definition "A Material Entity that is transported by a Vehicle during an Act of Location Change for the purpose of being delivered to or performing one or more functions at a predefined location."@en ;
    skos:scopeNote "In each case, the Payload is what provides the immediate reason for performing the Act of Location Change (e.g. transporting the passengers of a commercial airline flight to their destination; transporting food, fuel, oxygen, research equipment, and spare parts to the International Space Station; or conveying an array of sensors, cameras, and communications systems so they can operate during a Sun-Synchronous Earth Orbit)."@en .

ns8:ont00000557
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Stasis of Non-Mission Capable"@en ;
    rdfs:subClassOf ns8:ont00001132 ;
    skos:definition "A Stasis of Mission Capability during which the participating Continuant is not capable of performing any of its primary functions for the specified Mission."@en .

ns8:ont00000558
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Visible Light Reflection Process"@en ;
    rdfs:subClassOf ns8:ont00000099 ;
    skos:definition "A Wave Process in which an Electromagnetic Wave with a Visible Light Frequency is reflected off a portion of matter."@en .

ns8:ont00000559
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "QR Code"@en ;
    rdfs:subClassOf ns8:ont00000241 ;
    skos:definition "A Two-Dimensional Barcode that consists of numeric, alphanumeric, binary, or kanji information and is used primarily for tracking and marketing."@en .

ns8:ont00000560
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Cone&oldid=1058362269"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Cone Shape"@en ;
    rdfs:subClassOf ns8:ont00001360 ;
    skos:definition "A Three Dimensional Shape that inheres in a bearer in virtue of it having a Round base that tapers smoothly to an apex."@en .

ns8:ont00000561
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Dam&oldid=1053601756" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Dam"@en ;
    rdfs:subClassOf ns8:ont00000995 ;
    skos:definition "A Material Artifact that is designed to impound surface water or underground streams."@en .

ns8:ont00000562
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Animal&oldid=1063873549"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Animal"@en ;
    rdfs:subClassOf ns8:ont00000551 ;
    skos:definition "An Organism that is multicellular, eukaryotic, heterotrophic, and capable of motility for part of its life."@en .

ns8:ont00000563
    ns8:ont00001760 "https://www.commoncoreontologies.org/GeospatialOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Hydrographic Feature"@en ;
    rdfs:subClassOf ns8:ont00001081 ;
    skos:definition "A Geographic Feature associated with water."@en .

ns8:ont00000564
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Education&oldid=1064011752"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Educational Organization"@en ;
    rdfs:subClassOf ns8:ont00001180 ;
    skos:definition "An Organization whose primary purpose is to provide training or otherwise facilitate learning or the acquisition of knowledge, Skills, values, beliefs, or habits."@en .

ns8:ont00000565
    ns8:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Cube Shape"@en ;
    rdfs:subClassOf ns8:ont00000478 ;
    skos:definition "A Cuboidal shape inhering in a bearer in virtue of it having six Square faces."@en .

ns8:ont00000566
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Act of Artifact Employment"@en ;
    rdfs:subClassOf ns8:ont00000228 ;
    skos:definition "A Planned Act of using an Artifact."@en .

ns8:ont00000567
    ns8:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:comment "This is a general term that applies to both military and civilian activities, such as the Geospatial Region within which a company conducts its business."@en ;
    rdfs:label "Operational Area"@en ;
    rdfs:subClassOf ns8:ont00000487 ;
    skos:definition "A Geospatial Location in which an Agent conducts some activity."@en .

ns8:ont00000568
    ns8:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI ;
    owl:equivalentClass _:nimportcommonb312 ;
    rdf:type owl:Class ;
    rdfs:label "Organization Capability"@en ;
    rdfs:subClassOf ns8:ont00001379 ;
    skos:definition "An Agent Capability that inheres in an Organization to the extent of that Organization's capacity to realize it in Intentional Acts of a certain type."@en .

ns8:ont00000569
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Sensor&oldid=1059883466"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Sensor"@en ;
    rdfs:subClassOf ns8:ont00000736 ;
    skos:definition "A Transducer that is designed to convert incoming energy into a output signal which reliably corresponds to changes in that energy."@en .

ns8:ont00000570
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Force"@en ;
    rdfs:subClassOf ns1:BFO_0000144 ;
    skos:definition "A Process Profile that is the rate of change of an object's Momentum, is the product of an object's Mass and Acceleration with respect to an inertial frame of reference, and is measured in units of Newtons (N)."@en .

ns8:ont00000571
    ns8:ont00001754 "https://stats.oecd.org/glossary/detail.asp?ID=2508" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Article of Solid Waste"@en ;
    rdfs:subClassOf ns8:ont00000980 ;
    skos:definition "A Portion of Waste Material that has a low liquid content."@en .

ns8:ont00000572
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Sound Production"@en ;
    rdfs:subClassOf ns8:ont00000765 ;
    skos:altLabel "Sound Production Process"@en ;
    skos:definition "A Wave Production Process that produces a Sound Wave."@en .

ns8:ont00000573
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Act of Religious Training Acquisition"@en ;
    rdfs:subClassOf ns8:ont00000687 ;
    skos:definition "An Act of Training Acquisition performed by an Agent by acquiring knowledge of the tenets and/or practices of a religion from an Agent or communication medium that realizes a capacity derived from its affiliation with a Religious Organization."@en .

ns8:ont00000574
    ns8:ont00001760 "https://www.commoncoreontologies.org/GeospatialOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Environmental Feature"@en ;
    rdfs:subClassOf ns1:BFO_0000040 ;
    skos:definition "A Material Entity that is either a natural or man-made feature of the environment."@en .

ns8:ont00000575
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    owl:equivalentClass _:nimportcommonb316 ;
    rdf:type owl:Class ;
    rdfs:label "Quality Specification"@en ;
    rdfs:subClassOf ns8:ont00000965 ;
    skos:definition "A Directive Information Content Entity that prescribes some Quality."@en .

ns8:ont00000576
    ns8:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Scalp"@en ;
    rdfs:subClassOf ns8:ont00000084 ;
    skos:definition "A Bodily Component that consists of the skin covering the top of the head of a human or other animal."@en .

ns8:ont00000577
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Rectifier&oldid=1049943028"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Power Rectifier"@en ;
    rdfs:subClassOf ns8:ont00000995 ;
    skos:definition "A Material Artifact that is designed to convert alternating current (AC) to direct current (DC)."@en .

ns8:ont00000578
    ns8:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Sloped"@en ;
    rdfs:subClassOf ns8:ont00001059 ;
    skos:definition "A Shape Quality inhering in a bearer in virtue of the bearer having a horizontal border which is not level."@en .

ns8:ont00000579
    ns8:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Thin"@en ;
    rdfs:subClassOf ns8:ont00001059 ;
    skos:altLabel "Narrow"@en, "Slender"@en ;
    skos:definition "A Shape Quality inhering in a bearer in virtue of the bearer having a width or depth which is significantly smaller in proportion to its length or height."@en .

ns8:ont00000580
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Sine Waveform"@en ;
    rdfs:subClassOf ns8:ont00001286 ;
    skos:altLabel "Sinusoidal Waveform"@en ;
    skos:definition "A Waveform that is characterized by a smooth curved shape due to the continuous non-linear transitions between minimum and maximum Amplitudes of the Wave Cycle."@en .

ns8:ont00000581
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Tool&oldid=1061967184"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Tool"@en ;
    rdfs:subClassOf ns8:ont00000995 ;
    skos:definition "A Material Artifact that is designed to assist in the performance of manual or mechanical work and not to be consumed in that process."@en .

ns8:ont00000582
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Code 93 Barcode"@en ;
    rdfs:subClassOf ns8:ont00000258 ;
    skos:definition "A One-Dimensional Barcode that consists of up to 93 ASCII characters and is used in logistics to identify packages in retail inventory, lable electornic components, and provide supplementary delivery information."@en .

ns8:ont00000583
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Motel&oldid=1063898961"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Motel"@en ;
    rdfs:subClassOf ns8:ont00000180 ;
    skos:definition "A Hotel that is designed to accommodate motor vehicles along with their occupants."@en .

ns8:ont00000584
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:comment "An Act of Position Change does not entail a change of location."@en ;
    rdfs:label "Act of Position Change"@en ;
    rdfs:subClassOf ns8:ont00000357 ;
    skos:definition "An Act of Motion in which the position (i.e. the orientation, alignment, or arrangement) of some Object or of one or more of an Object's parts is changed by some Agent."@en ;
    skos:example "a top spinning in place", "adjusting your posture", "raising your left arm", "swivelling your office chair to face the window" .

ns8:ont00000585
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Sawtooth Waveform"@en ;
    rdfs:subClassOf ns8:ont00001286 ;
    skos:definition "A Waveform that is characterized by a sawtooth shape due to the continuous linear transition from minimum to maximum Amplitudes followed by a near-instantaneous transition from the maximum to minimum Amplitudes of the Wave Cycle."@en .

ns8:ont00000586
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Variable-pitch_propeller&oldid=1041375492"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Controllable Pitch Propeller"@en ;
    rdfs:subClassOf ns8:ont00000238 ;
    skos:altLabel "Variable-Pitch Propeller"@en ;
    skos:definition "A Propeller whose blades are designed to be alterable by rotating the blades about their vertical axis by means of mechanical or hydraulic arrangement."@en .

ns8:ont00000587
    ns8:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Ally Role"@en ;
    rdfs:subClassOf ns8:ont00000392 ;
    skos:definition "An Allegiance Role that inheres in an Agent in virtue of that Agent's commitment to perform Acts that support the Objectives of a particular Agent or Group of Agents."@en .

ns8:ont00000588
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Media&oldid=1062799283"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Act of Mass Media Communication"@en ;
    rdfs:subClassOf ns8:ont00000402 ;
    skos:definition "An Act of Communication intended to reach a large audience using a medium such as the internet, television, radio, newspaper, and magazine."@en .

ns8:ont00000589
    ns8:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Julian Date Fraction"@en ;
    rdfs:subClassOf ns8:ont00000973 ;
    skos:altLabel "Julian Date Time Identifier"@en, "Julian Day Fraction"@en ;
    skos:definition "A Decimal Time of Day Identifier that designates an approximate Temporal Instant that is part of some Julian Day."@en .

ns8:ont00000590
    ns8:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Convex Shape"@en ;
    rdfs:subClassOf ns8:ont00001059 ;
    skos:definition "A Shape Quality that inheres in a bearer in virtue of the bearer not having a cavity, such that no line connecting a pair of points on the surface of the bearer will lie outside."@en .

ns8:ont00000591
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    owl:equivalentClass _:nimportcommonb320 ;
    rdf:type owl:Class ;
    rdfs:label "Artifact Location"@en ;
    rdfs:subClassOf ns1:BFO_0000029 ;
    skos:definition "A Site that is the location of some Artifact."@en .

ns8:ont00000592
    ns8:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:comment "'Deviation Measurement Information Content Entity' and 'Veracity Measurement Information Content Entity' are complementary notions. Deviation is a measure of whether reality conforms to an ICE (e.g., a plan or prediction), whereas Veracity is a measure of whether a Descriptive ICE conforms to reality."@en, "Note, the term 'accuracy' is avoided due to its ambiguity between: correctness-of-performance (see: 'Reliability Measurement Information Content Entity'), correctness-of-information ('Veracity Measurement Information Content Entity'), and adherance-to-expectations (see: 'Deviation Measurement Information Content Entity')."@en ;
    rdfs:label "Veracity Measurement Information Content Entity"@en ;
    rdfs:subClassOf ns8:ont00001163 ;
    skos:altLabel "Accuracy of Information"@en, "Trueness Measurement"@en, "Veracity Measurement"@en ;
    skos:definition "A Measurement Information Content Entity that is a measurement of the extent to which a description conforms to the reality it describes."@en .

ns8:ont00000593
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Portion of Propellant"@en ;
    rdfs:subClassOf ns8:ont00000457 ;
    skos:definition "A Portion of Material that is designed to be used as an input in a Propulsion Process to produce Thrust."@en .

ns8:ont00000594
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Ignition Process"@en ;
    rdfs:subClassOf ns8:ont00000007 ;
    skos:altLabel "Ignition"@en ;
    skos:definition "A Natural Process that initiates a Combustion process."@en .

ns8:ont00000595
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Act of Cargo Transportation"@en ;
    rdfs:subClassOf ns8:ont00000065 ;
    skos:definition "An Act of Location Change involving the movement of manufactured goods through some Transportation Agent."@en .

ns8:ont00000596
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "JAN-13 Barcode"@en ;
    rdfs:subClassOf ns8:ont00000966 ;
    skos:definition "An EAN Barcode that consists of 13 numerical digits and is used primarily in Japan to designate products at the point of sale."@en .

ns8:ont00000597
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Flight_instruments&oldid=1062972990"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Instrument Display Panel"@en ;
    rdfs:subClassOf ns8:ont00000798 ;
    skos:definition "An Information Bearing Artifact that is designed to bear information about some Artifact that is derived by the instrumentation Sensors of that Artifact."@en .

ns8:ont00000598
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Valve&oldid=1048906126"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Valve"@en ;
    rdfs:subClassOf ns8:ont00000256 ;
    skos:definition "A Fluid Control Artifact that is designed to regulate, direct, or control the flow of fluid by opening, closing, or partially obstructing the fluid from moving along a passageway."@en .

ns8:ont00000599
    ns8:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Interpersonal Relationship Role"@en ;
    rdfs:subClassOf ns1:BFO_0000023 ;
    skos:definition "A Role that inheres in a Person in virtue of the obligations, expectations, or social norms that govern that Person's Intentional Acts within the context of a relationship with another Person."@en .

ns8:ont00000600
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Law&oldid=1060821734"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Legal Artifact Function"@en ;
    rdfs:subClassOf ns8:ont00001301 ;
    skos:definition "A Service Artifact Function that is realized in processes of giving legal advice to clients drafting legal documents for clients and representing clients in legal negotiations and court proceedings such as lawsuits."@en .

ns8:ont00000601
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Imaging Artifact Function"@en ;
    rdfs:subClassOf ns8:ont00000323 ;
    skos:definition "An Artifact Function that inheres in Artifacts that are designed to produce visual representations of entities."@en .

ns8:ont00000602
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "ITF Barcode"@en ;
    rdfs:subClassOf ns8:ont00000258 ;
    skos:definition "A One-Dimensional Barcode that consists of an even number of numerical characters and is used primarily in packaging and distribution."@en .

ns8:ont00000603
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Navigation Artifact Function"@en ;
    rdfs:subClassOf ns8:ont00000323 ;
    skos:definition "An Artifact Function that is realized during events in which an Artifact is used to determine the precise location of itself or another object and plan a route to a specified destination."@en .

ns8:ont00000604
    ns8:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Maximum Ordinal Measurement Information Content Entity"@en ;
    rdfs:subClassOf ns8:ont00001010 ;
    skos:definition "An Ordinal Measurement Information Content Entity that is a measurement of some entity in virtue of it being the largest or having the greatest amount relative to a nominally described set of like entities."@en .

ns8:ont00000605
    ns8:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Abbreviated Name"@en ;
    rdfs:subClassOf ns8:ont00000003 ;
    skos:definition "A Designative Name that is a shortened form of a Proper Name."@en .

ns8:ont00000606
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Truck&oldid=1060924486"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:comment "Trucks vary greatly in their size and power -- ranging from small ultra-light trucks to enormous heavy trucks. Trucks also vary greatly in their configurations -- ranging from very basic flatbeds or box trucks to highly specialized cargo carriers. Trucks may also be configured to mount specialized equipment, such as in the case of fire trucks, concrete mixers, and suction excavators."@en ;
    rdfs:label "Truck"@en ;
    rdfs:subClassOf ns8:ont00000053 ;
    skos:definition "A Ground Motor Vehicle that is designed to be used to transport cargo."@en .

ns8:ont00000607
    ns8:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Thickness"@en ;
    rdfs:subClassOf ns8:ont00000892 ;
    skos:definition "A Depth that inheres in a bearer in virtue of it extending inward through an object."@en .

ns8:ont00000608
    ns8:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Financial Value"@en ;
    rdfs:subClassOf ns1:BFO_0000019 ;
    skos:definition "A quality that inheres in an independent continuant to the degree that that independent continuant can serve as a medium of exchange in an economic system at a particular time."@en .

ns8:ont00000609
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:comment "This class should be used to demarcate the start of the temporal interval (through the BFO 'occupies temporal region' property) that the Entity bears the Disposition."@en ;
    rdfs:label "Gain of Disposition"@en ;
    rdfs:subClassOf _:nimportcommonb324, ns8:ont00000642 ;
    skos:definition "A Gain of Realizable Entity in which some Independent Continuant becomes the bearer of some Disposition."@en .

ns8:ont00000610
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Ultraviolet&oldid=1062593453"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Ultraviolet Light Frequency"@en ;
    rdfs:subClassOf ns8:ont00000754 ;
    skos:definition "An Electromagnetic Radiation Frequency of some Electromagnetic Wave that is between 750 terahertz and 30 petahertz."@en .

ns8:ont00000611
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Increase of Realizable Entity"@en ;
    rdfs:subClassOf ns8:ont00001214 ;
    skos:definition "An Increase of Specifically Dependent Continuant in which some Independent Continuant has an increase of some Realizable Entity that it bears."@en .

ns8:ont00000612
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Act of Weapon Use"@en ;
    rdfs:subClassOf ns8:ont00000566 ;
    skos:definition "An Act of Artifact Employment in which some Agent uses some Weapon."@en .

ns8:ont00000613
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Loss of Role"@en ;
    rdfs:subClassOf ns8:ont00000250 ;
    skos:definition "A Loss of Realizable Entity in which some Independent Continuant ceases to be the bearer of some Role."@en .

ns8:ont00000614
    ns8:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:comment "'Matter' here can also refer to the inertial energy of an object."@en, "Typical unit of measure is the kilogram or pound."@en ;
    rdfs:label "Mass"@en ;
    rdfs:subClassOf ns1:BFO_0000019 ;
    skos:definition "A Quality that inheres in a bearer in virtue of the amount of matter in that bearer."@en .

ns8:ont00000615
    ns8:ont00001754 "http://wordnetweb.princeton.edu/perl/webwn?s=encounter (Sense Key: Encounter%2:38:00)" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Act of Encounter"@en ;
    rdfs:subClassOf ns8:ont00000433 ;
    skos:definition "An Act of Association wherein two or more Persons meet in a casual or unplanned manner."@en .

ns8:ont00000616
    ns8:ont00001754 "http://www.dictionary.com/browse/religion" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Religion"@en ;
    rdfs:subClassOf ns8:ont00000958 ;
    skos:definition "An Information Content Entity that consists of a collection of claims about the meaning or origin of existence or about the existence or nature of one or more deities, an afterlife, or spiritual or sacred entities, and which is accepted as true by an Agent or Group of Agents."@en .

ns8:ont00000617
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Thermographic_camera&oldid=1063916009"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Infrared Camera"@en ;
    rdfs:subClassOf ns8:ont00000199 ;
    skos:altLabel "Thermal Imaging Camera"@en, "Thermographic Camera"@en ;
    skos:definition "A Camera that is designed to form and record an image generated from infrared radiation."@en .

ns8:ont00000618
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Category:Land_vehicles&oldid=546083623"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Ground Vehicle"@en ;
    rdfs:subClassOf ns8:ont00000713 ;
    skos:definition "A Vehicle that is designed to convey passengers, cargo, or equipment from one location to another by some form of ground travel."@en .

ns8:ont00000619
    ns8:ont00001754 "http://wordnetweb.princeton.edu/perl/webwn?s=week" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/TimeOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Week"@en ;
    rdfs:subClassOf _:nimportcommonb329, ns1:BFO_0000202 ;
    skos:definition "A Temporal Interval that is equal to seven consecutive Days."@en .

ns8:ont00000620
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Radiodensity&oldid=1048274724"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Radiopacity"@en ;
    rdfs:subClassOf ns8:ont00001384 ;
    skos:altLabel "Radiodensity"@en ;
    skos:definition "An Opacity that inheres in a bearer in virtue of its capacity to allow or prevent X-rays to pass through it."@en .

ns8:ont00000621
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Inverse Sawtooth Waveform"@en ;
    rdfs:subClassOf ns8:ont00001286 ;
    skos:definition "A Waveform that is characterized by a sawtooth shape due to the continuous linear transition from maximum to minimum Amplitudes followed by a near-instantaneous transition from the minimum to maximum Amplitudes of the Wave Cycle."@en .

ns8:ont00000622
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Stasis of Fully Mission Capable"@en ;
    rdfs:subClassOf ns8:ont00001132 ;
    skos:definition "A Stasis of Mission Capability during which the participating Continuant is capable of performing all of its primary functions for the specified Mission."@en .

ns8:ont00000623
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Impact Shielding Artifact Function"@en ;
    rdfs:subClassOf ns8:ont00000323 ;
    skos:definition "An Artifact Function that is realized during events in which an Artifact reduces the damage caused to the shielded object by an impact with another object."@en .

ns8:ont00000624
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Report&oldid=1063765657"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Report"@en ;
    rdfs:subClassOf ns8:ont00001298 ;
    skos:definition "A Document that is designed to bear some specific Information Content Entity that conveys an account of some event, situation, or the result of some observation or inquiry."@en .

ns8:ont00000625
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Nozzle Throat"@en ;
    rdfs:subClassOf ns8:ont00000256 ;
    skos:definition "A Fluid Control Artifact that consists of the narrowest portion of a Nozzle that is designed to converge the flow of fluid in order to increase the Velocity of the flow."@en .

ns8:ont00000626
    ns8:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:comment "Since predictions are inherently about not-yet-existant things, the Modal Relation Ontology term 'describes' (i.e. mro:describes) should be used (instead of the standard cco:describes) to relate instances of Predictive Information Content Entity to the entities they are about."@en ;
    rdfs:label "Predictive Information Content Entity"@en ;
    rdfs:subClassOf ns8:ont00000853 ;
    skos:altLabel "Prediction Information Content Entity"@en, "Prediction"@en ;
    skos:definition "A Descriptive Information Content Entity that describes an uncertain future event."@en .

ns8:ont00000627
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    owl:equivalentClass _:nimportcommonb330 ;
    rdf:type owl:Class ;
    rdfs:label "Infrastructure Element"@en ;
    rdfs:subClassOf ns1:BFO_0000040 ;
    skos:definition "A Material Entity that bears an Infrastructure Role."@en .

ns8:ont00000628
    ns8:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Electromagnetic Radiation Property"@en ;
    rdfs:subClassOf ns1:BFO_0000016 ;
    skos:definition "A Disposition that inheres in an bearer in virtue of how that bearer interacts with electromagnetic radiation."@en .

ns8:ont00000629
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Deception&oldid=1061346984"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Deception Artifact Function"@en ;
    rdfs:subClassOf ns8:ont00000323 ;
    skos:definition "An Artifact Function that is realized in processes which misinform or mislead some other entity."@en .

ns8:ont00000630
    ns8:ont00001753 "UT" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Universal Time Reference System"@en ;
    rdfs:subClassOf ns8:ont00000124 ;
    skos:definition "A Solar Time Reference System that is based on the average speed of the Earth's rotation and which uses the prime meridian at 0° longitude as a reference point."@en .

ns8:ont00000631
    dcterms:bibliographicCitation "Convention on Rights and Duties of States (inter-American); December 26, 1933. https://avalon.law.yale.edu/20th_century/intam03.asp. Accessed 6 Apr. 2023." ;
    dcterms:created "2023-02-06T10:14:09-05:00"@en ;
    ns8:ont00001754 "https://avalon.law.yale.edu/20th_century/intam03.asp" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI ;
    owl:equivalentClass _:nimportcommonb334 ;
    rdf:type owl:Class ;
    rdfs:label "Material Territory of a Country"@en ;
    rdfs:subClassOf ns8:ont00000662 ;
    skos:definition "The portions of lithosphere, hydrosphere, or atmosphere that together exactly occupy a The Domain of a Country."@en ;
    skos:prefLabel "Material Territory of a Country"@en .

ns8:ont00000632
    ns8:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Magnetism"@en ;
    rdfs:subClassOf ns1:BFO_0000016 ;
    skos:definition "A Disposition that is realized when its bearer exerts a magnetic force on another entity."@en .

ns8:ont00000633
    ns8:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:comment "When an object is \"weighed\", in the typical case, it is done so by taking into account the local force of gravity to determine the object's mass, whose standard of measure is the kilogram. The actual unit of measure of weight is the newton."@en ;
    rdfs:label "Weight"@en ;
    rdfs:subClassOf ns1:BFO_0000019 ;
    skos:definition "A Quality that inheres in some material entity with a mass in virtue of its location in some gravitational field."@en .

ns8:ont00000634
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Steam_engine&oldid=1064097686"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Steam Engine"@en ;
    rdfs:subClassOf ns8:ont00000431 ;
    skos:definition "An External Combustion Engine that is designed to use steam as its working fluid."@en .

ns8:ont00000635
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Refraction Artifact Function"@en ;
    rdfs:subClassOf ns8:ont00000323 ;
    skos:definition "An Artifact Function that is realized by an Artifact participating in a refraction event in which the Artifact causes a change in direction of wave propagation due to a change in its transmission medium."@en .

ns8:ont00000636
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:comment "Note that, while most if not all Acts of Appraisal involve some estimating and many Acts of Estimation involve some appraising (i.e. these classes are not disjoint), neither class subsumes the other. For example, some Acts of Appraisal (e.g. a tax assessor appraising the value of a building) impart a normative element to the measured value while others (e.g. a gustatory appraisal that fresh green beans taste better than canned green beans) involve complete information. Furthermore, many Acts of Estimation (e.g. estimating the height of a tree) are concerned solely with determining a numerical value (as opposed to the nature, value, importance, condition, or quality)."@en ;
    rdfs:label "Act of Appraisal"@en ;
    rdfs:subClassOf ns8:ont00000345 ;
    skos:definition "An Act of Measuring that involves evaluating, assessing, estimating, or judging the nature, value, importance, condition, or quality of something or someone."@en ;
    skos:example "a food critic rating the quality of a restaurant's ambiance, service, and food", "a mechanic assessing whether a damaged vehicle is repairable", "an insurance agent appraising the financial value of a building" ;
    skos:scopeNote "In the context of an Act of Appraisal, the terms 'value', 'condition', and 'quality' do not have the same meanings as their counterparts that are defined in the Common Core Ontologies. For example, a knife may be appraised to be of high quality if it is sharp and sturdy or to be of inferior quality if it is dull or fragile."@en .

ns8:ont00000637
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Portion of Gaseous Propellant"@en ;
    rdfs:subClassOf ns8:ont00000593 ;
    skos:definition "A Portion of Propellant that is stored in a gaseous state."@en .

ns8:ont00000638
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Heat Engine"@en ;
    rdfs:subClassOf ns8:ont00000210 ;
    skos:definition "An Engine that is designed to convert thermal energy into mechanical energy."@en .

ns8:ont00000639
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Mining&oldid=1062844924"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Mine"@en ;
    rdfs:subClassOf ns8:ont00000192 ;
    skos:definition "A Facility that is designed to support the extraction of minerals or other geological materials from an orebody, lode, vein, seam, reef, or placer deposit within the earth."@en .

ns8:ont00000640
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Email&oldid=1063646749"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Email Message"@en ;
    rdfs:subClassOf ns8:ont00001002 ;
    skos:definition "A Message that is transmitted to the recipient's Email Box."@en .

ns8:ont00000641
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Entertainment&oldid=1061851778"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Entertainment Facility"@en ;
    rdfs:subClassOf ns8:ont00000192 ;
    skos:definition "A Facility that is designed to host activities that are intended to hold the interest of, or give pleasure or delight to, an audience."@en .

ns8:ont00000642
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Gain of Realizable Entity"@en ;
    rdfs:subClassOf _:nimportcommonb338, ns8:ont00000395 ;
    skos:definition "A Gain of Specifically Dependent Continuant in which some Independent Continuant becomes the bearer of some Realizable Entity."@en ;
    skos:example "An informant becomes unreliable (disposition), A person begins to speak French (function), a person becomes a welder (role)." .

ns8:ont00000643
    ns8:ont00001753 "LF" ;
    ns8:ont00001754 "International Telecommunication Union (ITU)" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:comment "The corresponding Wavelength range is 10–1 km"@en ;
    rdfs:label "Low Frequency"@en ;
    rdfs:subClassOf ns8:ont00000150 ;
    skos:altLabel "ITU Band Number 5"@en ;
    skos:definition "A Radio Frequency that is between 30 and 300 kHz."@en .

ns8:ont00000644
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Oscillation&oldid=1002978272"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:comment "Oscillation is often thought of in the sense of motion, e.g., a swinging clock pendulum. However, the repetitive variation in location around a central point is technically a process of vibration, sometimes referred to as mechanical oscillation. Use the term Vibration Motion for those cases."@en ;
    rdfs:label "Oscillation Process"@en ;
    rdfs:subClassOf ns8:ont00000004 ;
    skos:altLabel "Oscillation"@en ;
    skos:definition "A Change in which the dependent entity alternates between two or more stases."@en .

ns8:ont00000645
    dcterms:created "2023-03-29T20:17:54-04:00"^^xsd:dateTime ;
    dcterms:creator "https://cubrc.org"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI ;
    owl:equivalentClass _:nimportcommonb343 ;
    rdf:type owl:Class ;
    rdfs:label "Permanent Resident"@en ;
    rdfs:subClassOf ns8:ont00001262 ;
    skos:definition "A person with a Permanent Resident Role."@en ;
    skos:prefLabel "Permanent Resident"@en .

ns8:ont00000646
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Highway&oldid=1063985949"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Highway"@en ;
    rdfs:subClassOf ns8:ont00000247 ;
    skos:definition "A Road that is designed to enable Ground Vehicles to travel between relatively major destinations."@en .

ns8:ont00000647
    ns8:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI ;
    owl:equivalentClass _:nimportcommonb347 ;
    rdf:type owl:Class ;
    rdfs:label "Organization Member"@en ;
    rdfs:subClassOf _:nimportcommonb351, ns8:ont00001262 ;
    skos:definition "A Person who is affiliated with some Organization by being a member of that Organization."@en .

ns8:ont00000648
    ns8:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Color Brightness"@en ;
    rdfs:subClassOf ns8:ont00000784 ;
    skos:altLabel "Color Intensity"@en ;
    skos:definition "An Optical Property that inheres in a bearer in virtue of its capacity to reflect or radiate light."@en .

ns8:ont00000649
    ns8:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Non-Name Identifier"@en ;
    rdfs:subClassOf ns8:ont00000686 ;
    skos:altLabel "ID"@en, "Identifier"@en ;
    skos:definition "A Designative Information Content Entity that consists of a string of characters that designates an entity within a specified namespace or context, is not a Designative Name, may be automatically or randomly generated, and typically has no preexisting cultural or social significance."@en .

ns8:ont00000650
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Ground Moving Target Indication Artifact Function"@en ;
    rdfs:subClassOf ns8:ont00000214 ;
    skos:definition "A Moving Target Indication Artifact Function that inheres in Artifacts that are designed to identify and track entities moving on or near the ground."@en .

ns8:ont00000651
    ns8:ont00001754 "http://www.dictionary.com/browse/containing" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Containing Artifact Function"@en ;
    rdfs:subClassOf ns8:ont00000323 ;
    skos:definition "An Artifact Function that is realized in a process in which one entity contains another."@en .

ns8:ont00000652
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Decoy&oldid=1058455081"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Decoy"@en ;
    rdfs:subClassOf ns8:ont00000995 ;
    skos:definition "A Material Artifact that is designed to distract or conceal what an individual or group might be looking for."@en .

ns8:ont00000653
    ns8:ont00001754 "http://purl.obolibrary.org/obo/IAO_0000064"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Algorithm"@en ;
    rdfs:subClassOf ns8:ont00000965 ;
    skos:definition "A Directive Information Content Entity that prescribes some Process and contains a finite sequence of unambiguous instructions in order to achieve some Objective."@en .

ns8:ont00000654
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Terrorism&oldid=1063471352"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Act of Terrorism"@en ;
    rdfs:subClassOf ns8:ont00001147 ;
    skos:definition "An Act of Violence which creates fear and which is prescribed by religious, political or ideological objectives, and which deliberately target or disregard the safety of civilians and are committed by members of non-government organizations."@en .

ns8:ont00000655
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Mail&oldid=1057401839"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Mailing Facility"@en ;
    rdfs:subClassOf ns8:ont00000192 ;
    skos:definition "A Facility that is designed for the systematic physical transportation of documents and packages."@en .

ns8:ont00000656
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Radiological_warfare&oldid=1060817328"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Radiological Weapon"@en ;
    rdfs:subClassOf ns8:ont00000445 ;
    skos:definition "A Weapon that is designed to inflict harm, damage, or incapacity by means of releasing radioactive material."@en .

ns8:ont00000657
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Distance Measurement Artifact Function"@en ;
    rdfs:subClassOf ns8:ont00001100 ;
    skos:definition "A Measurement Artifact Function that is realized during events in which an Artifact is used to measure the spatial Distance to a specified object or class of objects."@en .

ns8:ont00000658
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Missile Launcher"@en ;
    rdfs:subClassOf ns8:ont00001051 ;
    skos:definition "A Projectile Launcher that is designed to launch one or more Precision-Guided Missiles."@en .

ns8:ont00000659
    ns8:ont00001760 "https://www.commoncoreontologies.org/UnitsOfMeasureOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Measurement Unit of Torque"@en ;
    rdfs:subClassOf ns8:ont00000120 ;
    skos:altLabel "Measurement Unit of Moment of Force"@en, "Measurement Unit of Rotational Force"@en ;
    skos:definition "A Measurement Unit that is used as a standard for measurement of the rate of change of angular momentum of an object."@en .

ns8:ont00000660
    ns8:ont00001754 "http://wordnetweb.princeton.edu/perl/webwn?s=effect" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    owl:equivalentClass _:nimportcommonb352 ;
    rdf:type owl:Class ;
    rdfs:label "Effect"@en ;
    rdfs:subClassOf ns1:BFO_0000015 ;
    skos:altLabel "Consequence"@en ;
    skos:definition "A Process that follows and is caused by some previous Process."@en .

ns8:ont00000661
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Government&oldid=1063736308"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Government Artifact Function"@en ;
    rdfs:subClassOf ns8:ont00001301 ;
    skos:definition "A Service Artifact Function that is realized in processes in which public policy is administered and the actions of its members are directed."@en .

ns8:ont00000662
    dcterms:bibliographicCitation "Convention on Rights and Duties of States (inter-American); December 26, 1933. https://avalon.law.yale.edu/20th_century/intam03.asp. Accessed 6 Apr. 2023." ;
    dcterms:created "2023-02-06T10:14:09-05:00"@en ;
    ns8:ont00001754 "https://avalon.law.yale.edu/20th_century/intam03.asp" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI ;
    owl:equivalentClass _:nimportcommonb356 ;
    rdf:type owl:Class ;
    rdfs:label "Material Territory of a Government Domain"@en ;
    rdfs:subClassOf ns8:ont00001341 ;
    skos:definition "The portions of lithosphere, hydrosphere, or atmosphere that together exactly occupy a Government Domain"@en ;
    skos:prefLabel "Material Territory of a Government Domain"@en .

ns8:ont00000663
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Power Transmission Artifact"@en ;
    rdfs:subClassOf ns8:ont00000995 ;
    skos:definition "A Material Artifact that is designed to transfer and regulate Power flow from a Power Source to an application point."@en .

ns8:ont00000664
    ns8:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Radio Relay Station"@en ;
    rdfs:subClassOf ns8:ont00000531 ;
    skos:definition "A Communications Facility that is designed to support the receiving and re-transmitting of radio signals."@en .

ns8:ont00000665
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Cleaning Artifact Function"@en ;
    rdfs:subClassOf ns8:ont00000323 ;
    skos:definition "An Artifact Function that is realized in processes in which some Artifact is used to remove foreign objects from another object."@en .

ns8:ont00000666
    ns8:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI ;
    owl:equivalentClass _:nimportcommonb360 ;
    rdf:type owl:Class ;
    rdfs:label "Neutral Person"@en ;
    rdfs:subClassOf ns8:ont00001262 ;
    skos:altLabel "Unallied Person" ;
    skos:definition "A Person who is the bearer of some Neutral Role."@en .

ns8:ont00000667
    ns8:ont00001754 "https://en.wikipedia.org/wiki/Outpost_(military)" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Combat Outpost"@en ;
    rdfs:subClassOf ns8:ont00001052 ;
    skos:definition "A Military Facility that is designed to support the conduction of combat operations of limited scope or size."@en .

ns8:ont00000668
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Battery_terminal&oldid=1059455659"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Battery Terminal"@en ;
    rdfs:subClassOf ns8:ont00000995 ;
    skos:definition "A Material Artifact that is designed to connect a load or charger to a single or multiple-cell Battery."@en .

ns8:ont00000669
    ns8:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Distance Measurement Information Content Entity"@en ;
    rdfs:subClassOf ns8:ont00001022 ;
    skos:definition "A Ratio Measurement Information Content Entity that is a measurement of a One-Dimensional Extent inhering in some Site that is externally connected to two Independent Continuants."@en ;
    skos:scopeNote "Displacement (vector) is the shortest possible distance (scalar) between two points. Further thought is needed to adequately handle measurements of distance traveled along a path, e.g., a circuitous path or an arc (such as the surface of a planet), versus the simple case of a direct, straight line between two points."@en, "Distance is a measure between two reference points, which are located on or in, or in some manner part of, the two obejcts for which the length of the extent between is sought. For exmple, the center point of the indentation of a ball in the sand and the edge of the foul line, the forwardmost point on a car's bumper and the closest point on the 2-dimensional plane that serves as the fiat boundary of a crosswalk, the center of an antenna array and closest point on ground."@en .

ns8:ont00000670
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Port&oldid=1064091505"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Distribution Port"@en ;
    rdfs:subClassOf ns8:ont00001258 ;
    skos:definition "A Port that is designed with the cargo handling equipment necessary for the loading and unloading of Watercraft"@en .

ns8:ont00000671
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Antibiotic&oldid=1063633090"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Anti-Bacterial Artifact Function"@en ;
    rdfs:subClassOf ns8:ont00000415 ;
    skos:definition "An Anti-Microbial Artifact Function that is realized in a process which causes harm to, or the death of, some bacterium."@en .

ns8:ont00000672
    ns8:ont00001753 "SLF" ;
    ns8:ont00001754 "International Telecommunication Union (ITU)" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:comment "The corresponding Wavelength range is 10,000–1,000 km"@en ;
    rdfs:label "Super Low Frequency"@en ;
    rdfs:subClassOf ns8:ont00000150 ;
    skos:altLabel "ITU Band Number 2"@en ;
    skos:definition "A Radio Frequency that is between 30 and 300 Hz."@en .

ns8:ont00000673
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Prosthesis&oldid=1063749698"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Prosthetic Foot"@en ;
    rdfs:subClassOf ns8:ont00000715 ;
    skos:definition "A Prosthesis that is designed to replace a missing foot."@en .

ns8:ont00000674
    ns8:ont00001760 "https://www.commoncoreontologies.org/TimeOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Calendar Year"@en ;
    rdfs:subClassOf ns8:ont00000832 ;
    skos:definition "A Year that begins and ends concurrently with the Days specified by a Calendar System to be the first and last Days of the Year."@en .

ns8:ont00000675
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Sound&oldid=1050465877"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Sound Wave Process"@en ;
    rdfs:subClassOf _:nimportcommonb364, ns8:ont00001028 ;
    skos:definition "A Mechanical Wave Process of Pressure and displacement that is parallel to the propogation direction of the Wave Process through a medium."@en .

ns8:ont00000676
    ns8:ont00001754 "http://www.merriam-webster.com/dictionary/inhabit" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Act of Inhabitancy"@en ;
    rdfs:subClassOf ns8:ont00000228 ;
    skos:definition "A Planned Act in which a Person lives at a Site for a period of time that may be as short as 1 day/night or as long as the Person's entire life."@en .

ns8:ont00000677
    ns8:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Product Transport Facility"@en ;
    rdfs:subClassOf ns8:ont00000192 ;
    skos:definition "A Facility that is designed to transport some product."@en .

ns8:ont00000678
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Voltage_regulation&oldid=1045628774"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Voltage Regulating Artifact Function"@en ;
    rdfs:subClassOf ns8:ont00000098 ;
    skos:definition "An Artifact Function that is realized by processes in which some Artifact is used to cause a change in the voltage magnitude between the sending and receiving end of an electrical component."@en .

ns8:ont00000679
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Attitude Control Artifact Function"@en ;
    rdfs:subClassOf ns8:ont00000323 ;
    skos:altLabel "Orientation Control Artifact Function"@en ;
    skos:definition "An Artifact Function that is realized by an Artifact participating in an attitude control process."@en .

ns8:ont00000680
    ns8:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Medical Depot"@en ;
    rdfs:subClassOf ns8:ont00000881 ;
    skos:definition "A Storage Facility that is designed to store medical supplies."@en .

ns8:ont00000681
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Navigation_light&oldid=1034200601"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "External Navigation Lighting System"@en ;
    rdfs:subClassOf ns8:ont00000236 ;
    skos:definition "A Lighting System that is designed to be attached to some Vehicle and to emit colored light in order to signal that Vehicle's position, heading, and status."@en .

ns8:ont00000682
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Mirror&oldid=1063296474"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Mirror"@en ;
    rdfs:subClassOf ns8:ont00000136 ;
    skos:definition "An Optical Instrument that is designed to reflect light that has a wavelength within a given range and is incident on its relflecting surface such that the reflected light maintains most of the characteristics of the original light."@en .

ns8:ont00000683
    ns8:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Diminutive Name"@en ;
    rdfs:subClassOf ns8:ont00000605 ;
    skos:definition "An Abbreviated Name that is a familiar form of a Proper Name."@en ;
    skos:example "Alex, Bob, Cathy" ;
    skos:scopeNote "\"Familiar form of a Proper Name\" means: that the name is (originally) a short, affectionate version of the fuller name, used (originally) by family or friends."@en .

ns8:ont00000684
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Contract&oldid=1061365227"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Act of Contract Formation"@en ;
    rdfs:subClassOf ns8:ont00000821 ;
    skos:definition "An Act of Promising having a lawful object entered into voluntarily by two or more agents with legal capacity, each of whom intends to create one or more legal obligations between them."@en .

ns8:ont00000685
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Border&oldid=1061275162"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Government Domain Border"@en ;
    rdfs:subClassOf ns8:ont00000207 ;
    skos:definition "A Geospatial Boundary that is a boundary of some Government Domain."@en .

ns8:ont00000686
    ns8:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI ;
    owl:disjointWith ns8:ont00000853, ns8:ont00000965 ;
    owl:equivalentClass _:nimportcommonb365 ;
    rdf:type owl:Class ;
    rdfs:label "Designative Information Content Entity"@en ;
    rdfs:subClassOf ns8:ont00000958 ;
    skos:altLabel "Designative ICE"@en ;
    skos:definition "An Information Content Entity that consists of a set of symbols that denote some Entity."@en .

ns8:ont00000687
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Act of Training Acquisition"@en ;
    rdfs:subClassOf ns8:ont00000234 ;
    skos:definition "An Act of Training performed by an Agent by acquiring knowledge from another Agent."@en .

ns8:ont00000688
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Turbofan&oldid=1063724215"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Turbofan Air-Breathing Jet Engine"@en ;
    rdfs:subClassOf ns8:ont00000294 ;
    skos:definition "An Air-Breathing Jet Engine that uses a Turbofan, which consists of a Turbine and a Fan."@en .

ns8:ont00000689
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Switch&oldid=1059685800"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Switch Artifact Function"@en ;
    rdfs:subClassOf ns8:ont00000323 ;
    skos:definition "An Artifact Function that is realized in a process of breaking an electric circuit by interrupting the current or diverting it from one conductor to another."@en .

ns8:ont00000690
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Telecommunication Instrument"@en ;
    rdfs:subClassOf ns8:ont00000346 ;
    skos:definition "A Communication Instrument that is designed for use by some Agent in some Act of Communication where the recipient of that communication is potentially a significant distance away from the Agent."@en .

ns8:ont00000691
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Fuel Tank"@en ;
    rdfs:subClassOf ns8:ont00000020 ;
    skos:definition "A Container that is designed to store a Portion of Fuel."@en .

ns8:ont00000692
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Probability&oldid=1059657543"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:comment "Every probability measurement is made within a particular context given certain background assumptions."@en ;
    rdfs:label "Probability Measurement Information Content Entity"@en ;
    rdfs:subClassOf ns8:ont00001163 ;
    skos:altLabel "Likelihood Measurement"@en, "Probability Measurement"@en ;
    skos:definition "A Measurement Information Content Entity that is a measurement of the likelihood that a Process or Process Aggregate occurs."@en .

ns8:ont00000693
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Mass Specification"@en ;
    rdfs:subClassOf ns8:ont00000575 ;
    skos:definition "A Quality Specification that prescribes the Amount of Mass that a Material Entity should have."@en .

ns8:ont00000694
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Nozzle Mouth"@en ;
    rdfs:subClassOf ns8:ont00000256 ;
    skos:definition "A Fluid Control Artifact that consists of the portion of a Nozzle at the end that is designed to be where the flow of fluid exits the Nozzle."@en .

ns8:ont00000695
    ns8:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Radiolucent"@en ;
    rdfs:subClassOf ns8:ont00000620 ;
    skos:altLabel "Hypodense"@en, "Transradiance"@en ;
    skos:definition "A Radiopacity that inheres in a bearer in virtue of its capacity to permit most X-rays to pass through it."@en .

ns8:ont00000696
    ns8:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Ideology"@en ;
    rdfs:subClassOf ns8:ont00000958 ;
    skos:definition "An Information Content Entity that consists of a collection of claims about how some part of the world is or should be and which is accepted as true by an Agent or Group of Agents such that it forms the basis of their beliefs, goals, expectations, and motivations."@en .

ns8:ont00000697
    ns8:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI ;
    owl:equivalentClass _:nimportcommonb369 ;
    rdf:type owl:Class ;
    rdfs:label "Enemy Person"@en ;
    rdfs:subClassOf ns8:ont00001262 ;
    skos:definition "A Person who is the bearer of some Enemy Role."@en .

ns8:ont00000698
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=De_Laval_nozzle&oldid=1062746288"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:comment "By increasing the Exhaust Velocity of the gas, the Nozzle increases the Thrust generated."@en ;
    rdfs:label "Convergent-Divergent Nozzle"@en ;
    rdfs:subClassOf ns8:ont00000252 ;
    skos:altLabel "CD Nozzle"@en, "de Laval Nozzle"@en ;
    skos:definition "A Nozzle that consists of a tube with an asymmetric hourglass shape that is designed to accelerate hot pressurized gas by converting the heat energy of the gas flow into kinetic energy as it passes through the Nozzle Throat to generate increased Exhaust Velocity of the gas as it exits the Nozzle."@en .

ns8:ont00000699
    ns8:ont00001760 "https://www.commoncoreontologies.org/TimeOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Afternoon"@en ;
    rdfs:subClassOf ns1:BFO_0000202 ;
    skos:definition "A Temporal Interval that consists of the temporal regions between when the sun is at its apex (approximately 12:00pm) and when it sets (approximately 6:00pm)."@en .

ns8:ont00000700
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Computer_network&oldid=1061571662"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Computer Network"@en ;
    rdfs:subClassOf ns8:ont00000998 ;
    skos:altLabel "Data Network"@en ;
    skos:definition "A Telecommunication Network that is designed to allow the exchange of data between two or more computers connected to the network."@en .

ns8:ont00000701
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Wire Receiver"@en ;
    rdfs:subClassOf ns8:ont00001145 ;
    skos:definition "A Radio Receiver that uses a Wire Antenna to intercept radio signals."@en .

ns8:ont00000702
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Image&oldid=1062709732"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Image"@en ;
    rdfs:subClassOf ns8:ont00000798 ;
    skos:definition "An Information Bearing Artifact that is designed to carry an Information Content Entity that represents some entity owing to a visual isomorphism between the carrying artifact and the entity."@en .

ns8:ont00000703
    ns8:ont00001754 "http://www.thefreedictionary.com/system+clock" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "System Clock"@en ;
    rdfs:subClassOf ns8:ont00000159 ;
    skos:definition "A Timekeeping Instrument that is part of a computer an is designed to issue a steady high-frequency signal that is used to synchronize all of the computer's internal components."@en .

ns8:ont00000704
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Tunnel&oldid=1062456881"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Tunnel"@en ;
    rdfs:subClassOf ns8:ont00001326 ;
    skos:definition "A Land Transportation Artifact that is designed to enable Ground Vehicles to travel underneath a surrounding soil, earth, or rock formation."@en .

ns8:ont00000705
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Electric_power_transmission&oldid=1062551058"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Power Transmission Line"@en ;
    rdfs:subClassOf ns8:ont00000677 ;
    skos:definition "A Product Transport Facility that is designed to transmit electricity over distance via a system of above ground wires including their supports."@en .

ns8:ont00000706
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Electrical_connector&oldid=1061247409"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Terminal Board"@en ;
    rdfs:subClassOf ns8:ont00000995 ;
    skos:definition "A Material Artifact that is designed to join electrical terminations and create an electrical circuit by means of a block which connects individual wires without a splice or physically joining the ends."@en .

ns8:ont00000707
    ns8:ont00001760 "https://www.commoncoreontologies.org/UnitsOfMeasureOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Measurement Unit of Angle"@en ;
    rdfs:subClassOf ns8:ont00000120 ;
    skos:definition "A Measurement Unit that is used as a standard for measurement of the angle between two lines or planes in relation to a vertex."@en ;
    skos:example "degrees, radians" .

ns8:ont00000708
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Water_tower&oldid=1059754959"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Water Tower"@en ;
    rdfs:subClassOf ns8:ont00000881 ;
    skos:definition "A Facility that is the bearer of functions realized in processes of storing water in an elevated container."@en .

ns8:ont00000709
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Visual_prosthesis&oldid=1059269261"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Visual Prosthesis"@en ;
    rdfs:subClassOf ns8:ont00001248 ;
    skos:altLabel "Bionic Eye"@en ;
    skos:definition "An Artificial Eye that is designed to replace a missing eye, which performs the function of an eye."@en .

ns8:ont00000710
    ns8:ont00001754 "http://www.dictionary.com/browse/command-post" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Command Post Facility"@en ;
    rdfs:subClassOf ns8:ont00001052 ;
    skos:definition "A Military Facility that is designed to support the command and control of Military Operations or Forces."@en .

ns8:ont00000711
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Semi-automatic_pistol&oldid=1058568715"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Semi-automatic Pistol"@en ;
    rdfs:subClassOf ns8:ont00000156 ;
    skos:definition "A Hand Gun that has a single fixed firing chamber machined into the rear of the barrel and an ammunition magazine capable of holding multiple Cartridges such that the Hand Gun is designed to automatically reload each time it is fired and to fire a Bullet with each successive pull of the trigger until the stored ammunition is depleted."@en .

ns8:ont00000712
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Acceleration&oldid=1062249960"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Acceleration"@en ;
    rdfs:subClassOf _:nimportcommonb373, ns1:BFO_0000144 ;
    skos:definition "A Process Profile that is the rate of change of the Velocity of an object."@en .

ns8:ont00000713
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Vehicle&oldid=1063682179"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Vehicle"@en ;
    rdfs:subClassOf ns8:ont00000995 ;
    skos:definition "A Material Artifact that is designed to facilitate the movement of material entities from one location to another by conveying them there."@en .

ns8:ont00000714
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Horn_antenna&oldid=1050375403"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Horn Antenna"@en ;
    rdfs:subClassOf ns8:ont00001192 ;
    skos:altLabel "Microwave Horn"@en ;
    skos:definition "A Radio Antenna that consists of a flaring metal waveguide shaped like a horn to direct radio waves in a beam and can be used on its own or as a feeder for larger antenna structures, such as Parabolic Antennas."@en .

ns8:ont00000715
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Prosthesis&oldid=1063749698"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Prosthesis"@en ;
    rdfs:subClassOf ns8:ont00001381 ;
    skos:definition "A Medical Artifact that is designed to replace a missing body part."@en .

ns8:ont00000716
    ns8:ont00001754 "https://en.wikipedia.org/wiki/Battery_(electricity)" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Electric Battery"@en ;
    rdfs:subClassOf ns8:ont00001049 ;
    skos:altLabel "Battery"@en ;
    skos:definition "An Electrical Power Source that is designed to produce electric power by converting chemical energy to electrical energy."@en .

ns8:ont00000717
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Fossil_fuel&oldid=1062298144"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Fossil Fuel Power Plant"@en ;
    rdfs:subClassOf ns8:ont00001076 ;
    skos:definition "An Electric Power Station that is designed to convert fossil fuels (e.g. coal, natural gas, or petroleum) into electrical energy."@en .

ns8:ont00000718
    ns8:ont00001754 "http://www.merriam-webster.com/dictionary/village" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Village"@en ;
    rdfs:subClassOf ns8:ont00000460 ;
    skos:definition "A Local Administrative Region in which a human population permanently resides that is typically larger than the population of a hamlet but smaller than that of a Town."@en .

ns8:ont00000719
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Counterfeit&oldid=1063493600"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Counterfeit Instrument"@en ;
    rdfs:subClassOf ns8:ont00000995 ;
    skos:definition "A Material Artifact that is designed to be a fake replica of some genuine Artifact."@en .

ns8:ont00000720
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Cryogenic_storage_dewar&oldid=1021282649"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Cryogenic Storage Dewar"@en ;
    rdfs:subClassOf ns8:ont00000020 ;
    skos:definition "A Container that is designed to store a Portion of Cryogenic Material (such as liquid helium or liquid oxygen) and which consists of, minimally, walls that are constructed from two or more layers that are separated by a high vacuum to provide thermal insulation between the interior and exterior of the dewar."@en .

ns8:ont00000721
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Polarizing Prism"@en ;
    rdfs:subClassOf ns8:ont00000804 ;
    skos:definition "A Prism designed to split a beam of light entering the Prism into components of varying polarization."@en .

ns8:ont00000722
    ns8:ont00001760 "https://www.commoncoreontologies.org/GeospatialOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Sea Level"@en ;
    rdfs:subClassOf ns1:BFO_0000146 ;
    skos:definition "A Fiat Surface that divides the spheroid composed of Earth and its atmosphere at some point that corresponds to the mean level of calm water in the Earth’s oceans."@en .

ns8:ont00000723
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Vehicle Control System"@en ;
    rdfs:subClassOf ns8:ont00000781 ;
    skos:definition "A Control System that is designed to enable some Agent to control some Vehicle."@en .

ns8:ont00000724
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Parabolic_antenna&oldid=1057213241"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Parabolic Antenna"@en ;
    rdfs:subClassOf ns8:ont00001192 ;
    skos:altLabel "Dish Antenna"@en, "Parabolic Dish"@en ;
    skos:definition "A Radio Antenna that uses a parabolic reflector to direct or receive radio waves and has a very high gain."@en .

ns8:ont00000725
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Wedding&oldid=1063857279"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Wedding"@en ;
    rdfs:subClassOf ns8:ont00000455 ;
    skos:altLabel "Act of Wedding Ceremony"@en ;
    skos:definition "An Act of Ceremony in which two Persons are united in Marriage or a similar institution."@en .

ns8:ont00000726
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Decrease of Dependent Continuant"@en ;
    rdfs:subClassOf ns8:ont00000004 ;
    skos:definition "A Change in which some Independent Continuant has a decrease in the level of some Dependent Continuant that it bears."@en .

ns8:ont00000727
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Communication Artifact Function"@en ;
    rdfs:subClassOf ns8:ont00000323 ;
    skos:definition "An Artifact Function that is realized in a process in which meaningful signs are conveyed from one entity to another."@en .

ns8:ont00000728
    ns8:ont00001754 "http://kp12m.as.arizona.edu/docs/what_is_submillimeter.htm, https://en.wikipedia.org/wiki/Submillimetre_astronomy" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:comment "The submillimeter waveband is between the far-infrared and microwave wavebands and is typically taken to have a wavelength of between a few hundred micrometers and a millimeter."@en ;
    rdfs:label "Submillimeter Wavelength Radio Telescope"@en ;
    rdfs:subClassOf ns8:ont00000215 ;
    skos:altLabel "Microwave Telescope"@en ;
    skos:definition "A Radio Telescope that is designed to aid in the observation of spatially distant Objects by means of collecting and focusing radio waves from the submillimeter waveband (i.e. microwaves) to form an enhanced image of the Object."@en .

ns8:ont00000729
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Spherical_coordinate_system&oldid=1061029174"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Spherical Coordinate System"@en ;
    rdfs:subClassOf ns8:ont00000275 ;
    skos:definition "A Spatial Reference System for three-dimensional spatial regions that identifies each point using an ordered triple of numerical coordinates that consist of the radial distance of the point of interest from a fixed origin, its polar angle measured from a fixed zenith direction, and the azimuth angle of its orthogonal projection measured from a fixed direction on a reference plane that passes through the origin and is orthogonal to the zenith."@en .

ns8:ont00000730
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Power_transfer_unit&oldid=1002682083"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Hydraulic Power Transfer Unit"@en ;
    rdfs:subClassOf ns8:ont00000995 ;
    skos:definition "A Material Artifact that is designed to transfer hydraulic power from one of an Aircraft's hydraulic systems to another in the event that a system has failed or been turned off."@en .

ns8:ont00000731
    ns8:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:comment "'Deviation Measurement Information Content Entity' and 'Veracity Measurement Information Content Entity' are complementary notions. Deviation is a measure of whether reality conforms to an ICE (e.g., a plan or prediction), whereas Veracity is a measure of whether a Descriptive ICE conforms to reality."@en, "Note, the term 'accuracy' is avoided due to its ambiguity between: correctness-of-performance (see: 'Reliability Measurement Information Content Entity'), correctness-of-information (see: 'Veracity Measurement Information Content Entity'), and adherance-to-expectations ('Deviation Measurement Information Content Entity')."@en ;
    rdfs:label "Deviation Measurement Information Content Entity"@en ;
    rdfs:subClassOf ns8:ont00001163 ;
    skos:altLabel "Conformance Measurement"@en, "Degree of Conformance"@en, "Degree of Deviation"@en, "Deviation Measurement"@en ;
    skos:definition "A Measurement Information Content Entity that is a measurement of the extent to which an entity conforms to how it is expected or supposed to be."@en ;
    skos:example "a missile impact deviates from its target location by 100 feet", "a satellite deviaties from its predicted orbital path by 5 kilometers", "an overweight piece of luggage deviates from an airline's maximum allowed weight by +10 pounds" ;
    skos:scopeNote "In order for a Deviation to exist, an entity must first be expected, represented, prescribed, or predicted as being a certain way. Then, at a future time, this value can be compared to its actual, reported, or measured value to determine the Deviation between these values."@en .

ns8:ont00000732
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Microwave&oldid=1062124842"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:comment "The corresponding Wavelength range is 1,000–1 mm"@en ;
    rdfs:label "Microwave Frequency"@en ;
    rdfs:subClassOf ns8:ont00000150 ;
    skos:definition "A Radio Frequency that is between 300 MHz and 300 GHz."@en .

ns8:ont00000733
    ns8:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Spherical"@en ;
    rdfs:subClassOf ns8:ont00001360 ;
    skos:definition "A Three Dimensional Shape inhering in a bearer in virtue of all of its cross sections being round."@en .

ns8:ont00000734
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Land_mine&oldid=1060289159"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Land Mine"@en ;
    rdfs:subClassOf ns8:ont00000552 ;
    skos:definition "An Explosive Weapon that is designed to be concealed under or on the ground and to detonate as its target passes over or near it."@en .

ns8:ont00000735
    ns8:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Geospatial Region Bounding Box Identifier List"@en ;
    rdfs:subClassOf ns8:ont00000406 ;
    skos:definition "A Measurement Unit of Geocoordinate that is comprised of 4 pairs of coordinates, one for each of the 4 defining points (North, West, South, East) of a Geospatial Region Bounding Box."@en .

ns8:ont00000736
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Transducer&oldid=1053290948"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Transducer"@en ;
    rdfs:subClassOf ns8:ont00000995 ;
    skos:definition "A Material Artifact that is designed to convert one form of energy to another."@en .

ns8:ont00000737
    ns8:ont00001753 "FOB" ;
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Forward_operating_base&oldid=1059263624"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Forward Operations Base"@en ;
    rdfs:subClassOf ns8:ont00000483 ;
    skos:altLabel "Forward Operating Base"@en ;
    skos:definition "A Military Base that is located relatively close to an offensive Area of Operations, is supported by the Base of Operations, and is designed to support local strategic objectives and tactical operations."@en .

ns8:ont00000738
    ns8:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Length"@en ;
    rdfs:subClassOf ns8:ont00001367 ;
    skos:definition "A One Dimensional Extent that inheres in a bearer in virtue of the bearer's greatest extent in one direction."@en .

ns8:ont00000739
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Act of Sojourn"@en ;
    rdfs:subClassOf ns8:ont00000676 ;
    skos:definition "An Act of Inhabitancy in which a Person lives in a dwelling temporarily, often during stages of an Act of Travel."@en .

ns8:ont00000740
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:comment "This class is designed to group continuants according to a very broad criterion and is not intended to be used as a parent class for entities that can be more specifically represented under another class. Hence, Natural Resource may be an appropriate subtype but Money, Oil, and Gold Mine are not."@en ;
    rdfs:label "Resource"@en ;
    rdfs:subClassOf ns1:BFO_0000002 ;
    skos:definition "A Continuant that is owned by, in the possession of, or is otherwise controlled by an Agent such that it could be used by that Agent."@en ;
    skos:example "a group of interns", "a knowledge base", "a plot of land", "a software program", "a sum of money", "a vehicle" ;
    skos:scopeNote "Resources are Resources for some Agent. If no instance of Agent existed, no instance of Resource would exist either. It is not a requirement that something be valuable in order for it to be a Resource. Thus the value of something can drastically change without altering whether that thing is a Resource."@en .

ns8:ont00000741
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Act of Targeting"@en ;
    rdfs:subClassOf ns8:ont00000228 ;
    skos:definition "A Planned Act wherein some Agent maintains one or more entities as the objects of potential action given some operational requirement."@en .

ns8:ont00000742
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Ignition System"@en ;
    rdfs:subClassOf ns8:ont00000995 ;
    skos:definition "A Material Artifact that is designed to produce an Ignition process."@en .

ns8:ont00000743
    ns8:ont00001754 "Adapted from “Chart.” Merriam-Webster.com Dictionary, Merriam-Webster, https://www.merriam-webster.com/dictionary/chart. Accessed 4 Aug. 2024." ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Chart"@en ;
    rdfs:subClassOf ns8:ont00000702 ;
    skos:definition "An Image that is designed to carry some Representational Information Content Entity that is prescribed by some canonical visual format."@en .

ns8:ont00000744
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Act of Social Group Membership"@en ;
    rdfs:subClassOf ns8:ont00000433 ;
    skos:definition "An Act of Association wherein a Person belongs to some Social Group."@en .

ns8:ont00000745
    ns8:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Point Estimate Information Content Entity"@en ;
    rdfs:subClassOf ns8:ont00001176 ;
    skos:altLabel "Best Estimate"@en, "Point Estimate Measurement Information Content Entity"@en, "Point Estimate"@en ;
    skos:definition "An Estimate Information Content Entity that consists of a single value for the measured entity."@en .

ns8:ont00000746
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Combustion Engine"@en ;
    rdfs:subClassOf ns8:ont00000638 ;
    skos:definition "A Heat Engine that is designed to convert thermal energy that is generated through a local Combustion process into mechanical energy."@en .

ns8:ont00000747
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Canal&oldid=1059514223" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Canal"@en ;
    rdfs:subClassOf ns8:ont00000549 ;
    skos:definition "A Water Transportation Artifact that is an artificial Hydrographic Feature designed to convey water or enable Watercraft to travel inland."@en .

ns8:ont00000748
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Bullet&oldid=1062391591"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Bullet"@en ;
    rdfs:subClassOf ns8:ont00001150 ;
    skos:definition "A Portion of Ammunition that is designed to be projected by a Firearm, Sling, Slingshot, or Air Gun, but which does not (typically) contain explosives."@en .

ns8:ont00000749
    ns8:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Julian Day Number"@en ;
    rdfs:subClassOf _:nimportcommonb374, ns8:ont00000894 ;
    skos:definition "A Decimal Date Identifier that designates some Julian Day by using a number to indicate the sequential ordering of the Day since the Julian Date epoch."@en .

ns8:ont00000750
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Text_messaging&oldid=1062261405"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Text Messaging"@en ;
    rdfs:subClassOf ns8:ont00000517 ;
    skos:altLabel "Act of Text Messaging"@en, "Act of Texting"@en ;
    skos:definition "An Act of Communication by Media involving the exchange of brief written messages between fixed-line phone or mobile phone and fixed or portable devices over a network."@en .

ns8:ont00000751
    ns8:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI ;
    owl:equivalentClass _:nimportcommonb375 ;
    rdf:type owl:Class ;
    rdfs:label "Action Permission"@en ;
    rdfs:subClassOf ns8:ont00001324 ;
    skos:altLabel "Authorization"@en, "License"@en ;
    skos:definition "A Process Regulation that permits some Process."@en .

ns8:ont00000752
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    owl:equivalentClass _:nimportcommonb379 ;
    rdf:type owl:Class ;
    rdfs:comment "This is a defined class used to group process profiles of Wave Processes. Note that not every relevant process profile can be asserted as a subtype, however, because they (e.g. Frequency and Amplitude) are applicable to other processes as well (e.g. Oscillation Process)."@en ;
    rdfs:label "Wave Process Profile"@en ;
    rdfs:subClassOf ns1:BFO_0000144 ;
    skos:definition "A Process Profile of a Wave Process."@en .

ns8:ont00000753
    ns8:ont00001753 "ULF" ;
    ns8:ont00001754 "International Telecommunication Union (ITU)" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:comment "The corresponding Wavelength range is 1,000–100 km"@en ;
    rdfs:label "Ultra Low Frequency"@en ;
    rdfs:subClassOf ns8:ont00000150 ;
    skos:altLabel "ITU Band Number 3"@en ;
    skos:definition "A Radio Frequency that is between 300 Hz and 3 kHz."@en .

ns8:ont00000754
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Electromagnetic_spectrum&oldid=1063851392"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:comment "Divisions between EM radiation frequencies are fiat and sources vary on where to draw boundaries."@en ;
    rdfs:label "Electromagnetic Radiation Frequency"@en ;
    rdfs:subClassOf ns8:ont00001047 ;
    skos:definition "A Frequency that is characterized by the rate of Oscillations per second of an Electromagnetic Wave."@en .

ns8:ont00000755
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Zenith&oldid=1052625030"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/GeospatialOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Zenith"@en ;
    rdfs:subClassOf ns1:BFO_0000026 ;
    skos:definition "A One-Dimensional Spatial Region that extends from a given location upward along the local vertical direction pointing in the direction opposite the apparent Gravitational Force at that location."@en .

ns8:ont00000756
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Database&oldid=1057024641"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Database"@en ;
    rdfs:subClassOf ns8:ont00000798 ;
    skos:definition "An Information Bearing Artifact that is designed to bear some set of specific Information Content Entities and to be rapidly searchable and retrievable."@en .

ns8:ont00000757
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Synagogue&oldid=1063773298"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Synagogue"@en ;
    rdfs:subClassOf ns8:ont00000052 ;
    skos:definition "A Religious Facility that is designed for Judaic worship and prayer."@en .

ns8:ont00000758
    ns8:ont00001754 "ISO/IEC. 1998. Information Technology ― System and Software Integrity Levels Geneva, Switzerland: International Organization for Standardization (ISO)/International Electrotechnical Commission (IEC). ISO/IEC. 15026:1998. : 3.1"@en ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Component Role"@en ;
    rdfs:subClassOf ns1:BFO_0000023 ;
    skos:definition "A Role that inheres in an entity having a discrete structure in virtue of that entity being part of a system considered at a particular level of analysis."@en .

ns8:ont00000759
    ns8:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Color Saturation"@en ;
    rdfs:subClassOf ns8:ont00000784 ;
    skos:definition "An Optical Property that inheres in a bearer in virtue of its capacity to reflect high intensity light distributed across fewer wavelengths, typically considered on a continuum of purity."@en .

ns8:ont00000760
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Surface Wave Profile"@en ;
    rdfs:subClassOf ns8:ont00000752 ;
    skos:altLabel "Surface Wave"@en ;
    skos:definition "A Wave Process Profile in which the Wave Process propogates along the surface of a medium and which involves both transverse and longitudinal wave profiles such that the motion of the displacement of participating particles is circular or elliptical."@en ;
    skos:example "the motion of an ocean wave" .

ns8:ont00000761
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Pier&oldid=1057802753"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Pier"@en ;
    rdfs:subClassOf ns8:ont00000226 ;
    skos:definition "A Transportation Facility that is designed to partially enclose a harbor and form a landing place for Watercraft."@en .

ns8:ont00000762
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Fungicide&oldid=1056769271"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Fungicide Artifact Function"@en ;
    rdfs:subClassOf ns8:ont00000415 ;
    skos:definition "An Anti-Microbial Artifact Function that is realized in a process which causes harm to, or the death of, some fungus or fungal spore."@en .

ns8:ont00000763
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Velocity&oldid=1063300750"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Velocity"@en ;
    rdfs:subClassOf ns1:BFO_0000144 ;
    skos:definition "A Process Profile of an object's Motion that is characterized by its Speed and direction with respect to a frame of reference."@en .

ns8:ont00000764
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Optical Focusing Artifact Function"@en ;
    rdfs:subClassOf ns8:ont00000504 ;
    skos:definition "An Optical Processing Artifact Function that is realized by an Artifact participating in a light focusing event in which the Artifact causes the light beam to converge on a target spatial point."@en .

ns8:ont00000765
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Wave Production"@en ;
    rdfs:subClassOf ns8:ont00000007 ;
    skos:altLabel "Wave Production Process"@en ;
    skos:definition "A Natural Process in which a Wave Process is generated."@en .

ns8:ont00000766
    ns8:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Hardness"@en ;
    rdfs:subClassOf ns1:BFO_0000019 ;
    skos:definition "A Quality that inheres in a bearer in virtue of the degree to which it can be turned, bowed, or twisted without breaking."@en .

ns8:ont00000767
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:comment "A Lubrication System typical consists of a reservoir, pump, heat exchanger, filter, regulator, valves, sensors, pipes, and hoses. In some cases it also includes the passageways and openings within the artifact it is designed to lubricate. For example, the oil holes in a bearing and crankshaft."@en ;
    rdfs:label "Lubrication System"@en ;
    rdfs:subClassOf ns8:ont00000995 ;
    skos:definition "A Material Artifact that is designed to contain, transfer, and regulate the flow of lubricant to multiple locations in an Artifact."@en .

ns8:ont00000768
    ns8:ont00001754 "http://en.wiktionary.org/wiki/amount" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Amount"@en ;
    rdfs:subClassOf ns1:BFO_0000019 ;
    skos:definition "A Quality that inheres in a bearer in virtue of the total, aggregate or sum of a number of discrete items or material the entity contains as parts."@en .

ns8:ont00000769
    ns8:ont00001754 "http://www.merriam-webster.com/dictionary/request" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Act of Requesting"@en ;
    rdfs:subClassOf ns8:ont00000133 ;
    skos:definition "An Act of Directive Communication performed by asking for something."@en .

ns8:ont00000770
    ns8:ont00001760 "https://www.commoncoreontologies.org/UnitsOfMeasureOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Measurement Unit of Density"@en ;
    rdfs:subClassOf ns8:ont00000120 ;
    skos:definition "A Measurement Unit that is used as a standard for measurement of the mass of an object per unit of its total volume."@en .

ns8:ont00000771
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Imaging Instrument"@en ;
    rdfs:subClassOf ns8:ont00000995 ;
    skos:definition "A Material Artifact that is designed to produce images (visual representations) of an entity."@en .

ns8:ont00000772
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:comment "An Impulse changes the Momentum (and potentially also the direction of Motion) of the object it is applied to and is typically measured in Newton meters."@en ;
    rdfs:label "Impulsive Force"@en ;
    rdfs:subClassOf ns1:BFO_0000144 ;
    skos:altLabel "Imp"@en, "Impulse"@en, "J"@en ;
    skos:definition "A Process Profile that is the integral of a Force that is applied to a portion of matter over a period of time."@en .

ns8:ont00000773
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Curvilinear Motion"@en ;
    rdfs:subClassOf ns8:ont00000789 ;
    skos:altLabel "Curved Motion"@en ;
    skos:definition "A Translational Motion process in which an Object moves along a curved path."@en .

ns8:ont00000774
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Video Camera"@en ;
    rdfs:subClassOf ns8:ont00000199 ;
    skos:definition "A Camera that is designed to form and digitally or physically record a continuous stream of subsequent images of an entity or scene such that the images can be played back in succession as a video."@en .

ns8:ont00000775
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Locomotive&oldid=1062802629"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Locomotive"@en ;
    rdfs:subClassOf ns8:ont00000796 ;
    skos:definition "A Rail Transport Vehicle that is designed to provide the motive power for a Train."@en .

ns8:ont00000776
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Detection_theory&oldid=1049765804"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Signal Detection Artifact Function"@en ;
    rdfs:subClassOf ns8:ont00000323 ;
    skos:definition "An Artifact Function that is realized in the process of discerning between information-bearing patterns and random patterns, or noise, that distract from the information."@en .

ns8:ont00000777
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Hydraulic_motor&oldid=1027427666"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Hydraulic Motor"@en ;
    rdfs:subClassOf ns8:ont00001221 ;
    skos:definition "A Physically Powered Engine that converts hydraulic pressure and flow into torque and angular displacement."@en .

ns8:ont00000778
    ns8:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Chemical Depot"@en ;
    rdfs:subClassOf ns8:ont00000881 ;
    skos:definition "A Storage Facility that is designed to store chemicals."@en .

ns8:ont00000779
    ns8:ont00001754 "https://oceanservice.noaa.gov/facts/cryosphere.html (accessed 03/06/2023)"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/GeospatialOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Portion of Cryosphere"@en ;
    rdfs:subClassOf ns1:BFO_0000024 ;
    skos:definition "A fiat object part of the frozen part of a natural satellite's hydosphere"@en .

ns8:ont00000780
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Ethnic_group&oldid=1063804490"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Ethnicity"@en ;
    rdfs:subClassOf ns1:BFO_0000019 ;
    skos:definition "A Quality that inheres in its bearers by virtue of a common heritage, often consisting of a common language, a common culture (often including a shared religion) and an ideology that stresses common ancestry or endogamy."@en .

ns8:ont00000781
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Control_system&oldid=1061817176"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Control System"@en ;
    rdfs:subClassOf ns8:ont00000995 ;
    skos:definition "A Material Artifact that is designed to manage, command, direct, or regulate the behavior of at least one other Artifact."@en .

ns8:ont00000782
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Factory&oldid=1064125324"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Factory"@en ;
    rdfs:subClassOf ns8:ont00000192 ;
    skos:definition "A Facility that is designed for manufacturing or refining material products."@en .

ns8:ont00000783
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Stasis of Non-Mission Capable Maintenance"@en ;
    rdfs:subClassOf _:nimportcommonb383, ns8:ont00000557 ;
    skos:definition "A Stasis of Non-Mission Capable during which the participating Continuant is not capable of performing its primary functions for the specified Mission due to participating in an Act Of Maintenance."@en .

ns8:ont00000784
    ns8:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Optical Property"@en ;
    rdfs:subClassOf ns8:ont00000628 ;
    skos:definition "An Electromagnetic Radiation Property that is realized when its bearer interacts with electromagnetic waves within the visible light spectrum."@en .

ns8:ont00000785
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Repeater&oldid=1040047439"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Radio Repeater"@en ;
    rdfs:subClassOf ns8:ont00001320 ;
    skos:definition "A Radio Transceiver that is designed to receive a radio signal, amplify it, and retransmit it (often on another frequency)."@en .

ns8:ont00000786
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Increase of Role"@en ;
    rdfs:subClassOf ns8:ont00000611 ;
    skos:definition "An Increase of Realizable Entity in which some Independent Continuant has an increase of some Role that it bears."@en .

ns8:ont00000787
    ns8:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Altitude"@en ;
    rdfs:subClassOf ns8:ont00000967 ;
    skos:definition "A Height that inheres in a Site that externally connects an Independent Continuant to either the surface of the Earth or the Earth's mean Sea Level."@en .

ns8:ont00000788
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Steam_turbine&oldid=1060224962"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Turbine Steam Engine"@en ;
    rdfs:subClassOf ns8:ont00000634 ;
    skos:altLabel "Steam Turbine"@en ;
    skos:definition "A Steam Engine that is designed to extract thermal energy from pressurized steam and use it to do mechanical work on a rotating output shaft."@en .

ns8:ont00000789
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Translational Motion"@en ;
    rdfs:subClassOf _:nimportcommonb384, ns8:ont00001133 ;
    skos:definition "A Motion Process in which the participating Object changes its position from one portion of space to another."@en .

ns8:ont00000790
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Direct Current Power Source"@en ;
    rdfs:subClassOf ns8:ont00001049 ;
    skos:definition "An Electrical Power Source that is designed to transfer electrical power in the form of direct current."@en .

ns8:ont00000791
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Chemical_reaction&oldid=1063262412"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Chemical Reaction Artifact Function"@en ;
    rdfs:subClassOf ns8:ont00000323 ;
    skos:definition "An Artifact Function that is realized in a process that leads to the transformation of one set of chemical substances to another."@en .

ns8:ont00000792
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Catadioptric_system&oldid=1017210114"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Catadioptric Optical Telescope"@en ;
    rdfs:subClassOf ns8:ont00001009 ;
    skos:altLabel "Catadioptric Telescope"@en ;
    skos:definition "An Optical Telescope that is designed to aid in the observation of spatially distant Objects by means of collecting and focusing visible light through the use of a combination of Lenses and Mirrors to form an enhanced image of the Object."@en .

ns8:ont00000793
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Aircraft_fuel_system&oldid=1003132173"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Fuel Ventilation System"@en ;
    rdfs:subClassOf ns8:ont00000256 ;
    skos:definition "A Fluid Control Artifact that is designed to allow air into the Fuel Tank to take the place of burned fuel."@en .

ns8:ont00000794
    ns8:ont00001760 "https://www.commoncoreontologies.org/GeospatialOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Geospatial Ellipse"@en ;
    rdfs:subClassOf ns8:ont00000207 ;
    skos:definition "A One-Dimensional Geospatial Boundary that is formed by following a symmetric arc between four vertices which are connected to the center point of the ellipse via a straight line."@en .

ns8:ont00000795
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Electrical Conduction Artifact Function"@en ;
    rdfs:subClassOf ns8:ont00000098 ;
    skos:definition "An Electrical Artifact Function that is realized by an Artifact being used to conduct an electric current."@en .

ns8:ont00000796
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Rail_transport&oldid=1063793805"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Rail Transport Vehicle"@en ;
    rdfs:subClassOf ns8:ont00000618 ;
    skos:definition "A Ground Vehicle that is designed to convey cargo, passengers, or equipment by Railway."@en .

ns8:ont00000797
    ns8:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Hazel"@en ;
    rdfs:subClassOf ns8:ont00000378 ;
    skos:definition "A Color that is a combination of Brown and Green, typically associated with eye color."@en .

ns8:ont00000798
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Information Bearing Artifact"@en ;
    rdfs:subClassOf _:nimportcommonb385, _:nimportcommonb386, ns8:ont00000995 ;
    skos:definition "A Material Artifact that carries an Information Content Entity and is designed to do so using a particular format or structure."@en .

ns8:ont00000799
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=List_(abstract_data_type)&oldid=1041588680"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "List"@en ;
    rdfs:subClassOf ns8:ont00000798 ;
    skos:definition "An Information Bearing Artifact that consists of one or more Information Bearing Artifacts that carry Information Content Entities and are the subjects of some Sequence Position Ordinality."@en .

ns8:ont00000800
    ns8:ont00001754 "http://wordnetweb.princeton.edu/perl/webwn?s=day" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/TimeOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Day"@en ;
    rdfs:subClassOf _:nimportcommonb387, ns1:BFO_0000202 ;
    skos:definition "A Temporal Interval that is equal to the approximate length of time required for an Astronomical Body to complete one rotation around its Rotational Axis as specified relative to a particular Temporal Reference System."@en ;
    skos:scopeNote "Unless otherwise specified, a Day is assumed to be relative to the rotational motion of the Earth and is approximately equal to a twenty-four hour temporal region for which the start and end times are specified by the Temporal Reference System used."@en .

ns8:ont00000801
    ns8:ont00001760 "https://www.commoncoreontologies.org/GeospatialOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "y-Axis"@en ;
    rdfs:subClassOf ns8:ont00000161 ;
    skos:definition "A Coordinate System Axis designated by the variable 'y'."@en .

ns8:ont00000802
    ns8:ont00001754 "https://en.wikipedia.org/wiki/Stage_(theatre)" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Stage"@en ;
    rdfs:subClassOf ns8:ont00000641 ;
    skos:definition "An Entertainment Facility that is designed to provide a space upon which entertaining performances or productions can occur."@en .

ns8:ont00000803
    ns8:ont00001754 "http://www.merriam-webster.com/dictionary/round" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Round"@en ;
    rdfs:subClassOf ns8:ont00001059 ;
    skos:altLabel "Circular"@en ;
    skos:definition "A Shape Quality that inheres in a bearer in virtue of every point along its circumference being equidistant from the center."@en .

ns8:ont00000804
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Prism&oldid=1060221124"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Prism"@en ;
    rdfs:subClassOf ns8:ont00000136 ;
    skos:definition "An Optical Instrument that is designed to refract light and which consists of a transparent material with flat polished surfaces where at least two of these surfaces have an angle between them."@en .

ns8:ont00000805
    ns8:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Coiled"@en ;
    rdfs:subClassOf ns8:ont00001059 ;
    skos:definition "A Shape Quality inhering in a bearer in virtue of the bearer being wound in concentric rings or spirals."@en .

ns8:ont00000806
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Power_tool&oldid=1057147715"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Power Tool"@en ;
    rdfs:subClassOf ns8:ont00000581 ;
    skos:definition "A Tool that is designed to be actuated by a Power Source and mechanism other than or in addition to manual labor."@en .

ns8:ont00000807
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Compression Ignition Engine"@en ;
    rdfs:subClassOf ns8:ont00000394 ;
    skos:definition "An Internal Combustion Engine that is designed to operate by igniting a portion of Fuel and Oxidizer mixture using heat generated via compression of the mixture."@en .

ns8:ont00000808
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Reagent&oldid=1017651471"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Reactant Artifact Function"@en ;
    rdfs:subClassOf ns8:ont00000791 ;
    skos:definition "A Chemical Reaction Artifact Function that is realized in a process in which a substance or compound is added to a system in order to bring about a chemical reaction and is consumed in the course of the reaction."@en .

ns8:ont00000809
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Submersible&oldid=1062994844"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Submersible Artifact Function"@en ;
    rdfs:subClassOf ns8:ont00000323 ;
    skos:definition "An Artifact Function that is realized in processes of operating while submerged in water."@en .

ns8:ont00000810
    ns8:ont00001760 "https://www.commoncoreontologies.org/TimeOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:comment "This is a defined class."@en ;
    rdfs:label "Multi-Week Temporal Interval"@en ;
    rdfs:subClassOf _:nimportcommonb388, ns1:BFO_0000038 ;
    skos:definition "A one-dimensional temporal region that is measured in Weeks and spans at least one Week."@en .

ns8:ont00000811
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Radio Wave Conversion Artifact Function"@en ;
    rdfs:subClassOf ns8:ont00000323 ;
    skos:definition "An Artifact Function that is realized by an Artifact being used to convert electric power into radio waves or radio waves into electric power."@en .

ns8:ont00000812
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Electromagnetic_pulse&oldid=1060859738"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Electromagnetic Pulse"@en ;
    rdfs:subClassOf ns8:ont00000951 ;
    skos:altLabel "EMP"@en, "Transient Electromagnetic Disturbance"@en ;
    skos:definition "An Electromagnetic Wave Process that consists of a short high-energy burst of electromagnetic energy."@en .

ns8:ont00000813
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Portion of Nuclear Fuel"@en ;
    rdfs:subClassOf ns8:ont00000457 ;
    skos:definition "A Portion of Material that is designed to be used in a nuclear fission process to produce energy."@en .

ns8:ont00000814
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Water_treatment&oldid=1061706931"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Water Treatment Facility"@en ;
    rdfs:subClassOf ns8:ont00000192 ;
    skos:definition "A Facility that is designed for making water more acceptable for a specific end-use."@en .

ns8:ont00000815
    ns8:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Folded"@en ;
    rdfs:subClassOf ns8:ont00001059 ;
    skos:definition "A Shape Quality inhering in a bearer in virtue of one part of the bearer being layered over another connected part."@en .

ns8:ont00000816
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Portion of Liquid Nitrogen"@en ;
    rdfs:subClassOf ns8:ont00000255 ;
    skos:definition "A Portion of Cryogenic Material that is composed (almost) entirely of liquid nitrogen."@en .

ns8:ont00000817
    ns8:ont00001760 "https://www.commoncoreontologies.org/GeospatialOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Geospatial Line String"@en ;
    rdfs:subClassOf ns8:ont00000207 ;
    skos:definition "A One-Dimensional Geospatial Boundary that has two or more Geospatial Positions as vertices, where each vertex is connected to only one other vertex by a straight line."@en .

ns8:ont00000818
    ns8:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Orange"@en ;
    rdfs:subClassOf ns8:ont00000378 ;
    skos:definition "A Color that is between Red and Yellow with a wavelength in the visible spectrum typically between 590 to 635 nanometers."@en .

ns8:ont00000819
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Stasis"@en ;
    rdfs:subClassOf ns1:BFO_0000015 ;
    skos:definition "A Process in which one or more Independent Continuants endure in an unchanging condition."@en .

ns8:ont00000820
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Stasis of Function"@en ;
    rdfs:subClassOf ns8:ont00000246 ;
    skos:definition "A Stasis of Realizable Entity in which some Independent Continuant bears some Function that remains unchanged during a Temporal Interval."@en .

ns8:ont00000821
    ns8:ont00001754 "http://www.merriam-webster.com/dictionary/promise" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Act of Promising"@en ;
    rdfs:subClassOf ns8:ont00001162 ;
    skos:definition "An Act of Commissive Communication performed by declaring that the promising agent will do, or refrain from doing, the specified action."@en .

ns8:ont00000822
    ns8:ont00001753 "VLF" ;
    ns8:ont00001754 "International Telecommunication Union (ITU)" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:comment "The corresponding Wavelength range is 100–10 km"@en ;
    rdfs:label "Very Low Frequency"@en ;
    rdfs:subClassOf ns8:ont00000150 ;
    skos:altLabel "ITU Band Number 4"@en ;
    skos:definition "A Radio Frequency that is between 3 and 30 kHz."@en .

ns8:ont00000823
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Telecommunications&oldid=1061143810"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Optical Communication Artifact Function"@en ;
    rdfs:subClassOf ns8:ont00001148 ;
    skos:definition "An Electromagnetic Communication Artifact Function that is realized in a process that conveys meaningful signs by means of visible light."@en .

ns8:ont00000824
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Stasis of Role"@en ;
    rdfs:subClassOf ns8:ont00000246 ;
    skos:definition "A Stasis of Realizable Entity in which some Independent Continuant bears some Role that remains unchanged during a Temporal Interval."@en .

ns8:ont00000825
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Telecommunications_link&oldid=1062252217"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Telecommunication Network Line"@en ;
    rdfs:subClassOf ns8:ont00000346 ;
    skos:definition "A Communication Artifact that is designed to be the physical transmission medium that connects two or more Telecommunication Network Nodes within a Telecommunication Network to facilitate communication between the Nodes."@en .

ns8:ont00000826
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Refractive_index&oldid=1062519140"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Refractivity"@en ;
    rdfs:subClassOf ns8:ont00001137 ;
    skos:definition "A Radiation Reflectivity that inheres in a bearer in virtue of the capacity of that bearer to change the direction of a propagating wave when passing through it."@en .

ns8:ont00000827
    ns8:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI ;
    owl:equivalentClass _:nimportcommonb389 ;
    rdf:type owl:Class ;
    rdfs:label "Time of Day Identifier"@en ;
    rdfs:subClassOf ns8:ont00000540 ;
    skos:definition "A Temporal Instant Identifier that designates some Time of Day."@en .

ns8:ont00000828
    ns8:ont00001754 "http://www.dictionary.com/browse/pesticide" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Pesticide Artifact Function"@en ;
    rdfs:subClassOf ns8:ont00001123 ;
    skos:definition "A Poison Artifact Function that is realized in a process which causes illness in, or the death of, a living thing that is detrimental to humans or human concerns."@en .

ns8:ont00000829
    ns8:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:comment """Standards of date, time, and time zone data formats:
ISO/WD 8601-2 (http://www.loc.gov/standards/datetime/iso-tc154-wg5_n0039_iso_wd_8601-2_2016-02-16.pdf)
W3C (https://www.w3.org/TR/NOTE-datetime)"""@en, "There is no class 'Time Zone' (the region), only 'Time Zone Identifier' (the designator for some region). Instances of 'Time Zone Identifier' should be related to instances of 'Information Bearing Entity' by means of the object properites 'uses time zone identifier' and 'time zone identifier used by' as appropriate. This is supposed to be analogous to the way we represent the relationship between measurement values and measurement units, where the relevant instance of Information Bearing Entity 'uses measurement unit' some instance of Measurement Unit (i.e., an instance of Information Content Entity)."@en ;
    rdfs:label "Time Zone Identifier"@en ;
    rdfs:subClassOf ns8:ont00000390 ;
    skos:definition "A Spatial Region Identifier that designates the region associated with some uniform standard time for legal, commercial, or social purposes."@en .

ns8:ont00000830
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Speed&oldid=1058949945"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:comment "An object's speed is the scalar absolute value of it's Velocity."@en ;
    rdfs:label "Speed"@en ;
    rdfs:subClassOf ns1:BFO_0000144 ;
    skos:definition "A Process Profile that is characterized by the magnitude of an object's motion with respect to a frame of reference during some time period."@en .

ns8:ont00000831
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Herbicide&oldid=1061228045"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Herbicide Artifact Function"@en ;
    rdfs:subClassOf ns8:ont00000828 ;
    skos:definition "A Pesticide Artifact Function that is realized in a process which causes harm to, or the death to, unwanted plants."@en .

ns8:ont00000832
    ns8:ont00001754 "http://wordnetweb.princeton.edu/perl/webwn?s=year" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/TimeOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Year"@en ;
    rdfs:subClassOf _:nimportcommonb393, ns1:BFO_0000202 ;
    skos:definition "A Temporal Interval that is equal to the approximate length of time required for an Astronomical Body to complete one Orbital Revolution around its Primary Body as specified relative to a particular Temporal Reference System."@en ;
    skos:scopeNote "Unless otherwise specified, a Year is assumed to be relative to the Orbiting of the Earth around the Sun and is approximately equal to 12 Months or 365 Days."@en .

ns8:ont00000833
    ns8:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Julian Date Identifier"@en ;
    rdfs:subClassOf _:nimportcommonb394, _:nimportcommonb395, _:nimportcommonb396, ns8:ont00000973 ;
    skos:definition "A Decimal Time of Day Identifier that designates a Julian Date and is composed of both a Julian Day Number and a Julian Date Fraction."@en .

ns8:ont00000834
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Electromagnetic_spectrum&oldid=1063851392"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Mid Infrared Light Frequency"@en ;
    rdfs:subClassOf ns8:ont00001337 ;
    skos:definition "An Infrared Light Frequency that is between 20 and 214 terahertz."@en .

ns8:ont00000835
    ns8:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Body Shape"@en ;
    rdfs:subClassOf ns8:ont00001059 ;
    skos:definition "A Shape Quality inhering in a Person's body by virtue of the body's general outline or figure."@en .

ns8:ont00000836
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Act of Financial Instrument Use"@en ;
    rdfs:subClassOf ns8:ont00000566 ;
    skos:definition "An Act of Artifact Employment in which some Agent uses some Financial Instrument."@en .

ns8:ont00000837
    ns8:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Family"@en ;
    rdfs:subClassOf ns8:ont00000914 ;
    skos:definition "A Group of Persons related to one another by ancestry or marriage."@en .

ns8:ont00000838
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Portion of Fuel"@en ;
    rdfs:subClassOf ns8:ont00000457 ;
    skos:definition "A Portion of Material that is designed to release thermal energy when reacted with other substances."@en .

ns8:ont00000839
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Donation&oldid=1059373518"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Act of Donating"@en ;
    rdfs:subClassOf ns8:ont00000836 ;
    skos:definition "An Act of Financial Instrument Use wherein a Financial Instrument is tranfered by an Agent (the Donor) to another Agent (the Recipient) without return consideration."@en .

ns8:ont00000840
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Bicycle&oldid=1063761124"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Bicycle"@en ;
    rdfs:subClassOf ns8:ont00000618 ;
    skos:definition "A Ground Vehicle that consists of two wheels, one in front of the other, attached to a frame along with handlebars and pedals such that it is designed to receive its motive power from pedaling."@en .

ns8:ont00000841
    ns8:ont00001754 "http://www.dictionary.com/browse/explosive" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Explosive Artifact Function"@en ;
    rdfs:subClassOf ns8:ont00001153 ;
    skos:definition "A Damaging Artifact Function that is realized in a process in which the structural integrity of an entity is impaired beucase of the rapid increase in volume and release of energy in an extreme manner."@en .

ns8:ont00000842
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Sub-Bass Frequency"@en ;
    rdfs:subClassOf ns8:ont00000530 ;
    skos:definition "A Sonic Frequency that is between 20 and 60 Hz."@en .

ns8:ont00000843
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Solar_cell&oldid=1063439932"^^xsd:anyURI, "https://en.wikipedia.org/w/index.php?title=Solar_panel&oldid=1064397496"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Solar Panel"@en ;
    rdfs:subClassOf ns8:ont00001049 ;
    skos:definition "An Electrical Power Source that consists in part of one or more photovoltaic (i.e. solar) cells that convert light energy (photons) directly into electricity by means of the photovoltaic effect."@en .

ns8:ont00000844
    ns8:ont00001760 "https://www.commoncoreontologies.org/UnitsOfMeasureOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Measurement Unit of Temperature"@en ;
    rdfs:subClassOf ns8:ont00000120 ;
    skos:definition "A Measurement Unit that is used as a standard for measurement of the thermal energy in an object."@en ;
    skos:example "celsius, fahrenheit, kelvin" .

ns8:ont00000845
    ns8:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:comment "A percentage is one way to express a proportional measure where the decimal expression of the proportion is multiplied by 100, thus giving the proportional value with respect to a whole of 100. E.g., the ratio of pigs to cows on a farm is 44 to 79 (44:79 or 44/79). The proportion of pigs to total animals is 44 to 123 or 44/123. The percentage of pigs is the decimal equivalent of the proportion (0.36) multiplied by a 100 (36%). The percentage can be expressed as a proportion where the numerator value is transformed for a denominator of 100, i.e., 36 of a 100 animals are pigs (36/100)."@en, "We may want to add either a subclass for Percentage or a data property (has percentage value) that links the percentage expression for a proportion to the relevant IBE."@en ;
    rdfs:label "Proportional Ratio Measurement Information Content Entity"@en ;
    rdfs:subClassOf ns8:ont00001022 ;
    skos:definition "A Ratio Measurement Information Content Entity that is a measurement of a portion of a whole (described by the numerator) compared against that whole (described by the denominator) where the whole is a nominally described set of like entities."@en .

ns8:ont00000846
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Hydroelectricity&oldid=1062438236"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Hydroelectric Power Plant"@en ;
    rdfs:subClassOf ns8:ont00001076 ;
    skos:definition "An Electric Power Station that is designed to convert hydropower into electrical power."@en .

ns8:ont00000847
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    owl:disjointWith ns8:ont00000936 ;
    rdf:type owl:Class ;
    rdfs:label "Active Stasis"@en ;
    rdfs:subClassOf ns8:ont00001213 ;
    skos:definition "A Stasis of Artifact Operationality that holds during a Temporal Interval when an Artifact is realizing one or more of its designed Artifact Functions (especially one of its primary functions)."@en .

ns8:ont00000848
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Mounted Gun"@en ;
    rdfs:subClassOf ns8:ont00000088 ;
    skos:definition "A Firearm that is designed to be fired while mounted."@en .

ns8:ont00000849
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Heating System"@en ;
    rdfs:subClassOf ns8:ont00000453 ;
    skos:definition "An Environment Control System that is designed to heat the air or objects in a Site."@en .

ns8:ont00000850
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Stasis of Quality"@en ;
    rdfs:subClassOf ns8:ont00000135 ;
    skos:definition "A Stasis of Specifically Dependent Continuant in which some Independent Continuant bears some Quality that remains unchanged during a Temporal Interval."@en .

ns8:ont00000851
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Light_machine_gun&oldid=1063598801"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Light Machine Gun"@en ;
    rdfs:subClassOf ns8:ont00001104 ;
    skos:definition "A Long Gun that is designed to fire bullets in quick succession from an ammunition belt or magazine and to be employed by an individual soldier, with or without assistance, and typically weighing 9-22 lbs."@en .

ns8:ont00000852
    ns8:ont00001760 "https://www.commoncoreontologies.org/UnitsOfMeasureOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Measurement Unit of Work"@en ;
    rdfs:subClassOf ns8:ont00000120 ;
    skos:definition "A Measurement Unit that is used as a standard for measurement of displacements of points to which Forces have been applied."@en ;
    skos:example "joule, erg, kilowatt hour" .

ns8:ont00000853
    ns8:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI ;
    owl:disjointWith ns8:ont00000965 ;
    rdf:type owl:Class ;
    rdfs:label "Descriptive Information Content Entity"@en ;
    rdfs:subClassOf ns8:ont00000958 ;
    skos:altLabel "Descriptive ICE"@en ;
    skos:definition "An Information Content Entity that consists of a set of propositions that describe some Entity."@en .

ns8:ont00000854
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Decrease of Realizable Entity"@en ;
    rdfs:subClassOf ns8:ont00000290 ;
    skos:definition "A Decrease of Specifically Dependent Continuant in which some Independent Continuant has a decrease of some Realizable Entity that it bears."@en .

ns8:ont00000855
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Effect of Location Change"@en ;
    rdfs:subClassOf _:nimportcommonb397, _:nimportcommonb398, ns8:ont00000660 ;
    skos:definition "An Effect caused by some Act of Location Change and which results in an Object being located in a different place."@en .

ns8:ont00000856
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Artifact History"@en ;
    rdfs:subClassOf ns1:BFO_0000182 ;
    skos:definition "A History of an Artifact."@en .

ns8:ont00000857
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Ultra High Frequency Communication Instrument"@en ;
    rdfs:subClassOf ns8:ont00000903 ;
    skos:definition "A Radio Communication Instrument that is designed to participate in some process that has process part some Ultra High Frequency."@en .

ns8:ont00000858
    ns8:ont00001753 "IED" ;
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Improvised_explosive_device&oldid=1063432318"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Improvised Explosive Device"@en ;
    rdfs:subClassOf ns8:ont00000552 ;
    skos:definition "An Explosive Weapon that is designed to be used in non-conventional military action."@en .

ns8:ont00000859
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Television_broadcasting&oldid=1063890047"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Television Broadcast"@en ;
    rdfs:subClassOf ns8:ont00000517 ;
    skos:altLabel "Act of Television Broadcasting"@en ;
    skos:definition "An Act of Communciation by Media that is transmitted to an audience through a television network."@en .

ns8:ont00000860
    ns8:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI ;
    owl:equivalentClass _:nimportcommonb399 ;
    rdf:type owl:Class ;
    rdfs:label "Allied Person"@en ;
    rdfs:subClassOf ns8:ont00001262 ;
    skos:definition "A Person who is the bearer of some Ally Role."@en .

ns8:ont00000861
    ns8:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Split"@en ;
    rdfs:subClassOf ns8:ont00001059 ;
    skos:definition "A Shape Quality inhering in a bearer in virtue of the bearer having a linear opening, or having been divided into parts."@en .

ns8:ont00000862
    ns8:ont00001754 "http://www.animations.physics.unsw.edu.au/waves-sound/quantifying/index.html", "https://en.wikipedia.org/w/index.php?title=Sound&oldid=1050465877"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    owl:equivalentClass _:nimportcommonb403 ;
    rdf:type owl:Class ;
    rdfs:label "Sound Process Profile"@en ;
    rdfs:subClassOf ns1:BFO_0000144 ;
    skos:altLabel "Sound Quality"@en ;
    skos:definition "A Process Profile that is part of a sound reception process and is characterized by properties of incoming sound waves as they are translated by some sensory system."@en .

ns8:ont00000863
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Act of Confessing"@en ;
    rdfs:subClassOf ns8:ont00000379 ;
    skos:definition "An Act of Representative Communication in which a person makes an admission of misdeeds or faults."@en .

ns8:ont00000864
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Public_security&oldid=1058257389"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Public Safety Artifact Function"@en ;
    rdfs:subClassOf ns8:ont00001301 ;
    skos:definition "A Service Artifact Function that is realized in processes of preventing and responding to events that could endanger the safety of the general public from significant danger, injury/harm, or damage, such as crimes or disasters (natural or man-made)."@en .

ns8:ont00000865
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Loss of Specifically Dependent Continuant"@en ;
    rdfs:subClassOf ns8:ont00000876 ;
    skos:definition "A Loss of Dependent Continuant in which some Independent Continuant ceases to be the bearer of some Specifically Dependent Continuant."@en .

ns8:ont00000866
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Radio_network&oldid=1037183126"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Radio Broadcast"@en ;
    rdfs:subClassOf ns8:ont00000517 ;
    skos:altLabel "Act of Radio Broadcasting"@en ;
    skos:definition "An Act of Communciation by Media that is transmitted to an audience through a radio network."@en .

ns8:ont00000867
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Pipeline&oldid=1024308788"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Pipeline"@en ;
    rdfs:subClassOf ns8:ont00000677 ;
    skos:definition "A Product Transport Facility that is designed to transport goods or materials through a pipe."@en .

ns8:ont00000868
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Rocket Pod"@en ;
    rdfs:subClassOf ns8:ont00001173 ;
    skos:definition "A Rocket Launcher that is designed to contain several Unguided Rockets held in individual tubes and to be used by Aircraft or Helicopters for close air support."@en .

ns8:ont00000869
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Camera&oldid=1063931551"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Optical Camera"@en ;
    rdfs:subClassOf ns8:ont00000199 ;
    skos:definition "A Camera that is designed to form and record an image generated from visible light."@en .

ns8:ont00000870
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Infrastructure System"@en ;
    rdfs:subClassOf ns1:BFO_0000040 ;
    skos:altLabel "Infrastructure"@en ;
    skos:definition "A Material Entity that is composed of elements bearing Infrastructure Roles and is by itself sufficient to provide a planned service or benefit to some organization that maintains its elements."@en .

ns8:ont00000871
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Plant&oldid=1060821100"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Plant"@en ;
    rdfs:subClassOf ns8:ont00000551 ;
    skos:definition "An Organism that is multicellular, eukaryotic, autotrophic, and has cells that contain chloroplasts and walls made of cellulose."@en .

ns8:ont00000872
    ns8:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Brown"@en ;
    rdfs:subClassOf ns8:ont00000378 ;
    skos:definition "A Color that consists of dark orange and red, and of very low intensity."@en .

ns8:ont00000873
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Landform&oldid=1060439172"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/GeospatialOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Physiographic Feature"@en ;
    rdfs:subClassOf ns8:ont00001081 ;
    skos:definition "A Geographic Feature that is a geomorphological unit characterized by its surface form and location in the landscape."@en .

ns8:ont00000874
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Video&oldid=1049376249"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Video"@en ;
    rdfs:subClassOf ns8:ont00000798 ;
    skos:definition "An Information Bearing Artifact that is designed to bear some specific Information Content Entity in the form of a sequence of representations that are presented sufficiently rapidly to create the appearance of motion and continuity."@en .

ns8:ont00000875
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Act of Personal Communication"@en ;
    rdfs:subClassOf ns8:ont00000402 ;
    skos:definition "An Act of Communication having a small audience."@en .

ns8:ont00000876
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Loss of Dependent Continuant"@en ;
    rdfs:subClassOf ns8:ont00000004 ;
    skos:definition "A Change in which some Independent Continuant ceases to be the bearer or carrier of some Dependent Continuant."@en .

ns8:ont00000877
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Brake Control System"@en ;
    rdfs:subClassOf ns8:ont00000723 ;
    skos:definition "A Vehicle Control System that is designed to control the process of braking with the aim of preventing rolling, skidding, and hydroplaning."@en .

ns8:ont00000878
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Identification_friend_or_foe&oldid=1055168718"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Identification Friend or Foe Transponder"@en ;
    rdfs:subClassOf ns8:ont00000325 ;
    skos:altLabel "IFF"@en ;
    skos:definition "A Radio Transponder that is designed to automatically transmit a predefined signal in response to receiving an appropriate interrogation signal such that the entity it is located on can be positively identified as friendly."@en .

ns8:ont00000879
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Act of Religious Group Affiliation"@en ;
    rdfs:subClassOf ns8:ont00000433 ;
    skos:definition "An Act of Association wherein some Person belongs to some Religious Demonination or sub-Denomination."@en .

ns8:ont00000880
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Religion&oldid=1063431202"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Religious Artifact Function"@en ;
    rdfs:subClassOf ns8:ont00001301 ;
    skos:definition "A Service Artifact Function that is realized in processes related to worship and prayer."@en .

ns8:ont00000881
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Storage&oldid=1048222564"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Storage Facility"@en ;
    rdfs:subClassOf ns8:ont00000192 ;
    skos:definition "A Facility that is designed to store materials or goods."@en .

ns8:ont00000882
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Wind_farm&oldid=1062817899"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Wind Farm"@en ;
    rdfs:subClassOf ns8:ont00001076 ;
    skos:definition "An Electric Power Station that is designed to convert the wind's kinetic energy into electrical power by means of wind turbines."@en .

ns8:ont00000883
    ns8:ont00001754 "http://www.merriam-webster.com/dictionary/invite" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Act of Inviting"@en ;
    rdfs:subClassOf ns8:ont00001162 ;
    skos:definition "An Act of Commissive Communication performed by requesting the presence or participation of the audience, and which may include offering an incentive or inducement."@en .

ns8:ont00000884
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Loan&oldid=1063513958"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Act of Loaning"@en ;
    rdfs:subClassOf ns8:ont00000836 ;
    skos:definition "An Act of Financial Instrument Use wherein a Financial Instrument is given by an Agent (the Creditor) to another Agent (the Debtor) in order to receive Repayments from the Debtor which are of greater Financial Value."@en .

ns8:ont00000885
    ns8:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Wavy"@en ;
    rdfs:subClassOf ns8:ont00001059 ;
    skos:altLabel "Undulate"@en ;
    skos:definition "A Shape Quality inhering in a bearer in virtue of it having a sinuous or rippled border."@en .

ns8:ont00000886
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Wired Communication Reception Artifact Function"@en ;
    rdfs:subClassOf ns8:ont00000422 ;
    skos:definition "A Communication Reception Artifact Function that is realized during events in which an Artifact receives information transmitted from another Artifact, where the transmission of information occurs via a direct connection using an electrical conductor."@en .

ns8:ont00000887
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=City&oldid=1062635325"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "City"@en ;
    rdfs:subClassOf ns8:ont00000460 ;
    skos:definition "A Local Administrative Region in which a relatively large human population permanently resides; is designated as a city based on a particular administrative, legal, or historical status; and which delimits a local Government that typically oversees the provision of systems for sanitation, utilities, land usage, housing, and transportation."@en .

ns8:ont00000888
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "High Frequency Communication Instrument"@en ;
    rdfs:subClassOf ns8:ont00000903 ;
    skos:definition "A Radio Communication Instrument that is designed to participate in some process that has process part some High Frequency."@en .

ns8:ont00000889
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Visible Observation"@en ;
    rdfs:subClassOf _:nimportcommonb407, ns8:ont00000037 ;
    skos:definition "An Act of Observation that involves visual perception."@en .

ns8:ont00000890
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Travel&oldid=1037229469"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Act of Travel"@en ;
    rdfs:subClassOf ns8:ont00000065 ;
    skos:definition "An Act of Location Change wherein one or more Persons move between relatively distant geographical locations for any purpose and any duration, with or without any means of transport."@en .

ns8:ont00000891
    ns8:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Calendar System"@en ;
    rdfs:subClassOf ns8:ont00001328 ;
    skos:definition "A Temporal Reference System that is designed to organize and identify dates."@en ;
    skos:scopeNote "Calendars typically organize dates through the use of naming and temporal conventions based on Days, Weeks, Months, and Years."@en .

ns8:ont00000892
    ns8:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Depth"@en ;
    rdfs:subClassOf ns8:ont00001367 ;
    skos:definition "A One Dimensional Extent that inheres in a bearer in virtue of the bearer's extension in a downward, backward, or inward direction."@en .

ns8:ont00000893
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:comment "An empty notebook, when manufactured, is a medium but not yet a carrier of information content. However, a book, in the sense of a novel or collection of philosophical essays or poems, depends necessarily on it carrying some information content. Thus, there are no empty books. Likewise, there are no empty databases, only portions of digital storage that have not yet been configured to carry some information content according to a database software application."@en ;
    rdfs:label "Information Medium Artifact"@en ;
    rdfs:subClassOf ns8:ont00000995 ;
    skos:definition "A Material Artifact that is designed to have some Information Bearing Artifact as part."@en ;
    skos:example "A magnetic hard drive", "A notebook" .

ns8:ont00000894
    ns8:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Decimal Date Identifier"@en ;
    rdfs:subClassOf ns8:ont00000529 ;
    skos:definition "A Date Identifier that designates some Day by using a number to indicate the sequential ordering of the Day since a specified Reference Time."@en .

ns8:ont00000895
    ns8:ont00001754 "Haviland, William A.; Prins, Harald E. L.; McBride, Bunny; Walrath, Dana (2011). Cultural Anthropology: The Human Challenge (13th ed.). Cengage Learning. ISBN 978-0-495-81178-7", "https://en.wikipedia.org/w/index.php?title=Marriage&oldid=1064076951"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Married"@en ;
    rdfs:subClassOf ns8:ont00000335 ;
    skos:altLabel "Married Stasis"@en ;
    skos:definition "A Stasis of Generically Dependent Continuant that consists of a socially, culturally, or ritually recognized union or legal contract between spouses that establishes rights and obligations between them, between them and their children, and between them and their in-laws."@en .

ns8:ont00000896
    ns8:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Mean Point Estimate Information Content Entity"@en ;
    rdfs:subClassOf ns8:ont00000745 ;
    skos:altLabel "Arithmetic Mean"@en, "Average"@en, "Mean"@en ;
    skos:definition "A Point Estimate Information Content Entity that is a measurement of a set of values and is equal to the sum of all the values in the set divided by the total number of values in the set."@en .

ns8:ont00000897
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:comment "Oxidizers are essential participants in many processes including combustion and rusting. Hence, a portion of oxidizer must always be present along with a portion of fuel in order for combustion to occur."@en ;
    rdfs:label "Portion of Oxidizer"@en ;
    rdfs:subClassOf ns8:ont00000457 ;
    skos:altLabel "Portion of Oxidant"@en, "Portion of Oxidizing Agent"@en ;
    skos:definition "A Portion of Material that is disposed to steal electrons from other substances (i.e. to oxidize other substances) as a participant in a reduction-oxidation process."@en ;
    skos:example "oxygen, hydrogen peroxide, chlorine, sulfiric acid, potassium nitrate" .

ns8:ont00000898
    dcterms:bibliographicCitation "University, Utah State. Geopolitical Power | Aggies GO. https://chass.usu.edu/international-studies/aggies-go/power. Accessed 6 Apr. 2023." ;
    dcterms:created "2022-12-30T21:32:27-05:00"^^xsd:dateTime ;
    dcterms:creator "https://cubrc.org"^^xsd:anyURI ;
    ns8:ont00001754 "https://chass.usu.edu/international-studies/aggies-go/power" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Geopolitical Power Role"@en ;
    rdfs:subClassOf _:nimportcommonb408, ns1:BFO_0000023 ;
    skos:definition "A Role had by an Organization, that is perceived by an International Community as capable of performing influential acts in that community, and which would be realized in performing such acts."@en ;
    skos:prefLabel "Geopolitical Power Role"@en .

ns8:ont00000899
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "MSI Plessey Barcode"@en ;
    rdfs:subClassOf ns8:ont00000258 ;
    skos:definition "A One-Dimensional Barcode that consists of an indefinite number of numerical characters and is used for inventory control and marking storage containers and shelves in warehouse environments."@en .

ns8:ont00000900
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Radio Communication Relay Artifact Function"@en ;
    rdfs:subClassOf ns8:ont00001169 ;
    skos:definition "A Communication Relay Artifact Function that is realized during events in which an Artifact is used to first receive and then transmit information without the use of wires from one Artifact to another for the purpose of communiction."@en .

ns8:ont00000901
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Decontamination&oldid=1049850150"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Decontamination Facility"@en ;
    rdfs:subClassOf ns8:ont00001375 ;
    skos:definition "A Washing Facility that is designed to wash personnel or equipment after (potential) contamination by radioactive, biological, or chemical material."@en .

ns8:ont00000902
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Act of Facility Use"@en ;
    rdfs:subClassOf ns8:ont00000566 ;
    skos:definition "An Act of Artifact Employment in which an Agent makes use of some Facility."@en .

ns8:ont00000903
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Radio Communication Instrument"@en ;
    rdfs:subClassOf ns8:ont00000346 ;
    skos:definition "A Communication Instrument that is designed to enable communication between two or more entities via the use of radio waves."@en .

ns8:ont00000904
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Vehicle Track"@en ;
    rdfs:subClassOf _:nimportcommonb409, ns8:ont00000205 ;
    skos:definition "An Object Track for a Vehicle during some motion."@en .

ns8:ont00000905
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Post_office&oldid=1063684373"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Post Office"@en ;
    rdfs:subClassOf ns8:ont00000655 ;
    skos:definition "A Mailing Facility that is designed for serving customers of the national postal system."@en .

ns8:ont00000906
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Email_box&oldid=1061295368"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Email Box"@en ;
    rdfs:subClassOf ns8:ont00000690 ;
    skos:definition "A Telecommunication Instrument that is designed to be the delivery destination of Email Messages that are addressed to the corresponding Email Address."@en .

ns8:ont00000907
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Telephone&oldid=1060006278"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Telephone"@en ;
    rdfs:subClassOf ns8:ont00000690 ;
    skos:altLabel "Phone"@en ;
    skos:definition "A Telecommunication Instrument that is designed to provide point-to-point communication between agents by means of audio messages."@en .

ns8:ont00000908
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Act of Artifact Processing"@en ;
    rdfs:subClassOf ns8:ont00000228 ;
    skos:definition "A Planned Act of performing a series of mechanical or chemical operations on something in order to change or preserve it."@en .

ns8:ont00000909
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Emergency AC/DC Power Source"@en ;
    rdfs:subClassOf ns8:ont00001049 ;
    skos:definition "An Electrical Power Source that is designed to provide electrical power in an emergency situation by means of both alternating current and direct current."@en .

ns8:ont00000910
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Amplitude"@en ;
    rdfs:subClassOf ns1:BFO_0000144 ;
    skos:definition "A Process Profile of an Oscillation Process that is the absolute value of the maximum displacement from a zero, equilibrium, or mean value during one cycle of the Oscillation Process."@en .

ns8:ont00000911
    ns8:ont00001760 "https://www.commoncoreontologies.org/GeospatialOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Semi-Major Axis"@en ;
    rdfs:subClassOf ns1:BFO_0000026 ;
    skos:definition "A One-Dimensional Spatial Region that is equal to half the length of the Major Axis of an Ellipse."@en .

ns8:ont00000912
    ns8:ont00001754 "https://en.wikipedia.org/wiki/Pyramid_(geometry)" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Pyramidal"@en ;
    rdfs:subClassOf ns8:ont00001360 ;
    skos:definition "A Three Dimensional Shape that inheres in a bearer in virtue of it having a polygonal base with vertices that all connect to the same apex to form triangular faces."@en .

ns8:ont00000913
    ns8:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Maroon"@en ;
    rdfs:subClassOf ns8:ont00000378 ;
    skos:definition "A Color consisting of purple and brown hue."@en .

ns8:ont00000914
    ns8:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Group of Persons"@en ;
    rdfs:subClassOf _:nimportcommonb410, _:nimportcommonb411, ns8:ont00000300 ;
    skos:definition "A Group of Agents that has only Persons as parts."@en .

ns8:ont00000915
    ns8:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Acronym"@en ;
    rdfs:subClassOf ns8:ont00000605 ;
    skos:definition "An Abbreviated Name that combines the initial letters of a Designative Name and which is pronounced as a word."@en ;
    skos:example "Wi-Fi, ASCII, OPSEC" .

ns8:ont00000916
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Lunar_calendar&oldid=1055396837"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Lunar Calendar System"@en ;
    rdfs:subClassOf ns8:ont00000891 ;
    skos:definition "A Calendar System that is designed to organize and identify dates based on the cycles of the Moon's phases."@en .

ns8:ont00000917
    dcterms:bibliographicCitation "Permanent Residency - Wikipedia. https://en.wikipedia.org/wiki/Permanent_residency. Accessed 10 Feb. 2023." ;
    dcterms:created "2023-03-29T20:17:54-04:00"^^xsd:dateTime ;
    dcterms:creator "https://cubrc.org"^^xsd:anyURI ;
    ns8:ont00001754 "https://en.wikipedia.org/wiki/Permanent_residency" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Permanent Resident Role"@en ;
    rdfs:subClassOf ns1:BFO_0000023 ;
    skos:definition "A role inhering in a Person by virtue of that Person being recognized as having legal resident status in a Government Domain in which that person is not a citizen but where they have the right to reside on a permanent basis."@en ;
    skos:prefLabel "Permanent Resident Role"@en .

ns8:ont00000918
    ns8:ont00001754 "https://en.wikipedia.org/wiki/Node_(networking)" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Telecommunication Network Node"@en ;
    rdfs:subClassOf _:nimportcommonb412, ns8:ont00000346 ;
    skos:definition "A Communication Artifact that consists of a connection point, redistribution point, or endpoint that is designed to be part of a Telecommunication Network and can be either active or passive."@en .

ns8:ont00000919
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Parts List"@en ;
    rdfs:subClassOf ns8:ont00000575 ;
    skos:definition "A Quality Specification that prescribes the Amount of some type of Artifact that are part of or located on another Artifact."@en .

ns8:ont00000920
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Death&oldid=1064114499"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Death"@en ;
    rdfs:subClassOf ns8:ont00000007 ;
    skos:definition "A Natural Process in which all biological functions that sustain a living organism cease."@en .

ns8:ont00000921
    ns8:ont00001760 "https://www.commoncoreontologies.org/TimeOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Calendar Day"@en ;
    rdfs:subClassOf ns8:ont00000800 ;
    skos:definition "A Day that begins and ends concurrently with the Seconds specified by a Calendar System to be the first and last Seconds of the Day."@en .

ns8:ont00000922
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Act of Arrival"@en ;
    rdfs:subClassOf ns8:ont00000065 ;
    skos:definition "An Act of Location Change that consists of the participating entity reaching its destination such that the larger Act of Location Change is completed."@en .

ns8:ont00000923
    ns8:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Arbitrary Identifier"@en ;
    rdfs:subClassOf ns8:ont00000649 ;
    skos:altLabel "Arbitrary ID"@en ;
    skos:definition "A Non-Name Identifier that consists of a string of characters that does not follow an encoding system."@en .

ns8:ont00000924
    ns8:ont00001753 "BOL", "BoL" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:comment "A Beginning of Life Stasis (BoL) is a relatively brief Operational Stasis that is primarily of interest for the purpose of establishing a baseline for operational parameters to be compared to the designed specifications as well as the Artifact's performance throughout its operational life."@en ;
    rdfs:label "Beginning of Life Stasis"@en ;
    rdfs:subClassOf ns8:ont00001191 ;
    skos:definition "A Operational Stasis that holds during a Temporal Interval when an Artifact is first put into operational use such that its designed set of Artifact Functions is capable of operating at or near their designed peak performance levels."@en .

ns8:ont00000925
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Act of Military Training Acquisition"@en ;
    rdfs:subClassOf ns8:ont00000687 ;
    skos:definition "An Act of Training Acquisition performed by an Agent by acquiring knowledge of the tactics, techniques, and/or strategies of Military Operations from an Agent or communication medium that realizes a capacity derived from its affiliation with a Military Organization."@en .

ns8:ont00000926
    ns8:ont00001754 "http://wordnetweb.princeton.edu/perl/webwn?s=apologizing" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Act of Apologizing"@en ;
    rdfs:subClassOf ns8:ont00000123 ;
    skos:definition "An Act of Expressive Communication performed by acknowledging and expressing regret for a fault, shortcoming, or failure."@en .

ns8:ont00000927
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Bass Frequency"@en ;
    rdfs:subClassOf ns8:ont00000530 ;
    skos:definition "A Sonic Frequency that is between 60 and 250 Hz."@en .

ns8:ont00000928
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Railroad_car&oldid=1063802472"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Train Car"@en ;
    rdfs:subClassOf ns8:ont00000796 ;
    skos:altLabel "Railroad Car"@en ;
    skos:definition "A Rail Transport Vehicle that consists of a single Vehicle that is not a Train but is designed to be connected to other Train Cars along with at least one Locomotive to form a Train."@en .

ns8:ont00000929
    ns8:ont00001754 "http://origins.sese.asu.edu/ses405/Class%20Notes/Sys-Hier-WBS_Module_V1.0_PAS.pdf"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Part Role"@en ;
    rdfs:subClassOf ns1:BFO_0000023 ;
    skos:definition "A Role that inheres in an entity in virtue of it being part of some other entity without being subject to further subdivision or disassembly without destruction of its designated use."@en .

ns8:ont00000930
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Nickel%E2%80%93metal_hydride_battery&oldid=1061626676"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Nickel-metal Hydride Electric Battery"@en ;
    rdfs:subClassOf ns8:ont00001105 ;
    skos:altLabel "NiMH Battery"@en ;
    skos:definition "A Secondary Cell Electric Battery that has a metal-hydride anode and nickel oxide hydroxide cathode."@en .

ns8:ont00000931
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "UPC-A Barcode"@en ;
    rdfs:subClassOf ns8:ont00000326 ;
    skos:definition "A UPC Barcode that consists of 12 numerical digits."@en .

ns8:ont00000932
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Computing Artifact Function"@en ;
    rdfs:subClassOf ns8:ont00000323 ;
    skos:definition "An Artifact Function that is realized by an Artifact participating in a computation process."@en .

ns8:ont00000933
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Telephone&oldid=1060006278"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Landline Telephone"@en ;
    rdfs:subClassOf ns8:ont00000907 ;
    skos:definition "A Telephone that is connected to a Telephone Network through a pair of wires."@en .

ns8:ont00000934
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Constituent_state&oldid=1063662102"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Constituent State"@en ;
    rdfs:subClassOf ns8:ont00000126 ;
    skos:altLabel "State"@en ;
    skos:definition "A First-Order Administrative Region that is part of a Country and delimits a centralized regional Government that holds constitutionally-defined administrative jurisdiction over the defined geographic territory that bounds the State."@en .

ns8:ont00000935
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Act of Legal Instrument Use"@en ;
    rdfs:subClassOf ns8:ont00000566 ;
    skos:definition "An Act of Artifact Employment in which some Agent uses some Legal Instrument."@en .

ns8:ont00000936
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Deactivated Stasis"@en ;
    rdfs:subClassOf ns8:ont00001213 ;
    skos:definition "A Stasis of Artifact Operationality that holds during a Temporal Interval when an Artifact is not realizing any of its designed Artifact Functions (or at least not realizing any of its primary functions)."@en .

ns8:ont00000937
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Inhibiting Motion Artifact Function"@en ;
    rdfs:subClassOf ns8:ont00000323 ;
    skos:definition "An Artifact Function that is realized by processes in which some Artifact is used to inhibit the motion of some object."@en .

ns8:ont00000938
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Finance&oldid=1062402926"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Financial Artifact Function"@en ;
    rdfs:subClassOf ns8:ont00001301 ;
    skos:definition "A Service Artifact Function that is realized in processes of managing money."@en .

ns8:ont00000939
    ns8:ont00001760 "https://www.commoncoreontologies.org/GeospatialOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Geospatial Line"@en ;
    rdfs:subClassOf ns8:ont00000817 ;
    skos:definition "A Geospatial Line String that has only two vertices."@en .

ns8:ont00000940
    ns8:ont00001760 "https://www.commoncoreontologies.org/UnitsOfMeasureOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Measurement Unit of Momentum"@en ;
    rdfs:subClassOf ns8:ont00000120 ;
    skos:definition "A Measurement Unit that is used as a standard for measurement of the Momentum of a portion of matter that is in Motion."@en ;
    skos:example "kg m/s, slug ft/s, g m/s" .

ns8:ont00000941
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Phosphorescence&oldid=1060815719"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Phosphorescence"@en ;
    rdfs:subClassOf ns8:ont00001126 ;
    skos:definition "A Luminescent Property that inheres in a bearer in virtue of that bearer's capacity to emit visible light after absorbing shorter wavelength radiation, and to continue emitting after the absorbing process has ceased."@en .

ns8:ont00000942
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Sniper_rifle&oldid=1061592308"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Sniper Rifle"@en ;
    rdfs:subClassOf ns8:ont00000204 ;
    skos:definition "A Rifle that is designed to be highly accurate for long-range precision tactical shooting."@en .

ns8:ont00000943
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Ocular_prosthesis&oldid=1061336760"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Ocular Prosthesis"@en ;
    rdfs:subClassOf ns8:ont00001248 ;
    skos:definition "An Artificial Eye that is designed to replace a missing eye, but which does not function as an eye."@en .

ns8:ont00000944
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Thermal Imaging Artifact Function"@en ;
    rdfs:subClassOf ns8:ont00000601 ;
    skos:definition "An Imaging Artifact Function that is realized during events in which an Artifact is used to create a visual representation of an entity using radiation from the far infrared region of the electromagnetic spectrum that the entity emits"@en .

ns8:ont00000945
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=X-ray_telescope&oldid=1035025593"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "X-ray Telescope"@en ;
    rdfs:subClassOf ns8:ont00000547 ;
    skos:definition "A Telescope that is designed to aid in the observation of spatially distant Objects by means of collecting and focusing X-rays to form an enhanced image of the Object."@en .

ns8:ont00000946
    ns8:ont00001754 "https://en.wikipedia.org/wiki/Administration_(government)" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Government Building"@en ;
    rdfs:subClassOf ns8:ont00000192 ;
    skos:definition "A Facility that is designed for the administration of a community."@en .

ns8:ont00000947
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Temperature Measurement Artifact Function"@en ;
    rdfs:subClassOf ns8:ont00001100 ;
    skos:definition "A Measurement Artifact Function that is realized during events in which an Artifact is used to measure the Temperature of a specified object or class of objects."@en .

ns8:ont00000948
    ns8:ont00001754 "http://en.wikipedia.org/wiki/Worship (Sense Key: Worship%2:42:00 or Worship%1:04:00::)" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Act of Religious Worship"@en ;
    rdfs:subClassOf ns8:ont00000455 ;
    skos:definition "An Act of Ceremony wherein there occurs acts of religious devotion usually directed towards a deity."@en .

ns8:ont00000949
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Act of Consumption"@en ;
    rdfs:subClassOf ns8:ont00000228 ;
    skos:definition "A Planned Act in which a resource is ingested or used up."@en .

ns8:ont00000950
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Act of Maintenance"@en ;
    rdfs:subClassOf ns8:ont00000970 ;
    skos:definition "An Act of Artifact Modification in which an Artifact is modified in order to preserve or restore one or more of its designed Qualities or Functions."@en .

ns8:ont00000951
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Electromagnetic Wave Process"@en ;
    rdfs:subClassOf _:nimportcommonb413, ns8:ont00000099 ;
    skos:altLabel "Electromagnetic Radiation"@en ;
    skos:definition "A Wave Process that is produced by charged particles, involves the periodic Oscillation of electric and magnetic fields at right angles to each other and the direction of wave propogation such that it has a Transverse Wave Profile, and which transfers electromagnetic radiant energy through a portion of space or matter."@en .

ns8:ont00000952
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Electric_motor&oldid=1063829856"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Electric Motor"@en ;
    rdfs:subClassOf ns8:ont00000210 ;
    skos:altLabel "Electric Engine"@en ;
    skos:definition "An Engine that is designed to convert electrical energy into mechanical energy."@en .

ns8:ont00000953
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Pitch"@en ;
    rdfs:subClassOf ns8:ont00000862 ;
    skos:definition "A Sound Process Profile that is characterized by the frequency of translated sound waves, typically on a continuum from low to high."@en .

ns8:ont00000954
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Category:Telecommunications_infrastructure&oldid=989151314"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Telecommunication Infrastructure"@en ;
    rdfs:subClassOf ns8:ont00000870 ;
    skos:definition "An Infrastructure System that is designed to support the use of Telecommunication Instruments to communicate."@en .

ns8:ont00000955
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Angular_momentum&oldid=1063992505"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Angular Momentum"@en ;
    rdfs:subClassOf ns8:ont00000278 ;
    skos:definition "A Momentum that is the product of an object's moment of inertia and its Angular Velocity."@en .

ns8:ont00000956
    ns8:ont00001754 "https://en.wikipedia.org/wiki/Interchange_(road)" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Highway Interchange"@en ;
    rdfs:subClassOf ns8:ont00001086 ;
    skos:definition "A Road Junction that is designed to enable Ground Vehicles to exit one or more Highways and enter another Highway without directly crossing any other traffic stream."@en .

ns8:ont00000957
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Reservoir&oldid=1055068000"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Reservoir"@en ;
    rdfs:subClassOf ns8:ont00000881 ;
    skos:definition "A Storage Facility that is designed to store water in a man-made open enclosure or area."@en .

ns8:ont00000958
    ns8:ont00001754 "http://purl.obolibrary.org/obo/IAO_0000030" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI ;
    owl:equivalentClass _:nimportcommonb414 ;
    rdf:type owl:Class ;
    rdfs:label "Information Content Entity"@en ;
    rdfs:subClassOf ns1:BFO_0000031 ;
    skos:altLabel "ICE"@en ;
    skos:definition "A Generically Dependent Continuant that generically depends on some Information Bearing Entity and stands in relation of aboutness to some Entity."@en ;
    skos:scopeNote "Information Content Entity is here intended to be a class of Entities whose instances are the informational content of Information Bearing Entities. For example, three instances of information bearers -- such as a bar chart, color-coded map, and a written report -- each of which lists the GDP of Countries for the year 2010 are each different carriers of the same information content. It is this content that is generically dependent upon its carrier. This treatment of Informational Content Entity (cf. the Information Artifact Ontology) leads to a principle of subtyping based upon the relationship that ICE's have with the Entity they are about rather than characteristics such as format, language, measurement scale, or media. The latter are treated here as being Qualities of bearers."@en .

ns8:ont00000959
    ns8:ont00001760 "https://www.commoncoreontologies.org/UnitsOfMeasureOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Measurement Unit of Frequency"@en ;
    rdfs:subClassOf ns8:ont00000120 ;
    skos:definition "A Measurement Unit that is used as a standard for measurement of the number of times an event repeats per unit of time."@en ;
    skos:example "hertz, revolutions per minute" .

ns8:ont00000960
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Telephone_network&oldid=1046265527"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Fixed Line Network Telephone Call"@en ;
    rdfs:subClassOf ns8:ont00001190 ;
    skos:definition "A Telephone Call transmitted over a telephone network where the telephones are wired into a single telephone exchange."@en .

ns8:ont00000961
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Current Conversion Artifact Function"@en ;
    rdfs:subClassOf ns8:ont00000098 ;
    skos:definition "An Electrical Artifact Function that is realized by processes in which some Artifact is used to convert some electrical current."@en .

ns8:ont00000962
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Portion of Liquid Propellant"@en ;
    rdfs:subClassOf ns8:ont00000593 ;
    skos:definition "A Portion of Propellant that is stored in a liquid state."@en .

ns8:ont00000963
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Fuel Transfer System"@en ;
    rdfs:subClassOf ns8:ont00000256 ;
    skos:definition "A Fluid Control Artifact that is designed to facilitate the transfer of some Portion of Fuel from the Fuel Tank for use in some Engine."@en .

ns8:ont00000964
    ns8:ont00001753 "MF" ;
    ns8:ont00001754 "International Telecommunication Union (ITU)" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:comment "The corresponding Wavelength range is 1,000–100 m"@en ;
    rdfs:label "Medium Frequency"@en ;
    rdfs:subClassOf ns8:ont00000150 ;
    skos:altLabel "ITU Band Number 6"@en ;
    skos:definition "A Radio Frequency that is between 300 kHz and 3 MHz."@en .

ns8:ont00000965
    ns8:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI ;
    owl:equivalentClass _:nimportcommonb418 ;
    rdf:type owl:Class ;
    rdfs:label "Directive Information Content Entity"@en ;
    rdfs:subClassOf ns8:ont00000958 ;
    skos:altLabel "Directive ICE"@en ;
    skos:definition "An Information Content Entity that consists of a set of propositions or images (as in the case of a blueprint) that prescribe some Entity."@en .

ns8:ont00000966
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "EAN Barcode"@en ;
    rdfs:subClassOf ns8:ont00000258 ;
    skos:definition "A One-Dimensional Barcode that consists of 8 or 13 numerical digits and is used to scan consumer goods."@en .

ns8:ont00000967
    ns8:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Height"@en ;
    rdfs:subClassOf ns8:ont00001367 ;
    skos:definition "A One Dimensional Extent that inheres in a bearer in virtue of the bearer's extension in a vertical direction."@en .

ns8:ont00000968
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Assault_rifle&oldid=1063774380"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Assault Rifle"@en ;
    rdfs:subClassOf ns8:ont00000204 ;
    skos:definition "A Rifle that is designed to have selective-fire functionality and use an intermediate Cartridge and a detachable magazine."@en .

ns8:ont00000969
    ns8:ont00001760 "https://www.commoncoreontologies.org/UnitsOfMeasureOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Measurement Unit of Speed"@en ;
    rdfs:subClassOf ns8:ont00000120 ;
    skos:definition "A Measurement Unit that is used as a standard for measurement of the rates at which objects traverse distance."@en ;
    skos:example "miles per hour, kilometers per hour, knot, mach" .

ns8:ont00000970
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:comment "Excluded from this class are instances of role change or role creation such as the introduction of an artifact as a piece of evidence in a trial or the loading of artifacts onto a ship for transport."@en ;
    rdfs:label "Act of Artifact Modification"@en ;
    rdfs:subClassOf ns8:ont00000908 ;
    skos:definition "An Act of Artifact Processing in which an existing Artifact is acted upon in a manner that changes, adds, or removes one or more of its Qualities, Dispositions, or Functions."@en .

ns8:ont00000971
    ns8:ont00001754 "JC3IEDM-MIRD-DMWG-Edition_3.0.2_20090514" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Act of Deceptive Communication"@en ;
    rdfs:subClassOf ns8:ont00000402 ;
    skos:definition "Ac Act of Communication intended to mislead the audience by distortion or falsification of evidence and induce a reaction that is prejudicial to the interests of the audience."@en .

ns8:ont00000972
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "EAN-13 Barcode"@en ;
    rdfs:subClassOf ns8:ont00000966 ;
    skos:definition "An EAN Barcode that consists of 13 numerical digits and is used to designate products at the point of sale."@en .

ns8:ont00000973
    ns8:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Decimal Time of Day Identifier"@en ;
    rdfs:subClassOf ns8:ont00000827 ;
    skos:altLabel "Fractional Time of Day Identifier"@en ;
    skos:definition "A Time of Day Identifier that designates an approximate Temporal Instant that is part of some Day and is specified using a decimal value for the portion of the Day that preceded the Temporal Instant."@en .

ns8:ont00000974
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Plan&oldid=1047320560"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Plan"@en ;
    rdfs:subClassOf _:nimportcommonb422, ns8:ont00000965 ;
    skos:definition "A Directive Information Content Entity that prescribes some set of intended Intentional Acts through which some Agent expects to achieve some Objective."@en .

ns8:ont00000975
    ns8:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Cyan"@en ;
    rdfs:subClassOf ns8:ont00000378 ;
    skos:definition "A Color that is between Green and Blue with a wavelength in the visible spectrum typically between 490 and 520 nanometers."@en .

ns8:ont00000976
    ns8:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Political Orientation"@en ;
    rdfs:subClassOf ns8:ont00000696 ;
    skos:definition "An Ideology that characterizes the political thinking of an Agent or Group of Agents, usually with respect to the political environment within a particular nation."@en .

ns8:ont00000977
    ns8:ont00001754 "JC3IEDM-MIRD-DMWG-Edition_3.0.2_20090514" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Act of Publishing Mass Media Documentary"@en ;
    rdfs:subClassOf ns8:ont00000588 ;
    skos:definition "An Act of Mass Media Communication involving the preparation and public issuance of information that provides a factual record or report."@en .

ns8:ont00000978
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    owl:equivalentClass _:nimportcommonb423 ;
    rdf:type owl:Class ;
    rdfs:label "Cause"@en ;
    rdfs:subClassOf ns1:BFO_0000015 ;
    skos:definition "A Process that is the cause of or one of the causes of some other Process."@en .

ns8:ont00000979
    ns8:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Closure"@en ;
    rdfs:subClassOf ns1:BFO_0000019 ;
    skos:definition "A Quality that inheres in a bearer in virtue of the degree to which that bearer affords passage or sightline through it via an opening, aperture, orifice, or vent."@en .

ns8:ont00000980
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Portion of Waste Material"@en ;
    rdfs:subClassOf ns8:ont00001084 ;
    skos:definition "A Portion of Processed Material that serves no further use in terms of the initial user's own purposes of production, transformation, or consumption such that the Agent wants to dispose of it."@en .

ns8:ont00000981
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Act of Portion of Material Consumption"@en ;
    rdfs:subClassOf ns8:ont00000566 ;
    skos:definition "An Act of Artifact Employment in which a Portion of Material is expended."@en .

ns8:ont00000982
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Decrease of Function"@en ;
    rdfs:subClassOf ns8:ont00000543 ;
    skos:definition "A Decrease of Disposition in which some Independent Continuant has a decrease of some Function that it bears."@en .

ns8:ont00000983
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    owl:equivalentClass _:nimportcommonb427 ;
    rdf:type owl:Class ;
    rdfs:label "Shear Wave Process"@en ;
    rdfs:subClassOf ns8:ont00001028 ;
    skos:definition "A Mechanical Wave that has a Transverse Wave Profile."@en .

ns8:ont00000984
    ns8:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Occupation Role"@en ;
    rdfs:subClassOf ns1:BFO_0000023 ;
    skos:definition "A Role that inheres in an Agent in virtue of the responsibilities that Agent is expected to fulfill within the context of some Act of Employment."@en .

ns8:ont00000985
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Thermal_insulation&oldid=1059273300"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Thermal Insulation Artifact Function"@en ;
    rdfs:subClassOf ns8:ont00001350 ;
    skos:definition "A Thermal Control Artifact Function that is realized during events in which an Artifact prevents or reduces the transfer of heat between objects that are in thermal contact or in range of radiative influence."@en .

ns8:ont00000986
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Scar&oldid=1057179533"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Scar"@en ;
    rdfs:subClassOf ns8:ont00000084 ;
    skos:definition "A Bodily Component that consists of a portion of fibrous connective tissue on skin or within body tissue and which was formed due to an injury that has not healed completely."@en .

ns8:ont00000987
    ns8:ont00001754 "http://en.wikitionary.org/wiki/citizen" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Citizen Role"@en ;
    rdfs:subClassOf ns1:BFO_0000023 ;
    skos:definition "A Role that inheres in a Person by virtue of that Person being legally recognized as a member of a particular state, with associated rights and obligations."@en .

ns8:ont00000988
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Reflective Prism"@en ;
    rdfs:subClassOf ns8:ont00000804 ;
    skos:definition "A Prism designed to reflect light in order to flip, invert, rotate, deviate, or displace a beam of light entering the Prism."@en .

ns8:ont00000989
    ns8:ont00001753 "SHF" ;
    ns8:ont00001754 "International Telecommunication Union (ITU)" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:comment "The corresponding Wavelength range is 100–10 mm"@en ;
    rdfs:label "Super High Frequency"@en ;
    rdfs:subClassOf ns8:ont00000732 ;
    skos:altLabel "ITU Band Number 10"@en ;
    skos:definition "A Microwave Frequency that is between 3 and 30 GHz."@en .

ns8:ont00000990
    ns8:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Nickname"@en ;
    rdfs:subClassOf ns8:ont00000003 ;
    skos:definition "A Designative Name that is a familiar or humorous substitute for an entity's Proper Name."@en ;
    skos:example "Ike, Chief, P-Fox" .

ns8:ont00000991
    ns8:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Bent"@en ;
    rdfs:subClassOf ns8:ont00001059 ;
    skos:altLabel "Angular"@en, "Kinked"@en ;
    skos:definition "A Shape Quality inhering in a bearer in virtue of the bearer having one or more angles along its border."@en .

ns8:ont00000992
    ns8:ont00001754 "https://physics.nist.gov/cuu/Units/second.html" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/TimeOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:comment "The Second is used as the basic SI unit of time."@en ;
    rdfs:label "Second"@en ;
    rdfs:subClassOf _:nimportcommonb431, ns1:BFO_0000202 ;
    skos:definition "A Temporal Interval that is equal to the duration of 9,192,631,770 periods of the radiation corresponding to the transition between the two hyperfine levels of the ground state of the cesium 133 atom."@en .

ns8:ont00000993
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Power Rectifying Artifact Function"@en ;
    rdfs:subClassOf ns8:ont00000961 ;
    skos:definition "A Current Conversion Artifact Function that is realized by processes in which some Artifact is used to convert alternating current (AC) to direct current (DC)."@en .

ns8:ont00000994
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Electrical Power Production Artifact Function"@en ;
    rdfs:subClassOf ns8:ont00000098 ;
    skos:definition "An Electrical Artifact Function that is realized during events in which an Artifact is used to generate electrical power."@en .

ns8:ont00000995
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Material Artifact"@en ;
    rdfs:subClassOf ns1:BFO_0000040 ;
    skos:definition "A Material Entity that was designed by some Agent to realize a certain Function."@en .

ns8:ont00000996
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Ramjet&oldid=1062836331"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Ramjet Engine"@en ;
    rdfs:subClassOf ns8:ont00000294 ;
    skos:altLabel "Ramjet"@en ;
    skos:definition "An Air-Breathing Jet Engine that uses the forward motion of the Engine to compress incoming air (without the use of an axial compressor) and decelerate it to subsonic speeds before adding the fuel and constantly combusting the mixture then expelling the exhaust out through the rear Propelling Nozzle to generate Thrust."@en .

ns8:ont00000997
    dcterms:created "2022-12-30T21:32:27-05:00"^^xsd:dateTime ;
    dcterms:creator "https://cubrc.org"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Disrupting Disposition"@en ;
    rdfs:subClassOf ns1:BFO_0000016 ;
    skos:definition "A disposition the realization of which would disrupt a process some entity has an interest in."@en ;
    skos:editorialNote "This is a defined class. A Disrupting Disposition is indexed by the interest_in object property. A disposition can be a Disrupting Disposition according to one index and not a Disrupting Disposition according to another index." ;
    skos:prefLabel "Threat"@en .

ns8:ont00000998
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Telecommunications_network&oldid=1063347482"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Telecommunication Network"@en ;
    rdfs:subClassOf ns8:ont00001036 ;
    skos:definition "A Communication System that is designed to enable the transmission of information over significant distances between Telecommunication Endpoints via Telecommunication Network Nodes and Lines."@en .

ns8:ont00000999
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    owl:disjointWith ns8:ont00001191 ;
    rdf:type owl:Class ;
    rdfs:label "Defunct Stasis"@en ;
    rdfs:subClassOf ns8:ont00001213 ;
    skos:definition "A Stasis of Artifact Operationality that holds during a Temporal Interval when an Artifact no longer maintains its designed set of Artifact Functions (or at least no longer maintains its primary functions)."@en .

ns8:ont00001000
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Spray Nozzle"@en ;
    rdfs:subClassOf ns8:ont00000252 ;
    skos:definition "A Nozzle that is designed to facilitate a conversion of the flow of a portion of liquid into a dynamic collection of drops dispersed in a portion of gas."@en .

ns8:ont00001001
    ns8:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Drooping"@en ;
    rdfs:subClassOf ns8:ont00001059 ;
    skos:definition "A Shape Quality inhering in a bearer in virtue of the bearer having a border that hangs downwards."@en .

ns8:ont00001002
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Message&oldid=1060098631"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Message"@en ;
    rdfs:subClassOf ns8:ont00000798 ;
    skos:definition "An Information Bearing Artifact that is designed to bear some specific Information Content Entity that is relatively brief and to be transmitted from a sender to a recipient."@en .

ns8:ont00001003
    ns8:ont00001754 "https://en.wikipedia.org/wiki/Cartridge_(firearms)" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Cartridge"@en ;
    rdfs:subClassOf ns8:ont00001150 ;
    skos:definition "A Portion of Ammunition that is designed to package a Bullet, a propellant substance, and a primer within a case that is designed to fit within the firing chamber of a Firearm."@en .

ns8:ont00001004
    ns8:ont00001760 "https://www.commoncoreontologies.org/UnitsOfMeasureOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Measurement Unit of Electromagnetic Force"@en ;
    rdfs:subClassOf ns8:ont00000120 ;
    skos:definition "A Measurement Unit that is used as a standard for measurement of the electromagnetic force between electrically charged entities."@en ;
    skos:example "volt, ampere, coulomb" .

ns8:ont00001005
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Turbojet&oldid=1060948529"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Turbojet Air-Breathing Jet Engine"@en ;
    rdfs:subClassOf ns8:ont00000294 ;
    skos:definition "An Air-Breathing Jet Engine that uses a Turbojet, which consists of a Turbine with a Propelling Nozzle."@en .

ns8:ont00001006
    ns8:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Operator Role"@en ;
    rdfs:subClassOf ns1:BFO_0000023 ;
    skos:definition "A Role that inheres in an Agent by virtue of that Agent's responsibilities to operate or control some Artifact."@en ;
    skos:example "the role of driving a car", "the role of flying an airplane", "the role of operating a crane" .

ns8:ont00001007
    ns8:ont00001754 "https://en.wikipedia.org/wiki/Passenger_car_(rail)" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Passenger Train Car"@en ;
    rdfs:subClassOf ns8:ont00000928 ;
    skos:definition "A Train Car that is designed to transport passengers."@en .

ns8:ont00001008
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Biological_warfare&oldid=1062972883"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Biological Weapon"@en ;
    rdfs:subClassOf ns8:ont00000445 ;
    skos:definition "A Weapon that is designed to inflict harm, incapacity, or death by means of releasing disease-producing agents—such as bacteria, viruses, or fungi."@en .

ns8:ont00001009
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Optical_telescope&oldid=1062201329"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Optical Telescope"@en ;
    rdfs:subClassOf ns8:ont00000547 ;
    skos:definition "A Telescope that is designed to aid in the observation of spatially distant Objects by means of collecting and focusing visible light to form an enhanced image of the Object."@en .

ns8:ont00001010
    ns8:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI ;
    owl:disjointWith ns8:ont00001022, ns8:ont00001364 ;
    owl:equivalentClass _:nimportcommonb432 ;
    rdf:type owl:Class ;
    rdfs:comment "Four of the subtypes of measurements used here (Interval, Nominal, Ordinal, and Ratio) were originally defined by S.S. Stevens in the article \"On the Theory of Scales of Measurement\" in Science, Vol. 103 No. 2684 on June 7, 1946. For an introductory article with links to additional content including criticisms and alternate classifications of measurements see https://en.wikipedia.org/wiki/Level_of_measurement"@en ;
    rdfs:label "Ordinal Measurement Information Content Entity"@en ;
    rdfs:subClassOf ns8:ont00001163 ;
    skos:definition "A Measurement Information Content Entity that consists of a symbol that places an Entity into some rank order."@en ;
    skos:example "The sentence \"The coldest day in history in Chicago, IL. is January 20, 1985.\" is the carrier of an ordinal measurment."@en, "a measurement that places Geospatial Regions into a rank order of small, medium, large", "a measurement that places military units onto a readiness rank order of red, yellow, green" .

ns8:ont00001011
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Car&oldid=1064116950"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Automobile"@en ;
    rdfs:subClassOf ns8:ont00000053 ;
    skos:definition "A Ground Motor Vehicle that is designed to transport a small number of passengers while traveling on four tired wheels."@en .

ns8:ont00001012
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:comment "Further variants of GS1 DataBar have not been defined here."@en ;
    rdfs:label "GS1 DataBar Barcode"@en ;
    rdfs:subClassOf ns8:ont00000258 ;
    skos:definition "A One-Dimensional Barcode that consists of 12-14 numerical digits and is used in retail and healthcare."@en .

ns8:ont00001013
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Heating Artifact Function"@en ;
    rdfs:subClassOf ns8:ont00000323 ;
    skos:definition "An Artifact Function that is realized in a process in which the thermal energy of a system increases."@en .

ns8:ont00001014
    ns8:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Proper Name"@en ;
    rdfs:subClassOf ns8:ont00000003 ;
    skos:definition "A Designative Name that is an official name for a particular entity."@en .

ns8:ont00001015
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Controlled-access_highway&oldid=1063655601"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Controlled-Access Highway"@en ;
    rdfs:subClassOf ns8:ont00000646 ;
    skos:altLabel "Expressway"@en, "Freeway"@en, "Motorway"@en ;
    skos:definition "A Highway that is designed for high-speed vehicular traffic, with all traffic flow and ingress/egress regulated."@en .

ns8:ont00001016
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Lithosphere&oldid=1143215085"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/GeospatialOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Portion of Lithosphere"@en ;
    rdfs:subClassOf ns1:BFO_0000024 ;
    skos:definition "A fiat object part of the rigid, outermost rocky shell of a natural satellite."@en .

ns8:ont00001017
    ns8:ont00001754 "Schlosser, Markus, \"Agency\", The Stanford Encyclopedia of Philosophy (Winter 2019 Edition), Edward N. Zalta (ed.), available at: https://plato.stanford.edu/archives/win2019/entries/agency/"@en ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI ;
    owl:equivalentClass _:nimportcommonb436 ;
    rdf:type owl:Class ;
    rdfs:label "Agent"@en ;
    rdfs:subClassOf ns1:BFO_0000040 ;
    skos:definition "A Material Entity that bears an Agent Capability."@en .

ns8:ont00001018
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Equipment Cooling System"@en ;
    rdfs:subClassOf ns8:ont00000350 ;
    skos:definition "A Cooling System that is designed to cool some piece of equipment."@en .

ns8:ont00001019
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Steering Control System"@en ;
    rdfs:subClassOf ns8:ont00000723 ;
    skos:definition "A Vehicle Control System that is designed to control the direction some Vehicle is traveling."@en .

ns8:ont00001020
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Portion of Gaseous Fuel"@en ;
    rdfs:subClassOf ns8:ont00000838 ;
    skos:definition "A Portion of Fuel that is stored in a gaseous state."@en .

ns8:ont00001021
    ns8:ont00001754 "http://www.merriam-webster.com/dictionary/denial" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Act of Denying"@en ;
    rdfs:subClassOf ns8:ont00000379 ;
    skos:definition "An Act of Representative Communication performed by either asserting that something is not true or real or refusing to satisfy a request or desire."@en .

ns8:ont00001022
    ns8:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI ;
    owl:disjointWith ns8:ont00001364 ;
    owl:equivalentClass _:nimportcommonb440 ;
    rdf:type owl:Class ;
    rdfs:comment "Four of the subtypes of measurements used here (Interval, Nominal, Ordinal, and Ratio) were originally defined by S.S. Stevens in the article \"On the Theory of Scales of Measurement\" in Science, Vol. 103 No. 2684 on June 7, 1946. For an introductory article with links to additional content including criticisms and alternate classifications of measurements see https://en.wikipedia.org/wiki/Level_of_measurement"@en ;
    rdfs:label "Ratio Measurement Information Content Entity"@en ;
    rdfs:subClassOf ns8:ont00001163 ;
    skos:definition "A Measurement Information Content Entity that consists of a symbol that places a Quality of an Entity onto an interval scale having a true zero value."@en ;
    skos:example "The sentence \"The temperature reached 240.372 degrees Kelvin on January 20, 1985 in Chicago, IL.\" is the carrier of a ratio measurement as 0 degrees on the Kelvin scale does describe absolute zero."@en, "a measurement of the barometric pressure at 1,000 feet above sea level", "a measurement of the measure of air temperature on the Kelvin scale", "a measurement of the number of members in an Organization" .

ns8:ont00001023
    ns8:ont00001754 "http://wordnetweb.princeton.edu/perl/webwn?s=calendar+week" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/TimeOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Calendar Week"@en ;
    rdfs:subClassOf ns8:ont00000619 ;
    skos:definition "A Week that begins and ends concurrently with the Days specified by a Calendar System to be the first and last Days of the Week."@en .

ns8:ont00001024
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Spark Ignition Engine"@en ;
    rdfs:subClassOf ns8:ont00000394 ;
    skos:definition "An Internal Combustion Engine that is designed to operate by generating a spark to ignite a portion of Fuel and Oxidizer mixture."@en .

ns8:ont00001025
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Electric_generator&oldid=1057805035"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Electric Generator"@en ;
    rdfs:subClassOf ns8:ont00001049 ;
    skos:definition "An Electrical Power Source that is designed to convert mechanical energy to electrical energy for use in an external circuit."@en .

ns8:ont00001026
    ns8:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Pointing Orientation"@en ;
    rdfs:subClassOf ns8:ont00000119 ;
    skos:altLabel "Facing Orientation"@en ;
    skos:definition "A Spatial Orientation of a Material Entity in which one or more of its designated components are oriented toward a specified direction."@en .

ns8:ont00001027
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Trim_tab&oldid=1054550485"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Trim Tab"@en ;
    rdfs:subClassOf ns8:ont00000095 ;
    skos:definition "A Control Surface that is designed to counteract hydro-, aerodynamic, or other forces in order to stabilize the Vehicle it is part of in the desired Attitude."@en .

ns8:ont00001028
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Mechanical_wave&oldid=1057233679"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Mechanical Wave Process"@en ;
    rdfs:subClassOf ns8:ont00000099 ;
    skos:definition "A Wave Process that involves Oscillation of a portion of matter such that energy is transferred through the material medium."@en .

ns8:ont00001029
    ns8:ont00001754 "https://en.wikipedia.org/wiki/Rocket_(weapon)" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Unguided Rocket"@en ;
    rdfs:subClassOf ns8:ont00001150 ;
    skos:altLabel "Rocket"@en ;
    skos:definition "A Portion of Ammunition that is designed to be a self-propelled, but unguided, projectile that delivers some payload (explosive or other) over relatively long distances through the use of a Rocket Engine."@en .

ns8:ont00001030
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Train&oldid=1064071492"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Train"@en ;
    rdfs:subClassOf ns8:ont00000796 ;
    skos:altLabel "Railroad Train"@en, "Railway Train"@en ;
    skos:definition "A Rail Transport Vehicle that consists of a series of connected Train Cars or Railcars."@en .

ns8:ont00001031
    ns8:ont00001754 "http://www.merriam-webster.com/dictionary/volunteer" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Act of Volunteering"@en ;
    rdfs:subClassOf ns8:ont00001162 ;
    skos:definition "An Act of Commissive Communication performed by voluntarily undertaking or expressing a willingness to undertake a service."@en ;
    skos:example "entering into military service voluntarily", "rendering a service voluntarily" .

ns8:ont00001032
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Assignment_(law)&oldid=1056101591"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Act of Assignment"@en ;
    rdfs:subClassOf ns8:ont00001374 ;
    skos:definition "An Act of Declarative Communication in which rights held by one party (the assignor) are transferred to another party (the assignee) with regard to a particular entity as specified by the details of the assignment, which is often prescribed by a contract."@en .

ns8:ont00001033
    ns8:ont00001754 "http://purl.org/obo/owl/PATO#PATO_0000047" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Biological Sex"@en ;
    rdfs:subClassOf ns1:BFO_0000019 ;
    skos:definition "A Quality inhering in a bearer by virtue of the bearer's ability to undergo sexual reproduction in order to differentiate the individuals or types involved."@en .

ns8:ont00001034
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Full Motion Video Camera"@en ;
    rdfs:subClassOf ns8:ont00000774 ;
    skos:definition "A Video Camera that is designed to capture and record images of sufficiently high quality and in rapid enough succession that the resulting video supports smooth playback."@en .

ns8:ont00001035
    ns8:ont00001760 "https://www.commoncoreontologies.org/GeospatialOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Pitch Axis"@en ;
    rdfs:subClassOf ns8:ont00000387 ;
    skos:altLabel "Lateral Axis"@en ;
    skos:definition "An Axis of Rotation that passes through the center of an object's Mass and is perpendicular both to the direction of the object's motion and to the object's Yaw Axis."@en .

ns8:ont00001036
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Communications_system&oldid=1058600948"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Communication System"@en ;
    rdfs:subClassOf ns8:ont00000995 ;
    skos:definition "A Material Artifact that is designed to enable some Act of Communication by means of transmission systems, relay stations, tributary stations, and data terminal equipment, usually capable of interconnection and interoperation to form an integrated whole."@en .

ns8:ont00001037
    ns8:ont00001760 "https://www.commoncoreontologies.org/GeospatialOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Constructed Feature"@en ;
    rdfs:subClassOf ns8:ont00001197 ;
    skos:definition "An Anthropogenic Feature that has been constructed by deliberate human effort."@en .

ns8:ont00001038
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Nickel%E2%80%93cadmium_battery&oldid=1061809659"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Nickel Cadmium Electric Battery"@en ;
    rdfs:subClassOf ns8:ont00001105 ;
    skos:altLabel "NiCad Battery"@en ;
    skos:definition "A Secondary Cell Electric Battery that has a cadmium anode and nickel oxide hydroxide cathode."@en .

ns8:ont00001039
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Loan&oldid=1063513958"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Act of Repayment"@en ;
    rdfs:subClassOf ns8:ont00000836 ;
    skos:definition "An Act of Financial Instrument Use wherein a Financial Instrument is transferred by an Agent (the Debtor) to another Agent (the Creditor) to decrease the amount the Debtor owes to the Creditor from an earlier Act of Loaning."@en .

ns8:ont00001040
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Nadir&oldid=1057007248"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/GeospatialOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Nadir"@en ;
    rdfs:subClassOf ns1:BFO_0000026 ;
    skos:definition "A One-Dimensional Spatial Region that extends from a given location downward along the local vertical direction pointing in the direction of the apparent Gravitational Force at that location."@en .

ns8:ont00001041
    ns8:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Sequence Position Ordinality"@en ;
    rdfs:subClassOf ns8:ont00001010 ;
    skos:definition "An Ordinal Measurement Information Content Entity that is about the position of some entity in some ordered sequence."@en .

ns8:ont00001042
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Equipment Mount"@en ;
    rdfs:subClassOf ns8:ont00000995 ;
    skos:definition "A Material Artifact that is designed to support an Artifact."@en .

ns8:ont00001043
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Aircraft&oldid=1063924562"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Aircraft"@en ;
    rdfs:subClassOf ns8:ont00000713 ;
    skos:definition "A Vehicle that is designed to convey passengers, cargo, or equipment from one location to another by air travel."@en .

ns8:ont00001044
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Nuclear Radiation Detection Artifact Function"@en ;
    rdfs:subClassOf ns8:ont00000323 ;
    skos:definition "An Artifact Function that is realized during events in which an Artifact is used to detect the presence of nuclear radiation particles."@en .

ns8:ont00001045
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Artifact Model"@en ;
    rdfs:subClassOf ns8:ont00000319 ;
    skos:definition "A Directive Information Content Entity that prescribes a common set of Functions and Qualities to inhere in a set of artifact instances."@en .

ns8:ont00001046
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Notification Message"@en ;
    rdfs:subClassOf ns8:ont00001002 ;
    skos:definition "A Message that is designed to bear an Information Content Entity that describes a scenario that has been determined to merit attention by the recipient."@en .

ns8:ont00001047
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Frequency&oldid=1062800545"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Frequency"@en ;
    rdfs:subClassOf ns1:BFO_0000144 ;
    skos:altLabel "Temporal Frequency"@en ;
    skos:definition "A Process Profile that is characterized by the number of repetitive processes during a particular time period."@en .

ns8:ont00001048
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Increase of Dependent Continuant"@en ;
    rdfs:subClassOf ns8:ont00000004 ;
    skos:definition "A Change in which some Independent Continuant has an increase in the level of some Dependent Continuant that it bears."@en .

ns8:ont00001049
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Electrical Power Source"@en ;
    rdfs:subClassOf ns8:ont00000288 ;
    skos:definition "A Power Source that is designed to generate, control, and transfer power in the form of electrical energy."@en .

ns8:ont00001050
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Primary_cell&oldid=1047226932"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Primary Cell Electric Battery"@en ;
    rdfs:subClassOf ns8:ont00000716 ;
    skos:altLabel "Primary Cell Battery"@en ;
    skos:definition "A Electric Battery that is designed for one-time use and not to be recharged."@en .

ns8:ont00001051
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Projectile&oldid=1062048285"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Projectile Launcher"@en ;
    rdfs:subClassOf ns8:ont00000445 ;
    skos:definition "A Weapon that is designed to inflict damage or harm by means of launching a high-velocity projectile at a target."@en .

ns8:ont00001052
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Military&oldid=1063431234"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Military Facility"@en ;
    rdfs:subClassOf ns8:ont00000192 ;
    skos:definition "A Facility that is designed to support a Military Force."@en .

ns8:ont00001053
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Act of Collision"@en ;
    rdfs:subClassOf ns8:ont00000065 ;
    skos:definition "An Act of Location Change involving the movement of one object such that it collides with another object."@en .

ns8:ont00001054
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Helical_antenna&oldid=1062343033"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Helical Antenna"@en ;
    rdfs:subClassOf ns8:ont00000499 ;
    skos:definition "A Wire Antenna that consists of a conducting wire wound in the form of a helix that is typically mounted over a ground plane with a feed line connected between the bottom of the helix and the ground plane."@en .

ns8:ont00001055
    ns8:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Branched"@en ;
    rdfs:subClassOf ns8:ont00001059 ;
    skos:definition "A Shape Quality inhering in a bearer in virtue of the bearer having subdivisions or offshoots."@en .

ns8:ont00001056
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Light&oldid=1062630851"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:comment "Visible light overlaps with near infrared and near ultraviolet."@en ;
    rdfs:label "Visible Light Frequency"@en ;
    rdfs:subClassOf ns8:ont00000754 ;
    skos:definition "An Electromagnetic Radiation Frequency of some Electromagnetic Wave that is between 400 and 800 terahertz."@en .

ns8:ont00001057
    ns8:ont00001754 "JC3IEDM-MIRD-DMWG-Edition_3.0.2_20090514" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Act of Issuing Mass Media Press Release"@en ;
    rdfs:subClassOf ns8:ont00000588 ;
    skos:definition "An Act of Mass Media Communication involving sending forth, distributing, or putting into circulation an official statement issued to one or more members of the media for the purpose of announcing newsworthy information."@en .

ns8:ont00001058
    ns8:ont00001754 "http://wordnetweb.princeton.edu/perl/webwn?s=hour" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/TimeOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Hour"@en ;
    rdfs:subClassOf _:nimportcommonb444, ns1:BFO_0000202 ;
    skos:definition "A Temporal Interval that is equal to sixty consecutive Minutes."@en .

ns8:ont00001059
    ns8:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Shape Quality"@en ;
    rdfs:subClassOf ns1:BFO_0000019 ;
    skos:definition "A Quality that inheres in a bearer in virtue of the ratios between dimensions of external features of that bearer."@en .

ns8:ont00001060
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Aircraft_fuel_system&oldid=1003132173"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Fuel System"@en ;
    rdfs:subClassOf ns8:ont00000995 ;
    skos:definition "A Material Artifact that is designed to pump, manage, and deliver some Portion of Fuel to the Propulsion System and Auxiliary Power Unit of some Vehicle."@en .

ns8:ont00001061
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Motorcycle&oldid=1063743553"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Motorcycle"@en ;
    rdfs:subClassOf ns8:ont00000053 ;
    skos:altLabel "Motorbike"@en ;
    skos:definition "A Ground Motor Vehicle that is designed to transport a very small number of passengers (usually 1 or 2) while traveling on two or three tired wheels."@en .

ns8:ont00001062
    dcterms:bibliographicCitation "The International Community. 5 Apr. 2023, https://dictionary.cambridge.org/us/dictionary/english/international-community." ;
    dcterms:created "2022-12-30T21:32:27-05:00"^^xsd:dateTime ;
    dcterms:creator "https://cubrc.org"^^xsd:anyURI ;
    ns8:ont00001754 "https://dictionary.cambridge.org/us/dictionary/english/international-community" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "International Community"@en ;
    rdfs:subClassOf ns8:ont00000300 ;
    skos:definition "A maximal Group of Geopolitical Organizations engaged in geopolitics with one another."@en ;
    skos:prefLabel "International Community"@en .

ns8:ont00001063
    ns8:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Straight"@en ;
    rdfs:subClassOf ns8:ont00001059 ;
    skos:altLabel "Linear"@en ;
    skos:definition "A Shape Quality inhering in a bearer in virtue of the bearer not having curves, bends, or angles along its borders."@en .

ns8:ont00001064
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Barcode&oldid=1059844765"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:comment "For information on types of barcodes, see: https://www.scandit.com/types-barcodes-choosing-right-barcode/"@en ;
    rdfs:label "Barcode"@en ;
    rdfs:subClassOf ns8:ont00000798 ;
    skos:definition "An Information Bearing Artifact that is designed to bear one or more geometric shapes that concretize some Directive Information Content Entity."@en .

ns8:ont00001065
    ns8:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Two Dimensional Extent"@en ;
    rdfs:subClassOf ns8:ont00001202 ;
    skos:altLabel "Area"@en ;
    skos:definition "A Size Quality that inheres in a bearer in virtue of the bearer's extension in two dimensions."@en .

ns8:ont00001066
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Loss of Disposition"@en ;
    rdfs:subClassOf ns8:ont00000250 ;
    skos:definition "A Loss of Realizable Entity in which some Independent Continuant ceases to be the bearer of some Disposition."@en .

ns8:ont00001067
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Laser&oldid=1059215159"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Laser"@en ;
    rdfs:subClassOf ns8:ont00000995 ;
    skos:definition "A Material Artifact that is designed to emit light coherently through a process of optical amplification based on the stimulated emission of electromagnetic radiation."@en .

ns8:ont00001068
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Gain of Quality"@en ;
    rdfs:subClassOf _:nimportcommonb445, ns8:ont00000395 ;
    skos:definition "A Gain of Specifically Dependent Continuant in which an Independent Continuant becomes the bearer of some Quality."@en ;
    skos:example "A person becoming pregnant." .

ns8:ont00001069
    ns8:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI ;
    owl:disjointWith ns8:ont00001163 ;
    owl:equivalentClass _:nimportcommonb450 ;
    rdf:type owl:Class ;
    rdfs:label "Representational Information Content Entity"@en ;
    rdfs:subClassOf ns8:ont00000958 ;
    skos:definition "An Information Content Entity that represents some Entity."@en ;
    skos:example "the content of a court transcript represents a courtroom proceeding", "the content of a photograph of the Statue of Liberty represents the Statue of Liberty", "the content of a video of a sporting event represents that sporting event" .

ns8:ont00001070
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Fluid Control Artifact Function"@en ;
    rdfs:subClassOf ns8:ont00000323 ;
    skos:definition "An Artifact Function that is realized in processes in which some Artifact is used to control the direction or flow of some fluid."@en .

ns8:ont00001071
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Payload&oldid=1035953573"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Payload Capacity"@en ;
    rdfs:subClassOf _:nimportcommonb454, ns8:ont00000323 ;
    skos:definition "An Artifact Function that inheres in a Vehicle that is designed to transport Payload, and which is typically characterized by the maximum Weight, Mass, or Volume of Payload that the Vehicle can transport."@en .

ns8:ont00001072
    ns8:ont00001754 "International Telecommunication Union (ITU) Region 2" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "FM Radio Broadcast Frequency"@en ;
    rdfs:subClassOf ns8:ont00000169 ;
    skos:altLabel "Frequency Modulation Radio Broadcast Frequency"@en ;
    skos:definition "A Very High Frequency that is between 88 and 108 MHz."@en .

ns8:ont00001073
    ns8:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Financial Value of Property"@en ;
    rdfs:subClassOf ns8:ont00000608 ;
    skos:altLabel "Property Value"@en ;
    skos:definition "Financial Value that inheres in an material entity that is the object of an Act of Ownership."@en .

ns8:ont00001074
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Act of Educational Training Acquisition"@en ;
    rdfs:subClassOf ns8:ont00000687 ;
    skos:definition "An Act of Training Acquisition performed by an Agent by acquiring knowledge of a curriculum from an Agent or communication medium that realizes a capacity derived from its affiliation with some Educational Organization."@en .

ns8:ont00001075
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Act of Training Instruction"@en ;
    rdfs:subClassOf ns8:ont00000234 ;
    skos:definition "An Act of Training performed by an Agent by imparting knowledge to another Agent."@en .

ns8:ont00001076
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Power_station&oldid=1052973815"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Electric Power Station"@en ;
    rdfs:subClassOf ns8:ont00000192 ;
    skos:altLabel "Power Plant"@en ;
    skos:definition "A Facility that is designed to generate electrical power."@en .

ns8:ont00001077
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Heavy_machine_gun&oldid=1047303735"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Heavy Machine Gun"@en ;
    rdfs:subClassOf ns8:ont00000848 ;
    skos:definition "A Mounted Gun that is designed to fire ammunition greater than .50 caliber or 12.7mm ammunition in quick succession from an ammunition belt, and which typically weighs more than 30lbs."@en .

ns8:ont00001078
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Airport&oldid=1063243963"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Airport"@en ;
    rdfs:subClassOf ns8:ont00000226 ;
    skos:definition "A Transportation Facility that is designed for launching, receiving, and housing Aircraft."@en .

ns8:ont00001079
    ns8:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Blond"@en ;
    rdfs:subClassOf ns8:ont00000378 ;
    skos:definition "A Color that ranges from nearly white to a light greyish yellow"@en .

ns8:ont00001080
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Electromagnetic_spectrum&oldid=1063851392"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Far Infrared Light Frequency"@en ;
    rdfs:subClassOf ns8:ont00001337 ;
    skos:definition "An Infrared Light Frequency that is between 300 gigahertz and 20 terahertz."@en .

ns8:ont00001081
    ns8:ont00001760 "https://www.commoncoreontologies.org/GeospatialOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Geographic Feature"@en ;
    rdfs:subClassOf ns8:ont00000574 ;
    skos:definition "An Environmental Feature that is a natural (i.e. not human made) topographical feature having a (relatively) stable location in some Geospatial Region which can be designated by location-specific data."@en .

ns8:ont00001082
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Patch Receiver"@en ;
    rdfs:subClassOf ns8:ont00001145 ;
    skos:definition "A Radio Receiver that uses a Patch Antenna to intercept radio signals."@en .

ns8:ont00001083
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Engine&oldid=1063879193"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Air-Breathing Combustion Engine"@en ;
    rdfs:subClassOf ns8:ont00000056 ;
    skos:definition "A Reaction Engine that functions by drawing a continuous stream of air into and through the Engine where it is compressed, mixed with a Portion of Fuel, ignited, and then expelled as exhaust gas."@en .

ns8:ont00001084
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Portion of Processed Material"@en ;
    rdfs:subClassOf ns8:ont00000995 ;
    skos:definition "A Material Artifact that is the output of an Act of Artifact Processing."@en .

ns8:ont00001085
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Reflection Artifact Function"@en ;
    rdfs:subClassOf ns8:ont00000323 ;
    skos:definition "An Artifact Function that is realized by an Artifact participating in a reflection event in which the Artifact causes a change in a wavefront at an interface between the reflecting medium and the transmission medium such that the wavefront returns into the transmission medium."@en .

ns8:ont00001086
    ns8:ont00001754 "https://en.wikipedia.org/wiki/Junction_(road)" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Road Junction"@en ;
    rdfs:subClassOf ns8:ont00001326 ;
    skos:definition "A Land Transportation Artifact that is designed to enable Ground Vehicles to exit one Road and enter another."@en .

ns8:ont00001087
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Orientation Observation Artifact Function"@en ;
    rdfs:subClassOf ns8:ont00001306 ;
    skos:altLabel "Attitude Observation Artifact Function"@en ;
    skos:definition "An Observation Artifact Function that is realized during events in which an Artifact is used to collect information about the Orientation of a specified object or class of objects."@en .

ns8:ont00001088
    ns8:ont00001754 "http://wordnetweb.princeton.edu/perl/webwn?s=decade" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/TimeOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Decade"@en ;
    rdfs:subClassOf ns1:BFO_0000202 ;
    skos:definition "A Temporal Interval that is equal to a period of ten consecutive Years."@en .

ns8:ont00001089
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Petrochemical&oldid=1060574535"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Petrochemical Refinery"@en ;
    rdfs:subClassOf ns8:ont00001283 ;
    skos:definition "A Refinery that is designed for refining crude oil, intermediate petroleum products, or synthetic petroleum into products of value."@en .

ns8:ont00001090
    ns8:ont00001760 "https://www.commoncoreontologies.org/UnitsOfMeasureOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Measurement Unit of Pressure"@en ;
    rdfs:subClassOf ns8:ont00000120 ;
    skos:definition "A Measurement Unit that is used as a standard for measurement of Force applied perpendicular to a surface per unit area."@en ;
    skos:example "pascal, atmosphere, pound-force per square inch" .

ns8:ont00001091
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Fortification&oldid=1060156408"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Fort"@en ;
    rdfs:subClassOf ns8:ont00001052 ;
    skos:definition "A Military Facility that is designed to support the defense of or solidification of rule over some Geospatial Region and its inhabitants."@en .

ns8:ont00001092
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Electrical Power Storage Artifact Function"@en ;
    rdfs:subClassOf ns8:ont00000098 ;
    skos:altLabel "Capacitance"@en ;
    skos:definition "An Electrical Artifact Function that is realized during events in which an Artifact is used to store electrical power to be released at a later time."@en .

ns8:ont00001093
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Coin"@en ;
    rdfs:subClassOf ns8:ont00000475 ;
    skos:definition "A Portion of Cash that consists of a flat, portable, round pieces of metal designed to bear some specified Financial Value."@en .

ns8:ont00001094
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Espionage&oldid=1062702647"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Act of Espionage"@en ;
    rdfs:subClassOf ns8:ont00001251 ;
    skos:definition "An Act of Intelligence Gathering involving the obtaining of information that is considered secret or confidential without the permission of the holder of the information."@en .

ns8:ont00001095
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Cellular_network&oldid=1061429562"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Cellular Telecommunication Network"@en ;
    rdfs:subClassOf ns8:ont00000363 ;
    skos:altLabel "Cellular Network"@en, "Mobile Telecommunication Network"@en ;
    skos:definition "A Wireless Telecommunication Network where the last link between the network and the end user is wireless and is distributed over service areas called cells."@en .

ns8:ont00001096
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Submachine_gun&oldid=1063939013"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Submachine Gun"@en ;
    rdfs:subClassOf ns8:ont00001104 ;
    skos:definition "An Long Gun that is designed to be have automatic-fire functionality, fire pistol-caliber ammunition that is magazine-fed, and which is usually smaller than other automatic firearms."@en .

ns8:ont00001097
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Common Stock"@en ;
    rdfs:subClassOf ns8:ont00001278 ;
    skos:definition "Stock that entitles its holder to voting on corporate decisions."@en .

ns8:ont00001098
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Hospital&oldid=1063047817"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Hospital"@en ;
    rdfs:subClassOf ns8:ont00000055 ;
    skos:definition "A Healthcare Facility that is designed to provide patient treatment with specialized staff and equipment."@en .

ns8:ont00001099
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Bridge&oldid=1061858310" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Bridge"@en ;
    rdfs:subClassOf ns8:ont00001326 ;
    skos:definition "A Land Transportation Artifact that is designed to span physical obstacles without closing the way underneath to enable Persons or Ground Vehicles to pass over the obstacles."@en .

ns8:ont00001100
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Measurement Artifact Function"@en ;
    rdfs:subClassOf ns8:ont00000323 ;
    skos:definition "An Artifact Function that is realized during events in which an Artifact is used to measure one or more features of a specified object or class of objects."@en .

ns8:ont00001101
    ns8:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Interval Estimate Information Content Entity"@en ;
    rdfs:subClassOf ns8:ont00001176 ;
    skos:altLabel "Interval Estimate Measurement Information Content Entity"@en, "Interval Estimate"@en ;
    skos:definition "An Estimate Information Content Entity that consists of an interval of possible (or probable) values for the measured entity."@en .

ns8:ont00001102
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Commerce&oldid=1063120985"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Commercial Facility"@en ;
    rdfs:subClassOf ns8:ont00000192 ;
    skos:definition "A Facility that is designed for buying and selling goods and services, especially on a large scale."@en .

ns8:ont00001103
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    owl:equivalentClass _:nimportcommonb455 ;
    rdf:type owl:Class ;
    rdfs:label "Artifact Model Name"@en ;
    rdfs:subClassOf ns8:ont00000686 ;
    skos:definition "A Designative Information Content Entity that designates some Artifact Model."@en .

ns8:ont00001104
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Long_gun&oldid=1063715506"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Long Gun"@en ;
    rdfs:subClassOf ns8:ont00000088 ;
    skos:definition "A Firearm that is designed to have a longer barrel than a Hand Gun and to be fired while braced against the shoulder."@en .

ns8:ont00001105
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Rechargeable_battery&oldid=1064096406"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Secondary Cell Electric Battery"@en ;
    rdfs:subClassOf ns8:ont00000716 ;
    skos:altLabel "Rechargeable Battery"@en, "Secondary Cell Battery"@en ;
    skos:definition "An Electric Battery that is designed to be recharged."@en .

ns8:ont00001106
    ns8:ont00001760 "https://www.commoncoreontologies.org/GeospatialOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Roll Axis"@en ;
    rdfs:subClassOf ns8:ont00000387 ;
    skos:altLabel "Longitudinal Axis"@en ;
    skos:definition "An Axis of Rotation that passes through the center of an object's Mass from the front to the back of the object as defined by the direction of the object's motion."@en .

ns8:ont00001107
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Landfill&oldid=1058364420"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Landfill"@en ;
    rdfs:subClassOf ns8:ont00001315 ;
    skos:definition "A Waste Management Facility that is designed for disposing of waste by burial."@en .

ns8:ont00001108
    ns8:ont00001753 "UHF" ;
    ns8:ont00001754 "International Telecommunication Union (ITU)" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:comment """The corresponding Wavelength range is 1–0.1 m.

Note that the ITU definition of UHF is broader than the definition given by IEEE 521-2002 - IEEE Standard Letter Designations for Radar-Frequency Bands, which sets the frequency range at 300 MHz to 1 GHz."""@en ;
    rdfs:label "Ultra High Frequency"@en ;
    rdfs:subClassOf ns8:ont00000732 ;
    skos:altLabel "ITU Band Number 9"@en ;
    skos:definition "A Microwave Frequency that is between 300 MHz and 3 GHz."@en .

ns8:ont00001109
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Counter-Clockwise Rotational Motion"@en ;
    rdfs:subClassOf ns8:ont00000368 ;
    skos:altLabel "Anti-Clockwise Rotation"@en, "CCW Rotational Motion"@en, "Counter-Clockwise Rotation"@en ;
    skos:definition "A Rotational Motion in which the direction of rotation is toward the left as seen relative to the designated side of the plane of rotation."@en ;
    skos:example "the axial rotation of the Earth as seen from above the North Pole" .

ns8:ont00001110
    ns8:ont00001760 "https://www.commoncoreontologies.org/TimeOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Evening"@en ;
    rdfs:subClassOf ns1:BFO_0000202 ;
    skos:definition "A Temporal Interval that consists of the temporal regions between when the sun sets (approximately 6:00pm) and when people typically retire to sleep (approximately 9:00pm)."@en .

ns8:ont00001111
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Low Midrange Frequency"@en ;
    rdfs:subClassOf ns8:ont00000530 ;
    skos:definition "A Sonic Frequency that is between 250 and 500 Hz."@en .

ns8:ont00001112
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Proper_acceleration&oldid=1058169867"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Proper Acceleration"@en ;
    rdfs:subClassOf ns8:ont00000712 ;
    skos:definition "An Acceleration of an object relative to a free-fall, or inertial, observer who is momentarily at rest relative to the object being measured (hence, gravity does not cause Proper Acceleration)."@en .

ns8:ont00001113
    ns8:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Magenta"@en ;
    rdfs:subClassOf ns8:ont00000378 ;
    skos:definition "A Color consisting of red and blue hues."@en .

ns8:ont00001114
    ns8:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI ;
    owl:disjointWith ns8:ont00001203 ;
    rdf:type owl:Class ;
    rdfs:comment "Instances of this class are not proper Delimiting Domains, but in some cases may have an organization that exercises some control over the region, such as the homeowners' association for a neighborhood."@en ;
    rdfs:label "Division of Delimiting Domain"@en ;
    rdfs:subClassOf _:nimportcommonb459, ns8:ont00000472 ;
    skos:definition "A Geospatial Region that is a fiat division of a Delimiting Domain and not a Delimiting Domain."@en ;
    skos:example "Flatbush, French Quarter, Western New York, Texas Panhandle, Greater Montreal Area of Quebec, Pacific Northwest, southwest area of Al Anbar Province, Northern Iraq." .

ns8:ont00001115
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Telephone_network&oldid=1046265527"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Private Network Telephone Call"@en ;
    rdfs:subClassOf ns8:ont00001190 ;
    skos:definition "A Telephone Call transmitted over a network where a closed group of telephones are connected primarily to each other and use a gateway to reach the outside world, usually used inside companies and call centers (a.k.a. private branch exchange (PBX))."@en .

ns8:ont00001116
    ns8:ont00001754 "https://en.wikipedia.org/wiki/Epoch_(reference_date)" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/TimeOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Reference Time"@en ;
    rdfs:subClassOf ns1:BFO_0000203 ;
    skos:altLabel "Epoch Time"@en, "Epoch"@en, "Reference Date"@en ;
    skos:definition "A Temporal Instant specified as the origin for which other Temporal Regions are measured or identified."@en .

ns8:ont00001117
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Propelling_nozzle&oldid=1061239812"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Propelling Nozzle"@en ;
    rdfs:subClassOf ns8:ont00000252 ;
    skos:altLabel "Jet Nozzle"@en ;
    skos:definition "A Nozzle that is used to convert a propulsion Engine into a Jet Engine and functions by using its narrowest part, the throat, to increase Pressure within the Engine by constricting flow, usually until the flow chokes, then expanding the exhaust stream to, or near to, atmospheric pressure, while forming it into a high speed jet to propel the Vehicle."@en .

ns8:ont00001118
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Surface_tension&oldid=1062753527"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Surface Tension"@en ;
    rdfs:subClassOf ns1:BFO_0000016 ;
    skos:definition "A Disposition that inheres in a liquid and is realized when the cohesive forces of the molecules in the bearer at the surface are greater than the adhesive forces of the molecules in the surrounding air."@en .

ns8:ont00001119
    ns8:ont00001754 "https://en.wikipedia.org/wiki/Form_(document)" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Document Form"@en ;
    rdfs:subClassOf ns8:ont00001298 ;
    skos:definition "A Document having Document Fields as parts in which to write or select prescribed content."@en .

ns8:ont00001120
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Act of Religious Training Instruction"@en ;
    rdfs:subClassOf ns8:ont00001075 ;
    skos:definition "An Act of Training Instruction performed by an Agent who realizes a capacity derived from the Agent's affiliation with some Religious Organization by imparting knowledge of the tenets and/or practices of a religion to an Agent either directly or indirectly through some communication medium."@en .

ns8:ont00001121
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Scramjet&oldid=1062429697"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Scramjet Engine"@en ;
    rdfs:subClassOf ns8:ont00000294 ;
    skos:altLabel "Scramjet"@en, "Supersonic Combusting Ramjet"@en ;
    skos:definition "An Air-Breathing Jet Engine that uses the forward motion of the Engine to compress incoming air at supersonic speeds before adding the fuel and constantly combusting the mixture then expelling the exhaust out through the rear Propelling Nozzle to generate Thrust."@en .

ns8:ont00001122
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Radio Interference"@en ;
    rdfs:subClassOf ns8:ont00000007 ;
    skos:definition "A Natural Process in which a radio signal is disrupted, whether unintentionally or as the result of an Act of Radio Jamming, Act of Radio Spoofing, or similar Planned Act."@en .

ns8:ont00001123
    ns8:ont00001754 "http://www.dictionary.com/browse/poison" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Poison Artifact Function"@en ;
    rdfs:subClassOf ns8:ont00001153 ;
    skos:definition "A Damaging Artifact Function that is realized in a process which causes illness in, or the death of, a living thing."@en .

ns8:ont00001124
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Missile&oldid=1062028589"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Precision-Guided Missile"@en ;
    rdfs:subClassOf ns8:ont00001150 ;
    skos:altLabel "Missile"@en ;
    skos:definition "A Portion of Ammunition that is designed to be a self-propelled and precision-guided projectile that delivers some payload (explosive or other) over relatively long distances."@en .

ns8:ont00001125
    ns8:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Set of Eyes"@en ;
    rdfs:subClassOf _:nimportcommonb460, ns8:ont00000084 ;
    skos:definition "A Bodily Component that consists of two or more Eyes that are part of a single Agent."@en .

ns8:ont00001126
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Luminescence&oldid=1050169944"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:comment "There are a variety of photometric measurements, such as luminous flux/power or luminous intensity, whose units are lumen and candela respectively, which attempt to describe properties associated with the perception of light. These are weighted measurements, typically by the luminosity function, as thus exist on the side of information content. It is a point of further development to add the needed intrinsic properties of radiation that such measurements are about."@en ;
    rdfs:label "Luminescent Property"@en ;
    rdfs:subClassOf ns8:ont00000784 ;
    skos:definition "An Optical Property that inheres in a bearer in virtue of that bearer's capacity to emit visible light, but which isn't the result of the bearer being heated."@en .

ns8:ont00001127
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Loss of Quality"@en ;
    rdfs:subClassOf ns8:ont00000865 ;
    skos:definition "A Loss of Specifically Dependent Continuant in which some Independent Continuant ceases to be the bearer of some Quality."@en .

ns8:ont00001128
    ns8:ont00001754 "http://www.thefreedictionary.com/reside" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Act of Residing"@en ;
    rdfs:subClassOf ns8:ont00000676 ;
    skos:definition "An Act of Inhabitancy in which a Person lives in a dwelling permanently or for an extended period of time."@en .

ns8:ont00001129
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Pressurization Control Artifact Function"@en ;
    rdfs:subClassOf ns8:ont00000113 ;
    skos:definition "A Ventilation Control Artifact Function that is realized by processes in which some Artifact is used to control the partial pressure of air in some space."@en .

ns8:ont00001130
    ns8:ont00001760 "https://www.commoncoreontologies.org/GeospatialOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Geospatial Polygon"@en ;
    rdfs:subClassOf ns8:ont00000817 ;
    skos:definition "A Geospatial Line String that has at least three vertices where the connecting lines form a closed loop."@en .

ns8:ont00001131
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "EAN-8 Barcode"@en ;
    rdfs:subClassOf ns8:ont00000966 ;
    skos:definition "An EAN Barcode that consists of 8 numerical digits and is used to designate products at the point of sale."@en .

ns8:ont00001132
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Stasis of Mission Capability"@en ;
    rdfs:subClassOf ns8:ont00000246 ;
    skos:definition "A Stasis of Realizable Entity that holds during a temporal interval when a Continuant's capability (or lack thereof) to perform its intended Functions, tasks, or Objectives remains at a relatively constant level."@en .

ns8:ont00001133
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Motion"@en ;
    rdfs:subClassOf ns8:ont00000007 ;
    skos:definition "A Natural Process in which a Continuant changes its Location or Spatial Orientation over some Temporal Interval."@en .

ns8:ont00001134
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Vehicle_frame&oldid=1054003530"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Vehicle Frame"@en ;
    rdfs:subClassOf ns8:ont00000995 ;
    skos:definition "A Material Artifact that is designed to be the main supporting structure of some Vehicle."@en .

ns8:ont00001135
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Portion of Liquid Fuel"@en ;
    rdfs:subClassOf ns8:ont00000838 ;
    skos:definition "A Portion of Fuel that is stored in a liquid state."@en .

ns8:ont00001136
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Ultrasonic Frequency"@en ;
    rdfs:subClassOf ns8:ont00000008 ;
    skos:definition "A Sound Frequency that is greater than 20 kHz."@en .

ns8:ont00001137
    ns8:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Radiation Reflectivity"@en ;
    rdfs:subClassOf ns8:ont00000628 ;
    skos:definition "An Electromagnetic Radiation Property that inheres in a bearer in virtue of the capacity of that bearer to scatter or reflect electromagnetic radiation of a given frequency."@en .

ns8:ont00001138
    ns8:ont00001754 "Adapted from: https://en.wikipedia.org/wiki/Beverage_antenna" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Beverage Antenna"@en ;
    rdfs:subClassOf ns8:ont00000499 ;
    skos:definition "A Wire Antenna that consists of a horizontal wire one-half to two wavelengths long that is suspended above the ground with one end attached to the receiver feedline and the other grounded and which is typically used in the low and medium frequency radio bands."@en .

ns8:ont00001139
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Spacecraft&oldid=1062102614"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Spacecraft"@en ;
    rdfs:subClassOf ns8:ont00000713 ;
    skos:definition "A Vehicle that is designed to convey passengers, cargo, or equipment from one location to another by Spaceflight."@en .

ns8:ont00001140
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Flywheel&oldid=1061360783"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Flywheel"@en ;
    rdfs:subClassOf ns8:ont00000995 ;
    skos:definition "A Material Artifact that is designed to store rotational energy such that it has a significant moment of inertia which enables it to resist changes in rotational speed."@en .

ns8:ont00001141
    ns8:ont00001754 "https://archive.org/details/economicsprincip00osul/page/n489/mode/2up"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:comment "The disposition will typically be a function of an artifact, which is often designed to be part of some Infrastructure system. But not always. In some cases an entity may be repurposed to be an element of some Infrastructure. In those cases it is a capability of that entity that supports the functioning of the system."@en ;
    rdfs:label "Infrastructure Role"@en ;
    rdfs:subClassOf ns1:BFO_0000023 ;
    skos:definition "A Role that inheres in the bearer of a Disposition and has been assigned to an Infrastructure System such that the realization of that Disposition is sometimes part of the functioning of the Infrastructure System."@en .

ns8:ont00001142
    ns8:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Violet"@en ;
    rdfs:subClassOf ns8:ont00000378 ;
    skos:definition "A Color that is lower than Blue with a wavelength in the visible spectrum typically between 400 and 450 nanometers."@en .

ns8:ont00001143
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Fax&oldid=1054674158"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Facsimile Transmission"@en ;
    rdfs:subClassOf ns8:ont00000517 ;
    skos:altLabel "Act of Facsimile Transmission"@en, "Act of Faxing"@en ;
    skos:definition "An Act of Communication by Media in which the Information Content Entity that inheres in a Document is transmitted over a Telephone Network."@en .

ns8:ont00001144
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Entertainment&oldid=1061851778"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Act of Entertainment"@en ;
    rdfs:subClassOf ns8:ont00000228 ;
    skos:definition "A Planned Act consisting of any activity which provides a diversion or permits people to amuse themselves."@en .

ns8:ont00001145
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Radio_receiver&oldid=1060111342"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Radio Receiver"@en ;
    rdfs:subClassOf ns8:ont00000903 ;
    skos:definition "A Radio Communication Instrument that is an electronic device that is designed to extract information from radio waves intercepted by a Radio Antenna by using electronic filters to separate the desired radio frequency signal from other signals, an electronic amplifier to increase the power of the signal, and demodulation to recover the desired information."@en .

ns8:ont00001146
    ns8:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:comment "Sidereal Time is the angle measured from an observer's meridian along the celestial equator to the Great Circle that passes through the March equinox and both poles. This angle is usually expressed in Hours, Minutes, and Seconds."@en ;
    rdfs:label "Sidereal Time Reference System"@en ;
    rdfs:subClassOf ns8:ont00001328 ;
    skos:definition "A Temporal Reference System that is based on Earth's rate of rotation measured relative to one or more fixed Stars (rather than the Sun)."@en .

ns8:ont00001147
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Violence&oldid=1063681926"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Act of Violence"@en ;
    rdfs:subClassOf ns8:ont00000228 ;
    skos:definition "A Planned Act of causing harm to oneself or to another through the use of physical or verbal force."@en .

ns8:ont00001148
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Telecommunications&oldid=1061143810"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Electromagnetic Communication Artifact Function"@en ;
    rdfs:subClassOf ns8:ont00000727 ;
    skos:definition "A Communication Artifact Function that is realized in a process that conveys meaningful signs by means of electromagnetic radiation."@en .

ns8:ont00001149
    ns8:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Data Range Interval Estimate Information Content Entity"@en ;
    rdfs:subClassOf ns8:ont00001101 ;
    skos:definition "A Ratio Measurement Information Content Entity that is a measurement of a set of values and is equal to the absolute difference between the largest value and the smallest value in the set."@en .

ns8:ont00001150
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Ammunition&oldid=1062875850"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Portion of Ammunition"@en ;
    rdfs:subClassOf ns8:ont00000445 ;
    skos:definition "A Weapon that is designed to inflict harm, damage, or incapacity by being projected toward its target at a significant Velocity."@en .

ns8:ont00001151
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Paper&oldid=1057624743"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Portion of Paper"@en ;
    rdfs:subClassOf ns8:ont00000893 ;
    skos:definition "An Information Medium Artifact that is designed to bear some Information Content Entity by means of pressing together moist fibres of cellulose pulp derived from wood, rags, or grasses, and drying them into flexible sheets."@en .

ns8:ont00001152
    ns8:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI ;
    owl:equivalentClass _:nimportcommonb461 ;
    rdf:type owl:Class ;
    rdfs:label "Government Domain"@en ;
    rdfs:subClassOf ns8:ont00001203 ;
    skos:definition "A Delimiting Domain that delimits the authority of a Government to exercise its control within the bounded area."@en .

ns8:ont00001153
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Damaging Artifact Function"@en ;
    rdfs:subClassOf ns8:ont00000323 ;
    skos:definition "An Artifact Function that is realized in a process in which the structural integrity of an entity is impaired."@en .

ns8:ont00001154
    ns8:ont00001760 "https://www.commoncoreontologies.org/TimeOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:comment "This is a defined class."@en ;
    rdfs:label "Multi-Second Temporal Interval"@en ;
    rdfs:subClassOf _:nimportcommonb465, ns1:BFO_0000038 ;
    skos:definition "A one-dimensional temporal region that is measured in Seconds and spans at least one Second."@en .

ns8:ont00001155
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Full Motion Video Imaging Artifact Function"@en ;
    rdfs:subClassOf ns8:ont00000601 ;
    skos:definition "An Imaging Artifact Function that inheres in Artifacts that are designed to produce video of entities that is of high enough quality to make the represented motion appear continuous to human viewers."@en .

ns8:ont00001156
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Information Line"@en ;
    rdfs:subClassOf ns8:ont00000798 ;
    skos:definition "An Information Bearing Artifact that consists of a single line or row of some larger Information Bearing Artifact of which it is a part."@en ;
    skos:example "a line in a computer file that bears a portion of code for some computer program", "a line of data in a database", "a line of text in a book" .

ns8:ont00001157
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Hydraulic Power Source"@en ;
    rdfs:subClassOf ns8:ont00000288 ;
    skos:definition "A Power Source that is designed to generate, control, or transmit power by means of pressurized liquid."@en .

ns8:ont00001158
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Act of Data Transformation"@en ;
    rdfs:subClassOf ns8:ont00000366 ;
    skos:definition "An Act of Information Processing in which an algorithm is executed to act upon one or more input Information Content Entities into one or more output Information Content Entities."@en ;
    skos:scopeNote "It is not a requirement that the output Information Content Entity(ies) be qualitatively distinct from the input(s) as a result of an Act of Data Transformation, though doing so is typically the goal of performing this Act. Consider, for example, selecting a column in an Excel spreadsheet then executing the \\\"Remove Duplicates\\\" Algorithm on it. The intent is to remove rows in that column containing duplicate content. If no duplicate values are present, the information in the column remains unchanged but an Act of Data Transformation was nonetheless performed."@en .

ns8:ont00001159
    ns8:ont00001754 "https://en.wikipedia.org/wiki/Bond_(finance)" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Bond"@en ;
    rdfs:subClassOf ns8:ont00000537 ;
    skos:definition "A Financial Instrument that is designed to secure an Agent's debt for the holders of that debt."@en .

ns8:ont00001160
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Solvent&oldid=1062572314"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Solvent Artifact Function"@en ;
    rdfs:subClassOf ns8:ont00000791 ;
    skos:definition "A Chemical Reaction Artifact Function that is realized in the dissolving of other substances (namely, solutes) without change in the former's chemical structure."@en .

ns8:ont00001161
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Counterfeit&oldid=1063493600"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Counterfeit Legal Instrument"@en ;
    rdfs:subClassOf ns8:ont00000719 ;
    skos:definition "A Counterfeit Instrument that is designed to be a fake replica of some genuine Legal Instrument."@en .

ns8:ont00001162
    ns8:ont00001754 "Derived (loosely) from: John Searle's Speech Acts: An Essay in the Philosophy of Language" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:comment "Examples: agreeing, betting, guaranteeing, inviting, offering, promising, swearing, volunteering"@en ;
    rdfs:label "Act of Commissive Communication"@en ;
    rdfs:subClassOf ns8:ont00000402 ;
    skos:definition "An Act of Communication that commits a speaker to some future action."@en .

ns8:ont00001163
    ns8:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI ;
    owl:equivalentClass _:nimportcommonb466 ;
    rdf:type owl:Class ;
    rdfs:label "Measurement Information Content Entity"@en ;
    rdfs:subClassOf ns8:ont00000853 ;
    skos:altLabel "Measurement ICE"@en ;
    skos:definition "A Descriptive Information Content Entity that describes the extent, dimensions, quantity, or quality of an Entity relative to some standard."@en .

ns8:ont00001164
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=County&oldid=1062817834"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "County"@en ;
    rdfs:subClassOf ns8:ont00001152 ;
    skos:definition "A Government Domain that is part of either a First-Order or Second-Order Administrative Region."@en .

ns8:ont00001165
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Terrorist_training_camp&oldid=1037856600"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Terrorist Training Camp"@en ;
    rdfs:subClassOf ns8:ont00000332 ;
    skos:definition "A Training Camp designed to teach students methods of terrorism."@en .

ns8:ont00001166
    ns8:ont00001760 "https://www.commoncoreontologies.org/TimeOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:comment "This is a defined class."@en ;
    rdfs:label "Multi-Minute Temporal Interval"@en ;
    rdfs:subClassOf _:nimportcommonb470, ns1:BFO_0000038 ;
    skos:definition "A one-dimensional temporal region that is measured in Minutes and spans at least one Minute."@en .

ns8:ont00001167
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Midrange Frequency"@en ;
    rdfs:subClassOf ns8:ont00000530 ;
    skos:definition "A Sonic Frequency that is between 500 Hz and 2 kHz."@en .

ns8:ont00001168
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Working_mass&oldid=1057126114"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Reaction Mass"@en ;
    rdfs:subClassOf ns1:BFO_0000040 ;
    skos:altLabel "Working Mass"@en ;
    skos:definition "A Material Entity against which a Propulsion System operates in order to produce Acceleration."@en .

ns8:ont00001169
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Communication Relay Artifact Function"@en ;
    rdfs:subClassOf ns8:ont00000323 ;
    skos:definition "An Artifact Function that is realized during events in which an Artifact is used to first receive and then transmit information from one Artifact to another for the purpose of communiction."@en .

ns8:ont00001170
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Hard X-ray Frequency"@en ;
    rdfs:subClassOf ns8:ont00000490 ;
    skos:definition "An X-Ray Frequency that is between 3 and 30 exahertz."@en .

ns8:ont00001171
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Telephone_network&oldid=1046265527"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Wireless Network Telephone Call"@en ;
    rdfs:subClassOf ns8:ont00001190 ;
    skos:definition "A Telephone Call transmitted over a network where the telephones are mobile and can move anywhere within the coverage area."@en .

ns8:ont00001172
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Portion of Gelatinous Propellant"@en ;
    rdfs:subClassOf ns8:ont00000593 ;
    skos:definition "A Portion of Propellant that is stored in a gelatinous state."@en .

ns8:ont00001173
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Rocket_launcher&oldid=1049900727"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Rocket Launcher"@en ;
    rdfs:subClassOf ns8:ont00001051 ;
    skos:definition "A Projectile Launcher that is designed to launch one or more Unguided Rockets."@en .

ns8:ont00001174
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Electromagnetic_shielding&oldid=1063432544"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Electromagnetic Shielding Artifact Function"@en ;
    rdfs:subClassOf ns8:ont00000323 ;
    skos:definition "An Artifact Function that is realized in a process in which an electromagnetic field is blocked by barriers made of conductive or magnetic materials."@en .

ns8:ont00001175
    ns8:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Language"@en ;
    rdfs:subClassOf ns8:ont00000965 ;
    skos:definition "A Directive Information Content Entity that prescribes a canonical format for communication."@en .

ns8:ont00001176
    ns8:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Estimate Information Content Entity"@en ;
    rdfs:subClassOf ns8:ont00001163 ;
    skos:altLabel "Estimate Measurement Information Content Entity"@en, "Estimate"@en, "Estimated Value"@en ;
    skos:definition "A Measurement Information Content Entity that is a measurement of an entity based on partial information about that entity or an appropriately similar entity."@en .

ns8:ont00001177
    ns8:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Roll Orientation"@en ;
    rdfs:subClassOf ns8:ont00000119 ;
    skos:altLabel "Roll"@en ;
    skos:definition "A Spatial Orientation of an Object relative to its Roll Axis."@en .

ns8:ont00001178
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Railway Crossing"@en ;
    rdfs:subClassOf ns8:ont00001326 ;
    skos:altLabel "Level Crossing"@en ;
    skos:definition "A Land Transportation Artifact that is designed to enable Persons or Ground Vehicles to cross a Railway when traveling along a road or path that is perpendicular to and at the same elevation as the Railway at the point where they overlap."@en .

ns8:ont00001179
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Data_storage&oldid=1060116427"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Digital Storage Device"@en ;
    rdfs:subClassOf ns8:ont00000893 ;
    skos:definition "An Information Medium Artifact that is designed to bear some Information Content Entity by means of recording that information in digital (binary) format."@en ;
    skos:example "A computer's Hard Disk Drive", "A portable USB Drive" .

ns8:ont00001180
    ns8:ont00001754 "http://purl.obolibrary.org/obo/OBI_0000245" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:comment "Members of organizations are either Organizations themselves or individual Persons. Members can bear specific Organization Member Roles that are determined in the organization rules. The organization rules also determine how decisions are made on behalf of the Organization by the organization members."@en ;
    rdfs:label "Organization"@en ;
    rdfs:subClassOf ns8:ont00000300 ;
    skos:definition "A Group of Agents which can be the bearer of roles, has members, and has a set of organization rules."@en .

ns8:ont00001181
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Triple Inertial Navigation System"@en ;
    rdfs:subClassOf ns8:ont00000287 ;
    skos:altLabel "Triple INS"@en ;
    skos:definition "An Inertial Navigation System that is designed to use three redundant computers to continuously calculate via dead reckoning the position, orientation, and velocity of a moving object without the need for external references, in such a way that eliminates the need for a navigator."@en .

ns8:ont00001182
    ns8:ont00001754 "https://en.wikipedia.org/wiki/Phase_angle_(astronomy)" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Phase Angle"@en ;
    rdfs:subClassOf ns1:BFO_0000145 ;
    skos:altLabel "Orbital Phase Angle"@en ;
    skos:definition "A Relational Quality that is the angle between the light incident onto an observed Object and the light reflected from the Object."@en .

ns8:ont00001183
    ns8:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Social Network"@en ;
    rdfs:subClassOf ns8:ont00000300 ;
    skos:definition "A Group of Agents that are connected in dyadic relations by similar personal or career interests, activities, backgrounds, or real-life connections."@en .

ns8:ont00001184
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Spinning Motion"@en ;
    rdfs:subClassOf ns8:ont00000368 ;
    skos:definition "A Rotational Motion of an Object around an Axis of Rotation that passes through the Object's Center of Mass."@en .

ns8:ont00001185
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Rocket&oldid=1063307477"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Rocket"@en ;
    rdfs:subClassOf ns8:ont00000713 ;
    skos:definition "A Vehicle that is designed to travel through air or space and which obtains Thrust from a Rocket Engine."@en .

ns8:ont00001186
    ns8:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Color Hue"@en ;
    rdfs:subClassOf ns8:ont00000784 ;
    skos:definition "An Optical Property that inheres in a bearer in virtue of its capacity to reflect a dominant wavelength of the visible light spectrum, which is typically divided up into 6 to 8 ranges."@en .

ns8:ont00001187
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Navigation&oldid=1064122463"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Navigation System"@en ;
    rdfs:subClassOf ns8:ont00000995 ;
    skos:definition "A Material Artifact that is designed to enable an Agent or Artifact to determine the position or direction of some object, usually for the purpose of monitoring or controlling the movement of some Vehicle from one place to another."@en .

ns8:ont00001188
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Dentures&oldid=1056527226"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Denture"@en ;
    rdfs:subClassOf ns8:ont00000715 ;
    skos:definition "A Prosthesis that is designed to replace missing teeth."@en .

ns8:ont00001189
    ns8:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Blue"@en ;
    rdfs:subClassOf ns8:ont00000378 ;
    skos:definition "A Color that is between Cyan and Violet with a wavelength in the visible spectrum typically between 450 to 490 nanometers."@en .

ns8:ont00001190
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Telephone_network&oldid=1046265527"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Telephone Call"@en ;
    rdfs:subClassOf ns8:ont00000517 ;
    skos:altLabel "Act of Telephone Calling"@en ;
    skos:definition "An Act of Communciation by Media transmitted over a telephone network to two or more Persons."@en .

ns8:ont00001191
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Operational Stasis"@en ;
    rdfs:subClassOf ns8:ont00001213 ;
    skos:definition "A Stasis of Artifact Operationality that holds during a Temporal Interval when an Artifact maintains its designed set of Artifact Functions (or at least maintains its primary functions)."@en .

ns8:ont00001192
    ns8:ont00001754 "https://en.wikipedia.org/wiki/Antenna_(radio)" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Radio Antenna"@en ;
    rdfs:subClassOf ns8:ont00000092 ;
    skos:definition "A Bidirectional Transducer that is designed to convert electric power into radio waves, and radio waves into electric power."@en .

ns8:ont00001193
    ns8:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Fatigability"@en ;
    rdfs:subClassOf ns1:BFO_0000017 ;
    skos:definition "A Realizable Entity that is realized when its bearer loses strength and tires quickly."@en .

ns8:ont00001194
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:comment "This class should be used to demarcate the start of the temporal interval (through the occurs_on property) that the Entity bears the Role."@en ;
    rdfs:label "Gain of Role"@en ;
    rdfs:subClassOf _:nimportcommonb471, ns8:ont00000642 ;
    skos:definition "A Gain of Realizable Entity in which some Independent Continuant becomes bearer of some Role."@en .

ns8:ont00001195
    ns8:ont00001760 "https://www.commoncoreontologies.org/GeospatialOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Geospatial Error Region"@en ;
    rdfs:subClassOf ns8:ont00000207 ;
    skos:definition "A One-Dimensional Geospatial Boundary that bounds some Geospatial Region according to probability estimations for locating some object within it."@en .

ns8:ont00001196
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:comment "Many Acts of Manufacturing and Construction involve one or more Acts of Artifact Assembly, but Acts of Artifact Assembly can also occur in isolation from these activities."@en ;
    rdfs:label "Act of Artifact Assembly"@en ;
    rdfs:subClassOf ns8:ont00000908 ;
    skos:definition "An Act of Artifact Processing wherein a new Artifact is created by fitting component parts together."@en ;
    skos:example "putting together a piece of furniture purchased from Ikea" .

ns8:ont00001197
    ns8:ont00001754 "http://www.merriam-webster.com/dictionary/anthropogenic" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/GeospatialOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Anthropogenic Feature"@en ;
    rdfs:subClassOf ns8:ont00000574 ;
    skos:definition "An Environmental Feature that is related to or is the result of the influence of human beings on the environment."@en .

ns8:ont00001198
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Railcar&oldid=1063519348"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:comment "In American-English, the term 'Railcar' is often used in a broader sense that is interchangeable with 'Railroad Car'."@en ;
    rdfs:label "Railcar"@en ;
    rdfs:subClassOf ns8:ont00000796 ;
    skos:definition "A Rail Transport Vehicle that consists of a single self-propelled Vehicle that is not a Train, is designed to transport passengers, and which may also be designed to connect to other Railcars to form a Train."@en .

ns8:ont00001199
    ns8:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Protruding"@en ;
    rdfs:subClassOf ns8:ont00001059 ;
    skos:definition "A Shape Quality inhering in a part of an object in virtue of the part extending out above or beyond the surface of the object."@en .

ns8:ont00001200
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Structural Support Artifact Function"@en ;
    rdfs:subClassOf ns8:ont00000323 ;
    skos:definition "An Artifact Function that is realized by an Artifact providing physical support to another object."@en .

ns8:ont00001201
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Trail&oldid=1056047142"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Trail"@en ;
    rdfs:subClassOf ns8:ont00001326 ;
    skos:definition "A Land Transportation Artifact that is designed to enable transport through rough country, such as a forest or moor."@en .

ns8:ont00001202
    ns8:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Size Quality"@en ;
    rdfs:subClassOf ns1:BFO_0000019 ;
    skos:definition "A Quality that inheres in a bearer in virtue of the bearer's extension in one or more dimensions."@en .

ns8:ont00001203
    dcterms:created "2022-12-30T21:32:27-05:00"^^xsd:dateTime ;
    dcterms:creator "https://cubrc.org"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI ;
    owl:equivalentClass _:nimportcommonb476 ;
    rdf:type owl:Class ;
    rdfs:label "Delimiting Domain"@en ;
    rdfs:subClassOf ns8:ont00000472 ;
    skos:definition "A Geospatial Region that delimits the authority of an Organization to exercise its control within the bounded area."@en ;
    skos:prefLabel "Delimiting Domain"@en .

ns8:ont00001204
    ns8:ont00001760 "https://www.commoncoreontologies.org/TimeOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Night"@en ;
    rdfs:subClassOf ns1:BFO_0000202 ;
    skos:definition "A Temporal Interval that consists of the temporal regions between when people typically retire to sleep (approximately 9:00pm) and when the sun dawns (approximately 6:00am)."@en .

ns8:ont00001205
    ns8:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Priority Scale"@en ;
    rdfs:subClassOf ns8:ont00000398 ;
    skos:definition "A Reference System that is designed to be used to rank or identify the importance of entities of the specified type."@en .

ns8:ont00001206
    ns8:ont00001760 "https://www.commoncoreontologies.org/TimeOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:comment "This is a defined class."@en ;
    rdfs:label "Multi-Year Temporal Interval"@en ;
    rdfs:subClassOf _:nimportcommonb480, ns1:BFO_0000038 ;
    skos:definition "A one-dimensional temporal region that is measured in Years and spans at least one Year."@en .

ns8:ont00001207
    ns8:ont00001754 "https://en.wikipedia.org/wiki/Lens_(optics)" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Optical Lens"@en ;
    rdfs:subClassOf ns8:ont00000136 ;
    skos:altLabel "Lens"@en ;
    skos:definition "An Optical Instrument that is designed to focus or disperse a beam of light entering the lens by means of refraction."@en .

ns8:ont00001208
    ns8:ont00001753 "HF" ;
    ns8:ont00001754 "International Telecommunication Union (ITU) and IEEE 521-2002 - IEEE Standard Letter Designations for Radar-Frequency Bands" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:comment "The corresponding Wavelength range is 100–10 m"@en ;
    rdfs:label "High Frequency"@en ;
    rdfs:subClassOf ns8:ont00000150 ;
    skos:altLabel "ITU Band Number 7"@en ;
    skos:definition "A Radio Frequency that is between 3 and 30 MHz."@en .

ns8:ont00001209
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "UPC-E Barcode"@en ;
    rdfs:subClassOf ns8:ont00000326 ;
    skos:definition "A UPC Barcode that consists of 6 numerical digits."@en .

ns8:ont00001210
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Retail&oldid=1061431295"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Retail Artifact Function"@en ;
    rdfs:subClassOf ns8:ont00001301 ;
    skos:definition "A Service Artifact Function that is realized in processes of selling goods or merchandise in small or individual lots for direct consumption by persons or organizations."@en .

ns8:ont00001211
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Lifting Artifact Function"@en ;
    rdfs:subClassOf ns8:ont00000323 ;
    skos:definition "An Artifact Function that is realized by processes in which some Artifact is used to lift some object."@en .

ns8:ont00001212
    ns8:ont00001754 "http://purl.org/obo/owl/PATO#PATO_0000383" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Female Sex"@en ;
    rdfs:subClassOf ns8:ont00001033 ;
    skos:definition "A Biological Sex inhering in an individual that only produces gametes that can be fertilized by male gametes."@en .

ns8:ont00001213
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Stasis of Artifact Operationality"@en ;
    rdfs:subClassOf ns8:ont00000246 ;
    skos:definition "A Stasis of Realizable Entity that holds during a Temporal Interval when an Artifact's designed set of Artifact Functions (or at least its primary functions) or the realizations of those functions remain unchanged."@en .

ns8:ont00001214
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Increase of Specifically Dependent Continuant"@en ;
    rdfs:subClassOf ns8:ont00001048 ;
    skos:definition "An Increase of Dependent Continuant in which some Independent Continuant has an increase of some Specifically Dependent Continuant that it bears."@en .

ns8:ont00001215
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Funeral&oldid=1060270978"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Funeral"@en ;
    rdfs:subClassOf ns8:ont00000455 ;
    skos:altLabel "Act of Funeral Ceremony"@en ;
    skos:definition "An Act of Ceremony in which the Life of a Person who has died is celebrated, sanctified, or remembered."@en .

ns8:ont00001216
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Periscope&oldid=1030400442"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Periscope"@en ;
    rdfs:subClassOf ns8:ont00000136 ;
    skos:definition "An Optical Instrument that is designed to enable observation of an object that is located over, around, or through another object, obstacle, or condition that prevents direct line-of-sight observation from the observer's current position."@en .

ns8:ont00001217
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Medium_machine_gun&oldid=1063571269"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Medium Machine Gun"@en ;
    rdfs:subClassOf ns8:ont00000848 ;
    skos:definition "A Mounted Gun that is designed to fire full-power rifle Cartridges (less than .50 caliber or 12.7mm) in quick succession from an ammunition belt, and which typically weighs 22-30 lbs."@en .

ns8:ont00001218
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Signal_processing&oldid=1062720685"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Signal Processing Artifact Function"@en ;
    rdfs:subClassOf ns8:ont00000323 ;
    skos:definition "An Artifact Function that is realized in the process of transferring or processing information contained in signals."@en .

ns8:ont00001219
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:comment "Delta-v is not equivalent to and should not be confused with Acceleration, which is the rate of change of Velocity."@en ;
    rdfs:label "Delta-v"@en ;
    rdfs:subClassOf _:nimportcommonb481, ns1:BFO_0000144 ;
    skos:altLabel "Change in Velocity"@en, "DeltaV"@en ;
    skos:definition "A Process Profile that is the total change in Velocity of an object's Motion."@en .

ns8:ont00001220
    ns8:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Opaque"@en ;
    rdfs:subClassOf ns8:ont00001384 ;
    skos:definition "An Opacity that inheres in a bearer in virtue of that bearer's incapacity to transmit electromagnetic radiation of a given frequency through the bearer such that the bearer reflects, scatters, or absorbs all electromagnetic radiation of that frequency."@en .

ns8:ont00001221
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Physically Powered Engine"@en ;
    rdfs:subClassOf ns8:ont00000210 ;
    skos:altLabel "Physical Engine"@en ;
    skos:definition "An Engine that is designed to convert potential or kinetic energy into mechanical energy."@en .

ns8:ont00001222
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Photovoltaic_system&oldid=1063366598"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Solar Panel System"@en ;
    rdfs:subClassOf ns8:ont00001049 ;
    skos:altLabel "Photovoltaic System"@en, "Solar Array"@en ;
    skos:definition "An Electrical Power Source that consists in part of one or more Solar Panels, a power inverter, electrical wiring between the components, a mounting and support structure, and may also include a battery and/or a solar tracking system and is the bearer of functions realized in processes of deriving, transferring, and storing electrical energy derived from light energy."@en .

ns8:ont00001223
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Dish Receiver"@en ;
    rdfs:subClassOf ns8:ont00001145 ;
    skos:definition "A Radio Receiver that uses a Parabolic (or Dish) Antenna to intercept radio signals."@en .

ns8:ont00001224
    ns8:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI ;
    owl:equivalentClass _:nimportcommonb482 ;
    rdf:type owl:Class ;
    rdfs:label "Process Requirement"@en ;
    rdfs:subClassOf ns8:ont00001324 ;
    skos:altLabel "Duty"@en, "Obligation"@en ;
    skos:definition "A Process Regulation that requires some Process."@en .

ns8:ont00001225
    ns8:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Yellow"@en ;
    rdfs:subClassOf ns8:ont00000378 ;
    skos:definition "A Color that is between Orange and Green with a wavelength in the visible spectrum typically between 560 to 590 nanometers."@en .

ns8:ont00001226
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Act of Employment"@en ;
    rdfs:subClassOf ns8:ont00000433 ;
    skos:definition "An Act of Association wherein an Organization assigns a set of activities to some Person to be performed in exchange for financial compensation."@en .

ns8:ont00001227
    ns8:ont00001754 "http://www.acs.psu.edu/drussell/Demos/waves/wavemotion.html" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Longitudinal Wave Profile"@en ;
    rdfs:subClassOf _:nimportcommonb486, ns8:ont00000752 ;
    skos:altLabel "Compression Wave"@en, "Longitudinal Wave"@en ;
    skos:definition "A Wave Process Profile in which the displacement of participating particles is parallel to the direction of the Wave Process' propogation such that the particles alternate between participating in processes of compression and rarefaction as they participate in individual Wave Processes."@en .

ns8:ont00001228
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Academic_journal&oldid=1059723283"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Journal Article"@en ;
    rdfs:subClassOf ns8:ont00000798 ;
    skos:definition "An Information Bearing Artifact that is designed to bear a specific brief composition on a specific topic as part of a Journal Issue."@en .

ns8:ont00001229
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Alkaline_battery&oldid=1055652562"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Alkaline Electric Battery"@en ;
    rdfs:subClassOf ns8:ont00001050 ;
    skos:definition "A Primary Cell Electric Battery that has a Zinc anode and Manganese (IV) oxide cathode."@en .

ns8:ont00001230
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Rhombic_antenna&oldid=1057114456"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Rhombic Antenna"@en ;
    rdfs:subClassOf ns8:ont00000499 ;
    skos:definition "A Wire Antenna that consists of one to three parallel wires suspended above the ground by poles or towers at each vertex in a rhombic shape with each of the four sides being the same length (typically at least one wavelength or longer)."@en .

ns8:ont00001231
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Brilliance Frequency"@en ;
    rdfs:subClassOf ns8:ont00000530 ;
    skos:definition "A Sonic Frequency that is between 6 and 20 kHz."@en .

ns8:ont00001232
    ns8:ont00001754 "http://en.wikipedia.org/wiki/Possession_(law)" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:comment "In all cases, to possess something, an agent must have an intention to possess it."@en ;
    rdfs:label "Act of Possession"@en ;
    rdfs:subClassOf ns8:ont00000228 ;
    skos:definition "A Planned Act in which an agent intentionally exercises control towards a thing."@en .

ns8:ont00001233
    ns8:ont00001754 "http://www.dictionary.com/browse/crushing" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Crushing Artifact Function"@en ;
    rdfs:subClassOf ns8:ont00001153 ;
    skos:definition "A Damaging Artifact Function that is realized in a process in which the structural integrity of an entity is impaired because of significant pressure."@en .

ns8:ont00001234
    ns8:ont00001754 "https://en.wikipedia.org/wiki/Neutralization_(chemistry)" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Neutralization Artifact Function"@en ;
    rdfs:subClassOf ns8:ont00000791 ;
    skos:definition "A Chemical Reaction Artifact Function that is realized in a process in which an acid and a base react quantitatively with each other."@en .

ns8:ont00001235
    ns8:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Military Time Zone Identifier"@en ;
    rdfs:subClassOf ns8:ont00000829 ;
    skos:definition "A Time Zone Identifier that designates a spatial region where the local time is calculated according to the specified offset from Zulu time, which has no offset from Coordinated Universal Time."@en .

ns8:ont00001236
    ns8:ont00001754 "http://www.merriam-webster.com/dictionary/suicide" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Act of Suicide"@en ;
    rdfs:subClassOf _:nimportcommonb487, ns8:ont00001147 ;
    skos:altLabel "Suicide"@en ;
    skos:definition "An Act of Violence in which some Agent intentionally and voluntarily causes their own death."@en .

ns8:ont00001237
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Birth&oldid=1063718655"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Birth"@en ;
    rdfs:subClassOf ns8:ont00000007 ;
    skos:definition "A Natural Process of bringing forth offspring."@en .

ns8:ont00001238
    ns8:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Initialism"@en ;
    rdfs:subClassOf ns8:ont00000605 ;
    skos:definition "An Abbreviated Name that consists of the initial letters of some words (or syllables) in a Designative Name, and in which each letter is pronounced separately."@en ;
    skos:example "USA, CPU, BBC" .

ns8:ont00001239
    ns8:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Group of Organizations"@en ;
    rdfs:subClassOf _:nimportcommonb488, _:nimportcommonb489, ns8:ont00000300 ;
    skos:definition "A Group of Agents that has only Organizations as parts."@en .

ns8:ont00001240
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Telecommunications&oldid=1061143810"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Radio Communication Artifact Function"@en ;
    rdfs:subClassOf ns8:ont00001148 ;
    skos:definition "An Electromagnetic Communication Artifact Function that is realized in a process that conveys meaningful signs by means of radio waves."@en .

ns8:ont00001241
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Sensor&oldid=1059883466"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Sensor Artifact Function"@en ;
    rdfs:subClassOf ns8:ont00000323 ;
    skos:definition "An Artifact Function that is realized in processes wherein its bearer is used to produce an output signal which reliably corresponds to changes in the artifact's environment."@en .

ns8:ont00001242
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Actuator&oldid=1064000375"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Actuator"@en ;
    rdfs:subClassOf ns8:ont00000736 ;
    skos:definition "A Transducer that is designed to convert some control signal into mechanical motion."@en .

ns8:ont00001243
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Document Field"@en ;
    rdfs:subClassOf ns8:ont00000253 ;
    skos:definition "An Information Bearing Entity that is a part of some document into which bearers of prescribed information can be written or selected."@en .

ns8:ont00001244
    ns8:ont00001754 "JC3IEDM-MIRD-DMWG-Edition_3.0.2_20090514" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Act of Issuing Mass Media Article"@en ;
    rdfs:subClassOf ns8:ont00000588 ;
    skos:definition "An Act of Mass Media Communication involving sending forth, distributing, or putting into circulation a non-fictional essay, especially one included with others in a newspaper, magazine, or journal."@en .

ns8:ont00001245
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "PDF417 Code"@en ;
    rdfs:subClassOf ns8:ont00000241 ;
    skos:definition "A Two-Dimensional Barcode that is used in applications that require the storage of huge amounts of data."@en .

ns8:ont00001246
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Under Active Control"@en ;
    rdfs:subClassOf _:nimportcommonb490, ns8:ont00000847 ;
    skos:definition "An Active Stasis during which an Artifact participates in an Act of Artifact Employment."@en .

ns8:ont00001247
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Communication_endpoint&oldid=1020569501"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Telecommunication Endpoint"@en ;
    rdfs:subClassOf ns8:ont00000918 ;
    skos:definition "A Telecommunication Network Node that connects a Telecommunication Terminal to a Telecommunication Network."@en ;
    skos:scopeNote "A Telecommunication Terminal is an end user device such as a Telephone, fax machine, or Computer."@en .

ns8:ont00001248
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Artificial_eye&oldid=1046672400"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Artificial Eye"@en ;
    rdfs:subClassOf ns8:ont00000715 ;
    skos:definition "A Prosthesis that is designed to replace a missing eye."@en .

ns8:ont00001249
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Cabin_pressurization&oldid=1062243955"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Cabin Pressurization Control System"@en ;
    rdfs:subClassOf ns8:ont00000453 ;
    skos:definition "An Environment Control System that is designed to control the process in which conditioned air is pumped into the Cabin of some Aircraft or Spacecraft in order to create a safe and comfortable environment for passengers and crew flying at high altitudes."@en .

ns8:ont00001250
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Interior Lighting System"@en ;
    rdfs:subClassOf ns8:ont00000236 ;
    skos:definition "A Lighting System that is designed to emit light within the interior of some area."@en .

ns8:ont00001251
    ns8:ont00001754 "http://en.wikipedia.org/wiki/Intelligence_(information_gathering)" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Act of Intelligence Gathering"@en ;
    rdfs:subClassOf ns8:ont00000228 ;
    skos:definition "A Planned Act of producing and/or gathering information by a government or other Organization to guide decisions and actions by answering questions or obtaining advance warning of events and movements deemed to be important or otherwise relevant."@en .

ns8:ont00001252
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Propulsion&oldid=1022034059"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Propulsion Artifact Function"@en ;
    rdfs:subClassOf ns8:ont00000448 ;
    skos:definition "A Motion Artifact Function that is realized in a process in which the bearer of the function creates force leading to an entity's movement."@en .

ns8:ont00001253
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Fuel&oldid=1063590518"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Fuel Artifact Function"@en ;
    rdfs:subClassOf ns8:ont00000323 ;
    skos:definition "An Artifact Function that is realized in processes in which a Portion of Fuel is reacted with other substances in order to release chemical or nuclear energy to be used for heat or for work."@en .

ns8:ont00001254
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Revolver&oldid=1060461644"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Revolver"@en ;
    rdfs:subClassOf ns8:ont00000156 ;
    skos:definition "A Hand Gun having a number of firing chambers in a revolving cylinder, where each chamber in the cylinder can be loaded with a single Cartridge."@en .

ns8:ont00001255
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Insecticide&oldid=1063322558"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Insecticide Artifact Function"@en ;
    rdfs:subClassOf ns8:ont00000828 ;
    skos:definition "A Pesticide Artifact Function that is realized in a process that causes harm to, or the death of, an insect."@en .

ns8:ont00001256
    ns8:ont00001754 "https://en.wikipedia.org/wiki/Reliability_(statistics)" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:comment "Note, the term 'accuracy' is avoided due to its ambiguity between: correctness-of-performance ('Reliability Measurement Information Content Entity'), correctness-of-information (see: 'Veracity Measurement Information Content Entity'), and adherance-to-expectations (see: 'Deviation Measurement Information Content Entity')."@en ;
    rdfs:label "Reliability Measurement Information Content Entity"@en ;
    rdfs:subClassOf ns8:ont00001163 ;
    skos:altLabel "Accuracy of Process"@en, "Reliability Measurement"@en ;
    skos:definition "A Measurement Information Content Entity that is a measurement of the extent to which an entity can consistently produce an outcome."@en ;
    skos:scopeNote "Reliability concerns both a measure of past performance and the expectation that future performance will conform to the range of past performances."@en .

ns8:ont00001257
    ns8:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Nuclear Storage Depot"@en ;
    rdfs:subClassOf ns8:ont00000881 ;
    skos:definition "A Storage Facility that is designed to store nuclear material."@en .

ns8:ont00001258
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Port&oldid=1064091505"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Port"@en ;
    rdfs:subClassOf ns8:ont00000226 ;
    skos:definition "A Transportation Facility that is designed to contain harbors for docking Watercraft and for transfering people or cargo to and from land."@en .

ns8:ont00001259
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Atmosphere&oldid=1135486662"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/GeospatialOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Portion of Atmosphere"@en ;
    rdfs:subClassOf ns1:BFO_0000024 ;
    skos:definition "A fiat object part of the layer of gas or layers of gases that envelop a natural satellite."@en .

ns8:ont00001260
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Code 39 Barcode"@en ;
    rdfs:subClassOf ns8:ont00000258 ;
    skos:definition "A One-Dimensional Barcode that consists of 39 characters that are numbers 0-9, capital letters A-Z, or the symbols -.$/+% and space and is used primarily in automotive and defense industries."@en .

ns8:ont00001261
    ns8:ont00001754 "http://www.dictionary.com/browse/identify" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Act of Identifying"@en ;
    rdfs:subClassOf ns8:ont00000379 ;
    skos:definition "An Act of Representative Communication performed by asserting who or what a particular person or thing is."@en .

ns8:ont00001262
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Human&oldid=1063145185"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Person"@en ;
    rdfs:subClassOf ns8:ont00000562 ;
    skos:altLabel "Human"@en ;
    skos:definition "An Animal that is a member of the species Homo sapiens."@en .

ns8:ont00001263
    ns8:ont00001754 "JC3IEDM-MIRD-DMWG-Edition_3.0.2_20090514" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Act of Issuing Mass Media Documentary"@en ;
    rdfs:subClassOf ns8:ont00000588 ;
    skos:definition "An Act of Mass Media Communication involving sending forth, distributing, or putting into circulation information that provides a factual record or report."@en .

ns8:ont00001264
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Code 128 Barcode"@en ;
    rdfs:subClassOf ns8:ont00000258 ;
    skos:definition "A One-Dimensional Barcode that consists of up to 128 ASCII characters and is used primarily in supply chains."@en .

ns8:ont00001265
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Public_address_system&oldid=1059177344"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Public Address System"@en ;
    rdfs:subClassOf ns8:ont00001036 ;
    skos:altLabel "PA System"@en ;
    skos:definition "A Communication System that is designed to allow a Person to speak to a large audience."@en .

ns8:ont00001266
    ns8:ont00001754 "http://wordnetweb.princeton.edu/perl/webwn?s=vocational%20training" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Act of Vocational Training Instruction"@en ;
    rdfs:subClassOf ns8:ont00001075 ;
    skos:definition "An Act of Training Instruction performed by an Agent who realizes a capacity derived from the Agent's affiliation with a Vocational School, Technical School, Trade Organization, or Industry Educational Program Provider by imparting skills required for a specific occupation in industry, agriculture or trade to an Agent either directly or indirectly through some communication medium."@en .

ns8:ont00001267
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Propaganda&oldid=1062472484"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Act of Propaganda"@en ;
    rdfs:subClassOf ns8:ont00000971 ;
    skos:definition "An Act of Deceptive Communication Propaganda intended to influence the attitude of a mass audience toward some cause or position by presenting facts selectively (thus possibly lying by omission) or by using loaded messages to produce an emotional rather than rational response to the information presented."@en .

ns8:ont00001268
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "ISBN Barcode"@en ;
    rdfs:subClassOf ns8:ont00000966 ;
    skos:definition "An EAN Barcode that is used to designate books."@en .

ns8:ont00001269
    ns8:ont00001754 "http://www.merriam-webster.com/dictionary/warning" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Act of Warning"@en ;
    rdfs:subClassOf ns8:ont00000133 ;
    skos:definition "An Act of Directive Communication performed by indicating a possible or impending danger, problem, or other unpleasant situation."@en .

ns8:ont00001270
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Howitzer&oldid=1059576383"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Howitzer"@en ;
    rdfs:subClassOf ns8:ont00000268 ;
    skos:definition "A Cannon that is designed to have a relatively short barrel and to use relatively small propellant charges to propel projectiles in relatively high trajectories with a steep angle of descent."@en .

ns8:ont00001271
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Wired Communication Relay Artifact Function"@en ;
    rdfs:subClassOf ns8:ont00001169 ;
    skos:definition "A Communication Relay Artifact Function that is realized during events in which an Artifact is used to first receive and then transmit information by means of wires from one Artifact to another for the purpose of communiction."@en .

ns8:ont00001272
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Act of Murder"@en ;
    rdfs:subClassOf ns8:ont00000191 ;
    skos:definition "An Act of Homicide with malice aforethought."@en .

ns8:ont00001273
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Sensor Modality Function"@en ;
    rdfs:subClassOf _:nimportcommonb491, ns8:ont00001241 ;
    skos:definition "A Sensor Artifact Function that inheres in some Sensor in virtue of the type of energy the Sensor is capable of converting into an output signal."@en .

ns8:ont00001274
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Infrasonic Frequency"@en ;
    rdfs:subClassOf ns8:ont00000008 ;
    skos:definition "A Sound Frequency that is below 20 Hz."@en .

ns8:ont00001275
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Nominal Speed Artifact Function"@en ;
    rdfs:subClassOf ns8:ont00001353 ;
    skos:definition "A Speed Artifact Function that is realized in some process in which the Artifact bearing the Artifact Function attains a speed that does not exceed some specified tolerance of that Artifact."@en .

ns8:ont00001276
    ns8:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Carrier Air Wing"@en ;
    rdfs:subClassOf ns8:ont00000426 ;
    skos:definition "A Military Force that is trained and equipped to conduct air operations while embarked on an aircraft carrier."@en .

ns8:ont00001277
    ns8:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Red"@en ;
    rdfs:subClassOf ns8:ont00000378 ;
    skos:definition "A Color that is above Orange with a wavelength in the visible spectrum typically between 635 to 700 nanometers."@en .

ns8:ont00001278
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Stock&oldid=1064040249"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Stock"@en ;
    rdfs:subClassOf ns8:ont00000537 ;
    skos:definition "A Financial Instrument that entitles holders to an ownership interest (equity) in the specified Incorporated Organization."@en .

ns8:ont00001279
    ns8:ont00001754 "https://physicsabout.com/motion/"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Vibration Motion"@en ;
    rdfs:subClassOf ns8:ont00001133 ;
    skos:altLabel "Mechanical Oscillation"@en, "Oscillation Motion"@en, "Vibration"@en ;
    skos:definition "A Motion wherein some participant repetitively deviates from a central location to two surrounding locations."@en .

ns8:ont00001280
    ns8:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Flat"@en ;
    rdfs:subClassOf ns8:ont00001059 ;
    skos:definition "A Shape Quality inhering in a bearer in virtue of the bearer having a horizontal border without a significant deviation."@en .

ns8:ont00001281
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Emulsion&oldid=1056901580"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Emulsifier Artifact Function"@en ;
    rdfs:subClassOf ns8:ont00000791 ;
    skos:definition "A Chemical Reaction Artifact Function that is realized in a process in which two or more liquids that are normally immiscible are mixed."@en .

ns8:ont00001282
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Power_transfer_unit&oldid=1002682083"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Hydraulic Valve"@en ;
    rdfs:subClassOf ns8:ont00000598 ;
    skos:definition "A Valve that is designed to regulate, direct, or control the flow of a liquid by opening, closing, or partially obstructing various passageways."@en .

ns8:ont00001283
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Refinery&oldid=1027092124"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Refinery"@en ;
    rdfs:subClassOf ns8:ont00000782 ;
    skos:definition "A Factory that is designed for refining raw materials into products of value."@en .

ns8:ont00001284
    ns8:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Crew"@en ;
    rdfs:subClassOf ns8:ont00000914 ;
    skos:definition "A Group of Persons that bear Roles realized by the operation of the specified Vehicle."@en .

ns8:ont00001285
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Revolving Motion"@en ;
    rdfs:subClassOf ns8:ont00000368 ;
    skos:definition "A Rotational Motion of an Object around an Axis of Rotation that is located externally to the Site occupied by the Object."@en .

ns8:ont00001286
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Waveform"@en ;
    rdfs:subClassOf ns8:ont00000752 ;
    skos:definition "A Wave Process Profile that is the shape of the Wave Cycles of the Wave Process when depicted in a visual graph."@en .

ns8:ont00001287
    ns8:ont00001754 "http://www.dictionary.com/browse/maintain" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Maintenance Facility"@en ;
    rdfs:subClassOf ns8:ont00000192 ;
    skos:definition "A Facility that is designed to be used to perform actions to maintain or improve the state of some property or equipment."@en .

ns8:ont00001288
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Round_shot&oldid=1062790260"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Round Shot"@en ;
    rdfs:subClassOf ns8:ont00001150 ;
    skos:definition "A Portion of Ammunition that is designed to be a solid projectile without explosive charge and to be fired from a cannon."@en .

ns8:ont00001289
    ns8:ont00001754 "http://www.thefreedictionary.com/damaged" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Damaged Stasis"@en ;
    rdfs:subClassOf ns8:ont00000135 ;
    skos:altLabel "Compromised"@en, "Damaged"@en, "Injured"@en ;
    skos:definition "A Stasis of Specifically Dependent Continuant in which some Independent Continuant bears a Quality or Realizable Entity that has suffered impairment (i.e., a decrease or loss) due to a previous action or event such that the Independent Continuant is now of lesser value, usefulness, or functionality."@en ;
    skos:scopeNote "This class can be used to instantiate instances that might otherwise be treated by defined classes such as Damaged Vehicle or Wounded Person. The Independent Continuant and Quality or Realizable Entity are participants of the stasis which can in turn be related to the temporal interval via the occurs on property. "@en .

ns8:ont00001290
    ns8:ont00001760 "https://www.commoncoreontologies.org/UnitsOfMeasureOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Measurement Unit of Length"@en ;
    rdfs:subClassOf ns8:ont00000120 ;
    skos:definition "A Measurement Unit that is used as a standard for measurement of one-dimensional regions or Geospatial Regions."@en ;
    skos:example "foot, meter, kilometer, mile" .

ns8:ont00001291
    ns8:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Radiation Absorptivity"@en ;
    rdfs:subClassOf ns8:ont00000628 ;
    skos:definition "An Electromagnetic Radiation Property that inheres in a bearer in virtue of the capacity of that bearer to absorb electromagnetic radiation of a given frequency."@en .

ns8:ont00001292
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Bus&oldid=1055341487"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Bus"@en ;
    rdfs:subClassOf ns8:ont00000053 ;
    skos:definition "A Ground Motor Vehicle that is designed to transport a large number of people and to travel on six or more tired wheels."@en .

ns8:ont00001293
    ns8:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Perimeter"@en ;
    rdfs:subClassOf ns8:ont00001367 ;
    skos:definition "A One Dimensional Extent that inheres in a bearer in virtue of the extent of a boundary which encloses the bearer."@en .

ns8:ont00001294
    ns8:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Three Dimensional Extent"@en ;
    rdfs:subClassOf ns8:ont00001202 ;
    skos:altLabel "Volume"@en ;
    skos:definition "A Size Quality that inheres in a bearer in virtue of the bearer's extension in three dimensions."@en .

ns8:ont00001295
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Finance&oldid=1062402926"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Financial Facility"@en ;
    rdfs:subClassOf ns8:ont00000192 ;
    skos:definition "A Facility that is designed to support the management of money."@en .

ns8:ont00001296
    ns8:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Pitch Orientation"@en ;
    rdfs:subClassOf ns8:ont00000119 ;
    skos:altLabel "Pitch"@en ;
    skos:definition "A Spatial Orientation of an Object relative to its Pitch Axis."@en .

ns8:ont00001297
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Headquarters&oldid=1046429636"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Military Headquarters Facility"@en ;
    rdfs:subClassOf ns8:ont00001052 ;
    skos:definition "A Military Facility that is designed for military administration and coordination."@en .

ns8:ont00001298
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Document&oldid=1057829688"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Document"@en ;
    rdfs:subClassOf ns8:ont00000798 ;
    skos:definition "An Information Bearing Artifact that is designed to bear some specific Information Content Entity in a series of paragraphs of text or diagrams in the form of physical pieces of paper or an electronic word processor file."@en .

ns8:ont00001299
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Wetting&oldid=1062806793"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Wetting Agent Artifact Function"@en ;
    rdfs:subClassOf ns8:ont00000344 ;
    skos:definition "A Surfactant Artifact Function that is realized in a process that reduces the water repellent tendency of a substance thereby allowing it to become wet."@en .

ns8:ont00001300
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Patch_antenna&oldid=1016658507"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Patch Antenna"@en ;
    rdfs:subClassOf ns8:ont00001192 ;
    skos:altLabel "Microstrip Patch Antenna"@en, "Rectangular Microstrip Antenna"@en ;
    skos:definition "A Radio Antenna that consists of a flat rectangular sheet (or patch) of metal mounted over a larger sheet of metal called a ground plane which is typically contained inside a plastic radome for protection and is small enough that it can be mounted on a flat surface."@en .

ns8:ont00001301
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Goods_and_services&oldid=1063137197"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Service Artifact Function"@en ;
    rdfs:subClassOf ns8:ont00000323 ;
    skos:definition "An Artifact Function that is realized in a process of providing intangible goods to consumers."@en .

ns8:ont00001302
    ns8:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI ;
    owl:equivalentClass _:nimportcommonb492 ;
    rdf:type owl:Class ;
    rdfs:label "Civil Organization"@en ;
    rdfs:subClassOf ns8:ont00001180 ;
    skos:definition "An Organization that is not commercial or military and is the bearer of a Civilian Role."@en .

ns8:ont00001303
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Position Observation Artifact Function"@en ;
    rdfs:subClassOf ns8:ont00001306 ;
    skos:definition "An Observation Artifact Function that is realized during events in which an Artifact is used to collect information about the position of a specified object or class of objects."@en .

ns8:ont00001304
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Dimension Specification"@en ;
    rdfs:subClassOf ns8:ont00000575 ;
    skos:definition "An Quality Specification that prescribes some Size Quality."@en .

ns8:ont00001305
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Loss of Function"@en ;
    rdfs:subClassOf ns8:ont00001066 ;
    skos:definition "A Loss of Disposition in which some Independent Continuant ceases to be the bearer of some Function."@en .

ns8:ont00001306
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Observation Artifact Function"@en ;
    rdfs:subClassOf ns8:ont00000323 ;
    skos:definition "An Artifact Function that is realized during events in which an Artifact is used to collect information about a specified object or class of objects."@en .

ns8:ont00001307
    ns8:ont00001760 "https://www.commoncoreontologies.org/UnitsOfMeasureOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Measurement Unit of Mass Flow Rate"@en ;
    rdfs:subClassOf ns8:ont00000061 ;
    skos:definition "A Measurement Unit of Flow that is used as a standard for measurement of the rate at which the Mass of a substance passes per unit time."@en ;
    skos:example "kilogram per second, slug per second, pound per second" .

ns8:ont00001308
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Sewage_treatment&oldid=1062966352"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Sewage Treatment Facility"@en ;
    rdfs:subClassOf ns8:ont00001315 ;
    skos:definition "A Waste Management Facility that is designed for removing contaminants from wastewater, especially sewage."@en .

ns8:ont00001309
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Lot_number&oldid=1061846325"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Lot Number"@en ;
    rdfs:subClassOf ns8:ont00000077 ;
    skos:definition "A Code Identifier that designates a particular quantity or lot of material from a single manufacturer."@en .

ns8:ont00001310
    ns8:ont00001754 "http://www.dictionary.com/browse/covering" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Covering Artifact Function"@en ;
    rdfs:subClassOf ns8:ont00000323 ;
    skos:definition "An Artifact Function that is realized in a process in which an entity is covered."@en .

ns8:ont00001311
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Aerospace_manufacturer&oldid=1059223410"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Aircraft Manufacturing Facility"@en ;
    rdfs:subClassOf ns8:ont00000782 ;
    skos:definition "A Factory that is designed to manufacture Aircraft."@en .

ns8:ont00001312
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Paramilitary&oldid=1063281359"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Paramilitary Force"@en ;
    rdfs:subClassOf ns8:ont00000274 ;
    skos:definition "An Armed Force whose organizational structure, training, subculture, and (often) function are similar to those of a professional Military, and which is not included as part of a Government's formal Armed Forces."@en .

ns8:ont00001313
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Clothing&oldid=1063505718"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Article of Clothing"@en ;
    rdfs:subClassOf ns8:ont00000995 ;
    skos:definition "A Material Artifact that is designed to cover some portion of a body."@en .

ns8:ont00001314
    ns8:ont00001754 "http://www.id.uscourts.gov/glossary.htm" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Legal System Act"@en ;
    rdfs:subClassOf ns8:ont00000228 ;
    skos:definition "A Planned Act performed by an Agent that realizes their role within the context of a legal system of some jurisdiction."@en .

ns8:ont00001315
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Waste_management&oldid=1062844209"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Waste Management Facility"@en ;
    rdfs:subClassOf ns8:ont00000192 ;
    skos:definition "A Facility that is designed for managing waste for some portion of the waste's existence."@en .

ns8:ont00001316
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Gimbal&oldid=1053306885"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Gimbal"@en ;
    rdfs:subClassOf ns8:ont00001042 ;
    skos:definition "An Equipment Mount that consists of a pivoted support that allows an Artifact to Rotate about one or more Axes."@en .

ns8:ont00001317
    ns8:ont00001760 "https://www.commoncoreontologies.org/UnitsOfMeasureOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Measurement Unit of Volume"@en ;
    rdfs:subClassOf ns8:ont00000120 ;
    skos:definition "A Measurement Unit that is used as a standard for measurement of sites or three-dimensional regions or Geospatial Regions."@en ;
    skos:example "cubic feet, cubic meter, quart, liter" .

ns8:ont00001318
    ns8:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Yaw Orientation"@en ;
    rdfs:subClassOf ns8:ont00000119 ;
    skos:altLabel "Yaw"@en ;
    skos:definition "A Spatial Orientation of an Object relative to its Yaw Axis."@en .

ns8:ont00001319
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Tank&oldid=1060527612"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:comment "Tank firepower is normally provided by a large-caliber main gun mounted in a rotating turret, which is supported by secondary machine guns. A tank's heavy armour and all-terrain mobility provide protection for both the tank and its crew, allowing it to perform all primary tasks of the armoured troops on the battlefield."@en ;
    rdfs:label "Tank"@en ;
    rdfs:subClassOf ns8:ont00000427 ;
    skos:definition "An Armored Fighting Vehicle that is designed to carry heavy firepower, have a powerful Engine, and travel on one or more continuous tracks such that it is suitable for front-line combat and can provide operational maneuverability as well as tactical offensive and defensive capabilities."@en .

ns8:ont00001320
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Transceiver&oldid=1058453736"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Radio Transceiver"@en ;
    rdfs:subClassOf ns8:ont00000903 ;
    skos:definition "A Radio Communication Instrument that is an electronic device composed of both a Radio Transmitter and a Radio Receiver that share common circuitry or a single housing."@en .

ns8:ont00001321
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Lead%E2%80%93acid_battery&oldid=1061641405"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Lead Acid Electric Battery"@en ;
    rdfs:subClassOf ns8:ont00001105 ;
    skos:definition "A Secondary Cell Electric Battery that has a lead anode and lead oxide cathode."@en .

ns8:ont00001322
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:comment "For the most part Generically Dependent Continuants do not inhere in their bearers over some continuous scale. The primary exception is religion and this class allows annotation of those cases where an Agent is described as becoming less religious. Other cases would include the decrease of an organization's bearing of some objective."@en ;
    rdfs:label "Decrease of Generically Dependent Continuant"@en ;
    rdfs:subClassOf ns8:ont00000726 ;
    skos:definition "A Decrease of Dependent Continuant in which some Independent Continuant has a decrease in the level of a Generically Dependent Continuant that it bears."@en .

ns8:ont00001323
    ns8:ont00001754 "https://en.wikipedia.org/wiki/Bearing_(mechanical)" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Bearing Artifact Function"@en ;
    rdfs:subClassOf ns8:ont00000323 ;
    skos:definition "An Artifact Function that is realized in processes in which the Artifact constrains relative motion to only the desired motion, and reduces friction between moving parts."@en .

ns8:ont00001324
    ns8:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Process Regulation"@en ;
    rdfs:subClassOf ns8:ont00000965 ;
    skos:definition "A Directive Information Content Entity that prescribes an Process as required, prohibited, or permitted, and is the output of an Process which realizes some Authority Role."@en ;
    skos:scopeNote "Although regulations often regulate processes which involve agents--as the regulating or regulated participant--it is unclear how causally active an agents need to be in those regulated processes. For example, it is not clear how causally active a human agent is in the process of a traffic light regulating the motion of a self-driving vehicle."@en .

ns8:ont00001325
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Act of Renting"@en ;
    rdfs:subClassOf ns8:ont00001334 ;
    skos:definition "An Act of Purchasing wherein a Financial Instrument is used by an Agent (the Renter) as a payment to acquire temporary possession or use of a good or property that is owned or controlled by another Agent (the Seller)."@en .

ns8:ont00001326
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Land Transportation Artifact"@en ;
    rdfs:subClassOf ns8:ont00000254 ;
    skos:definition "A Transportation Artifact that is fixed in place and designed to bear a Function, the realization of which is sometimes part of a process moving Vehicles and Agents from one location to another via land."@en .

ns8:ont00001327
    ns8:ont00001754 "http://en.wiktionary.org/wiki/commually" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Social Act"@en ;
    rdfs:subClassOf ns8:ont00000228 ;
    skos:definition "A Planned Act having an objective that affects, is performed by, or is performed on behalf of, a community or group of Persons."@en .

ns8:ont00001328
    ns8:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Temporal Reference System"@en ;
    rdfs:subClassOf ns8:ont00000398 ;
    skos:altLabel "Temporal Reference Frame"@en, "Time Scale"@en ;
    skos:definition "A Reference System that describes a set of standards for measuring time as well as understanding the context of and organizing temporal data."@en .

ns8:ont00001329
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Education&oldid=1064011752"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Education Artifact Function"@en ;
    rdfs:subClassOf ns8:ont00001301 ;
    skos:definition "A Service Artifact Function that is realized in processes of transmiting accumulated knowledge skills and values from one generation to another."@en .

ns8:ont00001330
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Telemetry&oldid=1061697851"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Telemetry Process"@en ;
    rdfs:subClassOf _:nimportcommonb496, _:nimportcommonb497, ns8:ont00000110 ;
    skos:definition "A Mechanical Process that is highly automated and in which measurements are made or other data is collected and transmitted to receiving equipment to facilitate the monitoring of environmental conditions or equipment parameters at a remote or inaccessible location."@en ;
    skos:example "using a GPS tag to track a shark's migratory pattern", "using a portable cardiac monitor to remotely collect data on a patient's heart activity (biotelemetry)" .

ns8:ont00001331
    ns8:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Legal Name"@en ;
    rdfs:subClassOf ns8:ont00001014 ;
    skos:definition "A Proper Name that is an official name for the designated entity as determined by a Government or court of law."@en .

ns8:ont00001332
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Ultraviolet&oldid=1062593453"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Extreme Ultraviolet Light Frequency"@en ;
    rdfs:subClassOf ns8:ont00000610 ;
    skos:definition "An Ultraviolet Light Frequency that is between 3 and 30 petahertz."@en .

ns8:ont00001333
    ns8:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Rosy"@en ;
    rdfs:subClassOf ns8:ont00000378 ;
    skos:definition "A Color consisting of red hue and yellow hue and high brightness."@en .

ns8:ont00001334
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Purchasing&oldid=1050163120"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Act of Purchasing"@en ;
    rdfs:subClassOf ns8:ont00000836 ;
    skos:definition "An Act of Financial Instrument Use wherein a Financial Instrument is used by an Agent (the Purchaser) to acquire a good or service from another Agent (the Provider)."@en .

ns8:ont00001335
    dcterms:creator "https://cubrc.org"^^xsd:anyURI ;
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Government&oldid=1063736308"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Government"@en ;
    rdfs:subClassOf _:nimportcommonb498, ns8:ont00001180 ;
    skos:definition "An Organization that is the highest legitimate authority delimited by some Delimiting Domain and that exercises executive, legislative, or judicial authority in that Domain."@en ;
    skos:editorialNote "Highest legitimate authority should not be confused with highest legitimate authority of a particular kind. For example, while the judicial branch of the United States government has the highest judicial authority in a Delimiting Domain, it is not the highest legitimate authority delimited by that domain. The combination of executive, judicial, and legislative branches is higher because it wields more legitimate authority than any branch on its own."@en, "Importantly, the definition states \"highest legitimate authority delimited by some Delimiting Domain\" and not \"highest legitimate authority in some Delimiting Domain.\" The government of Wales is the highest legitimate authority delimited by some Delimiting Domain but it is not the highest legitimate authority in that domain, which would be the government of the United Kingdom."@en .

ns8:ont00001336
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Ownership&oldid=1058224617"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:comment "The relation between the owner and property may be private, collective, or common and the property may be objects, land, real estate, or intellectual property."@en ;
    rdfs:label "Act of Ownership"@en ;
    rdfs:subClassOf ns8:ont00001232 ;
    skos:definition "An Act of Possession that includes an agent having certain rights and duties over the property owned."@en .

ns8:ont00001337
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Infrared&oldid=1064111319"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Infrared Light Frequency"@en ;
    rdfs:subClassOf ns8:ont00000754 ;
    skos:definition "An Electromagnetic Radiation Frequency of some Electromagnetic Wave that is between 300 gigahertz and 430 tetrahertz."@en .

ns8:ont00001338
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Timbre"@en ;
    rdfs:subClassOf ns8:ont00000862 ;
    skos:definition "A Sound Process Profile that is characterized by the variation, spectrum, or envelope of translated sound waves, typically on a continuum from dull or dark to bright."@en .

ns8:ont00001339
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Act of Walking"@en ;
    rdfs:subClassOf ns8:ont00000890 ;
    skos:definition "An Act of Travel that proceeds by foot."@en .

ns8:ont00001340
    ns8:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Calendar Date Identifier"@en ;
    rdfs:subClassOf ns8:ont00000529 ;
    skos:definition "A Date Identifier that designates some Day by using a combination of Day, Week, Month, or Year Identifiers formatted according to an implementation of a Calendar System."@en ;
    skos:example "January 1, 2018; 1 January 2018; 01/01/18; 01Jan18" .

ns8:ont00001341
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Geosphere&oldid=1137306949"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/GeospatialOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Portion of Geosphere"@en ;
    rdfs:subClassOf ns1:BFO_0000024 ;
    skos:definition "A fiat object part that is composed of one or more portions of the atmosphere, cryosphere, hydrosphere, or lithosphere"@en .

ns8:ont00001342
    ns8:ont00001753 "IFV" ;
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Infantry_fighting_vehicle&oldid=1062470745"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Infantry Fighting Vehicle"@en ;
    rdfs:subClassOf ns8:ont00000427 ;
    skos:definition "An Armored Fighting Vehicle that is designed to carry infantry into battle and to provide fire support for them."@en ;
    skos:scopeNote "Infantry Fighting Vehicles (IFVs) are differentiated from Armored Personnel Carriers (APCs) because they are designed to give direct fire support to the dismounted infantry and so usually have significantly enhanced armament. IFVs also often have improved armour and firing ports (allowing the infantry to fire personal weapons while mounted)."@en .

ns8:ont00001343
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Circuit_breaker&oldid=1060854893"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Circuit Breaker"@en ;
    rdfs:subClassOf ns8:ont00000995 ;
    skos:definition "A Material Artifact that is designed to protect an electrical circuit from damage caused by excess current from an overload or short circuit."@en .

ns8:ont00001344
    ns8:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Biological Depot"@en ;
    rdfs:subClassOf ns8:ont00000881 ;
    skos:definition "A Storage Facility that is designed to store biological agents."@en .

ns8:ont00001345
    ns8:ont00001760 "https://www.commoncoreontologies.org/UnitsOfMeasureOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Measurement Unit of Impulse"@en ;
    rdfs:subClassOf ns8:ont00000120 ;
    skos:definition "A Measurement Unit that is used as a standard for measurement of the integral of a Force applied to a portion of matter over a temporal interval."@en ;
    skos:example "N s, dyne second" .

ns8:ont00001346
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Legal_instrument&oldid=1054387344"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Legal Instrument"@en ;
    rdfs:subClassOf ns8:ont00000995 ;
    skos:definition "A Material Artifact that is designed as a formally executed written document that can be formally attributed to its author, records and formally expresses a legally enforceable act, process, or contractual duty, obligation, or right, and therefore evidences that act, process, or agreement."@en .

ns8:ont00001347
    ns8:ont00001754 "http://purl.obolibrary.org/obo/GO_0007610" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Behavior"@en ;
    rdfs:subClassOf ns8:ont00000005 ;
    skos:definition "An Act in which an Independent Continuant participates as an Agent in response to external or internal stimuli and following some pattern which is dependent upon some combination of that Independent Continuant's internal state and external conditions."@en .

ns8:ont00001348
    ns8:ont00001760 "https://www.commoncoreontologies.org/GeospatialOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:comment "For an object in motion, its Three-Dimensional Position is part of its Three-Dimensional Path."@en ;
    rdfs:label "Three-Dimensional Position"@en ;
    rdfs:subClassOf ns1:BFO_0000028 ;
    skos:definition "A Three-Dimensional Spatial Region that encompasses the (minimal) spatial region in which some object is located at a particular time."@en .

ns8:ont00001349
    ns8:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Grey"@en ;
    rdfs:subClassOf ns8:ont00000378 ;
    skos:definition "A Color between white and black colors."@en .

ns8:ont00001350
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Thermal Control Artifact Function"@en ;
    rdfs:subClassOf ns8:ont00000323 ;
    skos:definition "An Artifact Function that is realized by an Artifact increasing, decreasing, or maintaining the temperature of itself, a part of itself, or another object."@en .

ns8:ont00001351
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Cartesian_coordinate_system&oldid=1058613323"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Cartesian Coordinate System"@en ;
    rdfs:subClassOf ns8:ont00000275 ;
    skos:altLabel "Rectangular Coordinate System"@en ;
    skos:definition "A Spatial Reference System that identifies each point in a spatial region of n-dimensions using an ordered n-tuple of numerical coordinates that are the signed (i.e. positive or negative) distances measured in the same unit of length from the zero point where the fixed perpendicular Coordinate System Axes meet."@en .

ns8:ont00001352
    ns8:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:comment "Greenwich Mean Time (GMT) is the mean solar time at the Royal Observatory in Greenwich, London and has been superseded by Coordinated Universal Time (UTC)."@en ;
    rdfs:label "Greenwich Mean Time Zone Identifier"@en ;
    rdfs:subClassOf ns8:ont00000829 ;
    skos:definition "A Time Zone Identifier that designates a spatial region where the local time is calculated according to the specified offset from Greenwich Mean Time."@en .

ns8:ont00001353
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Speed Artifact Function"@en ;
    rdfs:subClassOf ns8:ont00000448 ;
    skos:definition "A Motion Artifact Function that is realized in some process in which its bearer has some speed."@en .

ns8:ont00001354
    ns8:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Vermilion"@en ;
    rdfs:subClassOf ns8:ont00000378 ;
    skos:definition "A Color consisting of red and orange hue with a slight amount of gray."@en .

ns8:ont00001355
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Goods_wagon&oldid=1062686785"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Freight Train Car"@en ;
    rdfs:subClassOf ns8:ont00000928 ;
    skos:altLabel "Freight Car"@en ;
    skos:definition "A Train Car that is designed to transport cargo."@en .

ns8:ont00001356
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Increase of Disposition"@en ;
    rdfs:subClassOf ns8:ont00000611 ;
    skos:definition "An Increase of Realizable Entity in which some Independent Continuant has an increase of some Disposition that it bears."@en .

ns8:ont00001357
    ns8:ont00001760 "https://www.commoncoreontologies.org/UnitsOfMeasureOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Measurement Unit of Time"@en ;
    rdfs:subClassOf ns8:ont00000120 ;
    skos:definition "A Measurement Unit that is used as a standard for measurement of temporal regions."@en ;
    skos:example "second, minute, hour, day" .

ns8:ont00001358
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=School&oldid=1063515394"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "School"@en ;
    rdfs:subClassOf ns8:ont00000270 ;
    skos:definition "An Education Facility that is designed to provide learning space and environments for teaching of students under the direction of teachers."@en .

ns8:ont00001359
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:comment "An Act of Manufacturing typically involves the mass production of goods."@en ;
    rdfs:label "Act of Manufacturing"@en ;
    rdfs:subClassOf ns8:ont00000908 ;
    skos:definition "An Act of Artifact Processing wherein Artifacts are created in a Facility for the purpose of being sold to consumers."@en .

ns8:ont00001360
    ns8:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Three Dimensional Shape"@en ;
    rdfs:subClassOf ns8:ont00001059 ;
    skos:definition "A Shape Quality that inheres only in a three dimensional entity."@en .

ns8:ont00001361
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Healing&oldid=1053920678"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Healing Artifact Function"@en ;
    rdfs:subClassOf ns8:ont00000323 ;
    skos:definition "An Artifact Function that is realized in a process in which health is restored to an unbalanced, diseased, or damaged organism."@en .

ns8:ont00001362
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Natural-gas_processing&oldid=1056700541"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Gas Processing Facility"@en ;
    rdfs:subClassOf ns8:ont00001283 ;
    skos:definition "A Refinery that is designed for refining natural gas into products of value."@en .

ns8:ont00001363
    ns8:ont00001754 "http://purl.org/obo/owl/PATO#PATO_0000384" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Male Sex"@en ;
    rdfs:subClassOf ns8:ont00001033 ;
    skos:definition "A Biological Sex inhering in an individual whose sex organs contain only male gametes."@en .

ns8:ont00001364
    ns8:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI ;
    owl:equivalentClass _:nimportcommonb499 ;
    rdf:type owl:Class ;
    rdfs:comment "Four of the subtypes of measurements used here (Interval, Nominal, Ordinal, and Ratio) were originally defined by S.S. Stevens in the article \"On the Theory of Scales of Measurement\" in Science, Vol. 103 No. 2684 on June 7, 1946. For an introductory article with links to additional content including criticisms and alternate classifications of measurements see https://en.wikipedia.org/wiki/Level_of_measurement"@en ;
    rdfs:label "Interval Measurement Information Content Entity"@en ;
    rdfs:subClassOf ns8:ont00001163 ;
    skos:definition "A Measurement Information Content Entity that places a Quality of an Entity onto some interval scale having no true zero value."@en ;
    skos:example "The sentence \"The temperature reached -27 degrees Fahrenheit on January 20, 1985 in Chicago, IL.\" is the carrier of an interval measurement as 0 degrees on the Fahrenheit scale does not describe absolute zero."@en .

ns8:ont00001365
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Maximum Speed Artifact Function"@en ;
    rdfs:subClassOf ns8:ont00001353 ;
    skos:definition "A Speed Artifact Function that is realized in some process in which the Artifact bearing the Artifact Function attains the highest speed at which that Artifact is designed to operate."@en .

ns8:ont00001366
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Powering Artifact Function"@en ;
    rdfs:subClassOf ns8:ont00000323 ;
    skos:definition "An Artifact Function that is realized by processes in which some Artifact is used to supply power to some Artifact."@en .

ns8:ont00001367
    ns8:ont00001754 "http://purl.obolibrary.org/obo/PATO_0001708" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:comment "Subclasses of one dimensional extent are included for usability. It is doubtful any of them can be objectively distinguished (on the side of the bearing entity) without some reference to external properties such as orientation and perspective."@en ;
    rdfs:label "One Dimensional Extent"@en ;
    rdfs:subClassOf ns8:ont00001202 ;
    skos:definition "A Size Quality that inheres in a bearer in virtue of the bearer's extension in one dimension."@en .

ns8:ont00001368
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Motion Observation Artifact Function"@en ;
    rdfs:subClassOf ns8:ont00001306 ;
    skos:definition "An Observation Artifact Function that is realized during events in which an Artifact is used to collect information about the Motion of a specified object or class of objects."@en .

ns8:ont00001369
    ns8:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Rectangular"@en ;
    rdfs:subClassOf ns8:ont00001059 ;
    skos:definition "A Shape Quality inhering in a bearer in virtue of having four sides and four 90 degree angles."@en .

ns8:ont00001370
    ns8:ont00001754 "https://en.wikipedia.org/wiki/Bearing_(mechanical)" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Machine Bearing"@en ;
    rdfs:subClassOf ns8:ont00000995 ;
    skos:definition "A Material Artifact that is designed to constrain relative motion to only desired motion and reduces friction between moving parts."@en .

ns8:ont00001371
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Electromagnetic_induction&oldid=1061836930"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Electromagnetic Induction Artifact Function"@en ;
    rdfs:subClassOf ns8:ont00000323 ;
    skos:definition "An Artifact Function that is realized by processes in which some Artifact that is used to produce electromotive force across an electrical conductor due to its dynamic interaction with a magnetic field."@en .

ns8:ont00001372
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Fertilizer&oldid=1062923261"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Fertilizer Artifact Function"@en ;
    rdfs:subClassOf ns8:ont00000437 ;
    skos:definition "An Enhancing Artifact Function that is realized in processes of supplying soilds or plant tissues with one or more plant nutrients essential to growth."@en .

ns8:ont00001373
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Bow_and_arrow&oldid=1062193194"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Bow"@en ;
    rdfs:subClassOf ns8:ont00001051 ;
    skos:definition "A Projectile Launcher that is designed to launch Arrows."@en .

ns8:ont00001374
    ns8:ont00001754 "Derived (loosely) from: John Searle's Speech Acts: An Essay in the Philosophy of Language" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:comment "Examples: Baptism, Sentencing a person to imprisonment, Pronouncing a couple husband and wife, Declaring war"@en ;
    rdfs:label "Act of Declarative Communication"@en ;
    rdfs:subClassOf ns8:ont00000402 ;
    skos:definition "An Act of Communication that changes the reality in accord with the proposition of the declaration."@en .

ns8:ont00001375
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Washing&oldid=1035998791"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Washing Facility"@en ;
    rdfs:subClassOf ns8:ont00000192 ;
    skos:definition "A Facility that is designed to wash personnel or equipment."@en .

ns8:ont00001376
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Torque&oldid=1063339484"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Torque"@en ;
    rdfs:subClassOf ns8:ont00000570 ;
    skos:altLabel "Moment of Force"@en ;
    skos:definition "A Force that is applied to an object in a direction that would tend to cause the object to rotate around an Axis of Rotation and is the rate of change of an object's Angular Momentum."@en .

ns8:ont00001377
    ns8:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Gold Color"@en ;
    rdfs:subClassOf ns8:ont00000378 ;
    skos:definition "A Color that resembles a yellow-orange Hue with the added feature of having a metallic shine."@en .

ns8:ont00001378
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Hospitality&oldid=1049599161"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Hospitality Artifact Function"@en ;
    rdfs:subClassOf ns8:ont00001301 ;
    skos:definition "A Service Artifact Function that is realized in processes of accommodation food and beverage meeting and events gaming entertainment and recreation tourism services and visitor information."@en .

ns8:ont00001379
    ns8:ont00001754 "Schlosser, Markus, \"Agency\", The Stanford Encyclopedia of Philosophy (Winter 2019 Edition), Edward N. Zalta (ed.), available at: https://plato.stanford.edu/archives/win2019/entries/agency/"@en ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Agent Capability"@en ;
    rdfs:subClassOf ns1:BFO_0000017 ;
    skos:definition "A Realizable Entity that inheres in a Material Entity in virtue of that Material Entity's capacity to realize it in some Planned Act."@en .

ns8:ont00001380
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Farm&oldid=1058311769"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Farm"@en ;
    rdfs:subClassOf ns8:ont00000339 ;
    skos:definition "An Agricultural Facility that is designed to produce food and other crops."@en .

ns8:ont00001381
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Medical Artifact"@en ;
    rdfs:subClassOf ns8:ont00000995 ;
    skos:definition "A Material Artifact that is designed for diagnosing, treating, or preventing disease, disability, or death."@en .

ns8:ont00001382
    ns8:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Electronic Cash"@en ;
    rdfs:subClassOf ns8:ont00000475 ;
    skos:definition "A Portion of Cash that consists of Bytes."@en .

ns8:ont00001383
    ns8:ont00001754 "https://en.wikipedia.org/w/index.php?title=Fire_station&oldid=1060666629"^^xsd:anyURI ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:label "Fire Station"@en ;
    rdfs:subClassOf ns8:ont00000479 ;
    skos:altLabel "Fire Hall"@en, "Fire House"@en ;
    skos:definition "A Public Safety Facility that is designed for the storage of firefighting apparatus."@en .

ns8:ont00001384
    ns8:ont00001754 "https://en.wikipedia.org/wiki/Opacity_(optics)" ;
    ns8:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI ;
    rdf:type owl:Class ;
    rdfs:comment "Note that it is important to specify the frequency of electromagnetic radiation when representing a bearer's Opacity since a bearer may be Opaque with respect to electromagnetic radiation of one frequency, but be transparent with respect to electromagnetic radiation of another frequency. Unless otherwise stated, statements about a bearer's Opacity are assumed to be about electromagnetic radiation with a frequency in the visible spectrum."@en ;
    rdfs:label "Opacity"@en ;
    rdfs:subClassOf ns8:ont00000628 ;
    skos:definition "An Electromagnetic Radiation Property that inheres in a bearer in virtue of that bearer's capacity to transmit electromagnetic radiation of a given frequency through the bearer instead of reflecting, scattering, or absorbing electromangentic radiation of that frequency."@en .

ns8:ont00001385
    ns8:ont00001760 "https://www.commoncoreontologies.org/CurrencyUnitOntology"^^xsd:anyURI ;
