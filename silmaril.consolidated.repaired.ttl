_:npredecessorshapesb93
    rdf:type sh:SPARQLConstraint ;
    sh:message "Every projection leg must carry a signified identifier." ;
    sh:select """PREFIX silo: <urn:silmaril:type:graph:instance:instruction:code:property:core:entity:property:object:>
        PREFIX sild: <urn:silmaril:type:graph:instance:instruction:code:property:core:entity:property:data:>
        SELECT $this WHERE {
          $this <urn:silmaril:type:graph:instance:instruction:code:property:core:entity:property:object:has:projection:leg> ?leg .
          FILTER NOT EXISTS { ?leg <urn:silmaril:type:graph:instance:instruction:code:property:core:entity:property:data:projection:signified:identifier> ?id }
        }""" .

_:npredecessorshapesb94
    rdf:type sh:SPARQLConstraint ;
    sh:message "Every projection leg in a family must carry the same signified identifier." ;
    sh:select """PREFIX silo: <urn:silmaril:type:graph:instance:instruction:code:property:core:entity:property:object:>
        PREFIX sild: <urn:silmaril:type:graph:instance:instruction:code:property:core:entity:property:data:>
        SELECT $this WHERE {
          $this <urn:silmaril:type:graph:instance:instruction:code:property:core:entity:property:object:has:projection:leg> ?left, ?right .
          ?left <urn:silmaril:type:graph:instance:instruction:code:property:core:entity:property:data:projection:signified:identifier> ?leftId .
          ?right <urn:silmaril:type:graph:instance:instruction:code:property:core:entity:property:data:projection:signified:identifier> ?rightId .
          FILTER(?leftId != ?rightId)
        }""" .

